+// Zero-filled trie storage, equivalent to a static array of `size` nodes.
+// On Windows, VirtualAlloc pages are zero and only become resident when touched.
+trie alloc_trie(u32 size) {
+#ifdef WIN32
+  trie t = (trie)VirtualAlloc(NULL, (size_t)size * sizeof(trie_node),
+    MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+#else
+  trie t = (trie)calloc(size, sizeof(trie_node));
+#endif
+  if (!t) {
+    fprintf(stderr, "Error: unable to allocate parser tries\n");
+    exit(5);
+  }
+  return t;
+}
+
 void init_parser() {
+  gt_thms = alloc_trie(THM_TRIE_SIZE); gt_thms_end = gt_thms + 2;
+  gt_terms = alloc_trie(TERM_TRIE_SIZE); gt_terms_end = gt_terms + 2;
   g_delims[' '] = DELIM_SPACE | DELIM_RIGHT;
   g_delims['\n'] = DELIM_SPACE | DELIM_RIGHT;
   g_delims['$'] = DELIM_RIGHT;
