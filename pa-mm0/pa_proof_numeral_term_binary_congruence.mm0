def paProofNumeralTermAdditionRightCongruenceProof (a b c h p: nat): nat = $ paProofNumeralMPProof (paProofNumeralTermAdditionRightCongruenceRef a c) (paProofNumeralTermAdditionRightCongruenceTarget a b c) (paProofAxiomAnnotation (paProofNumeralTermReflexivityWitness (paTermAddition c a))) (paProofNumeralTermAdditionRightCongruenceFirstAnnotation a b c h) (paProofNumeralTermReflexivityProof (paTermAddition c a)) (paProofNumeralTermAdditionRightCongruenceFirstProof a b c h p) $;

theorem paProofNumeralTermAdditionRightCongruence_derives (a b c h p: nat): $ paTermBound 0 c -> paProofDerives p (paProofRow 0 (paFormulaEqual a b) h) -> paProofDerives (paProofNumeralTermAdditionRightCongruenceProof a b c h p) (paProofNumeralTermAdditionRightCongruenceRow a b c h) $;

