import "pa_proof_numeral_multiplication.mm0";

def paProofNumeralTermAdditionLeftCongruencePhi (a c: nat): nat = $ paFormulaEqual (paTermAddition a c) (paTermAddition (paTermVariable 0) c) $;

def paProofNumeralTermAdditionLeftCongruenceRef (a c: nat): nat = $ paFormulaEqual (paTermAddition a c) (paTermAddition a c) $;

def paProofNumeralTermAdditionLeftCongruenceTarget (a b c: nat): nat = $ paFormulaEqual (paTermAddition a c) (paTermAddition b c) $;

def paProofNumeralTermAdditionLeftCongruenceAxiomFormula (a b c: nat): nat = $ paFormulaImp (paFormulaEqual a b) (paFormulaImp (paProofNumeralTermAdditionLeftCongruenceRef a c) (paProofNumeralTermAdditionLeftCongruenceTarget a b c)) $;

def paProofNumeralTermAdditionLeftCongruenceAxiomAnnotation (a b c: nat): nat = $ paProofAxiomAnnotation (paProofNumeralEqSubstWitness (paProofNumeralTermAdditionLeftCongruencePhi a c) a b) $;

def paProofNumeralTermAdditionLeftCongruenceAxiomRow (a b c: nat): nat = $ paProofRow 0 (paProofNumeralTermAdditionLeftCongruenceAxiomFormula a b c) (paProofNumeralTermAdditionLeftCongruenceAxiomAnnotation a b c) $;

def paProofNumeralTermAdditionLeftCongruenceFirstAnnotation (a b c h: nat): nat = $ paProofNumeralMPAnnotation (paFormulaEqual a b) (paFormulaImp (paProofNumeralTermAdditionLeftCongruenceRef a c) (paProofNumeralTermAdditionLeftCongruenceTarget a b c)) h (paProofNumeralTermAdditionLeftCongruenceAxiomAnnotation a b c) $;

def paProofNumeralTermAdditionLeftCongruenceFirstRow (a b c h: nat): nat = $ paProofRow 0 (paFormulaImp (paProofNumeralTermAdditionLeftCongruenceRef a c) (paProofNumeralTermAdditionLeftCongruenceTarget a b c)) (paProofNumeralTermAdditionLeftCongruenceFirstAnnotation a b c h) $;

def paProofNumeralTermAdditionLeftCongruenceFirstProof (a b c h p: nat): nat = $ paProofNumeralMPProof (paFormulaEqual a b) (paFormulaImp (paProofNumeralTermAdditionLeftCongruenceRef a c) (paProofNumeralTermAdditionLeftCongruenceTarget a b c)) h (paProofNumeralTermAdditionLeftCongruenceAxiomAnnotation a b c) p (paProofNumeralEqSubstProof (paProofNumeralTermAdditionLeftCongruencePhi a c) a b) $;

def paProofNumeralTermAdditionLeftCongruenceAnnotation (a b c h: nat): nat = $ paProofNumeralMPAnnotation (paProofNumeralTermAdditionLeftCongruenceRef a c) (paProofNumeralTermAdditionLeftCongruenceTarget a b c) (paProofAxiomAnnotation (paProofNumeralTermReflexivityWitness (paTermAddition a c))) (paProofNumeralTermAdditionLeftCongruenceFirstAnnotation a b c h) $;

def paProofNumeralTermAdditionLeftCongruenceRow (a b c h: nat): nat = $ paProofRow 0 (paProofNumeralTermAdditionLeftCongruenceTarget a b c) (paProofNumeralTermAdditionLeftCongruenceAnnotation a b c h) $;

def paProofNumeralTermAdditionLeftCongruenceProof (a b c h p: nat): nat = $ paProofNumeralMPProof (paProofNumeralTermAdditionLeftCongruenceRef a c) (paProofNumeralTermAdditionLeftCongruenceTarget a b c) (paProofAxiomAnnotation (paProofNumeralTermReflexivityWitness (paTermAddition a c))) (paProofNumeralTermAdditionLeftCongruenceFirstAnnotation a b c h) (paProofNumeralTermReflexivityProof (paTermAddition a c)) (paProofNumeralTermAdditionLeftCongruenceFirstProof a b c h p) $;

theorem paProofNumeralTermAdditionLeftCongruence_derives (a b c h p: nat): $ paTermBound 0 c -> paProofDerives p (paProofRow 0 (paFormulaEqual a b) h) -> paProofDerives (paProofNumeralTermAdditionLeftCongruenceProof a b c h p) (paProofNumeralTermAdditionLeftCongruenceRow a b c h) $;

