def paProofNumeralTermAdditionRightCongruenceFirstAnnotation (a b c h: nat): nat = $ paProofNumeralMPAnnotation (paFormulaEqual a b) (paFormulaImp (paProofNumeralTermAdditionRightCongruenceRef a c) (paProofNumeralTermAdditionRightCongruenceTarget a b c)) h (paProofNumeralTermAdditionRightCongruenceAxiomAnnotation a b c) $;

