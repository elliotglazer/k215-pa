def paProofNumeralTermMultiplicationLeftCongruenceProof (a b c h p: nat): nat = $ paProofNumeralMPProof (paProofNumeralTermMultiplicationLeftCongruenceRef a c) (paProofNumeralTermMultiplicationLeftCongruenceTarget a b c) (paProofAxiomAnnotation (paProofNumeralTermReflexivityWitness (paTermMultiplication a c))) (paProofNumeralTermMultiplicationLeftCongruenceFirstAnnotation a b c h) (paProofNumeralTermReflexivityProof (paTermMultiplication a c)) (paProofNumeralTermMultiplicationLeftCongruenceFirstProof a b c h p) $;

theorem paProofNumeralTermMultiplicationLeftCongruence_derives (a b c h p: nat): $ paTermBound 0 c -> paProofDerives p (paProofRow 0 (paFormulaEqual a b) h) -> paProofDerives (paProofNumeralTermMultiplicationLeftCongruenceProof a b c h p) (paProofNumeralTermMultiplicationLeftCongruenceRow a b c h) $;

