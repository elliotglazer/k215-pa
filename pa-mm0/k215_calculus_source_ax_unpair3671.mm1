pub theorem k215UnpairMacro3671 (n a b c: nat): $ k215PReach (k215UnpairAt3671State k215PNum3671 a b n c) (k215UnpairAt3671State k215PNum3679 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
