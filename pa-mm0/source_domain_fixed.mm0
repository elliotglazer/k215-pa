import "source_relative_prefix.mm0";

import "source_core_theory.mm0";

def sfDFF0: nat = $ sfEq 0 0 $;

def sfDFF1: nat = $ sfEq 1 0 $;

def sfDFF2: nat = $ sfEq 0 1 $;

def sfDFF3: nat = $ sfImp sfDFF1 sfDFF2 $;

def sfDFF4: nat = $ sfEq 2 1 $;

def sfDFF5: nat = $ sfEq 2 0 $;

def sfDFF6: nat = $ sfImp sfDFF1 sfDFF5 $;

def sfDFF7: nat = $ sfImp sfDFF4 sfDFF6 $;

def sfDFF8: nat = $ sfEq 3 1 $;

def sfDFF9: nat = $ sfMem 3 2 $;

def sfDFF10: nat = $ sfMem 1 0 $;

def sfDFF11: nat = $ sfImp sfDFF9 sfDFF10 $;

def sfDFF12: nat = $ sfImp sfDFF5 sfDFF11 $;

def sfDFF13: nat = $ sfImp sfDFF8 sfDFF12 $;

def sfDomainEqualityFixed (z: nat): wff = $ z = zfcRefl \/ (z = zfcSym \/ (z = zfcTrans \/ z = zfcEqElem)) $;

theorem sfDomainRefl_core (D: nat) (hd: $ sfWf D $): $ sfTheoryProvable zfcCoreAxioms (sfRelativize D zfcRefl) $;

theorem sfDomainSym_core (D: nat) (hd: $ sfWf D $): $ sfTheoryProvable zfcCoreAxioms (sfRelativize D zfcSym) $;

theorem sfDomainTrans_core (D: nat) (hd: $ sfWf D $): $ sfTheoryProvable zfcCoreAxioms (sfRelativize D zfcTrans) $;

theorem sfDomainEqElem_core (D: nat) (hd: $ sfWf D $): $ sfTheoryProvable zfcCoreAxioms (sfRelativize D zfcEqElem) $;

theorem sfDomainEqualityFixed_image (D a: nat) (hd: $ sfWf D $): $ sfDomainEqualityFixed a -> sfTheoryProvable zfcCoreAxioms (sfRelativize D a) $;
