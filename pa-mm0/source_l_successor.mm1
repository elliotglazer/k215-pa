import "source_l_successor_replay.mm1";

@_ def sfLRecursionSuccessor: nat = $ slRSFormula $;
pub theorem sfLRecursionSuccessor_context: $ slRSContext = sfLBackground $ = 'eqid;
pub theorem sfLRecursionSuccessor_local: $ nsLocal sfLBackground sfLRecursionSuccessor $ = '(mpbi (nsLocal_context_eq sfLRecursionSuccessor_context) slRSCertificate);
pub theorem sfLRecursionSuccessor_zfr: $ sfTheoryProvable zfrAxioms sfLRecursionSuccessor $ = '(ax_mp (sfTheory_local sfLBackground_zfr) sfLRecursionSuccessor_local);
