pub theorem k215UnpairMacro2858 (n a b c: nat): $ k215PReach (k215UnpairAt2858State k215PNum2858 a b n c) (k215UnpairAt2858State k215PNum2866 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
