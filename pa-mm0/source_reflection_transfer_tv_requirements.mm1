import "source_reflection_transfer_tv_step.mm1";

import "source_structural_induction.mm1";

@_ def sfTVRequirementsBody(D y c h:nat):nat = $ if (c = 0) (sfEq 0 0) (if (sfTag c = 1) (sfEq 0 0) (if (sfTag c = 2) (sfEq 0 0) (if (sfTag c = 3) (sfAnd (h @ (y, sfLeft c)) (h @ (y, sfRight c))) (if (sfTag c = 4) (sfAnd (h @ (y, sfLeft c)) (h @ (y, sfRight c))) (if (sfTag c = 5) (sfAnd (h @ (y, sfLeft c)) (h @ (y, sfRight c))) (if (sfTag c = 6 /\ sfRight c = 0) (sfAnd (sfReflectionEwAt D (sfImp (sfRelativize D (sfLeft c)) sfBot) y) (sfAll (sfImp (sfMem 0 (suc y)) (h @ (suc y, sfLeft c))))) (if (sfTag c = 7 /\ sfRight c = 0) (sfAnd (sfReflectionEwAt D (sfRelativize D (sfLeft c)) y) (sfAll (sfImp (sfMem 0 (suc y)) (h @ (suc y, sfLeft c))))) (sfEq 0 0)))))))) $;

@_ abstract def sfTVRequirementsStep(D:nat)(.h:nat):set = $ \ h, sfTVRequirementsBody D (fst (sfHistoryLength h)) (snd (sfHistoryLength h)) h $;

@_ def sfTVRequirements(D y c:nat):nat = $ srec (sfTVRequirementsStep D) (y, c) $;

@_ abstract def sfTVRequirementsHistory(D y c:nat)(.i:nat):nat = $ \. i e. upto (y, c), srec (sfTVRequirementsStep D) i $;

pub theorem sfTVRequirementsStep_apply(D h:nat): $ sfTVRequirementsStep D @ h = sfTVRequirementsBody D (fst (sfHistoryLength h)) (snd (sfHistoryLength h)) h $ = (named '(!! applame j ,eqtac));

pub theorem sfTVRequirementsHistory_size(D y c:nat): $ sfHistoryLength (sfTVRequirementsHistory D y c) = (y, c) $ = (named '(sreclem eqid));

pub theorem sfTVRequirementsHistory_lookup(D y c e a:nat): $ (e, a) < (y, c) -> sfTVRequirementsHistory D y c @ (e, a) = sfTVRequirements D e a $ = (named '(syl (apprlame sreceq2) (bi2 elupto)));

pub theorem sfTVRequirements_unfold(D y c:nat): $ sfTVRequirements D y c = sfTVRequirementsBody D y c (sfTVRequirementsHistory D y c) $ = (named '(eqtr srecval (eqtr sfTVRequirementsStep_apply (sfTVRequirementsBodyeq eqid (eqtr (fsteq sfTVRequirementsHistory_size) fstpr) (eqtr (sndeq sfTVRequirementsHistory_size) sndpr) eqid))));

theorem sftvrBody_Mem(D y c h:nat)(h0:$ c != 0 $)(ht:$ sfTag c = 1 $): $ sfTVRequirementsBody D y c h = sfEq 0 0 $ = (named '(eqtr (ifneg h0) (ifpos ht)));

theorem sftvrBody_Eq(D y c h:nat)(h0:$ c != 0 $)(ht:$ sfTag c = 2 $): $ sfTVRequirementsBody D y c h = sfEq 0 0 $ = (named '(eqtr (ifneg h0) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc lt01S)))) (ifpos ht))));

theorem sftvrBody_And(D y c h:nat)(h0:$ c != 0 $)(ht:$ sfTag c = 3 $): $ sfTVRequirementsBody D y c h = sfAnd (h @ (y, sfLeft c)) (h @ (y, sfRight c)) $ = (named '(eqtr (ifneg h0) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc lt01S)))) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc lt01S))))) (ifpos ht)))));

theorem sftvrBody_Or(D y c h:nat)(h0:$ c != 0 $)(ht:$ sfTag c = 4 $): $ sfTVRequirementsBody D y c h = sfAnd (h @ (y, sfLeft c)) (h @ (y, sfRight c)) $ = (named '(eqtr (ifneg h0) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc lt01S)))) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc lt01S))))) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S)))))) (ifpos ht))))));

theorem sftvrBody_Imp(D y c h:nat)(h0:$ c != 0 $)(ht:$ sfTag c = 5 $): $ sfTVRequirementsBody D y c h = sfAnd (h @ (y, sfLeft c)) (h @ (y, sfRight c)) $ = (named '(eqtr (ifneg h0) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc lt01S)))) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc lt01S))))) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S)))))) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S))))))) (ifpos ht)))))));

theorem sftvrBody_All(D y c h:nat)(h0:$ c != 0 $)(ht:$ sfTag c = 6 $)(hz:$ sfRight c = 0 $): $ sfTVRequirementsBody D y c h = sfAnd (sfReflectionEwAt D (sfImp (sfRelativize D (sfLeft c)) sfBot) y) (sfAll (sfImp (sfMem 0 (suc y)) (h @ (suc y, sfLeft c)))) $ = (named '(eqtr (ifneg h0) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc lt01S)))) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc lt01S))))) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S)))))) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S))))))) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S)))))))) (ifpos (ian ht hz)))))))));

theorem sftvrBody_Ex(D y c h:nat)(h0:$ c != 0 $)(ht:$ sfTag c = 7 $)(hz:$ sfRight c = 0 $): $ sfTVRequirementsBody D y c h = sfAnd (sfReflectionEwAt D (sfRelativize D (sfLeft c)) y) (sfAll (sfImp (sfMem 0 (suc y)) (h @ (suc y, sfLeft c)))) $ = (named '(eqtr (ifneg h0) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc lt01S)))) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc lt01S))))) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S)))))) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S))))))) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S)))))))) (eqtr (ifneg (mt anl (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S)))))))))) (ifpos (ian ht hz))))))))));

theorem sftvrHistory_child(D y c a:nat)(hl:$ sfLeft c = a $)(ha:$ a < c $): $ sfTVRequirementsHistory D y c @ (y, sfLeft c) = sfTVRequirements D (y) a $ = (named '(eqtr (appeq2 (preq2 hl)) (sfTVRequirementsHistory_lookup (sfKey_lt ha))));

theorem sftvrHistory_right(D y c a:nat)(hl:$ sfRight c = a $)(ha:$ a < c $): $ sfTVRequirementsHistory D y c @ (y, sfRight c) = sfTVRequirements D (y) a $ = (named '(eqtr (appeq2 (preq2 hl)) (sfTVRequirementsHistory_lookup (sfKey_lt ha))));

theorem sftvrHistory_underBinder(D y c a:nat)(hl:$ sfLeft c = a $)(ha:$ a < c $): $ sfTVRequirementsHistory D y c @ (suc y, sfLeft c) = sfTVRequirements D (suc y) a $ = (named '(eqtr (appeq2 (preq2 hl)) (sfTVRequirementsHistory_lookup (sfKey_underBinder_lt ha))));

pub theorem sfTVRequirements_bot(D y:nat): $ sfTVRequirements D y sfBot = sfEq 0 0 $ = (named '(eqtr sfTVRequirements_unfold (ifpos eqid)));

pub theorem sfTVRequirements_sfMem(D y a b:nat): $ sfTVRequirements D y (sfMem a b) = sfEq 0 0 $ = (named '(eqtr sfTVRequirements_unfold (sftvrBody_Mem sfMem_ne_sfBot sfMem_tag)));

pub theorem sfTVRequirements_sfEq(D y a b:nat): $ sfTVRequirements D y (sfEq a b) = sfEq 0 0 $ = (named '(eqtr sfTVRequirements_unfold (sftvrBody_Eq sfEq_ne_sfBot sfEq_tag)));

pub theorem sfTVRequirements_sfAnd(D y a b:nat): $ sfTVRequirements D y (sfAnd a b) = sfAnd (sfTVRequirements D y a) (sfTVRequirements D y b) $ = (named '(eqtr sfTVRequirements_unfold (eqtr (sftvrBody_And sfAnd_ne_sfBot sfAnd_tag) (nsAnd_eq (sftvrHistory_child sfAnd_left sfAnd_left_lt) (sftvrHistory_right sfAnd_right sfAnd_right_lt)))));

pub theorem sfTVRequirements_sfOr(D y a b:nat): $ sfTVRequirements D y (sfOr a b) = sfAnd (sfTVRequirements D y a) (sfTVRequirements D y b) $ = (named '(eqtr sfTVRequirements_unfold (eqtr (sftvrBody_Or sfOr_ne_sfBot sfOr_tag) (nsAnd_eq (sftvrHistory_child sfOr_left sfOr_left_lt) (sftvrHistory_right sfOr_right sfOr_right_lt)))));

pub theorem sfTVRequirements_sfImp(D y a b:nat): $ sfTVRequirements D y (sfImp a b) = sfAnd (sfTVRequirements D y a) (sfTVRequirements D y b) $ = (named '(eqtr sfTVRequirements_unfold (eqtr (sftvrBody_Imp sfImp_ne_sfBot sfImp_tag) (nsAnd_eq (sftvrHistory_child sfImp_left sfImp_left_lt) (sftvrHistory_right sfImp_right sfImp_right_lt)))));

pub theorem sfTVRequirements_sfAll(D y a:nat): $ sfTVRequirements D y (sfAll a) = sfAnd (sfReflectionEwAt D (sfImp (sfRelativize D a) sfBot) y) (sfAll (sfImp (sfMem 0 (suc y)) (sfTVRequirements D (suc y) a))) $ = (named '(eqtr sfTVRequirements_unfold (eqtr (sftvrBody_All sfAll_ne_sfBot sfAll_tag sfAll_right) (nsAnd_eq (nsImp_eq (nsEx_eq (nsAnd_eq eqid (nsImp_eq (trud (sfRelativizeeq2d (a1i sfAll_left))) eqid))) (nsEx_eq (nsAnd_eq eqid (nsImp_eq (trud (sfRelativizeeq2d (a1i sfAll_left))) eqid)))) (nsAll_eq (nsImp_eq eqid (sftvrHistory_underBinder sfAll_left sfAll_body_lt)))))));

pub theorem sfTVRequirements_sfEx(D y a:nat): $ sfTVRequirements D y (sfEx a) = sfAnd (sfReflectionEwAt D (sfRelativize D a) y) (sfAll (sfImp (sfMem 0 (suc y)) (sfTVRequirements D (suc y) a))) $ = (named '(eqtr sfTVRequirements_unfold (eqtr (sftvrBody_Ex sfEx_ne_sfBot sfEx_tag sfEx_right) (nsAnd_eq (nsImp_eq (nsEx_eq (nsAnd_eq eqid (trud (sfRelativizeeq2d (a1i sfEx_left))))) (nsEx_eq (nsAnd_eq eqid (trud (sfRelativizeeq2d (a1i sfEx_left)))))) (nsAll_eq (nsImp_eq eqid (sftvrHistory_underBinder sfEx_left sfEx_body_lt)))))));
