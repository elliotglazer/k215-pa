import "k215_calculus_source_ax_stack_loops.mm0";
import "k215_literal_runtime_reach.mm0";
import "k215_calculus_source_pairing.mm0";
import "k215_calculus_source_ax_stack_lookups.mm0";

def k215UnpairAt3803State (pc a b n c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) n (k215PR3 c) (k215PR4 c) (k215PR5 c) a b (k215PR8 c)) $;

theorem k215UnpairAt3803Advance (a b n c: nat): $ k215PReach (k215UnpairAt3803State k215PNum3803 a b (suc n) c) (k215UnpairAt3803State k215PNum3803 (fst (suc (a, b))) (snd (suc (a, b))) n c) $;

def k215UnpairAt3803Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt3803State k215PNum3803 a b n c) (k215UnpairAt3803State k215PNum3811 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;

def k215UnpairAt3803Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt3803Run n a b c $;

theorem k215UnpairMacro3803 (n a b c: nat): $ k215PReach (k215UnpairAt3803State k215PNum3803 a b n c) (k215UnpairAt3803State k215PNum3811 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;

theorem k215UnpairMacro3803_clean (n c: nat): $ k215PReach (k215UnpairAt3803State k215PNum3803 0 0 n c) (k215UnpairAt3803State k215PNum3811 (fst n) (snd n) 0 c) $;
