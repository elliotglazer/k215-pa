import "source_k0_collection_initial.mm0";

import "quotation_supported_quantifiers.mm0";

theorem sfK0Collection_allocated_request_at (E: set) (n b t r a k psi: nat) (z: nat) (hf: $ sfBound (suc (suc n)) psi $) (hk: $ 0 < k $)
 (hb: $ b < k $) (ht: $ t < k $) (hr: $ r < k $) (ha: $ a < k $)
 (he: $ sqEnvBelow E n k $) (hz: $ z < k $):
 $ k218QProvable (kImp (kAll (suc (suc k)) (sfK0CollectionRequest E r b t r a (suc k) (suc (suc k)) (suc (suc (suc k))) (suc (suc (suc (suc k)))) (suc (suc (suc (suc (suc k))))) psi)) (sfK0CollectionRequest E r b t r a (suc k) z (suc (suc (suc k))) (suc (suc (suc (suc k)))) (suc (suc (suc (suc (suc k))))) psi)) $;

theorem sfK0Collection_allocated_initial (E: set) (n b t r a k psi: nat) (hf: $ sfBound (suc (suc n)) psi $) (hk: $ 0 < k $)
 (hb: $ b < k $) (ht: $ t < k $) (hr: $ r < k $) (ha: $ a < k $)
 (he: $ sqEnvBelow E n k $):
 $ k218QProvable (kImp (kImp (kImp (kAll (suc (suc k)) (sfK0CollectionRequest E r b t r a (suc k) (suc (suc k)) (suc (suc (suc k))) (suc (suc (suc (suc k)))) (suc (suc (suc (suc (suc k))))) psi)) (kImp (sfK0CollectionSupport E b t r a (suc k) (suc (suc (suc k))) (suc (suc k)) (suc (suc (suc (suc k)))) (suc (suc (suc (suc (suc k))))) psi) kF)) kF) (kImp (kImp (kEq r t) kF) (kImp (kAll (suc (suc (suc (suc k)))) (kImp (sfK0QSepNamedSingleton (suc (suc (suc (suc k)))) r (suc (suc (suc (suc (suc k)))))) kF)) (kImp (kAll (suc (suc (suc (suc k)))) (kImp (kMem (suc (suc (suc (suc k)))) t) kF)) (kImp (kImp (kMem b (suc k)) (kImp (kMem t (suc k)) kF)) kF))))) $;

def sfK0CollectionAllocatedBody (E: set) (b t r a k psi: nat): nat = $ (kImp (kImp (kAll (suc (suc k)) (sfK0CollectionRequest E r b t r a (suc k) (suc (suc k)) (suc (suc (suc k))) (suc (suc (suc (suc k)))) (suc (suc (suc (suc (suc k))))) psi)) (kImp (sfK0CollectionSupport E b t r a (suc k) (suc (suc (suc k))) (suc (suc k)) (suc (suc (suc (suc k)))) (suc (suc (suc (suc (suc k))))) psi) kF)) kF) $;

theorem sfK0Collection_allocated_source (E: set) (n b t r a k psi: nat) (hf: $ sfBound (suc (suc n)) psi $) (hk: $ 0 < k $)
 (hb: $ b < k $) (ht: $ t < k $) (hr: $ r < k $) (ha: $ a < k $)
 (he: $ sqEnvBelow E n k $):
 $ sfK0CollectionWitness E r b t r a k psi = (kImp (kAll (suc k) (kImp (sfK0CollectionAllocatedBody E b t r a k psi) kF)) kF) $;

theorem sfK0Collection_allocated_open (E: set) (n b t r a k psi: nat) (hf: $ sfBound (suc (suc n)) psi $) (hk: $ 0 < k $)
 (hb: $ b < k $) (ht: $ t < k $) (hr: $ r < k $) (ha: $ a < k $)
 (he: $ sqEnvBelow E n k $):
 $ k218QProvable (kImp (kAll (suc k) (kImp (sfK0CollectionAllocatedBody E b t r a k psi) kF)) kF) $;
