import "source_piece_pcf_rep_cover_consumer_r40.mm0";

theorem sfPieceRepEnvironmentCover_eq(A C n B D:nat)(ha:$ A = B $)(hc:$ C = D $): $ sfPieceRepEnvironmentCover A C n = sfPieceRepEnvironmentCover B D n $;

theorem sfPieceRepEnvironmentCover_subst(k t A C n:nat): $ sfSubst k t (sfPieceRepEnvironmentCover A C n) = sfPieceRepEnvironmentCover (sfSubstIndex k t A) (sfSubstIndex k t C) n $;

theorem sfPieceRepCoverFormula_use(G n A B C:nat): $ nsLocal G (sfPieceRepCoverFormula n) -> nsLocal G (sfPieceRepSuccessor A B) -> nsLocal G (sfPieceRepClosure B C) -> nsLocal G (sfPieceRepEnvironmentCover A C n) $;
