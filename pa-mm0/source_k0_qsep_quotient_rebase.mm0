import "k218q_quotient_mixed_rebase.mm0";

def sfK0QSepQuotientBody (E: set) (t a c z M K phi: nat): nat =
 $ kAnd (kMem t c) (kAll z (kImp (kMem t z)
   (kAnd (kImp (sqMember t z c M) (kAnd (sqMember t z a M) (sqQuote (sqEnvCons z E) t K 0 phi)))
         (kImp (kAnd (sqMember t z a M) (sqQuote (sqEnvCons z E) t K 0 phi)) (sqMember t z c M))))) $;

theorem sfK0QSepQuotient_body_rebase (E: set) (n t a c z M R phi: nat) (hf: $ sfBound (suc n) phi $) (hM0: $ 0 < M $)
 (htM: $ t < M $) (hzM: $ z < M $) (hMR: $ M < R $)
 (heM: $ sqEnvBelow E n M $) (heR: $ sqEnvBelow E n R $):
 $ k218IEquivalent (sfK0QSepQuotientBody E t a c z M R phi) (sfK0QSepQuotientBody E t a c z M M phi) $;

theorem sfK0QSepQuotient_exists_rebase (E: set) (n t a c z M R phi: nat) (hf: $ sfBound (suc n) phi $) (hM0: $ 0 < M $)
 (htM: $ t < M $) (hzM: $ z < M $) (hMR: $ M < R $)
 (heM: $ sqEnvBelow E n M $) (heR: $ sqEnvBelow E n R $):
 $ k218IEquivalent (kExists c (sfK0QSepQuotientBody E t a c z M R phi)) (kExists c (sfK0QSepQuotientBody E t a c z M M phi)) $;
