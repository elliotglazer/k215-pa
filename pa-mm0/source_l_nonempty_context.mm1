import "source_contexts.mm1";

pub theorem sfLNEContext_skip (a G D: nat) (h: $ sfContextSub G D $):
  $ sfContextSub G (a : D) $ =
'(ax_mp (ax_mp sfContextSub_trans h) sfContextSub_cons);
pub theorem sfLNEContext_adjoin (a G D: nat)
  (ha: $ a IN D $) (h: $ sfContextSub G D $):
  $ sfContextSub (a : G) D $ =
'(mpbir (sseq1 (nseq lmemsS)) (mpbir insss (ian ha h)));
pub theorem sfLNEContext_keep (a G D: nat) (h: $ sfContextSub G D $):
  $ sfContextSub (a : G) (a : D) $ =
'(sfLNEContext_adjoin sfContext_member_head (sfLNEContext_skip h));
