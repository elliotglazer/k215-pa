do { (set-timeout 5000) };

-- Lane L02: Power Set holds in L, unconditionally (ZFR proves Power^L).
pub theorem sfLPower_image_zfr: $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcPower) $ =
 '(sfLPower_image_from_definability sfLPairCommon2_zfr
   (sfLDefinabilityLaw_from_core (ax_mp sfBound_wf sfLPowerSubsetFormula_bound)
     (sfLCoreDefinabilityLaw_zfr sfLPowerSubsetFormula_bound)));
