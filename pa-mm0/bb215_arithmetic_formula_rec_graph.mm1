import "bb215_arithmetic_formula_finite_code.mm1";

@_ abstract def bb215ArithmeticFormulaHistoryCell (a i y: nat): wff = $ bb215ArithmeticFormulaFiniteCell (fst a) (snd a) (i, y) $;

@_ abstract def bb215ArithmeticFormulaRecValues (z: nat) (S: set) (.i: nat): set = $ \ i, rec z S i $;

pub theorem bb215ArithmeticFormulaRecValues_at (z i: nat) (S: set): $ bb215ArithmeticFormulaRecValues z S @ i = rec z S i $ = (named '(!! applame j ,eqtac));

@_ abstract def bb215ArithmeticFormulaRecCharacterization (a z: nat) (S: set) (n .i .y: nat): wff = $ A. i A. y (bb215ArithmeticFormulaHistoryCell a i y <-> i <= n /\ y = rec z S i) $;

theorem bb215ArithmeticFormulaRecCharacterization_index (a z n i: nat) (S: set) {y: nat}: $ bb215ArithmeticFormulaRecCharacterization a z S n -> A. y (bb215ArithmeticFormulaHistoryCell a i y <-> i <= n /\ y = rec z S i) $ = (named '(!! eale j ,eqtac));

theorem bb215ArithmeticFormulaRecCharacterization_point (a z n i y: nat) (S: set): $ bb215ArithmeticFormulaRecCharacterization a z S n -> (bb215ArithmeticFormulaHistoryCell a i y <-> i <= n /\ y = rec z S i) $ = (named '(rsyl (!! bb215ArithmeticFormulaRecCharacterization_index j) (!! eale j ,eqtac)));

theorem bb215ArithmeticFormulaRecCode_rewrite (a z n: nat) (S: set) {i y: nat}: $ (A. i A. y (bb215ArithmeticFormulaHistoryCell a i y <-> i < suc n /\ y = bb215ArithmeticFormulaRecValues z S @ i)) <-> bb215ArithmeticFormulaRecCharacterization a z S n $ = (named '(!! aleqi i @ !! aleqi y @ bieq2 (aneq (bicom leltsuc) (eqeq2 bb215ArithmeticFormulaRecValues_at))));

theorem bb215ArithmeticFormulaRecCharacterization_exists (z n: nat) (S: set) {a: nat}: $ E. a bb215ArithmeticFormulaRecCharacterization a z S n $ = (named '(mpbi (!! exeqi a bb215ArithmeticFormulaRecCode_rewrite) bb215ArithmeticFormulaFiniteCode_exists));

@_ abstract def bb215ArithmeticFormulaRecClosure (a: nat) (S: set) (n .i .x: nat): wff = $ A. i (i < n -> A. x (bb215ArithmeticFormulaHistoryCell a i x -> bb215ArithmeticFormulaHistoryCell a (suc i) (S @ x))) $;

@_ abstract def bb215ArithmeticFormulaRecCertificate (a z: nat) (S: set) (n v .y: nat): wff = $ bb215ArithmeticFormulaHistoryCell a 0 z /\ bb215ArithmeticFormulaRecClosure a S n /\ A. y (bb215ArithmeticFormulaHistoryCell a n y -> y = v) $;

@_ abstract def bb215ArithmeticFormulaRecGraph (z: nat) (S: set) (n v .a: nat): wff = $ E. a bb215ArithmeticFormulaRecCertificate a z S n v $;

theorem bb215ArithmeticFormulaRecClosure_index (a n i: nat) (S: set) {x: nat}: $ bb215ArithmeticFormulaRecClosure a S n -> i < n -> A. x (bb215ArithmeticFormulaHistoryCell a i x -> bb215ArithmeticFormulaHistoryCell a (suc i) (S @ x)) $ = (named '(!! eale j ,eqtac));

theorem bb215ArithmeticFormulaRecClosure_body (a i x: nat) (S: set) {y: nat}: $ (A. y (bb215ArithmeticFormulaHistoryCell a i y -> bb215ArithmeticFormulaHistoryCell a (suc i) (S @ y))) -> bb215ArithmeticFormulaHistoryCell a i x -> bb215ArithmeticFormulaHistoryCell a (suc i) (S @ x) $ = (named '(!! eale y ,eqtac));

theorem bb215ArithmeticFormulaRecClosure_at (a n i x: nat) (S: set): $ bb215ArithmeticFormulaRecClosure a S n -> i < n -> bb215ArithmeticFormulaHistoryCell a i x -> bb215ArithmeticFormulaHistoryCell a (suc i) (S @ x) $ = (named '(syl (imim2i (!! bb215ArithmeticFormulaRecClosure_body j)) (!! bb215ArithmeticFormulaRecClosure_index j)));

theorem bb215ArithmeticFormulaRecCertificate_step (a z n v i x: nat) (S: set): $ bb215ArithmeticFormulaRecCertificate a z S n v -> i < n -> bb215ArithmeticFormulaHistoryCell a i x -> bb215ArithmeticFormulaHistoryCell a (suc i) (S @ x) $ = (named '(syl bb215ArithmeticFormulaRecClosure_at anlr));

theorem bb215ArithmeticFormulaRecCertificate_initial (a z n v: nat) (S: set): $ bb215ArithmeticFormulaRecCertificate a z S n v -> bb215ArithmeticFormulaHistoryCell a 0 (rec z S 0) $ = (named '(mpbid (a1i (bb215ArithmeticFormulaHistoryCelleq3 (eqcom rec0))) anll));

theorem bb215ArithmeticFormulaRecCertificate_runs (a z n v i: nat) (S: set): $ bb215ArithmeticFormulaRecCertificate a z S n v -> i <= n -> bb215ArithmeticFormulaHistoryCell a i (rec z S i) $ = (named @ induct '(indd) 'i '(a1d bb215ArithmeticFormulaRecCertificate_initial) '(exp (mpbid (a1i (bb215ArithmeticFormulaHistoryCelleq3 (eqcom recS))) (mpd (mpd (syl ltle anr) (syl anr anl)) (mpd anr (syl bb215ArithmeticFormulaRecCertificate_step anll))))));

theorem bb215ArithmeticFormulaRecCertificate_final_index (a z n v: nat) (S: set) {j: nat}: $ bb215ArithmeticFormulaRecCertificate a z S n v -> A. j (bb215ArithmeticFormulaHistoryCell a n j -> j = v) $ = (named 'anr);

theorem bb215ArithmeticFormulaRecCertificate_final (a z n v y: nat) (S: set): $ bb215ArithmeticFormulaRecCertificate a z S n v -> bb215ArithmeticFormulaHistoryCell a n y -> y = v $ = (named '(rsyl (!! bb215ArithmeticFormulaRecCertificate_final_index j) (!! eale j ,eqtac)));

theorem bb215ArithmeticFormulaRecCertificate_sound (a z n v: nat) (S: set): $ bb215ArithmeticFormulaRecCertificate a z S n v -> rec z S n = v $ = (named '(mpd (mpd (a1i leid) bb215ArithmeticFormulaRecCertificate_runs) bb215ArithmeticFormulaRecCertificate_final));

pub theorem bb215ArithmeticFormulaRecGraph_sound (z n v: nat) (S: set): $ bb215ArithmeticFormulaRecGraph z S n v -> rec z S n = v $ = (named '(!! eex a bb215ArithmeticFormulaRecCertificate_sound));

theorem bb215ArithmeticFormulaRecCharacterization_initial (a z n: nat) (S: set): $ bb215ArithmeticFormulaRecCharacterization a z S n -> bb215ArithmeticFormulaHistoryCell a 0 z $ = (named '(mpbird bb215ArithmeticFormulaRecCharacterization_point (iand (a1i le01) (a1i (eqcom rec0)))));

theorem bb215ArithmeticFormulaRecCharacterization_closure (a z n: nat) (S: set): $ bb215ArithmeticFormulaRecCharacterization a z S n -> bb215ArithmeticFormulaRecClosure a S n $ = (named '(!! iald i @ exp @ !! iald x @ exp (mpbird (syl bb215ArithmeticFormulaRecCharacterization_point anll) (iand anlr (eqtrd (appeq2d (syl anr (mpbid (syl bb215ArithmeticFormulaRecCharacterization_point anll) anr))) (a1i (eqcom recS)))))));

theorem bb215ArithmeticFormulaRecCharacterization_final (a z n: nat) (S: set): $ bb215ArithmeticFormulaRecCharacterization a z S n -> A. y (bb215ArithmeticFormulaHistoryCell a n y -> y = rec z S n) $ = (named '(!! iald y @ syl (imim2i anr) (bi1d bb215ArithmeticFormulaRecCharacterization_point)));

theorem bb215ArithmeticFormulaRecCharacterization_certificate (a z n: nat) (S: set): $ bb215ArithmeticFormulaRecCharacterization a z S n -> bb215ArithmeticFormulaRecCertificate a z S n (rec z S n) $ = (named '(iand (iand bb215ArithmeticFormulaRecCharacterization_initial bb215ArithmeticFormulaRecCharacterization_closure) bb215ArithmeticFormulaRecCharacterization_final));

pub theorem bb215ArithmeticFormulaRecGraph_witness (z n: nat) (S: set): $ bb215ArithmeticFormulaRecGraph z S n (rec z S n) $ = (named '(ax_mp (!! eximi a bb215ArithmeticFormulaRecCharacterization_certificate) bb215ArithmeticFormulaRecCharacterization_exists));

pub theorem bb215ArithmeticFormulaRecGraph_correct (z n v: nat) (S: set): $ bb215ArithmeticFormulaRecGraph z S n v <-> rec z S n = v $ = (named '(ibii bb215ArithmeticFormulaRecGraph_sound (mpbii bb215ArithmeticFormulaRecGraph_witness (bb215ArithmeticFormulaRecGrapheq4d id))));
