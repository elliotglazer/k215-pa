import "source_reflection_transfer_cover_profile.mm0";

def sfReflectionPHProducerContext(level:nat):nat = $ (sfReflectionHierarchySubsetNormal level) : (sfReflectionOrdinalSubsetCompare : ((sfReflectionCondLevelExists level) : ((sfReflectionLimitCoverageLaw level) : 0))) $;

def sfReflectionPH3Law(T:set)(start domain level sb sc n i:nat):nat = $ sfImp (sfReflectionLimitProfile level (sfPieceBinary domain (sfReflectionPCLevel level) sb sc n)) (sfImp (sfORBinary level 0 3) (sfImp (sfReflectionTuple T start 3 (sfPieceCount sb sc i)) (sfReflectionTupleEw T start domain (sfPieceMatrix sb sc i) 3))) $;

theorem sfReflectionPH3_from_producers_local(T F:set)(start domain level sb sc n i:nat)(hd:$ sfBound 1 domain $)(hl:$ sfBound 2 level $)(hv:$ sfPieceTableValid sb sc n $)(hi:$ i < n $): $ nsLocal (sfReflectionPHProducerContext level) (sfReflectionPH3Law T start domain level sb sc n i) $;

theorem sfReflectionPH3_from_producers(T F:set)(start domain level sb sc n i:nat)(hd:$ sfBound 1 domain $)(hl:$ sfBound 2 level $)(hv:$ sfPieceTableValid sb sc n $)(hi:$ i < n $)(hE:$ sfTheoryProvable zfrAxioms (sfReflectionCondLevelExists level) $)(hS:$ sfTheoryProvable zfrAxioms (sfReflectionHierarchySubsetNormal level) $)(hC:$ sfTheoryProvable zfrAxioms (sfReflectionLimitCoverageLaw level) $): $ sfTheoryProvable zfrAxioms (sfReflectionPH3Law T start domain level sb sc n i) $;
