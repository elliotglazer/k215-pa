import "pa_source_interpretation_nat_term_substitution.mm0";

def paNatTermConsEnvironment (E: set) (v .i: nat): set = $ \ i, if (i = 0) v (E @ (i - 1)) $;

theorem paNatTermConsEnvironment_value (E: set) (v i: nat): $ paNatTermConsEnvironment E v @ i = if (i = 0) v (E @ (i - 1)) $;

theorem paNatTermConsEnvironment_zero (E: set) (v: nat): $ paNatTermConsEnvironment E v @ 0 = v $;

theorem paNatTermConsEnvironment_suc (E: set) (v i: nat): $ paNatTermConsEnvironment E v @ suc i = E @ i $;
