import "k215_literal_runtime_native_coverage.mm1";
import "k215_literal_runtime_native_reverse.mm1";

theorem k215PNativeSpan_law_at (g s w r: nat):
 $ k215PNativeSpan 0 k215PNum4751 -> k215PInRange s -> k215PNativeOutcome g s w r $ =
 '(exp @ mpbid (a1i (k215PNativeOutcomeeq2 k215PState_rebuild))
   (syl k215PNativeRow_at (mpd (iand (a1i le01) anr) (syl k215PNativeSpan_at anl))));
pub theorem k215PNativeSpan_law:
 $ k215PNativeSpan 0 k215PNum4751 -> k215PNativeLaw $ =
 (named '(iald @ iald @ iald @ iald k215PNativeSpan_law_at));
