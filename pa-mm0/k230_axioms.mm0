import "k230_codes.mm0";

-- The numeric axiom family of Thm230.v, with no formula-class parameter.
def kAxBody (n a b c u: nat): wff =
$ n = kRho1 a b \/ (n = kRho2 a b c \/ (n = kRho3 a b c \/
 (n = kRho4 a b c \/ (n = kRho5 a b c \/ (n = kRho6 a b \/
 (n = kRho7 a b c \/ (n = kRho8 a b c u \/
 (c != a /\ c != b /\ n = kBundle a b c)))))))) $;

def kAxioms (.n .a .b .c .u: nat): set =
$ {n | n = 0 \/ E. a E. b E. c E. u kAxBody n a b c u} $;

theorem kAxioms_value {a b c u: nat} (n: nat):
  $ n e. kAxioms <-> n = 0 \/ E. a E. b E. c E. u kAxBody n a b c u $;
theorem kAxioms_true: $ 0 e. kAxioms $;
theorem kAxioms_instance (n a b c u: nat):
  $ kAxBody n a b c u -> n e. kAxioms $;
theorem kAxioms_rho1 (a b: nat): $ kRho1 a b e. kAxioms $;
theorem kAxioms_rho2 (a b c: nat): $ kRho2 a b c e. kAxioms $;
theorem kAxioms_rho3 (a b c: nat): $ kRho3 a b c e. kAxioms $;
theorem kAxioms_rho4 (a b c: nat): $ kRho4 a b c e. kAxioms $;
theorem kAxioms_rho5 (a b c: nat): $ kRho5 a b c e. kAxioms $;
theorem kAxioms_rho6 (a b: nat): $ kRho6 a b e. kAxioms $;
theorem kAxioms_rho7 (a b c: nat): $ kRho7 a b c e. kAxioms $;
theorem kAxioms_rho8 (a b c u: nat): $ kRho8 a b c u e. kAxioms $;
theorem kAxioms_bundle (a b c: nat): $ c != a /\ c != b -> kBundle a b c e. kAxioms $;
