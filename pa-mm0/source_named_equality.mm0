import "k218_role_substitution.mm0";

import "quotation_binders_absent.mm0";

import "k218q_leibniz.mm0";

import "quotation_supported_environment.mm0";

theorem sfNamed_binary_input_congr_meta (E: set) (n R y u v psi: nat) (h0: $ sfBound (suc (suc n)) psi $) (h1: $ u < R $) (h2: $ v < R $) (h3: $ u != 0 $) (h4: $ u != y $) (h5: $ sqEnvAvoid E n u $):
 $ k218QProvable (kImp (kEq u v) (kImp (sfNamedTemplate (sqEnvCons y (sqEnvCons u E)) R 0 psi) (sfNamedTemplate (sqEnvCons y (sqEnvCons v E)) R 0 psi))) $;

def sneSafeEnvironment (P: wff) (E: set) (.i: nat): set = $ {i | ifp P (i e. E) (i e. sqZeroEnvironment)} $;

def sneResult (E: set) (R y u v psi: nat): nat = $ kImp (kEq u v) (kImp (sfNamedTemplate (sqEnvCons y (sqEnvCons u E)) R 0 psi) (sfNamedTemplate (sqEnvCons y (sqEnvCons v E)) R 0 psi)) $;

theorem sfNamed_binary_input_congr_d (G: wff) (E: set) (n R y u v psi: nat) (h0: $ G -> sfBound (suc (suc n)) psi $) (h1: $ G -> u < R $) (h2: $ G -> v < R $) (h3: $ G -> u != 0 $) (h4: $ G -> u != y $) (h5: $ G -> sqEnvAvoid E n u $):
 $ G -> k218QProvable (kImp (kEq u v) (kImp (sfNamedTemplate (sqEnvCons y (sqEnvCons u E)) R 0 psi) (sfNamedTemplate (sqEnvCons y (sqEnvCons v E)) R 0 psi))) $;

theorem sfNamed_binary_input_congr (E: set) (n R y u v psi: nat):
 $ sfBound (suc (suc n)) psi -> u < R -> v < R -> u != 0 -> u != y -> sqEnvAvoid E n u -> k218QProvable (kImp (kEq u v) (kImp (sfNamedTemplate (sqEnvCons y (sqEnvCons u E)) R 0 psi) (sfNamedTemplate (sqEnvCons y (sqEnvCons v E)) R 0 psi))) $;
