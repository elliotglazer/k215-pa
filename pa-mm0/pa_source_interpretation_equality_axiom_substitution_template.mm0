def paSIEQSMapCons (a: nat) (R: set) (.i: nat): set = $ \ i, if (i = 0) a (R @ (i - 1)) $;

def paSIEQSMapAdd (t .i: nat): set = $ \ i, i + t $;

def paSIEQSMap1: set = $ paSIEQSMapAdd 1 $;

def paSIEqSubstF0 (phi tgraph ugraph p q guard: nat): nat = $ sfRename paSIEQSMap1 0 guard $;

def paSIEqSubstF1 (phi tgraph ugraph p q guard: nat): nat = $ sfRename paSIEQSMap1 0 q $;

def paSIEqSubstF2 (phi tgraph ugraph p q guard: nat): nat = $ sfImp phi (paSIEqSubstF1 phi tgraph ugraph p q guard) $;

def paSIEqSubstF3 (phi tgraph ugraph p q guard: nat): nat = $ sfImp ugraph (paSIEqSubstF2 phi tgraph ugraph p q guard) $;

def paSIEqSubstF4 (phi tgraph ugraph p q guard: nat): nat = $ sfImp (paSIEqSubstF0 phi tgraph ugraph p q guard) (paSIEqSubstF3 phi tgraph ugraph p q guard) $;

def paSIEqSubstF5 (phi tgraph ugraph p q guard: nat): nat = $ sfAll (paSIEqSubstF4 phi tgraph ugraph p q guard) $;

def paSIEqSubstF6 (phi tgraph ugraph p q guard: nat): nat = $ sfRename paSIEQSMap1 0 p $;

def paSIEqSubstF7 (phi tgraph ugraph p q guard: nat): nat = $ sfImp (paSIEqSubstF6 phi tgraph ugraph p q guard) phi $;

def paSIEqSubstF8 (phi tgraph ugraph p q guard: nat): nat = $ sfImp tgraph (paSIEqSubstF7 phi tgraph ugraph p q guard) $;

def paSIEqSubstF9 (phi tgraph ugraph p q guard: nat): nat = $ sfImp (paSIEqSubstF0 phi tgraph ugraph p q guard) (paSIEqSubstF8 phi tgraph ugraph p q guard) $;

def paSIEqSubstF10 (phi tgraph ugraph p q guard: nat): nat = $ sfAll (paSIEqSubstF9 phi tgraph ugraph p q guard) $;

def paSIEqSubstF11 (phi tgraph ugraph p q guard: nat): nat = $ sfRename paSIEQSMap1 0 tgraph $;

def paSIEQSMap3: set = $ paSIEQSMapAdd 2 $;

def paSIEQSMap2: set = $ paSIEQSMapCons 0 paSIEQSMap3 $;

def paSIEqSubstF12 (phi tgraph ugraph p q guard: nat): nat = $ sfRename paSIEQSMap2 0 ugraph $;

def paSIEqSubstF13 (phi tgraph ugraph p q guard: nat): nat = $ sfEq 1 0 $;

def paSIEqSubstF14 (phi tgraph ugraph p q guard: nat): nat = $ sfAnd (paSIEqSubstF12 phi tgraph ugraph p q guard) (paSIEqSubstF13 phi tgraph ugraph p q guard) $;

def paSIEqSubstF15 (phi tgraph ugraph p q guard: nat): nat = $ sfAnd (paSIEqSubstF11 phi tgraph ugraph p q guard) (paSIEqSubstF14 phi tgraph ugraph p q guard) $;

def paSIEqSubstF16 (phi tgraph ugraph p q guard: nat): nat = $ sfEx (paSIEqSubstF15 phi tgraph ugraph p q guard) $;

def paSIEqSubstF17 (phi tgraph ugraph p q guard: nat): nat = $ sfEx (paSIEqSubstF16 phi tgraph ugraph p q guard) $;

def paSIEqSubstF18 (phi tgraph ugraph p q guard: nat): nat = $ sfRename paSIEQSMap3 0 guard $;

def paSIEqSubstF19 (phi tgraph ugraph p q guard: nat): nat = $ sfRename paSIEQSMap2 0 phi $;

def paSIEqSubstF20 (phi tgraph ugraph p q guard: nat): nat = $ sfRename paSIEQSMap3 0 q $;

def paSIEqSubstF21 (phi tgraph ugraph p q guard: nat): nat = $ sfImp (paSIEqSubstF19 phi tgraph ugraph p q guard) (paSIEqSubstF20 phi tgraph ugraph p q guard) $;

def paSIEqSubstF22 (phi tgraph ugraph p q guard: nat): nat = $ sfImp (paSIEqSubstF12 phi tgraph ugraph p q guard) (paSIEqSubstF21 phi tgraph ugraph p q guard) $;

def paSIEqSubstF23 (phi tgraph ugraph p q guard: nat): nat = $ sfImp (paSIEqSubstF18 phi tgraph ugraph p q guard) (paSIEqSubstF22 phi tgraph ugraph p q guard) $;

def paSIEqSubstF24 (phi tgraph ugraph p q guard: nat): nat = $ sfAll (paSIEqSubstF23 phi tgraph ugraph p q guard) $;

def paSIEqSubstF25 (phi tgraph ugraph p q guard: nat): nat = $ sfRename paSIEQSMap2 0 tgraph $;

def paSIEqSubstF26 (phi tgraph ugraph p q guard: nat): nat = $ sfRename paSIEQSMap3 0 p $;

def paSIEqSubstF27 (phi tgraph ugraph p q guard: nat): nat = $ sfImp (paSIEqSubstF26 phi tgraph ugraph p q guard) (paSIEqSubstF19 phi tgraph ugraph p q guard) $;

def paSIEqSubstF28 (phi tgraph ugraph p q guard: nat): nat = $ sfImp (paSIEqSubstF25 phi tgraph ugraph p q guard) (paSIEqSubstF27 phi tgraph ugraph p q guard) $;

def paSIEqSubstF29 (phi tgraph ugraph p q guard: nat): nat = $ sfImp (paSIEqSubstF18 phi tgraph ugraph p q guard) (paSIEqSubstF28 phi tgraph ugraph p q guard) $;

def paSIEqSubstF30 (phi tgraph ugraph p q guard: nat): nat = $ sfAll (paSIEqSubstF29 phi tgraph ugraph p q guard) $;

def paSIEQSMap5: set = $ paSIEQSMapAdd 3 $;

def paSIEQSMap4: set = $ paSIEQSMapCons 1 paSIEQSMap5 $;

def paSIEqSubstF31 (phi tgraph ugraph p q guard: nat): nat = $ sfRename paSIEQSMap4 0 tgraph $;

def paSIEQSMap6: set = $ paSIEQSMapCons 0 paSIEQSMap5 $;

def paSIEqSubstF32 (phi tgraph ugraph p q guard: nat): nat = $ sfRename paSIEQSMap6 0 ugraph $;

def paSIEqSubstF33 (phi tgraph ugraph p q guard: nat): nat = $ sfAnd (paSIEqSubstF32 phi tgraph ugraph p q guard) (paSIEqSubstF13 phi tgraph ugraph p q guard) $;

def paSIEqSubstF34 (phi tgraph ugraph p q guard: nat): nat = $ sfAnd (paSIEqSubstF31 phi tgraph ugraph p q guard) (paSIEqSubstF33 phi tgraph ugraph p q guard) $;

def paSIEqSubstF35 (phi tgraph ugraph p q guard: nat): nat = $ sfEx (paSIEqSubstF34 phi tgraph ugraph p q guard) $;

def paSIEqSubstF36 (phi tgraph ugraph p q guard: nat): nat = $ sfEx (paSIEqSubstF35 phi tgraph ugraph p q guard) $;

def paSIEqSubstF37 (phi tgraph ugraph p q guard: nat): nat = $ sfRename paSIEQSMap5 0 guard $;

def paSIEqSubstF38 (phi tgraph ugraph p q guard: nat): nat = $ sfRename paSIEQSMap6 0 phi $;

def paSIEqSubstF39 (phi tgraph ugraph p q guard: nat): nat = $ sfRename paSIEQSMap5 0 q $;

def paSIEqSubstF40 (phi tgraph ugraph p q guard: nat): nat = $ sfImp (paSIEqSubstF38 phi tgraph ugraph p q guard) (paSIEqSubstF39 phi tgraph ugraph p q guard) $;

def paSIEqSubstF41 (phi tgraph ugraph p q guard: nat): nat = $ sfImp (paSIEqSubstF32 phi tgraph ugraph p q guard) (paSIEqSubstF40 phi tgraph ugraph p q guard) $;

def paSIEqSubstF42 (phi tgraph ugraph p q guard: nat): nat = $ sfImp (paSIEqSubstF37 phi tgraph ugraph p q guard) (paSIEqSubstF41 phi tgraph ugraph p q guard) $;

def paSIEqSubstF43 (phi tgraph ugraph p q guard: nat): nat = $ sfAll (paSIEqSubstF42 phi tgraph ugraph p q guard) $;

