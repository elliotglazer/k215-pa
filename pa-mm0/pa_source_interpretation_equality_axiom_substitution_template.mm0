def paSIEqSubstF45 (phi tgraph ugraph p q guard: nat): nat = $ sfRename paSIEQSMap5 0 p $;

def paSIEqSubstF46 (phi tgraph ugraph p q guard: nat): nat = $ sfImp (paSIEqSubstF45 phi tgraph ugraph p q guard) (paSIEqSubstF38 phi tgraph ugraph p q guard) $;

def paSIEqSubstF47 (phi tgraph ugraph p q guard: nat): nat = $ sfImp (paSIEqSubstF44 phi tgraph ugraph p q guard) (paSIEqSubstF46 phi tgraph ugraph p q guard) $;

def paSIEqSubstF48 (phi tgraph ugraph p q guard: nat): nat = $ sfImp (paSIEqSubstF37 phi tgraph ugraph p q guard) (paSIEqSubstF47 phi tgraph ugraph p q guard) $;

def paSIEqSubstF49 (phi tgraph ugraph p q guard: nat): nat = $ sfAll (paSIEqSubstF48 phi tgraph ugraph p q guard) $;

def paSIEQSMap8: set = $ paSIEQSMapAdd 4 $;

def paSIEQSMap7: set = $ paSIEQSMapCons 1 paSIEQSMap8 $;

def paSIEqSubstF50 (phi tgraph ugraph p q guard: nat): nat = $ sfRename paSIEQSMap7 0 tgraph $;

def paSIEQSMap9: set = $ paSIEQSMapCons 0 paSIEQSMap8 $;

def paSIEqSubstF51 (phi tgraph ugraph p q guard: nat): nat = $ sfRename paSIEQSMap9 0 ugraph $;

def paSIEqSubstF52 (phi tgraph ugraph p q guard: nat): nat = $ sfAnd (paSIEqSubstF51 phi tgraph ugraph p q guard) (paSIEqSubstF13 phi tgraph ugraph p q guard) $;

def paSIEqSubstF53 (phi tgraph ugraph p q guard: nat): nat = $ sfAnd (paSIEqSubstF50 phi tgraph ugraph p q guard) (paSIEqSubstF52 phi tgraph ugraph p q guard) $;

def paSIEqSubstF54 (phi tgraph ugraph p q guard: nat): nat = $ sfEx (paSIEqSubstF53 phi tgraph ugraph p q guard) $;

def paSIEqSubstF55 (phi tgraph ugraph p q guard: nat): nat = $ sfEx (paSIEqSubstF54 phi tgraph ugraph p q guard) $;

def paSIEqSubstF56 (phi tgraph ugraph p q guard: nat): nat = $ sfRename paSIEQSMap3 0 tgraph $;

def paSIEqSubstF57 (phi tgraph ugraph p q guard: nat): nat = $ sfEq 2 0 $;

def paSIEqSubstF58 (phi tgraph ugraph p q guard: nat): nat = $ sfAnd (paSIEqSubstF32 phi tgraph ugraph p q guard) (paSIEqSubstF57 phi tgraph ugraph p q guard) $;

def paSIEqSubstF59 (phi tgraph ugraph p q guard: nat): nat = $ sfAnd (paSIEqSubstF56 phi tgraph ugraph p q guard) (paSIEqSubstF58 phi tgraph ugraph p q guard) $;

def paSIEqSubstF60 (phi tgraph ugraph p q guard: nat): nat = $ sfEx (paSIEqSubstF59 phi tgraph ugraph p q guard) $;

