def paSIEqSubstF67 (phi tgraph ugraph p q guard: nat): nat = $ sfImp p q $;

def paSIEqSubstF68 (phi tgraph ugraph p q guard: nat): nat = $ sfImp (paSIEqSubstF17 phi tgraph ugraph p q guard) (paSIEqSubstF67 phi tgraph ugraph p q guard) $;

def paSIEqSubstF69 (phi tgraph ugraph p q guard: nat): nat = $ sfImp guard (paSIEqSubstF68 phi tgraph ugraph p q guard) $;

def paSIEqSubstF70 (phi tgraph ugraph p q guard: nat): nat = $ sfImp (paSIEqSubstF10 phi tgraph ugraph p q guard) (paSIEqSubstF69 phi tgraph ugraph p q guard) $;

