def paSourceEqualitySubstitutionValueLiteral (phi tgraph ugraph p q guard: nat): nat = $ sfImp (paSIEqSubstF5 phi tgraph ugraph p q guard) (paSIEqSubstF70 phi tgraph ugraph p q guard) $;

theorem paSourceEqualitySubstitutionValue_local (phi tgraph ugraph p q guard n: nat) (h0: $ sfBound (suc n) phi $) (h1: $ sfBound (suc n) tgraph $) (h2: $ sfBound (suc n) ugraph $) (h3: $ sfBound (suc n) p $) (h4: $ sfBound (suc n) q $) (h5: $ sfBound (suc n) guard $): $ nsLocal sfFormulaEqualityContext (paSourceEqualitySubstitutionValueLiteral phi tgraph ugraph p q guard) $;

def paSourceEqualityGraphForward (phi tgraph p guard: nat): nat = $ sfAll (sfImp (sfShift 0 guard) (sfImp tgraph (sfImp (sfShift 0 p) phi))) $;

def paSourceEqualityGraphBackward (phi ugraph q guard: nat): nat = $ sfAll (sfImp (sfShift 0 guard) (sfImp ugraph (sfImp phi (sfShift 0 q)))) $;

def paSourceEqualitySubstitutionValue (phi tgraph ugraph p q guard: nat): nat = $ sfImp (paSourceEqualityGraphBackward phi ugraph q guard) (sfImp (paSourceEqualityGraphForward phi tgraph p guard) (sfImp guard (sfImp (paSourceFormulaEqual tgraph ugraph) (sfImp p q)))) $;

theorem paSourceEqualitySubstitutionValue_exact (phi tgraph ugraph p q guard n: nat) (h0: $ sfBound (suc n) phi $) (h1: $ sfBound (suc n) tgraph $) (h2: $ sfBound (suc n) ugraph $) (h3: $ sfBound (suc n) p $) (h4: $ sfBound (suc n) q $) (h5: $ sfBound (suc n) guard $): $ paSourceEqualitySubstitutionValue phi tgraph ugraph p q guard = (paSourceEqualitySubstitutionValueLiteral phi tgraph ugraph p q guard) $;

theorem paSourceEqualitySubstitutionValue_provable (phi tgraph ugraph p q guard n: nat) (h0: $ sfBound (suc n) phi $) (h1: $ sfBound (suc n) tgraph $) (h2: $ sfBound (suc n) ugraph $) (h3: $ sfBound (suc n) p $) (h4: $ sfBound (suc n) q $) (h5: $ sfBound (suc n) guard $): $ zfcProvable (paSourceEqualitySubstitutionValue phi tgraph ugraph p q guard) $;
