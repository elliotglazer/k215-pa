import "k215_calculus_source_decode.mm0";
import "k215_calculus_source_nip_unpair.mm0";
import "k215_calculus_source_nip_comparison.mm0";

theorem k215NipHaltSource (u t w d h v: nat):
 $ h = 1 -> k215PReach (k215PState k215Num23 (k215PVector u t w 0 d h 0 0 v))
   (k215PState k215PNum4736 (k215PVector u t w 0 d 0 0 0 v)) $;

theorem k215NipPopSource (u t w d h v: nat):
 $ h != 1 -> k215PReach (k215PState k215Num23 (k215PVector u t w 0 d h 0 0 v))
   (k215PState 0 (k215PVector u t (snd w) 0 d (fst w) 0 0 v)) $;
