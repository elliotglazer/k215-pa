import "source_l_clstage_k2.mm0";

import "source_l_clstage_op5.mm0";

import "source_l_replacement_definability_from_parts.mm0";

-- The Definability Lemma chain with env_inC (sfLEnvLaw_zfr) and op-5 closure (sfLOp5Law_zfr)
-- discharged: only rep_ex (sfLRepLaw) and, for Replacement, NextLevel remain.
theorem sfLCoreDefinabilityLaw_from_rep(m psi:nat)(hb:$ sfBound (suc m) psi $)
 (hR:$ sfTheoryProvable zfrAxioms (sfLRepLaw m psi) $):
 $ sfTheoryProvable zfrAxioms (sfLCoreDefinabilityLaw m psi) $;

theorem sfLReplacementDefinableLaw_from_rep(m psi:nat)(hb:$ sfBound (suc m) psi $)
 (hR:$ sfTheoryProvable zfrAxioms (sfLRepLaw m psi) $)
 (hL:$ sfTheoryProvable zfrAxioms sfLNextLevelLaw $):
 $ sfTheoryProvable zfrAxioms (sfLReplacementDefinableLaw m psi) $;

theorem sfLDefPowerLiteral_from_rep
 (hR:$ sfTheoryProvable zfrAxioms (sfLRepLaw 1 sfLPowerSubsetFormula) $):
 $ sfTheoryProvable zfrAxioms sfLDefPowerLiteral $;
