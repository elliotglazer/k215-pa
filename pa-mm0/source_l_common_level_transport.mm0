import "source_l_common_level_syntax.mm0";
import "source_theory_prefix.mm0";
import "source_renaming_agreement.mm0";
import "source_domain_discharge.mm0";

theorem sfCLInstance_shift (c n d y: nat) (hc: $ sfBound n c $):
 $ sfShift 0 (sfRename (sfCLPairMap d y) 0 c) = sfRename (sfCLPairMap (suc d) (suc y)) 0 c $;

theorem sfCLOrdinalAt_shift (d: nat):
 $ sfShift 0 (sfCLOrdinalAt d) = sfCLOrdinalAt (suc d) $;

theorem sfCLHierarchyAt_shift (d y: nat):
 $ sfShift 0 (sfCLHierarchyAt d y) = sfCLHierarchyAt (suc d) (suc y) $;

theorem sfCLPoint_shift (start count d y: nat):
 $ sfShift 0 (sfCLPoint start count d y) = sfCLPoint (suc start) count (suc d) (suc y) $;

theorem sfCLUnary_instance (c d: nat) (hc: $ sfBound 1 c $):
 $ sfRename (sfCLPairMap d d) 0 c = sfSubst 0 d c $;

theorem sfCLOrdinalAt_subst (d: nat):
 $ sfCLOrdinalAt d = sfSubst 0 d sfCLOrdinal $;

theorem sfCLUnary_bound (c d k: nat) (hc: $ sfBound 1 c $):
 $ d < k -> sfBound k (sfSubst 0 d c) $;

theorem sfCLUnary_shift (c d: nat) (hc: $ sfBound 1 c $):
 $ sfShift 0 (sfSubst 0 d c) = sfSubst 0 (suc d) c $;

theorem sfCLPredicates_bound (c start count k: nat) (hc: $ sfBound 1 c $):
 $ sfCLNamesBound start count k -> sfBound k (sfCLPredicates c start count) $;

theorem sfCLPredicates_shift (c start count: nat) (hc: $ sfBound 1 c $):
 $ sfShift 0 (sfCLPredicates c start count) = sfCLPredicates c (suc start) count $;
