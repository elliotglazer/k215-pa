import "source_l_replacement_definable_bound.mm0";

import "source_l_common_level_instance_renaming.mm0";

def sfLReplacementDefinableEnv(T:set)(beta Y:nat):set =
 $ sqEnvCons Y (sqEnvCons beta T) $;

theorem sfLReplacementDefinableLaw_use(T:set)(G m psi beta Y:nat)
 (hb:$ sfBound (suc m) psi $)
 (hp:$ nsLocal G (sfLReplacementDefinableLaw m psi) $)
 (ho:$ nsLocal G (sfCLOrdinalAt beta) $)
 (hl:$ nsLocal G (sfCLHierarchyAt beta Y) $)
 (hm:$ sfCLRowProofs (sfCLBallMemberRows T Y) G m $):
 $ nsLocal G (sfLReplacementImageDefinable T sfLDomain psi Y) $;
