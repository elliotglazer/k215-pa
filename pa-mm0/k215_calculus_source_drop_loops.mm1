@_ def k215Loop4698State (pc x y z c: nat): nat = $ k215PState pc (k215PVector z x (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) y (k215PR7 c) (k215PR8 c)) $;

do (apply (register-eqd 'k215Loop4698State) '(k215Loop4698Stateeqd));

theorem k215Loop4698StepZ (y z c: nat): $ k215PStep (k215Loop4698State k215PNum4698 0 y z c) = (k215Loop4698State k215PNum4701 0 y z c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupExtraLoopsblocks_4698) (ifeq (eqeq1 k215PGet1_vector) eqid eqid)) (ifpos eqid));

theorem k215Loop4698StepS (x y z c: nat): $ k215PStep (k215Loop4698State k215PNum4698 (suc x) y z c) = (k215Loop4698State k215PNum4699 x y z c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupExtraLoopsblocks_4698) (ifeq (eqeq1 k215PGet1_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet1_vector)) (eqtr k215PSet1_vector (k215PVectoreq2 (eqtr subSS sub02))))));

theorem k215Loop4698Step1 (x y z c: nat): $ k215PStep (k215Loop4698State k215PNum4699 x y z c) = (k215Loop4698State k215PNum4700 x (suc y) z c) $ = '(eqtr (k215PAtCI k215PLookupExtraLoopsblocks_4699) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet6_vector)) k215PSet6_vector)));

theorem k215Loop4698Back (x y z c: nat): $ k215PStep (k215Loop4698State k215PNum4700 x y z c) = (k215Loop4698State k215PNum4698 x y z c) $ = '(k215PAtCC k215PLookupExtraLoopsblocks_4700);

theorem k215Loop4698Cycle1 (x y z c: nat): $ k215PIter 1 (k215Loop4698State k215PNum4698 (suc x) y z c) = (k215Loop4698State k215PNum4699 x y z c) $ = '(eqtr k215PIter_succ (eqtr (k215PStepeq k215PIter_zero) k215Loop4698StepS));

theorem k215Loop4698Cycle2 (x y z c: nat): $ k215PIter 2 (k215Loop4698State k215PNum4698 (suc x) y z c) = (k215Loop4698State k215PNum4700 x (suc y) z c) $ = '(eqtr k215PIter_succ (eqtr (k215PStepeq k215Loop4698Cycle1) k215Loop4698Step1));

theorem k215Loop4698Cycle3 (x y z c: nat): $ k215PIter 3 (k215Loop4698State k215PNum4698 (suc x) y z c) = (k215Loop4698State k215PNum4698 x (suc y) z c) $ = '(eqtr k215PIter_succ (eqtr (k215PStepeq k215Loop4698Cycle2) k215Loop4698Back));

@_ abstract def k215Loop4698Claim (x c: nat) (.y .z: nat): wff =
 $ A. y A. z k215PIter (3 * x + 1) (k215Loop4698State k215PNum4698 x y z c) = (k215Loop4698State k215PNum4701 0 (x + y) z c) $;
theorem k215Loop4698At (x y z c: nat): $ k215Loop4698Claim x c -> k215PIter (3 * x + 1) (k215Loop4698State k215PNum4698 x y z c) = (k215Loop4698State k215PNum4701 0 (x + y) z c) $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215Loop4698Base (y z c: nat): $ k215PIter (3 * 0 + 1) (k215Loop4698State k215PNum4698 0 y z c) = (k215Loop4698State k215PNum4701 0 (0 + y) z c) $ =
 '(eqtr (k215PItereq1 (eqtr (addeq1 mul0) add01))
   (eqtr k215PIter_succ (eqtr (k215PStepeq k215PIter_zero)
     (eqtr k215Loop4698StepZ (k215Loop4698Stateeq eqid eqid (eqcom add01) eqid eqid)))));
theorem k215Loop4698Inductive (x y z c: nat): $ k215Loop4698Claim x c -> k215PIter (3 * suc x + 1) (k215Loop4698State k215PNum4698 (suc x) y z c) = (k215Loop4698State k215PNum4701 0 (suc x + y) z c) $ =
 '(eqtrd (a1i (eqtr (k215PItereq1 k215EqTime_succ)
     (eqtr k215PIter_add (k215PItereq2 k215Loop4698Cycle3))))
   (eqtrd k215Loop4698At (a1i (k215Loop4698Stateeq eqid eqid (eqtr addS (eqcom addS1)) eqid eqid))));
theorem k215Loop4698All (x c: nat): $ k215Loop4698Claim x c $ =
 (named @ induct '(ind) 'x '(ax_gen (ax_gen k215Loop4698Base)) '(iald @ iald k215Loop4698Inductive));
