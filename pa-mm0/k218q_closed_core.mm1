import "k218q_parameter_close.mm1";

theorem k218CC_base (n: nat): $ 3 < 4 + n $ =
'(ltletr ltsucid leaddid1);

theorem k218CC_seed {i j: nat} (n f: nat)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218QProvable (k218ParameterFormula n (sfK218SeededCore f)) $ =
(named '(!! k218QSourceSeededCore_at i j k218CC_base
 k218ParameterNames_avoid1 k218ParameterNames_avoid3
 {k218ParameterNames_below : $ A. j (j < n -> sqNumericEnvironment (k218ParameterNames n) @ j < 4 + n) $}
 leid hf));

theorem k218CC_kp0 {i j: nat} (n f: nat)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218QProvable (k218ParameterFormula n (sfK218Kp0 f)) $ =
(named '(!! k218QSourceKp0_at i j k218CC_base
 k218ParameterNames_avoid1 k218ParameterNames_avoid3
 {k218ParameterNames_below : $ A. j (j < n -> sqNumericEnvironment (k218ParameterNames n) @ j < 4 + n) $}
 leid hf));

theorem k218CC_zero_formula (a: nat):
 $ k218ParameterFormula 0 a = sfNamedTemplate (sqNumericEnvironment 0) 4 0 a $ =
'(eqtr (k218ParameterTemplateeq1 k218ParameterNames_zero) (k218ParameterTemplateeq2 add0));

pub theorem k218QClosedSeededCore {i j: nat} (n f: nat)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218QProvable (sfNamedTemplate (sqNumericEnvironment 0) 4 0
     (sfAllPrefix n (sfK218SeededCore f))) $ =
(named '(mpbi (k218QProvableeq k218CC_zero_formula)
 (ax_mp (k218ParameterFormula_close sfK218SeededCore_wf) (!! k218CC_seed i j hf))));

pub theorem k218QClosedKp0 {i j: nat} (n f: nat)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218QProvable (sfNamedTemplate (sqNumericEnvironment 0) 4 0
     (sfAllPrefix n (sfK218Kp0 f))) $ =
(named '(mpbi (k218QProvableeq k218CC_zero_formula)
 (ax_mp (k218ParameterFormula_close sfK218Kp0_wf) (!! k218CC_kp0 i j hf))));
