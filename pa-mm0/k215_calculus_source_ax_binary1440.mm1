theorem k215BinaryUnpairInAt1440 (u t w c a b v: nat): $ (k215UnpairAt1440State k215PNum1440 0 0 w (k215PVector u t w c a b 0 0 v)) = (k215PState k215PNum1440 (k215PVector u t w c a b 0 0 v)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector eqid k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryUnpairOutAt1440 (u t w c a b v: nat): $ (k215UnpairAt1440State k215PNum1448 (fst w) (snd w) 0 (k215PVector u t w c a b 0 0 v)) = (k215PState k215PNum1448 (k215PVector u t 0 c a b (fst w) (snd w) v)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector eqid k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryUnpairAt1440 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum1440 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum1448 (k215PVector u t 0 c a b (fst w) (snd w) v)) $ =
 '(mpbi (k215PReacheq k215BinaryUnpairInAt1440 k215BinaryUnpairOutAt1440) k215UnpairMacro1440_clean);

theorem k215BinaryRestoreStackAt1440 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum1448 (k215PVector u t 0 c a b (fst w) (snd w) v)) (k215PState k215PNum1451 (k215PVector u t (snd w) c a b (fst w) 0 v)) $ =
 '(k215PReach_intro (eqtr k215Loop1448Vector (k215PStateeq2 (k215PVectoreq3 add0))));

theorem k215BinaryPairInAt1440 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt1451State k215PNum1451 a6 a1 a7 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum1451 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryPairOutAt1440 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt1451State k215PNum1461 0 0 (a7 + (a6, a1)) (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum1461 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryPairAt1440 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat):
 $ k215PReach (k215PState k215PNum1451 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215PNum1461 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ =
 '(mpbi (k215PReacheq k215BinaryPairInAt1440 k215BinaryPairOutAt1440) k215PairMacro1451);

theorem k215BinaryPairCleanAt1440 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum1451 (k215PVector u t (snd w) c a b (fst w) 0 v)) (k215PState k215PNum1461 (k215PVector u 0 (snd w) c a b 0 (fst w, t) v)) $ =
 '(mpbi (k215PReacheq2 (k215PStateeq2 (k215PVectoreq8 add01))) k215BinaryPairAt1440);
theorem k215BinaryFourAt1440 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum1461 (k215PVector u 0 (snd w) c a b 0 (fst w, t) v)) (k215PState k215PNum1467 (k215PVector u (4 * (fst w, t)) (snd w) c a b 0 0 v)) $ =
 '(k215PReach_intro (eqtr k215Loop1461Vector (k215PStateeq2 (k215PVectoreq2 add0))));

theorem k215BinaryTagAllAt1440 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum1467 (k215PVector u (4 * (fst w, t)) (snd w) c a b 0 0 v)) (k215PState k215PNum1467 (k215PVector u (kImp (fst w) t) (snd w) c a b 0 0 v)) $ = 'k215PReach_refl;

pub theorem k215BinaryConstructor1440 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum1440 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum1467 (k215PVector u (kImp (fst w) t) (snd w) c a b 0 0 v)) $ = '(ax_mp (ax_mp k215PReach_trans k215BinaryUnpairAt1440) (ax_mp (ax_mp k215PReach_trans k215BinaryRestoreStackAt1440) (ax_mp (ax_mp k215PReach_trans k215BinaryPairCleanAt1440) (ax_mp (ax_mp k215PReach_trans k215BinaryFourAt1440) k215BinaryTagAllAt1440))));

