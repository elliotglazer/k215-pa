import "source_reflection_transfer_tv_theory.mm0";

import "source_reflection_transfer_tv_existential.mm0";

import "source_l_common_level_setrel_bounds.mm0";

def sfTVReflectionWitness(n c:nat):nat = $ sfEx (sfAnd sfLeastOrdinalPredicate (sfCLReflection sfLDomain n c 0)) $;

theorem sfTVReflectionWitness_body_bound(n c:nat)(hb:$ sfBound n c $): $ sfBound 1 (sfAnd sfLeastOrdinalPredicate (sfCLReflection sfLDomain n c 0)) $;

theorem sfTVReflectionWitness_closed(n c:nat)(hb:$ sfBound n c $): $ sfBound 0 (sfTVReflectionWitness n c) $;

theorem sfTVReflectionWitness_from_output_local(n c:nat)(hb:$ sfBound n c $): $ nsLocal (sfTVReflectionContext sfLUniversalHierarchyRelation) (sfImp (sfReflectionLimitOutput sfLUniversalHierarchyRelation (sfTVCanonicalPiece n c)) (sfTVReflectionWitness n c)) $;

theorem sfTVReflectionWitness_from_output_zfr(n c:nat)(hb:$ sfBound n c $)(hE:$ sfTheoryProvable zfrAxioms (sfReflectionCondLevelExists sfLUniversalHierarchyRelation) $)(hS:$ sfTheoryProvable zfrAxioms (sfReflectionHierarchySubsetNormal sfLUniversalHierarchyRelation) $)(hC:$ sfTheoryProvable zfrAxioms (sfReflectionLimitCoverageLaw sfLUniversalHierarchyRelation) $): $ sfTheoryProvable zfrAxioms (sfImp (sfReflectionLimitOutput sfLUniversalHierarchyRelation (sfTVCanonicalPiece n c)) (sfTVReflectionWitness n c)) $;
