import "source_k0_qsep_tagged_substitution.mm0";

import "source_k0_qsep_tagged_branches.mm0";

import "source_k0_qsep_singleton.mm0";

theorem sfK0QSepTagged_root_seed (E: set) (r t b K theta: nat):
 $ k218QProvable (sfK0QSepNamedTagged E r t b r b K theta) $;

theorem sfK0QSepTagged_root_seed_exists (E: set) (n r t b c u y K theta: nat)
 (hf: $ sfBound (suc n) theta $)
 (hu0: $ u != 0 $) (hy0: $ y != 0 $)
 (huK: $ u < K $) (hyK: $ y < K $) (hrK: $ r < K $) (hbK: $ b < K $)
 (hru: $ r != u $) (htu: $ t != u $) (hbu: $ b != u $) (hcu: $ c != u $)
 (hyu: $ y != u $) (huy: $ u < y $) (hry: $ r < y $) (hby: $ b < y $)
 (hyr: $ y != r $) (hyt: $ y != t $) (hyb: $ y != b $) (hyc: $ y != c $)
 (heu: $ sqEnvAvoid E n u $) (hey: $ sqEnvAvoid E n y $):
 $ k218QProvable (kExists y (sfK0QSepNamedTagged E r t b r y K theta)) $;

theorem sfK0QSepTagged_root_return (E: set) (n r t b c u y K theta: nat)
 (hf: $ sfBound (suc n) theta $)
 (hu0: $ u != 0 $) (hy0: $ y != 0 $)
 (huK: $ u < K $) (hyK: $ y < K $) (hrK: $ r < K $) (hbK: $ b < K $)
 (hru: $ r != u $) (htu: $ t != u $) (hbu: $ b != u $) (hcu: $ c != u $)
 (hyu: $ y != u $) (huy: $ u < y $) (hry: $ r < y $) (hby: $ b < y $)
 (hyr: $ y != r $) (hyt: $ y != t $) (hyb: $ y != b $) (hyc: $ y != c $)
 (heu: $ sqEnvAvoid E n u $) (hey: $ sqEnvAvoid E n y $):
 $ k218QProvable (kImp (kAll u (sfK0QSepTaggedRequest E r t b c u y K theta)) (kExists y (kAnd (kMem y c) (sfK0QSepNamedTagged E r t b r y K theta)))) $;

theorem sfK0QSepTagged_root_member (E: set) (n r t b c u y K theta: nat)
 (hf: $ sfBound (suc n) theta $)
 (hu0: $ u != 0 $) (hy0: $ y != 0 $)
 (huK: $ u < K $) (hyK: $ y < K $) (hrK: $ r < K $) (hbK: $ b < K $)
 (hru: $ r != u $) (htu: $ t != u $) (hbu: $ b != u $) (hcu: $ c != u $)
 (hyu: $ y != u $) (huy: $ u < y $) (hry: $ r < y $) (hby: $ b < y $)
 (hyr: $ y != r $) (hyt: $ y != t $) (hyb: $ y != b $) (hyc: $ y != c $)
 (heu: $ sqEnvAvoid E n u $) (hey: $ sqEnvAvoid E n y $):
 $ k218QProvable (kImp (kImp (kEq r t) kF) (kImp (kAll y (kNot (sfK0QSepNamedSingleton y r K))) (kImp (kAll u (sfK0QSepTaggedRequest E r t b c u y K theta)) (kMem b c)))) $;
