import "k215_calculus_source_ax_stack_loops.mm0";
import "k215_literal_runtime_reach.mm0";
import "k215_calculus_source_pairing.mm0";
import "k215_calculus_source_ax_stack_lookups.mm0";

def k215UnpairAt4145State (pc a b n c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) n (k215PR3 c) (k215PR4 c) (k215PR5 c) a b (k215PR8 c)) $;

theorem k215UnpairAt4145Advance (a b n c: nat): $ k215PReach (k215UnpairAt4145State k215PNum4145 a b (suc n) c) (k215UnpairAt4145State k215PNum4145 (fst (suc (a, b))) (snd (suc (a, b))) n c) $;

def k215UnpairAt4145Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt4145State k215PNum4145 a b n c) (k215UnpairAt4145State k215PNum4153 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;

def k215UnpairAt4145Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt4145Run n a b c $;

theorem k215UnpairMacro4145 (n a b c: nat): $ k215PReach (k215UnpairAt4145State k215PNum4145 a b n c) (k215UnpairAt4145State k215PNum4153 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;

theorem k215UnpairMacro4145_clean (n c: nat): $ k215PReach (k215UnpairAt4145State k215PNum4145 0 0 n c) (k215UnpairAt4145State k215PNum4153 (fst n) (snd n) 0 c) $;
