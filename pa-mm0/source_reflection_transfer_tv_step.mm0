import "source_reflection_transfer_tv_quantifiers.mm0";

import "source_l_common_level_setrel.mm0";

theorem sfTVExists_local(G D a b y:nat)(hd:$ sfWf D $)(ha:$ sfWf a $)(hb:$ sfWf b $)(hI:$ nsLocal G (sfAll (sfImp (sfMem 0 (suc y)) (sfIff a b))) $)(hC:$ nsLocal G (sfAll (sfImp (sfMem 0 (suc y)) D)) $)(hE:$ nsLocal G (sfReflectionEwAt D a y) $): $ nsLocal G (sfIff (sfEx (sfAnd D a)) (sfEx (sfAnd (sfMem 0 (suc y)) b))) $;

theorem sfTVAll_local(G D a b y:nat)(hd:$ sfWf D $)(ha:$ sfWf a $)(hb:$ sfWf b $)(hI:$ nsLocal G (sfAll (sfImp (sfMem 0 (suc y)) (sfIff a b))) $)(hC:$ nsLocal G (sfAll (sfImp (sfMem 0 (suc y)) D)) $)(hE:$ nsLocal G (sfReflectionEwAt D (sfImp a sfBot) y) $): $ nsLocal G (sfIff (sfAll (sfImp D a)) (sfAll (sfImp (sfMem 0 (suc y)) b))) $;

theorem sfTV_Ex_relativizations(G D phi y:nat)(hd:$ sfWf D $)(hI:$ nsLocal G (sfAll (sfImp (sfMem 0 (suc y)) (sfIff (sfRelativize D phi) (sfCLSetRel (suc y) phi)))) $)(hC:$ nsLocal G (sfAll (sfImp (sfMem 0 (suc y)) D)) $)(hE:$ nsLocal G (sfReflectionEwAt D (sfRelativize D phi) y) $): $ nsLocal G (sfIff (sfRelativize D (sfEx phi)) (sfCLSetRel y (sfEx phi))) $;

theorem sfTV_All_relativizations(G D phi y:nat)(hd:$ sfWf D $)(hI:$ nsLocal G (sfAll (sfImp (sfMem 0 (suc y)) (sfIff (sfRelativize D phi) (sfCLSetRel (suc y) phi)))) $)(hC:$ nsLocal G (sfAll (sfImp (sfMem 0 (suc y)) D)) $)(hE:$ nsLocal G (sfReflectionEwAt D (sfImp (sfRelativize D phi) sfBot) y) $): $ nsLocal G (sfIff (sfRelativize D (sfAll phi)) (sfCLSetRel y (sfAll phi))) $;
