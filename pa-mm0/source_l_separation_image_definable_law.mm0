import "source_l_separation_image_producer_context.mm0";
import "source_l_replacement_definable_instances.mm0";

-- The generic definability law for the separation predicate yields the candidate
-- that the Separation-image producer consumes, in its exact reflected context.
theorem sfLSeparationImage_candidate_from_law(G n phi:nat)
 (hb:$ sfBound (suc n) phi $)
 (hD:$ nsLocal G (sfLReplacementDefinableLaw (suc n) (sfPieceSeparationPredicate phi)) $):
 $ nsLocal (sfLSeparationReflectedContext (sfLSeparationImageInputContext G n) n phi)
   (sfLSeparationImageCandidate (sfLSeparationImageParameterMap 2) sfLDomain phi 0 2) $;

-- The six stage facts and the definability law, all as ZFR theorems, give the
-- relativized Separation instance. The law is an explicit premise.
theorem sfLSeparationImage_schema_from_law_and_source_proofs(n phi:nat)
 (hb:$ sfBound (suc n) phi $)
 (hE:$ sfTheoryProvable zfrAxioms sfLReplacementLevelExtension $)
 (hA:$ sfTheoryProvable zfrAxioms (sfLReplacementAboveLaw (suc n) phi) $)
 (hL:$ sfTheoryProvable zfrAxioms sfLReplacementLevelExistsLaw $)
 (hS:$ sfTheoryProvable zfrAxioms (sfReflectionHierarchySubsetNormal sfCLHierarchy) $)
 (hT:$ sfTheoryProvable zfrAxioms sfLSeparationStageTransNormal $)
 (hZ:$ sfTheoryProvable zfrAxioms (sfCLRecipe 0 0) $)
 (hD:$ sfTheoryProvable zfrAxioms
   (sfLReplacementDefinableLaw (suc n) (sfPieceSeparationPredicate phi)) $):
 $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain (zfcSeparationCode phi n)) $;
