import "bb215_derivability_d3_equality.mm0";

-- L05, layer L2 (lanes/L05.md): substituting at depth d into a term lifted by d + 1 gives the
-- term lifted by d. Generalizes bb215D3_subst_lift (the case d = 0); needed to instantiate
-- laws with three or more universal variables.

def bb215L2LiftSubstClass (d t .c: nat): set = $ {c | paTermSubst d t (paTermLift (suc d) c) = paTermLift d c} $;

theorem bb215L2_subst_lift (n d t s: nat):
  $ paTermBound n s -> paTermSubst d t (paTermLift (suc d) s) = paTermLift d s $;
