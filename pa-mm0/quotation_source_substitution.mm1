@_ abstract def ntSourceShiftClass (E: set) (k z .c .d: nat): set =
$ {c | A. d (sfNamedTemplate (sqEnvCons z E) k d (sfShift d c) = sfNamedTemplate E k d (c))} $;

pub theorem ntSourceShift_value {d: nat} (E: set) (k z: nat) (c: nat):
 $ c e. ntSourceShiftClass E k z <-> A. d (sfNamedTemplate (sqEnvCons z E) k d (sfShift d c) = sfNamedTemplate E k d (c)) $ =
(named '(elabe ,eqtac));

theorem ntSourceShift_depth (E: set) (k z: nat) (d c: nat):
 $ A. j (sfNamedTemplate (sqEnvCons z E) k j (sfShift j c) = sfNamedTemplate E k j (c)) -> sfNamedTemplate (sqEnvCons z E) k d (sfShift d c) = sfNamedTemplate E k d (c) $ =
(named '(!! eale j ,eqtac));

theorem ntSourceShift_at (E: set) (k z: nat) (d c: nat):
 $ c e. ntSourceShiftClass E k z -> sfNamedTemplate (sqEnvCons z E) k d (sfShift d c) = sfNamedTemplate E k d (c) $ =
(named '(syl ntSourceShift_depth {(bi1 ntSourceShift_value) :
 $ c e. ntSourceShiftClass E k z -> A. j (sfNamedTemplate (sqEnvCons z E) k j (sfShift j c) = sfNamedTemplate E k j (c)) $}));

theorem ntSourceShift_bot (E: set) (k z: nat): $ sfBot e. ntSourceShiftClass E k z $ =
(named '(mpbir ntSourceShift_value @ ax_gen @ eqtr (sfNamedTemplateeq4 sfShift_bot) @
 eqtr sfNamedTemplate_bot (eqcom sfNamedTemplate_bot)));

theorem ntSourceShift_mem (E: set) (k z: nat) (a b: nat):
 $ sfMem a b e. ntSourceShiftClass E k z $ =
(named '(mpbir ntSourceShift_value @ ax_gen @ eqtr (sfNamedTemplateeq4 sfShift_sfMem) @
 eqtr sfNamedTemplate_sfMem (eqtr (kMemeq sfNamedIndex_source_shift sfNamedIndex_source_shift) (eqcom sfNamedTemplate_sfMem))));

