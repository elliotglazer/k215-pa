theorem qqSourceSubst_and (E: set) (t k i: nat) (a b: nat):
 $ a e. qqSourceSubstClass E t k i /\ b e. qqSourceSubstClass E t k i -> sfAnd a b e. qqSourceSubstClass E t k i $ =
(named '(mpbird (a1i qqSourceSubst_value) @ !! iald d @
 eqtrd (a1i (sqQuoteeq5 sfSubst_sfAnd)) @ eqtrd (a1i sqQuote_sfAnd) @
 eqtrd (kAndeqd (syl qqSourceSubst_at anl) (syl qqSourceSubst_at anr))
 (a1i (eqcom sqQuote_sfAnd))));

theorem qqSourceSubst_or (E: set) (t k i: nat) (a b: nat):
 $ a e. qqSourceSubstClass E t k i /\ b e. qqSourceSubstClass E t k i -> sfOr a b e. qqSourceSubstClass E t k i $ =
(named '(mpbird (a1i qqSourceSubst_value) @ !! iald d @
 eqtrd (a1i (sqQuoteeq5 sfSubst_sfOr)) @ eqtrd (a1i sqQuote_sfOr) @
 eqtrd (kDisjeqd (syl qqSourceSubst_at anl) (syl qqSourceSubst_at anr))
 (a1i (eqcom sqQuote_sfOr))));

theorem qqSourceSubst_imp (E: set) (t k i: nat) (a b: nat):
 $ a e. qqSourceSubstClass E t k i /\ b e. qqSourceSubstClass E t k i -> sfImp a b e. qqSourceSubstClass E t k i $ =
(named '(mpbird (a1i qqSourceSubst_value) @ !! iald d @
 eqtrd (a1i (sqQuoteeq5 sfSubst_sfImp)) @ eqtrd (a1i sqQuote_sfImp) @
 eqtrd (kImpeqd (syl qqSourceSubst_at anl) (syl qqSourceSubst_at anr))
 (a1i (eqcom sqQuote_sfImp))));

theorem qqSourceSubst_binary (E: set) (t k i: nat): $ sfBinaryClosed (qqSourceSubstClass E t k i) $ =
(named '(ax_gen @ ax_gen @ iand (iand qqSourceSubst_and qqSourceSubst_or) qqSourceSubst_imp));

theorem qqSourceSubst_all (E: set) (t k i: nat) (a: nat):
 $ a e. qqSourceSubstClass E t k i -> sfAll a e. qqSourceSubstClass E t k i $ =
(named '(mpbird (a1i qqSourceSubst_value) @ !! iald d @
 eqtrd (a1i (sqQuoteeq5 sfSubst_sfAll)) @ eqtrd (a1i sqQuote_sfAll) @
 eqtrd (kAlleqd eqidd (kImpeqd eqidd qqSourceSubst_at)) (a1i (eqcom sqQuote_sfAll))));

theorem qqSourceSubst_ex (E: set) (t k i: nat) (a: nat):
 $ a e. qqSourceSubstClass E t k i -> sfEx a e. qqSourceSubstClass E t k i $ =
(named '(mpbird (a1i qqSourceSubst_value) @ !! iald d @
 eqtrd (a1i (sqQuoteeq5 sfSubst_sfEx)) @ eqtrd (a1i sqQuote_sfEx) @
 eqtrd (kExistseqd eqidd (kAndeqd eqidd qqSourceSubst_at)) (a1i (eqcom sqQuote_sfEx))));

theorem qqSourceSubst_quantifier (E: set) (t k i: nat): $ sfQuantifierClosed (qqSourceSubstClass E t k i) $ =
(named '(ax_gen @ iand qqSourceSubst_all qqSourceSubst_ex));

theorem qqSourceSubst_closed (E: set) (t k i: nat): $ sfConstructionClosed (qqSourceSubstClass E t k i) $ =
'(ian (ian (ian qqSourceSubst_bot qqSourceSubst_atomic) qqSourceSubst_binary) qqSourceSubst_quantifier);

pub theorem sqQuote_source_substitution (E: set) (t k i d c: nat):
 $ sfWf c -> sqQuote E t k d (sfSubst d i c) = sqQuote (sqEnvCons (E @ i) E) t k d (c) $ =
'(syl qqSourceSubst_at (ax_mp sfWf_induction qqSourceSubst_closed));
