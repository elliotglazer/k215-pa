import "quotation_binders.mm1";
import "source_substitution.mm1";

theorem qSS_shift_below (E: set) (z k d j: nat):
 $ j < d -> sfNamedIndex (sqEnvCons z E) k d (sfShiftIndex d j) = sfNamedIndex E k d j $ =
'(eqtrd (sfNamedIndexeq4d sfShiftIndex_bound) @
 eqtrd sfNamedIndex_bound (eqcomd sfNamedIndex_bound));
theorem qSS_suc_free (d j: nat): $ ~j < d -> ~suc j < d $ =
'(syl (bi1 lenlt) (syl (mpi lesucid letr) (bi2 lenlt)));
theorem qSS_shift_free (E: set) (z k d j: nat):
 $ ~j < d -> sfNamedIndex (sqEnvCons z E) k d (sfShiftIndex d j) = sfNamedIndex E k d j $ =
'(eqtrd (sfNamedIndexeq4d sfShiftIndex_free) @
 eqtrd (syl sfNamedIndex_free qSS_suc_free) @
 eqtrd (appeq2d (syl sucsub (bi2 lenlt))) @
 eqtrd (a1i sqEnvCons_suc) (eqcomd sfNamedIndex_free));
pub theorem sfNamedIndex_source_shift (E: set) (z k d j: nat):
 $ sfNamedIndex (sqEnvCons z E) k d (sfShiftIndex d j) = sfNamedIndex E k d j $ =
'(cases qSS_shift_below qSS_shift_free);

theorem qSS_subst_below (E: set) (i k d j: nat):
 $ j < d -> sfNamedIndex E k d (sfSubstIndex d i j) =
   sfNamedIndex (sqEnvCons (E @ i) E) k d j $ =
'(eqtrd (sfNamedIndexeq4d sfSubstIndex_bound) @
 eqtrd sfNamedIndex_bound (eqcomd sfNamedIndex_bound));
theorem qSS_subst_hit (E: set) (i k d: nat):
 $ sfNamedIndex E k d (sfSubstIndex d i d) =
   sfNamedIndex (sqEnvCons (E @ i) E) k d d $ =
'(eqtr (sfNamedIndexeq4 sfSubstIndex_hit) @
 eqtr (sfNamedIndex_free (mpbi lenlt leaddid2)) @
 eqtr (appeq2 pncan) @ eqcom @
 eqtr (sfNamedIndex_free (mpbi lenlt leid)) @
 eqtr (appeq2 subid) sqEnvCons_zero);
theorem qSS_subst_equal (E: set) (i k d j: nat):
 $ j = d -> sfNamedIndex E k d (sfSubstIndex d i j) =
   sfNamedIndex (sqEnvCons (E @ i) E) k d j $ =
'(eqtrd (sfNamedIndexeq4d (sfSubstIndexeq3d id)) @
 eqtrd (a1i qSS_subst_hit) (eqcomd (sfNamedIndexeq4d id)));
theorem qSS_pred_free (d j: nat): $ d < j -> ~j - 1 < d $ =
'(syl (bi1 lenlt) (syl (bi1 (leeq1 sucsub1)) lesub1i));
theorem qSS_sub_swap (d j: nat): $ j - 1 - d = j - d - 1 $ =
'(eqtr subsub (eqtr (subeq2 addcom) (eqcom subsub)));
theorem qSS_cons_nonzero (E: set) (x j: nat):
 $ j != 0 -> sqEnvCons x E @ j = E @ (j - 1) $ =
'(eqtrd (a1i sqEnvCons_value) ifneg);
theorem qSS_subst_above (E: set) (i k d j: nat):
 $ d < j -> sfNamedIndex E k d (sfSubstIndex d i j) =
   sfNamedIndex (sqEnvCons (E @ i) E) k d j $ =
'(eqtrd (sfNamedIndexeq4d sfSubstIndex_above) @
 eqtrd (syl sfNamedIndex_free qSS_pred_free) @
 eqtrd (a1i (appeq2 qSS_sub_swap)) @ eqcomd @
 eqtrd (syl sfNamedIndex_free (syl (bi1 lenlt) ltle)) @
 syl qSS_cons_nonzero (syl (bi1 lt01) (bi1 subpos)));
pub theorem sfNamedIndex_source_subst (E: set) (i k d j: nat):
 $ sfNamedIndex E k d (sfSubstIndex d i j) =
   sfNamedIndex (sqEnvCons (E @ i) E) k d j $ =
'(cases qSS_subst_equal (syl (eor qSS_subst_below qSS_subst_above) (bi1 neltlt)));

