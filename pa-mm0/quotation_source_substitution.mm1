theorem ntSourceShift_and (E: set) (k z: nat) (a b: nat):
 $ a e. ntSourceShiftClass E k z /\ b e. ntSourceShiftClass E k z -> sfAnd a b e. ntSourceShiftClass E k z $ =
(named '(mpbird (a1i ntSourceShift_value) @ !! iald d @
 eqtrd (a1i (sfNamedTemplateeq4 sfShift_sfAnd)) @ eqtrd (a1i sfNamedTemplate_sfAnd) @
 eqtrd (kAndeqd (syl ntSourceShift_at anl) (syl ntSourceShift_at anr))
