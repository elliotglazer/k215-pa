import "quotient_core_consistency.mm1";

import "source_k0_qsep_uniform.mm1";

import "source_wf_consistency.mm1";

import "k215_calculus_equivalence.mm1";

pub theorem k215SeparationImages: $ omegaSeparationImages $ = (named 'sfK0QSep_all_context);

pub theorem k215CoreSchemas_from_replacement: $ omegaReplacementImages -> quotientCoreSchemas $ = (named '(iand (a1i k215SeparationImages) id));

pub theorem k215CoreInconsistency_from_replacement: $ omegaReplacementImages -> sfTheoryProvable zfcCoreAxioms sfBot -> k215Inconsistent $ = (named '(exp (syl k215Cal_Inconsistent_reverse (mpd anr (syl quotientCore_inconsistency (syl k215CoreSchemas_from_replacement anl))))));

pub theorem k215ZFRInconsistency_from_replacement: $ omegaReplacementImages -> sfTheoryProvable zfrAxioms sfBot -> k215Inconsistent $ = (named '(exp (mpd (syl sfWFZFR_refutation anr) (syl k215CoreInconsistency_from_replacement anl))));
