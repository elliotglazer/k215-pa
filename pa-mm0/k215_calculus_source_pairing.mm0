import "proof_sequence.mm0";

theorem k215PairDiagonal_succ (k: nat): $ (suc k, 0) = suc k + (k, 0) $;

theorem k215PairDiagonal_rotate (k: nat): $ (suc k, 0) = suc (0, k) $;

theorem k215Pair_next (a b: nat): $ (a, suc b) = suc (suc a, b) $;

theorem k215Pair_sum_step (a b k: nat) (h: $ a + b = suc k $):
 $ (a, b) = b + suc (0, k) $;

def k215PairAdvance (p: nat): nat =
 $ if (fst p = 0) (suc (snd p), 0) (fst p - 1, suc (snd p)) $;

theorem k215PairAdvance_correct (p: nat): $ k215PairAdvance p = suc p $;
