import "source_k0_qrep_witness_syntax.mm0";

import "k218q_alpha.mm0";

theorem sfK0QRepRawProfile_antecedent_alpha (E: set) (n t a c u w q y x R phi: nat) (hf: $ sfBound (suc (suc n)) phi $)
 (hwR: $ w < R $) (hqR: $ q < R $) (hw0: $ w != 0 $) (hq0: $ q != 0 $)
 (hwt: $ w != t $) (hwu: $ w != u $) (hwq: $ w != q $)
 (hqt: $ q != t $) (hqu: $ q != u $)
 (hew: $ sqEnvAvoid E n w $) (heq: $ sqEnvAvoid E n q $):
 $ k218IEquivalent (sfK0QRepRawProfile E t a c u w y x R phi) (sfK0QRepRawProfile E t a c u q y x R phi) $;
