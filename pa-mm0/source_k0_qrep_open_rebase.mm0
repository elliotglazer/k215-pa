import "source_k0_qrep_functional_allocated.mm0";

def sfK0QRepOpenOutput (phi: nat): nat = $ sfEx (sfAll (sfIff (sfMem 0 1) (sfEx (sfAnd (sfMem 0 3) (sfRename sfRepCMap 0 phi))))) $;

theorem sfK0QRepOutput_bound (n phi: nat) (hf: $ sfBound (suc (suc n)) phi $):
 $ sfBound (suc n) (sfK0QRepOpenOutput phi) $;

theorem sfK0QRepFunctionality_bound (n phi: nat) (hf: $ sfBound (suc (suc n)) phi $):
 $ sfBound n (sfFunctionality (sfRename sfRepAMap 0 phi) (sfRename sfRepBMap 0 phi)) $;

theorem sfK0QRepCanonicalFunctional_rebase (E: set) (n t k l phi: nat) (hf: $ sfBound (suc (suc n)) phi $) (hk: $ 0 < k $) (hl: $ 0 < l $) (htk: $ t < k $) (htl: $ t < l $) (hek: $ sqEnvBelow E n k $) (hel: $ sqEnvBelow E n l $):
 $ k218QProvable (kImp (sfK0QRepCanonicalFunctional E t k phi) (sfK0QRepCanonicalFunctional E t l phi)) $;

theorem sfK0QRepOutput_rebase (E: set) (n t a k l phi: nat) (hf: $ sfBound (suc (suc n)) phi $) (hk: $ 0 < k $) (hl: $ 0 < l $) (htk: $ t < k $) (htl: $ t < l $) (hek: $ sqEnvBelow E n k $) (hel: $ sqEnvBelow E n l $) (hak: $ a < k $) (hal: $ a < l $):
 $ k218IEquivalent (sqQuote (sqEnvCons a E) t k 0 (sfK0QRepOpenOutput phi)) (sqQuote (sqEnvCons a E) t l 0 (sfK0QRepOpenOutput phi)) $;
