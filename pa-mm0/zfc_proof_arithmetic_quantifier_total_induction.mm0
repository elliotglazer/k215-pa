import "source_substitution.mm0";

def zfcProofArithmeticQuantifierTotalClosed (P: set) (.a .b: nat): wff = $ (A. a A. b sfNode 0 a b e. P) /\ (A. a A. b sfMem a b e. P) /\ (A. a A. b sfEq a b e. P) /\ (A. a A. b (a e. P /\ b e. P -> sfAnd a b e. P)) /\ (A. a A. b (a e. P /\ b e. P -> sfOr a b e. P)) /\ (A. a A. b (a e. P /\ b e. P -> sfImp a b e. P)) /\ (A. a (a e. P -> sfAll a e. P)) /\ (A. a (a e. P -> sfEx a e. P)) /\ (A. a A. b (b != 0 -> sfNode 6 a b e. P)) /\ (A. a A. b (b != 0 -> sfNode 7 a b e. P)) $;

theorem zfcProofArithmeticQuantifierTotal_induction (P: set) (c: nat): $ zfcProofArithmeticQuantifierTotalClosed P -> c e. P $;
