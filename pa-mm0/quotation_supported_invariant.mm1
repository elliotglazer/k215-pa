import "quotation_supported_quantifiers.mm1";
import "source_nd_quantifiers.mm1";

-- The cutoff bounds the row code and may be enlarged to include hidden
-- instantiation witnesses. Environments and target contexts are numerical.
@_ def sqSupportedRowGoal (r S t k H: nat): wff =
 $ ifp (fst r = 0)
 (kHypProvable H (sqQuote (sqNumericEnvironment S) t k 0 (snd (snd r))))
 (kHypProvable (sqQuote (sqNumericEnvironment S) t k 0 (fst (snd (snd r))) : H)
   (sqQuote (sqNumericEnvironment S) t k 0 (snd (snd (snd (snd r))))) /\
  kHypProvable (sqQuote (sqNumericEnvironment S) t k 0 (fst (snd (snd (snd r)))) : H)
   (sqQuote (sqNumericEnvironment S) t k 0 (snd (snd (snd (snd r)))))) $;
@_ abstract def sqSupportedProperty (n r .S .t .k .H: nat): wff =
 $ A. S A. t A. k A. H (sqEnvironmentSafe S n t k -> sqDomainSupport H S t ->
 sqSourceSupport H S t k (fst (snd r)) -> sqSupportedRowGoal r S t k H) $;
@_ def sqSupportedAt (n r: nat): wff =
 $ sfRowWf r /\ (r <= n /\ sqSupportedProperty n r) $;
@_ abstract def sqSupportedGood (r .n: nat): wff = $ E. n sqSupportedAt n r $;
@_ abstract def sqSupportedClass (.r: nat): set = $ {r | sqSupportedGood r} $;

pub theorem sqSupportedRowGoal_sequent (G a S t k H: nat):
 $ sqSupportedRowGoal (sfSequent G a) S t k H <->
 kHypProvable H (sqQuote (sqNumericEnvironment S) t k 0 a) $ =
'(bitr (ifppos sfSequent_tag) @ kHypProvableeq2 (sqQuoteeq5 sfSequent_formula));
pub theorem sqSupportedRowGoal_branches (G a b c S t k H: nat):
 $ sqSupportedRowGoal (sfBranches G a b c) S t k H <->
 (kHypProvable (sqQuote (sqNumericEnvironment S) t k 0 a : H) (sqQuote (sqNumericEnvironment S) t k 0 c) /\
 kHypProvable (sqQuote (sqNumericEnvironment S) t k 0 b : H) (sqQuote (sqNumericEnvironment S) t k 0 c)) $ =
'(bitr (ifpneg (mpbir (noteq (eqeq1 sfBranches_tag)) (ltneri lt01S))) @ aneq
 (kHypProvableeq (conseq1 (sqQuoteeq5 sfBranches_left)) (sqQuoteeq5 sfBranches_formula))
 (kHypProvableeq (conseq1 (sqQuoteeq5 sfBranches_right)) (sqQuoteeq5 sfBranches_formula)));
pub theorem sqSupportedProperty_at (n r S t k H: nat):
 $ sqSupportedProperty n r -> sqEnvironmentSafe S n t k -> sqDomainSupport H S t ->
 sqSourceSupport H S t k (fst (snd r)) -> sqSupportedRowGoal r S t k H $ =
(named '(!! ealie v @ !! ealde w @ !! ealde x @ !! ealde y @ bi1d ,eqtac));
pub theorem sqSupportedAt_wf (n r: nat): $ sqSupportedAt n r -> sfRowWf r $ = 'anl;
pub theorem sqSupportedAt_bound (n r: nat): $ sqSupportedAt n r -> r <= n $ = '(syl anl anr);
pub theorem sqSupportedAt_property (n r: nat):
 $ sqSupportedAt n r -> sqSupportedProperty n r $ = '(syl anr anr);
pub theorem sqSupportedAt_intro (n r: nat):
 $ sfRowWf r -> r <= n -> sqSupportedProperty n r -> sqSupportedAt n r $ =
'(exp @ exp @ iand anll (iand anlr anr));
pub theorem sqSupportedGood_intro (n r: nat): $ sqSupportedAt n r -> sqSupportedGood r $ =
(named '(iexe ,eqtac));
pub theorem sqSupportedGood_wf (r: nat): $ sqSupportedGood r -> sfRowWf r $ =
(named '(eex sqSupportedAt_wf));
pub theorem sqSupportedClass_value (r: nat):
 $ r e. sqSupportedClass <-> sqSupportedGood r $ = (named '(elabe ,eqtac));
pub theorem sqSupportedAt_use (n r S t k H: nat):
 $ sqSupportedAt n r -> sqEnvironmentSafe S n t k -> sqDomainSupport H S t ->
 sqSourceSupport H S t k (fst (snd r)) -> sqSupportedRowGoal r S t k H $ =
'(syl sqSupportedProperty_at sqSupportedAt_property);
pub theorem sqSupportedAt_sequent (n G a S t k H: nat):
 $ sqSupportedAt n (sfSequent G a) -> sqEnvironmentSafe S n t k -> sqDomainSupport H S t ->
 sqSourceSupport H S t k G -> kHypProvable H (sqQuote (sqNumericEnvironment S) t k 0 a) $ =
'(exp @ exp @ exp @ syl (bi1 sqSupportedRowGoal_sequent) @
 mpd (syl (bi2 (sqSourceSupporteq5 sfSequent_context)) anr) @
 mpd (syl anr anl) @ mpd (syl anr (syl anl anl)) @
 syl sqSupportedAt_use (syl anl (syl anl anl)));
