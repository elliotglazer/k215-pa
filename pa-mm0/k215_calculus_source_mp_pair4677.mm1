@_ def k215PairAt4677State (pc a b t c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) b (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) a t (k215PR8 c)) $;

do (apply (register-eqd 'k215PairAt4677State) '(k215PairAt4677Stateeqd));

theorem k215PairAt4677TransferIn (a b t c: nat): $ k215PIter (4 * b + 1) (k215PairAt4677State k215PNum4677 a b t c) = (k215PairAt4677State k215PNum4681 (a + b) 0 (t + b) c) $ =
 '(eqtr k215Loop4677Vector (k215PStateeq2 (k215PVectoreq eqid eqid eqid eqid eqid eqid addcom addcom eqid)));
theorem k215PairAt4677TransferBack (a t c: nat): $ k215PIter (3 * a + 1) (k215PairAt4677State k215PNum4683 a 0 t c) = (k215PairAt4677State k215PNum4686 0 a t c) $ =
 '(eqtr k215Loop4683Vector (k215PStateeq2 (k215PVectoreq2 add0)));
pub theorem k215PairAt4677ReachIn (a b t c: nat): $ k215PReach (k215PairAt4677State k215PNum4677 a b t c) (k215PairAt4677State k215PNum4681 (a + b) 0 (t + b) c) $ =
 '(k215PReach_intro k215PairAt4677TransferIn);
theorem k215PairAt4677ReachBack (a t c: nat): $ k215PReach (k215PairAt4677State k215PNum4683 a 0 t c) (k215PairAt4677State k215PNum4686 0 a t c) $ =
 '(k215PReach_intro k215PairAt4677TransferBack);


theorem k215PairAt4677Step50Z (b t c: nat): $ k215PStep (k215PairAt4677State k215PNum4681 0 b t c) = (k215PairAt4677State k215PNum4687 0 b t c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupPair4677_4681) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215PairAt4677Reach50Z (b t c: nat): $ k215PReach (k215PairAt4677State k215PNum4681 0 b t c) (k215PairAt4677State k215PNum4687 0 b t c) $ = '(k215PReach_step k215PairAt4677Step50Z);

theorem k215PairAt4677Step50S (a b t c: nat): $ k215PStep (k215PairAt4677State k215PNum4681 (suc a) b t c) = (k215PairAt4677State k215PNum4682 a b t c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupPair4677_4681) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215PairAt4677Reach50S (a b t c: nat): $ k215PReach (k215PairAt4677State k215PNum4681 (suc a) b t c) (k215PairAt4677State k215PNum4682 a b t c) $ = '(k215PReach_step k215PairAt4677Step50S);

theorem k215PairAt4677Step51 (a b t c: nat): $ k215PStep (k215PairAt4677State k215PNum4682 a b t c) = (k215PairAt4677State k215PNum4683 a b (suc t) c) $ = '(eqtr (k215PAtCI k215PLookupPair4677_4682) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215PairAt4677Reach51 (a b t c: nat): $ k215PReach (k215PairAt4677State k215PNum4682 a b t c) (k215PairAt4677State k215PNum4683 a b (suc t) c) $ = '(k215PReach_step k215PairAt4677Step51);

theorem k215PairAt4677Step55 (a b t c: nat): $ k215PStep (k215PairAt4677State k215PNum4686 a b t c) = (k215PairAt4677State k215PNum4677 a b t c) $ = '(k215PAtCC k215PLookupPair4677_4686);

theorem k215PairAt4677Reach55 (a b t c: nat): $ k215PReach (k215PairAt4677State k215PNum4686 a b t c) (k215PairAt4677State k215PNum4677 a b t c) $ = '(k215PReach_step k215PairAt4677Step55);

theorem k215PairAt4677Prefix (k t c: nat): $ k215PReach (k215PairAt4677State k215PNum4681 (suc k) 0 t c) (k215PairAt4677State k215PNum4677 0 k (suc t) c) $ = '(ax_mp (ax_mp k215PReach_trans k215PairAt4677Reach50S) (ax_mp (ax_mp k215PReach_trans k215PairAt4677Reach51) (ax_mp (ax_mp k215PReach_trans k215PairAt4677ReachBack) k215PairAt4677Reach55)));
theorem k215PairAt4677ReachSum (a b t k c: nat): $ a + b = suc k -> k215PReach (k215PairAt4677State k215PNum4677 a b t c) (k215PairAt4677State k215PNum4681 (suc k) 0 (t + b) c) $ =
 '(mpbid (k215PReacheq2d (k215PairAt4677Stateeq2d id)) (a1i k215PairAt4677ReachIn));
pub theorem k215PairAt4677Cycle (a b t k c: nat): $ a + b = suc k -> k215PReach (k215PairAt4677State k215PNum4677 a b t c) (k215PairAt4677State k215PNum4677 0 k (suc (t + b)) c) $ =
 '(mpd (a1i k215PairAt4677Prefix) (syl k215PReach_trans k215PairAt4677ReachSum));
theorem k215PairAt4677ReachZeroIn (t c: nat): $ k215PReach (k215PairAt4677State k215PNum4677 0 0 t c) (k215PairAt4677State k215PNum4681 0 0 t c) $ =
 '(mpbi (k215PReacheq2 (k215PairAt4677Stateeq eqid add0 eqid add0 eqid)) k215PairAt4677ReachIn);
pub theorem k215PairAt4677Base (t c: nat): $ k215PReach (k215PairAt4677State k215PNum4677 0 0 t c) (k215PairAt4677State k215PNum4687 0 0 t c) $ =
 '(ax_mp (ax_mp k215PReach_trans k215PairAt4677ReachZeroIn) k215PairAt4677Reach50Z);


@_ abstract def k215PairAt4677Run (a b t c: nat): wff =
 $ k215PReach (k215PairAt4677State k215PNum4677 a b t c) (k215PairAt4677State k215PNum4687 0 0 (t + (a, b)) c) $;
do (apply (register-eqd 'k215PairAt4677Run) '(k215PairAt4677Runeqd));
theorem k215PairAt4677RunZero (t c: nat): $ k215PairAt4677Run 0 0 t c $ =
 '(mpbi (k215PReacheq2 (k215PairAt4677Stateeq4 (eqcom (eqtr (addeq2 pr0) add0)))) k215PairAt4677Base);
theorem k215PairAt4677RunBase (a b t c: nat): $ a + b = 0 -> k215PairAt4677Run a b t c $ =
 '(mpbiri k215PairAt4677RunZero (k215PairAt4677Runeqd
   (syl anl (bi1 addeq0)) (syl anr (bi1 addeq0)) eqidd eqidd));
theorem k215PairAt4677SumStep (a b k: nat): $ a + b = suc k -> (a, b) = b + suc (0, k) $ =
 '(eqtrd (a1i preqadd) (eqtrd (addeq1d (preq1d id))
   (a1i (eqtr (addeq1 k215PairDiagonal_rotate) addcom))));
theorem k215PairAt4677Accumulator (a b t k: nat): $ a + b = suc k -> suc (t + b) + (0, k) = t + (a, b) $ =
 '(eqtrd
   (a1i (eqtr addS1 (eqtr (suceq addass)
     (eqtr (eqcom addS) (addeq2 (eqcom addS))))))
   (addeq2d (eqcomd k215PairAt4677SumStep)));
@_ abstract def k215PairAt4677Claim (k c: nat) (.a .b .t: nat): wff =
 $ A. a A. b A. t (a + b = k -> k215PairAt4677Run a b t c) $;
theorem k215PairAt4677Claim_at (a b t k c: nat): $ k215PairAt4677Claim k c -> a + b = k -> k215PairAt4677Run a b t c $ =
 (named '(!! ealie i @ !! ealde j @ !! ealde l @ bi1d ,eqtac));
theorem k215PairAt4677RunInductive (a b t k c: nat): $ k215PairAt4677Claim k c -> a + b = suc k -> k215PairAt4677Run a b t c $ =
 '(exp @ mpd
   (mpbid
     (k215PReacheq2d (k215PairAt4677Stateeq4d (syl k215PairAt4677Accumulator anr)))
     (mpd (a1i add01) (syl k215PairAt4677Claim_at anl)))
   (syl k215PReach_trans (syl k215PairAt4677Cycle anr)));
theorem k215PairAt4677Claim_all (k c: nat): $ k215PairAt4677Claim k c $ =
 (named @ induct '(ind) 'k
   '(ax_gen (ax_gen (ax_gen k215PairAt4677RunBase)))
   '(iald @ iald @ iald k215PairAt4677RunInductive));
pub theorem k215PairMacro4677 (a b t c: nat): $ k215PReach (k215PairAt4677State k215PNum4677 a b t c) (k215PairAt4677State k215PNum4687 0 0 (t + (a, b)) c) $ =
 '(ax_mp (ax_mp k215PairAt4677Claim_at k215PairAt4677Claim_all) eqid);


