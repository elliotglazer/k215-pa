import "k215_calculus_source_ax_stack_loops.mm1";
import "k215_literal_runtime_reach.mm1";
import "k215_calculus_source_pairing.mm1";
import "k215_calculus_source_ax_stack_lookups.mm1";

@_ def k215UnpairAt2540State (pc a b n c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) n (k215PR3 c) (k215PR4 c) (k215PR5 c) a b (k215PR8 c)) $;

do (apply (register-eqd 'k215UnpairAt2540State) '(k215UnpairAt2540Stateeqd));

theorem k215UnpairAt2540Transfer (b n c: nat): $ k215PIter (3 * b + 1) (k215UnpairAt2540State k215PNum2544 0 b n c) = (k215UnpairAt2540State k215PNum2547 b 0 n c) $ =
 '(eqtr k215Loop2544Vector (k215PStateeq2 (k215PVectoreq7 add0)));
theorem k215UnpairAt2540ReachTransfer (b n c: nat): $ k215PReach (k215UnpairAt2540State k215PNum2544 0 b n c) (k215UnpairAt2540State k215PNum2547 b 0 n c) $ =
 '(k215PReach_intro k215UnpairAt2540Transfer);


theorem k215UnpairAt2540Step9Z (a b c: nat): $ k215PStep (k215UnpairAt2540State k215PNum2540 a b 0 c) = (k215UnpairAt2540State k215PNum2548 a b 0 c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair2540_2540) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt2540Reach9Z (a b c: nat): $ k215PReach (k215UnpairAt2540State k215PNum2540 a b 0 c) (k215UnpairAt2540State k215PNum2548 a b 0 c) $ = '(k215PReach_step k215UnpairAt2540Step9Z);

theorem k215UnpairAt2540Step9S (a b n c: nat): $ k215PStep (k215UnpairAt2540State k215PNum2540 a b (suc n) c) = (k215UnpairAt2540State k215PNum2541 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair2540_2540) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet2_vector)) (eqtr k215PSet2_vector (k215PVectoreq3 (eqtr subSS sub02))))));

theorem k215UnpairAt2540Reach9S (a b n c: nat): $ k215PReach (k215UnpairAt2540State k215PNum2540 a b (suc n) c) (k215UnpairAt2540State k215PNum2541 a b n c) $ = '(k215PReach_step k215UnpairAt2540Step9S);

theorem k215UnpairAt2540Step10 (a b n c: nat): $ k215PStep (k215UnpairAt2540State k215PNum2541 a b n c) = (k215UnpairAt2540State k215PNum2542 a (suc b) n c) $ = '(eqtr (k215PAtCI k215PLookupUnpair2540_2541) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215UnpairAt2540Reach10 (a b n c: nat): $ k215PReach (k215UnpairAt2540State k215PNum2541 a b n c) (k215UnpairAt2540State k215PNum2542 a (suc b) n c) $ = '(k215PReach_step k215UnpairAt2540Step10);

theorem k215UnpairAt2540Step11Z (b n c: nat): $ k215PStep (k215UnpairAt2540State k215PNum2542 0 b n c) = (k215UnpairAt2540State k215PNum2544 0 b n c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair2540_2542) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt2540Reach11Z (b n c: nat): $ k215PReach (k215UnpairAt2540State k215PNum2542 0 b n c) (k215UnpairAt2540State k215PNum2544 0 b n c) $ = '(k215PReach_step k215UnpairAt2540Step11Z);

theorem k215UnpairAt2540Step11S (a b n c: nat): $ k215PStep (k215UnpairAt2540State k215PNum2542 (suc a) b n c) = (k215UnpairAt2540State k215PNum2543 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair2540_2542) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215UnpairAt2540Reach11S (a b n c: nat): $ k215PReach (k215UnpairAt2540State k215PNum2542 (suc a) b n c) (k215UnpairAt2540State k215PNum2543 a b n c) $ = '(k215PReach_step k215UnpairAt2540Step11S);

theorem k215UnpairAt2540Step12 (a b n c: nat): $ k215PStep (k215UnpairAt2540State k215PNum2543 a b n c) = (k215UnpairAt2540State k215PNum2547 a b n c) $ = '(k215PAtCB k215PLookupUnpair2540_2543);

theorem k215UnpairAt2540Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt2540State k215PNum2543 a b n c) (k215UnpairAt2540State k215PNum2547 a b n c) $ = '(k215PReach_step k215UnpairAt2540Step12);

theorem k215UnpairAt2540Step16 (a b n c: nat): $ k215PStep (k215UnpairAt2540State k215PNum2547 a b n c) = (k215UnpairAt2540State k215PNum2540 a b n c) $ = '(k215PAtCC k215PLookupUnpair2540_2547);

theorem k215UnpairAt2540Reach16 (a b n c: nat): $ k215PReach (k215UnpairAt2540State k215PNum2547 a b n c) (k215UnpairAt2540State k215PNum2540 a b n c) $ = '(k215PReach_step k215UnpairAt2540Step16);

theorem k215UnpairAt2540CycleZero (b n c: nat): $ k215PReach (k215UnpairAt2540State k215PNum2540 0 b (suc n) c) (k215UnpairAt2540State k215PNum2540 (suc b) 0 n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt2540Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2540Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2540Reach11Z) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2540ReachTransfer) k215UnpairAt2540Reach16))));
theorem k215UnpairAt2540CycleSucc (a b n c: nat): $ k215PReach (k215UnpairAt2540State k215PNum2540 (suc a) b (suc n) c) (k215UnpairAt2540State k215PNum2540 a (suc b) n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt2540Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2540Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2540Reach11S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2540Reach12) k215UnpairAt2540Reach16))));


theorem k215UnpairAt2540AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt2540State k215PNum2540 0 b (suc n) c) (k215UnpairAt2540State k215PNum2540 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt2540Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215PairDiagonal_rotate)) (eqtr (eqcom sndpr) (sndeq k215PairDiagonal_rotate)) eqid eqid)) k215UnpairAt2540CycleZero);

theorem k215UnpairAt2540AdvanceSucc (a b n c: nat): $ k215PReach (k215UnpairAt2540State k215PNum2540 (suc a) b (suc n) c) (k215UnpairAt2540State k215PNum2540 (fst (suc ((suc a), b))) (snd (suc ((suc a), b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt2540Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215Pair_next)) (eqtr (eqcom sndpr) (sndeq k215Pair_next)) eqid eqid)) k215UnpairAt2540CycleSucc);

pub theorem k215UnpairAt2540Advance (a b n c: nat): $ k215PReach (k215UnpairAt2540State k215PNum2540 a b (suc n) c) (k215UnpairAt2540State k215PNum2540 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
 (named @ induct '(ind) 'a 'k215UnpairAt2540AdvanceZero '(a1i k215UnpairAt2540AdvanceSucc));
@_ abstract def k215UnpairAt2540Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt2540State k215PNum2540 a b n c) (k215UnpairAt2540State k215PNum2548 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
theorem k215UnpairAt2540RunZero (a b c: nat): $ k215UnpairAt2540Run 0 a b c $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt2540Stateeq eqid
     (eqcom (eqtr (fsteq add0) fstpr))
     (eqcom (eqtr (sndeq add0) sndpr)) eqid eqid)) k215UnpairAt2540Reach9Z);
@_ abstract def k215UnpairAt2540Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt2540Run n a b c $;
theorem k215UnpairAt2540Claim_at (n a b c: nat): $ k215UnpairAt2540Claim n c -> k215UnpairAt2540Run n a b c $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215UnpairAt2540CodeStep (a b n: nat): $ (fst (suc (a, b)), snd (suc (a, b))) + n = (a, b) + suc n $ =
 '(eqtr (addeq1 fstsnd) addSass);
theorem k215UnpairAt2540RunInductive (n a b c: nat): $ k215UnpairAt2540Claim n c -> k215UnpairAt2540Run (suc n) a b c $ =
 '(syl (ax_mp k215PReach_trans k215UnpairAt2540Advance)
   (mpbid (a1i (k215PReacheq2 (k215UnpairAt2540Stateeq eqid
     (fsteq k215UnpairAt2540CodeStep) (sndeq k215UnpairAt2540CodeStep) eqid eqid))) k215UnpairAt2540Claim_at));
theorem k215UnpairAt2540Claim_all (n c: nat): $ k215UnpairAt2540Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt2540RunZero)) '(iald @ iald k215UnpairAt2540RunInductive));
pub theorem k215UnpairMacro2540 (n a b c: nat): $ k215PReach (k215UnpairAt2540State k215PNum2540 a b n c) (k215UnpairAt2540State k215PNum2548 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
 '(ax_mp k215UnpairAt2540Claim_at k215UnpairAt2540Claim_all);
pub theorem k215UnpairMacro2540_clean (n c: nat): $ k215PReach (k215UnpairAt2540State k215PNum2540 0 0 n c) (k215UnpairAt2540State k215PNum2548 (fst n) (snd n) 0 c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt2540Stateeq eqid
   (fsteq (eqtr (addeq1 pr0) add01))
   (sndeq (eqtr (addeq1 pr0) add01)) eqid eqid)) k215UnpairMacro2540);


