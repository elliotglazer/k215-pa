import "k218_proof_transfer.mm0";

-- The remaining hypothesis is precisely the image of the old theory bundle.
-- This module does not assert that hypothesis.
def k218OldBundleImages (.a .b .c: nat): wff =
  $ A. a A. b A. c
    (c != a /\ c != b -> kBundle a b c e. k218TranslatedClass) $;
theorem k218OldBundleImages_at (a b c: nat):
  $ k218OldBundleImages ->
    c != a /\ c != b -> kBundle a b c e. k218TranslatedClass $;
theorem k218OldBundleImages_axioms:
  $ k218OldBundleImages -> kAxioms C_ k218TranslatedClass $;
theorem k218OldBundleImages_transfer (a: nat):
  $ k218OldBundleImages -> kProvable a -> k218Provable (k218Translate a) $;
theorem k218OldBundleImages_consistency:
  $ k218OldBundleImages -> (~k218Provable kF -> ~kProvable kF) $;
