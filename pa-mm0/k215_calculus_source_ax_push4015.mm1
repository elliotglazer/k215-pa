import "k215_calculus_source_ax_pair4021.mm1";
import "k215_calculus_source_ax_stack_loops.mm1";

theorem k215PairVectorInAt4015 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt4021State k215PNum4021 a6 a1 a7 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum4021 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215PairVectorOutAt4015 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt4021State k215PNum4031 0 0 (a7 + (a6, a1)) (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum4031 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

pub theorem k215PairMacro46_vectorAt4015 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat):
 $ k215PReach (k215PState k215PNum4021 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215PNum4031 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ =
 '(mpbi (k215PReacheq k215PairVectorInAt4015 k215PairVectorOutAt4015) k215PairMacro4021);

theorem k215PushAStage0At4015 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum4015 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum4018 (k215PVector u 0 w c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop4015Vector (k215PStateeq2 (k215PVectoreq7 add0))));

theorem k215PushAStage1At4015 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum4018 (k215PVector u 0 w c a b t 0 v)) (k215PState k215PNum4021 (k215PVector u w 0 c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop4018Vector (k215PStateeq2 (k215PVectoreq2 add0))));

theorem k215PushAStage2At4015 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum4021 (k215PVector u w 0 c a b t 0 v)) (k215PState k215PNum4031 (k215PVector u 0 0 c a b 0 (t, w) v)) $ = '(mpbi (k215PReacheq2 (k215PStateeq2 (k215PVectoreq8 add01))) k215PairMacro46_vectorAt4015);

theorem k215PushAStage3At4015 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum4031 (k215PVector u 0 0 c a b 0 (t, w) v)) (k215PState k215PNum4034 (k215PVector u 0 (t, w) c a b 0 0 v)) $ = '(k215PReach_intro (eqtr k215Loop4031Vector (k215PStateeq2 (k215PVectoreq3 add0))));

theorem k215PushAStage4At4015 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum4034 (k215PVector u 0 (t, w) c a b 0 0 v)) (k215PState k215PNum4038 (k215PVector u c (t, w) 0 a b c 0 v)) $ = '(k215PReach_intro (eqtr k215Loop4034Vector (k215PStateeq2 (k215PVectoreq eqid add0 eqid eqid eqid eqid add0 eqid eqid))));

theorem k215PushAStage5At4015 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum4038 (k215PVector u c (t, w) 0 a b c 0 v)) (k215PState k215PNum4041 (k215PVector u c (t, w) c a b 0 0 v)) $ = '(k215PReach_intro (eqtr k215Loop4038Vector (k215PStateeq2 (k215PVectoreq4 add0))));

pub theorem k215PushParam4015 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum4015 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum4041 (k215PVector u c (t, w) c a b 0 0 v)) $ = '(ax_mp (ax_mp k215PReach_trans k215PushAStage0At4015) (ax_mp (ax_mp k215PReach_trans k215PushAStage1At4015) (ax_mp (ax_mp k215PReach_trans k215PushAStage2At4015) (ax_mp (ax_mp k215PReach_trans k215PushAStage3At4015) (ax_mp (ax_mp k215PReach_trans k215PushAStage4At4015) k215PushAStage5At4015)))));

