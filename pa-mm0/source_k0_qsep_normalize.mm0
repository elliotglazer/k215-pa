theorem sfK0QSepQuotient_canonical (E: set) (n t a k phi: nat) (hf: $ sfBound (suc n) phi $) (hk: $ 0 < k $)
 (ht: $ t < k $) (ha: $ a < suc k $) (he: $ sqEnvBelow E n k $):
 $ k218QProvable (kImp (kExists (suc (suc (suc (suc (suc (suc (suc k))))))) (sfK0QSepQuotientBody E t a (suc (suc (suc (suc (suc (suc (suc k))))))) (suc (suc (suc (suc (suc (suc (suc (suc k)))))))) (suc (suc (suc (suc (suc (suc (suc (suc (suc k))))))))) (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc k)))))))))) phi)) (kExists (suc k) (sfK0QSepQuotientBody E t a (suc k) (suc (suc k)) (suc (suc (suc k))) (suc (suc (suc k))) phi))) $;

theorem sfK0QSepQuotient_to_quote (E: set) (n t a k phi: nat) (hf: $ sfBound (suc n) phi $) (hk: $ 0 < k $)
 (ht: $ t < k $) (ha: $ a < suc k $) (he: $ sqEnvBelow E n k $):
 $ k218QProvable (kImp (kExists (suc (suc (suc (suc (suc (suc (suc k))))))) (sfK0QSepQuotientBody E t a (suc (suc (suc (suc (suc (suc (suc k))))))) (suc (suc (suc (suc (suc (suc (suc (suc k)))))))) (suc (suc (suc (suc (suc (suc (suc (suc (suc k))))))))) (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc k)))))))))) phi)) (sqQuote (sqEnvCons a E) t (suc k) 0 (sfK0QSepOpenSeparation phi))) $;
