 $ k218QProvable (kImp (sfK0QRepFunctional E 1 a u v w T R phi) (kImp kEmptyMarker (kImp (kMem 1 x) (kImp (kMem x a) (kImp (kMem 1 y) (kImp (sfK0QRepRelation E 1 R x y phi) (kImp (kAll u (kImp (kImp (kImp (kMem 1 u) (kImp (kMem u a) kF)) kF) (kImp (kExists w (kImp (kImp (kMem 1 w) (kImp (sfK0QRepRelation E 1 R u w phi) kF)) kF)) (kExists z (kImp (kImp (kMem 1 z) (kImp (kImp (kImp (kMem z c) (kImp (sfK0QRepRelation E 1 R u z phi) kF)) kF) kF)) kF))))) (sqMember 1 y c N)))))))) $;
