import "source_k0_qrep_carrier.mm0";

def qrcSafeEnvironment (P: wff) (E: set) (.i: nat): set = $ {i | ifp P (i e. E) (i e. sqZeroEnvironment)} $;

def qrcResult (E: set) (k phi: nat): nat = $ kImp kEmptyMarker (sqQuote E 1 k 0 (sfReplacement (sfRename sfRepAMap 0 phi) (sfRename sfRepBMap 0 phi) (sfRename sfRepCMap 0 phi))) $;

theorem sfK0QRepCarrier_image_d (G: wff) (E: set) (n k phi: nat)
 (hf: $ G -> sfBound (suc (suc n)) phi $) (hk: $ G -> 2 < k $)
 (he: $ G -> sqEnvBelow E n k $):
 $ G -> k218QProvable (kImp kEmptyMarker (sqQuote E 1 k 0 (sfReplacement (sfRename sfRepAMap 0 phi) (sfRename sfRepBMap 0 phi) (sfRename sfRepCMap 0 phi)))) $;

theorem sfK0QRepCarrier_image_curried (E: set) (n k phi: nat):
 $ sfBound (suc (suc n)) phi -> 2 < k -> sqEnvBelow E n k -> k218QProvable (kImp kEmptyMarker (sqQuote E 1 k 0 (sfReplacement (sfRename sfRepAMap 0 phi) (sfRename sfRepBMap 0 phi) (sfRename sfRepCMap 0 phi)))) $;
