import "source_syntax_elim.mm0";
import "trace_soundness.mm0";

theorem sfContextsWf_congr (H: wff) (a b: nat) (h: $ H -> a = b $):
  $ H -> (sfWf a <-> sfWf b) $;

-- Finite Peano cons-lists; these are not the source beta-coded contexts.
def sfFormulaClass (.a: nat): set = $ {a | sfWf a} $;
def sfContextWf (G: nat): wff = $ all sfFormulaClass G $;
def sfContextSub (G D: nat): wff = $ lmems G C_ lmems D $;
def sfSequent (G a: nat): nat = $ (0, G, a) $;
def sfBranches (G a b c: nat): nat = $ (1, G, a, b, c) $;
def sfRowWf (r: nat): wff =
$ ifp (fst r = 0)
  (sfContextWf (fst (snd r)) /\ sfWf (snd (snd r)))
  (fst r = 1 /\ (sfContextWf (fst (snd r)) /\
    (sfWf (fst (snd (snd r))) /\
    (sfWf (fst (snd (snd (snd r)))) /\ sfWf (snd (snd (snd (snd r)))))))) $;

theorem sfFormulaClass_value (a: nat): $ a e. sfFormulaClass <-> sfWf a $;
theorem sfContextWf_nil: $ sfContextWf 0 $;
theorem sfContextWf_cons (a G: nat): $ sfContextWf (a : G) <-> sfWf a /\ sfContextWf G $;
theorem sfContextWf_append (G D: nat): $ sfContextWf (G ++ D) <-> sfContextWf G /\ sfContextWf D $;
theorem sfContextWf_member (G a: nat): $ sfContextWf G -> a IN G -> sfWf a $;
theorem sfContext_member_head (a G: nat): $ a IN (a : G) $;
theorem sfContext_member_tail (a b G: nat): $ a IN G -> a IN (b : G) $;
theorem sfContextSub_member (G D a: nat): $ sfContextSub G D -> a IN G -> a IN D $;
theorem sfContextSub_refl (G: nat): $ sfContextSub G G $;
theorem sfContextSub_trans (G D E: nat): $ sfContextSub G D -> sfContextSub D E -> sfContextSub G E $;
theorem sfContextSub_cons (a G: nat): $ sfContextSub G (a : G) $;
theorem sfContextSub_wf (G D: nat): $ sfContextSub G D -> sfContextWf D -> sfContextWf G $;
theorem sfSequent_injective (G D a b: nat): $ sfSequent G a = sfSequent D b <-> G = D /\ a = b $;
theorem sfBranches_injective (G D a b c u v w: nat):
  $ sfBranches G a b c = sfBranches D u v w <-> G = D /\ (a = u /\ (b = v /\ c = w)) $;
theorem sfSequent_ne_branches (G D a b c u: nat): $ sfSequent G a != sfBranches D b c u $;
theorem sfSequent_tag (G a: nat): $ fst (sfSequent G a) = 0 $;
theorem sfBranches_tag (G a b c: nat): $ fst (sfBranches G a b c) = 1 $;
theorem sfSequent_context (G a: nat): $ fst (snd (sfSequent G a)) = G $;
theorem sfSequent_formula (G a: nat): $ snd (snd (sfSequent G a)) = a $;
theorem sfBranches_context (G a b c: nat): $ fst (snd (sfBranches G a b c)) = G $;
theorem sfBranches_left (G a b c: nat): $ fst (snd (snd (sfBranches G a b c))) = a $;
theorem sfBranches_right (G a b c: nat): $ fst (snd (snd (snd (sfBranches G a b c)))) = b $;
theorem sfBranches_formula (G a b c: nat): $ snd (snd (snd (snd (sfBranches G a b c)))) = c $;

theorem sfRowWf_sequent (G a: nat):
  $ sfRowWf (sfSequent G a) <-> sfContextWf G /\ sfWf a $;
theorem sfRowWf_branches (G a b c: nat):
  $ sfRowWf (sfBranches G a b c) <-> sfContextWf G /\ (sfWf a /\ (sfWf b /\ sfWf c)) $;
theorem sfRowWf_sequent_intro (G a: nat):
  $ sfContextWf G -> sfWf a -> sfRowWf (sfSequent G a) $;
theorem sfRowWf_branches_intro (G a b c: nat):
  $ sfContextWf G -> sfWf a -> sfWf b -> sfWf c -> sfRowWf (sfBranches G a b c) $;

theorem sfSequent_congr (H: wff) (a b u v: nat) (h0: $ H -> a = u $) (h1: $ H -> b = v $):
  $ H -> sfSequent a b = sfSequent u v $;

theorem sfSequent_congr_context (H: wff) (a b u: nat) (h: $ H -> a = u $):
  $ H -> sfSequent a b = sfSequent u b $;

theorem sfSequent_congr_formula (H: wff) (a b v: nat) (h: $ H -> b = v $):
  $ H -> sfSequent a b = sfSequent a v $;

theorem sfBranches_congr (H: wff) (a b c d u v w x: nat) (h0: $ H -> a = u $) (h1: $ H -> b = v $) (h2: $ H -> c = w $) (h3: $ H -> d = x $):
  $ H -> sfBranches a b c d = sfBranches u v w x $;

theorem sfBranches_congr_context (H: wff) (a b c d u: nat) (h: $ H -> a = u $):
  $ H -> sfBranches a b c d = sfBranches u b c d $;

theorem sfBranches_congr_left (H: wff) (a b c d v: nat) (h: $ H -> b = v $):
  $ H -> sfBranches a b c d = sfBranches a v c d $;

theorem sfBranches_congr_right (H: wff) (a b c d w: nat) (h: $ H -> c = w $):
  $ H -> sfBranches a b c d = sfBranches a b w d $;

theorem sfBranches_congr_formula (H: wff) (a b c d x: nat) (h: $ H -> d = x $):
  $ H -> sfBranches a b c d = sfBranches a b c x $;

theorem sfContextWf_congr (H: wff) (a u: nat) (h0: $ H -> a = u $):
  $ H -> (sfContextWf a <-> sfContextWf u) $;

theorem sfRowWf_congr (H: wff) (a u: nat) (h0: $ H -> a = u $):
  $ H -> (sfRowWf a <-> sfRowWf u) $;

theorem sfContextSub_congr (H: wff) (a b u v: nat) (h0: $ H -> a = u $) (h1: $ H -> b = v $):
  $ H -> (sfContextSub a b <-> sfContextSub u v) $;

theorem sfContextSub_congr_source (H: wff) (a b u: nat) (h: $ H -> a = u $):
  $ H -> (sfContextSub a b <-> sfContextSub u b) $;

theorem sfContextSub_congr_target (H: wff) (a b v: nat) (h: $ H -> b = v $):
  $ H -> (sfContextSub a b <-> sfContextSub a v) $;
