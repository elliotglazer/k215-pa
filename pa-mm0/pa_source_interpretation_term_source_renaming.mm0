import "pa_source_interpretation_term_induction.mm0";

import "pa_source_interpretation_term_renaming.mm0";

import "pa_source_interpretation_term_source_bound.mm0";

import "pa_source_interpretation_graph_renaming.mm0";

def paTermSourceRenameClass (R: set) (n .c: nat): set = $ {c | paTermBound n c /\ paTermSource (paTermRename R c) = sfRename (paTermGraphMap R) 0 (paTermSource c)} $;

theorem paTermSource_renaming (R: set) (n c: nat): $ paTermBound n c -> paTermSource (paTermRename R c) = sfRename (paTermGraphMap R) 0 (paTermSource c) $;
