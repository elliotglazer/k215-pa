import "source_reflection_transfer_tv_existential.mm0";

import "source_domain_discharge.mm0";

theorem sfTVEx_project_closed(G A Q:nat)(hG:$ sfTheoryContext sfClosedFormulaClass G $)(ha:$ sfWf A $)(hq:$ sfBound 0 Q $)(hp:$ nsLocal (A : G) Q $): $ nsLocal G (sfImp (sfEx A) Q) $;

theorem sfTVTheory_exists_closed(T:set)(A Q:nat)(ht:$ sfTheoryClosed T $)(hq:$ sfBound 0 Q $)(hi:$ sfTheoryProvable T (sfImp A Q) $)(he:$ sfTheoryProvable T (sfEx A) $): $ sfTheoryProvable T Q $;

theorem sfTVTheory_syllogism(T:set)(A B C:nat)(ht:$ sfTheoryClosed T $)(hAB:$ sfTheoryProvable T (sfImp A B) $)(hBC:$ sfTheoryProvable T (sfImp B C) $): $ sfTheoryProvable T (sfImp A C) $;
