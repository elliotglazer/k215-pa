theorem pcrd_lift_second(T:set)(G r h n e z a:nat)(hz:$ sfShift 0 a = a $):
 $ (nsLocal (pcrdFirstContext T G r h n e) a) -> (nsLocal (pcrdSecondContext T G r h n e z) a) $ =
