 $ sfPieceEnvDomainGood T n -> (nsLocal G sfPieceRepDomainBaseLaw) -> (nsLocal G sfPieceRepDomainStepLaw) -> (nsLocal G (sfPieceEnv (sfPieceRepOffset T r h) (suc n) e)) -> (nsLocal G (sfPieceNumeral (suc n) z)) -> (nsLocal G (sfPieceRepDomain e z)) $ =
 '(exp (exp (exp (exp (mpd (mpd (mpd (anwl (anwl anr)) (mpd (anwl (anwl (anwl anr))) (mpd (anwl (anwl (anwl (anwl id)))) (a1i pcrd_inner_domain)))) (mpd (mpd anr (a1i pcrd_first_num)) (a1i (sfLocal_exE sfShift_wf)))) (mpd (mpd (anwl anr) (a1i (bi1 (nsLocal_formula_eq sfPieceEnv_offset_suc)))) (a1i (sfLocal_exE sfPieceRepDomain_wf))))))));

theorem pcrd_good_step(T:set)(n:nat):
 $ sfPieceEnvDomainGood T n -> sfPieceEnvDomainGood T (suc n) $ =
 (named '(iald (iald (iald (iald (iald pcrd_good_step_at))))));

pub theorem sfPieceEnv_domain_induction(T:set)(n:nat):
 $ sfPieceEnvDomainGood T n $ =
 (named @ induct '(ind) 'n 'pcrd_good_zero 'pcrd_good_step);

pub theorem sfPieceEnv_domain_from_laws(T:set)(G n e z:nat)(hb:$ nsLocal G sfPieceRepDomainBaseLaw $)(hs:$ nsLocal G sfPieceRepDomainStepLaw $)(he:$ nsLocal G (sfPieceEnv T n e) $)(hn:$ nsLocal G (sfPieceNumeral n z) $):
 $ (nsLocal G (sfPieceRepDomain e z)) $ =
 '(ax_mp (ax_mp (ax_mp (ax_mp (ax_mp pcrd_good_at sfPieceEnv_domain_induction) hb) hs) (mpbir (nsLocal_formula_eq sfPieceEnv_offset_origin) he)) hn);
