 $ (nsLocal G sfPieceRepDomainBaseLaw) -> (nsLocal G sfPieceRepDomainStepLaw) -> (nsLocal G (sfPieceEnv (sfPieceRepOffset T r h) 0 e)) -> (nsLocal G (sfPieceNumeral 0 z)) -> (nsLocal G (sfPieceRepDomain e z)) $ =
 '(exp (exp (exp (mpd (mpd anr (a1i (bi1 (nsLocal_formula_eq sfPieceNumeral_zero)))) (mpd (mpd (anwl anr) (a1i (bi1 (nsLocal_formula_eq sfPieceEnv_zero)))) (mpd (anwl (anwl (anwl id))) (a1i pcrd_base_use)))))));

@_ def pcrdGoodAt1(T:set)(n G .r .h .e .z:nat):wff = $ A. r A. h A. e A. z ((nsLocal G sfPieceRepDomainBaseLaw) -> (nsLocal G sfPieceRepDomainStepLaw) -> (nsLocal G (sfPieceEnv (sfPieceRepOffset T r h) n e)) -> (nsLocal G (sfPieceNumeral n z)) -> (nsLocal G (sfPieceRepDomain e z))) $;

theorem pcrd_good_part1(T:set)(n G:nat):
 $ sfPieceEnvDomainGood T n -> pcrdGoodAt1 T n G $ =
 (named '(!! eale j0 ,eqtac));

@_ def pcrdGoodAt2(T:set)(n G r .h .e .z:nat):wff = $ A. h A. e A. z ((nsLocal G sfPieceRepDomainBaseLaw) -> (nsLocal G sfPieceRepDomainStepLaw) -> (nsLocal G (sfPieceEnv (sfPieceRepOffset T r h) n e)) -> (nsLocal G (sfPieceNumeral n z)) -> (nsLocal G (sfPieceRepDomain e z))) $;

theorem pcrd_good_part2(T:set)(n G r:nat):
 $ pcrdGoodAt1 T n G -> pcrdGoodAt2 T n G r $ =
 (named '(!! eale j0 ,eqtac));

@_ def pcrdGoodAt3(T:set)(n G r h .e .z:nat):wff = $ A. e A. z ((nsLocal G sfPieceRepDomainBaseLaw) -> (nsLocal G sfPieceRepDomainStepLaw) -> (nsLocal G (sfPieceEnv (sfPieceRepOffset T r h) n e)) -> (nsLocal G (sfPieceNumeral n z)) -> (nsLocal G (sfPieceRepDomain e z))) $;

theorem pcrd_good_part3(T:set)(n G r h:nat):
 $ pcrdGoodAt2 T n G r -> pcrdGoodAt3 T n G r h $ =
 (named '(!! eale j0 ,eqtac));

@_ def pcrdGoodAt4(T:set)(n G r h e .z:nat):wff = $ A. z ((nsLocal G sfPieceRepDomainBaseLaw) -> (nsLocal G sfPieceRepDomainStepLaw) -> (nsLocal G (sfPieceEnv (sfPieceRepOffset T r h) n e)) -> (nsLocal G (sfPieceNumeral n z)) -> (nsLocal G (sfPieceRepDomain e z))) $;

theorem pcrd_good_part4(T:set)(n G r h e:nat):
 $ pcrdGoodAt3 T n G r h -> pcrdGoodAt4 T n G r h e $ =
 (named '(!! eale j0 ,eqtac));

@_ def pcrdGoodAt5(T:set)(n G r h e z:nat):wff = $ ((nsLocal G sfPieceRepDomainBaseLaw) -> (nsLocal G sfPieceRepDomainStepLaw) -> (nsLocal G (sfPieceEnv (sfPieceRepOffset T r h) n e)) -> (nsLocal G (sfPieceNumeral n z)) -> (nsLocal G (sfPieceRepDomain e z))) $;

theorem pcrd_good_part5(T:set)(n G r h e z:nat):
 $ pcrdGoodAt4 T n G r h e -> pcrdGoodAt5 T n G r h e z $ =
 (named '(!! eale j0 ,eqtac));

theorem pcrd_good_at(T:set)(G r h n e z:nat):
 $ sfPieceEnvDomainGood T n -> (nsLocal G sfPieceRepDomainBaseLaw) -> (nsLocal G sfPieceRepDomainStepLaw) -> (nsLocal G (sfPieceEnv (sfPieceRepOffset T r h) n e)) -> (nsLocal G (sfPieceNumeral n z)) -> (nsLocal G (sfPieceRepDomain e z)) $ =
 '(syl pcrd_good_part5 (syl pcrd_good_part4 (syl pcrd_good_part3 (syl pcrd_good_part2 pcrd_good_part1))));

theorem pcrd_good_zero(T:set):
 $ sfPieceEnvDomainGood T 0 $ =
 (named '(ax_gen (ax_gen (ax_gen (ax_gen (ax_gen pcrd_good_zero_at))))));

