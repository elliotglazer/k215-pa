theorem pcrd_inner_domain(T:set)(G r h n e z:nat):
 $ sfPieceEnvDomainGood T n -> (nsLocal G sfPieceRepDomainBaseLaw) -> (nsLocal G sfPieceRepDomainStepLaw) -> (nsLocal (pcrdSecondContext T G r h n e z) (sfShift 0 (sfShift 0 (sfPieceRepDomain e z)))) $ =
 '(exp (exp (mpd (mpd (a1i pcrd_second_succ) (mpd (mpd (a1i pcrd_second_num) (mpd (a1i pcrd_second_env) (mpd (mpd anr (a1i pcrd_step_to_second)) (mpd (mpd (anwl anr) (a1i pcrd_base_to_second)) (mpd (anwl (anwl id)) (a1i pcrd_good_at)))))) (mpd (a1i pcrd_second_ext) (mpd (mpd anr (a1i pcrd_step_to_second)) (a1i pcrd_step_use))))) (a1i (bi2 (nsLocal_formula_eq pcrd_domain_shift2))))));

