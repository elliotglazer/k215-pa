 '(eqtr sfSubst_sfAll (nsAll_eq (eqtr sfSubst_sfAll (nsAll_eq (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepExtension_subst (sfPieceRepExtension_eq (eqtr sfSubstIndex_lift (suceq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor)))) (eqtr sfSubstIndex_lift (suceq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor)))) (eqtr sfSubstIndex_lift (suceq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_zero)))))) (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepDomain_subst (sfPieceRepDomain_eq (eqtr sfSubstIndex_lift (suceq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor)))) (ax_mp sfSubstIndex_bound (mpbi ltsuc lt01S)))) (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepSuccessor_subst (sfPieceRepSuccessor_eq (ax_mp sfSubstIndex_bound (mpbi ltsuc lt01S)) (ax_mp sfSubstIndex_bound lt01S))) (eqtr sfPieceRepDomain_subst (sfPieceRepDomain_eq (eqtr sfSubstIndex_lift (suceq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_zero)))) (ax_mp sfSubstIndex_bound lt01S)))))))))))));

theorem pcrd_step_inst2(G e v z:nat):
 $ nsLocal G sfPieceRepDomainStepLaw -> nsLocal G (sfAll (sfAll (sfImp (sfPieceRepExtension (suc (suc e)) (suc (suc v)) (suc (suc z))) (sfImp (sfPieceRepDomain (suc (suc e)) 1) (sfImp (sfPieceRepSuccessor 1 0) (sfPieceRepDomain (suc (suc z)) 0)))))) $ =
 '(syl (syl (bi1 (nsLocal_formula_eq pcrd_step_open2)) nsLocal_AllE) pcrd_step_inst1);

theorem pcrd_step_open3(e v z d:nat):
 $ sfSubst 0 d (sfAll (sfImp (sfPieceRepExtension (suc (suc e)) (suc (suc v)) (suc (suc z))) (sfImp (sfPieceRepDomain (suc (suc e)) 1) (sfImp (sfPieceRepSuccessor 1 0) (sfPieceRepDomain (suc (suc z)) 0))))) = (sfAll (sfImp (sfPieceRepExtension (suc e) (suc v) (suc z)) (sfImp (sfPieceRepDomain (suc e) (suc d)) (sfImp (sfPieceRepSuccessor (suc d) 0) (sfPieceRepDomain (suc z) 0))))) $ =
 '(eqtr sfSubst_sfAll (nsAll_eq (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepExtension_subst (sfPieceRepExtension_eq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor)) (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor)) (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor)))) (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepDomain_subst (sfPieceRepDomain_eq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor)) (eqtr sfSubstIndex_lift (suceq sfSubstIndex_zero)))) (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepSuccessor_subst (sfPieceRepSuccessor_eq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_zero)) (ax_mp sfSubstIndex_bound lt01S))) (eqtr sfPieceRepDomain_subst (sfPieceRepDomain_eq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor)) (ax_mp sfSubstIndex_bound lt01S)))))))))));

theorem pcrd_step_inst3(G e v z d:nat):
 $ nsLocal G sfPieceRepDomainStepLaw -> nsLocal G (sfAll (sfImp (sfPieceRepExtension (suc e) (suc v) (suc z)) (sfImp (sfPieceRepDomain (suc e) (suc d)) (sfImp (sfPieceRepSuccessor (suc d) 0) (sfPieceRepDomain (suc z) 0))))) $ =
 '(syl (syl (bi1 (nsLocal_formula_eq pcrd_step_open3)) nsLocal_AllE) pcrd_step_inst2);

theorem pcrd_step_open4(e v z d u:nat):
 $ sfSubst 0 u (sfImp (sfPieceRepExtension (suc e) (suc v) (suc z)) (sfImp (sfPieceRepDomain (suc e) (suc d)) (sfImp (sfPieceRepSuccessor (suc d) 0) (sfPieceRepDomain (suc z) 0)))) = (sfImp (sfPieceRepExtension e v z) (sfImp (sfPieceRepDomain e d) (sfImp (sfPieceRepSuccessor d u) (sfPieceRepDomain z u)))) $ =
 '(eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepExtension_subst (sfPieceRepExtension_eq sfSubstIndex_successor sfSubstIndex_successor sfSubstIndex_successor)) (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepDomain_subst (sfPieceRepDomain_eq sfSubstIndex_successor sfSubstIndex_successor)) (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepSuccessor_subst (sfPieceRepSuccessor_eq sfSubstIndex_successor sfSubstIndex_zero)) (eqtr sfPieceRepDomain_subst (sfPieceRepDomain_eq sfSubstIndex_successor sfSubstIndex_zero))))))));

theorem pcrd_step_inst4(G e v z d u:nat):
 $ nsLocal G sfPieceRepDomainStepLaw -> nsLocal G (sfImp (sfPieceRepExtension e v z) (sfImp (sfPieceRepDomain e d) (sfImp (sfPieceRepSuccessor d u) (sfPieceRepDomain z u)))) $ =
 '(syl (syl (bi1 (nsLocal_formula_eq pcrd_step_open4)) nsLocal_AllE) pcrd_step_inst3);

pub theorem pcrd_step_use(G e v z d u:nat):
 $ nsLocal G sfPieceRepDomainStepLaw -> nsLocal G (sfPieceRepExtension e v z) -> nsLocal G (sfPieceRepDomain e d) -> nsLocal G (sfPieceRepSuccessor d u) -> nsLocal G (sfPieceRepDomain z u) $ =
 '(syl (syl6 (syl6 nsLocal_mp nsLocal_mp) nsLocal_mp) pcrd_step_inst4);

@_ def pcrdEnvBody(T:set)(r h n e:nat):nat = $ sfAnd (sfPieceEnv (sfPieceRepOffset T (suc r) (suc h)) n 0) (sfPieceRepExtension 0 (suc (h + (T @ r))) (suc e)) $;

@_ def pcrdNumBody(n z:nat):nat = $ sfAnd (sfPieceNumeral n 0) (sfPieceRepSuccessor 0 (suc (suc z))) $;

@_ def pcrdFirstContext(T:set)(G r h n e:nat):nat = $ pcrdEnvBody T r h n e : sfContextShift G $;

@_ def pcrdSecondContext(T:set)(G r h n e z:nat):nat = $ pcrdNumBody n z : sfContextShift (pcrdFirstContext T G r h n e) $;

@_ def sfPieceEnvDomainGood(T:set)(n .J .r .h .e .z:nat):wff = $ A. J A. r A. h A. e A. z (nsLocal J sfPieceRepDomainBaseLaw -> nsLocal J sfPieceRepDomainStepLaw -> nsLocal J (sfPieceEnv (sfPieceRepOffset T r h) n e) -> nsLocal J (sfPieceNumeral n z) -> nsLocal J (sfPieceRepDomain e z)) $;

