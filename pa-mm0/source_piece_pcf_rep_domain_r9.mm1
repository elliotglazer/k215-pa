 '(ax_mp (ax_mp (ax_mp nsLocal_weaken pcrd_second_wf) sfContextSub_cons) (mpbi (nsLocal_formula_eq pcrd_extension_shift) (ax_mp sfSepLocal_shift pcrd_first_ext)));

theorem pcrd_lift_first(T:set)(G r h n e a:nat)(hz:$ sfShift 0 a = a $):
 $ (nsLocal G a) -> (nsLocal (pcrdFirstContext T G r h n e) a) $ =
