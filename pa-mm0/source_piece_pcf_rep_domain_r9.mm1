 $ (nsLocal G sfPieceRepDomainBaseLaw) -> (nsLocal (pcrdSecondContext T G r h n e z) sfPieceRepDomainBaseLaw) $ =
 '(syl (pcrd_lift_second pcrd_base_shift) (pcrd_lift_first pcrd_base_shift));

theorem pcrd_step_to_second(T:set)(G r h n e z:nat):
 $ (nsLocal G sfPieceRepDomainStepLaw) -> (nsLocal (pcrdSecondContext T G r h n e z) sfPieceRepDomainStepLaw) $ =
