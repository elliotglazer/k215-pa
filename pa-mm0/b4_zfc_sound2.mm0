theorem bdRRen2_quant(m v i d c y t a b: nat) {x: nat}: $ bdHasOK m v i /\ c = sfNode t a b /\ (t = 6 \/ t = 7) /\ b = 0 -> E. x (x <= y /\ bdHas m v i bdtRen 2 (suc d) a x /\ bdNode t x 0 y) -> sfRename sfRepBMap d c = y $;
theorem bdRRen2_junk (d c y t a b: nat): $ c = sfNode t a b /\ t < 8 -> y = 0 /\ (t = 0 \/ ((t = 6 \/ t = 7) /\ b != 0)) -> sfRename sfRepBMap d c = y $;
theorem bdRRen2_sound (m v i d c y: nat): $ bdHasOK m v i -> bdRRen m v i 2 d c y -> sfRename sfRepBMap d c = y $;
theorem bdRRen3_has (m v i d a x: nat): $ bdHasOK m v i -> bdHas m v i bdtRen 3 d a x -> sfRename sfRepCMap d a = x $;
theorem bdRRen3_hass (m v i d a x: nat): $ bdHasOK m v i -> bdHas m v i bdtRen 3 (suc d) a x -> sfRename sfRepCMap (suc d) a = x $;
