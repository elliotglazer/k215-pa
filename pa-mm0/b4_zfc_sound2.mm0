theorem bdRRen1_junk (d c y t a b: nat): $ c = sfNode t a b /\ t < 8 -> y = 0 /\ (t = 0 \/ ((t = 6 \/ t = 7) /\ b != 0)) -> sfRename sfRepAMap d c = y $;
theorem bdRRen1_sound (m v i d c y: nat): $ bdHasOK m v i -> bdRRen m v i 1 d c y -> sfRename sfRepAMap d c = y $;
