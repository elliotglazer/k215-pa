import "b4_zfc_sound1.mm0";

theorem bdLt4 (e: nat): $ e < 4 -> e = 0 \/ e = 1 \/ e = 2 \/ e = 3 $;
theorem bdRenG_0 (d c y: nat): $ bdRenG 0 d c y <-> sfRename sfSepMap d c = y $;
theorem bdRenG_1 (d c y: nat): $ bdRenG 1 d c y <-> sfRename sfRepAMap d c = y $;
theorem bdRenG_2 (d c y: nat): $ bdRenG 2 d c y <-> sfRename sfRepBMap d c = y $;
theorem bdRenG_3 (d c y: nat): $ bdRenG 3 d c y <-> sfRename sfRepCMap d c = y $;
theorem bdRShift_has (m v i d a x: nat): $ bdHasOK m v i -> bdHas m v i bdtShift d a x 0 -> sfShift d a = x $;
theorem bdRShift_hass (m v i d a x: nat): $ bdHasOK m v i -> bdHas m v i bdtShift (suc d) a x 0 -> sfShift (suc d) a = x $;
theorem bdRShift_atom(m v i d c y t a b: nat) {x z: nat}: $ c = sfNode t a b /\ (t = 1 \/ t = 2) -> E. x (x <= y /\ E. z (z <= y /\ bdShIdx d a x /\ bdShIdx d b z /\ bdNode t x z y)) -> sfShift d c = y $;
theorem bdRShift_bin(m v i d c y t a b: nat) {x z: nat}: $ bdHasOK m v i /\ c = sfNode t a b /\ (t = 3 \/ t = 4 \/ t = 5) -> E. x (x <= y /\ E. z (z <= y /\ bdHas m v i bdtShift d a x 0 /\ bdHas m v i bdtShift d b z 0 /\ bdNode t x z y)) -> sfShift d c = y $;
theorem bdRShift_quant(m v i d c y t a b: nat) {x: nat}: $ bdHasOK m v i /\ c = sfNode t a b /\ (t = 6 \/ t = 7) /\ b = 0 -> E. x (x <= y /\ bdHas m v i bdtShift (suc d) a x 0 /\ bdNode t x 0 y) -> sfShift d c = y $;
theorem bdRShift_junk (d c y t a b: nat): $ c = sfNode t a b /\ t < 8 -> y = 0 /\ (t = 0 \/ ((t = 6 \/ t = 7) /\ b != 0)) -> sfShift d c = y $;
theorem bdRShift_sound (m v i d c y: nat): $ bdHasOK m v i -> bdRShift m v i d c y -> sfShift d c = y $;
theorem bdRSubst_has (m v i d s a x: nat): $ bdHasOK m v i -> bdHas m v i bdtSubst d s a x -> sfSubst d s a = x $;
theorem bdRSubst_hass (m v i d s a x: nat): $ bdHasOK m v i -> bdHas m v i bdtSubst (suc d) s a x -> sfSubst (suc d) s a = x $;
theorem bdRSubst_atom(m v i d s c y t a b: nat) {x z: nat}: $ c = sfNode t a b /\ (t = 1 \/ t = 2) -> E. x (x <= y /\ E. z (z <= y /\ bdSbIdx d s a x /\ bdSbIdx d s b z /\ bdNode t x z y)) -> sfSubst d s c = y $;
theorem bdRSubst_bin(m v i d s c y t a b: nat) {x z: nat}: $ bdHasOK m v i /\ c = sfNode t a b /\ (t = 3 \/ t = 4 \/ t = 5) -> E. x (x <= y /\ E. z (z <= y /\ bdHas m v i bdtSubst d s a x /\ bdHas m v i bdtSubst d s b z /\ bdNode t x z y)) -> sfSubst d s c = y $;
theorem bdRSubst_quant(m v i d s c y t a b: nat) {x: nat}: $ bdHasOK m v i /\ c = sfNode t a b /\ (t = 6 \/ t = 7) /\ b = 0 -> E. x (x <= y /\ bdHas m v i bdtSubst (suc d) s a x /\ bdNode t x 0 y) -> sfSubst d s c = y $;
theorem bdRSubst_junk (d s c y t a b: nat): $ c = sfNode t a b /\ t < 8 -> y = 0 /\ (t = 0 \/ ((t = 6 \/ t = 7) /\ b != 0)) -> sfSubst d s c = y $;
theorem bdRSubst_sound (m v i d s c y: nat): $ bdHasOK m v i -> bdRSubst m v i d s c y -> sfSubst d s c = y $;
theorem bdRRen0_has (m v i d a x: nat): $ bdHasOK m v i -> bdHas m v i bdtRen 0 d a x -> sfRename sfSepMap d a = x $;
theorem bdRRen0_hass (m v i d a x: nat): $ bdHasOK m v i -> bdHas m v i bdtRen 0 (suc d) a x -> sfRename sfSepMap (suc d) a = x $;
theorem bdRRen0_atom(m v i d c y t a b: nat) {x z: nat}: $ c = sfNode t a b /\ (t = 1 \/ t = 2) -> E. x (x <= y /\ E. z (z <= y /\ bdRnIdx 0 d a x /\ bdRnIdx 0 d b z /\ bdNode t x z y)) -> sfRename sfSepMap d c = y $;
theorem bdRRen0_bin(m v i d c y t a b: nat) {x z: nat}: $ bdHasOK m v i /\ c = sfNode t a b /\ (t = 3 \/ t = 4 \/ t = 5) -> E. x (x <= y /\ E. z (z <= y /\ bdHas m v i bdtRen 0 d a x /\ bdHas m v i bdtRen 0 d b z /\ bdNode t x z y)) -> sfRename sfSepMap d c = y $;
theorem bdRRen0_quant(m v i d c y t a b: nat) {x: nat}: $ bdHasOK m v i /\ c = sfNode t a b /\ (t = 6 \/ t = 7) /\ b = 0 -> E. x (x <= y /\ bdHas m v i bdtRen 0 (suc d) a x /\ bdNode t x 0 y) -> sfRename sfSepMap d c = y $;
theorem bdRRen0_junk (d c y t a b: nat): $ c = sfNode t a b /\ t < 8 -> y = 0 /\ (t = 0 \/ ((t = 6 \/ t = 7) /\ b != 0)) -> sfRename sfSepMap d c = y $;
theorem bdRRen0_sound (m v i d c y: nat): $ bdHasOK m v i -> bdRRen m v i 0 d c y -> sfRename sfSepMap d c = y $;
theorem bdRRen1_has (m v i d a x: nat): $ bdHasOK m v i -> bdHas m v i bdtRen 1 d a x -> sfRename sfRepAMap d a = x $;
