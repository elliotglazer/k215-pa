import "bb215_arithmetic_formula_pair.mm0";

import "bb215_tables.mm0";

theorem bb215TableArithmeticBit (a: nat): $ a <= 1 <-> a = 0 \/ a = 1 $;

theorem bb215TableArithmeticPairComponents (w r a: nat): $ bb215ArithmeticFormulaPairGraph w r a <-> fst a = w /\ snd a = r $;

def bb215TableArithmeticBitPair (r a: nat): wff = $ bb215ArithmeticFormulaPairGraph 0 r a \/ bb215ArithmeticFormulaPairGraph 1 r a $;

theorem bb215TableArithmeticBitPair_components (r a: nat): $ bb215TableArithmeticBitPair r a <-> fst a <= 1 /\ snd a = r $;

def bb215TableArithmeticActionGraph (a .r .t .k: nat): wff = $ E. r E. t E. k (bb215TableArithmeticBitPair r a /\ bb215TableArithmeticBitPair t r /\ t + k = k215Num215) $;

theorem bb215TableArithmeticActionGraph_correct (a: nat) {r t k: nat}: $ bb215TableArithmeticActionGraph a <-> k215TMValidAction a $;
