import "pa_proof_numeral_level_map.mm0";

import "pa_proof_numeral_level_bounds.mm0";

theorem paProofRules_levelShift (k r l: nat): $ (r, l) e. paProofRules -> (paProofLevelShift k r, paProofTraceLevelShift k l) e. paProofRules $;

theorem paProofValid_levelShift (k p: nat): $ paProofValid p -> paProofValid (paProofTraceLevelShift k p) $;

theorem paProofDerives_levelShift (k p r: nat): $ paProofDerives p r -> paProofDerives (paProofTraceLevelShift k p) (paProofLevelShift k r) $;

theorem paProofDerives_levelShift_row (k n c h p: nat): $ paProofDerives p (paProofRow n c h) -> paProofDerives (paProofTraceLevelShift k p) (paProofRow (n + k) c (paProofLevelShiftAnnotation k n c h)) $;

theorem paProofDerives_levelShift_zero (k c h p: nat): $ paProofDerives p (paProofRow 0 c h) -> paProofDerives (paProofTraceLevelShift k p) (paProofRow k c (paProofLevelShiftAnnotation k 0 c h)) $;
