import "source_domain_fixed.mm0";
import "source_l_domain.mm0";

theorem sfLRefl_zfr: $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcRefl) $;
theorem sfLSym_zfr: $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcSym) $;
theorem sfLTrans_zfr: $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcTrans) $;
theorem sfLEqElem_zfr: $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcEqElem) $;

theorem sfLEqualityFixed_image (a: nat):
 $ sfDomainEqualityFixed a -> sfTheoryProvable zfrAxioms (sfRelativize sfLDomain a) $;
