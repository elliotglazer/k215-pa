import "source_l_separation_image_reflected_collection.mm0";

import "source_l_common_level_zero_lift.mm0";

def sfLReplacementCommonProducerContext(count phi:nat):nat =
 $ sfLReplacementLevelExtension : (sfLReplacementAboveLaw count phi :
   (sfLReplacementLevelExistsLaw : (sfReflectionHierarchySubsetNormal sfCLHierarchy :
     (sfCLRecipe 0 0 : 0)))) $;

def lrscmInput(params count phi:nat):nat =
 $ sfCLPredicates sfLDomain 0 params : sfLReplacementCommonProducerContext count phi $;

theorem sfLReplacementCommonReflected_local(params count phi:nat)(hb:$ sfBound count phi $):
 $ nsLocal (sfLReplacementCommonProducerContext count phi) (sfCLCommonReflectedLaw 0 params count phi) $;

theorem sfLReplacementCommonReflected_from_source_proofs(params count phi:nat)
 (hb:$ sfBound count phi $)
 (hE:$ sfTheoryProvable zfrAxioms sfLReplacementLevelExtension $)
 (hA:$ sfTheoryProvable zfrAxioms (sfLReplacementAboveLaw count phi) $)
 (hL:$ sfTheoryProvable zfrAxioms sfLReplacementLevelExistsLaw $)
 (hS:$ sfTheoryProvable zfrAxioms (sfReflectionHierarchySubsetNormal sfCLHierarchy) $):
 $ sfTheoryProvable zfrAxioms (sfCLCommonReflectedLaw 0 params count phi) $;
