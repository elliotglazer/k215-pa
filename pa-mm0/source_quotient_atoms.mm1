import "source_named_renaming.mm1";

import "source_quotient_bounds.mm1";

import "quotation_environment.mm1";

theorem sqaEnv_value (z a b i: nat): $ sqAtomEnvironment z a b @ i = if (i = 0) z (if (i = 1) a b) $ = (named '(!! applame j ,eqtac));

theorem sqaApplyIf (E: set) (p: wff) (a b: nat): $ E @ (if p a b) = if p (E @ a) (E @ b) $ = '(cases (eqtr4d (appeq2d ifpos) ifpos) (eqtr4d (appeq2d ifneg) ifneg));

theorem sqaEnv_point (E: set) (z a b i: nat): $ sfComposeMap E (sqAtomEnvironment z a b) @ i = sqAtomEnvironment (E @ z) (E @ a) (E @ b) @ i $ = '(eqtr sfComposeMap_value (eqtr (appeq2 sqaEnv_value) (eqtr sqaApplyIf (eqtr (ifeq3 sqaApplyIf) (eqcom sqaEnv_value)))));

theorem sqaEnv_agree (E: set) (z a b n: nat): $ sqEnvAgree (sfComposeMap E (sqAtomEnvironment z a b)) (sqAtomEnvironment (E @ z) (E @ a) (E @ b)) n $ = (named '(ax_gen (a1i sqaEnv_point)));

pub theorem sfQuotientMem_named (E: set) (z a b k: nat): $ sfNamedTemplate E k 0 (sfQuotientMem z a b) = sqMember (E @ z) (E @ a) (E @ b) k $ = '(eqtr (ax_mp sfNamedTemplate_source_renaming sqMemberSource_wf) (ax_mp (sfNamedTemplate_environment sqaEnv_agree) (mpbir (srecpeq2 (preq1 add01)) sqMemberSource_bound)));

pub theorem sqQuote_mem_zero (E: set) (t k a b: nat): $ sqQuote E t k 0 (sfMem a b) = sqMember t (E @ a) (E @ b) k $ = '(eqtr sqQuote_sfMem (sqMembereq eqid sfNamedIndex_zero sfNamedIndex_zero add02));

pub theorem sfQuotient_mem_quote (E: set) (z a b k: nat): $ sfNamedTemplate E k 0 (sfQuotient z (sfMem a b)) = sqQuote E (E @ z) k 0 (sfMem a b) $ = '(eqtr (sfNamedTemplateeq4 sfQuotient_sfMem) (eqtr sfQuotientMem_named (eqcom sqQuote_mem_zero)));

pub theorem sfQuotientEq_named (E: set) (z a b k: nat): $ sfNamedTemplate E k 0 (sfQuotientEq z a b) = sqEqual (E @ z) (E @ a) (E @ b) k $ = '(eqtr (ax_mp sfNamedTemplate_source_renaming sqEqualSource_wf) (ax_mp (sfNamedTemplate_environment sqaEnv_agree) (mpbir (srecpeq2 (preq1 add01)) sqEqualSource_bound)));

pub theorem sqQuote_eq_zero (E: set) (t k a b: nat): $ sqQuote E t k 0 (sfEq a b) = sqEqual t (E @ a) (E @ b) k $ = '(eqtr sqQuote_sfEq (sqEqualeq eqid sfNamedIndex_zero sfNamedIndex_zero add02));

pub theorem sfQuotient_eq_quote (E: set) (z a b k: nat): $ sfNamedTemplate E k 0 (sfQuotient z (sfEq a b)) = sqQuote E (E @ z) k 0 (sfEq a b) $ = '(eqtr (sfNamedTemplateeq4 sfQuotient_sfEq) (eqtr sfQuotientEq_named (eqcom sqQuote_eq_zero)));
