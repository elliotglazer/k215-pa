 $ A. y A. z k215PIter (3 * x + 1) (k215Loop4694State k215PNum4694 x y z c) = (k215Loop4694State k215PNum4697 0 (x + y) z c) $;

theorem k215Loop4694Transfer (x y z c: nat): $ k215PIter (3 * x + 1) (k215Loop4694State k215PNum4694 x y z c) = (k215Loop4694State k215PNum4697 0 (x + y) z c) $;

theorem k215Loop4694Vector (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ k215PIter (3 * a6 + 1) (k215PState k215PNum4694 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) =
   k215PState k215PNum4697 (k215PVector a0 a1 a2 a3 (a6 + a4) a5 0 a7 a8) $;
