import "source_piece_pcf_rep_transport.mm1";

import "source_l_common_level_setrel_renaming.mm1";

import "source_wf_separation_logic.mm1";

@_ abstract def sfPieceRepresentationAt (T:set) (G A R phi e:nat): wff = $ nsLocal G (sfIff (sfMem e R) (sfCLSetRel A (sfRename T 0 phi))) $;

theorem sfPieceDefinableBot_empty_open (R e:nat): $ sfSubst 0 e (sfImp (sfMem 0 (suc R)) sfBot) = sfImp (sfMem e R) sfBot $ = (named '(eqtr sfSubst_sfImp (nsImp_eq (eqtr sfSubst_sfMem (nsMem_eq sfSubstIndex_zero sfSubstIndex_successor)) sfSubst_bot)));

pub theorem sfPieceDefinableBot_empty_eliminate (G R e:nat) (he:$ nsLocal G (sfPieceRepEmpty R) $): $ nsLocal G (sfImp (sfMem e R) sfBot) $ = (named '(sfRQ_rewrite sfPieceDefinableBot_empty_open (ax_mp nsLocal_AllE he)));

pub theorem sfPieceDefinableBot_member_iff (G R e:nat) (he:$ nsLocal G (sfPieceRepEmpty R) $): $ nsLocal G (sfIff (sfMem e R) sfBot) $ = (named '(ax_mp (ax_mp sfLocal_and (sfPieceDefinableBot_empty_eliminate he)) (ax_mp nsLocal_II (ax_mp (sfLocal_falseE sfWf_mem) (ax_mp (ax_mp nsLocal_hyp (mpbir sfContextWf_cons (ian sfWf_bot (ax_mp nsLocal_context_wf he)))) sfContext_member_head)))));

pub theorem sfPieceDefinableBot_matrix (T:set) (A:nat): $ sfCLSetRel A (sfRename T 0 sfBot) = sfBot $ = (named '(eqtr (trud (sfCLSetRel_formula_congr (a1i eqid) (a1i sfRename_bot))) sfCLSetRel_bot));

pub theorem sfPieceDefinableBot_represents (T:set) (G A R e:nat) (he:$ nsLocal G (sfPieceRepEmpty R) $): $ sfPieceRepresentationAt T G A R sfBot e $ = (named '(sfRQ_rewrite (nsAnd_eq (nsImp_eq eqid (eqcom sfPieceDefinableBot_matrix)) (nsImp_eq (eqcom sfPieceDefinableBot_matrix) eqid)) (sfPieceDefinableBot_member_iff he)));

theorem sfPieceDefinableBot_empty_shift (R:nat): $ sfShift 0 (sfPieceRepEmpty R) = sfPieceRepEmpty (suc R) $ = (named '(eqtr sfShift_sfAll (nsAll_eq (eqtr sfShift_sfImp (nsImp_eq (eqtr sfShift_sfMem (nsMem_eq (ax_mp sfShiftIndex_bound lt01S) (ax_mp sfShiftIndex_free (mt (bi2 ltsuc) lt02)))) sfShift_bot)))));

pub theorem sfPieceDefinableBot_profile (G R:nat) (he:$ nsLocal G (sfPieceRepEmpty R) $): $ nsLocal G (sfAll (sfIff (sfMem 0 (suc R)) sfBot)) $ = (named '(ax_mp (sfLocal_allI (ax_mp nsLocal_context_wf he)) (sfPieceDefinableBot_member_iff (sfRQ_rewrite sfPieceDefinableBot_empty_shift (ax_mp sfSepLocal_shift he)))));

@_ abstract def sfPieceDefinableBotWitnessBody (C:nat): nat = $ sfAnd (sfMem 0 (suc C)) (sfAll (sfIff (sfMem 0 1) sfBot)) $;

@_ abstract def sfPieceDefinableBotWitness (C:nat): nat = $ sfEx (sfPieceDefinableBotWitnessBody C) $;

pub theorem sfPieceDefinableBotWitness_wf (C:nat): $ sfWf (sfPieceDefinableBotWitness C) $ = (named '(ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and sfWf_mem) (ax_mp sfWf_all (ax_mp (ax_mp sfWf_and (ax_mp (ax_mp sfWf_imp sfWf_mem) sfWf_bot)) (ax_mp (ax_mp sfWf_imp sfWf_bot) sfWf_mem))))));

pub theorem sfPieceDefinableBotWitness_open (C R:nat): $ sfSubst 0 R (sfPieceDefinableBotWitnessBody C) = sfAnd (sfMem R C) (sfAll (sfIff (sfMem 0 (suc R)) sfBot)) $ = (named '(eqtr sfSubst_sfAnd (nsAnd_eq (eqtr sfSubst_sfMem (nsMem_eq sfSubstIndex_zero sfSubstIndex_successor)) (eqtr sfSubst_sfAll (nsAll_eq (eqtr sfSubst_sfAnd (nsAnd_eq (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfSubst_sfMem (nsMem_eq (ax_mp sfSubstIndex_bound lt01S) (eqtr sfSubstIndex_lift (suceq sfSubstIndex_zero)))) sfSubst_bot)) (eqtr sfSubst_sfImp (nsImp_eq sfSubst_bot (eqtr sfSubst_sfMem (nsMem_eq (ax_mp sfSubstIndex_bound lt01S) (eqtr sfSubstIndex_lift (suceq sfSubstIndex_zero)))))))))))));

pub theorem sfPieceDefinableBotWitness_intro (G C R:nat) (he:$ nsLocal G (sfPieceRepEmpty R) $) (hm:$ nsLocal G (sfMem R C) $): $ nsLocal G (sfPieceDefinableBotWitness C) $ = (named '(ax_mp (ax_mp nsLocal_ExI (ax_mp (ax_mp sfWf_and sfWf_mem) (ax_mp sfWf_all (ax_mp (ax_mp sfWf_and (ax_mp (ax_mp sfWf_imp sfWf_mem) sfWf_bot)) (ax_mp (ax_mp sfWf_imp sfWf_bot) sfWf_mem))))) (sfRQ_rewrite (eqcom sfPieceDefinableBotWitness_open) (ax_mp (ax_mp sfLocal_and hm) (sfPieceDefinableBot_profile he)))));

theorem sfPieceDefinableBotWitness_profile_bound: $ sfBound 1 (sfAll (sfIff (sfMem 0 1) sfBot)) $ = (named '(mpbir sfBound_sfAll (mpbir sfBound_sfAnd (ian (mpbir sfBound_sfImp (ian (mpbir sfBound_sfMem (ian lt01S (mpbi ltsuc lt01S))) sfBound_bot)) (mpbir sfBound_sfImp (ian sfBound_bot (mpbir sfBound_sfMem (ian lt01S (mpbi ltsuc lt01S)))))))));

theorem sfPieceDefinableBotWitness_shift (C:nat): $ sfShift 0 (sfPieceDefinableBotWitness C) = sfPieceDefinableBotWitness (suc C) $ = (named '(eqtr sfShift_sfEx (nsEx_eq (eqtr sfShift_sfAnd (nsAnd_eq (eqtr sfShift_sfMem (nsMem_eq (ax_mp sfShiftIndex_bound lt01S) (ax_mp sfShiftIndex_free (mt (bi2 ltsuc) lt02)))) (ax_mp sfShift_bound_identity sfPieceDefinableBotWitness_profile_bound))))));

pub theorem sfPieceDefinableBotWitness_from_empty (G C:nat) (he:$ nsLocal G (sfEx (sfAnd (sfPieceRepEmpty 0) (sfMem 0 (suc C)))) $): $ nsLocal G (sfPieceDefinableBotWitness C) $ = (named '(ax_mp (ax_mp (sfLocal_exE sfPieceDefinableBotWitness_wf) he) (sfRQ_rewrite (eqcom sfPieceDefinableBotWitness_shift) (sfPieceDefinableBotWitness_intro (ax_mp nsLocal_CE1 (ax_mp (ax_mp nsLocal_hyp (mpbir sfContextWf_cons (ian (ax_mp (ax_mp sfWf_and sfPieceRepEmpty_wf) sfWf_mem) sfContextShift_wf))) sfContext_member_head)) (ax_mp nsLocal_CE2 (ax_mp (ax_mp nsLocal_hyp (mpbir sfContextWf_cons (ian (ax_mp (ax_mp sfWf_and sfPieceRepEmpty_wf) sfWf_mem) sfContextShift_wf))) sfContext_member_head))))));
