def bb215ArithmeticFormulaDepthEightSatBody (E: set) (c h .x: nat): wff = $ ifp (c = 0) (0 != 0) (ifp (sfTag c = 1) (bb215ArithmeticFormulaTermValue E (sfLeft c) = bb215ArithmeticFormulaTermValue E (sfRight c)) (ifp (sfTag c = 3) (sfLeft c e. h /\ sfRight c e. h) (ifp (sfTag c = 4) (sfLeft c e. h \/ sfRight c e. h) (ifp (sfTag c = 5) (sfLeft c e. h -> sfRight c e. h) (ifp (sfTag c = 6 /\ sfRight c = 0) (A. x bb215ArithmeticFormulaDepthSevenSat (paNatTermConsEnvironment E x) (sfLeft c)) (ifp (sfTag c = 7 /\ sfRight c = 0) (E. x bb215ArithmeticFormulaDepthSevenSat (paNatTermConsEnvironment E x) (sfLeft c)) (0 != 0))))))) $;

def bb215ArithmeticFormulaDepthEightSatStep (E: set) (.c .h: nat): set = $ S\ c, {h | bb215ArithmeticFormulaDepthEightSatBody E c h} $;

def bb215ArithmeticFormulaDepthEightSat (E: set) (c: nat): wff = $ srecp (bb215ArithmeticFormulaDepthEightSatStep E) c $;

def bb215ArithmeticFormulaDepthEightSatPrevious (E: set) (c .i: nat): nat = $ sep (upto c) {i | srecp (bb215ArithmeticFormulaDepthEightSatStep E) i} $;

theorem bb215ArithmeticFormulaDepthEightSatStep_value (E: set) (c h: nat): $ (c, h) e. bb215ArithmeticFormulaDepthEightSatStep E <-> bb215ArithmeticFormulaDepthEightSatBody E c h $;

theorem bb215ArithmeticFormulaDepthEightSatPrevious_value (E: set) (c a: nat): $ a e. bb215ArithmeticFormulaDepthEightSatPrevious E c <-> a < c /\ bb215ArithmeticFormulaDepthEightSat E a $;

theorem bb215ArithmeticFormulaDepthEightSat_unfold (E: set) (c: nat): $ bb215ArithmeticFormulaDepthEightSat E c <-> bb215ArithmeticFormulaDepthEightSatBody E c (bb215ArithmeticFormulaDepthEightSatPrevious E c) $;

theorem bb215ArithmeticFormulaDepthEightSat_false (E: set): $ bb215ArithmeticFormulaDepthEightSat E paFormulaFalse <-> 0 != 0 $;

theorem bb215ArithmeticFormulaDepthEightSat_equal (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthEightSat E (paFormulaEqual a b) <-> bb215ArithmeticFormulaTermValue E a = bb215ArithmeticFormulaTermValue E b $;

theorem bb215ArithmeticFormulaDepthEightSat_and (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthEightSat E (paFormulaAnd a b) <-> (bb215ArithmeticFormulaDepthEightSat E a /\ bb215ArithmeticFormulaDepthEightSat E b) $;

theorem bb215ArithmeticFormulaDepthEightSat_or (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthEightSat E (paFormulaOr a b) <-> (bb215ArithmeticFormulaDepthEightSat E a \/ bb215ArithmeticFormulaDepthEightSat E b) $;

theorem bb215ArithmeticFormulaDepthEightSat_imp (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthEightSat E (paFormulaImp a b) <-> (bb215ArithmeticFormulaDepthEightSat E a -> bb215ArithmeticFormulaDepthEightSat E b) $;

theorem bb215ArithmeticFormulaDepthEightSat_all (E: set) (a: nat) {x: nat}: $ bb215ArithmeticFormulaDepthEightSat E (paFormulaAll a) <-> A. x bb215ArithmeticFormulaDepthSevenSat (paNatTermConsEnvironment E x) a $;

theorem bb215ArithmeticFormulaDepthEightSat_ex (E: set) (a: nat) {x: nat}: $ bb215ArithmeticFormulaDepthEightSat E (paFormulaEx a) <-> E. x bb215ArithmeticFormulaDepthSevenSat (paNatTermConsEnvironment E x) a $;
