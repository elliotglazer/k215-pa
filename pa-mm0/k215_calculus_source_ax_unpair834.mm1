@_ def k215UnpairAt834State (pc a b n c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) n (k215PR3 c) (k215PR4 c) (k215PR5 c) a b (k215PR8 c)) $;

do (apply (register-eqd 'k215UnpairAt834State) '(k215UnpairAt834Stateeqd));

theorem k215UnpairAt834Transfer (b n c: nat): $ k215PIter (3 * b + 1) (k215UnpairAt834State k215PNum838 0 b n c) = (k215UnpairAt834State k215PNum841 b 0 n c) $ =
 '(eqtr k215Loop838Vector (k215PStateeq2 (k215PVectoreq7 add0)));
theorem k215UnpairAt834ReachTransfer (b n c: nat): $ k215PReach (k215UnpairAt834State k215PNum838 0 b n c) (k215UnpairAt834State k215PNum841 b 0 n c) $ =
 '(k215PReach_intro k215UnpairAt834Transfer);


theorem k215UnpairAt834Step9Z (a b c: nat): $ k215PStep (k215UnpairAt834State k215PNum834 a b 0 c) = (k215UnpairAt834State k215PNum842 a b 0 c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair834_834) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt834Reach9Z (a b c: nat): $ k215PReach (k215UnpairAt834State k215PNum834 a b 0 c) (k215UnpairAt834State k215PNum842 a b 0 c) $ = '(k215PReach_step k215UnpairAt834Step9Z);

theorem k215UnpairAt834Step9S (a b n c: nat): $ k215PStep (k215UnpairAt834State k215PNum834 a b (suc n) c) = (k215UnpairAt834State k215PNum835 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair834_834) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet2_vector)) (eqtr k215PSet2_vector (k215PVectoreq3 (eqtr subSS sub02))))));

theorem k215UnpairAt834Reach9S (a b n c: nat): $ k215PReach (k215UnpairAt834State k215PNum834 a b (suc n) c) (k215UnpairAt834State k215PNum835 a b n c) $ = '(k215PReach_step k215UnpairAt834Step9S);

theorem k215UnpairAt834Step10 (a b n c: nat): $ k215PStep (k215UnpairAt834State k215PNum835 a b n c) = (k215UnpairAt834State k215PNum836 a (suc b) n c) $ = '(eqtr (k215PAtCI k215PLookupUnpair834_835) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215UnpairAt834Reach10 (a b n c: nat): $ k215PReach (k215UnpairAt834State k215PNum835 a b n c) (k215UnpairAt834State k215PNum836 a (suc b) n c) $ = '(k215PReach_step k215UnpairAt834Step10);

theorem k215UnpairAt834Step11Z (b n c: nat): $ k215PStep (k215UnpairAt834State k215PNum836 0 b n c) = (k215UnpairAt834State k215PNum838 0 b n c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair834_836) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt834Reach11Z (b n c: nat): $ k215PReach (k215UnpairAt834State k215PNum836 0 b n c) (k215UnpairAt834State k215PNum838 0 b n c) $ = '(k215PReach_step k215UnpairAt834Step11Z);

theorem k215UnpairAt834Step11S (a b n c: nat): $ k215PStep (k215UnpairAt834State k215PNum836 (suc a) b n c) = (k215UnpairAt834State k215PNum837 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair834_836) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215UnpairAt834Reach11S (a b n c: nat): $ k215PReach (k215UnpairAt834State k215PNum836 (suc a) b n c) (k215UnpairAt834State k215PNum837 a b n c) $ = '(k215PReach_step k215UnpairAt834Step11S);

theorem k215UnpairAt834Step12 (a b n c: nat): $ k215PStep (k215UnpairAt834State k215PNum837 a b n c) = (k215UnpairAt834State k215PNum841 a b n c) $ = '(k215PAtCB k215PLookupUnpair834_837);

theorem k215UnpairAt834Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt834State k215PNum837 a b n c) (k215UnpairAt834State k215PNum841 a b n c) $ = '(k215PReach_step k215UnpairAt834Step12);

theorem k215UnpairAt834Step16 (a b n c: nat): $ k215PStep (k215UnpairAt834State k215PNum841 a b n c) = (k215UnpairAt834State k215PNum834 a b n c) $ = '(k215PAtCC k215PLookupUnpair834_841);

theorem k215UnpairAt834Reach16 (a b n c: nat): $ k215PReach (k215UnpairAt834State k215PNum841 a b n c) (k215UnpairAt834State k215PNum834 a b n c) $ = '(k215PReach_step k215UnpairAt834Step16);

theorem k215UnpairAt834CycleZero (b n c: nat): $ k215PReach (k215UnpairAt834State k215PNum834 0 b (suc n) c) (k215UnpairAt834State k215PNum834 (suc b) 0 n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt834Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt834Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt834Reach11Z) (ax_mp (ax_mp k215PReach_trans k215UnpairAt834ReachTransfer) k215UnpairAt834Reach16))));
theorem k215UnpairAt834CycleSucc (a b n c: nat): $ k215PReach (k215UnpairAt834State k215PNum834 (suc a) b (suc n) c) (k215UnpairAt834State k215PNum834 a (suc b) n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt834Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt834Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt834Reach11S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt834Reach12) k215UnpairAt834Reach16))));


theorem k215UnpairAt834AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt834State k215PNum834 0 b (suc n) c) (k215UnpairAt834State k215PNum834 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt834Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215PairDiagonal_rotate)) (eqtr (eqcom sndpr) (sndeq k215PairDiagonal_rotate)) eqid eqid)) k215UnpairAt834CycleZero);

theorem k215UnpairAt834AdvanceSucc (a b n c: nat): $ k215PReach (k215UnpairAt834State k215PNum834 (suc a) b (suc n) c) (k215UnpairAt834State k215PNum834 (fst (suc ((suc a), b))) (snd (suc ((suc a), b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt834Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215Pair_next)) (eqtr (eqcom sndpr) (sndeq k215Pair_next)) eqid eqid)) k215UnpairAt834CycleSucc);

pub theorem k215UnpairAt834Advance (a b n c: nat): $ k215PReach (k215UnpairAt834State k215PNum834 a b (suc n) c) (k215UnpairAt834State k215PNum834 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
 (named @ induct '(ind) 'a 'k215UnpairAt834AdvanceZero '(a1i k215UnpairAt834AdvanceSucc));
@_ abstract def k215UnpairAt834Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt834State k215PNum834 a b n c) (k215UnpairAt834State k215PNum842 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
theorem k215UnpairAt834RunZero (a b c: nat): $ k215UnpairAt834Run 0 a b c $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt834Stateeq eqid
     (eqcom (eqtr (fsteq add0) fstpr))
     (eqcom (eqtr (sndeq add0) sndpr)) eqid eqid)) k215UnpairAt834Reach9Z);
@_ abstract def k215UnpairAt834Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt834Run n a b c $;
theorem k215UnpairAt834Claim_at (n a b c: nat): $ k215UnpairAt834Claim n c -> k215UnpairAt834Run n a b c $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215UnpairAt834CodeStep (a b n: nat): $ (fst (suc (a, b)), snd (suc (a, b))) + n = (a, b) + suc n $ =
 '(eqtr (addeq1 fstsnd) addSass);
theorem k215UnpairAt834RunInductive (n a b c: nat): $ k215UnpairAt834Claim n c -> k215UnpairAt834Run (suc n) a b c $ =
 '(syl (ax_mp k215PReach_trans k215UnpairAt834Advance)
   (mpbid (a1i (k215PReacheq2 (k215UnpairAt834Stateeq eqid
     (fsteq k215UnpairAt834CodeStep) (sndeq k215UnpairAt834CodeStep) eqid eqid))) k215UnpairAt834Claim_at));
theorem k215UnpairAt834Claim_all (n c: nat): $ k215UnpairAt834Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt834RunZero)) '(iald @ iald k215UnpairAt834RunInductive));
pub theorem k215UnpairMacro834 (n a b c: nat): $ k215PReach (k215UnpairAt834State k215PNum834 a b n c) (k215UnpairAt834State k215PNum842 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
 '(ax_mp k215UnpairAt834Claim_at k215UnpairAt834Claim_all);
pub theorem k215UnpairMacro834_clean (n c: nat): $ k215PReach (k215UnpairAt834State k215PNum834 0 0 n c) (k215UnpairAt834State k215PNum842 (fst n) (snd n) 0 c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt834Stateeq eqid
   (fsteq (eqtr (addeq1 pr0) add01))
   (sndeq (eqtr (addeq1 pr0) add01)) eqid eqid)) k215UnpairMacro834);


