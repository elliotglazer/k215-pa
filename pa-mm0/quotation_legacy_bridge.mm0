import "quotation_bootstrap.mm0";
import "k230_equivalence.mm0";

-- Apply a checked legacy marker-wrapped theorem under the exact quotient
-- context, then transport its conclusion through a checked equivalence.
theorem sqLegacyMarker_open (a: nat):
  $ kProvable (kImp kEmptyMarker a) -> kHypProvable kQuotientContext a $;

theorem sqLegacyMarker_translate (a b: nat) (he: $ kEquivalent a b $):
  $ kProvable (kImp kEmptyMarker a) -> kHypProvable kQuotientContext b $;
