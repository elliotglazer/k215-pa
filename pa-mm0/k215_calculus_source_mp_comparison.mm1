 (named @ induct '(ind) 'y
  '(eqtr (k215PItereq (eqtr (addeq1 mul0) add01) (k215PEq4661Stateeq2 add0)) (eqtr k215PIter_add (eqtr (k215PItereq2 k215PEq4661StartXS3) k215PEq4661ClearX)))
  '(eqtrd (a1i (eqtr (k215PItereq k215EqTime_succ (k215PEq4661Stateeq2 addS)) (eqtr k215PIter_add (k215PItereq2 k215PEq4661PairS3)))) id));

pub theorem k215PEq4661GreaterY (x y z: nat): $ k215PIter (3 * x + (2 + (3 * y + 3))) (k215PEq4661State 0 x (suc y + x) z) = (k215PEq4661State k215CalEqN11 0 0 z) $ =
 (named @ induct '(ind) 'x
  '(eqtr (k215PItereq (eqtr (addeq1 mul0) add01) (k215PEq4661Stateeq3 add0)) (eqtr k215PIter_add (eqtr (k215PItereq2 k215PEq4661StartYS2) k215PEq4661ClearY)))
  '(eqtrd (a1i (eqtr (k215PItereq k215EqTime_succ (k215PEq4661Stateeq3 addS)) (eqtr k215PIter_add (k215PItereq2 k215PEq4661PairS3)))) id));

@_ abstract def k215PEq4661Done (a b z out: nat) (.n: nat): wff =
 $ E. n k215PIter n (k215PEq4661State 0 a b z) = k215PEq4661State out 0 0 z $;
do (apply (register-eqd 'k215PEq4661Done) '(k215PEq4661Doneeqd));
theorem k215PEq4661Done_intro (a b z out n: nat): $ k215PIter n (k215PEq4661State 0 a b z) = k215PEq4661State out 0 0 z -> k215PEq4661Done a b z out $ =
 (named '(iexe ,eqtac));
theorem k215PEq4661Done_equal (a b z: nat): $ a = b -> k215PEq4661Done a b z k215CalEqN10 $ =
 '(mpbii (ax_mp k215PEq4661Done_intro k215PEq4661Equal) (k215PEq4661Doneeq2d id));
theorem k215PEq4661Done_greaterX (a b z: nat): $ b < a -> k215PEq4661Done a b z k215CalEqN11 $ =
 '(mpbii (ax_mp k215PEq4661Done_intro k215PEq4661GreaterX) (k215PEq4661Doneeq1d k215EqPositiveDifference));
theorem k215PEq4661Done_greaterY (a b z: nat): $ a < b -> k215PEq4661Done a b z k215CalEqN11 $ =
 '(mpbii (ax_mp k215PEq4661Done_intro k215PEq4661GreaterY) (k215PEq4661Doneeq2d k215EqPositiveDifference));
theorem k215PEq4661Done_different (a b z: nat): $ a != b -> k215PEq4661Done a b z k215CalEqN11 $ =
 '(syl (eor k215PEq4661Done_greaterY k215PEq4661Done_greaterX) (bi1 neltlt));
pub theorem k215PEq4661Done_all (a b z: nat): $ k215PEq4661Done a b z (if (a = b) k215CalEqN10 k215CalEqN11) $ =
 '(cases (mpbid (k215PEq4661Doneeq4d (eqcomd ifpos)) k215PEq4661Done_equal)
         (mpbid (k215PEq4661Doneeq4d (eqcomd ifneg)) k215PEq4661Done_different));


theorem k215Comparison4661DoneReach (a b z out: nat): $ k215PEq4661Done a b z out -> k215PReach (k215PEq4661State 0 a b z) (k215PEq4661State out 0 0 z) $ = (named '(eex k215PReach_intro));

theorem k215Comparison4661In (u t w c d a b r v: nat): $ k215PEq4661State 0 a b (k215PVector u t w c d a b r v) = (k215PState k215PNum4661 (k215PVector u t w c d a b r v)) $ = '(eqtr k215PEq4661At0 (k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector k215PR2_vector k215PR3_vector k215PR4_vector eqid eqid k215PR7_vector k215PR8_vector)));

theorem k215Comparison4661EqualOut (u t w c d a b r v: nat): $ k215PEq4661State k215CalEqN10 0 0 (k215PVector u t w c d a b r v) = (k215PState k215PNum4671 (k215PVector u t w c d 0 0 r v)) $ = '(eqtr k215PEq4661At10 (k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector k215PR2_vector k215PR3_vector k215PR4_vector eqid eqid k215PR7_vector k215PR8_vector)));

theorem k215Comparison4661DifferentOut (u t w c d a b r v: nat): $ k215PEq4661State k215CalEqN11 0 0 (k215PVector u t w c d a b r v) = (k215PState k215PNum4697 (k215PVector u t w c d 0 0 r v)) $ = '(eqtr k215PEq4661At11 (k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector k215PR2_vector k215PR3_vector k215PR4_vector eqid eqid k215PR7_vector k215PR8_vector)));

theorem k215Comparison4661EqualRaw (a b z: nat): $ a = b -> k215PReach (k215PEq4661State 0 a b z) (k215PEq4661State k215CalEqN10 0 0 z) $ = '(syl k215Comparison4661DoneReach k215PEq4661Done_equal);

pub theorem k215Comparison4661Equal (u t w c d a b r v: nat): $ a = b -> k215PReach (k215PState k215PNum4661 (k215PVector u t w c d a b r v)) (k215PState k215PNum4671 (k215PVector u t w c d 0 0 r v)) $ = '(mpbid (a1i (k215PReacheq k215Comparison4661In k215Comparison4661EqualOut)) k215Comparison4661EqualRaw);

theorem k215Comparison4661DifferentRaw (a b z: nat): $ a != b -> k215PReach (k215PEq4661State 0 a b z) (k215PEq4661State k215CalEqN11 0 0 z) $ = '(syl k215Comparison4661DoneReach k215PEq4661Done_different);

pub theorem k215Comparison4661Different (u t w c d a b r v: nat): $ a != b -> k215PReach (k215PState k215PNum4661 (k215PVector u t w c d a b r v)) (k215PState k215PNum4697 (k215PVector u t w c d 0 0 r v)) $ = '(mpbid (a1i (k215PReacheq k215Comparison4661In k215Comparison4661DifferentOut)) k215Comparison4661DifferentRaw);

