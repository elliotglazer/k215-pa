def sfTVExistsRule(D M a b:nat):nat = $ sfImp (sfAll (sfImp (M) (sfAnd (sfImp (a) (b)) (sfImp (b) (a))))) (sfImp (sfAll (sfImp (M) (D))) (sfImp (sfImp (sfEx (sfAnd (D) (a))) (sfEx (sfAnd (M) (a)))) (sfAnd (sfImp (sfEx (sfAnd (D) (a))) (sfEx (sfAnd (M) (b)))) (sfImp (sfEx (sfAnd (M) (b))) (sfEx (sfAnd (D) (a))))))) $;

def sfTVAllRule(D M a b:nat):nat = $ sfImp (sfAll (sfImp (M) (sfAnd (sfImp (a) (b)) (sfImp (b) (a))))) (sfImp (sfAll (sfImp (M) (D))) (sfImp (sfImp (sfEx (sfAnd (D) (sfImp (a) (sfBot)))) (sfEx (sfAnd (M) (sfImp (a) (sfBot))))) (sfAnd (sfImp (sfAll (sfImp (D) (a))) (sfAll (sfImp (M) (b)))) (sfImp (sfAll (sfImp (M) (b))) (sfAll (sfImp (D) (a))))))) $;

