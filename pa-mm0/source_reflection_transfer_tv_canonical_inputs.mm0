import "source_reflection_transfer_tv_containment.mm0";

import "source_reflection_transfer_limit_profile.mm0";

import "source_l_universal_hierarchy_interface.mm0";

theorem sfTVCLHierarchy_relation(a y:nat): $ sfCLHierarchyAt a y = sfORBinary sfLUniversalHierarchyRelation a y $;

theorem sfTVCLOrdinal_zero: $ sfCLOrdinalAt 0 = sfCLOrdinal $;

theorem sfTVProfile_ordinal(G level P:nat)(hp:$ nsLocal G (sfReflectionLimitProfile level P) $): $ nsLocal G (sfCLOrdinalAt 0) $;

theorem sfTVProfile_containment(G P:nat)(hp:$ nsLocal G (sfReflectionLimitProfile sfLUniversalHierarchyRelation P) $)(hL:$ nsLocal G (sfORBinary sfLUniversalHierarchyRelation 0 3) $): $ nsLocal G (sfAll (sfImp (sfMem 0 4) sfLDomain)) $;
