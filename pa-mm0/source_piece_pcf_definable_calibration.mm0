import "source_piece_pcf_definable_recipe.mm0";

import "source_renaming_extensional.mm0";

import "source_l_common_level_setrel_bounds.mm0";

def sfPieceDefinableRecipeCutoffMap: set = $ sfRenameDepthMap sfSuccessorMap 1 $;

def sfPieceDefinableRecipeDoubleCutoffMap: set = $ sfComposeMap sfPieceDefinableRecipeCutoffMap sfPieceDefinableRecipeCutoffMap $;

theorem sfPieceDefinableRecipeMap_at (i:nat): $ sfPieceDefinableRecipeMap @ i = 3 + i $;

theorem sfPieceDefinableRecipeDoubleCutoffMap_at (i:nat): $ sfPieceDefinableRecipeDoubleCutoffMap @ i = (sqEnvCons 0 sfPieceDefinableRecipeMap) @ i $;

theorem sfPieceDefinableRecipe_environment_exact (n:nat): $ sfPieceDefinableRecipeEnvironment n = sfShift 1 (sfShift 1 (sfPieceEnvCore n)) $;

theorem sfPieceDefinableRecipe_environment_bound (n:nat): $ sfBound (suc (suc (suc n))) (sfPieceDefinableRecipeEnvironment n) $;

theorem sfPieceDefinableRecipe_point_bound (n phi:nat): $ sfBound n phi -> sfBound (suc (suc n)) (sfPieceDefinableRecipePoint n phi) $;

theorem sfPieceDefinableRecipe_bound (n phi:nat): $ sfBound n phi -> sfBound 2 (sfPieceDefinableRecipe n phi) $;
