'(sfWf_quantifier_right (sfTag_nonzero (mpbir (noteq (eqeq1 (sfNode_tag (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S))))))))) (ltneri lt01S)))
  (mpbir (noteq (eqeq1 (sfNode_tag (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S))))))))) (ltneri (mpbi ltsuc lt01S)))
  (mpbir (noteq (eqeq1 (sfNode_tag (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S))))))))) (ltneri (mpbi ltsuc (mpbi ltsuc lt01S))))
  (mpbir (noteq (eqeq1 (sfNode_tag (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S))))))))) (ltneri (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S)))))
  (mpbir (noteq (eqeq1 (sfNode_tag (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S))))))))) (ltneri (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S))))))
  (mpbir (noteq (eqeq1 (sfNode_tag (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S))))))))) (ltneri (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S)))))))
  (sfNode_right (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S))))))));

pub theorem sfMalformed_all_payload (a b: nat):
  $ b != 0 -> ~sfWf (sfNode 6 a b) $ =
'(con3 sfWf_all_node_right);

theorem sfWf_ex_node_right (a b: nat):
  $ sfWf (sfNode 7 a b) -> b = 0 $ =
'(sfWf_quantifier_right (sfTag_nonzero (mpbir (noteq (eqeq1 (sfNode_tag (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S)))))))))) (ltneri lt01S)))
