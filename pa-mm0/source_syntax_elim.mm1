-- MALFORMED CODE REJECTION
theorem sfAllowed_tags (n h: nat):
  $ sfAllowed n h -> n = 0 \/ ((sfTag n = 1 \/ sfTag n = 2) \/
    ((sfTag n = 3 \/ sfTag n = 4 \/ sfTag n = 5) \/ (sfTag n = 6 \/ sfTag n = 7))) $ =
'(orim id @ orim id @ orim (syl anl anl) (syl anl anl));

theorem sfWf_tags (n: nat):
  $ sfWf n -> n = 0 \/ ((sfTag n = 1 \/ sfTag n = 2) \/
    ((sfTag n = 3 \/ sfTag n = 4 \/ sfTag n = 5) \/ (sfTag n = 6 \/ sfTag n = 7))) $ =
'(syl sfAllowed_tags (bi1 sfWf_unfold));

theorem sfTag0_conflict (n k: nat) (hk: $ 0 != k $):
  $ sfTag n = 0 -> sfTag n = k -> n = 0 $ =
'(syl6 (absurd hk) eqtr3);

theorem sfTag0_cases (n: nat):
  $ sfTag n = 0 -> (n = 0 \/ ((sfTag n = 1 \/ sfTag n = 2) \/
    ((sfTag n = 3 \/ sfTag n = 4 \/ sfTag n = 5) \/ (sfTag n = 6 \/ sfTag n = 7)))) -> n = 0 $ =
'(eord (a1i id) @ eord
  (eord (sfTag0_conflict (ltnei lt01S)) (sfTag0_conflict (ltnei lt01S)))
  (eord (eord (eord (sfTag0_conflict (ltnei lt01S)) (sfTag0_conflict (ltnei lt01S)))
    (sfTag0_conflict (ltnei lt01S)))
    (eord (sfTag0_conflict (ltnei lt01S)) (sfTag0_conflict (ltnei lt01S)))));

pub theorem sfWf_tag0 (n: nat): $ sfTag n = 0 -> sfWf n -> n = 0 $ =
'(syl5 sfWf_tags sfTag0_cases);

pub theorem sfMalformed_tag0 (n: nat): $ n != 0 -> sfTag n = 0 -> ~sfWf n $ =
'(com12 @ con3d sfWf_tag0);

theorem sfTag_nonzero (n: nat) (ht: $ sfTag n != 0 $): $ n != 0 $ =
'(mt (syl6eq mod01 modeq1) ht);

theorem sfWf_quantifier_right (n b: nat)
  (h0: $ n != 0 $) (h1: $ sfTag n != 1 $) (h2: $ sfTag n != 2 $)
  (h3: $ sfTag n != 3 $) (h4: $ sfTag n != 4 $) (h5: $ sfTag n != 5 $)
  (hr: $ sfRight n = b $):
  $ sfWf n -> b = 0 $ =
'(syl (eqtr3 hr) @ syl anl @
  syl (sfAllowed_quantifier_elim h0 h1 h2 h3 h4 h5) (bi1 sfWf_unfold));

