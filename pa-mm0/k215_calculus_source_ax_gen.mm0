import "k215_calculus_source_ax_push26.mm0";
import "k215_calculus_source_ax_push52.mm0";
import "k215_calculus_source_ax_binary78.mm0";

theorem k215AXGenSourceInterval (u t w c d h fields: nat):
 $ k215PReach (k215PState k215Num26 (k215PVector u t w c d h 0 0 fields))
   (k215PState k215Num107 (k215PVector u (kAll d h) (t, w) c d h 0 0 fields)) $;
