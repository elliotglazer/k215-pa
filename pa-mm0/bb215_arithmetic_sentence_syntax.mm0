import "bb215_arithmetic_formula_value_code.mm0";

import "pa_formula_substitution_bound.mm0";

import "pa_source_interpretation_nat_qf_substitution_bound.mm0";

def bb215ArithmeticSentencePA (b: nat): nat = $ paFormulaSubst 0 (paTermNumeral b) bb215ArithmeticFormulaValueCode $;

def bb215ArithmeticSentenceSource (b: nat): nat = $ paFormulaSource (bb215ArithmeticSentencePA b) $;

theorem bb215ArithmeticSentenceNumeralSubst_bound (b n c: nat): $ paFormulaBound (suc n) c -> paFormulaBound n (paFormulaSubst 0 (paTermNumeral b) c) $;

theorem bb215ArithmeticSentencePA_bound (b: nat): $ paFormulaBound 0 (bb215ArithmeticSentencePA b) $;

theorem bb215ArithmeticSentenceSource_exact (b: nat): $ paFormulaSource (bb215ArithmeticSentencePA b) = bb215ArithmeticSentenceSource b $;

theorem bb215ArithmeticSentenceSource_bound (b: nat): $ sfBound 0 (bb215ArithmeticSentenceSource b) $;

theorem bb215ArithmeticSentenceSource_wf (b: nat): $ sfWf (bb215ArithmeticSentenceSource b) $;
