theorem sfPieceRepClosure_wf(B C:nat): $ sfWf (sfPieceRepClosure B C) $;

theorem sfPieceRepClosure_eq(B C D E:nat)(hb:$ B = D $)(hc:$ C = E $): $ sfPieceRepClosure B C = sfPieceRepClosure D E $;

theorem sfPieceRepClosure_rename(R:set)(k B C:nat): $ sfRename R k (sfPieceRepClosure B C) = sfPieceRepClosure (sfRenameIndex R k B) (sfRenameIndex R k C) $;

theorem sfPieceRepClosure_subst(k t B C:nat): $ sfSubst k t (sfPieceRepClosure B C) = sfPieceRepClosure (sfSubstIndex k t B) (sfSubstIndex k t C) $;

theorem sfPieceRepClosure_shift(B C:nat): $ sfShift 0 (sfPieceRepClosure B C) = sfPieceRepClosure (suc B) (suc C) $;

theorem pcr38SuccAt_eq(A C x B D y:nat)(ha:$ A = B $)(hc:$ C = D $)(hx:$ x = y $): $ pcr38SuccAt A C x = pcr38SuccAt B D y $;

theorem pcr38SuccAt_subst(k t A C x:nat): $ sfSubst k t (pcr38SuccAt A C x) = pcr38SuccAt (sfSubstIndex k t A) (sfSubstIndex k t C) (sfSubstIndex k t x) $;

theorem pcr38SuccAt_rename(R:set)(k A C x:nat): $ sfRename R k (pcr38SuccAt A C x) = pcr38SuccAt (sfRenameIndex R k A) (sfRenameIndex R k C) (sfRenameIndex R k x) $;

def sfPieceRepCoverBaseLaw:nat = $ (sfAll (sfAll (sfAll (sfImp (sfPieceRepSuccessor 2 1) (sfImp (sfPieceRepClosure 1 0) (sfEx (sfAnd (sfMem 0 1) (sfAll (sfImp (sfPieceRepEmpty 0) (sfMem 0 1)))))))))) $;

theorem sfPieceRepCoverBaseLaw_wf: $ sfWf sfPieceRepCoverBaseLaw $;

def sfPieceRepCoverCarrierLaw:nat = $ (sfAll (sfAll (sfAll (sfImp (sfPieceRepSuccessor 2 1) (sfImp (sfPieceRepClosure 1 0) (sfMem 2 0)))))) $;

theorem sfPieceRepCoverCarrierLaw_wf: $ sfWf sfPieceRepCoverCarrierLaw $;

def sfPieceRepCoverStepLaw:nat = $ (sfAll (sfAll (sfAll (sfAll (sfImp (sfPieceRepClosure 3 2) (sfImp (sfMem 1 2) (sfImp (sfMem 0 2) (pcr38SuccAt 0 2 1)))))))) $;

theorem sfPieceRepCoverStepLaw_wf: $ sfWf sfPieceRepCoverStepLaw $;

theorem sfPieceRepCoverStepLaw_shift: $ sfShift 0 sfPieceRepCoverStepLaw = sfPieceRepCoverStepLaw $;

theorem sfPieceRepCoverStepLaw_use(G B C X A:nat): $ nsLocal G sfPieceRepCoverStepLaw -> nsLocal G (sfPieceRepClosure B C) -> nsLocal G (sfMem X C) -> nsLocal G (sfMem A C) -> nsLocal G (pcr38SuccAt A C X) $;
