import "bb215_arithmetic_formula_depth_nineteen_sat.mm0";

import "pa_source_interpretation_nat_term_assignment.mm0";

def bb215ArithmeticFormulaDepthTwentySatBody (E: set) (c h .x: nat): wff = $ ifp (c = 0) (0 != 0) (ifp (sfTag c = 1) (bb215ArithmeticFormulaTermValue E (sfLeft c) = bb215ArithmeticFormulaTermValue E (sfRight c)) (ifp (sfTag c = 3) (sfLeft c e. h /\ sfRight c e. h) (ifp (sfTag c = 4) (sfLeft c e. h \/ sfRight c e. h) (ifp (sfTag c = 5) (sfLeft c e. h -> sfRight c e. h) (ifp (sfTag c = 6 /\ sfRight c = 0) (A. x bb215ArithmeticFormulaDepthNineteenSat (paNatTermConsEnvironment E x) (sfLeft c)) (ifp (sfTag c = 7 /\ sfRight c = 0) (E. x bb215ArithmeticFormulaDepthNineteenSat (paNatTermConsEnvironment E x) (sfLeft c)) (0 != 0))))))) $;

def bb215ArithmeticFormulaDepthTwentySatStep (E: set) (.c .h: nat): set = $ S\ c, {h | bb215ArithmeticFormulaDepthTwentySatBody E c h} $;

def bb215ArithmeticFormulaDepthTwentySat (E: set) (c: nat): wff = $ srecp (bb215ArithmeticFormulaDepthTwentySatStep E) c $;

def bb215ArithmeticFormulaDepthTwentySatPrevious (E: set) (c .i: nat): nat = $ sep (upto c) {i | srecp (bb215ArithmeticFormulaDepthTwentySatStep E) i} $;

theorem bb215ArithmeticFormulaDepthTwentySatStep_value (E: set) (c h: nat): $ (c, h) e. bb215ArithmeticFormulaDepthTwentySatStep E <-> bb215ArithmeticFormulaDepthTwentySatBody E c h $;

theorem bb215ArithmeticFormulaDepthTwentySatPrevious_value (E: set) (c a: nat): $ a e. bb215ArithmeticFormulaDepthTwentySatPrevious E c <-> a < c /\ bb215ArithmeticFormulaDepthTwentySat E a $;

theorem bb215ArithmeticFormulaDepthTwentySat_unfold (E: set) (c: nat): $ bb215ArithmeticFormulaDepthTwentySat E c <-> bb215ArithmeticFormulaDepthTwentySatBody E c (bb215ArithmeticFormulaDepthTwentySatPrevious E c) $;

theorem bb215ArithmeticFormulaDepthTwentySat_false (E: set): $ bb215ArithmeticFormulaDepthTwentySat E paFormulaFalse <-> 0 != 0 $;

theorem bb215ArithmeticFormulaDepthTwentySat_equal (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthTwentySat E (paFormulaEqual a b) <-> bb215ArithmeticFormulaTermValue E a = bb215ArithmeticFormulaTermValue E b $;

theorem bb215ArithmeticFormulaDepthTwentySat_and (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthTwentySat E (paFormulaAnd a b) <-> (bb215ArithmeticFormulaDepthTwentySat E a /\ bb215ArithmeticFormulaDepthTwentySat E b) $;

theorem bb215ArithmeticFormulaDepthTwentySat_or (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthTwentySat E (paFormulaOr a b) <-> (bb215ArithmeticFormulaDepthTwentySat E a \/ bb215ArithmeticFormulaDepthTwentySat E b) $;

theorem bb215ArithmeticFormulaDepthTwentySat_imp (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthTwentySat E (paFormulaImp a b) <-> (bb215ArithmeticFormulaDepthTwentySat E a -> bb215ArithmeticFormulaDepthTwentySat E b) $;

theorem bb215ArithmeticFormulaDepthTwentySat_all (E: set) (a: nat) {x: nat}: $ bb215ArithmeticFormulaDepthTwentySat E (paFormulaAll a) <-> A. x bb215ArithmeticFormulaDepthNineteenSat (paNatTermConsEnvironment E x) a $;

theorem bb215ArithmeticFormulaDepthTwentySat_ex (E: set) (a: nat) {x: nat}: $ bb215ArithmeticFormulaDepthTwentySat E (paFormulaEx a) <-> E. x bb215ArithmeticFormulaDepthNineteenSat (paNatTermConsEnvironment E x) a $;
