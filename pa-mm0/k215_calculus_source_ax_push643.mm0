 $ k215PReach (k215PState k215PNum649 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215PNum659 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $;

theorem k215PushParam643 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum643 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum669 (k215PVector u a (t, w) c a b 0 0 v)) $;
