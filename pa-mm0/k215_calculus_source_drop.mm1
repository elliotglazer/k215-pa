import "k215_calculus_source_decode.mm1";
import "k215_calculus_source_drop_push.mm1";
import "k215_calculus_source_drop_lookups.mm1";


theorem k215DropDispatch (u t w d h v: nat):
 $ k215PReach (k215PState k215Num23 (k215PVector u t w 1 d h 0 0 v))
   (k215PState k215Num24 (k215PVector u t w 0 d h 0 0 v)) $ =
 '(k215PReach_step (eqtr (eqtr (eqtr (k215PAtCD k215PLookupDrop_23)
   (ifeq (eqeq1 k215PGet3_vector) eqid eqid)) (ifneg peano1))
   (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet3_vector))
     (eqtr k215PSet3_vector (k215PVectoreq4 (eqtr subSS sub02)))))));
theorem k215DropBranch (u t w d h v: nat):
 $ k215PReach (k215PState k215Num24 (k215PVector u t w 0 d h 0 0 v))
   (k215PState k215PNum4698 (k215PVector u t w 0 d h 0 0 v)) $ =
 '(k215PReach_step (eqtr (eqtr (k215PAtCD k215PLookupDrop_24)
   (ifeq (eqeq1 k215PGet3_vector) eqid eqid)) (ifpos eqid)));
theorem k215DropReturn (u t w d h v: nat):
 $ k215PReach (k215PState k215PNum4724 (k215PVector u h (t, w) 0 d h 0 0 v))
   (k215PState 0 (k215PVector u h (t, w) 0 d h 0 0 v)) $ =
 '(k215PReach_step (k215PAtCB k215PLookupDrop_4724));
pub theorem k215DropSourceInterval (u t w d h v: nat):
 $ k215PReach (k215PState k215Num23 (k215PVector u t w 1 d h 0 0 v))
   (k215PState 0 (k215PVector u h (t, w) 0 d h 0 0 v)) $ =
 '(ax_mp (ax_mp k215PReach_trans k215DropDispatch)
   (ax_mp (ax_mp k215PReach_trans k215DropBranch)
     (ax_mp (ax_mp k215PReach_trans k215PushParam4698) k215DropReturn)));
