import "source_reflection_transfer_tv_ball.mm0";

def sfTVRowInputs(D G y N C:nat)(.k .c:nat):wff = $ A. k A. c ((k <= N /\ c <= C /\ sfBound (suc k) c) -> (nsLocal G (sfTVRowBall D k (sfRelativize D c) y) /\ nsLocal G (sfTVRowBall D k (sfImp (sfRelativize D c) sfBot) y))) $;

theorem sfTVRowInputs_at(D G y N C k c:nat): $ sfTVRowInputs D G y N C -> (k <= N /\ c <= C /\ sfBound (suc k) c) -> (nsLocal G (sfTVRowBall D k (sfRelativize D c) y) /\ nsLocal G (sfTVRowBall D k (sfImp (sfRelativize D c) sfBot) y)) $;

theorem sfTVRowInputs_shift(D G y N C:nat)(hd:$ sfBound 1 D $)(hr:$ sfTVRowInputs D G y N C $): $ sfTVRowInputs D (sfContextShift G) (suc y) N C $;

theorem sfTVRowInputs_weaken(D G J y N C:nat)(hj:$ sfContextWf J $)(hs:$ sfContextSub G J $)(hr:$ sfTVRowInputs D G y N C $): $ sfTVRowInputs D J y N C $;

theorem sfTVRowInputs_shift_if(H:wff)(D G y N C:nat)(hd:$ sfBound 1 D $)(hr:$ H -> sfTVRowInputs D G y N C $): $ H -> sfTVRowInputs D (sfContextShift G) (suc y) N C $;

theorem sfTVRowInputs_weaken_if(H:wff)(D G J y N C:nat)(hj:$ H -> sfContextWf J $)(hs:$ H -> sfContextSub G J $)(hr:$ H -> sfTVRowInputs D G y N C $): $ H -> sfTVRowInputs D J y N C $;
