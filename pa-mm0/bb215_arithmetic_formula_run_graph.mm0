import "bb215_arithmetic_formula_rec_graph.mm0";

import "bb215_tables.mm0";

def bb215ArithmeticFormulaRunStep (T .x: nat): set = $ \ x, bb215Step T x $;

def bb215ArithmeticFormulaRunGraph (T n v: nat): wff = $ bb215ArithmeticFormulaRecGraph k215TMInitial (bb215ArithmeticFormulaRunStep T) n v $;

theorem bb215ArithmeticFormulaRunStep_at (T x: nat): $ bb215ArithmeticFormulaRunStep T @ x = bb215Step T x $;

theorem bb215ArithmeticFormulaRun_rec_exact (T n: nat): $ rec k215TMInitial (bb215ArithmeticFormulaRunStep T) n = bb215Run T n k215TMInitial $;

theorem bb215ArithmeticFormulaRunGraph_correct (T n v: nat): $ bb215ArithmeticFormulaRunGraph T n v <-> bb215Run T n k215TMInitial = v $;
