import "k218q_seed_normalized.mm0";

-- Expose the actual existential conclusion of the negated seed schema.
-- The matrix and the container binder retain their literal raw codes.
def k218QSeedWitness (a b c d: nat): nat =
 $ kExists c (kAnd (k218Closure a b c d) (kRequest b c d)) $;

theorem k218QNegImp_right (p q: nat):
 $ k218QProvable (kImp (kNot (kImp p q)) (kNot q)) $;

theorem k218QSeedY_witness (a b c d: nat):
 $ k218QProvable (kImp (k218SeedY a b c d) (k218QSeedWitness a b c d)) $;

theorem k218QSeed_witness (d: nat):
 $ k218QProvable (k218QSeedWitness 1 3 (k218QSeedCode d) d) $;

theorem k218QSeed_witness_universal (d: nat):
 $ k218QProvable (kAll 1 (k218QSeedWitness 1 3 (k218QSeedCode d) d)) $;
