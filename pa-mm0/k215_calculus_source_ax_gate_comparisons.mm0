import "k215_calculus_source_nip_comparison.mm0";
import "k215_calculus_source_ax_gate_lookups.mm0";

def k215PEq4560Location (pc: nat): nat = $ if (pc = 0) k215PNum4560 (if (pc = 1) k215PNum4561 (if (pc = 2) k215PNum4562 (if (pc = 3) k215PNum4563 (if (pc = 4) k215PNum4564 (if (pc = 5) k215PNum4565 (if (pc = 6) k215PNum4566 (if (pc = 7) k215PNum4567 (if (pc = 8) k215PNum4568 (if (pc = 9) k215PNum4569 (if (pc = k215CalEqN10) k215PNum4570 (k215PNum4572))))))))))) $;

def k215PEq4560State (pc x y z: nat): nat = $ k215PState (k215PEq4560Location pc) (k215PVector (k215PR0 z) (k215PR1 z) (k215PR2 z) (k215PR3 z) (k215PR4 z) x y (k215PR7 z) (k215PR8 z)) $;

theorem k215PEq4560ClearX (x z: nat): $ k215PIter (2 * x + 3) (k215PEq4560State 5 x 0 z) = (k215PEq4560State k215CalEqN11 0 0 z) $;

theorem k215PEq4560ClearY (y z: nat): $ k215PIter (3 * y + 3) (k215PEq4560State 5 0 y z) = (k215PEq4560State k215CalEqN11 0 0 z) $;

theorem k215PEq4560Equal (x z: nat): $ k215PIter (3 * x + 2) (k215PEq4560State 0 x x z) = (k215PEq4560State k215CalEqN10 0 0 z) $;

theorem k215PEq4560GreaterX (x y z: nat): $ k215PIter (3 * y + (3 + (2 * x + 3))) (k215PEq4560State 0 (suc x + y) y z) = (k215PEq4560State k215CalEqN11 0 0 z) $;

theorem k215PEq4560GreaterY (x y z: nat): $ k215PIter (3 * x + (2 + (3 * y + 3))) (k215PEq4560State 0 x (suc y + x) z) = (k215PEq4560State k215CalEqN11 0 0 z) $;

def k215PEq4560Done (a b z out: nat) (.n: nat): wff =
 $ E. n k215PIter n (k215PEq4560State 0 a b z) = k215PEq4560State out 0 0 z $;

theorem k215PEq4560Done_all (a b z: nat): $ k215PEq4560Done a b z (if (a = b) k215CalEqN10 k215CalEqN11) $;

def k215PEq4578Location (pc: nat): nat = $ if (pc = 0) k215PNum4578 (if (pc = 1) k215PNum4579 (if (pc = 2) k215PNum4580 (if (pc = 3) k215PNum4581 (if (pc = 4) k215PNum4582 (if (pc = 5) k215PNum4583 (if (pc = 6) k215PNum4584 (if (pc = 7) k215PNum4585 (if (pc = 8) k215PNum4586 (if (pc = 9) k215PNum4587 (if (pc = k215CalEqN10) k215PNum4588 (k215PNum4590))))))))))) $;

def k215PEq4578State (pc x y z: nat): nat = $ k215PState (k215PEq4578Location pc) (k215PVector (k215PR0 z) (k215PR1 z) (k215PR2 z) (k215PR3 z) (k215PR4 z) x y (k215PR7 z) (k215PR8 z)) $;

theorem k215PEq4578ClearX (x z: nat): $ k215PIter (2 * x + 3) (k215PEq4578State 5 x 0 z) = (k215PEq4578State k215CalEqN11 0 0 z) $;

theorem k215PEq4578ClearY (y z: nat): $ k215PIter (3 * y + 3) (k215PEq4578State 5 0 y z) = (k215PEq4578State k215CalEqN11 0 0 z) $;

theorem k215PEq4578Equal (x z: nat): $ k215PIter (3 * x + 2) (k215PEq4578State 0 x x z) = (k215PEq4578State k215CalEqN10 0 0 z) $;

theorem k215PEq4578GreaterX (x y z: nat): $ k215PIter (3 * y + (3 + (2 * x + 3))) (k215PEq4578State 0 (suc x + y) y z) = (k215PEq4578State k215CalEqN11 0 0 z) $;

theorem k215PEq4578GreaterY (x y z: nat): $ k215PIter (3 * x + (2 + (3 * y + 3))) (k215PEq4578State 0 x (suc y + x) z) = (k215PEq4578State k215CalEqN11 0 0 z) $;

def k215PEq4578Done (a b z out: nat) (.n: nat): wff =
 $ E. n k215PIter n (k215PEq4578State 0 a b z) = k215PEq4578State out 0 0 z $;

theorem k215PEq4578Done_all (a b z: nat): $ k215PEq4578Done a b z (if (a = b) k215CalEqN10 k215CalEqN11) $;

theorem k215Comparison4560Equal (u t w c d a b r v: nat): $ a = b -> k215PReach (k215PState k215PNum4560 (k215PVector u t w c d a b r v)) (k215PState k215PNum4570 (k215PVector u t w c d 0 0 r v)) $;

theorem k215Comparison4560Different (u t w c d a b r v: nat): $ a != b -> k215PReach (k215PState k215PNum4560 (k215PVector u t w c d a b r v)) (k215PState k215PNum4572 (k215PVector u t w c d 0 0 r v)) $;

theorem k215Comparison4578Equal (u t w c d a b r v: nat): $ a = b -> k215PReach (k215PState k215PNum4578 (k215PVector u t w c d a b r v)) (k215PState k215PNum4588 (k215PVector u t w c d 0 0 r v)) $;

theorem k215Comparison4578Different (u t w c d a b r v: nat): $ a != b -> k215PReach (k215PState k215PNum4578 (k215PVector u t w c d a b r v)) (k215PState k215PNum4590 (k215PVector u t w c d 0 0 r v)) $;
