@_ def sfK0CollectionWitness (E: set) (root b t r a k psi: nat): nat = $ (kExists (suc k) (kAnd (kAll (suc (suc k)) (kImp (kDisj (kEq (suc (suc k)) root) (kExists (suc (suc (suc k))) (kAnd (kMem (suc (suc (suc k))) (suc k)) (kAll (suc (suc (suc (suc k)))) (kImp (kMem (suc (suc (suc (suc k)))) (suc (suc k))) (kMem (suc (suc (suc (suc k)))) (suc (suc (suc k))))))))) (kImp (kExists (suc (suc (suc k))) (sfK0CollectionTagged E b t r a (suc (suc k)) (suc (suc (suc k))) (suc (suc (suc (suc k)))) (suc (suc (suc (suc (suc k))))) psi)) (kExists (suc (suc (suc k))) (kAnd (kMem (suc (suc (suc k))) (suc k)) (sfK0CollectionTagged E b t r a (suc (suc k)) (suc (suc (suc k))) (suc (suc (suc (suc k)))) (suc (suc (suc (suc (suc k))))) psi)))))) (kAll (suc (suc k)) (kImp (kMem (suc (suc k)) (suc k)) (kExists (suc (suc (suc k))) (sfK0CollectionTagged E b t r a (suc (suc (suc k))) (suc (suc k)) (suc (suc (suc (suc k)))) (suc (suc (suc (suc (suc k))))) psi)))))) $;

pub theorem sfK0CollectionWitness_source (E: set) (n root b t r a k psi: nat) (hf: $ sfBound (suc (suc n)) psi $):
 $ sfNamedTemplate (sqEnvCons root (sqEnvCons b (sqEnvCons t (sqEnvCons r (sqEnvCons a E))))) (suc k) 0 (sfK0QSepKp0UseBody (sfK0QRepCollectionMatrix psi)) = (sfK0CollectionWitness E root b t r a k psi) $ =
(named '(eqtr (ax_mp sfNamedTemplate_ex_cons (ax_mp (ax_mp sfWf_and (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp (ax_mp (ax_mp sfWf_or sfWf_eq) (ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and sfWf_mem) (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfWf_mem) sfWf_mem)))))) (ax_mp (ax_mp sfWf_imp (ax_mp sfWf_ex sfRename_wf)) (ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and sfWf_mem) sfRename_wf)))))) (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfWf_mem) (ax_mp sfWf_ex sfRename_wf))))) (kExistseq2 (eqtr sfNamedTemplate_sfAnd (kAndeq (eqtr (ax_mp sfNamedTemplate_all_cons (ax_mp (ax_mp sfWf_imp (ax_mp (ax_mp sfWf_or sfWf_eq) (ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and sfWf_mem) (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfWf_mem) sfWf_mem)))))) (ax_mp (ax_mp sfWf_imp (ax_mp sfWf_ex sfRename_wf)) (ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and sfWf_mem) sfRename_wf))))) (kAlleq2 (eqtr sfNamedTemplate_sfImp (kImpeq (eqtr sfNamedTemplate_sfOr (kDisjeq (eqtr sfNamedTemplate_sfEq (kEqeq (eqtr sfNamedIndex_zero sqEnvCons_zero) (eqtr sfNamedIndex_zero (eqtr sqEnvCons_suc (eqtr sqEnvCons_suc sqEnvCons_zero))))) (eqtr (ax_mp sfNamedTemplate_ex_cons (ax_mp (ax_mp sfWf_and sfWf_mem) (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfWf_mem) sfWf_mem)))) (kExistseq2 (eqtr sfNamedTemplate_sfAnd (kAndeq (eqtr sfNamedTemplate_sfMem (kMemeq (eqtr sfNamedIndex_zero sqEnvCons_zero) (eqtr sfNamedIndex_zero (eqtr sqEnvCons_suc (eqtr sqEnvCons_suc sqEnvCons_zero))))) (eqtr (ax_mp sfNamedTemplate_all_cons (ax_mp (ax_mp sfWf_imp sfWf_mem) sfWf_mem)) (kAlleq2 (eqtr sfNamedTemplate_sfImp (kImpeq (eqtr sfNamedTemplate_sfMem (kMemeq (eqtr sfNamedIndex_zero sqEnvCons_zero) (eqtr sfNamedIndex_zero (eqtr sqEnvCons_suc (eqtr sqEnvCons_suc sqEnvCons_zero))))) (eqtr sfNamedTemplate_sfMem (kMemeq (eqtr sfNamedIndex_zero sqEnvCons_zero) (eqtr sfNamedIndex_zero (eqtr sqEnvCons_suc sqEnvCons_zero)))))))))))))) (eqtr sfNamedTemplate_sfImp (kImpeq (eqtr (ax_mp sfNamedTemplate_ex_cons sfRename_wf) (kExistseq2 (eqtr (k218RoleKpRequest_matrix (ax_mp sfBound_wf (sfK0QRepCollectionMatrix_bound hf))) (ax_mp sfK0Collection_tagged_named (ax_mp sfBound_wf hf))))) (eqtr (ax_mp sfNamedTemplate_ex_cons (ax_mp (ax_mp sfWf_and sfWf_mem) sfRename_wf)) (kExistseq2 (eqtr sfNamedTemplate_sfAnd (kAndeq (eqtr sfNamedTemplate_sfMem (kMemeq (eqtr sfNamedIndex_zero sqEnvCons_zero) (eqtr sfNamedIndex_zero (eqtr sqEnvCons_suc (eqtr sqEnvCons_suc sqEnvCons_zero))))) (eqtr (k218RoleKpRequest_matrix (ax_mp sfBound_wf (sfK0QRepCollectionMatrix_bound hf))) (ax_mp sfK0Collection_tagged_named (ax_mp sfBound_wf hf))))))))))))) (eqtr (ax_mp sfNamedTemplate_all_cons (ax_mp (ax_mp sfWf_imp sfWf_mem) (ax_mp sfWf_ex sfRename_wf))) (kAlleq2 (eqtr sfNamedTemplate_sfImp (kImpeq (eqtr sfNamedTemplate_sfMem (kMemeq (eqtr sfNamedIndex_zero sqEnvCons_zero) (eqtr sfNamedIndex_zero (eqtr sqEnvCons_suc sqEnvCons_zero)))) (eqtr (ax_mp sfNamedTemplate_ex_cons sfRename_wf) (kExistseq2 (eqtr (k218RoleSupport_matrix (ax_mp sfBound_wf (sfK0QRepCollectionMatrix_bound hf))) (ax_mp sfK0Collection_tagged_named (ax_mp sfBound_wf hf))))))))))))));

pub theorem sfK0CollectionWitness_open (E: set) (n root b t r a k psi: nat)
 (hf: $ sfBound (suc (suc n)) psi $) (hk: $ 0 < k $)
 (he: $ sqEnvBelow (sqEnvCons b (sqEnvCons t (sqEnvCons r (sqEnvCons a E)))) (suc (suc (suc (suc n)))) k $) (hr: $ root < k $):
 $ k218QProvable (sfK0CollectionWitness E root b t r a k psi) $ =
(named '(mpbi (k218QProvableeq (sfK0CollectionWitness_source hf)) (sfK0QSepKp0_open_use (sfK0QRepCollectionMatrix_bound hf) hk he hr)));
