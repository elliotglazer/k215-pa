import "source_l_replacement_reflected_image.mm1";
import "source_l_replacement_prefix_elimination.mm1";

@_ def sfLReplacementDefinableAntecedent(m:nat):nat =
 $ sfAnd (sfCLOrdinalAt 1) (sfAnd (sfCLHierarchyAt 1 0) (sfCLMembership 2 0 m)) $;

@_ def sfLReplacementDefinableBody(m psi:nat):nat =
 $ sfImp (sfLReplacementDefinableAntecedent m)
   (sfLReplacementImageDefinable (sfLReplacementStartMap 2) sfLDomain psi 0) $;

-- The production proof of this closed formula is a separate obligation.
@_ def sfLReplacementDefinableLaw(m psi:nat):nat =
 $ sfAllPrefix (m + 2) (sfLReplacementDefinableBody m psi) $;

theorem lrdl_image_wf(T:set)(psi Y:nat):
 $ sfWf (sfLReplacementImageDefinable T sfLDomain psi Y) $ =
 '(ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and sfLDomain_wf)
  (ax_mp sfWf_all (mpbir sfWf_iff (ian sfWf_mem
   (ax_mp (ax_mp sfWf_and sfWf_mem) sfCLSetRel_wf))))));

theorem lrdl_body_wf(m psi:nat): $ sfWf (sfLReplacementDefinableBody m psi) $ =
 '(ax_mp (ax_mp sfWf_imp
   (ax_mp (ax_mp sfWf_and sfCLOrdinalAt_wf)
    (ax_mp (ax_mp sfWf_and sfCLHierarchyAt_wf) sfCLMembership_wf))) lrdl_image_wf);

pub theorem sfLReplacementDefinableLaw_wf(m psi:nat):
 $ sfWf (sfLReplacementDefinableLaw m psi) $ =
 '(mpbir sfWf_allPrefix lrdl_body_wf);

theorem lrdl_two(body:nat): $ sfAllPrefix 2 body = sfAll (sfAll body) $ =
 '(eqtr sfAllPrefix_suc (nsAll_eq (eqtr sfAllPrefix_suc (nsAll_eq sfAllPrefix_zero))));

theorem lrdl_nested_zero(body:nat):
 $ sfAllPrefix (0 + 2) body = sfAllPrefix 0 (sfAll (sfAll body)) $ =
 '(eqtr (sfAllPrefixeq1 add01) (eqtr lrdl_two (eqcom sfAllPrefix_zero)));

theorem lrdl_nested_step(m body:nat):
 $ sfAllPrefix (m + 2) body = sfAllPrefix m (sfAll (sfAll body)) ->
   sfAllPrefix (suc m + 2) body = sfAllPrefix (suc m) (sfAll (sfAll body)) $ =
 '(eqtrd (a1i (eqtr (sfAllPrefixeq1 addS1) sfAllPrefix_suc))
  (eqtrd (sfAlleqd id) (a1i (eqcom sfAllPrefix_suc))));

theorem lrdl_nested_all(m body:nat):
 $ sfAllPrefix (m + 2) body = sfAllPrefix m (sfAll (sfAll body)) $ =
 (named @ induct '(ind) 'm 'lrdl_nested_zero 'lrdl_nested_step);

pub theorem sfLReplacementDefinableLaw_nested(m psi:nat):
 $ sfLReplacementDefinableLaw m psi =
   sfAllPrefix m (sfAll (sfAll (sfLReplacementDefinableBody m psi))) $ =
 'lrdl_nested_all;

pub theorem sfLReplacementDefinableLaw_eliminate(T:set)(G m psi:nat)
 (hp:$ nsLocal G (sfLReplacementDefinableLaw m psi) $):
 $ nsLocal G (sfRename (sfCLBallEnv T (m + 2)) 0 (sfLReplacementDefinableBody m psi)) $ =
 '(sfLReplacementPrefix_eliminate hp);
