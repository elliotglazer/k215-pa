import "pa_source_interpretation_term_rename_algebra.mm0";

import "pa_source_interpretation_term_substitution.mm0";

def paTMAgreementClass (R S: set) (.c: nat): set = $ {c | paTermRename R c = paTermRename S c} $;

theorem paTermRename_agreement {j: nat} (R S: set) (n c: nat): $ (A. j (j < n -> R @ j = S @ j)) -> paTermBound n c -> paTermRename R c = paTermRename S c $;

theorem paTermLift_zero (n c: nat): $ paTermBound n c -> paTermLift 0 c = c $;

theorem paTermSubst_zero_variable (n a: nat): $ paTermBound n a -> paTermSubst 0 a (paTermVariable 0) = a $;
