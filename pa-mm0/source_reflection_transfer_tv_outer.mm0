import "source_reflection_transfer_tv_context.mm0";

theorem sfTVBallContext_rows(D G y N C n:nat)(hd:$ sfBound 1 D $)(hr:$ sfTVRowInputs D G y N C $): $ sfTVRowInputs D (sfTVBallContext G y n) (y + n) N C $;

theorem sfTVBallContext_containment(D G y n:nat)(hd:$ sfBound 1 D $)(hc:$ nsLocal G (sfAll (sfImp (sfMem 0 (suc y)) D)) $): $ nsLocal (sfTVBallContext G y n) (sfAll (sfImp (sfMem 0 (suc (y + n))) D)) $;

theorem sfTV_outer_from_rows(D G y N C n c:nat)(hd:$ sfBound 1 D $)(hg:$ sfContextWf G $)(hn:$ n + c <= N $)(hc:$ c <= C $)(hb:$ sfBound n c $)(he:$ nsLocal G zfcRefl $)(hr:$ sfTVRowInputs D G y N C $)(hy:$ nsLocal G (sfAll (sfImp (sfMem 0 (suc y)) D)) $): $ nsLocal G (sfCLBall n y (sfIff (sfRelativize D c) (sfCLSetRel (y + n) c))) $;
