import "source_l_separation_image_op5_extension.mm1";
import "source_l_separation_image_op5_support.mm1";

pub theorem sfLSeparationOp5_profile_from_background(T:set)(G n phi R A s Y:nat)
 (hb:$ sfBound (suc n) phi $)
 (hg:$ sfContextWf G $)(hi:$ sfContextSub sfLBackground G $)
 (hr:$ nsLocal G (sfPieceDefinableNamed (suc n) phi R A) $)
 (hm:$ sfReflectionDnMembers T G A n $)
 (hs:$ nsLocal G (sfPieceEnv T n s) $)
 (ho:$ nsLocal G (sfLSeparationOp5 R s A Y) $):
 $ nsLocal G (sfPieceDefinableProfile T phi A Y) $ =
 '(sfLSeparationOp5_profile_from_total hb hr hm hs ho
   (ax_mp (ax_mp (ax_mp nsLocal_weaken hg) hi) sfLSeparationOp5Extension_local));
