import "source_l_separation_image_schema_kernel.mm0";
import "source_l_replacement_parameter_transport.mm0";

def sfLSeparationProducerContext(n phi:nat):nat =
 $ sfLReplacementLevelExtension :
  (sfLReplacementAboveLaw (suc n) phi :
   (sfLReplacementLevelExistsLaw :
    (sfReflectionHierarchySubsetNormal sfCLHierarchy :
     (sfLSeparationStageTransNormal : (sfCLRecipe 0 0 : 0))))) $;

def sfLSeparationProducerDefinableContext(n phi:nat):nat =
 $ sfLSeparationReflectedContext (sfLSeparationImageInputContext (sfLSeparationProducerContext n phi) n) n phi $;

theorem sfLSeparationImageInput_lift(G n f:nat)
 (hf:$ sfShift 0 f = f $)(hp:$ nsLocal G f $):
 $ nsLocal (sfLSeparationImageInputContext G n) f $;

theorem sfLSeparationImage_schema_from_source_proofs(n phi:nat)
 (hb:$ sfBound (suc n) phi $)
 (hE:$ sfTheoryProvable zfrAxioms sfLReplacementLevelExtension $)
 (hA:$ sfTheoryProvable zfrAxioms (sfLReplacementAboveLaw (suc n) phi) $)
 (hL:$ sfTheoryProvable zfrAxioms sfLReplacementLevelExistsLaw $)
 (hS:$ sfTheoryProvable zfrAxioms (sfReflectionHierarchySubsetNormal sfCLHierarchy) $)
 (hT:$ sfTheoryProvable zfrAxioms sfLSeparationStageTransNormal $)
 (hZ:$ sfTheoryProvable zfrAxioms (sfCLRecipe 0 0) $)
 (hD:$ nsLocal (sfLSeparationProducerDefinableContext n phi)
   (sfLSeparationImageCandidate (sfLSeparationImageParameterMap 2) sfLDomain phi 0 2) $):
 $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain (zfcSeparationCode phi n)) $;
