import "k218q_matrix_request.mm0";
import "k218q_fresh_context.mm0";
import "k218q_bound_vacuity.mm0";
import "k218q_closure_relabel.mm0";
import "k218q_request_rootify.mm0";

def k218Kp0LocalPremise (E: set) (n a c t u z v p w x y B f: nat): nat = $ (kAnd (kImp (kExists x (sfNamedTemplate (sqEnvCons x (sqEnvCons a E)) B 0 f)) (kExists x (kAnd (kMem x c) (sfNamedTemplate (sqEnvCons x (sqEnvCons a E)) B 0 f)))) (kAll u (kImp (kMem u c) (kExists v (kAnd (sfNamedTemplate (sqEnvCons u (sqEnvCons v E)) B 0 f) (kAll p (kImp (kAll w (kImp (kMem w p) (kMem w u))) (kImp (kExists x (sfNamedTemplate (sqEnvCons x (sqEnvCons p E)) B 0 f)) (kExists x (kAnd (kMem x c) (sfNamedTemplate (sqEnvCons x (sqEnvCons p E)) B 0 f))))))))))) $;

def k218Kp0LocalConclusion (E: set) (n a c t u z v p w x y B f: nat): nat = $ (kAnd (kAll t (kImp (kDisj (kEq t a) (kExists z (kAnd (kMem z c) (kAll w (kImp (kMem w t) (kMem w z)))))) (kImp (kExists x (sfNamedTemplate (sqEnvCons x (sqEnvCons t E)) B 0 f)) (kExists x (kAnd (kMem x c) (sfNamedTemplate (sqEnvCons x (sqEnvCons t E)) B 0 f)))))) (kAll u (kImp (kMem u c) (kExists v (sfNamedTemplate (sqEnvCons u (sqEnvCons v E)) B 0 f))))) $;

theorem k218QKp0_local (E: set) (n a c t u z v p w x y B f: nat)
 (ha0: $ 0 < a $)
 (h0: $ a < c $)
 (h1: $ c < t $)
 (h2: $ t < u $)
 (h3: $ u < z $)
 (h4: $ z < v $)
 (h5: $ v < p $)
 (h6: $ p < w $)
 (h7: $ w < x $)
 (h8: $ x < y $)
 (h9: $ y < B $)
 (hea: $ sqEnvAvoid E n a $)
 (hec: $ sqEnvAvoid E n c $)
 (het: $ sqEnvAvoid E n t $)
 (heu: $ sqEnvAvoid E n u $)
 (hez: $ sqEnvAvoid E n z $)
 (hev: $ sqEnvAvoid E n v $)
 (hep: $ sqEnvAvoid E n p $)
 (hew: $ sqEnvAvoid E n w $)
 (hex: $ sqEnvAvoid E n x $)
 (hey: $ sqEnvAvoid E n y $)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218QProvable (kImp (k218Kp0LocalPremise E n a c t u z v p w x y B f) (k218Kp0LocalConclusion E n a c t u z v p w x y B f)) $;

def k218Kp0PointPremise (E: set) (n a c t u z v p w x y B f: nat): nat = $ (kAnd (kImp (kExists x (sfNamedTemplate (sqEnvCons x (sqEnvCons a E)) B 0 f)) (kExists x (kAnd (kMem x c) (sfNamedTemplate (sqEnvCons x (sqEnvCons a E)) B 0 f)))) (kAll u (kImp (kMem u c) (kExists v (kAnd (sfNamedTemplate (sqEnvCons u (sqEnvCons v E)) B 0 f) (kAll p (kImp (kAll w (kImp (kMem w p) (kMem w u))) (kAll x (kImp (sfNamedTemplate (sqEnvCons x (sqEnvCons p E)) B 0 f) (kExists y (kAnd (sfNamedTemplate (sqEnvCons y (sqEnvCons p E)) B 0 f) (kMem y c)))))))))))) $;

theorem k218QKp0_pointwise (E: set) (n a c t u z v p w x y B f: nat)
 (ha0: $ 0 < a $)
 (h0: $ a < c $)
 (h1: $ c < t $)
 (h2: $ t < u $)
 (h3: $ u < z $)
 (h4: $ z < v $)
 (h5: $ v < p $)
 (h6: $ p < w $)
 (h7: $ w < x $)
 (h8: $ x < y $)
 (h9: $ y < B $)
 (hea: $ sqEnvAvoid E n a $)
 (hec: $ sqEnvAvoid E n c $)
 (het: $ sqEnvAvoid E n t $)
 (heu: $ sqEnvAvoid E n u $)
 (hez: $ sqEnvAvoid E n z $)
 (hev: $ sqEnvAvoid E n v $)
 (hep: $ sqEnvAvoid E n p $)
 (hew: $ sqEnvAvoid E n w $)
 (hex: $ sqEnvAvoid E n x $)
 (hey: $ sqEnvAvoid E n y $)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218QProvable (kImp (k218Kp0PointPremise E n a c t u z v p w x y B f) (k218Kp0LocalConclusion E n a c t u z v p w x y B f)) $;
