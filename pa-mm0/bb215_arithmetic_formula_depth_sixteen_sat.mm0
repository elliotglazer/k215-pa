import "pa_source_interpretation_nat_term_assignment.mm0";

def bb215ArithmeticFormulaDepthSixteenSatBody (E: set) (c h .x: nat): wff = $ ifp (c = 0) (0 != 0) (ifp (sfTag c = 1) (bb215ArithmeticFormulaTermValue E (sfLeft c) = bb215ArithmeticFormulaTermValue E (sfRight c)) (ifp (sfTag c = 3) (sfLeft c e. h /\ sfRight c e. h) (ifp (sfTag c = 4) (sfLeft c e. h \/ sfRight c e. h) (ifp (sfTag c = 5) (sfLeft c e. h -> sfRight c e. h) (ifp (sfTag c = 6 /\ sfRight c = 0) (A. x bb215ArithmeticFormulaDepthFifteenSat (paNatTermConsEnvironment E x) (sfLeft c)) (ifp (sfTag c = 7 /\ sfRight c = 0) (E. x bb215ArithmeticFormulaDepthFifteenSat (paNatTermConsEnvironment E x) (sfLeft c)) (0 != 0))))))) $;

def bb215ArithmeticFormulaDepthSixteenSatStep (E: set) (.c .h: nat): set = $ S\ c, {h | bb215ArithmeticFormulaDepthSixteenSatBody E c h} $;

def bb215ArithmeticFormulaDepthSixteenSat (E: set) (c: nat): wff = $ srecp (bb215ArithmeticFormulaDepthSixteenSatStep E) c $;

def bb215ArithmeticFormulaDepthSixteenSatPrevious (E: set) (c .i: nat): nat = $ sep (upto c) {i | srecp (bb215ArithmeticFormulaDepthSixteenSatStep E) i} $;

theorem bb215ArithmeticFormulaDepthSixteenSatStep_value (E: set) (c h: nat): $ (c, h) e. bb215ArithmeticFormulaDepthSixteenSatStep E <-> bb215ArithmeticFormulaDepthSixteenSatBody E c h $;

theorem bb215ArithmeticFormulaDepthSixteenSatPrevious_value (E: set) (c a: nat): $ a e. bb215ArithmeticFormulaDepthSixteenSatPrevious E c <-> a < c /\ bb215ArithmeticFormulaDepthSixteenSat E a $;

theorem bb215ArithmeticFormulaDepthSixteenSat_unfold (E: set) (c: nat): $ bb215ArithmeticFormulaDepthSixteenSat E c <-> bb215ArithmeticFormulaDepthSixteenSatBody E c (bb215ArithmeticFormulaDepthSixteenSatPrevious E c) $;

theorem bb215ArithmeticFormulaDepthSixteenSat_false (E: set): $ bb215ArithmeticFormulaDepthSixteenSat E paFormulaFalse <-> 0 != 0 $;

theorem bb215ArithmeticFormulaDepthSixteenSat_equal (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthSixteenSat E (paFormulaEqual a b) <-> bb215ArithmeticFormulaTermValue E a = bb215ArithmeticFormulaTermValue E b $;

theorem bb215ArithmeticFormulaDepthSixteenSat_and (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthSixteenSat E (paFormulaAnd a b) <-> (bb215ArithmeticFormulaDepthSixteenSat E a /\ bb215ArithmeticFormulaDepthSixteenSat E b) $;

theorem bb215ArithmeticFormulaDepthSixteenSat_or (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthSixteenSat E (paFormulaOr a b) <-> (bb215ArithmeticFormulaDepthSixteenSat E a \/ bb215ArithmeticFormulaDepthSixteenSat E b) $;

theorem bb215ArithmeticFormulaDepthSixteenSat_imp (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthSixteenSat E (paFormulaImp a b) <-> (bb215ArithmeticFormulaDepthSixteenSat E a -> bb215ArithmeticFormulaDepthSixteenSat E b) $;

theorem bb215ArithmeticFormulaDepthSixteenSat_all (E: set) (a: nat) {x: nat}: $ bb215ArithmeticFormulaDepthSixteenSat E (paFormulaAll a) <-> A. x bb215ArithmeticFormulaDepthFifteenSat (paNatTermConsEnvironment E x) a $;

theorem bb215ArithmeticFormulaDepthSixteenSat_ex (E: set) (a: nat) {x: nat}: $ bb215ArithmeticFormulaDepthSixteenSat E (paFormulaEx a) <-> E. x bb215ArithmeticFormulaDepthFifteenSat (paNatTermConsEnvironment E x) a $;
