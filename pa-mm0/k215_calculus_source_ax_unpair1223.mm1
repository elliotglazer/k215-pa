@_ def k215UnpairAt1223State (pc a b n c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) n (k215PR3 c) (k215PR4 c) (k215PR5 c) a b (k215PR8 c)) $;

do (apply (register-eqd 'k215UnpairAt1223State) '(k215UnpairAt1223Stateeqd));

theorem k215UnpairAt1223Transfer (b n c: nat): $ k215PIter (3 * b + 1) (k215UnpairAt1223State k215PNum1227 0 b n c) = (k215UnpairAt1223State k215PNum1230 b 0 n c) $ =
 '(eqtr k215Loop1227Vector (k215PStateeq2 (k215PVectoreq7 add0)));
theorem k215UnpairAt1223ReachTransfer (b n c: nat): $ k215PReach (k215UnpairAt1223State k215PNum1227 0 b n c) (k215UnpairAt1223State k215PNum1230 b 0 n c) $ =
 '(k215PReach_intro k215UnpairAt1223Transfer);


theorem k215UnpairAt1223Step9Z (a b c: nat): $ k215PStep (k215UnpairAt1223State k215PNum1223 a b 0 c) = (k215UnpairAt1223State k215PNum1231 a b 0 c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair1223_1223) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt1223Reach9Z (a b c: nat): $ k215PReach (k215UnpairAt1223State k215PNum1223 a b 0 c) (k215UnpairAt1223State k215PNum1231 a b 0 c) $ = '(k215PReach_step k215UnpairAt1223Step9Z);

