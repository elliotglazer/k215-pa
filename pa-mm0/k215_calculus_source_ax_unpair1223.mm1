theorem k215UnpairAt1223Reach9S (a b n c: nat): $ k215PReach (k215UnpairAt1223State k215PNum1223 a b (suc n) c) (k215UnpairAt1223State k215PNum1224 a b n c) $ = '(k215PReach_step k215UnpairAt1223Step9S);

theorem k215UnpairAt1223Step10 (a b n c: nat): $ k215PStep (k215UnpairAt1223State k215PNum1224 a b n c) = (k215UnpairAt1223State k215PNum1225 a (suc b) n c) $ = '(eqtr (k215PAtCI k215PLookupUnpair1223_1224) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215UnpairAt1223Reach10 (a b n c: nat): $ k215PReach (k215UnpairAt1223State k215PNum1224 a b n c) (k215UnpairAt1223State k215PNum1225 a (suc b) n c) $ = '(k215PReach_step k215UnpairAt1223Step10);

theorem k215UnpairAt1223Step11Z (b n c: nat): $ k215PStep (k215UnpairAt1223State k215PNum1225 0 b n c) = (k215UnpairAt1223State k215PNum1227 0 b n c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair1223_1225) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt1223Reach11Z (b n c: nat): $ k215PReach (k215UnpairAt1223State k215PNum1225 0 b n c) (k215UnpairAt1223State k215PNum1227 0 b n c) $ = '(k215PReach_step k215UnpairAt1223Step11Z);

theorem k215UnpairAt1223Step11S (a b n c: nat): $ k215PStep (k215UnpairAt1223State k215PNum1225 (suc a) b n c) = (k215UnpairAt1223State k215PNum1226 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair1223_1225) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215UnpairAt1223Reach11S (a b n c: nat): $ k215PReach (k215UnpairAt1223State k215PNum1225 (suc a) b n c) (k215UnpairAt1223State k215PNum1226 a b n c) $ = '(k215PReach_step k215UnpairAt1223Step11S);

theorem k215UnpairAt1223Step12 (a b n c: nat): $ k215PStep (k215UnpairAt1223State k215PNum1226 a b n c) = (k215UnpairAt1223State k215PNum1230 a b n c) $ = '(k215PAtCB k215PLookupUnpair1223_1226);

theorem k215UnpairAt1223Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt1223State k215PNum1226 a b n c) (k215UnpairAt1223State k215PNum1230 a b n c) $ = '(k215PReach_step k215UnpairAt1223Step12);

theorem k215UnpairAt1223Step16 (a b n c: nat): $ k215PStep (k215UnpairAt1223State k215PNum1230 a b n c) = (k215UnpairAt1223State k215PNum1223 a b n c) $ = '(k215PAtCC k215PLookupUnpair1223_1230);

theorem k215UnpairAt1223Reach16 (a b n c: nat): $ k215PReach (k215UnpairAt1223State k215PNum1230 a b n c) (k215UnpairAt1223State k215PNum1223 a b n c) $ = '(k215PReach_step k215UnpairAt1223Step16);

theorem k215UnpairAt1223CycleZero (b n c: nat): $ k215PReach (k215UnpairAt1223State k215PNum1223 0 b (suc n) c) (k215UnpairAt1223State k215PNum1223 (suc b) 0 n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt1223Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt1223Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt1223Reach11Z) (ax_mp (ax_mp k215PReach_trans k215UnpairAt1223ReachTransfer) k215UnpairAt1223Reach16))));
theorem k215UnpairAt1223CycleSucc (a b n c: nat): $ k215PReach (k215UnpairAt1223State k215PNum1223 (suc a) b (suc n) c) (k215UnpairAt1223State k215PNum1223 a (suc b) n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt1223Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt1223Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt1223Reach11S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt1223Reach12) k215UnpairAt1223Reach16))));


theorem k215UnpairAt1223AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt1223State k215PNum1223 0 b (suc n) c) (k215UnpairAt1223State k215PNum1223 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt1223Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215PairDiagonal_rotate)) (eqtr (eqcom sndpr) (sndeq k215PairDiagonal_rotate)) eqid eqid)) k215UnpairAt1223CycleZero);

theorem k215UnpairAt1223AdvanceSucc (a b n c: nat): $ k215PReach (k215UnpairAt1223State k215PNum1223 (suc a) b (suc n) c) (k215UnpairAt1223State k215PNum1223 (fst (suc ((suc a), b))) (snd (suc ((suc a), b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt1223Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215Pair_next)) (eqtr (eqcom sndpr) (sndeq k215Pair_next)) eqid eqid)) k215UnpairAt1223CycleSucc);

pub theorem k215UnpairAt1223Advance (a b n c: nat): $ k215PReach (k215UnpairAt1223State k215PNum1223 a b (suc n) c) (k215UnpairAt1223State k215PNum1223 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
 (named @ induct '(ind) 'a 'k215UnpairAt1223AdvanceZero '(a1i k215UnpairAt1223AdvanceSucc));
@_ abstract def k215UnpairAt1223Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt1223State k215PNum1223 a b n c) (k215UnpairAt1223State k215PNum1231 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
theorem k215UnpairAt1223RunZero (a b c: nat): $ k215UnpairAt1223Run 0 a b c $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt1223Stateeq eqid
     (eqcom (eqtr (fsteq add0) fstpr))
     (eqcom (eqtr (sndeq add0) sndpr)) eqid eqid)) k215UnpairAt1223Reach9Z);
@_ abstract def k215UnpairAt1223Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt1223Run n a b c $;
theorem k215UnpairAt1223Claim_at (n a b c: nat): $ k215UnpairAt1223Claim n c -> k215UnpairAt1223Run n a b c $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215UnpairAt1223CodeStep (a b n: nat): $ (fst (suc (a, b)), snd (suc (a, b))) + n = (a, b) + suc n $ =
 '(eqtr (addeq1 fstsnd) addSass);
theorem k215UnpairAt1223RunInductive (n a b c: nat): $ k215UnpairAt1223Claim n c -> k215UnpairAt1223Run (suc n) a b c $ =
 '(syl (ax_mp k215PReach_trans k215UnpairAt1223Advance)
   (mpbid (a1i (k215PReacheq2 (k215UnpairAt1223Stateeq eqid
     (fsteq k215UnpairAt1223CodeStep) (sndeq k215UnpairAt1223CodeStep) eqid eqid))) k215UnpairAt1223Claim_at));
theorem k215UnpairAt1223Claim_all (n c: nat): $ k215UnpairAt1223Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt1223RunZero)) '(iald @ iald k215UnpairAt1223RunInductive));
pub theorem k215UnpairMacro1223 (n a b c: nat): $ k215PReach (k215UnpairAt1223State k215PNum1223 a b n c) (k215UnpairAt1223State k215PNum1231 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
 '(ax_mp k215UnpairAt1223Claim_at k215UnpairAt1223Claim_all);
pub theorem k215UnpairMacro1223_clean (n c: nat): $ k215PReach (k215UnpairAt1223State k215PNum1223 0 0 n c) (k215UnpairAt1223State k215PNum1231 (fst n) (snd n) 0 c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt1223Stateeq eqid
   (fsteq (eqtr (addeq1 pr0) add01))
   (sndeq (eqtr (addeq1 pr0) add01)) eqid eqid)) k215UnpairMacro1223);


