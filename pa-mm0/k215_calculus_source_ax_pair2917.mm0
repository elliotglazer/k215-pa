import "k215_calculus_source_ax_stack_loops.mm0";
import "k215_literal_runtime_reach.mm0";
import "k215_calculus_source_pairing.mm0";
import "k215_calculus_source_ax_stack_lookups.mm0";

def k215PairAt2917State (pc a b t c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) b (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) a t (k215PR8 c)) $;

theorem k215PairAt2917ReachIn (a b t c: nat): $ k215PReach (k215PairAt2917State k215PNum2917 a b t c) (k215PairAt2917State k215PNum2921 (a + b) 0 (t + b) c) $;

theorem k215PairAt2917Cycle (a b t k c: nat): $ a + b = suc k -> k215PReach (k215PairAt2917State k215PNum2917 a b t c) (k215PairAt2917State k215PNum2917 0 k (suc (t + b)) c) $;

theorem k215PairAt2917Base (t c: nat): $ k215PReach (k215PairAt2917State k215PNum2917 0 0 t c) (k215PairAt2917State k215PNum2927 0 0 t c) $;

def k215PairAt2917Run (a b t c: nat): wff =
 $ k215PReach (k215PairAt2917State k215PNum2917 a b t c) (k215PairAt2917State k215PNum2927 0 0 (t + (a, b)) c) $;

def k215PairAt2917Claim (k c: nat) (.a .b .t: nat): wff =
 $ A. a A. b A. t (a + b = k -> k215PairAt2917Run a b t c) $;

theorem k215PairMacro2917 (a b t c: nat): $ k215PReach (k215PairAt2917State k215PNum2917 a b t c) (k215PairAt2917State k215PNum2927 0 0 (t + (a, b)) c) $;
