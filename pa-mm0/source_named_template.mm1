import "raw_source_image.mm1";
import "source_structural_induction.mm1";

@_ def kDisj (a b: nat): nat = $ kImp (kNot a) b $;
@_ def sfNamedIndex (E: set) (k d i: nat): nat =
$ if (i < d) (k + (d - suc i)) (E @ (i - d)) $;
@_ def sfNamedBody (E: set) (k d c h: nat): nat =
$ if (c = 0) kF
  (if (sfTag c = 1) (kMem (sfNamedIndex E k d (sfLeft c)) (sfNamedIndex E k d (sfRight c)))
  (if (sfTag c = 2) (kEq (sfNamedIndex E k d (sfLeft c)) (sfNamedIndex E k d (sfRight c)))
  (if (sfTag c = 3) (kAnd (h @ (d, sfLeft c)) (h @ (d, sfRight c)))
  (if (sfTag c = 4) (kDisj (h @ (d, sfLeft c)) (h @ (d, sfRight c)))
  (if (sfTag c = 5) (kImp (h @ (d, sfLeft c)) (h @ (d, sfRight c)))
  (if (sfTag c = 6 /\ sfRight c = 0) (kAll (k + d) (h @ (suc d, sfLeft c)))
  (if (sfTag c = 7 /\ sfRight c = 0) (kExists (k + d) (h @ (suc d, sfLeft c))) kF))))))) $;
@_ abstract def sfNamedStep (E: set) (k .h: nat): set =
$ \ h, sfNamedBody E k (fst (sfHistoryLength h)) (snd (sfHistoryLength h)) h $;
@_ abstract def sfNamedTemplate (E: set) (k d c: nat): nat = $ srec (sfNamedStep E k) (d, c) $;
@_ abstract def sfNamedHistory (E: set) (k d c .i: nat): nat =
$ \. i e. upto (d, c), srec (sfNamedStep E k) i $;

pub theorem sfNamedIndex_bound (E: set) (k d i: nat):
  $ i < d -> sfNamedIndex E k d i = k + (d - suc i) $ =
'ifpos;

pub theorem sfNamedIndex_free (E: set) (k d i: nat):
  $ ~i < d -> sfNamedIndex E k d i = E @ (i - d) $ =
'ifneg;

pub theorem sfNamedIndex_zero (E: set) (k i: nat):
  $ sfNamedIndex E k 0 i = E @ i $ =
'(eqtr (sfNamedIndex_free lt02) (appeq2 sub02));

pub theorem sfNamedIndex_new (E: set) (k d: nat):
  $ sfNamedIndex E k (suc d) 0 = k + d $ =
'(eqtr (sfNamedIndex_bound lt01S) (addeq2 sucsub1));

pub theorem sfNamedIndex_lift (E: set) (k d i: nat):
  $ sfNamedIndex E k (suc d) (suc i) = sfNamedIndex E k d i $ =
'(ifeq (bicom ltsuc) (addeq2 subSS) (appeq2 subSS));

pub theorem sfNamedStep_apply (E: set) (k h: nat):
  $ sfNamedStep E k @ h = sfNamedBody E k (fst (sfHistoryLength h)) (snd (sfHistoryLength h)) h $ =
(named '(!! applame j ,eqtac));

pub theorem sfNamedHistory_size (E: set) (k d c: nat):
  $ sfHistoryLength (sfNamedHistory E k d c) = (d, c) $ =
(named '(sreclem eqid));

pub theorem sfNamedHistory_lookup (E: set) (k d c e a: nat):
  $ (e, a) < (d, c) -> sfNamedHistory E k d c @ (e, a) = sfNamedTemplate E k e a $ =
(named '(syl (apprlame sreceq2) (bi2 elupto)));

pub theorem sfNamedTemplate_unfold (E: set) (k d c: nat):
  $ sfNamedTemplate E k d c = sfNamedBody E k d c (sfNamedHistory E k d c) $ =
(named '(eqtr srecval @ eqtr sfNamedStep_apply @
  sfNamedBodyeq eqsid eqid (eqtr (fsteq sfNamedHistory_size) fstpr)
    (eqtr (sndeq sfNamedHistory_size) sndpr) eqid));

theorem sfNTBody_sfMem (E: set) (k d c h: nat)
  (h0: $ c != 0 $) (ht: $ sfTag c = 1 $):
  $ sfNamedBody E k d c h = kMem (sfNamedIndex E k d (sfLeft c)) (sfNamedIndex E k d (sfRight c)) $ =
'(eqtr (ifneg h0) (ifpos ht));

theorem sfNTBody_sfEq (E: set) (k d c h: nat)
  (h0: $ c != 0 $) (ht: $ sfTag c = 2 $):
  $ sfNamedBody E k d c h = kEq (sfNamedIndex E k d (sfLeft c)) (sfNamedIndex E k d (sfRight c)) $ =
'(eqtr (ifneg h0) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc lt01S)))) (ifpos ht)));

theorem sfNTBody_sfAnd (E: set) (k d c h: nat)
  (h0: $ c != 0 $) (ht: $ sfTag c = 3 $):
  $ sfNamedBody E k d c h = kAnd (h @ (d, sfLeft c)) (h @ (d, sfRight c)) $ =
'(eqtr (ifneg h0) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc lt01S)))) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc lt01S))))) (ifpos ht))));

theorem sfNTBody_sfOr (E: set) (k d c h: nat)
  (h0: $ c != 0 $) (ht: $ sfTag c = 4 $):
  $ sfNamedBody E k d c h = kDisj (h @ (d, sfLeft c)) (h @ (d, sfRight c)) $ =
'(eqtr (ifneg h0) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc lt01S)))) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc lt01S))))) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S)))))) (ifpos ht)))));

theorem sfNTBody_sfImp (E: set) (k d c h: nat)
  (h0: $ c != 0 $) (ht: $ sfTag c = 5 $):
  $ sfNamedBody E k d c h = kImp (h @ (d, sfLeft c)) (h @ (d, sfRight c)) $ =
'(eqtr (ifneg h0) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc lt01S)))) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc lt01S))))) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S)))))) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S))))))) (ifpos ht))))));

theorem sfNTBody_sfAll (E: set) (k d c h: nat)
  (h0: $ c != 0 $) (ht: $ sfTag c = 6 $) (hz: $ sfRight c = 0 $):
  $ sfNamedBody E k d c h = kAll (k + d) (h @ (suc d, sfLeft c)) $ =
'(eqtr (ifneg h0) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc lt01S)))) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc lt01S))))) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S)))))) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S))))))) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S)))))))) (ifpos (ian ht hz))))))));

theorem sfNTBody_sfEx (E: set) (k d c h: nat)
  (h0: $ c != 0 $) (ht: $ sfTag c = 7 $) (hz: $ sfRight c = 0 $):
  $ sfNamedBody E k d c h = kExists (k + d) (h @ (suc d, sfLeft c)) $ =
'(eqtr (ifneg h0) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc lt01S)))) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc lt01S))))) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S)))))) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S))))))) (eqtr (ifneg (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S)))))))) (eqtr (ifneg (mt anl (mpbir (noteq (eqeq1 ht)) (ltneri (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S)))))))))) (ifpos (ian ht hz)))))))));

theorem sfNTHistory_left (E: set) (k d c a: nat)
  (he: $ sfLeft c = a $) (ha: $ a < c $):
  $ sfNamedHistory E k d c @ (d, sfLeft c) = sfNamedTemplate E k (d) a $ =
'(eqtr (appeq2 (preq2 he)) (sfNamedHistory_lookup (sfKey_lt ha)));

theorem sfNTHistory_right (E: set) (k d c a: nat)
  (he: $ sfRight c = a $) (ha: $ a < c $):
  $ sfNamedHistory E k d c @ (d, sfRight c) = sfNamedTemplate E k (d) a $ =
'(eqtr (appeq2 (preq2 he)) (sfNamedHistory_lookup (sfKey_lt ha)));

theorem sfNTHistory_binder (E: set) (k d c a: nat)
  (he: $ sfLeft c = a $) (ha: $ a < c $):
  $ sfNamedHistory E k d c @ (suc d, sfLeft c) = sfNamedTemplate E k (suc d) a $ =
'(eqtr (appeq2 (preq2 he)) (sfNamedHistory_lookup (sfKey_underBinder_lt ha)));

pub theorem sfNamedTemplate_bot (E: set) (k d: nat):
  $ sfNamedTemplate E k d sfBot = kF $ =
'(eqtr sfNamedTemplate_unfold (ifpos eqid));

pub theorem sfNamedTemplate_sfMem (E: set) (k d a b: nat):
  $ sfNamedTemplate E k d (sfMem a b) = kMem (sfNamedIndex E k d a) (sfNamedIndex E k d b) $ =
'(eqtr sfNamedTemplate_unfold (eqtr (sfNTBody_sfMem sfMem_ne_sfBot sfMem_tag) (kMemeq (sfNamedIndexeq4 sfMem_left) (sfNamedIndexeq4 sfMem_right))));

pub theorem sfNamedTemplate_sfEq (E: set) (k d a b: nat):
  $ sfNamedTemplate E k d (sfEq a b) = kEq (sfNamedIndex E k d a) (sfNamedIndex E k d b) $ =
'(eqtr sfNamedTemplate_unfold (eqtr (sfNTBody_sfEq sfEq_ne_sfBot sfEq_tag) (kEqeq (sfNamedIndexeq4 sfEq_left) (sfNamedIndexeq4 sfEq_right))));

pub theorem sfNamedTemplate_sfAnd (E: set) (k d a b: nat):
  $ sfNamedTemplate E k d (sfAnd a b) = kAnd (sfNamedTemplate E k d a) (sfNamedTemplate E k d b) $ =
'(eqtr sfNamedTemplate_unfold (eqtr (sfNTBody_sfAnd sfAnd_ne_sfBot sfAnd_tag) (kAndeq (sfNTHistory_left sfAnd_left sfAnd_left_lt) (sfNTHistory_right sfAnd_right sfAnd_right_lt))));

pub theorem sfNamedTemplate_sfOr (E: set) (k d a b: nat):
  $ sfNamedTemplate E k d (sfOr a b) = kDisj (sfNamedTemplate E k d a) (sfNamedTemplate E k d b) $ =
'(eqtr sfNamedTemplate_unfold (eqtr (sfNTBody_sfOr sfOr_ne_sfBot sfOr_tag) (kDisjeq (sfNTHistory_left sfOr_left sfOr_left_lt) (sfNTHistory_right sfOr_right sfOr_right_lt))));

pub theorem sfNamedTemplate_sfImp (E: set) (k d a b: nat):
  $ sfNamedTemplate E k d (sfImp a b) = kImp (sfNamedTemplate E k d a) (sfNamedTemplate E k d b) $ =
'(eqtr sfNamedTemplate_unfold (eqtr (sfNTBody_sfImp sfImp_ne_sfBot sfImp_tag) (kImpeq (sfNTHistory_left sfImp_left sfImp_left_lt) (sfNTHistory_right sfImp_right sfImp_right_lt))));

pub theorem sfNamedTemplate_sfAll (E: set) (k d a: nat):
  $ sfNamedTemplate E k d (sfAll a) = kAll (k + d) (sfNamedTemplate E k (suc d) a) $ =
'(eqtr sfNamedTemplate_unfold (eqtr (sfNTBody_sfAll sfAll_ne_sfBot sfAll_tag sfAll_right) (kAlleq2 (sfNTHistory_binder sfAll_left sfAll_body_lt))));

pub theorem sfNamedTemplate_sfEx (E: set) (k d a: nat):
  $ sfNamedTemplate E k d (sfEx a) = kExists (k + d) (sfNamedTemplate E k (suc d) a) $ =
'(eqtr sfNamedTemplate_unfold (eqtr (sfNTBody_sfEx sfEx_ne_sfBot sfEx_tag sfEx_right) (kExistseq2 (sfNTHistory_binder sfEx_left sfEx_body_lt))));

