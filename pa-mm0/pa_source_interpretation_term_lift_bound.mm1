import "pa_source_interpretation_term_rename_bound.mm1";

theorem paTermLiftMap_point_bound (k n i: nat): $ i < n -> paTermLiftMap k @ i < k + n $ = (named '(mpbird (a1i (lteq1 paTermLiftMap_value)) (bi1 ltadd2)));

theorem paTermLiftMap_bound (k n: nat) {i: nat}: $ A. i (i < n -> paTermLiftMap k @ i < k + n) $ = (named '(ax_gen paTermLiftMap_point_bound));

pub theorem paTermLift_bound (k n c: nat): $ paTermBound n c -> paTermBound (k + n) (paTermLift k c) $ = (named '(paTermRename_bound paTermLiftMap_bound));

theorem paTermShiftMap_point_bound (d n i: nat): $ i < n -> paTermShiftMap d @ i < suc n $ = (named '(mpbird (a1i (lteq1 paTermShiftMap_value)) (ifbothd lteq1 lteq1 (ltletrd anl (a1i lesucid)) (syl (bi1 ltsuc) anl))));

theorem paTermShiftMap_bound (d n: nat) {i: nat}: $ A. i (i < n -> paTermShiftMap d @ i < suc n) $ = (named '(ax_gen paTermShiftMap_point_bound));

pub theorem paTermShift_bound (d n c: nat): $ paTermBound n c -> paTermBound (suc n) (paTermShift d c) $ = (named '(paTermRename_bound paTermShiftMap_bound));
