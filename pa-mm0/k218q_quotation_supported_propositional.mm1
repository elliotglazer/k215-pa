(named '(exp @ !! iald S @ !! iald t @ !! iald k @ !! iald H k218SQ_sqSP_Wk_point));

theorem k218SQ_sqSP_Wk_at (n G D a: nat):
 $ sfRowWf (sfSequent D a) -> sfContextSub G D -> k218SQ_sqSupportedAt n (sfSequent G a) ->
   k218SQ_sqSupportedGood (sfSequent D a) $ =
'(exp @ exp @ syl k218SQ_sqSupportedGood_intro @
 iand anll (iand (a1i leaddid1)
 (syl (ax_mp k218SQ_sqSupportedProperty_mono leaddid2) @
  mpd (syl k218SQ_sqSupportedAt_property anr) (syl k218SQ_sqSP_Wk_property anlr))));

