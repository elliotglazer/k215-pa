theorem k218SQ_sqSP_good_congr (F: wff) (r s: nat) (h: $ F -> r = s $):
 $ F -> (k218SQ_sqSupportedGood r <-> k218SQ_sqSupportedGood s) $ = '(k218SQ_sqSupportedGoodeqd h);

theorem k218SQ_sqSP_unary_transport (r p R P: nat)
 (h: $ sfRowWf R -> k218SQ_sqSupportedGood P -> k218SQ_sqSupportedGood R $):
 $ sfRowWf r -> (r = R /\ p = P) -> k218SQ_sqSupportedGood p -> k218SQ_sqSupportedGood r $ =
'(exp @ exp @ mpbird (k218SQ_sqSP_good_congr (syl anl anlr)) @
 mpd (mpbid (k218SQ_sqSP_good_congr (syl anr anlr)) anr)
 (syl h (mpbid (sfRowWf_congr (syl anl anlr)) anll)));

theorem k218SQ_sqSP_binary_transport (r p q R P Q: nat)
 (h: $ sfRowWf R -> k218SQ_sqSupportedGood P -> k218SQ_sqSupportedGood Q -> k218SQ_sqSupportedGood R $):
 $ sfRowWf r -> (r = R /\ (p = P /\ q = Q)) ->
   k218SQ_sqSupportedGood p -> k218SQ_sqSupportedGood q -> k218SQ_sqSupportedGood r $ =
'(exp @ exp @ exp @ mpbird (k218SQ_sqSP_good_congr (syl anl (syl anlr anl))) @
 mpd (mpbid (k218SQ_sqSP_good_congr (syl anr (syl anr (syl anlr anl)))) anr) @
 mpd (mpbid (k218SQ_sqSP_good_congr (syl anl (syl anr (syl anlr anl)))) anlr) @
 syl h (mpbid (sfRowWf_congr (syl anl (syl anlr anl))) (syl anll anl)));

