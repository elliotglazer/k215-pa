 $ sfRowWf (sfSequent D a) -> sfContextSub G D -> k218SQ_sqSupportedGood (sfSequent G a) ->
   k218SQ_sqSupportedGood (sfSequent D a) $ =
(named '(com23 (eexd (com23 k218SQ_sqSP_Wk_at))));

