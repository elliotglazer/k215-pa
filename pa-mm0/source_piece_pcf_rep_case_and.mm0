import "source_piece_pcf_rep_case_common.mm0";

import "source_piece_pcf_definable_difference_use.mm0";

-- And case of the uniform representation theorem (Rocq Z_cl.rep_ex, And branch:
-- R1 - (R1 - R2) by two differences), in hypothesis form.

theorem sfPieceRepCaseAnd_rule (G n a b w A l r d: nat)
  (hg: $ sfContextWf G $) (hba: $ sfBound n a $) (hbb: $ sfBound n b $)
  (hL: $ nsLocal G (sfPieceDefinableNamed n a l A) $)
  (hR: $ nsLocal G (sfPieceDefinableNamed n b r A) $)
  (hD: $ nsLocal G (sfPieceDefinableConjunctionDifference l r d) $)
  (hN: $ nsLocal G (sfPieceDefinableConjunctionDifference l d w) $):
  $ nsLocal G (sfPieceDefinableNamed n (sfAnd a b) w A) $;

theorem sfPieceRepCaseAnd (G A B C n a b: nat)
  (hg: $ sfContextWf G $) (hbg: $ sfContextSub sfLBackground G $)
  (hc: $ nsLocal G (sfPieceRepClosure B C) $)
  (hba: $ sfBound n a $) (hbb: $ sfBound n b $)
  (hwa: $ nsLocal G (sfPieceDefinableWitness A C n a) $)
  (hwb: $ nsLocal G (sfPieceDefinableWitness A C n b) $):
  $ nsLocal G (sfPieceDefinableWitness A C n (sfAnd a b)) $;
