import "source_relative_quantifiers.mm0";

theorem sfLocal_falseE (G a: nat) (ha: $ sfWf a $):
  $ nsLocal G sfBot -> nsLocal G a $;

theorem sfLocal_orR (G a b: nat) (ha: $ sfWf a $):
  $ nsLocal G b -> nsLocal G (sfOr a b) $;

theorem sfLocal_peirce (G a b: nat)
  (hg: $ sfContextWf G $) (ha: $ sfWf a $) (hb: $ sfWf b $):
  $ nsLocal G (sfImp (sfImp (sfImp a b) a) a) $;
