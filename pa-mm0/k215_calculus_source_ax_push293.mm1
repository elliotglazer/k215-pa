theorem k215PairVectorInAt293 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt299State k215PNum299 a6 a1 a7 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum299 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215PairVectorOutAt293 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt299State k215PNum309 0 0 (a7 + (a6, a1)) (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum309 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

pub theorem k215PairMacro46_vectorAt293 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat):
 $ k215PReach (k215PState k215PNum299 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215PNum309 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ =
 '(mpbi (k215PReacheq k215PairVectorInAt293 k215PairVectorOutAt293) k215PairMacro299);

theorem k215PushAStage0At293 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum293 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum296 (k215PVector u 0 w c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop293Vector (k215PStateeq2 (k215PVectoreq7 add0))));

theorem k215PushAStage1At293 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum296 (k215PVector u 0 w c a b t 0 v)) (k215PState k215PNum299 (k215PVector u w 0 c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop296Vector (k215PStateeq2 (k215PVectoreq2 add0))));

theorem k215PushAStage2At293 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum299 (k215PVector u w 0 c a b t 0 v)) (k215PState k215PNum309 (k215PVector u 0 0 c a b 0 (t, w) v)) $ = '(mpbi (k215PReacheq2 (k215PStateeq2 (k215PVectoreq8 add01))) k215PairMacro46_vectorAt293);

theorem k215PushAStage3At293 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum309 (k215PVector u 0 0 c a b 0 (t, w) v)) (k215PState k215PNum312 (k215PVector u 0 (t, w) c a b 0 0 v)) $ = '(k215PReach_intro (eqtr k215Loop309Vector (k215PStateeq2 (k215PVectoreq3 add0))));

theorem k215PushAStage4At293 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum312 (k215PVector u 0 (t, w) c a b 0 0 v)) (k215PState k215PNum316 (k215PVector u c (t, w) 0 a b c 0 v)) $ = '(k215PReach_intro (eqtr k215Loop312Vector (k215PStateeq2 (k215PVectoreq eqid add0 eqid eqid eqid eqid add0 eqid eqid))));

theorem k215PushAStage5At293 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum316 (k215PVector u c (t, w) 0 a b c 0 v)) (k215PState k215PNum319 (k215PVector u c (t, w) c a b 0 0 v)) $ = '(k215PReach_intro (eqtr k215Loop316Vector (k215PStateeq2 (k215PVectoreq4 add0))));

pub theorem k215PushParam293 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum293 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum319 (k215PVector u c (t, w) c a b 0 0 v)) $ = '(ax_mp (ax_mp k215PReach_trans k215PushAStage0At293) (ax_mp (ax_mp k215PReach_trans k215PushAStage1At293) (ax_mp (ax_mp k215PReach_trans k215PushAStage2At293) (ax_mp (ax_mp k215PReach_trans k215PushAStage3At293) (ax_mp (ax_mp k215PReach_trans k215PushAStage4At293) k215PushAStage5At293)))));

