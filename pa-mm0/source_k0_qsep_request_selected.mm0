import "source_k0_qsep_request_marker.mm0";

import "source_k0_qsep_selected_branches.mm0";

import "source_k0_qsep_selected_exclusions.mm0";

theorem sfK0QSepTagged_selected_return (E: set) (n r t b c p x u y K theta: nat)
 (hf: $ sfBound (suc n) theta $) (hu0: $ u != 0 $) (hy0: $ y != 0 $)
 (huK: $ u < K $) (hyK: $ y < K $) (hpK: $ p < K $) (hxK: $ x < K $)
 (hbK: $ b < K $) (htK: $ t < K $) (hrK: $ r < K $)
 (hru: $ r != u $) (htu: $ t != u $) (hbu: $ b != u $) (hcu: $ c != u $)
 (hyu: $ y != u $) (huy: $ u < y $) (hpy: $ p < y $)
 (hyr: $ y != r $) (hyt: $ y != t $) (hyb: $ y != b $) (hyc: $ y != c $)
 (hyp: $ y != p $) (hyx: $ y != x $)
 (heu: $ sqEnvAvoid E n u $) (hey: $ sqEnvAvoid E n y $) (hpu: $ p != u $):
 $ k218QProvable (kImp (kMem b c) (kImp (kAll u (sfK0QSepTaggedRequest E r t b c u y K theta)) (kImp (sfK0QSepNamedSingleton x p K) (kImp (kMem x b) (kImp (sfNamedTemplate (sqEnvCons x E) K 0 theta) (kExists y (kAnd (kMem y c) (sfK0QSepNamedTagged E r t b p y K theta)))))))) $;

theorem sfK0QSepTagged_selected_member (E: set) (n r t b c p x u y K theta: nat)
 (hf: $ sfBound (suc n) theta $) (hu0: $ u != 0 $) (hy0: $ y != 0 $)
 (huK: $ u < K $) (hyK: $ y < K $) (hpK: $ p < K $) (hxK: $ x < K $)
 (hbK: $ b < K $) (htK: $ t < K $) (hrK: $ r < K $)
 (hru: $ r != u $) (htu: $ t != u $) (hbu: $ b != u $) (hcu: $ c != u $)
 (hyu: $ y != u $) (huy: $ u < y $) (hpy: $ p < y $)
 (hyr: $ y != r $) (hyt: $ y != t $) (hyb: $ y != b $) (hyc: $ y != c $)
 (hyp: $ y != p $) (hyx: $ y != x $)
 (heu: $ sqEnvAvoid E n u $) (hey: $ sqEnvAvoid E n y $) (hpu: $ p != u $):
 $ k218QProvable (kImp (kAll y (kImp (kMem y t) kF)) (kImp (kMem b r) (kImp (kMem t r) (kImp (kImp (kEq b t) kF) (kImp (kMem b c) (kImp (kAll u (sfK0QSepTaggedRequest E r t b c u y K theta)) (kImp (sfK0QSepNamedSingleton x p K) (kImp (kMem x b) (kImp (sfNamedTemplate (sqEnvCons x E) K 0 theta) (kMem x c)))))))))) $;
