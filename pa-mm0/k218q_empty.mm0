import "k218q_seed_witness.mm0";
import "k218q_specialization.mm0";

-- A direct consequence of the SeedG axiom for the false matrix.
-- This proof does not use an assumed K0 or old-K core image.
theorem k218QFalse_vacuity_one:
 $ k218QProvable (kImp kF (kAll 1 kF)) $;

theorem k218QFalse_conjunction_exists (q: nat):
 $ k218QProvable (kImp (kExists 1 (kAnd kF q)) kF) $;

theorem k218QFalse_closure_empty (c: nat):
 $ k218QProvable (kImp (k218Closure 1 3 c kF)
     (kAll 3 (kNot (kMem 3 c)))) $;

theorem k218QEmpty_witness:
 $ k218QProvable (kExists (k218QSeedCode kF)
     (kAll 3 (kNot (kMem 3 (k218QSeedCode kF))))) $;
