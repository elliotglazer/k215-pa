@_ def sfTVRoleMap(n:nat)(.i:nat):set = $ \ i, if (i < 4) (n + i) (i - 4) $;

pub theorem sfTVRoleMap_at(n i:nat): $ sfTVRoleMap n @ i = if (i < 4) (n + i) (i - 4) $ = (named '(!! applame j ,eqtac));

pub theorem sfTVRoleMap_low(n i:nat)(hi:$ i < 4 $): $ sfTVRoleMap n @ i = n + i $ = (named '(eqtr sfTVRoleMap_at (ifpos hi)));

pub theorem sfTVRoleMap_tail(n i:nat): $ sfTVRoleMap n @ (i + 4) = i $ = (named '(eqtr sfTVRoleMap_at (eqtr (ifneg (mpbi lenlt leaddid2)) (eqtr (subeq1 addcom) pncan2))));

theorem sftvr_agree(n:nat): $ sfRenameMapAgree (sfTVRoleMap n) (sfTVLiftMap n) 4 $ = (named '(ax_gen (eqtrd (eqtrd (a1i sfTVRoleMap_at) ifpos) (a1i (eqcom sfTVLiftMap_at)))));

pub theorem sfTVRoleMap_small(n c:nat)(hb:$ sfBound 4 c $): $ sfRename (sfTVRoleMap n) 0 c = sfTVLift n c $ = (named '(ax_mp (ax_mp sfRename_bounded_agreement sftvr_agree) (mpbir (sfBoundeq1 add01) hb)));

theorem sftvr_compose(n i:nat): $ sfComposeMap (sfTVRoleMap n) (sfReflectionTupleMap sfIdentityMap 4) @ i = sfIdentityMap @ i $ = (named '(eqtr sfComposeMap_value (eqtr (appeq2 (eqtr sfReflectionTupleMap_at (addeq1 sfIdentityMap_value))) (eqtr sfTVRoleMap_tail (eqcom sfIdentityMap_value)))));

pub theorem sfTVRoleMap_matrix(n matrix:nat)(hm:$ sfWf matrix $): $ sfRename (sfTVRoleMap n) 1 (sfRename (sfReflectionTupleMap sfIdentityMap 4) 1 matrix) = matrix $ = (named '(eqtr (ax_mp sfRename_compose hm) (eqtr (ax_mp (sfRename_extensional (ax_gen sftvr_compose)) hm) (ax_mp sfRename_identity hm))));

theorem sftvr_true(n:nat): $ sfRename (sfTVRoleMap n) 0 sfCLTrue = sfCLTrue $ = (named '(eqtr sfRename_sfImp (nsImp_eq sfRename_bot sfRename_bot)));

theorem sftvr_mem(n i:nat): $ sfRename (sfTVRoleMap n) 0 (sfMem ((sfIdentityMap @ i) + 4) 3) = sfMem ((sfIdentityMap @ i) + 0) (n + 3) $ = (named '(eqtr sfRename_sfMem (nsMem_eq (eqtr sfRenameIndex_zero (eqtr (appeq2 (addeq1 sfIdentityMap_value)) (eqtr sfTVRoleMap_tail (eqcom (eqtr add0 sfIdentityMap_value))))) (eqtr sfRenameIndex_zero (sfTVRoleMap_low (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S))))))));

pub theorem sfTVRoleMap_tuple(n m:nat): $ sfRename (sfTVRoleMap n) 0 (sfReflectionTuple sfIdentityMap 4 3 m) = sfReflectionTuple sfIdentityMap 0 (n + 3) m $ = (named @ induct '(ind) 'm '(eqtr (sfRenameeq3 sfReflectionTuple_zero) (eqtr sftvr_true (eqcom sfReflectionTuple_zero))) '(eqtrd (a1i (sfRenameeq3 sfReflectionTuple_suc)) (eqtrd (a1i sfRename_sfAnd) (eqtrd (sfAndeqd id (a1i sftvr_mem)) (a1i (eqcom sfReflectionTuple_suc))))));
