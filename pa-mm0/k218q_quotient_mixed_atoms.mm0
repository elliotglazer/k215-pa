import "k218q_quotient_atom_uniform.mm0";

import "k218q_quotation_supported_theory.mm0";

def k218QMixed (H t k x y: nat): wff = $ x = y \/ k218IHypProvable H (sqEqual t x y k) $;

def k218QMBounds (k t x xp y yp: nat): wff = $ 0 < k /\ (t < k /\ (x < k /\ (xp < k /\ (y < k /\ yp < k)))) $;

theorem k218QMHyp_same (H a b: nat): $ a = b -> k218IHypProvable H (kImp a b) $;

theorem k218QMHyp_syl (G: wff) (H a b c: nat) (ha: $ G -> k218IHypProvable H (kImp a b) $) (hb: $ G -> k218IHypProvable H (kImp b c) $): $ G -> k218IHypProvable H (kImp a c) $;

theorem k218QM_sym_related (G: wff) (H k t x y: nat) (hb: $ G -> k218QASymBounds k t x y $) (he: $ G -> k218IHypProvable H (k218QAEmpty t k) $) (hr: $ G -> k218IHypProvable H (sqEqual t x y k) $): $ G -> k218IHypProvable H (sqEqual t y x k) $;

theorem k218QM_sym (G: wff) (H k t x y: nat) (hb: $ G -> k218QASymBounds k t x y $) (he: $ G -> k218IHypProvable H (k218QAEmpty t k) $) (hr: $ G -> k218QMixed H t k x y $): $ G -> k218QMixed H t k y x $;

theorem k218QM_member_left_related (G: wff) (H k t x xp y yp: nat) (hb: $ G -> k218QMBounds k t x xp y yp $) (he: $ G -> k218IHypProvable H (k218QAEmpty t k) $) (hr: $ G -> k218IHypProvable H (sqEqual t x xp k) $): $ G -> k218IHypProvable H ((kImp (sqMember t x y k) (sqMember t xp y k))) $;

theorem k218QM_member_left (G: wff) (H k t x xp y yp: nat) (hb: $ G -> k218QMBounds k t x xp y yp $) (he: $ G -> k218IHypProvable H (k218QAEmpty t k) $) (hr: $ G -> k218QMixed H t k x xp $): $ G -> k218IHypProvable H ((kImp (sqMember t x y k) (sqMember t xp y k))) $;

theorem k218QM_member_right_related (G: wff) (H k t x xp y yp: nat) (hb: $ G -> k218QMBounds k t x xp y yp $) (he: $ G -> k218IHypProvable H (k218QAEmpty t k) $) (hr: $ G -> k218IHypProvable H (sqEqual t y yp k) $): $ G -> k218IHypProvable H ((kImp (sqMember t xp y k) (sqMember t xp yp k))) $;

theorem k218QM_member_right (G: wff) (H k t x xp y yp: nat) (hb: $ G -> k218QMBounds k t x xp y yp $) (he: $ G -> k218IHypProvable H (k218QAEmpty t k) $) (hr: $ G -> k218QMixed H t k y yp $): $ G -> k218IHypProvable H ((kImp (sqMember t xp y k) (sqMember t xp yp k))) $;

theorem k218QM_equal_left_related (G: wff) (H k t x xp y yp: nat) (hb: $ G -> k218QMBounds k t x xp y yp $) (he: $ G -> k218IHypProvable H (k218QAEmpty t k) $) (hr: $ G -> k218IHypProvable H (sqEqual t x xp k) $): $ G -> k218IHypProvable H ((kImp (sqEqual t x y k) (sqEqual t xp y k))) $;

theorem k218QM_equal_left (G: wff) (H k t x xp y yp: nat) (hb: $ G -> k218QMBounds k t x xp y yp $) (he: $ G -> k218IHypProvable H (k218QAEmpty t k) $) (hr: $ G -> k218QMixed H t k x xp $): $ G -> k218IHypProvable H ((kImp (sqEqual t x y k) (sqEqual t xp y k))) $;

theorem k218QM_equal_right_related (G: wff) (H k t x xp y yp: nat) (hb: $ G -> k218QMBounds k t x xp y yp $) (he: $ G -> k218IHypProvable H (k218QAEmpty t k) $) (hr: $ G -> k218IHypProvable H (sqEqual t y yp k) $): $ G -> k218IHypProvable H ((kImp (sqEqual t x y k) (sqEqual t x yp k))) $;

theorem k218QM_equal_right (G: wff) (H k t x xp y yp: nat) (hb: $ G -> k218QMBounds k t x xp y yp $) (he: $ G -> k218IHypProvable H (k218QAEmpty t k) $) (hr: $ G -> k218QMixed H t k y yp $): $ G -> k218IHypProvable H ((kImp (sqEqual t x y k) (sqEqual t x yp k))) $;

theorem k218QM_member_transport (G: wff) (H k t x xp y yp: nat) (hb: $ G -> k218QMBounds k t x xp y yp $) (he: $ G -> k218IHypProvable H (k218QAEmpty t k) $) (hx: $ G -> k218QMixed H t k x xp $) (hy: $ G -> k218QMixed H t k y yp $): $ G -> k218IHypProvable H ((kImp (sqMember t x y k) (sqMember t xp yp k))) $;

theorem k218QM_equal_transport (G: wff) (H k t x xp y yp: nat) (hb: $ G -> k218QMBounds k t x xp y yp $) (he: $ G -> k218IHypProvable H (k218QAEmpty t k) $) (hx: $ G -> k218QMixed H t k x xp $) (hy: $ G -> k218QMixed H t k y yp $): $ G -> k218IHypProvable H ((kImp (sqEqual t x y k) (sqEqual t xp yp k))) $;
