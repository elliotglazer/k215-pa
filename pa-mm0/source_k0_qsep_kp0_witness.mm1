@_ def sfK0QSepKp0UseBody (f: nat): nat = $ (sfEx (sfAnd (sfAll (sfImp (sfOr (sfEq 0 2) (sfEx (sfAnd (sfMem 0 2) (sfAll (sfImp (sfMem 0 2) (sfMem 0 1)))))) (sfImp (sfEx (sfRename sfK218KpRequestMap 0 f)) (sfEx (sfAnd (sfMem 0 2) (sfRename sfK218KpRequestMap 0 f)))))) (sfAll (sfImp (sfMem 0 1) (sfEx (sfRename sfK218SupportMap 0 f)))))) $;

pub theorem sfK0QSepKp0UseBody_bound (n f: nat) (hf: $ sfBound (suc (suc n)) f $):
 $ sfBound (suc n) (sfK0QSepKp0UseBody f) $ =
'(mpbi sfBound_sfAll (sfK218Kp0_bound hf));

pub theorem sfK0QSep_all_specialization (E: set) (n k y a: nat) (hz: $ k != 0 $) (hy: $ y < k $) (he: $ sqEnvAvoid E n k $)
 (ha: $ sfBound (suc n) a $):
 $ k218QProvable (kImp (sfNamedTemplate E k 0 (sfAll a)) (sfNamedTemplate (sqEnvCons y E) (suc k) 0 a)) $ =
'(mpbir (k218QProvableeq (kImpeq
 (ax_mp sfNamedTemplate_all_cons (ax_mp sfBound_wf ha))
 (eqcom (ax_mp (sfNamedTemplate_substitution_cons hz he) ha))))
 (ax_mp (ax_mp (ax_mp k218INamed_specialization (ltner hy))
 (ax_mp (sfNamedTemplate_binder_absent ltsucid) (ax_mp sfBound_wf ha)))
 (ax_mp (sfNamedTemplate_binder_absent (ltletr hy lesucid)) (ax_mp sfBound_wf ha))));

pub theorem sfK0QSepKp0_use {i j: nat} (E: set) (n B k y f: nat)
 (hB: $ 3 < B $) (he1: $ sqEnvAvoid E n 1 $) (he3: $ sqEnvAvoid E n 3 $)
 (he: $ A. j (j < n -> E @ j < B) $) (hk: $ B <= k $)
 (hz: $ k != 0 $) (hy: $ y < k $) (hek: $ sqEnvAvoid E n k $)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218QProvable (sfNamedTemplate (sqEnvCons y E) (suc k) 0 (sfK0QSepKp0UseBody f)) $ =
(named '(k218QProvable_mp (!! k218QSourceKp0_at i j hB he1 he3 he hk hf)
 (sfK0QSep_all_specialization hz hy hek (sfK0QSepKp0UseBody_bound hf))));

@_ def sfK0QSepTaggedWitness (E: set) (a r t b k theta: nat): nat = $ (kExists (suc k) (kAnd (kAll (suc (suc k)) (kImp (kDisj (kEq (suc (suc k)) a) (kExists (suc (suc (suc k))) (kAnd (kMem (suc (suc (suc k))) (suc k)) (kAll (suc (suc (suc (suc k)))) (kImp (kMem (suc (suc (suc (suc k)))) (suc (suc k))) (kMem (suc (suc (suc (suc k)))) (suc (suc (suc k))))))))) (kImp (kExists (suc (suc (suc k))) (sfK0QSepNamedTagged E r t b (suc (suc k)) (suc (suc (suc k))) (suc (suc (suc (suc k)))) theta)) (kExists (suc (suc (suc k))) (kAnd (kMem (suc (suc (suc k))) (suc k)) (sfK0QSepNamedTagged E r t b (suc (suc k)) (suc (suc (suc k))) (suc (suc (suc (suc k)))) theta)))))) (kAll (suc (suc k)) (kImp (kMem (suc (suc k)) (suc k)) (kExists (suc (suc (suc k))) (sfK0QSepNamedTagged E r t b (suc (suc (suc k))) (suc (suc k)) (suc (suc (suc (suc k)))) theta)))))) $;

pub theorem sfK0QSepTaggedWitness_source (E: set) (n a r t b k theta: nat) (hf: $ sfBound (suc n) theta $):
 $ sfNamedTemplate (sqEnvCons a (sqEnvCons b (sqEnvCons t (sqEnvCons r E)))) (suc k) 0 (sfK0QSepKp0UseBody (sfK0QSepTagged theta)) = sfK0QSepTaggedWitness E a r t b k theta $ =
(named '(eqtr (ax_mp sfNamedTemplate_ex_cons (ax_mp (ax_mp sfWf_and (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp (ax_mp (ax_mp sfWf_or sfWf_eq) (ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and sfWf_mem) (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfWf_mem) sfWf_mem)))))) (ax_mp (ax_mp sfWf_imp (ax_mp sfWf_ex sfRename_wf)) (ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and sfWf_mem) sfRename_wf)))))) (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfWf_mem) (ax_mp sfWf_ex sfRename_wf))))) (kExistseq2 (eqtr sfNamedTemplate_sfAnd (kAndeq (eqtr (ax_mp sfNamedTemplate_all_cons (ax_mp (ax_mp sfWf_imp (ax_mp (ax_mp sfWf_or sfWf_eq) (ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and sfWf_mem) (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfWf_mem) sfWf_mem)))))) (ax_mp (ax_mp sfWf_imp (ax_mp sfWf_ex sfRename_wf)) (ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and sfWf_mem) sfRename_wf))))) (kAlleq2 (eqtr sfNamedTemplate_sfImp (kImpeq (eqtr sfNamedTemplate_sfOr (kDisjeq (eqtr sfNamedTemplate_sfEq (kEqeq (eqtr sfNamedIndex_zero sqEnvCons_zero) (eqtr sfNamedIndex_zero (eqtr sqEnvCons_suc (eqtr sqEnvCons_suc sqEnvCons_zero))))) (eqtr (ax_mp sfNamedTemplate_ex_cons (ax_mp (ax_mp sfWf_and sfWf_mem) (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfWf_mem) sfWf_mem)))) (kExistseq2 (eqtr sfNamedTemplate_sfAnd (kAndeq (eqtr sfNamedTemplate_sfMem (kMemeq (eqtr sfNamedIndex_zero sqEnvCons_zero) (eqtr sfNamedIndex_zero (eqtr sqEnvCons_suc (eqtr sqEnvCons_suc sqEnvCons_zero))))) (eqtr (ax_mp sfNamedTemplate_all_cons (ax_mp (ax_mp sfWf_imp sfWf_mem) sfWf_mem)) (kAlleq2 (eqtr sfNamedTemplate_sfImp (kImpeq (eqtr sfNamedTemplate_sfMem (kMemeq (eqtr sfNamedIndex_zero sqEnvCons_zero) (eqtr sfNamedIndex_zero (eqtr sqEnvCons_suc (eqtr sqEnvCons_suc sqEnvCons_zero))))) (eqtr sfNamedTemplate_sfMem (kMemeq (eqtr sfNamedIndex_zero sqEnvCons_zero) (eqtr sfNamedIndex_zero (eqtr sqEnvCons_suc sqEnvCons_zero)))))))))))))) (eqtr sfNamedTemplate_sfImp (kImpeq (eqtr (ax_mp sfNamedTemplate_ex_cons sfRename_wf) (kExistseq2 (eqtr (k218RoleKpRequest_matrix (ax_mp sfBound_wf (sfK0QSepTagged_bound hf))) (sfK0QSepTagged_named (ax_mp sfBound_wf hf))))) (eqtr (ax_mp sfNamedTemplate_ex_cons (ax_mp (ax_mp sfWf_and sfWf_mem) sfRename_wf)) (kExistseq2 (eqtr sfNamedTemplate_sfAnd (kAndeq (eqtr sfNamedTemplate_sfMem (kMemeq (eqtr sfNamedIndex_zero sqEnvCons_zero) (eqtr sfNamedIndex_zero (eqtr sqEnvCons_suc (eqtr sqEnvCons_suc sqEnvCons_zero))))) (eqtr (k218RoleKpRequest_matrix (ax_mp sfBound_wf (sfK0QSepTagged_bound hf))) (sfK0QSepTagged_named (ax_mp sfBound_wf hf))))))))))))) (eqtr (ax_mp sfNamedTemplate_all_cons (ax_mp (ax_mp sfWf_imp sfWf_mem) (ax_mp sfWf_ex sfRename_wf))) (kAlleq2 (eqtr sfNamedTemplate_sfImp (kImpeq (eqtr sfNamedTemplate_sfMem (kMemeq (eqtr sfNamedIndex_zero sqEnvCons_zero) (eqtr sfNamedIndex_zero (eqtr sqEnvCons_suc sqEnvCons_zero)))) (eqtr (ax_mp sfNamedTemplate_ex_cons sfRename_wf) (kExistseq2 (eqtr (k218RoleSupport_matrix (ax_mp sfBound_wf (sfK0QSepTagged_bound hf))) (sfK0QSepTagged_named (ax_mp sfBound_wf hf))))))))))))));

pub theorem sfK0QSepTaggedWitness_proved {i j: nat} (E: set) (n B a r t b k theta: nat)
 (hB: $ 3 < B $)
 (he1: $ sqEnvAvoid (sqEnvCons b (sqEnvCons t (sqEnvCons r E))) (suc (suc (suc n))) 1 $)
 (he3: $ sqEnvAvoid (sqEnvCons b (sqEnvCons t (sqEnvCons r E))) (suc (suc (suc n))) 3 $)
 (he: $ A. j (j < suc (suc (suc n)) -> (sqEnvCons b (sqEnvCons t (sqEnvCons r E))) @ j < B) $)
 (hk: $ B <= k $) (hz: $ k != 0 $) (ha: $ a < k $)
 (hek: $ sqEnvAvoid (sqEnvCons b (sqEnvCons t (sqEnvCons r E))) (suc (suc (suc n))) k $)
 (hf: $ sfBound (suc n) theta $):
 $ k218QProvable (sfK0QSepTaggedWitness E a r t b k theta) $ =
(named '(mpbi (k218QProvableeq (sfK0QSepTaggedWitness_source hf))
 (!! sfK0QSepKp0_use i j hB he1 he3 he hk hz ha hek (sfK0QSepTagged_bound hf))));
