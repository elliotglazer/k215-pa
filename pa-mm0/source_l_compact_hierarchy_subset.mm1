pub theorem sfLCompactHierarchySubset_replay_context: $ srcLCompactSubsetContext = sfLBackground $ = 'eqid;
pub theorem sfLCompactHierarchySubset_replay_formula: $ srcLCompactSubsetFormula = sfLCompactHierarchySubsetFormula $ = 'eqid;
pub theorem sfLCompactHierarchySubset_local: $ nsLocal sfLBackground sfLCompactHierarchySubsetFormula $ = '(mpbi (nsLocal_context_eq sfLCompactHierarchySubset_replay_context) (mpbi (nsLocal_formula_eq sfLCompactHierarchySubset_replay_formula) srcLCompactSubsetCertificate));
pub theorem sfLPowerHierarchySubset_zfr: $ sfTheoryProvable zfrAxioms sfLPowerHierarchySubset $ = '(sfLCompactHierarchySubset_from_local sfLUniversalHierarchyExists_zfr sfLUniversalHierarchyUnique_zfr (sfLCompactHierarchyTrans_from_checked sfLWeakStageTrans_zfr) sfLCompactHierarchySubset_local);
