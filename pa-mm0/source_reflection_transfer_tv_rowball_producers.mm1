pub theorem sfTVFunctionRowBall_from_producers(D level:nat)(E:set)(n i:nat)(hd:$ sfBound 1 D $)(hl:$ sfBound 2 level $)(hv:$ sfPieceFunctionTableValid E n $)(hi:$ i < n $)(hE:$ sfTheoryProvable zfrAxioms (sfReflectionCondLevelExists level) $)(hS:$ sfTheoryProvable zfrAxioms (sfReflectionHierarchySubsetNormal level) $)(hC:$ sfTheoryProvable zfrAxioms (sfReflectionLimitCoverageLaw level) $): $ sfTheoryProvable zfrAxioms (sfTVRowBallLaw D level (sfPieceFunctionBinary D (sfReflectionPCLevel level) E n) (sfPieceFunctionCount E i) (sfPieceFunctionMatrix E i)) $ = (named '(ax_mp (ax_mp (sfTheory_lemma_context zfrAxioms_closed) (mpbir sfTheoryContext_cons (ian (mpbir sfTheoryProofClass_value hS) (mpbir sfTheoryContext_cons (ian (mpbir sfTheoryProofClass_value sfReflectionOrdinalSubsetCompare_zfr) (mpbir sfTheoryContext_cons (ian (mpbir sfTheoryProofClass_value hE) (mpbir sfTheoryContext_cons (ian (mpbir sfTheoryProofClass_value hC) sfTheoryContext_nil))))))))) (sfTVFunctionRowBall_from_producers_local hd hl hv hi)));
