import "bb215_derivability_l2_add_assoc.mm0";

-- L05, layer L2 (lanes/L05.md): multiplication inside PA: level-n instances of the two
-- multiplication axioms, and 0 * x = 0. Generated by build_bb215_derivability_l2_add_basic.py.

theorem bb215L2_mul_zero_inst (n t: nat) (ht: $ paTermBound n t $):
  $ paProvable n (paFormulaEqual (paTermMultiplication t paTermZero) paTermZero) $;

theorem bb215L2_mul_succ_inst (n s t: nat) (hs: $ paTermBound n s $) (ht: $ paTermBound n t $):
  $ paProvable n (paFormulaEqual (paTermMultiplication s (paTermSuccessor t)) (paTermAddition (paTermMultiplication s t) s)) $;

-- PA |- A. x (0 * x = 0)

theorem bb215L2_mul_zero_left:
  $ paProvable 0 (paFormulaAll (paFormulaEqual (paTermMultiplication paTermZero (paTermVariable 0)) paTermZero)) $;
