pub theorem eofSupported: $ k218SQ_sqSupportedGood (sfSequent eoPSContext eoPSFormula) $ = '(ax_mp eofLocal_supported eoPSCertificate);

pub theorem eofToZero (S: nat): $ k218IHypProvable kQuotientContext (sqQuote (sqNumericEnvironment S) 1 4 0 eoPSFormula) -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 eoPSFormula) $ = '(bi1 (k218IHypProvableeq2 (ax_mp sqQuote_environment_closed eofOmegaClosed)));

pub theorem eofUse (F: wff) (n: nat) (hf: $ F -> eofFiveImages $) (ha: $ F -> k218SQ_sqSupportedAt n (sfSequent eoPSContext eoPSFormula) $): $ F -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 eoPSFormula) $ = '(syl eofToZero (mpd (syl eofSourceSupport hf) (mpd (a1i k218SQ_sqBootstrap_default_domain) (mpd (a1i sqBootstrap_default_safe) (mpd ha (a1i k218SQ_sqSupportedAt_sequent))))));

pub theorem eofAt (n: nat): $ eofFiveImages -> k218SQ_sqSupportedAt n (sfSequent eoPSContext eoPSFormula) -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 eoPSFormula) $ = (named '(exp @ eofUse anl anr));

pub theorem eofResult: $ eofFiveImages -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 eoPSFormula) $ = (named '(mpd (a1i eofSupported) (eexd eofAt)));

pub theorem eofOmegaImage: $ eofFiveImages -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 zfcOmega) $ = 'eofResult;
