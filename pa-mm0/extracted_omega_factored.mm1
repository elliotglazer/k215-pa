pub theorem eofSourceSupport (S: nat): $ eofFiveImages -> k218SQ_sqSourceSupport kQuotientContext S 1 4 eoPSContext $ = '(mpd eofImageAt0 (mpd (mpd eofImageAt1 (mpd (mpd eofImageAt2 (mpd (mpd eofImageAt3 (mpd (mpd eofImageAt4 (mpd (mpd eofImageAt5 (mpd (mpd eofImageAt6 (mpd (mpd eofImageAt7 (mpd (mpd eofImageAt8 (mpd (mpd eofImageAt9 (mpd (mpd eofImageAt10 (mpd (mpd eofImageAt11 (mpd (mpd eofImageAt12 (mpd (mpd eofImageAt13 (mpd (mpd eofImageAt14 (mpd (a1i k218SQ_sqSourceSupport_nil) (a1i k218SQ_sqSourceSupport_cons))) (a1i k218SQ_sqSourceSupport_cons))) (a1i k218SQ_sqSourceSupport_cons))) (a1i k218SQ_sqSourceSupport_cons))) (a1i k218SQ_sqSourceSupport_cons))) (a1i k218SQ_sqSourceSupport_cons))) (a1i k218SQ_sqSourceSupport_cons))) (a1i k218SQ_sqSourceSupport_cons))) (a1i k218SQ_sqSourceSupport_cons))) (a1i k218SQ_sqSourceSupport_cons))) (a1i k218SQ_sqSourceSupport_cons))) (a1i k218SQ_sqSourceSupport_cons))) (a1i k218SQ_sqSourceSupport_cons))) (a1i k218SQ_sqSourceSupport_cons))) (a1i k218SQ_sqSourceSupport_cons)));

