import "bd_certs_b4b.mm0";
import "b4_zfc_final.mm0";

theorem bdZfcPrf_sound (w s: nat): $ bdZfcPrf w s -> zfcProvable s $;
theorem bdZfcPrf_sound_ex (s: nat) {w: nat}: $ E. w bdZfcPrf w s -> zfcProvable s $;
theorem bdZfcPrf_intro (mm vv BB GG pp s: nat): $ bdZfcJust mm vv BB /\ GG <= BB /\ pp <= BB /\ sfSequent GG s <= pp /\ bdHas mm vv vv bdtCax GG 0 0 0 /\ bdHas mm vv vv bdtValid pp 0 0 0 /\ bdHas mm vv vv bdtIn (sfSequent GG s) pp 0 0 -> bdZfcPrf (mm, (vv, BB)) s $;
theorem bdZfcPrf_cert (GG pp s: nat) {w: nat}: $ zfcContext GG -> traceValid sfNDFullRules pp -> sfSequent GG s IN pp -> E. w bdZfcPrf w s $;
theorem bdZfcPrf_complete (s: nat) {w: nat}: $ zfcProvable s -> E. w bdZfcPrf w s $;
theorem bdZfcPrf_iff (s: nat) {w: nat}: $ zfcProvable s <-> E. w bdZfcPrf w s $;
theorem bdZfcBot_Prf (w: nat): $ bdZfcBot w <-> bdZfcPrf w 0 $;
