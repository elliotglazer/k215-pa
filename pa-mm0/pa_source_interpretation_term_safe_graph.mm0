import "pa_source_interpretation_builders.mm0";

def paSourceSafeGraph (phi n: nat): nat = $ if (sfBound (suc n) phi) phi sfBot $;

theorem paSourceSafeGraph_eq (phi n: nat): $ sfBound (suc n) phi -> paSourceSafeGraph phi n = phi $;

theorem paSourceSafeGraph_bound (phi n: nat): $ sfBound (suc n) (paSourceSafeGraph phi n) $;
