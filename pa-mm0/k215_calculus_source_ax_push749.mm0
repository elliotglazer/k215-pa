import "k215_calculus_source_ax_pair755.mm0";
import "k215_calculus_source_ax_stack_loops.mm0";

theorem k215PairMacro46_vectorAt749 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat):
 $ k215PReach (k215PState k215PNum755 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215PNum765 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $;

theorem k215PushParam749 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum749 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum775 (k215PVector u b (t, w) c a b 0 0 v)) $;
