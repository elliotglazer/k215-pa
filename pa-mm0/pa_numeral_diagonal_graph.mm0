import "pa_numeral_formula_subst_graph.mm0";

def paNumeralDiagonal (c: nat): nat = $ paFormulaSubst 0 (paTermNumeral c) c $;

def paNumeralDiagonalGraph (c t: nat): wff = $ paNumeralFormulaSubstGraph 0 c c t $;

theorem paNumeralDiagonalGraph_correct (c t m: nat): $ paFormulaBound m c -> (paNumeralDiagonalGraph c t <-> t = paNumeralDiagonal c) $;

theorem paNumeralDiagonalGraph_total (c: nat): $ paNumeralDiagonalGraph c (paNumeralDiagonal c) $;

theorem paNumeralDiagonal_bound (c: nat): $ paFormulaBound 1 c -> paFormulaBound 0 (paNumeralDiagonal c) $;

theorem paNumeralDiagonalGraph_closed (c t: nat): $ paFormulaBound 1 c -> paNumeralDiagonalGraph c t -> paFormulaBound 0 t $;
