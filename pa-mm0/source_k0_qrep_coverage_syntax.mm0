import "source_k0_qrep_witness_syntax.mm0";

def sfK0QRepCoverageBody (E: set) (a c u w z R phi: nat): nat = $ (kImp (kImp (kImp (kMem 1 u) (kImp (kMem u a) kF)) kF) (kImp (kExists w (kImp (kImp (kMem 1 w) (kImp (sfK0QRepRelation E 1 R u w phi) kF)) kF)) (kExists z (kImp (kImp (kMem 1 z) (kImp (kImp (kImp (kMem z c) (kImp (sfK0QRepRelation E 1 R u z phi) kF)) kF) kF)) kF)))) $;

theorem sfK0QRepCoverage_specialization (E: set) (n a c u w z x R phi: nat) (hf: $ sfBound (suc (suc n)) phi $)
 (huR: $ u < R $) (hxR: $ x < R $) (hu0: $ u != 0 $)
 (hu1: $ u != 1 $) (hua: $ u != a $) (huc: $ u != c $)
 (huw: $ u != w $) (huz: $ u != z $) (hxw: $ x != w $)
 (hxz: $ x != z $) (hux: $ u != x $) (heu: $ sqEnvAvoid E n u $):
 $ k218QProvable (kImp (kAll u (sfK0QRepCoverageBody E a c u w z R phi)) (sfK0QRepCoverageBody E a c x w z R phi)) $;

theorem sfK0QRepCoverage_premise_intro (E: set) (n x w y R phi: nat) (hf: $ sfBound (suc (suc n)) phi $) (hwR: $ w < R $) (hyR: $ y < R $) (hw0: $ w != 0 $) (hw1: $ w != 1 $) (hwx: $ w != x $) (hwy: $ w != y $) (hew: $ sqEnvAvoid E n w $):
 $ k218QProvable (kImp (kImp (kImp (kMem 1 y) (kImp (sfK0QRepRelation E 1 R x y phi) kF)) kF) (kExists w (kImp (kImp (kMem 1 w) (kImp (sfK0QRepRelation E 1 R x w phi) kF)) kF))) $;
