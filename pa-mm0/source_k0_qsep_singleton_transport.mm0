import "source_k0_qsep_singleton.mm0";

import "k218q_equality.mm0";

import "k218q_bound_vacuity.mm0";

theorem sfK0QSepSingleton_container (x p r b K: nat) (hx: $ x < K $) (hp: $ p < K $) (hr: $ r < K $) (hb: $ b < K $):
 $ k218QProvable (kImp (kEq p r) (kImp (kImp (kImp (kMem x p) (kImp (kAll K (kImp (kMem K p) (kEq K x))) kF)) kF) (kImp (kImp (kMem x r) (kImp (kAll K (kImp (kMem K r) (kEq K x))) kF)) kF))) $;

theorem sfK0QSepSingleton_subset (x p r b K: nat) (hx: $ x < K $) (hp: $ p < K $) (hr: $ r < K $) (hb: $ b < K $):
 $ k218QProvable (kImp (kImp (kImp (kMem x p) (kImp (kAll K (kImp (kMem K p) (kEq K x))) kF)) kF) (kImp (kMem x b) (kAll K (kImp (kMem K p) (kMem K b))))) $;
