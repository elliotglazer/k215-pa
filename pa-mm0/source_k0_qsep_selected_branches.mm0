import "source_k0_qsep_singleton.mm0";

import "source_k0_qsep_tagged_branches.mm0";

theorem sfK0QSepTagged_selected_at (E: set) (r t b c p x y K theta: nat) (hf: $ sfWf theta $) (hpK: $ p < K $) (hxK: $ x < K $) (hyK: $ y < K $)
 (hyp: $ y != p $) (hyr: $ y != r $) (hyt: $ y != t $) (hyx: $ y != x $) (hyc: $ y != c $):
 $ k218QProvable (kImp (kImp (kEq p r) kF) (kImp (kImp (kEq p t) kF) (kImp (kMem x p) (kImp (kImp (kImp (kMem y c) (kImp (kImp (kImp (kImp (kImp (kEq p r) (kImp (kEq y b) kF)) kF) kF) (kImp (kImp (kImp (kImp (kEq p t) (kImp (kEq y t) kF)) kF) kF) (kImp (kImp (sfK0QSepNamedSingleton y p K) (kImp (kImp (kImp (kMem y b) (kImp (sfNamedTemplate (sqEnvCons y E) K 0 theta) kF)) kF) kF)) kF))) kF)) kF) (kMem x c))))) $;

theorem sfK0QSepTagged_selected_exists (E: set) (r t b c p x y K theta: nat) (hf: $ sfWf theta $) (hpK: $ p < K $) (hxK: $ x < K $) (hyK: $ y < K $)
 (hyp: $ y != p $) (hyr: $ y != r $) (hyt: $ y != t $) (hyx: $ y != x $) (hyc: $ y != c $):
 $ k218QProvable (kImp (kImp (kEq p r) kF) (kImp (kImp (kEq p t) kF) (kImp (kMem x p) (kImp (kImp (kAll y (kImp (kImp (kImp (kMem y c) (kImp (kImp (kImp (kImp (kImp (kEq p r) (kImp (kEq y b) kF)) kF) kF) (kImp (kImp (kImp (kImp (kEq p t) (kImp (kEq y t) kF)) kF) kF) (kImp (kImp (sfK0QSepNamedSingleton y p K) (kImp (kImp (kImp (kMem y b) (kImp (sfNamedTemplate (sqEnvCons y E) K 0 theta) kF)) kF) kF)) kF))) kF)) kF) kF)) kF) (kMem x c))))) $;
