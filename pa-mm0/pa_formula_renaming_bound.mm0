import "pa_formula_renaming.mm0";

theorem paFormulaTermRename_bound {i: nat} (R: set) (d n m a: nat): $ A. i (i < n -> R @ i < m) -> paTermBound (d + n) a -> paTermBound (d + m) (paTermRename (sfRenameDepthMap R d) a) $;

theorem paFormulaRename_bound {i: nat} (R: set) (d n m c: nat): $ A. i (i < n -> R @ i < m) -> paFormulaBound (d + n) c -> paFormulaBound (d + m) (paFormulaRename R d c) $;
