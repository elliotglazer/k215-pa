def bdDvd (a b .c: nat): wff = $ E. c (c <= b /\ c * a = b) $;
def bdCell (m v k .x: nat): wff =
$ 0 < m /\ 0 < v /\ A. x (x <= k -> 0 < x -> bdDvd x m) /\
  bdDvd (suc (m * suc k)) v $;
def paS1GuardAtom (G t: nat): wff = $ G = paBoundedLE (paTermVariable 1) t \/ G = paBoundedLT (paTermVariable 1) t $;
def paS1Cmp (c .a .b: nat): wff = $ E. a E. b (c = paFormulaEx (paFormulaEqual (paTermAddition a (paTermVariable 0)) b) /\ paTermLowerBound 1 a /\ paTermLowerBound 1 b) $;
def paS1PreAtom (l .u: nat): wff = $ paS1Cmp l /\ ~ E. u paS1GuardAtom l u $;
def paS1HeadShape (g G .l .r: nat): wff = $ (g = G \/ E. r g = paFormulaAnd G r) \/
  (E. l (paS1PreAtom l /\ g = paFormulaAnd l G) \/ E. l E. r (paS1PreAtom l /\ g = paFormulaAnd (paFormulaAnd l G) r)) $;
def paS1HeadAt (g t .G: nat): wff = $ E. G (paS1GuardAtom G t /\ paS1HeadShape g G) $;
def paS1HeadGuard (g .t: nat): wff = $ E. t (paTermLowerBound 2 t /\ paS1HeadAt g t) $;
def paS1ImpGuarded (a .g .b: nat): wff = $ E. g E. b (a = paFormulaImp g b /\ paS1HeadGuard g) $;
def paS1ClassAllowed (s c h: nat): wff = $ ifp (c = 0) (0 = 0)
 (ifp (sfTag c = 1) (0 = 0)
 (ifp (sfTag c = 3) ((s, sfLeft c) e. h /\ (s, sfRight c) e. h)
 (ifp (sfTag c = 4) ((s, sfLeft c) e. h /\ (s, sfRight c) e. h)
 (ifp (sfTag c = 5) ((1 - s, sfLeft c) e. h /\ (s, sfRight c) e. h)
 (ifp (sfTag c = 6 /\ sfRight c = 0) ((s, sfLeft c) e. h /\ (s = 0 \/ paS1ImpGuarded (sfLeft c)))
 (ifp (sfTag c = 7 /\ sfRight c = 0) ((s != 0 /\ (s, sfLeft c) e. h) \/ (s = 0 /\ (((s, sfLeft c) e. h /\ paS1HeadGuard (sfLeft c)) \/ paS1Cmp c)))
 (0 != 0))))))) $;
def paS1ClassStep (.k .h: nat): set = $ S\ k, {h | paS1ClassAllowed (fst k) (snd k) h} $;
def paS1Class (s c: nat): wff = $ srecp paS1ClassStep (s, c) $;
def paS1In (m v k: nat): wff = $ bdCell m v k $;
def paS1Lk (i e x: nat): nat = $ (0, i, e, x) $;
def paS1Tv (t e x: nat): nat = $ (1, t, e, x) $;
def paS1Tn (c e: nat): nat = $ (2, c, e) $;
def paS1Fn (c e: nat): nat = $ (3, c, e) $;
