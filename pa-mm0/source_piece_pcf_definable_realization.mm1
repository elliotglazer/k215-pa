import "source_piece_pcf_definable_witness_transport.mm1";

import "source_piece_pcf_rep_parameters.mm1";

import "source_reflection_transfer_maps.mm1";

@_ abstract def sfPieceDefinableRealizationMap(T:set)(e r A:nat): set = $ sqEnvCons e (sfPieceEnvironment T r A) $;

@_ abstract def sfPieceDefinableRealizationBody(n phi:nat): nat = $ sfImp (sfPieceDefinableRecipeEnvironment n) (sfIff (sfMem 0 1) (sfCLSetRel 2 (sfRename sfPieceDefinableRecipeMap 0 phi))) $;

theorem sfPieceDefinableRealization_add3(i:nat): $ 3 + i = suc (suc (suc i)) $ = (named '(eqtr addS1 (suceq (eqtr addS1 (suceq (eqtr addS1 (suceq add01)))))));

pub theorem sfPieceDefinableRealizationMap_zero(T:set)(e r A:nat): $ sfPieceDefinableRealizationMap T e r A @ 0 = e $ = (named 'sqEnvCons_zero);

pub theorem sfPieceDefinableRealizationMap_one(T:set)(e r A:nat): $ sfPieceDefinableRealizationMap T e r A @ 1 = r $ = (named '(eqtr sqEnvCons_suc sfPieceEnvironment_zero));

pub theorem sfPieceDefinableRealizationMap_two(T:set)(e r A:nat): $ sfPieceDefinableRealizationMap T e r A @ 2 = A $ = (named '(eqtr sqEnvCons_suc sfPieceEnvironment_one));

pub theorem sfPieceDefinableRealizationMap_tail(T:set)(e r A i:nat): $ sfPieceDefinableRealizationMap T e r A @ (3 + i) = T @ i $ = (named '(eqtr (appeq2 (sfPieceDefinableRealization_add3)) (eqtr sqEnvCons_suc sfPieceEnvironment_tail)));

pub theorem sfPieceDefinableRealizationMap_compose(T:set)(e r A i:nat): $ sfComposeMap (sfPieceDefinableRealizationMap T e r A) sfPieceDefinableRecipeMap @ i = T @ i $ = (named '(eqtr sfComposeMap_value (eqtr (appeq2 sfPieceDefinableRecipeMap_at) sfPieceDefinableRealizationMap_tail)));

pub theorem sfPieceDefinableRealization_environment(T:set)(e r A n:nat): $ sfRename (sfPieceDefinableRealizationMap T e r A) 0 (sfPieceDefinableRecipeEnvironment n) = sfPieceEnv T n e $ = (named '(eqtr sfPieceEnv_rename (sfPieceEnv_eq sfPieceDefinableRealizationMap_zero (ax_gen sfPieceDefinableRealizationMap_compose))));

pub theorem sfPieceDefinableRealization_matrix(T:set)(e r A phi:nat)(hf:$ sfWf phi $): $ sfRename (sfPieceDefinableRealizationMap T e r A) 0 (sfCLSetRel 2 (sfRename sfPieceDefinableRecipeMap 0 phi)) = sfCLSetRel A (sfRename T 0 phi) $ = (named '(eqtr (ax_mp sfCLSetRel_rename sfRename_wf) (trud (sfCLSetReleqd (a1i (eqtr sfRenameIndex_zero sfPieceDefinableRealizationMap_two)) (a1i (eqtr (ax_mp sfRename_compose hf) (ax_mp (sfRename_extensional (ax_gen sfPieceDefinableRealizationMap_compose)) hf)))))));

pub theorem sfPieceDefinableRealization_member(T:set)(e r A:nat): $ sfRename (sfPieceDefinableRealizationMap T e r A) 0 (sfMem 0 1) = sfMem e r $ = (named '(eqtr sfRename_sfMem (sfMemeq (eqtr sfRenameIndex_zero sfPieceDefinableRealizationMap_zero) (eqtr sfRenameIndex_zero sfPieceDefinableRealizationMap_one))));

theorem sfPieceDefinableRealization_iff_rename(S:set)(a b:nat): $ sfRename S 0 (sfIff a b) = sfIff (sfRename S 0 a) (sfRename S 0 b) $ = (named '(eqtr sfRename_sfAnd (sfAndeq sfRename_sfImp sfRename_sfImp)));

pub theorem sfPieceDefinableRealizationBody_wf(n phi:nat): $ sfWf (sfPieceDefinableRealizationBody n phi) $ = (named '(ax_mp (ax_mp sfWf_imp sfPieceEnv_wf) (ax_mp (ax_mp sfWf_and (ax_mp (ax_mp sfWf_imp sfWf_mem) sfCLSetRel_wf)) (ax_mp (ax_mp sfWf_imp sfCLSetRel_wf) sfWf_mem))));

pub theorem sfPieceDefinableRealization_open(T:set)(n phi e r A:nat)(hf:$ sfWf phi $): $ sfSubst 0 e (sfRename (sfPieceEnvironment T r A) 1 (sfPieceDefinableRealizationBody n phi)) = sfImp (sfPieceEnv T n e) (sfIff (sfMem e r) (sfCLSetRel A (sfRename T 0 phi))) $ = (named '(eqtr (sfReflectionTransfer_open sfPieceDefinableRealizationBody_wf) (eqtr sfRename_sfImp (nsImp_eq sfPieceDefinableRealization_environment (eqtr sfPieceDefinableRealization_iff_rename (nsAnd_eq (nsImp_eq sfPieceDefinableRealization_member (sfPieceDefinableRealization_matrix hf)) (nsImp_eq (sfPieceDefinableRealization_matrix hf) sfPieceDefinableRealization_member)))))));

pub theorem sfPieceDefinableRealization_local(T:set)(G n phi r A e:nat)(hb:$ sfBound n phi $)(hr:$ nsLocal G (sfPieceDefinableNamed n phi r A) $)(hm:$ sfReflectionDnMembers T G A n $)(he:$ nsLocal G (sfPieceEnv T n e) $): $ nsLocal G (sfIff (sfMem e r) (sfCLSetRel A (sfRename T 0 phi))) $ = (named '(ax_mp (ax_mp nsLocal_mp (sfRQ_rewrite (sfPieceDefinableRealization_open (ax_mp sfBound_wf hb)) (ax_mp nsLocal_AllE (sfRQ_rewrite sfRename_sfAll (ax_mp (sfReflectionDn_eliminate_binary (ax_mp sfBound_wf (ax_mp sfPieceDefinableRecipe_point_bound hb)) (ax_mp sfPieceDefinableRecipe_bound hb) hm) (sfRQ_rewrite (eqtr (sfPieceDefinableNamed_open hb) (! sfReflectionDnOpen_rename $ T $ $ r $ $ A $ $ sfPieceDefinableRecipe n phi $ (ax_mp sfPieceDefinableRecipe_bound hb))) hr)))))) he));

pub theorem sfPieceDefinableRealization_included_context(T:set)(G H n phi r A e:nat)(hb:$ sfBound n phi $)(hw:$ sfContextWf H $)(hs:$ sfContextSub G H $)(hr:$ nsLocal G (sfPieceDefinableNamed n phi r A) $)(hm:$ sfReflectionDnMembers T H A n $)(he:$ nsLocal H (sfPieceEnv T n e) $): $ nsLocal H (sfIff (sfMem e r) (sfCLSetRel A (sfRename T 0 phi))) $ = (named '(sfPieceDefinableRealization_local hb (ax_mp (ax_mp (ax_mp nsLocal_weaken hw) hs) hr) hm he));
