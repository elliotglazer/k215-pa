theorem sfK0QSepTagged_input_substitution (E: set) (n r t b u y z K theta: nat)
 (hf: $ sfBound (suc n) theta $) (h0: $ u != 0 $)
 (hK: $ u < K $) (hzK: $ z < K $)
 (hr: $ r != u $) (ht: $ t != u $) (hb: $ b != u $)
 (hother: $ y != u $) (he: $ sqEnvAvoid E n u $):
 $ kSubst (sfK0QSepNamedTagged E r t b u y K theta) u z = sfK0QSepNamedTagged E r t b z y K theta $;

theorem sfK0QSepTagged_input_specialization (E: set) (n r t b u y z K theta: nat)
 (hf: $ sfBound (suc n) theta $) (h0: $ u != 0 $)
 (hK: $ u < K $) (hzK: $ z < K $)
 (hr: $ r != u $) (ht: $ t != u $) (hb: $ b != u $)
 (hother: $ y != u $) (he: $ sqEnvAvoid E n u $) (hz: $ u != z $):
 $ k218QProvable (kImp (kAll u (sfK0QSepNamedTagged E r t b u y K theta)) (sfK0QSepNamedTagged E r t b z y K theta)) $;

theorem sfK0QSepTagged_input_exists_intro (E: set) (n r t b u y z K theta: nat)
 (hf: $ sfBound (suc n) theta $) (h0: $ u != 0 $)
 (hK: $ u < K $) (hzK: $ z < K $)
 (hr: $ r != u $) (ht: $ t != u $) (hb: $ b != u $)
 (hother: $ y != u $) (he: $ sqEnvAvoid E n u $) (hz: $ u != z $):
 $ k218QProvable (kImp (sfK0QSepNamedTagged E r t b z y K theta) (kExists u (sfK0QSepNamedTagged E r t b u y K theta))) $;

def sfK0QSepTaggedRequest (E: set) (r t b c u y K theta: nat): nat = $ (kImp (kDisj (kEq u r) (kExists y (kAnd (kMem y c) (kAll K (kImp (kMem K u) (kMem K y)))))) (kImp (kExists y (kDisj (kAnd (kEq u r) (kEq y b)) (kDisj (kAnd (kEq u t) (kEq y t)) (kAnd (kAnd (kMem y u) (kAll K (kImp (kMem K u) (kEq K y)))) (kAnd (kMem y b) (sfNamedTemplate (sqEnvCons y E) K 0 theta)))))) (kExists y (kAnd (kMem y c) (kDisj (kAnd (kEq u r) (kEq y b)) (kDisj (kAnd (kEq u t) (kEq y t)) (kAnd (kAnd (kMem y u) (kAll K (kImp (kMem K u) (kEq K y)))) (kAnd (kMem y b) (sfNamedTemplate (sqEnvCons y E) K 0 theta))))))))) $;

