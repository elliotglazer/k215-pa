import "k218q_quotient_atom_laws.mm1";

@_ def k218QAGuardName (p: wff) (x: nat): nat = $ if p x 0 $;

@_ def k218QAGuardBase (p: wff) (k: nat): nat = $ if p k 1 $;

pub theorem k218QAGuardBase_positive (p: wff) (k: nat) (hk: $ p -> 0 < k $): $ 0 < k218QAGuardBase p k $ = '(cases (mpbird (lteq2d ifpos) hk) (mpbird (lteq2d ifneg) (a1i lt01S)));

pub theorem k218QAGuardName_below (p: wff) (k x: nat) (hx: $ p -> x < k $): $ k218QAGuardName p x < k218QAGuardBase p k $ = '(cases (mpbird (lteqd ifpos ifpos) hx) (mpbird (lteqd ifneg ifneg) (a1i lt01S)));

@_ def k218QASymLaw (k t x y: nat): nat = $ (kImp (k218QAEmpty t k) (kImp (sqEqual t x y k) (sqEqual t y x k))) $;

@_ def k218QASymBounds (k t x y: nat): wff = $ (0 < k /\ (t < k /\ (x < k /\ y < k))) $;

theorem k218QA_sym_guarded (k t x y: nat): $ k218QProvable (k218QASymLaw (k218QAGuardBase (k218QASymBounds k t x y) k) (k218QAGuardName (k218QASymBounds k t x y) t) (k218QAGuardName (k218QASymBounds k t x y) x) (k218QAGuardName (k218QASymBounds k t x y) y)) $ = '(k218QA_sym_proved (k218QAGuardBase_positive anl) (k218QAGuardName_below (syl anl anr)) (k218QAGuardName_below (syl (syl anl anr) anr)) (k218QAGuardName_below (syl (syl (syl id anr) anr) anr)));

pub theorem k218QA_sym_uniform (k t x y: nat): $ k218QASymBounds k t x y -> k218QProvable (k218QASymLaw k t x y) $ = '(mpbid (k218QProvableeqd (k218QASymLaweqd ifpos ifpos ifpos ifpos)) (a1i k218QA_sym_guarded));

@_ def k218QATransLaw (k t x y z: nat): nat = $ (kImp (k218QAEmpty t k) (kImp (sqEqual t x y k) (kImp (sqEqual t y z k) (sqEqual t x z k)))) $;

@_ def k218QATransBounds (k t x y z: nat): wff = $ (0 < k /\ (t < k /\ (x < k /\ (y < k /\ z < k)))) $;

theorem k218QA_trans_guarded (k t x y z: nat): $ k218QProvable (k218QATransLaw (k218QAGuardBase (k218QATransBounds k t x y z) k) (k218QAGuardName (k218QATransBounds k t x y z) t) (k218QAGuardName (k218QATransBounds k t x y z) x) (k218QAGuardName (k218QATransBounds k t x y z) y) (k218QAGuardName (k218QATransBounds k t x y z) z)) $ = '(k218QA_trans_proved (k218QAGuardBase_positive anl) (k218QAGuardName_below (syl anl anr)) (k218QAGuardName_below (syl (syl anl anr) anr)) (k218QAGuardName_below (syl (syl (syl anl anr) anr) anr)) (k218QAGuardName_below (syl (syl (syl (syl id anr) anr) anr) anr)));

pub theorem k218QA_trans_uniform (k t x y z: nat): $ k218QATransBounds k t x y z -> k218QProvable (k218QATransLaw k t x y z) $ = '(mpbid (k218QProvableeqd (k218QATransLaweqd ifpos ifpos ifpos ifpos ifpos)) (a1i k218QA_trans_guarded));

@_ def k218QAMemberLeftLaw (k t x xp y: nat): nat = $ (kImp (k218QAEmpty t k) (kImp (sqEqual t x xp k) (kImp (sqMember t x y k) (sqMember t xp y k)))) $;

@_ def k218QAMemberLeftBounds (k t x xp y: nat): wff = $ (0 < k /\ (t < k /\ (x < k /\ (xp < k /\ y < k)))) $;

theorem k218QA_member_left_guarded (k t x xp y: nat): $ k218QProvable (k218QAMemberLeftLaw (k218QAGuardBase (k218QAMemberLeftBounds k t x xp y) k) (k218QAGuardName (k218QAMemberLeftBounds k t x xp y) t) (k218QAGuardName (k218QAMemberLeftBounds k t x xp y) x) (k218QAGuardName (k218QAMemberLeftBounds k t x xp y) xp) (k218QAGuardName (k218QAMemberLeftBounds k t x xp y) y)) $ = '(k218QA_member_left_proved (k218QAGuardBase_positive anl) (k218QAGuardName_below (syl anl anr)) (k218QAGuardName_below (syl (syl anl anr) anr)) (k218QAGuardName_below (syl (syl (syl anl anr) anr) anr)) (k218QAGuardName_below (syl (syl (syl (syl id anr) anr) anr) anr)));

pub theorem k218QA_member_left_uniform (k t x xp y: nat): $ k218QAMemberLeftBounds k t x xp y -> k218QProvable (k218QAMemberLeftLaw k t x xp y) $ = '(mpbid (k218QProvableeqd (k218QAMemberLeftLaweqd ifpos ifpos ifpos ifpos ifpos)) (a1i k218QA_member_left_guarded));

@_ def k218QAMemberRightLaw (k t x y yp: nat): nat = $ (kImp (k218QAEmpty t k) (kImp (sqEqual t y yp k) (kImp (sqMember t x y k) (sqMember t x yp k)))) $;

@_ def k218QAMemberRightBounds (k t x y yp: nat): wff = $ (0 < k /\ (t < k /\ (x < k /\ (y < k /\ yp < k)))) $;

theorem k218QA_member_right_guarded (k t x y yp: nat): $ k218QProvable (k218QAMemberRightLaw (k218QAGuardBase (k218QAMemberRightBounds k t x y yp) k) (k218QAGuardName (k218QAMemberRightBounds k t x y yp) t) (k218QAGuardName (k218QAMemberRightBounds k t x y yp) x) (k218QAGuardName (k218QAMemberRightBounds k t x y yp) y) (k218QAGuardName (k218QAMemberRightBounds k t x y yp) yp)) $ = '(k218QA_member_right_proved (k218QAGuardBase_positive anl) (k218QAGuardName_below (syl anl anr)) (k218QAGuardName_below (syl (syl anl anr) anr)) (k218QAGuardName_below (syl (syl (syl anl anr) anr) anr)) (k218QAGuardName_below (syl (syl (syl (syl id anr) anr) anr) anr)));

pub theorem k218QA_member_right_uniform (k t x y yp: nat): $ k218QAMemberRightBounds k t x y yp -> k218QProvable (k218QAMemberRightLaw k t x y yp) $ = '(mpbid (k218QProvableeqd (k218QAMemberRightLaweqd ifpos ifpos ifpos ifpos ifpos)) (a1i k218QA_member_right_guarded));
