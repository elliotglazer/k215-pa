import "k218q_named_at_eigen.mm0";

theorem k218INamedAt_mono_imp (p q G a: nat):
 $ (p <= q) -> (k218INamedAt p G a) -> k218INamedAt q G a $;

theorem k218INamedAt_Ctx_imp (p G a: nat):
 $ (a IN G) -> k218INamedAt p G a $;

theorem k218INamedAt_II_imp (p G a b: nat):
 $ (k218INamedAt p (a : G) b) -> k218INamedAt p G (sfImp a b) $;

theorem k218INamedAt_Exp_imp (p G a: nat):
 $ (k218INamedAt p G sfBot) -> k218INamedAt p G a $;

theorem k218INamedAt_CE1_imp (p G a b: nat):
 $ (k218INamedAt p G (sfAnd a b)) -> k218INamedAt p G a $;

theorem k218INamedAt_CE2_imp (p G a b: nat):
 $ (k218INamedAt p G (sfAnd a b)) -> k218INamedAt p G b $;

theorem k218INamedAt_DI1_imp (p G a b: nat):
 $ (k218INamedAt p G a) -> k218INamedAt p G (sfOr a b) $;

theorem k218INamedAt_DI2_imp (p G a b: nat):
 $ (k218INamedAt p G b) -> k218INamedAt p G (sfOr a b) $;

theorem k218INamedAt_Wk_imp (p G J a: nat):
 $ (sfContextSub J G) -> (k218INamedAt p J a) -> k218INamedAt p G a $;

theorem k218INamedAt_IE_imp (p G a b: nat):
 $ (k218INamedAt p G a) -> (k218INamedAt p G (sfImp a b)) -> k218INamedAt p G b $;

theorem k218INamedAt_CI_imp (p G a b: nat):
 $ (k218INamedAt p G a) -> (k218INamedAt p G b) -> k218INamedAt p G (sfAnd a b) $;

theorem k218INamedAt_DE_imp (p G a b c: nat):
 $ (k218INamedAt p G (sfOr a b)) -> (k218INamedAt p (a : G) c) -> (k218INamedAt p (b : G) c) -> k218INamedAt p G c $;

theorem k218INamedAt_AllE_imp (p G i a: nat):
 $ (sfBound (suc p) a) -> (i < p) -> (k218INamedAt p G (sfAll a)) -> k218INamedAt p G (sfSubst 0 i a) $;

theorem k218INamedAt_ExI_imp (p G i a: nat):
 $ (sfBound (suc p) a) -> (i < p) -> (k218INamedAt p G (sfSubst 0 i a)) -> k218INamedAt p G (sfEx a) $;

theorem k218INamedAt_AllI_imp (p G a: nat):
 $ (sfContextWf G) -> (sqSourceBound p G) -> (sfBound p (sfAll a)) -> (k218INamedAt (suc p) (sfContextShift G) a) -> k218INamedAt p G (sfAll a) $;

theorem k218INamedAt_ExE_imp (p G a c: nat):
 $ (sfContextWf G) -> (sqSourceBound p G) -> (sfBound p (sfEx a)) -> (sfBound p c) -> (k218INamedAt p G (sfEx a)) -> (k218INamedAt (suc p) (a : sfContextShift G) (sfShift 0 c)) -> k218INamedAt p G c $;
