import "pa_proof_numeral_bounded_exists_at.mm0";

import "pa_proof_numeral_bounded_propositional.mm0";

def paProofNumeralExistsImplicationContrapositiveAnnotation (c t: nat): nat = $ paProofNumeralBoundedImpComposeAnnotation 0 (paFormulaImp (paFormulaImp (paFormulaAll (paFormulaImp c paFormulaFalse)) paFormulaFalse) paFormulaFalse) (paFormulaAll (paFormulaImp c paFormulaFalse)) (paFormulaImp (paFormulaSubst 0 t c) paFormulaFalse) (paProofNumeralBoundedDNEAnnotation 0 (paFormulaAll (paFormulaImp c paFormulaFalse))) (paProofAxiomAnnotation (paProofNumeralAllElimAxiomWitness (paFormulaImp c paFormulaFalse) t)) $;

def paProofNumeralExistsImplicationContrapositiveProof (c t: nat): nat = $ paProofNumeralBoundedImpComposeProof 0 (paFormulaImp (paFormulaImp (paFormulaAll (paFormulaImp c paFormulaFalse)) paFormulaFalse) paFormulaFalse) (paFormulaAll (paFormulaImp c paFormulaFalse)) (paFormulaImp (paFormulaSubst 0 t c) paFormulaFalse) (paProofNumeralBoundedDNEAnnotation 0 (paFormulaAll (paFormulaImp c paFormulaFalse))) (paProofAxiomAnnotation (paProofNumeralAllElimAxiomWitness (paFormulaImp c paFormulaFalse) t)) (paProofNumeralBoundedDNEProof 0 (paFormulaAll (paFormulaImp c paFormulaFalse))) (paProofNumeralAllElimAxiomProof 0 (paFormulaImp c paFormulaFalse) t) $;

theorem paProofNumeralExistsImplicationContrapositive_derives (c t: nat): $ paFormulaBound 1 c /\ paTermBound 0 t -> paProofDerives (paProofNumeralExistsImplicationContrapositiveProof c t) (paProofRow 0 (paFormulaImp (paFormulaImp (paFormulaImp (paFormulaAll (paFormulaImp c paFormulaFalse)) paFormulaFalse) paFormulaFalse) (paFormulaImp (paFormulaSubst 0 t c) paFormulaFalse)) (paProofNumeralExistsImplicationContrapositiveAnnotation c t)) $;

def paProofNumeralExistsImplicationNotAllAnnotation (c t: nat): nat = $ paProofNumeralBoundedMPAnnotation 0 (paFormulaImp (paFormulaImp (paFormulaImp (paFormulaAll (paFormulaImp c paFormulaFalse)) paFormulaFalse) paFormulaFalse) (paFormulaImp (paFormulaSubst 0 t c) paFormulaFalse)) (paFormulaImp (paFormulaSubst 0 t c) (paFormulaImp (paFormulaAll (paFormulaImp c paFormulaFalse)) paFormulaFalse)) (paProofNumeralExistsImplicationContrapositiveAnnotation c t) (paProofAxiomAnnotation (paProofNumeralBoundedProp3Witness 0 (paFormulaImp (paFormulaAll (paFormulaImp c paFormulaFalse)) paFormulaFalse) (paFormulaSubst 0 t c))) $;

def paProofNumeralExistsImplicationNotAllProof (c t: nat): nat = $ paProofNumeralBoundedMPProof 0 (paFormulaImp (paFormulaImp (paFormulaImp (paFormulaAll (paFormulaImp c paFormulaFalse)) paFormulaFalse) paFormulaFalse) (paFormulaImp (paFormulaSubst 0 t c) paFormulaFalse)) (paFormulaImp (paFormulaSubst 0 t c) (paFormulaImp (paFormulaAll (paFormulaImp c paFormulaFalse)) paFormulaFalse)) (paProofNumeralExistsImplicationContrapositiveAnnotation c t) (paProofAxiomAnnotation (paProofNumeralBoundedProp3Witness 0 (paFormulaImp (paFormulaAll (paFormulaImp c paFormulaFalse)) paFormulaFalse) (paFormulaSubst 0 t c))) (paProofNumeralExistsImplicationContrapositiveProof c t) (paProofNumeralBoundedProp3Proof 0 (paFormulaImp (paFormulaAll (paFormulaImp c paFormulaFalse)) paFormulaFalse) (paFormulaSubst 0 t c)) $;

theorem paProofNumeralExistsImplicationNotAll_derives (c t: nat): $ paFormulaBound 1 c /\ paTermBound 0 t -> paProofDerives (paProofNumeralExistsImplicationNotAllProof c t) (paProofRow 0 (paFormulaImp (paFormulaSubst 0 t c) (paFormulaImp (paFormulaAll (paFormulaImp c paFormulaFalse)) paFormulaFalse)) (paProofNumeralExistsImplicationNotAllAnnotation c t)) $;

def paProofNumeralExistsImplicationAnnotation (c t: nat): nat = $ paProofNumeralBoundedImpComposeAnnotation 0 (paFormulaSubst 0 t c) (paFormulaImp (paFormulaAll (paFormulaImp c paFormulaFalse)) paFormulaFalse) (paFormulaEx c) (paProofNumeralExistsImplicationNotAllAnnotation c t) (paProofAxiomAnnotation (paProofNumeralBoundedExistsAtDualWitness 0 c)) $;

def paProofNumeralExistsImplicationProof (c t: nat): nat = $ paProofNumeralBoundedImpComposeProof 0 (paFormulaSubst 0 t c) (paFormulaImp (paFormulaAll (paFormulaImp c paFormulaFalse)) paFormulaFalse) (paFormulaEx c) (paProofNumeralExistsImplicationNotAllAnnotation c t) (paProofAxiomAnnotation (paProofNumeralBoundedExistsAtDualWitness 0 c)) (paProofNumeralExistsImplicationNotAllProof c t) (paProofNumeralBoundedExistsAtDualProof 0 c) $;

theorem paProofNumeralExistsImplication_derives (c t: nat): $ paFormulaBound 1 c /\ paTermBound 0 t -> paProofDerives (paProofNumeralExistsImplicationProof c t) (paProofRow 0 (paFormulaImp (paFormulaSubst 0 t c) (paFormulaEx c)) (paProofNumeralExistsImplicationAnnotation c t)) $;
