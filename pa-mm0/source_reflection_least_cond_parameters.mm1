def sfLeastOrdinalParametersRawLaw(phi:nat):nat = $ (lopF236 phi) $;

pub theorem sfLeastOrdinalParameters_nd(phi:nat)(hf:$ sfWf phi $): $ nsLocal (sfLeastOrdinalParametersContext phi) (sfLeastOrdinalParametersRawLaw phi) $ = (named '(lopP994 hf));

pub theorem sfLeastOrdinalParameters_literal(phi:nat)(hf:$ sfWf phi $): $ sfLeastOrdinalParametersRawLaw phi = sfLeastOrdinalLaw phi $ = (named '(lopLiteral996 hf));

pub theorem sfLeastOrdinalParametersContext_proved(n phi:nat)(hb:$ sfBound (suc n) phi $): $ all (sfTheoryProofClass zfrAxioms) (sfLeastOrdinalParametersContext phi) $ = (named '(mpbir allS (ian (mpbir sfTheoryProofClass_value (mpbir (trud (sfTheoryProvable_congr (a1i (lopSep995 (ax_mp sfBound_wf hb))))) (ax_mp (ax_mp sfTheoryProvable_prefix_elim zfrAxioms_closed) (ax_mp (ax_mp sfTheoryAxiom_provable_closed zfrAxioms_closed) (ax_mp zfrSeparationCode_member hb))))) (mpbir allS (ian (mpbir sfTheoryProofClass_value sfLeastOrdinalSuccessorLaw_zfr) (mpbir allS (ian (mpbir sfTheoryProofClass_value sfLeastOrdinalMemberLaw_zfr) (mpbir allS (ian (mpbir sfTheoryProofClass_value sfLeastOrdinalRegularLaw_zfr) all0)))))))));

pub theorem sfLeastOrdinalParameters_zfr_meta(n phi:nat)(hb:$ sfBound (suc n) phi $): $ sfTheoryProvable zfrAxioms (sfLeastOrdinalLaw phi) $ = (named '(mpbi (trud (sfTheoryProvable_congr (a1i (sfLeastOrdinalParameters_literal (ax_mp sfBound_wf hb))))) (ax_mp (ax_mp (sfTheory_lemma_context zfrAxioms_closed) (sfLeastOrdinalParametersContext_proved hb)) (sfLeastOrdinalParameters_nd (ax_mp sfBound_wf hb)))));

do { (add-eqd-thm 'sfLeastOrdinalLaw 'lopLawCong) };
theorem lopSafe_bound(P:wff)(n phi:nat)(hp:$ P -> sfBound n phi $): $ sfBound n (if P phi sfBot) $ = '(cases (mpbird (srecpeq2d (preq2d ifpos)) hp) (mpbird (srecpeq2d (preq2d ifneg)) (a1i sfBound_bot)));
theorem lopSafe_theorem(n phi:nat): $ sfTheoryProvable zfrAxioms (sfLeastOrdinalLaw (if (sfBound (suc n) phi) phi sfBot)) $ = '(sfLeastOrdinalParameters_zfr_meta (lopSafe_bound id));

pub theorem sfLeastOrdinalParameters_zfr(n phi:nat): $ sfBound (suc n) phi -> sfTheoryProvable zfrAxioms (sfLeastOrdinalLaw phi) $ = (named '(mpbid (sfTheoryProvable_congr (lopLawCongeqd ifpos)) (a1i lopSafe_theorem)));

pub theorem sfLeastOrdinalParameters_all_zfr(n phi:nat): $ sfBound (suc n) phi -> sfTheoryProvable zfrAxioms (sfAllPrefix n (sfLeastOrdinalLaw phi)) $ = (named '(syl (ax_mp sfTheoryProvable_prefix_intro zfrAxioms_closed) sfLeastOrdinalParameters_zfr));
