import "source_k0_qrep_invariance.mm1";

theorem qrepReverseTransport_input_d (G: wff) (E: set) (n t k x xp y phi: nat) (h0: $ G -> sfBound (suc (suc n)) phi $) (h1: $ G -> 0 < k $) (h2: $ G -> t < k $) (h3: $ G -> x < k $) (h4: $ G -> xp < k $) (h5: $ G -> y < k $) (h6: $ G -> sqEnvBelow E n k $):
 $ G -> k218QProvable (kImp (k218QAEmpty t k) (kImp (sqEqual t x xp k) (kImp (sqQuote (sqEnvCons xp (sqEnvCons y E)) t k 0 phi) (sqQuote (sqEnvCons x (sqEnvCons y E)) t k 0 phi)))) $ =
'(syl k218IHypProvable_empty (syl k218IHypProvable_deduction (syl k218IHypProvable_deduction (syl anr (! sfK0QRep_invariance_d $ G $ $ E $ $ ((sqEqual t x xp k) : ((k218QAEmpty t k) : 0)) $ $ n $ $ t $ $ k $ $ x $ $ xp $ $ y $ $ y $ $ phi $ h0 h1 h2 h3 h4 h5 h5 h6 (a1i (ax_mp k218IHypProvable_assumption (mpbir lmemS (orr lmemconsid)))) (a1i (orr (ax_mp k218IHypProvable_assumption lmemconsid))) (a1i (orl eqid)))))));

pub theorem sfK0QRep_input_transport_reverse (E: set) (n t k x xp y phi: nat):
 $ sfBound (suc (suc n)) phi -> 0 < k -> t < k -> x < k -> xp < k -> y < k -> sqEnvBelow E n k -> k218QProvable (kImp (k218QAEmpty t k) (kImp (sqEqual t x xp k) (kImp (sqQuote (sqEnvCons xp (sqEnvCons y E)) t k 0 phi) (sqQuote (sqEnvCons x (sqEnvCons y E)) t k 0 phi)))) $ =
(named '(exp @ exp @ exp @ exp @ exp @ exp @ qrepReverseTransport_input_d (syl (syl (syl (syl (syl (syl id anl) anl) anl) anl) anl) anl) (syl (syl (syl (syl (syl anr anl) anl) anl) anl) anl) (syl (syl (syl (syl anr anl) anl) anl) anl) (syl (syl (syl anr anl) anl) anl) (syl (syl anr anl) anl) (syl anr anl) anr));

theorem qrepReverseTransport_output_d (G: wff) (E: set) (n t k x y yp phi: nat) (h0: $ G -> sfBound (suc (suc n)) phi $) (h1: $ G -> 0 < k $) (h2: $ G -> t < k $) (h3: $ G -> x < k $) (h4: $ G -> y < k $) (h5: $ G -> yp < k $) (h6: $ G -> sqEnvBelow E n k $):
 $ G -> k218QProvable (kImp (k218QAEmpty t k) (kImp (sqEqual t y yp k) (kImp (sqQuote (sqEnvCons x (sqEnvCons yp E)) t k 0 phi) (sqQuote (sqEnvCons x (sqEnvCons y E)) t k 0 phi)))) $ =
'(syl k218IHypProvable_empty (syl k218IHypProvable_deduction (syl k218IHypProvable_deduction (syl anr (! sfK0QRep_invariance_d $ G $ $ E $ $ ((sqEqual t y yp k) : ((k218QAEmpty t k) : 0)) $ $ n $ $ t $ $ k $ $ x $ $ x $ $ y $ $ yp $ $ phi $ h0 h1 h2 h3 h3 h4 h5 h6 (a1i (ax_mp k218IHypProvable_assumption (mpbir lmemS (orr lmemconsid)))) (a1i (orl eqid)) (a1i (orr (ax_mp k218IHypProvable_assumption lmemconsid))))))));

pub theorem sfK0QRep_output_transport_reverse (E: set) (n t k x y yp phi: nat):
 $ sfBound (suc (suc n)) phi -> 0 < k -> t < k -> x < k -> y < k -> yp < k -> sqEnvBelow E n k -> k218QProvable (kImp (k218QAEmpty t k) (kImp (sqEqual t y yp k) (kImp (sqQuote (sqEnvCons x (sqEnvCons yp E)) t k 0 phi) (sqQuote (sqEnvCons x (sqEnvCons y E)) t k 0 phi)))) $ =
(named '(exp @ exp @ exp @ exp @ exp @ exp @ qrepReverseTransport_output_d (syl (syl (syl (syl (syl (syl id anl) anl) anl) anl) anl) anl) (syl (syl (syl (syl (syl anr anl) anl) anl) anl) anl) (syl (syl (syl (syl anr anl) anl) anl) anl) (syl (syl (syl anr anl) anl) anl) (syl (syl anr anl) anl) (syl anr anl) anr));
