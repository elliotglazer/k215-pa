import "quotient_quotation.mm1";

@_ abstract def sqEnvAgree (E F: set) (n .i: nat): wff = $ A. i (i < n -> E @ i = F @ i) $;
pub theorem sqEnvAgree_at (E F: set) (n i: nat):
  $ sqEnvAgree E F n -> i < n -> E @ i = F @ i $ =
(named '(!! eale j ,eqtac));

pub theorem sqEnvAgree_zero (E F: set): $ sqEnvAgree E F 0 $ =
(named '(ax_gen @ ax_mp absurd lt02));

theorem sqEnvIndex_below (E F: set) (G: wff) (k d i: nat)
  (hi: $ G -> i < d $):
  $ G -> sfNamedIndex E k d i = sfNamedIndex F k d i $ =
'(eqtrd (syl sfNamedIndex_bound hi) (eqcomd (syl sfNamedIndex_bound hi)));

theorem sqEnvIndex_above (E F: set) (G: wff) (k d n i: nat)
  (he: $ G -> sqEnvAgree E F n $) (hb: $ G -> i < d + n $)
  (hi: $ G -> ~i < d $):
  $ G -> sfNamedIndex E k d i = sfNamedIndex F k d i $ =
'(eqtrd (syl sfNamedIndex_free hi) @
  eqtrd (mpd (mpbird (syl ltsubadd2 (syl (bi2 lenlt) hi)) hb)
    (syl sqEnvAgree_at he)) (eqcomd (syl sfNamedIndex_free hi)));

pub theorem sqEnvAgree_index (E F: set) (k d n i: nat):
  $ sqEnvAgree E F n -> i < d + n ->
    sfNamedIndex E k d i = sfNamedIndex F k d i $ =
'(exp @ casesda (sqEnvIndex_below anr)
  (sqEnvIndex_above (syl anl anl) (syl anr anl) anr));

@_ abstract def ntEnvClass (E F: set) (k n: nat) (.c .d: nat): set =
$ {c | A. d (sfBound (d + n) c -> sfNamedTemplate E k d c = sfNamedTemplate F k d c)} $;
pub theorem ntEnv_value {d: nat} (E F: set) (k n: nat) (c: nat):
  $ c e. ntEnvClass E F k n <-> A. d (sfBound (d + n) c -> sfNamedTemplate E k d c = sfNamedTemplate F k d c) $ =
(named '(elabe ,eqtac));

theorem ntEnv_depth (E F: set) (k n: nat) (d c: nat):
  $ A. j (sfBound (j + n) c -> sfNamedTemplate E k j c = sfNamedTemplate F k j c) ->
    sfBound (d + n) c -> sfNamedTemplate E k d c = sfNamedTemplate F k d c $ =
(named '(!! eale j ,eqtac));

theorem ntEnv_at (E F: set) (k n: nat) (d c: nat):
  $ c e. ntEnvClass E F k n -> sfBound (d + n) c -> sfNamedTemplate E k d c = sfNamedTemplate F k d c $ =
(named '(syl ntEnv_depth {(bi1 ntEnv_value) :
  $ c e. ntEnvClass E F k n -> A. j (sfBound (j + n) c -> sfNamedTemplate E k j c = sfNamedTemplate F k j c) $}));

theorem ntEnv_bot (E F: set) (k n: nat): $ sfBot e. ntEnvClass E F k n $ =
(named '(mpbir ntEnv_value @ ax_gen @ a1i @ eqtr sfNamedTemplate_bot (eqcom sfNamedTemplate_bot)));

theorem ntEnv_mem (E F: set) (k n: nat) (a b: nat) (he: $ sqEnvAgree E F n $):
  $ sfMem a b e. ntEnvClass E F k n $ =
(named '(mpbir ntEnv_value @ ax_gen @
  eqtrd (a1i sfNamedTemplate_sfMem) (eqtrd (kMemeqd
    (mpd (syl anl (bi1 sfBound_sfMem)) (a1i (ax_mp sqEnvAgree_index he)))
    (mpd (syl anr (bi1 sfBound_sfMem)) (a1i (ax_mp sqEnvAgree_index he)))) (a1i (eqcom sfNamedTemplate_sfMem)))));

theorem ntEnv_eq (E F: set) (k n: nat) (a b: nat) (he: $ sqEnvAgree E F n $):
  $ sfEq a b e. ntEnvClass E F k n $ =
(named '(mpbir ntEnv_value @ ax_gen @
  eqtrd (a1i sfNamedTemplate_sfEq) (eqtrd (kEqeqd
    (mpd (syl anl (bi1 sfBound_sfEq)) (a1i (ax_mp sqEnvAgree_index he)))
    (mpd (syl anr (bi1 sfBound_sfEq)) (a1i (ax_mp sqEnvAgree_index he)))) (a1i (eqcom sfNamedTemplate_sfEq)))));

theorem ntEnv_atomic (E F: set) (k n: nat) (he: $ sqEnvAgree E F n $):
  $ sfAtomicClosed (ntEnvClass E F k n) $ =
(named '(ax_gen @ ax_gen @ ian (ntEnv_mem he) (ntEnv_eq he)));

theorem ntEnv_and (E F: set) (k n: nat) (a b: nat):
  $ a e. ntEnvClass E F k n /\ b e. ntEnvClass E F k n -> sfAnd a b e. ntEnvClass E F k n $ =
(named '(mpbird (a1i ntEnv_value) @ !! iald d @ exp @
  eqtrd (a1i sfNamedTemplate_sfAnd)
    (eqtrd (kAndeqd (mpd (syl anl (syl (bi1 sfBound_sfAnd) anr)) (syl ntEnv_at (syl anl anl))) (mpd (syl anr (syl (bi1 sfBound_sfAnd) anr)) (syl ntEnv_at (syl anr anl)))) (a1i (eqcom sfNamedTemplate_sfAnd)))));

theorem ntEnv_or (E F: set) (k n: nat) (a b: nat):
  $ a e. ntEnvClass E F k n /\ b e. ntEnvClass E F k n -> sfOr a b e. ntEnvClass E F k n $ =
(named '(mpbird (a1i ntEnv_value) @ !! iald d @ exp @
  eqtrd (a1i sfNamedTemplate_sfOr)
    (eqtrd (kDisjeqd (mpd (syl anl (syl (bi1 sfBound_sfOr) anr)) (syl ntEnv_at (syl anl anl))) (mpd (syl anr (syl (bi1 sfBound_sfOr) anr)) (syl ntEnv_at (syl anr anl)))) (a1i (eqcom sfNamedTemplate_sfOr)))));

theorem ntEnv_imp (E F: set) (k n: nat) (a b: nat):
  $ a e. ntEnvClass E F k n /\ b e. ntEnvClass E F k n -> sfImp a b e. ntEnvClass E F k n $ =
(named '(mpbird (a1i ntEnv_value) @ !! iald d @ exp @
  eqtrd (a1i sfNamedTemplate_sfImp)
    (eqtrd (kImpeqd (mpd (syl anl (syl (bi1 sfBound_sfImp) anr)) (syl ntEnv_at (syl anl anl))) (mpd (syl anr (syl (bi1 sfBound_sfImp) anr)) (syl ntEnv_at (syl anr anl)))) (a1i (eqcom sfNamedTemplate_sfImp)))));

theorem ntEnv_binary (E F: set) (k n: nat): $ sfBinaryClosed (ntEnvClass E F k n) $ =
(named '(ax_gen @ ax_gen @ iand (iand ntEnv_and ntEnv_or) ntEnv_imp));

theorem ntEnv_all (E F: set) (k n: nat) (a: nat):
  $ a e. ntEnvClass E F k n -> sfAll a e. ntEnvClass E F k n $ =
(named '(mpbird (a1i ntEnv_value) @ !! iald d @ exp @
  eqtrd (a1i sfNamedTemplate_sfAll) (eqtrd (kAlleqd eqidd (mpd (mpbird (a1i (srecpeq2 (preq1 addS1))) (syl (bi1 sfBound_sfAll) anr)) (syl ntEnv_at anl))) (a1i (eqcom sfNamedTemplate_sfAll)))));

theorem ntEnv_ex (E F: set) (k n: nat) (a: nat):
  $ a e. ntEnvClass E F k n -> sfEx a e. ntEnvClass E F k n $ =
(named '(mpbird (a1i ntEnv_value) @ !! iald d @ exp @
  eqtrd (a1i sfNamedTemplate_sfEx) (eqtrd (kExistseqd eqidd (mpd (mpbird (a1i (srecpeq2 (preq1 addS1))) (syl (bi1 sfBound_sfEx) anr)) (syl ntEnv_at anl))) (a1i (eqcom sfNamedTemplate_sfEx)))));

theorem ntEnv_quantifier (E F: set) (k n: nat): $ sfQuantifierClosed (ntEnvClass E F k n) $ =
(named '(ax_gen @ iand ntEnv_all ntEnv_ex));

theorem ntEnv_closed (E F: set) (k n: nat) (he: $ sqEnvAgree E F n $):
  $ sfConstructionClosed (ntEnvClass E F k n) $ =
'(ian (ian (ian ntEnv_bot (ntEnv_atomic he)) ntEnv_binary) ntEnv_quantifier);

pub theorem sfNamedTemplate_environment (E F: set) (k n: nat) (d c: nat) (he: $ sqEnvAgree E F n $):
  $ sfBound (d + n) c -> sfNamedTemplate E k d c = sfNamedTemplate F k d c $ =
'(mpd id (syl ntEnv_at (syl (ax_mp sfWf_induction (ntEnv_closed he)) sfBound_wf)));

pub theorem sfNamedTemplate_environment_closed (E F: set) (k: nat) (c: nat):
  $ sfBound 0 c -> sfNamedTemplate E k 0 c = sfNamedTemplate F k 0 c $ =
(named '(syl {(sfNamedTemplate_environment sqEnvAgree_zero) :
  $ sfBound (0 + 0) c -> sfNamedTemplate E k 0 c = sfNamedTemplate F k 0 c $}
  (bi2 (srecpeq2 (preq1 add01)))));

@_ abstract def qqEnvClass (E F: set) (t k n: nat) (.c .d: nat): set =
$ {c | A. d (sfBound (d + n) c -> sqQuote E t k d c = sqQuote F t k d c)} $;
pub theorem qqEnv_value {d: nat} (E F: set) (t k n: nat) (c: nat):
  $ c e. qqEnvClass E F t k n <-> A. d (sfBound (d + n) c -> sqQuote E t k d c = sqQuote F t k d c) $ =
(named '(elabe ,eqtac));

theorem qqEnv_depth (E F: set) (t k n: nat) (d c: nat):
  $ A. j (sfBound (j + n) c -> sqQuote E t k j c = sqQuote F t k j c) ->
    sfBound (d + n) c -> sqQuote E t k d c = sqQuote F t k d c $ =
(named '(!! eale j ,eqtac));

theorem qqEnv_at (E F: set) (t k n: nat) (d c: nat):
  $ c e. qqEnvClass E F t k n -> sfBound (d + n) c -> sqQuote E t k d c = sqQuote F t k d c $ =
(named '(syl qqEnv_depth {(bi1 qqEnv_value) :
  $ c e. qqEnvClass E F t k n -> A. j (sfBound (j + n) c -> sqQuote E t k j c = sqQuote F t k j c) $}));

theorem qqEnv_bot (E F: set) (t k n: nat): $ sfBot e. qqEnvClass E F t k n $ =
(named '(mpbir qqEnv_value @ ax_gen @ a1i @ eqtr sqQuote_bot (eqcom sqQuote_bot)));

theorem qqEnv_mem (E F: set) (t k n: nat) (a b: nat) (he: $ sqEnvAgree E F n $):
  $ sfMem a b e. qqEnvClass E F t k n $ =
(named '(mpbir qqEnv_value @ ax_gen @
  eqtrd (a1i sqQuote_sfMem) (eqtrd (sqMembereqd eqidd
    (mpd (syl anl (syl (bi1 sfBound_sfMem) id)) (a1i (ax_mp sqEnvAgree_index he)))
    (mpd (syl anr (syl (bi1 sfBound_sfMem) id)) (a1i (ax_mp sqEnvAgree_index he))) eqidd) (a1i (eqcom sqQuote_sfMem)))));

theorem qqEnv_eq (E F: set) (t k n: nat) (a b: nat) (he: $ sqEnvAgree E F n $):
  $ sfEq a b e. qqEnvClass E F t k n $ =
(named '(mpbir qqEnv_value @ ax_gen @
  eqtrd (a1i sqQuote_sfEq) (eqtrd (sqEqualeqd eqidd
    (mpd (syl anl (syl (bi1 sfBound_sfEq) id)) (a1i (ax_mp sqEnvAgree_index he)))
    (mpd (syl anr (syl (bi1 sfBound_sfEq) id)) (a1i (ax_mp sqEnvAgree_index he))) eqidd) (a1i (eqcom sqQuote_sfEq)))));

theorem qqEnv_atomic (E F: set) (t k n: nat) (he: $ sqEnvAgree E F n $):
  $ sfAtomicClosed (qqEnvClass E F t k n) $ =
(named '(ax_gen @ ax_gen @ ian (qqEnv_mem he) (qqEnv_eq he)));

theorem qqEnv_and (E F: set) (t k n: nat) (a b: nat):
  $ a e. qqEnvClass E F t k n /\ b e. qqEnvClass E F t k n -> sfAnd a b e. qqEnvClass E F t k n $ =
(named '(mpbird (a1i qqEnv_value) @ !! iald d @ exp @
  eqtrd (a1i sqQuote_sfAnd)
    (eqtrd (kAndeqd (mpd (syl anl (syl (bi1 sfBound_sfAnd) anr)) (syl qqEnv_at (syl anl anl))) (mpd (syl anr (syl (bi1 sfBound_sfAnd) anr)) (syl qqEnv_at (syl anr anl)))) (a1i (eqcom sqQuote_sfAnd)))));

theorem qqEnv_or (E F: set) (t k n: nat) (a b: nat):
  $ a e. qqEnvClass E F t k n /\ b e. qqEnvClass E F t k n -> sfOr a b e. qqEnvClass E F t k n $ =
(named '(mpbird (a1i qqEnv_value) @ !! iald d @ exp @
  eqtrd (a1i sqQuote_sfOr)
    (eqtrd (kDisjeqd (mpd (syl anl (syl (bi1 sfBound_sfOr) anr)) (syl qqEnv_at (syl anl anl))) (mpd (syl anr (syl (bi1 sfBound_sfOr) anr)) (syl qqEnv_at (syl anr anl)))) (a1i (eqcom sqQuote_sfOr)))));

theorem qqEnv_imp (E F: set) (t k n: nat) (a b: nat):
  $ a e. qqEnvClass E F t k n /\ b e. qqEnvClass E F t k n -> sfImp a b e. qqEnvClass E F t k n $ =
(named '(mpbird (a1i qqEnv_value) @ !! iald d @ exp @
  eqtrd (a1i sqQuote_sfImp)
    (eqtrd (kImpeqd (mpd (syl anl (syl (bi1 sfBound_sfImp) anr)) (syl qqEnv_at (syl anl anl))) (mpd (syl anr (syl (bi1 sfBound_sfImp) anr)) (syl qqEnv_at (syl anr anl)))) (a1i (eqcom sqQuote_sfImp)))));

theorem qqEnv_binary (E F: set) (t k n: nat): $ sfBinaryClosed (qqEnvClass E F t k n) $ =
(named '(ax_gen @ ax_gen @ iand (iand qqEnv_and qqEnv_or) qqEnv_imp));

theorem qqEnv_all (E F: set) (t k n: nat) (a: nat):
  $ a e. qqEnvClass E F t k n -> sfAll a e. qqEnvClass E F t k n $ =
(named '(mpbird (a1i qqEnv_value) @ !! iald d @ exp @
  eqtrd (a1i sqQuote_sfAll) (eqtrd (kAlleqd eqidd (kImpeqd eqidd (mpd (mpbird (a1i (srecpeq2 (preq1 addS1))) (syl (bi1 sfBound_sfAll) anr)) (syl qqEnv_at anl)))) (a1i (eqcom sqQuote_sfAll)))));

theorem qqEnv_ex (E F: set) (t k n: nat) (a: nat):
  $ a e. qqEnvClass E F t k n -> sfEx a e. qqEnvClass E F t k n $ =
(named '(mpbird (a1i qqEnv_value) @ !! iald d @ exp @
  eqtrd (a1i sqQuote_sfEx) (eqtrd (kExistseqd eqidd (kAndeqd eqidd (mpd (mpbird (a1i (srecpeq2 (preq1 addS1))) (syl (bi1 sfBound_sfEx) anr)) (syl qqEnv_at anl)))) (a1i (eqcom sqQuote_sfEx)))));

theorem qqEnv_quantifier (E F: set) (t k n: nat): $ sfQuantifierClosed (qqEnvClass E F t k n) $ =
(named '(ax_gen @ iand qqEnv_all qqEnv_ex));

theorem qqEnv_closed (E F: set) (t k n: nat) (he: $ sqEnvAgree E F n $):
  $ sfConstructionClosed (qqEnvClass E F t k n) $ =
'(ian (ian (ian qqEnv_bot (qqEnv_atomic he)) qqEnv_binary) qqEnv_quantifier);

pub theorem sqQuote_environment (E F: set) (t k n: nat) (d c: nat) (he: $ sqEnvAgree E F n $):
  $ sfBound (d + n) c -> sqQuote E t k d c = sqQuote F t k d c $ =
'(mpd id (syl qqEnv_at (syl (ax_mp sfWf_induction (qqEnv_closed he)) sfBound_wf)));

pub theorem sqQuote_environment_closed (E F: set) (t k: nat) (c: nat):
  $ sfBound 0 c -> sqQuote E t k 0 c = sqQuote F t k 0 c $ =
(named '(syl {(sqQuote_environment sqEnvAgree_zero) :
  $ sfBound (0 + 0) c -> sqQuote E t k 0 c = sqQuote F t k 0 c $}
  (bi2 (srecpeq2 (preq1 add01)))));

