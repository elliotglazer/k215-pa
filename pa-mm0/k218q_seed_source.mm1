import "k218q_seed_outer.mm1";


theorem k218SF_and_commute (p q: nat):
 $ k218IEquivalent (kAnd p q) (kAnd q p) $ =
'(ian
  (k218QProvable_mp k218IPropAndLeft
    (k218QProvable_mp (k218IProvable_syl k218IPropAndRight k218IPropAndIntro) k218IPropS))
  (k218QProvable_mp k218IPropAndLeft
    (k218QProvable_mp (k218IProvable_syl k218IPropAndRight k218IPropAndIntro) k218IPropS)));

theorem k218SF_root_matrix {i j: nat} (E: set) (n B f: nat)
 (hB: $ 3 < B $) (he: $ A. j (j < n -> E @ j < B) $)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218IEquivalent (sfNamedTemplate (sqEnvCons (suc (suc (k218SourceSeedBase E B f))) (sqEnvCons (k218SourceSeedBase E B f) E)) (k218SourceMatrixBase E B f) 0 f) (sfNamedTemplate (sqEnvCons (suc (suc (k218SourceSeedBase E B f))) (sqEnvCons (k218SourceSeedBase E B f) E)) (suc (suc (suc (k218SourceSeedBase E B f)))) 0 f) $ =
(named '(k218QMatrix_pair_rebase hf (sqRebaseHygiene_below (lttr (lttr lt01S hB) (lttr k218PS_B_lt_C (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr k218SO_order2 k218SO_order3) k218SO_order4) k218SO_order5) k218SO_order6) k218SO_order7) k218SO_order8) k218SO_order9) k218SO_order10))) {(k218CRB_env_mono (lttr k218PS_B_lt_C (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr k218SO_order2 k218SO_order3) k218SO_order4) k218SO_order5) k218SO_order6) k218SO_order7) k218SO_order8) k218SO_order9) k218SO_order10)) he) : $ A. i (i < n -> E @ i < (k218SourceMatrixBase E B f)) $}) (sqRebaseHygiene_below (lttr (lttr lt01S hB) (lttr k218PS_B_lt_C (lttr (lttr (lttr k218SO_order2 k218SO_order3) k218SO_order4) k218SO_order5))) {(k218CRB_env_mono (lttr k218PS_B_lt_C (lttr (lttr (lttr k218SO_order2 k218SO_order3) k218SO_order4) k218SO_order5)) he) : $ A. i (i < n -> E @ i < (suc (suc (suc (k218SourceSeedBase E B f))))) $}) (sqAllocAvoid_below (lttr (lttr (lttr (lttr (lttr k218SO_order5 k218SO_order6) k218SO_order7) k218SO_order8) k218SO_order9) k218SO_order10)) (sqAllocAvoid_below (lttr (lttr (lttr (lttr (lttr (lttr (lttr k218SO_order3 k218SO_order4) k218SO_order5) k218SO_order6) k218SO_order7) k218SO_order8) k218SO_order9) k218SO_order10)) (sqAllocAvoid_below k218SO_order5) (sqAllocAvoid_below (lttr (lttr k218SO_order3 k218SO_order4) k218SO_order5))));

pub theorem k218QSeedOuter_to_named_source {i j: nat} (E: set) (n B f: nat)
 (hB: $ 3 < B $) (he1: $ sqEnvAvoid E n 1 $) (he3: $ sqEnvAvoid E n 3 $)
 (he: $ A. j (j < n -> E @ j < B) $)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218IEquivalent (k218SourceOuterSeed E n B f)
     (k218NamedSeededCore E (k218SourceSeedBase E B f) f) $ =
(named '(ax_mp k218IEquivalent_all (ax_mp k218IEquivalent_exists (ax_mp k218IEquivalent_trans (ian (ax_mp k218IEquivalent_and (ian k218IEquivalent_refl (ax_mp k218IEquivalent_imp (ian (ax_mp k218IEquivalent_exists (!! k218SF_root_matrix i j hB he hf)) (ax_mp k218IEquivalent_exists (ax_mp k218IEquivalent_trans (ian (ax_mp k218IEquivalent_and (ian (!! k218SF_root_matrix i j hB he hf) k218IEquivalent_refl)) k218SF_and_commute))))))) k218SF_and_commute)))));

pub theorem k218QNamedSeededCore {i j: nat} (E: set) (n B f: nat)
 (hB: $ 3 < B $) (he1: $ sqEnvAvoid E n 1 $) (he3: $ sqEnvAvoid E n 3 $)
 (he: $ A. j (j < n -> E @ j < B) $)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218QProvable (k218NamedSeededCore E (k218SourceSeedBase E B f) f) $ =
(named '(ax_mp (ax_mp k218QProvable_mp
    (ax_mp (ax_mp k218QProvable_mp
      (!! k218QSourcePreparedSeed_provable i j hB he1 he3 he hf))
      (ax_mp anl (!! k218QSourceSeed_outer j hB he1 he3 he hf))))
  (ax_mp anl (!! k218QSeedOuter_to_named_source i j hB he1 he3 he hf))));

pub theorem k218QSourceSeededCore {i j: nat} (E: set) (n B f: nat)
 (hB: $ 3 < B $) (he1: $ sqEnvAvoid E n 1 $) (he3: $ sqEnvAvoid E n 3 $)
 (he: $ A. j (j < n -> E @ j < B) $)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218QProvable (sfNamedTemplate E (k218SourceSeedBase E B f) 0 (sfK218SeededCore f)) $ =
(named '(mpbir
  (k218QProvableeq (k218NamedSeededCore_source (ax_mp sfBound_wf hf)))
  (!! k218QNamedSeededCore i j hB he1 he3 he hf)));
