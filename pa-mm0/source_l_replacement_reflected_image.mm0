import "source_l_replacement_witness.mm0";

import "source_l_separation_image_reflection.mm0";

import "source_l_common_level_point_rules.mm0";

import "source_piece_conjunction_proofs.mm0";

def sfLReplacementStartMap(start:nat)(.i:nat):set = $ \ i, i + start $;

theorem sfLReplacementStartMap_at(start i:nat):
 $ sfLReplacementStartMap start @ i = i + start $;

theorem sfLReplacementRows_from_membership(G start Y n:nat)
 (hm:$ nsLocal G (sfCLMembership start Y n) $):
 $ sfCLRowProofs (sfCLBallMemberRows (sfLReplacementStartMap start) Y) G n $;

theorem sfLReplacementRows_from_point(G start n beta Y:nat)
 (hp:$ nsLocal G (sfCLPoint start n beta Y) $):
 $ sfCLRowProofs (sfCLBallMemberRows (sfLReplacementStartMap start) Y) G n $;

theorem sfLReplacementComparison_from_reflected_point(G start n psi beta Y:nat)
 (hb:$ sfBound (suc n) psi $)
 (hp:$ nsLocal G (sfCLReflectedPoint start n (suc n) psi beta Y) $):
 $ nsLocal G (sfLSeparationImageComparison (sfLReplacementStartMap start) sfLDomain psi Y) $;

theorem sfLReplacementWitness_from_reflected_point(G start n psi beta Y:nat)
 (hb:$ sfBound (suc n) psi $)
 (hp:$ nsLocal G (sfCLReflectedPoint start n (suc n) psi beta Y) $)
 (he:$ nsLocal G (sfLReplacementImageDefinable (sfLReplacementStartMap start) sfLDomain psi Y) $)
 (hc:$ nsLocal G (sfLReplacementImageCoverage (sfLReplacementStartMap start) sfLDomain psi Y) $):
 $ nsLocal G (sfLReplacementImageWitness (sfLReplacementStartMap start) sfLDomain psi) $;
