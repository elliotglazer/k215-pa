import "source_reflection_least_cond_parameters_bounds.mm1";

import "source_reflection_least_cond_ord_maps.mm1";

def sfOrdinalCollectionSubset(x y:nat):nat = $ sfAll (sfImp (sfMem 0 (suc x)) (sfMem 0 (suc y))) $;

def sfOrdinalCollectionOrdinal(x:nat):nat = $ sfSubst 0 x sfLeastOrdinalPredicate $;

def sfOrdinalCollectionPoint(phi:nat):nat = $ sfAll (sfImp (sfMem 0 1) (sfEx (sfAnd sfLeastOrdinalPredicate (sfLCBinary phi 0 1 3)))) $;

def sfOrdinalCollectionMono(phi:nat):nat = $ sfAll (sfAll (sfAll (sfImp (sfOrdinalCollectionOrdinal 1) (sfImp (sfLeastOrdinalPredicate) (sfImp (sfOrdinalCollectionSubset 1 0) (sfImp (sfLCBinary phi 1 2 4) (sfLCBinary phi 0 2 4))))))) $;

def sfOrdinalCollectionOutput(phi:nat):nat = $ sfEx (sfAnd sfLeastOrdinalPredicate (sfAll (sfImp (sfMem 0 2) (sfLCBinary phi 1 0 3)))) $;

def sfOrdinalCollectionLaw(phi:nat):nat = $ sfImp (sfOrdinalCollectionPoint phi) (sfImp (sfOrdinalCollectionMono phi) (sfOrdinalCollectionOutput phi)) $;

def sfOrdinalCollectionSelector(phi:nat):nat = $ sfAnd (sfAnd (sfOrdinalCollectionOrdinal 1) (sfLCBinary phi 1 0 3)) (sfAll (sfImp (sfMem 0 2) (sfImp (sfLCBinary phi 0 1 4) sfBot))) $;

pub theorem sfOrdinalCollectionSubset_wf(x y:nat): $ sfWf (sfOrdinalCollectionSubset x y) $ = '(ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfWf_mem) sfWf_mem));

pub theorem sfOrdinalCollectionOrdinal_wf(x:nat): $ sfWf (sfOrdinalCollectionOrdinal x) $ = 'sfSubst_wf;

pub theorem sfOrdinalCollectionPoint_wf(phi:nat): $ sfWf (sfOrdinalCollectionPoint phi) $ = '(ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfWf_mem) (ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and (ax_mp sfBound_wf sfLeastOrdinalPredicate_bound)) sfLCBinary_wf))));

pub theorem sfOrdinalCollectionMono_wf(phi:nat): $ sfWf (sfOrdinalCollectionMono phi) $ = '(ax_mp sfWf_all (ax_mp sfWf_all (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfOrdinalCollectionOrdinal_wf) (ax_mp (ax_mp sfWf_imp (ax_mp sfBound_wf sfLeastOrdinalPredicate_bound)) (ax_mp (ax_mp sfWf_imp sfOrdinalCollectionSubset_wf) (ax_mp (ax_mp sfWf_imp sfLCBinary_wf) sfLCBinary_wf)))))));

pub theorem sfOrdinalCollectionOutput_wf(phi:nat): $ sfWf (sfOrdinalCollectionOutput phi) $ = '(ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and (ax_mp sfBound_wf sfLeastOrdinalPredicate_bound)) (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfWf_mem) sfLCBinary_wf))));

pub theorem sfOrdinalCollectionSelector_wf(phi:nat): $ sfWf (sfOrdinalCollectionSelector phi) $ = '(ax_mp (ax_mp sfWf_and (ax_mp (ax_mp sfWf_and sfOrdinalCollectionOrdinal_wf) sfLCBinary_wf)) (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfWf_mem) (ax_mp (ax_mp sfWf_imp sfLCBinary_wf) sfWf_bot))));

pub theorem sfOrdinalCollectionLaw_wf(phi:nat): $ sfWf (sfOrdinalCollectionLaw phi) $ = '(ax_mp (ax_mp sfWf_imp sfOrdinalCollectionPoint_wf) (ax_mp (ax_mp sfWf_imp sfOrdinalCollectionMono_wf) sfOrdinalCollectionOutput_wf));
