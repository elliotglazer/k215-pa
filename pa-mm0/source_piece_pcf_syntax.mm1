import "source_l_common_level_blocks.mm1";
import "source_renaming_laws.mm1";

@_ def sfPieceBeta (sb sc i: nat): nat = $ sb % suc (suc i * sc) $;
@_ def sfPieceCount (sb sc i: nat): nat = $ fst (sfPieceBeta sb sc i) $;
@_ def sfPieceMatrix (sb sc i: nat): nat = $ snd (sfPieceBeta sb sc i) $;
@_ def sfPieceTableValid (sb sc n .i: nat): wff =
 $ A. i (i < n -> sfBound (suc (sfPieceCount sb sc i)) (sfPieceMatrix sb sc i)) $;

@_ def sfPieceShift3 (phi: nat): nat = $ sfShift 1 (sfShift 1 (sfShift 1 phi)) $;
@_ def sfPieceEw (domain matrix: nat): nat =
 $ sfImp (sfEx (sfAnd domain matrix)) (sfEx (sfAnd (sfMem 0 1) matrix)) $;
@_ def sfPieceD0 (domain level phi: nat): nat =
 $ sfAll (sfImp level (sfPieceEw domain (sfPieceShift3 phi))) $;

@_ def sfPieceRotate (.i: nat): set =
 $ \ i, if (i = 0) 1 (if (i = 1) 2 (if (i = 2) 0 i)) $;
@_ def sfPieceDnStep (.previous: nat): set =
 $ \ previous, sfAll (sfImp (sfMem 0 2) (sfRename sfPieceRotate 0 previous)) $;
@_ def sfPieceDn (count body: nat): nat = $ rec body sfPieceDnStep count $;

@_ def sfPieceOpenMap (d X .i: nat): set =
 $ \ i, if (i = 0) d (if (i = 1) X i) $;
@_ def sfPiecePC (domain level count phi d X: nat): nat =
 $ sfRename (sfPieceOpenMap d X) 0 (sfPieceDn count (sfPieceD0 domain level phi)) $;

@_ def sfPieceRows (domain level sb sc d X .i: nat): set =
 $ \ i, sfPiecePC domain level (sfPieceCount sb sc i) (sfPieceMatrix sb sc i) d X $;
@_ def sfPieceConjunction (domain level sb sc n d X: nat): nat =
 $ sfCLFold (sfPieceRows domain level sb sc d X) n $;
@_ def sfPieceBinary (domain level sb sc n: nat): nat =
 $ sfPieceConjunction domain level sb sc n 0 1 $;

pub theorem sfPieceTableValid_at (sb sc n i: nat):
 $ sfPieceTableValid sb sc n -> i < n ->
   sfBound (suc (sfPieceCount sb sc i)) (sfPieceMatrix sb sc i) $ =
(named '(!! eale j ,eqtac));

pub theorem sfPieceTableValid_prefix (sb sc n: nat):
 $ sfPieceTableValid sb sc (suc n) -> sfPieceTableValid sb sc n $ =
(named '(alimi (imim1i (ax_mp (com12 ltletr) lesucid))));

pub theorem sfPieceTableValid_last (sb sc n: nat):
 $ sfPieceTableValid sb sc (suc n) ->
   sfBound (suc (sfPieceCount sb sc n)) (sfPieceMatrix sb sc n) $ =
'(mpd (a1i ltsucid) sfPieceTableValid_at);

pub theorem sfPieceRotate_value (i: nat):
 $ sfPieceRotate @ i = if (i = 0) 1 (if (i = 1) 2 (if (i = 2) 0 i)) $ =
(named '(applame ,eqtac));

pub theorem sfPieceOpenMap_value (d X i: nat):
 $ sfPieceOpenMap d X @ i = if (i = 0) d (if (i = 1) X i) $ =
(named '(applame ,eqtac));

pub theorem sfPieceDnStep_value (previous: nat):
 $ sfPieceDnStep @ previous = sfAll (sfImp (sfMem 0 2) (sfRename sfPieceRotate 0 previous)) $ =
(named '(applame ,eqtac));

pub theorem sfPieceDn_zero (body: nat): $ sfPieceDn 0 body = body $ = 'rec0;
pub theorem sfPieceDn_suc (count body: nat):
 $ sfPieceDn (suc count) body =
   sfAll (sfImp (sfMem 0 2) (sfRename sfPieceRotate 0 (sfPieceDn count body))) $ =
'(eqtr recS sfPieceDnStep_value);

pub theorem sfPieceRows_value (domain level sb sc d X i: nat):
 $ sfPieceRows domain level sb sc d X @ i =
   sfPiecePC domain level (sfPieceCount sb sc i) (sfPieceMatrix sb sc i) d X $ =
(named '(applame ,eqtac));

pub theorem sfPieceConjunction_zero (domain level sb sc d X: nat):
 $ sfPieceConjunction domain level sb sc 0 d X = sfCLTrue $ = 'sfCLFold_zero;

pub theorem sfPieceConjunction_suc (domain level sb sc n d X: nat):
 $ sfPieceConjunction domain level sb sc (suc n) d X =
   sfAnd (sfPieceConjunction domain level sb sc n d X)
    (sfPiecePC domain level (sfPieceCount sb sc n) (sfPieceMatrix sb sc n) d X) $ =
'(eqtr sfCLFold_suc (trud (sfAndeqd (a1i eqid) (a1i sfPieceRows_value))));

pub theorem sfPiecePC_wf (domain level count phi d X: nat):
 $ sfWf (sfPiecePC domain level count phi d X) $ = 'sfRename_wf;

pub theorem sfPieceConjunction_wf (domain level sb sc n d X: nat):
 $ sfWf (sfPieceConjunction domain level sb sc n d X) $ =
(named @ induct '(ind) 'n
 '(mpbir (sfSchema_wf_eq sfPieceConjunction_zero) (ax_mp (ax_mp sfWf_imp sfWf_bot) sfWf_bot))
 '(mpbird (a1i (sfSchema_wf_eq sfPieceConjunction_suc))
  (syl (bi2 sfWf_and_iff) (iand id (a1i sfPiecePC_wf)))));

pub theorem sfPieceBinary_wf (domain level sb sc n: nat):
 $ sfWf (sfPieceBinary domain level sb sc n) $ = 'sfPieceConjunction_wf;
