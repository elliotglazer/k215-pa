pub theorem sfK0QSep_profile_specialization (E: set) (n t a b c x theta: nat)
 (hf: $ sfBound (suc n) theta $) (hz: $ x != 0 $)
 (ht: $ t != x $) (ha: $ a != x $) (hb: $ b != x $) (hc: $ c != x $)
 (he: $ sqEnvAvoid E n x $) (htx: $ t < x $):
 $ k218QProvable (kImp (kAll x (sfK0QSepRawProfile t a b c x (sfNamedTemplate (sqEnvCons x E) (suc x) 0 theta))) (sfK0QSepRawProfile t a b c t (sfNamedTemplate (sqEnvCons t E) (suc x) 0 theta))) $ =
(named '(mpbi (k218QProvableeq (kImpeq2 (sfK0QSep_profile_substitution hf hz ht ha hb hc he)))
 (ax_mp (ax_mp (ax_mp k218INamed_specialization (ax_mp necom ht))
   (qsepProfileAbsentX hf htx)) (qsepProfileAbsentT hf htx))));

pub theorem sfK0QSep_marker_from_profile (E: set) (n t a b c x theta: nat)
 (hf: $ sfBound (suc n) theta $) (hz: $ x != 0 $)
 (ht: $ t != x $) (ha: $ a != x $) (hb: $ b != x $) (hc: $ c != x $)
 (he: $ sqEnvAvoid E n x $) (htx: $ t < x $):
 $ k218QProvable (kImp (kAll x (sfK0QSepRawProfile t a b c x (sfNamedTemplate (sqEnvCons x E) (suc x) 0 theta))) (kMem t c)) $ =
'(k218IProvable_syl (sfK0QSep_profile_specialization hf hz ht ha hb hc he htx) (sfK0QSep_marker_point (ax_mp sfBound_wf hf)));
