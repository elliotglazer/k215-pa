import "bb215_derivability_l3b_cop.mm0";

-- L08 for L06 (step E, B1.2b prerequisites; lanes/L08.md): Cantor pairing inside PA, free variables.
-- Pair(a, b, p) is the frozen code 2 p = (a + b) S (a + b) + 2 b. Generated by bb215_internal_bridge_pow2_build.py.

-- double_inj: A. x A. y (2 x = 2 y -> x = y); parity: A. n E. h (n S n = 2 h); pair_total: A. a A. b E. p Pair(a, b, p);
-- pair_lt: Pair(a,b,p) -> Pair(a',b',p) -> S (a + b) + d = a' + b' -> False; pair_inj: Pair(a,b,p) -> Pair(a',b',p) -> a = a' /\ b = b'.

theorem bb215IBP_double_inj: $ paProvable 0 (paFormulaAll (paFormulaAll (paFormulaImp (paFormulaEqual (paTermMultiplication (paTermSuccessor (paTermSuccessor paTermZero)) (paTermVariable 1)) (paTermMultiplication (paTermSuccessor (paTermSuccessor paTermZero)) (paTermVariable 0))) (paFormulaEqual (paTermVariable 1) (paTermVariable 0))))) $;

theorem bb215IBP_parity: $ paProvable 0 (paFormulaAll (paFormulaEx (paFormulaEqual (paTermMultiplication (paTermVariable 1) (paTermSuccessor (paTermVariable 1))) (paTermMultiplication (paTermSuccessor (paTermSuccessor paTermZero)) (paTermVariable 0))))) $;

theorem bb215IBP_pair_total: $ paProvable 0 (paFormulaAll (paFormulaAll (paFormulaEx (paFormulaEqual (paTermMultiplication (paTermSuccessor (paTermSuccessor paTermZero)) (paTermVariable 0)) (paTermAddition (paTermMultiplication (paTermAddition (paTermVariable 2) (paTermVariable 1)) (paTermSuccessor (paTermAddition (paTermVariable 2) (paTermVariable 1)))) (paTermMultiplication (paTermSuccessor (paTermSuccessor paTermZero)) (paTermVariable 1))))))) $;

theorem bb215IBP_pair_lt: $ paProvable 0 (paFormulaAll (paFormulaAll (paFormulaAll (paFormulaAll (paFormulaAll (paFormulaAll (paFormulaImp (paFormulaEqual (paTermMultiplication (paTermSuccessor (paTermSuccessor paTermZero)) (paTermVariable 1)) (paTermAddition (paTermMultiplication (paTermAddition (paTermVariable 5) (paTermVariable 4)) (paTermSuccessor (paTermAddition (paTermVariable 5) (paTermVariable 4)))) (paTermMultiplication (paTermSuccessor (paTermSuccessor paTermZero)) (paTermVariable 4)))) (paFormulaImp (paFormulaEqual (paTermMultiplication (paTermSuccessor (paTermSuccessor paTermZero)) (paTermVariable 1)) (paTermAddition (paTermMultiplication (paTermAddition (paTermVariable 3) (paTermVariable 2)) (paTermSuccessor (paTermAddition (paTermVariable 3) (paTermVariable 2)))) (paTermMultiplication (paTermSuccessor (paTermSuccessor paTermZero)) (paTermVariable 2)))) (paFormulaImp (paFormulaEqual (paTermAddition (paTermSuccessor (paTermAddition (paTermVariable 5) (paTermVariable 4))) (paTermVariable 0)) (paTermAddition (paTermVariable 3) (paTermVariable 2))) paFormulaFalse))))))))) $;

theorem bb215IBP_pair_inj: $ paProvable 0 (paFormulaAll (paFormulaAll (paFormulaAll (paFormulaAll (paFormulaAll (paFormulaImp (paFormulaEqual (paTermMultiplication (paTermSuccessor (paTermSuccessor paTermZero)) (paTermVariable 0)) (paTermAddition (paTermMultiplication (paTermAddition (paTermVariable 4) (paTermVariable 3)) (paTermSuccessor (paTermAddition (paTermVariable 4) (paTermVariable 3)))) (paTermMultiplication (paTermSuccessor (paTermSuccessor paTermZero)) (paTermVariable 3)))) (paFormulaImp (paFormulaEqual (paTermMultiplication (paTermSuccessor (paTermSuccessor paTermZero)) (paTermVariable 0)) (paTermAddition (paTermMultiplication (paTermAddition (paTermVariable 2) (paTermVariable 1)) (paTermSuccessor (paTermAddition (paTermVariable 2) (paTermVariable 1)))) (paTermMultiplication (paTermSuccessor (paTermSuccessor paTermZero)) (paTermVariable 1)))) (paFormulaAnd (paFormulaEqual (paTermVariable 4) (paTermVariable 2)) (paFormulaEqual (paTermVariable 3) (paTermVariable 1)))))))))) $;
