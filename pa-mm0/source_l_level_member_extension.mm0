import "source_l_level_extension_syntax.mm0";
import "source_l_level_member_extension_replay.mm0";

import "extracted_ltrans_weak.mm0";


theorem sfLLevelExtension_context: $ slLEContext = sfLBackground $;

theorem sfLLevelExtension_formula: $ slLEFormula = sfImp sfLStageTrans (sfImp sfLLevelMember (sfImp sfLPairCommon2 sfLLevelExtension)) $;

theorem sfLLevelExtension_local: $ nsLocal sfLBackground (sfImp sfLStageTrans (sfImp sfLLevelMember (sfImp sfLPairCommon2 sfLLevelExtension))) $;

theorem sfLLevelExtension_factored_zfr: $ sfTheoryProvable zfrAxioms (sfImp sfLStageTrans (sfImp sfLLevelMember (sfImp sfLPairCommon2 sfLLevelExtension))) $;

theorem sfLLevelExtension_from_next_common2: $ sfTheoryProvable zfrAxioms sfLPairNextLevel -> sfTheoryProvable zfrAxioms sfLPairCommon2 -> sfTheoryProvable zfrAxioms sfLLevelExtension $;
