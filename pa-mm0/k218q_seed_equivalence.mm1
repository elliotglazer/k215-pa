import "k218q_seed_syntax.mm1";
import "k218q_equivalence.mm1";

pub theorem k218QSeedY_equivalent (a b c u v: nat)
  (he: $ k218IEquivalent u v $):
  $ k218IEquivalent (k218SeedY a b c u) (k218SeedY a b c v) $ =
'(ax_mp k218IEquivalent_not (ax_mp k218IEquivalent_imp (ian (ax_mp k218IEquivalent_imp (ian k218IEquivalent_refl (ax_mp k218IEquivalent_all k218IEquivalent_refl))) (ax_mp k218IEquivalent_all (ax_mp k218IEquivalent_imp (ian (ax_mp k218IEquivalent_all (ax_mp k218IEquivalent_imp (ian k218IEquivalent_refl (ax_mp k218IEquivalent_exists (ax_mp k218IEquivalent_and (ian he (ax_mp k218IEquivalent_all (ax_mp k218IEquivalent_imp (ian (ax_mp k218IEquivalent_all (ax_mp k218IEquivalent_imp (ian k218IEquivalent_refl k218IEquivalent_refl))) (ax_mp k218IEquivalent_all (ax_mp k218IEquivalent_imp (ian he (ax_mp k218IEquivalent_exists (ax_mp k218IEquivalent_and (ian he k218IEquivalent_refl))))))))))))))) (ax_mp k218IEquivalent_not (ax_mp k218IEquivalent_all (ax_mp k218IEquivalent_imp (ian he (ax_mp k218IEquivalent_exists (ax_mp k218IEquivalent_and (ian he k218IEquivalent_refl)))))))))))));
