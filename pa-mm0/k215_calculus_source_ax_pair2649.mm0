import "k215_calculus_source_ax_stack_loops.mm0";
import "k215_literal_runtime_reach.mm0";
import "k215_calculus_source_pairing.mm0";
import "k215_calculus_source_ax_stack_lookups.mm0";

def k215PairAt2649State (pc a b t c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) b (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) a t (k215PR8 c)) $;

theorem k215PairAt2649ReachIn (a b t c: nat): $ k215PReach (k215PairAt2649State k215PNum2649 a b t c) (k215PairAt2649State k215PNum2653 (a + b) 0 (t + b) c) $;

theorem k215PairAt2649Cycle (a b t k c: nat): $ a + b = suc k -> k215PReach (k215PairAt2649State k215PNum2649 a b t c) (k215PairAt2649State k215PNum2649 0 k (suc (t + b)) c) $;

theorem k215PairAt2649Base (t c: nat): $ k215PReach (k215PairAt2649State k215PNum2649 0 0 t c) (k215PairAt2649State k215PNum2659 0 0 t c) $;

def k215PairAt2649Run (a b t c: nat): wff =
 $ k215PReach (k215PairAt2649State k215PNum2649 a b t c) (k215PairAt2649State k215PNum2659 0 0 (t + (a, b)) c) $;

def k215PairAt2649Claim (k c: nat) (.a .b .t: nat): wff =
 $ A. a A. b A. t (a + b = k -> k215PairAt2649Run a b t c) $;

theorem k215PairMacro2649 (a b t c: nat): $ k215PReach (k215PairAt2649State k215PNum2649 a b t c) (k215PairAt2649State k215PNum2659 0 0 (t + (a, b)) c) $;
