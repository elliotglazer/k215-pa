theorem bcT0ne (c: nat): $ sfTag c != 0 -> c != 0 $;
theorem paTermRename_junk (R: set) (c: nat):
  $ sfTag c != 1 -> sfTag c != 2 -> sfTag c != 3 -> sfTag c != 4 -> paTermRename R c = paTermZero $;
theorem bcTagNe (G: wff) (c k j: nat) (h: $ G -> sfTag c = k $) (hn: $ k != j $): $ G -> sfTag c != j $;
theorem bcTagPos (G: wff) (c k: nat) (h: $ G -> sfTag c = k $) (hn: $ k != 0 $): $ G -> 0 < c $;
theorem paTermRename_tag1 (R: set) (c: nat): $ sfTag c = 1 -> paTermRename R c = paTermVariable (R @ sfLeft c) $;
theorem paTermRename_tag2 (R: set) (c: nat): $ sfTag c = 2 -> paTermRename R c = paTermSuccessor (paTermRename R (sfLeft c)) $;
theorem paTermSubst_junk (d a c: nat):
  $ sfTag c != 1 -> sfTag c != 2 -> sfTag c != 3 -> sfTag c != 4 -> paTermSubst d a c = paTermZero $;
theorem paTermSubst_tag1 (d a c: nat): $ sfTag c = 1 -> paTermSubst d a c = paTermSubstVariable d a (sfLeft c) $;
theorem paTermSubst_tag2 (d a c: nat): $ sfTag c = 2 -> paTermSubst d a c = paTermSuccessor (paTermSubst d a (sfLeft c)) $;
theorem paTermSource_junk (c: nat):
  $ sfTag c != 1 -> sfTag c != 2 -> sfTag c != 3 -> sfTag c != 4 -> paTermSource c = paSourceTermZero $;
theorem paTermSource_tag1 (c: nat): $ sfTag c = 1 -> paTermSource c = paSourceTermVariable (sfLeft c) $;
theorem paTermSource_tag2 (c: nat): $ sfTag c = 2 -> paTermSource c = paSourceTermSuccessor (paTermSource (sfLeft c)) $;
theorem paFormulaSubst_junk (d a c: nat):
  $ sfTag c != 1 -> sfTag c != 3 -> sfTag c != 4 -> sfTag c != 5 -> ~(sfTag c = 6 /\ sfRight c = 0) ->
    ~(sfTag c = 7 /\ sfRight c = 0) -> paFormulaSubst d a c = 0 $;
theorem paFormulaRename_junk (R: set) (d c: nat):
  $ sfTag c != 1 -> sfTag c != 3 -> sfTag c != 4 -> sfTag c != 5 -> ~(sfTag c = 6 /\ sfRight c = 0) ->
    ~(sfTag c = 7 /\ sfRight c = 0) -> paFormulaRename R d c = 0 $;
theorem paFormulaSource_junk (c: nat):
  $ sfTag c != 1 -> sfTag c != 3 -> sfTag c != 4 -> sfTag c != 5 -> ~(sfTag c = 6 /\ sfRight c = 0) ->
    ~(sfTag c = 7 /\ sfRight c = 0) -> paFormulaSource c = 0 $;
