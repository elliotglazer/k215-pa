import "k218_translation_growth.mm1";
import "k218q_seed_equivalence.mm1";

pub theorem k218QSeed_double_negative (d: nat):
  $ k218QProvable (k218SeedY 1 3 (k218QSeedCode d) (kNot (kNot d))) $ =
'(mpbir (k218Provableeq k218Translate_k218SeedY)
  (ax_mp k218Bundle_normalized_seed (ian k218QS_label_ne1 k218QS_label_ne3)));
theorem k218QS_dneg (d: nat): $ k218IEquivalent (kNot (kNot d)) d $ =
'(ian k218IPropDNE k218IPropB3);
pub theorem k218QSeed_normalized (d: nat):
  $ k218QProvable (k218SeedY 1 3 (k218QSeedCode d) d) $ =
'(ax_mp (ax_mp k218QProvable_mp k218QSeed_double_negative)
  (anl (k218QSeedY_equivalent k218QS_dneg)));
