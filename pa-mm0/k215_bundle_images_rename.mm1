@_ def k215DecSeedGz (a b k z Q: nat): nat =
 $ (sfAll (sfRename (rawBinderMap k) 0 (sfImp (sfAll (sfRename (rawBinderMap b) 0 (sfImp (sfMem b k) (sfImp (sfAll (sfRename (rawBinderMap a) 0 (sfImp Q (sfImp (sfAll (sfRename (rawBinderMap a) 0 (sfImp (sfAll (sfRename (rawBinderMap k) 0 (sfImp (sfMem k a) (sfMem k b)))) (sfAll (sfRename (rawBinderMap b) 0 (sfImp Q (sfImp (sfAll (sfRename (rawBinderMap b) 0 (sfImp Q (sfImp (sfMem b k) (sfMem z z))))) (sfMem z z)))))))) (sfMem z z))))) (sfMem z z))))) (sfImp (sfAll (sfRename (rawBinderMap b) 0 (sfImp Q (sfImp (sfAll (sfRename (rawBinderMap b) 0 (sfImp Q (sfImp (sfMem b k) (sfMem z z))))) (sfMem z z))))) (sfMem z z))))) $;
@_ def k215DecBundleGz (a b k z Q: nat): nat =
 $ (sfImp (sfImp (sfImp (sfMem a b) (sfAll (sfRename (rawBinderMap k) 0 (sfMem a b)))) (k215DecSeedGz a b k z Q)) (sfMem z z)) $;

pub theorem k215DecBundleG_z (a b k Q: nat): $ k215DecBundleG a b k Q = k215DecBundleGz a b k 0 Q $ = 'eqid;

-- Case i = x: both sides are 0.
theorem k215BR_case_eq (S: set) (x i: nat):
 $ i = x -> sfRenameIndex S 1 (rawBinderMap x @ i) = rawBinderMap (S @ x) @ (S @ i) $ =
'(eqtr4d
   (eqtrd (sfRenameIndex_congr_index (eqtrd (appeq2d id) (a1i rawBinderMap_same)))
     (a1i (ax_mp sfRenameIndex_bound lt01S)))
   (eqtrd (appeq2d (appeq2d id)) (a1i rawBinderMap_same)));

-- Case i != x: both sides are suc (S @ i), using injectivity.
theorem k215BR_case_ne (S: set) (x i: nat) (hi: $ S @ i = S @ x -> i = x $):
 $ i != x -> sfRenameIndex S 1 (rawBinderMap x @ i) = rawBinderMap (S @ x) @ (S @ i) $ =
'(eqtr4d
   (eqtrd (sfRenameIndex_congr_index rawBinderMap_other)
     (a1i (eqtr sfRenameIndex_lift (suceq sfRenameIndex_zero))))
   (syl rawBinderMap_other (con3 hi)));

theorem k215BR_point (S: set) (x: nat) {i: nat} (hinj: $ A. i (S @ i = S @ x -> i = x) $):
 $ sfComposeMap (sfRenameDepthMap S 1) (rawBinderMap x) @ i =
   sfComposeMap (rawBinderMap (S @ x)) S @ i $ =
'(eqtr (eqtr sfComposeMap_value sfRenameDepthMap_value)
   (eqtr (cases k215BR_case_eq (k215BR_case_ne (ax_mp eal hinj))) (eqcom sfComposeMap_value)));

pub theorem k215BR_comm (S: set) (x B: nat) {i: nat} (hinj: $ A. i (S @ i = S @ x -> i = x) $) (hB: $ sfWf B $):
 $ sfRename S 1 (sfRename (rawBinderMap x) 0 B) =
   sfRename (rawBinderMap (S @ x)) 0 (sfRename S 0 B) $ =
(named '(eqtr (sfRenameeq2 (eqcom add01)) (eqtr (ax_mp sfRename_depth sfRename_wf)
   (eqtr (ax_mp sfRename_compose hB)
    (eqtr (ax_mp (sfRename_extensional (!! ax_gen i @ ! k215BR_point S x i hinj)) hB)
     (eqcom (ax_mp sfRename_compose hB)))))));

