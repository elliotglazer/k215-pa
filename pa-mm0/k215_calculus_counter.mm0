import "k215_calculus_mp.mm0";

def k215CounterPrefix (i r: nat): nat = $ if (i = 0) r (suc (k215CmdMP i r)) $;

def k215CounterTime (i: nat): nat = $ if (i = 0) 0 1 $;

theorem k215Counter_run (i r np w: nat):
 $ k215EnumIter (k215CounterTime i)
      (k218EnumState (k215CounterPrefix i r) np 0 w 0 0) =
   suc (k218EnumState r np 0 w i 0) $;
