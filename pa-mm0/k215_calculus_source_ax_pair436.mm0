import "k215_calculus_source_ax_stack_loops.mm0";
import "k215_literal_runtime_reach.mm0";
import "k215_calculus_source_pairing.mm0";
import "k215_calculus_source_ax_stack_lookups.mm0";

def k215PairAt436State (pc a b t c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) b (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) a t (k215PR8 c)) $;

theorem k215PairAt436ReachIn (a b t c: nat): $ k215PReach (k215PairAt436State k215PNum436 a b t c) (k215PairAt436State k215PNum440 (a + b) 0 (t + b) c) $;

theorem k215PairAt436Cycle (a b t k c: nat): $ a + b = suc k -> k215PReach (k215PairAt436State k215PNum436 a b t c) (k215PairAt436State k215PNum436 0 k (suc (t + b)) c) $;

theorem k215PairAt436Base (t c: nat): $ k215PReach (k215PairAt436State k215PNum436 0 0 t c) (k215PairAt436State k215PNum446 0 0 t c) $;

def k215PairAt436Run (a b t c: nat): wff =
 $ k215PReach (k215PairAt436State k215PNum436 a b t c) (k215PairAt436State k215PNum446 0 0 (t + (a, b)) c) $;

def k215PairAt436Claim (k c: nat) (.a .b .t: nat): wff =
 $ A. a A. b A. t (a + b = k -> k215PairAt436Run a b t c) $;

theorem k215PairMacro436 (a b t c: nat): $ k215PReach (k215PairAt436State k215PNum436 a b t c) (k215PairAt436State k215PNum446 0 0 (t + (a, b)) c) $;
