import "source_l_common_level_two_native.mm1";
import "source_l_pair_shell.mm1";
import "source_l_compact_hierarchy_subset.mm1";

-- Hand-written replacement for the output of build_source_l_common_level_two.py (whose
-- native input review/source-l-common-level/common_two.fullnd.json is not in the repo).
-- sfLPairCommon2 unfolds to slPFF791 and sfCL2NativeLaw to cl2NF791, a verbatim copy of the
-- same definition tree (build_source_l_common_level_two_native.py), so the two are equal by
-- unfolding definitions.
pub theorem sfLPairCommon2_native: $ sfLPairCommon2 = sfCL2NativeLaw $ = 'eqid;

pub theorem sfLPairCommon2_zfr: $ sfTheoryProvable zfrAxioms sfLPairCommon2 $ =
'(mpbir (sfTheoryProvableeq2 sfLPairCommon2_native)
  (sfCL2NativeLaw_from_hierarchy sfLPowerHierarchySubset_zfr));
