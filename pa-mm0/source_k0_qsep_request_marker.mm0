import "source_k0_qsep_request_root.mm0";

import "source_k0_qsep_empty.mm0";

def sfK0QSepSubsetCandidate (t c y K: nat): nat = $ kAnd (kMem y c) (kAll K (kImp (kMem K t) (kMem K y))) $;

theorem sfK0QSepSubsetCandidate_exists_intro (t b c y K: nat) (hy0: $ y != 0 $) (hyK: $ y < K $) (hbK: $ b < K $) (hcy: $ c != y $) (hty: $ t != y $) (hyb: $ y != b $):
 $ k218QProvable (kImp (sfK0QSepSubsetCandidate t c b K) (kExists y (sfK0QSepSubsetCandidate t c y K))) $;

theorem sfK0QSepTagged_marker_seed (E: set) (n r t b c u y K theta: nat)
 (hf: $ sfBound (suc n) theta $)
 (hu0: $ u != 0 $) (hy0: $ y != 0 $) (hK0: $ K != 0 $)
 (huK: $ u < K $) (hyK: $ y < K $) (htK: $ t < K $) (hbK: $ b < K $)
 (hru: $ r != u $) (htu: $ t != u $) (hbu: $ b != u $) (hcu: $ c != u $)
 (hyu: $ y != u $) (huy: $ u < y $) (ht_y: $ t < y $)
 (hyr: $ y != r $) (hyt: $ y != t $) (hyb: $ y != b $) (hyc: $ y != c $)
 (heu: $ sqEnvAvoid E n u $) (hey: $ sqEnvAvoid E n y $):
 $ k218QProvable (kImp (kImp (kImp (kImp (kEq t r) (kImp (kEq t b) kF)) kF) kF) (kImp (kImp (kImp (kImp (kEq t t) (kImp (kEq t t) kF)) kF) kF) (kImp (kImp (sfK0QSepNamedSingleton t t K) (kImp (kImp (kImp (kMem t b) (kImp (sfNamedTemplate (sqEnvCons t E) K 0 theta) kF)) kF) kF)) kF))) $;

theorem sfK0QSepTagged_marker_seed_exists (E: set) (n r t b c u y K theta: nat)
 (hf: $ sfBound (suc n) theta $)
 (hu0: $ u != 0 $) (hy0: $ y != 0 $) (hK0: $ K != 0 $)
 (huK: $ u < K $) (hyK: $ y < K $) (htK: $ t < K $) (hbK: $ b < K $)
 (hru: $ r != u $) (htu: $ t != u $) (hbu: $ b != u $) (hcu: $ c != u $)
 (hyu: $ y != u $) (huy: $ u < y $) (ht_y: $ t < y $)
 (hyr: $ y != r $) (hyt: $ y != t $) (hyb: $ y != b $) (hyc: $ y != c $)
 (heu: $ sqEnvAvoid E n u $) (hey: $ sqEnvAvoid E n y $):
 $ k218QProvable (kExists y (sfK0QSepNamedTagged E r t b t y K theta)) $;

theorem sfK0QSepTagged_marker_return (E: set) (n r t b c u y K theta: nat)
 (hf: $ sfBound (suc n) theta $)
 (hu0: $ u != 0 $) (hy0: $ y != 0 $) (hK0: $ K != 0 $)
 (huK: $ u < K $) (hyK: $ y < K $) (htK: $ t < K $) (hbK: $ b < K $)
 (hru: $ r != u $) (htu: $ t != u $) (hbu: $ b != u $) (hcu: $ c != u $)
 (hyu: $ y != u $) (huy: $ u < y $) (ht_y: $ t < y $)
 (hyr: $ y != r $) (hyt: $ y != t $) (hyb: $ y != b $) (hyc: $ y != c $)
 (heu: $ sqEnvAvoid E n u $) (hey: $ sqEnvAvoid E n y $):
 $ k218QProvable (kImp (kAll y (kImp (kMem y t) kF)) (kImp (kMem b c) (kImp (kAll u (sfK0QSepTaggedRequest E r t b c u y K theta)) (kExists y (kAnd (kMem y c) (sfK0QSepNamedTagged E r t b t y K theta)))))) $;

theorem sfK0QSepTagged_marker_member (E: set) (n r t b c u y K theta: nat)
 (hf: $ sfBound (suc n) theta $)
 (hu0: $ u != 0 $) (hy0: $ y != 0 $) (hK0: $ K != 0 $)
 (huK: $ u < K $) (hyK: $ y < K $) (htK: $ t < K $) (hbK: $ b < K $)
 (hru: $ r != u $) (htu: $ t != u $) (hbu: $ b != u $) (hcu: $ c != u $)
 (hyu: $ y != u $) (huy: $ u < y $) (ht_y: $ t < y $)
 (hyr: $ y != r $) (hyt: $ y != t $) (hyb: $ y != b $) (hyc: $ y != c $)
 (heu: $ sqEnvAvoid E n u $) (hey: $ sqEnvAvoid E n y $):
 $ k218QProvable (kImp (kImp (kEq t r) kF) (kImp (kAll y (kImp (kMem y t) kF)) (kImp (kMem b c) (kImp (kAll u (sfK0QSepTaggedRequest E r t b c u y K theta)) (kMem t c))))) $;
