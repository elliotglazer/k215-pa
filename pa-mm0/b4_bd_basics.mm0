import "bd_certs.mm0";

theorem bdPair_double (a b: nat): $ 2 * (a, b) = (a + b) * suc (a + b) + 2 * b $;
theorem bdPair_iff (a b p: nat): $ bdPair a b p <-> p = (a, b) $;
theorem bdPair_pr (a b: nat): $ bdPair a b (a, b) $;
theorem bdPair_le1 (a b p: nat): $ bdPair a b p -> a <= p $;
theorem bdPair_le2 (a b p: nat): $ bdPair a b p -> b <= p $;
theorem bdDvd_iff (a b: nat): $ bdDvd a b <-> a || b $;
theorem bdCell_iff (m v k: nat) {x: nat}: $ bdCell m v k <->
  0 < m /\ 0 < v /\ A. x (0 < x /\ x <= k -> x || m) /\ suc (m * suc k) || v $;
theorem bdCell_lt (m v k: nat): $ bdCell m v k -> k < v $;
theorem bdCell_code {k m v: nat} (n: nat) (p: wff k):
  $ E. m E. v A. k (bdCell m v k <-> k < n /\ p) $;
theorem bdState_iff (q l r s: nat): $ bdState q l r s <-> s = (q, l, r) $;
theorem bdState_le (q l r s: nat): $ bdState q l r s -> q <= s /\ l <= s /\ r <= s $;
theorem bdHalf_iff (a h c: nat): $ bdHalf a h c <-> h = a // 2 /\ c = a % 2 $;
