import "source_l_common_level_two_wf.mm0";

theorem sfCL2_sub_use (G b a Y Z: nat) (hS: $ nsLocal G sfCL2Sub $)
 (hb: $ nsLocal G (sfCLOrdinalAt b) $) (ha: $ nsLocal G (sfCLOrdinalAt a) $)
 (hs: $ nsLocal G (sfCLSubset a b) $)
 (hY: $ nsLocal G (sfCLHierarchyAt b Y) $) (hZ: $ nsLocal G (sfCLHierarchyAt a Z) $):
 $ nsLocal G (sfCLSubset Z Y) $;

theorem sfCL2_cmp_use (G x y: nat) (hC: $ nsLocal G sfCL2Cmp $)
 (hx: $ nsLocal G (sfCLOrdinalAt x) $) (hy: $ nsLocal G (sfCLOrdinalAt y) $):
 $ nsLocal G (sfOr (sfCLSubset x y) (sfCLSubset y x)) $;
