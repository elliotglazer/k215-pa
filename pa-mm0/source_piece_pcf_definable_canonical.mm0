import "source_piece_pcf_definable_parameters.mm0";

def sfPieceDefinableCanonicalMap(.i:nat): set = $ \ i, suc (suc i) $;

theorem sfPieceDefinableCanonicalMap_at(i:nat): $ sfPieceDefinableCanonicalMap @ i = suc (suc i) $;

theorem sfPieceDefinableCanonical_head(G:nat): $ nsLocal (sfPieceDefinableParametersStep @ G) (sfMem 2 1) $;

theorem sfPieceDefinableCanonical_lift(G i:nat): $ nsLocal G (sfMem (suc (suc i)) 1) -> nsLocal (sfPieceDefinableParametersStep @ G) (sfMem (suc (suc (suc i))) 1) $;

theorem sfPieceDefinableCanonical_members(n G:nat): $ sfReflectionDnMembers sfPieceDefinableCanonicalMap (sfPieceDefinableParametersContext n G) 1 n $;

theorem sfPieceDefinableCanonical_recipe(n G phi:nat)(hg:$ sfContextWf G $)(hp:$ nsLocal (sfPieceDefinableParametersContext n G) (sfPieceDefinableRecipePoint n phi) $): $ nsLocal G (sfPieceDefinableRecipe n phi) $;
