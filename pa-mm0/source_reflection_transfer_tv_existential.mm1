pub theorem sfTVEx2_project_closed(G A Q:nat)(hG:$ sfTheoryContext sfClosedFormulaClass G $)(ha:$ sfWf A $)(hq:$ sfBound 0 Q $)(hp:$ nsLocal (A : G) Q $): $ nsLocal G (sfImp (sfEx (sfEx A)) Q) $ = (named '(ax_mp nsLocal_II (ax_mp (ax_mp (sfLocal_exE (ax_mp sfBound_wf hq)) (ax_mp (ax_mp nsLocal_hyp (mpbir sfContextWf_cons (ian (ax_mp sfWf_ex (ax_mp sfWf_ex ha)) (ax_mp (ax_mp sfTheoryContext_wf ssid) hG)))) sfContext_member_head)) (mpbir (nsLocal_formula_eq (ax_mp sfShift_closed_identity hq)) (ax_mp (ax_mp (sfLocal_exE (ax_mp sfBound_wf hq)) (ax_mp (ax_mp nsLocal_hyp (mpbir sfContextWf_cons (ian (ax_mp sfWf_ex ha) sfContextShift_wf))) sfContext_member_head)) (mpbir (nsLocal_formula_eq (ax_mp sfShift_closed_identity hq)) (ax_mp (ax_mp nsLocal_weaken (mpbir sfContextWf_cons (ian ha sfContextShift_wf))) (sfTVContextSub_cons (sfTVClosedContext_sub_shift hG (mpbir sfContextWf_cons (ian (ax_mp sfWf_ex ha) sfContextShift_wf)) (ax_mp (ax_mp sfContextSub_trans (sfTVClosedContext_sub_shift hG (mpbir sfContextWf_cons (ian (ax_mp sfWf_ex (ax_mp sfWf_ex ha)) (ax_mp (ax_mp sfTheoryContext_wf ssid) hG))) sfContextSub_cons)) sfContextSub_cons))) hp)))))));
