import "source_wf_replacement_closure.mm0";

import "source_wf_separation_logic.mm0";

def wfRFixedF0: nat = $ sfMem 0 1 $;

def wfRFixedF1: nat = $ sfMem 0 2 $;

def wfRFixedF2: nat = $ sfImp wfRFixedF0 wfRFixedF1 $;

def wfRFixedF3: nat = $ sfAll wfRFixedF2 $;

def wfRFixedF4: nat = $ sfImp wfRFixedF0 wfRFixedF3 $;

def wfRFixedF5: nat = $ sfAll wfRFixedF4 $;

def wfRFixedF6: nat = $ sfEx wfRFixedF0 $;

def wfRFixedF7: nat = $ sfBot $;

def wfRFixedF8: nat = $ sfImp wfRFixedF1 wfRFixedF7 $;

def wfRFixedF9: nat = $ sfImp wfRFixedF0 wfRFixedF8 $;

def wfRFixedF10: nat = $ sfAll wfRFixedF9 $;

def wfRFixedF11: nat = $ sfAnd wfRFixedF0 wfRFixedF10 $;

def wfRFixedF12: nat = $ sfEx wfRFixedF11 $;

def wfRFixedF13: nat = $ sfImp wfRFixedF6 wfRFixedF12 $;

def wfRFixedF14: nat = $ sfImp wfRFixedF3 wfRFixedF13 $;

def wfRFixedF15: nat = $ sfAll wfRFixedF14 $;

