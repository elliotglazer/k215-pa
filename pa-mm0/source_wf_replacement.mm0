def wfRFixedF17: nat = $ sfMem 1 0 $;

def wfRFixedF18: nat = $ sfAnd wfRFixedF16 wfRFixedF17 $;

def wfRFixedF19: nat = $ sfEx wfRFixedF18 $;

def wfRFixedF20: nat = $ sfImp wfRFixedF0 wfRFixedF19 $;

def wfRFixedF21: nat = $ sfAll wfRFixedF20 $;

def wfRFixedF22: nat = $ sfImp wfRFixedF21 wfRFixedF19 $;

def wfRFixedF23: nat = $ sfAll wfRFixedF22 $;

def wfRFixedF24: nat = $ sfMem 3 0 $;

def wfRFixedF25: nat = $ sfAnd wfRFixedF16 wfRFixedF24 $;

def wfRFixedF26: nat = $ sfEx wfRFixedF25 $;

def wfRFixedF27: nat = $ sfMem 2 0 $;

def wfRFixedF28: nat = $ sfAnd wfRFixedF16 wfRFixedF27 $;

def wfRFixedF29: nat = $ sfEx wfRFixedF28 $;

def wfRUniformF0 (a b c: nat): nat = $ sfImp b (sfEq 1 0) $;

def wfRUniformF1 (a b c: nat): nat = $ sfImp a (wfRUniformF0 a b c) $;

def wfRUniformF2 (a b c: nat): nat = $ sfImp sfWFDomain (wfRUniformF1 a b c) $;

def wfRUniformF3 (a b c: nat): nat = $ sfAll (wfRUniformF2 a b c) $;

def wfRUniformF4 (a b c: nat): nat = $ sfImp sfWFDomain (wfRUniformF3 a b c) $;

def wfRUniformF5 (a b c: nat): nat = $ sfAll (wfRUniformF4 a b c) $;

def wfRUniformF6 (a b c: nat): nat = $ sfImp sfWFDomain (wfRUniformF5 a b c) $;

def wfRUniformF7 (a b c: nat): nat = $ sfAll (wfRUniformF6 a b c) $;

def wfRUniformF8 (a b c: nat): nat = $ sfAnd wfRFixedF26 wfRFixedF29 $;

def wfRUniformF9 (a b c: nat): nat = $ sfAnd (wfRUniformF8 a b c) a $;

def wfRUniformF10 (a b c: nat): nat = $ sfAnd wfRFixedF26 sfWFDomain $;

def wfRUniformF11 (a b c: nat): nat = $ sfAnd (wfRUniformF10 a b c) b $;

def wfRUniformF12 (a b c: nat): nat = $ sfImp (wfRUniformF11 a b c) (sfEq 1 0) $;

def wfRUniformF13 (a b c: nat): nat = $ sfImp (wfRUniformF9 a b c) (wfRUniformF12 a b c) $;

def wfRUniformF14 (a b c: nat): nat = $ sfAll (wfRUniformF13 a b c) $;

def wfRUniformF15 (a b c: nat): nat = $ sfAll (wfRUniformF14 a b c) $;

def wfRUniformF16 (a b c: nat): nat = $ sfAll (wfRUniformF15 a b c) $;

def wfRUniformF17 (a b c: nat): nat = $ sfAnd sfWFDomain wfRFixedF29 $;

def wfRUniformF18 (a b c: nat): nat = $ sfAnd (wfRUniformF17 a b c) c $;

def wfRUniformF19 (a b c: nat): nat = $ sfAnd (sfMem 0 3) (wfRUniformF18 a b c) $;

def wfRUniformF20 (a b c: nat): nat = $ sfEx (wfRUniformF19 a b c) $;

def wfRUniformF21 (a b c: nat): nat = $ sfImp (sfMem 0 1) (wfRUniformF20 a b c) $;

def wfRUniformF22 (a b c: nat): nat = $ sfImp (wfRUniformF20 a b c) (sfMem 0 1) $;

def wfRUniformF23 (a b c: nat): nat = $ sfAnd (wfRUniformF21 a b c) (wfRUniformF22 a b c) $;

def wfRUniformF24 (a b c: nat): nat = $ sfAll (wfRUniformF23 a b c) $;

def wfRUniformF25 (a b c: nat): nat = $ sfEx (wfRUniformF24 a b c) $;

def wfRUniformF26 (a b c: nat): nat = $ sfAll (wfRUniformF25 a b c) $;

def wfRUniformF27 (a b c: nat): nat = $ sfImp (wfRUniformF16 a b c) (wfRUniformF26 a b c) $;

def wfRUniformG28 (a b c: nat): nat = $ (wfRUniformF27 a b c) : 0 $;

def wfRUniformG29 (a b c: nat): nat = $ sfWFClosure : (wfRUniformG28 a b c) $;

def wfRUniformG30 (a b c: nat): nat = $ (wfRUniformF7 a b c) : (wfRUniformG29 a b c) $;

def wfRUniformG31 (a b c: nat): nat = $ sfContextShift (wfRUniformG30 a b c) $;

def wfRUniformG32 (a b c: nat): nat = $ sfWFDomain : (wfRUniformG31 a b c) $;

def wfRUniformG33 (a b c: nat): nat = $ sfContextShift (wfRUniformG32 a b c) $;

def wfRUniformG34 (a b c: nat): nat = $ sfContextShift (wfRUniformG31 a b c) $;

def wfRUniformG35 (a b c: nat): nat = $ wfRFixedF29 : (wfRUniformG34 a b c) $;

def wfRUniformG36 (a b c: nat): nat = $ sfWFDomain : (wfRUniformG35 a b c) $;

def wfRUniformG37 (a b c: nat): nat = $ sfContextShift (wfRUniformG36 a b c) $;

def wfRUniformG38 (a b c: nat): nat = $ sfContextShift (wfRUniformG34 a b c) $;

def wfRUniformG39 (a b c: nat): nat = $ wfRFixedF26 : (wfRUniformG38 a b c) $;

def wfRUniformG40 (a b c: nat): nat = $ wfRFixedF29 : (wfRUniformG39 a b c) $;

def wfRUniformG41 (a b c: nat): nat = $ sfWFDomain : (wfRUniformG40 a b c) $;

def wfRUniformG42 (a b c: nat): nat = $ (wfRUniformF9 a b c) : (wfRUniformG38 a b c) $;

def wfRUniformG43 (a b c: nat): nat = $ (wfRUniformF11 a b c) : (wfRUniformG42 a b c) $;

def wfRUniformG44 (a b c: nat): nat = $ (wfRUniformF24 a b c) : (wfRUniformG33 a b c) $;

def wfRUniformG45 (a b c: nat): nat = $ sfContextShift (wfRUniformG44 a b c) $;

def wfRUniformG46 (a b c: nat): nat = $ (sfMem 0 1) : (wfRUniformG45 a b c) $;

def wfRUniformG47 (a b c: nat): nat = $ sfContextShift (wfRUniformG46 a b c) $;

def wfRUniformG48 (a b c: nat): nat = $ (wfRUniformF19 a b c) : (wfRUniformG47 a b c) $;

def wfRUniformF49 (a b c: nat): nat = $ sfShift 0 sfWFDomain $;

def wfRUniformF50 (a b c: nat): nat = $ sfImp (sfMem 0 1) sfWFDomain $;

def wfRUniformF51 (a b c: nat): nat = $ sfAll (wfRUniformF50 a b c) $;

def wfRUniformF52 (a b c: nat): nat = $ sfShift 0 sfWFClosure $;

def wfRUniformF53 (a b c: nat): nat = $ sfImp (wfRUniformF51 a b c) sfWFDomain $;

def wfRUniformG54 (a b c: nat): nat = $ sfWFDomain : (wfRUniformG45 a b c) $;

def wfRUniformG55 (a b c: nat): nat = $ (sfMem 0 1) : (wfRUniformG54 a b c) $;

def wfRUniformG56 (a b c: nat): nat = $ sfContextShift (wfRUniformG55 a b c) $;

def wfRUniformG57 (a b c: nat): nat = $ (wfRUniformF19 a b c) : (wfRUniformG56 a b c) $;

def wfRUniformF58 (a b c: nat): nat = $ sfAnd (sfMem 0 3) c $;

def wfRUniformF59 (a b c: nat): nat = $ sfAnd sfWFDomain (wfRUniformF58 a b c) $;

def wfRUniformF60 (a b c: nat): nat = $ sfShift 1 (wfRUniformF59 a b c) $;

def wfRUniformF61 (a b c: nat): nat = $ sfEx (wfRUniformF60 a b c) $;

def wfRUniformF62 (a b c: nat): nat = $ sfEx (wfRUniformF59 a b c) $;

def wfRUniformF63 (a b c: nat): nat = $ sfShift 0 (wfRUniformF62 a b c) $;

def wfRUniformF64 (a b c: nat): nat = $ sfImp (sfMem 0 1) (wfRUniformF62 a b c) $;

def wfRUniformG65 (a b c: nat): nat = $ (wfRUniformF62 a b c) : (wfRUniformG54 a b c) $;

def wfRUniformG66 (a b c: nat): nat = $ sfContextShift (wfRUniformG65 a b c) $;

def wfRUniformG67 (a b c: nat): nat = $ (wfRUniformF59 a b c) : (wfRUniformG66 a b c) $;

def wfRUniformF68 (a b c: nat): nat = $ sfShift 1 (wfRUniformF19 a b c) $;

def wfRUniformF69 (a b c: nat): nat = $ sfEx (wfRUniformF68 a b c) $;

def wfRUniformF70 (a b c: nat): nat = $ sfShift 0 (wfRUniformF20 a b c) $;

def wfRUniformF71 (a b c: nat): nat = $ sfImp (wfRUniformF62 a b c) (sfMem 0 1) $;

def wfRUniformF72 (a b c: nat): nat = $ sfAnd (wfRUniformF64 a b c) (wfRUniformF71 a b c) $;

def wfRUniformF73 (a b c: nat): nat = $ sfImp sfWFDomain (wfRUniformF72 a b c) $;

def wfRUniformF74 (a b c: nat): nat = $ sfAll (wfRUniformF73 a b c) $;

def wfRUniformF75 (a b c: nat): nat = $ sfAnd sfWFDomain (wfRUniformF74 a b c) $;

def wfRUniformF76 (a b c: nat): nat = $ sfShift 1 (wfRUniformF75 a b c) $;

def wfRUniformF77 (a b c: nat): nat = $ sfEx (wfRUniformF76 a b c) $;

def wfRUniformF78 (a b c: nat): nat = $ sfEx (wfRUniformF75 a b c) $;

def wfRUniformF79 (a b c: nat): nat = $ sfShift 0 (wfRUniformF78 a b c) $;

def wfRUniformF80 (a b c: nat): nat = $ sfImp sfWFDomain (wfRUniformF78 a b c) $;

def wfRUniformF81 (a b c: nat): nat = $ sfAll (wfRUniformF80 a b c) $;

def wfRUniformF82 (a b c: nat): nat = $ sfImp (wfRUniformF7 a b c) (wfRUniformF81 a b c) $;

def sfWFReplacementRaw (a b c: nat): nat = $ (wfRUniformF27 a b c) $;

def sfWFReplacementGuarded (a b c: nat): nat = $ (wfRUniformF82 a b c) $;

def sfWFReplacementContext (a b c: nat): nat = $ sfWFClosure : (sfWFReplacementRaw a b c : 0) $;

theorem sfWFReplacement_local (a b c: nat) (ha: $ sfWf a $) (hb: $ sfWf b $) (hc: $ sfWf c $): $ nsLocal (sfWFReplacementContext a b c) (sfWFReplacementGuarded a b c) $;

theorem sfWFReplacement_theory (T: set) (a b c: nat)
 (ht: $ sfTheoryClosed T $) (ha: $ sfWf a $) (hb: $ sfWf b $) (hc: $ sfWf c $):
 $ sfTheoryProvable T sfWFClosure -> sfTheoryProvable T (sfWFReplacementRaw a b c) ->
   sfTheoryProvable T (sfWFReplacementGuarded a b c) $;
