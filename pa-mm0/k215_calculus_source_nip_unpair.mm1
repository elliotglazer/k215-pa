theorem k215UnpairAt4737AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt4737State k215PNum4737 0 b (suc n) c) (k215UnpairAt4737State k215PNum4737 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
