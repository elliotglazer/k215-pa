theorem k215UnpairAt4737Claim_all (n c: nat): $ k215UnpairAt4737Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt4737RunZero)) '(iald @ iald k215UnpairAt4737RunInductive));
pub theorem k215UnpairMacro4737 (n a b c: nat): $ k215PReach (k215UnpairAt4737State k215PNum4737 a b n c) (k215UnpairAt4737State k215PNum4745 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
