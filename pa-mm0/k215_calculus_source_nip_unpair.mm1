@_ abstract def k215UnpairAt4737Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt4737State k215PNum4737 a b n c) (k215UnpairAt4737State k215PNum4745 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
