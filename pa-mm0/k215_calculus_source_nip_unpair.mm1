theorem k215UnpairAt4737Step12 (a b n c: nat): $ k215PStep (k215UnpairAt4737State k215PNum4740 a b n c) = (k215UnpairAt4737State k215PNum4744 a b n c) $ = '(k215PAtCB k215PLookupUnpair4737_4740);

theorem k215UnpairAt4737Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt4737State k215PNum4740 a b n c) (k215UnpairAt4737State k215PNum4744 a b n c) $ = '(k215PReach_step k215UnpairAt4737Step12);

