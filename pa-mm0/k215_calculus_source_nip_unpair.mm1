pub theorem k215UnpairAt4737Advance (a b n c: nat): $ k215PReach (k215UnpairAt4737State k215PNum4737 a b (suc n) c) (k215UnpairAt4737State k215PNum4737 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
