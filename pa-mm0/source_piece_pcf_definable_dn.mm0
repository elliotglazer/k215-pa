import "source_piece_pcf_definable_recipe.mm0";

def sfPieceDefinableDnBox (a:nat): nat = $ sfAll (sfImp (sfMem 0 2) (sfRename sfPieceRotate 0 a)) $;

theorem sfPieceDefinableDnBox_wf (a:nat): $ sfWf (sfPieceDefinableDnBox a) $;

theorem sfPieceDefinableDnBox_intro (a:nat): $ nsLocal 0 a -> nsLocal 0 (sfPieceDefinableDnBox a) $;

theorem sfPieceDefinableDnBox_imp (a b:nat): $ nsLocal 0 (sfImp a b) -> nsLocal 0 (sfImp (sfPieceDefinableDnBox a) (sfPieceDefinableDnBox b)) $;

theorem sfPieceDefinableDnBox_apply (a b:nat): $ nsLocal 0 (sfImp (sfPieceDefinableDnBox (sfImp a b)) (sfImp (sfPieceDefinableDnBox a) (sfPieceDefinableDnBox b))) $;

theorem sfPieceDefinableDn_intro (n a:nat): $ nsLocal 0 a -> nsLocal 0 (sfPieceDn n a) $;

theorem sfPieceDefinableDn_apply_pure (n a b:nat)(ha:$ sfWf a $)(hb:$ sfWf b $): $ nsLocal 0 (sfImp (sfPieceDn n (sfImp a b)) (sfImp (sfPieceDn n a) (sfPieceDn n b))) $;

theorem sfPieceDefinableDn_apply (G n a b:nat)(ha:$ sfWf a $)(hb:$ sfWf b $)(hi:$ nsLocal G (sfPieceDn n (sfImp a b)) $)(hp:$ nsLocal G (sfPieceDn n a) $): $ nsLocal G (sfPieceDn n b) $;
