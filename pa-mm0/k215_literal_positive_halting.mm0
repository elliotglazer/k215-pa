import "k215_literal_control.mm0";

theorem k215TmControlProgress_reach (s t: nat):
 $ k215TmControlProgress s t -> k215TMReach s t $;

theorem k215TmControlProgress_budget (s t n: nat):
 $ k215TmControlProgress s t ->
   k215TMQ (k215TMRun (suc n) s) = k215Num215 ->
   k215TMQ (k215TMRun n t) = k215Num215 $;
