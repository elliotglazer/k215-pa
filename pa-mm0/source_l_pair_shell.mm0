import "source_l_pair_common2_syntax.mm0";
import "source_l_pair_shell_replay.mm0";

def slPEF0: nat = $ sfMem 0 1 $;

def slPEF1: nat = $ sfEq 0 3 $;

def slPEF2: nat = $ sfEq 0 2 $;

def slPEF3: nat = $ sfOr slPEF1 slPEF2 $;

def slPEF4: nat = $ sfImp slPEF0 slPEF3 $;

def slPEF5: nat = $ sfImp slPEF3 slPEF0 $;

def slPEF6: nat = $ sfAnd slPEF4 slPEF5 $;

def slPEF7: nat = $ sfAll slPEF6 $;

def slPEF8: nat = $ sfImp sfLDomain slPEF6 $;

def slPEF9: nat = $ sfAll slPEF8 $;

def slPEF10: nat = $ sfEx slPEF7 $;

def slPEF11: nat = $ sfAnd sfLDomain slPEF9 $;

def slPEF12: nat = $ sfEx slPEF11 $;

def slPEF13: nat = $ sfAll slPEF10 $;

def slPEF14: nat = $ sfImp sfLDomain slPEF12 $;

def slPEF15: nat = $ sfAll slPEF14 $;

def sfLPairNextLevel: nat = $ slPFF817 $;


theorem sfLPairShell_context: $ slPFContext = sfLBackground $;

theorem sfLPairShell_formula: $ slPFFormula = sfImp sfLDefPair (sfImp sfLPairNextLevel (sfImp sfLPairCommon2 (sfRelativize sfLDomain zfcPair))) $;

theorem sfLPairShell_local: $ nsLocal sfLBackground (sfImp sfLDefPair (sfImp sfLPairNextLevel (sfImp sfLPairCommon2 (sfRelativize sfLDomain zfcPair)))) $;

theorem sfLPairShell_zfr: $ sfTheoryProvable zfrAxioms (sfImp sfLDefPair (sfImp sfLPairNextLevel (sfImp sfLPairCommon2 (sfRelativize sfLDomain zfcPair)))) $;

theorem sfLPair_from_levels: $ sfTheoryProvable zfrAxioms sfLPairNextLevel -> sfTheoryProvable zfrAxioms sfLPairCommon2 -> sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcPair) $;
