@_ def k218QMName (H k: nat): nat = $ kFreshAllocate H 0 0 k $;

pub theorem k218QMName_above (H k: nat): $ k < k218QMName H k $ = 'kFreshAllocate_above_reserved;

pub theorem k218QMName_positive (H k: nat): $ 0 < k218QMName H k $ = 'lt01S;

pub theorem k218QMName_vacuous (H k: nat): $ k218IContextVacuous H (k218QMName H k) $ = '(ax_mp k218IContextFresh_vacuous kFreshAllocate_context);

pub theorem k218QMF_safe_raised (G: wff) (H S n t k: nat) (hs: $ G -> sqEnvironmentSafe S n t k $): $ G -> sqEnvironmentSafe S n t (k218QMName H k) $ = '(syl (ax_mp sqEnvironmentSafe_raise k218QMName_above) hs);

pub theorem k218QMF_safe_successor (G: wff) (H S n t k: nat) (hs: $ G -> sqEnvironmentSafe S n t k $): $ G -> sqEnvironmentSafe S n t (suc (k218QMName H k)) $ = '(syl (ax_mp sqEnvironmentSafe_raise (lttr k218QMName_above ltsucid)) hs);

pub theorem k218QMF_safe_child (G: wff) (H S n t k: nat) (hs: $ G -> sqEnvironmentSafe S n t k $): $ G -> sqEnvironmentSafe ((k218QMName H k) : S) (suc n) t (suc (k218QMName H k)) $ = '(syl (ax_mp sqEnvironmentSafe_cons ltsucid) (k218QMF_safe_successor hs));

pub theorem k218QMF_empty_child (G: wff) (H S n t k: nat) (hs: $ G -> sqEnvironmentSafe S n t k $) (he: $ G -> k218IHypProvable H (k218QAEmpty t k) $): $ G -> k218IHypProvable H (k218QAEmpty t (suc (k218QMName H k))) $ = '(k218QEquivForward (k218QM_empty_rebase (syl sqEnvironmentSafe_positive hs) (a1i lt01S) (syl sqEnvironmentSafe_tag hs) (syl sqEnvironmentSafe_tag (k218QMF_safe_successor hs))) he);

pub theorem k218QMF_mixed_child (G: wff) (H S T n t k: nat) (hs: $ G -> sqEnvironmentSafe S n t k $) (ht: $ G -> sqEnvironmentSafe T n t k $) (he: $ G -> k218IHypProvable H (k218QAEmpty t k) $) (hr: $ G -> k218QMixedEnv H S T n t k $): $ G -> k218QMixedEnv H ((k218QMName H k) : S) ((k218QMName H k) : T) (suc n) t (suc (k218QMName H k)) $ = '(syl k218QMixedEnv_cons (k218QMixedEnv_rebase hs ht (k218QMF_safe_successor hs) (k218QMF_safe_successor ht) hr));

pub theorem k218QMF_three (G: wff) (H a b c d: nat) (hab: $ G -> k218QHEquiv H a b $) (hbc: $ G -> k218QHEquiv H b c $) (hcd: $ G -> k218QHEquiv H c d $): $ G -> k218QHEquiv H a d $ = '(syl k218QHEquiv_trans (iand hab (syl k218QHEquiv_trans (iand hbc hcd))));

pub theorem k218QMF_numeric_all (G: wff) (S t k a: nat) (ha: $ G -> sfWf a $): $ G -> (sqQuote (sqNumericEnvironment S) t k 0 (sfAll a)) = (kAll k (kImp (kMem t k) (sqQuote (sqNumericEnvironment (k : S)) t (suc k) 0 a))) $ = '(eqtrd (syl sqQuote_all_cons ha) (kAlleq2d (kImpeq2d (eqcomd (syl sqNumeric_quote_cons ha)))));

theorem k218QMF_all_core (G: wff) (H S T n t k a: nat) (hs: $ G -> sqEnvironmentSafe S n t k $) (ht: $ G -> sqEnvironmentSafe T n t k $) (he: $ G -> k218IHypProvable H (k218QAEmpty t k) $) (hr: $ G -> k218QMixedEnv H S T n t k $) (hc: $ G -> a e. k218QMFormulaClass $) (hf: $ G -> sfBound n (sfAll a) $): $ G -> k218QHEquiv H (sqQuote (sqNumericEnvironment S) t k 0 (sfAll a)) (sqQuote (sqNumericEnvironment T) t k 0 (sfAll a)) $ = '(k218QMF_three (k218QMF_seed_equiv (k218QM_quote_rebase hf (syl sqEnvironmentSafe_positive hs) (a1i k218QMName_positive) (syl sqEnvironmentSafe_tag hs) (syl sqEnvironmentSafe_tag (k218QMF_safe_raised hs)) (syl sqEnvironmentSafe_live_below hs) (syl sqEnvironmentSafe_live_below (k218QMF_safe_raised hs)))) (k218QMF_transport (k218QMF_numeric_all (syl sfBound_wf (syl (bi1 sfBound_sfAll) hf))) (k218QMF_numeric_all (syl sfBound_wf (syl (bi1 sfBound_sfAll) hf))) (mpd (syl k218QHEquiv_imp (iand (a1i k218QHEquiv_refl) (k218QMFormula_use hc (syl (bi1 sfBound_sfAll) hf) (k218QMF_safe_child hs) (k218QMF_safe_child ht) (k218QMF_empty_child hs he) (k218QMF_mixed_child hs ht he hr)))) (a1i (ax_mp k218QHEquiv_all k218QMName_vacuous)))) (syl k218QHEquiv_sym (k218QMF_seed_equiv (k218QM_quote_rebase hf (syl sqEnvironmentSafe_positive ht) (a1i k218QMName_positive) (syl sqEnvironmentSafe_tag ht) (syl sqEnvironmentSafe_tag (k218QMF_safe_raised ht)) (syl sqEnvironmentSafe_live_below ht) (syl sqEnvironmentSafe_live_below (k218QMF_safe_raised ht))))));

theorem k218QMF_all (a: nat): $ a e. k218QMFormulaClass -> (sfAll a) e. k218QMFormulaClass $ = (named '(mpbird (a1i k218QMFormula_value) @ !! iald H @ !! iald S @ !! iald T @ !! iald n @ !! iald t @ !! iald k @ exp @ exp @ exp @ exp @ exp @ k218QMF_all_core (syl (syl (syl anr anl) anl) anl) (syl (syl anr anl) anl) (syl anr anl) anr (syl (syl (syl (syl (syl id anl) anl) anl) anl) anl) (syl (syl (syl (syl anr anl) anl) anl) anl)));

pub theorem k218QMF_numeric_exists (G: wff) (S t k a: nat) (ha: $ G -> sfWf a $): $ G -> (sqQuote (sqNumericEnvironment S) t k 0 (sfEx a)) = (kExists k (kAnd (kMem t k) (sqQuote (sqNumericEnvironment (k : S)) t (suc k) 0 a))) $ = '(eqtrd (syl sqQuote_ex_cons ha) (kExistseq2d (kAndeq2d (eqcomd (syl sqNumeric_quote_cons ha)))));

theorem k218QMF_exists_core (G: wff) (H S T n t k a: nat) (hs: $ G -> sqEnvironmentSafe S n t k $) (ht: $ G -> sqEnvironmentSafe T n t k $) (he: $ G -> k218IHypProvable H (k218QAEmpty t k) $) (hr: $ G -> k218QMixedEnv H S T n t k $) (hc: $ G -> a e. k218QMFormulaClass $) (hf: $ G -> sfBound n (sfEx a) $): $ G -> k218QHEquiv H (sqQuote (sqNumericEnvironment S) t k 0 (sfEx a)) (sqQuote (sqNumericEnvironment T) t k 0 (sfEx a)) $ = '(k218QMF_three (k218QMF_seed_equiv (k218QM_quote_rebase hf (syl sqEnvironmentSafe_positive hs) (a1i k218QMName_positive) (syl sqEnvironmentSafe_tag hs) (syl sqEnvironmentSafe_tag (k218QMF_safe_raised hs)) (syl sqEnvironmentSafe_live_below hs) (syl sqEnvironmentSafe_live_below (k218QMF_safe_raised hs)))) (k218QMF_transport (k218QMF_numeric_exists (syl sfBound_wf (syl (bi1 sfBound_sfEx) hf))) (k218QMF_numeric_exists (syl sfBound_wf (syl (bi1 sfBound_sfEx) hf))) (mpd (syl k218QHEquiv_and (iand (a1i k218QHEquiv_refl) (k218QMFormula_use hc (syl (bi1 sfBound_sfEx) hf) (k218QMF_safe_child hs) (k218QMF_safe_child ht) (k218QMF_empty_child hs he) (k218QMF_mixed_child hs ht he hr)))) (a1i (ax_mp k218QHEquiv_exists k218QMName_vacuous)))) (syl k218QHEquiv_sym (k218QMF_seed_equiv (k218QM_quote_rebase hf (syl sqEnvironmentSafe_positive ht) (a1i k218QMName_positive) (syl sqEnvironmentSafe_tag ht) (syl sqEnvironmentSafe_tag (k218QMF_safe_raised ht)) (syl sqEnvironmentSafe_live_below ht) (syl sqEnvironmentSafe_live_below (k218QMF_safe_raised ht))))));

theorem k218QMF_exists (a: nat): $ a e. k218QMFormulaClass -> (sfEx a) e. k218QMFormulaClass $ = (named '(mpbird (a1i k218QMFormula_value) @ !! iald H @ !! iald S @ !! iald T @ !! iald n @ !! iald t @ !! iald k @ exp @ exp @ exp @ exp @ exp @ k218QMF_exists_core (syl (syl (syl anr anl) anl) anl) (syl (syl anr anl) anl) (syl anr anl) anr (syl (syl (syl (syl (syl id anl) anl) anl) anl) anl) (syl (syl (syl (syl anr anl) anl) anl) anl)));

theorem k218QMF_quantifiers: $ sfQuantifierClosed k218QMFormulaClass $ = (named '(ax_gen (iand k218QMF_all k218QMF_exists)));

pub theorem k218QMFormula_closed: $ sfConstructionClosed k218QMFormulaClass $ = '(ian (ian (ian k218QMF_bot k218QMF_atomic) k218QMF_binary) k218QMF_quantifiers);

pub theorem k218QMFormula_member (c: nat): $ sfWf c -> c e. k218QMFormulaClass $ = '(ax_mp sfWf_induction k218QMFormula_closed);

pub theorem k218QM_formula_invariance (H S T n t k c: nat): $ sfBound n c -> sqEnvironmentSafe S n t k -> sqEnvironmentSafe T n t k -> k218IHypProvable H (k218QAEmpty t k) -> k218QMixedEnv H S T n t k -> k218QHEquiv H (sqQuote (sqNumericEnvironment S) t k 0 c) (sqQuote (sqNumericEnvironment T) t k 0 c) $ = '(mpd id (syl k218QMFormula_at (syl k218QMFormula_member sfBound_wf)));
