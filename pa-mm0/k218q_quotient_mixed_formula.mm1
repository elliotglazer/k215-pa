import "k218q_quotient_mixed_environment.mm1";

@_ abstract def k218QMFormulaClass (.c .H .S .T .n .t .k: nat): set = $ {c | A. H A. S A. T A. n A. t A. k (sfBound n c -> sqEnvironmentSafe S n t k -> sqEnvironmentSafe T n t k -> k218IHypProvable H (k218QAEmpty t k) -> k218QMixedEnv H S T n t k -> k218QHEquiv H (sqQuote (sqNumericEnvironment S) t k 0 c) (sqQuote (sqNumericEnvironment T) t k 0 c))} $;

pub theorem k218QMFormula_value {H S T n t k: nat} (c: nat): $ c e. k218QMFormulaClass <-> A. H A. S A. T A. n A. t A. k (sfBound n c -> sqEnvironmentSafe S n t k -> sqEnvironmentSafe T n t k -> k218IHypProvable H (k218QAEmpty t k) -> k218QMixedEnv H S T n t k -> k218QHEquiv H (sqQuote (sqNumericEnvironment S) t k 0 c) (sqQuote (sqNumericEnvironment T) t k 0 c)) $ = (named '(elabe ,eqtac));

theorem k218QMFormula_all_at (c H S T n t k: nat): $ (A. J A. U A. V A. m A. r A. l (sfBound m c -> sqEnvironmentSafe U m r l -> sqEnvironmentSafe V m r l -> k218IHypProvable J (k218QAEmpty r l) -> k218QMixedEnv J U V m r l -> k218QHEquiv J (sqQuote (sqNumericEnvironment U) r l 0 c) (sqQuote (sqNumericEnvironment V) r l 0 c))) -> sfBound n c -> sqEnvironmentSafe S n t k -> sqEnvironmentSafe T n t k -> k218IHypProvable H (k218QAEmpty t k) -> k218QMixedEnv H S T n t k -> k218QHEquiv H (sqQuote (sqNumericEnvironment S) t k 0 c) (sqQuote (sqNumericEnvironment T) t k 0 c) $ = (named '(!! ealie J @ !! ealde U @ !! ealde V @ !! ealde m @ !! ealde r @ !! ealde l @ bi1d ,eqtac));

pub theorem k218QMFormula_at (c H S T n t k: nat): $ c e. k218QMFormulaClass -> sfBound n c -> sqEnvironmentSafe S n t k -> sqEnvironmentSafe T n t k -> k218IHypProvable H (k218QAEmpty t k) -> k218QMixedEnv H S T n t k -> k218QHEquiv H (sqQuote (sqNumericEnvironment S) t k 0 c) (sqQuote (sqNumericEnvironment T) t k 0 c) $ = (named '(syl k218QMFormula_all_at (bi1 k218QMFormula_value)));

pub theorem k218QMFormula_use (G: wff) (c H S T n t k: nat) (hc: $ G -> c e. k218QMFormulaClass $) (hb: $ G -> sfBound n c $) (hs: $ G -> sqEnvironmentSafe S n t k $) (ht: $ G -> sqEnvironmentSafe T n t k $) (he: $ G -> k218IHypProvable H (k218QAEmpty t k) $) (hr: $ G -> k218QMixedEnv H S T n t k $): $ G -> k218QHEquiv H (sqQuote (sqNumericEnvironment S) t k 0 c) (sqQuote (sqNumericEnvironment T) t k 0 c) $ = '(mpd hr (mpd he (mpd ht (mpd hs (mpd hb (syl k218QMFormula_at hc))))));

pub theorem k218QMF_transport (G: wff) (H a b ap bp: nat) (ha: $ G -> a = ap $) (hb: $ G -> b = bp $) (he: $ G -> k218QHEquiv H ap bp $): $ G -> k218QHEquiv H a b $ = '(mpbird (k218QHEquiveqd eqidd ha hb) he);

pub theorem k218QMF_seed_equiv (G: wff) (H a b: nat) (he: $ G -> k218IEquivalent a b $): $ G -> k218QHEquiv H a b $ = '(iand (syl k218IHypProvable_seed (syl anl he)) (syl k218IHypProvable_seed (syl anr he)));

