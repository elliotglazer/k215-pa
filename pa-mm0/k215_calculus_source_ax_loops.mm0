def k215Loop26State (pc x y z c: nat): nat = $ k215PState pc (k215PVector z x (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) y (k215PR7 c) (k215PR8 c)) $;

def k215Loop26Claim (x c: nat) (.y .z: nat): wff =
 $ A. y A. z k215PIter (3 * x + 1) (k215Loop26State k215Num26 x y z c) = (k215Loop26State k215Num29 0 (x + y) z c) $;

theorem k215Loop26Transfer (x y z c: nat): $ k215PIter (3 * x + 1) (k215Loop26State k215Num26 x y z c) = (k215Loop26State k215Num29 0 (x + y) z c) $;

theorem k215Loop26Vector (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ k215PIter (3 * a1 + 1) (k215PState k215Num26 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) =
   k215PState k215Num29 (k215PVector a0 0 a2 a3 a4 a5 (a1 + a6) a7 a8) $;

