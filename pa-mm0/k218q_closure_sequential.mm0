import "k218q_closure_fresh_base.mm0";
import "k218_named_core.mm0";

def k218ClosureSequential (E: set) (n B a b c f: nat): nat =
 $ (kAll (suc (suc (k218ClosureSourceBase E B a b c f))) (kImp (kMem (suc (suc (k218ClosureSourceBase E B a b c f))) c) (kExists (suc (suc (suc (k218ClosureSourceBase E B a b c f)))) (kAnd (sfNamedTemplate (sqEnvCons (suc (suc (k218ClosureSourceBase E B a b c f))) (sqEnvCons (suc (suc (suc (k218ClosureSourceBase E B a b c f)))) E)) (k218ClosureMatrixBase E B a b c f) 0 f) (kAll (suc (suc (suc (suc (k218ClosureSourceBase E B a b c f))))) (kImp (kAll (suc (suc (suc (suc (suc (k218ClosureSourceBase E B a b c f)))))) (kImp (kMem (suc (suc (suc (suc (suc (k218ClosureSourceBase E B a b c f)))))) (suc (suc (suc (suc (k218ClosureSourceBase E B a b c f)))))) (kMem (suc (suc (suc (suc (suc (k218ClosureSourceBase E B a b c f)))))) (suc (suc (k218ClosureSourceBase E B a b c f)))))) (kAll (suc (suc (suc (suc (suc (k218ClosureSourceBase E B a b c f)))))) (kImp (sfNamedTemplate (sqEnvCons (suc (suc (suc (suc (suc (k218ClosureSourceBase E B a b c f)))))) (sqEnvCons (suc (suc (suc (suc (k218ClosureSourceBase E B a b c f))))) E)) (k218ClosureMatrixBase E B a b c f) 0 f) (kExists (suc (suc (suc (suc (suc (suc (k218ClosureSourceBase E B a b c f))))))) (kAnd (sfNamedTemplate (sqEnvCons (suc (suc (suc (suc (suc (suc (k218ClosureSourceBase E B a b c f))))))) (sqEnvCons (suc (suc (suc (suc (k218ClosureSourceBase E B a b c f))))) E)) (k218ClosureMatrixBase E B a b c f) 0 f) (kMem (suc (suc (suc (suc (suc (suc (k218ClosureSourceBase E B a b c f))))))) c))))))))))) $;

theorem k218QClosure_sequential {j: nat} (E: set) (n B a b c f: nat)
 (he: $ A. j (j < n -> E @ j < B) $) (hf: $ sfBound (suc (suc n)) f $):
 $ k218IEquivalent (k218ClosureRebased E n B a b c f) (k218ClosureSequential E n B a b c f) $;
