import "source_piece_pcf_above.mm0";

import "source_piece_pcf_row_transport.mm0";

import "source_piece_pcf_function_join.mm0";

theorem sfPieceFunctionCanonicalRows_exist(E:set)(n:nat)
 (he:$ sfTheoryProvable zfrAxioms sfPieceLevelEx $)
 (hs:$ sfTheoryProvable zfrAxioms sfPieceLevelSub $):
 $ sfPieceFunctionTableValid E n -> sfPieceFunctionRowWitnesses sfLDomain sfPieceCanonicalLevel E n $;

theorem sfPieceFunctionCanonicalTable_witnesses(E:set)(n:nat)
 (he:$ sfTheoryProvable zfrAxioms sfPieceLevelEx $)
 (hs:$ sfTheoryProvable zfrAxioms sfPieceLevelSub $):
 $ sfPieceFunctionTableValid E n -> sfPieceFunctionTableWitnesses sfLDomain sfPieceCanonicalLevel E n $;

theorem sfPieceFunctionPCf_exists_from_levels(E:set)(n:nat)
 (he:$ sfTheoryProvable zfrAxioms sfPieceLevelEx $)
 (hs:$ sfTheoryProvable zfrAxioms sfPieceLevelSub $):
 $ sfPieceFunctionTableValid E n ->
   sfTheoryProvable zfrAxioms (sfEx (sfAnd sfLeastOrdinalPredicate
    (sfPieceFunctionBinary sfLDomain sfPieceCanonicalLevel E n))) $;

theorem sfPieceFunctionPCf_mono_from_levels(E:set)(n:nat)
 (he:$ sfTheoryProvable zfrAxioms sfPieceLevelEx $)
 (hs:$ sfTheoryProvable zfrAxioms sfPieceLevelSub $):
 $ sfPieceFunctionTableValid E n ->
   sfTheoryProvable zfrAxioms (sfPieceMonoCode
    (sfPieceFunctionBinary sfLDomain sfPieceCanonicalLevel E n)) $;

theorem sfPieceFunctionPCf_binary_bound(E:set)(n:nat):
 $ sfPieceFunctionTableValid E n -> sfBound 2 (sfPieceFunctionBinary sfLDomain sfPieceCanonicalLevel E n) $;
