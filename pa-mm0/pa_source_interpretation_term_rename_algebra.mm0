import "pa_source_interpretation_term_induction.mm0";

import "pa_source_interpretation_term_renaming.mm0";

def paTMIdentityClass (.c: nat): set = $ {c | paTermRename sfIdentityMap c = c} $;

theorem paTermRename_identity (n c: nat): $ paTermBound n c -> paTermRename sfIdentityMap c = c $;

def paTMComposeClass (R S: set) (.c: nat): set = $ {c | paTermRename R (paTermRename S c) = paTermRename (sfComposeMap R S) c} $;

theorem paTermRename_compose (R S: set) (n c: nat): $ paTermBound n c -> paTermRename R (paTermRename S c) = paTermRename (sfComposeMap R S) c $;
