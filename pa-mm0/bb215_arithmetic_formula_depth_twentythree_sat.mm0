import "pa_source_interpretation_nat_term_assignment.mm0";

def bb215ArithmeticFormulaDepthTwentythreeSatBody (E: set) (c h .x: nat): wff = $ ifp (c = 0) (0 != 0) (ifp (sfTag c = 1) (bb215ArithmeticFormulaTermValue E (sfLeft c) = bb215ArithmeticFormulaTermValue E (sfRight c)) (ifp (sfTag c = 3) (sfLeft c e. h /\ sfRight c e. h) (ifp (sfTag c = 4) (sfLeft c e. h \/ sfRight c e. h) (ifp (sfTag c = 5) (sfLeft c e. h -> sfRight c e. h) (ifp (sfTag c = 6 /\ sfRight c = 0) (A. x bb215ArithmeticFormulaDepthTwentytwoSat (paNatTermConsEnvironment E x) (sfLeft c)) (ifp (sfTag c = 7 /\ sfRight c = 0) (E. x bb215ArithmeticFormulaDepthTwentytwoSat (paNatTermConsEnvironment E x) (sfLeft c)) (0 != 0))))))) $;

def bb215ArithmeticFormulaDepthTwentythreeSatStep (E: set) (.c .h: nat): set = $ S\ c, {h | bb215ArithmeticFormulaDepthTwentythreeSatBody E c h} $;

def bb215ArithmeticFormulaDepthTwentythreeSat (E: set) (c: nat): wff = $ srecp (bb215ArithmeticFormulaDepthTwentythreeSatStep E) c $;

def bb215ArithmeticFormulaDepthTwentythreeSatPrevious (E: set) (c .i: nat): nat = $ sep (upto c) {i | srecp (bb215ArithmeticFormulaDepthTwentythreeSatStep E) i} $;

theorem bb215ArithmeticFormulaDepthTwentythreeSatStep_value (E: set) (c h: nat): $ (c, h) e. bb215ArithmeticFormulaDepthTwentythreeSatStep E <-> bb215ArithmeticFormulaDepthTwentythreeSatBody E c h $;

theorem bb215ArithmeticFormulaDepthTwentythreeSatPrevious_value (E: set) (c a: nat): $ a e. bb215ArithmeticFormulaDepthTwentythreeSatPrevious E c <-> a < c /\ bb215ArithmeticFormulaDepthTwentythreeSat E a $;

theorem bb215ArithmeticFormulaDepthTwentythreeSat_unfold (E: set) (c: nat): $ bb215ArithmeticFormulaDepthTwentythreeSat E c <-> bb215ArithmeticFormulaDepthTwentythreeSatBody E c (bb215ArithmeticFormulaDepthTwentythreeSatPrevious E c) $;

theorem bb215ArithmeticFormulaDepthTwentythreeSat_false (E: set): $ bb215ArithmeticFormulaDepthTwentythreeSat E paFormulaFalse <-> 0 != 0 $;

theorem bb215ArithmeticFormulaDepthTwentythreeSat_equal (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthTwentythreeSat E (paFormulaEqual a b) <-> bb215ArithmeticFormulaTermValue E a = bb215ArithmeticFormulaTermValue E b $;

theorem bb215ArithmeticFormulaDepthTwentythreeSat_and (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthTwentythreeSat E (paFormulaAnd a b) <-> (bb215ArithmeticFormulaDepthTwentythreeSat E a /\ bb215ArithmeticFormulaDepthTwentythreeSat E b) $;

theorem bb215ArithmeticFormulaDepthTwentythreeSat_or (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthTwentythreeSat E (paFormulaOr a b) <-> (bb215ArithmeticFormulaDepthTwentythreeSat E a \/ bb215ArithmeticFormulaDepthTwentythreeSat E b) $;

theorem bb215ArithmeticFormulaDepthTwentythreeSat_imp (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthTwentythreeSat E (paFormulaImp a b) <-> (bb215ArithmeticFormulaDepthTwentythreeSat E a -> bb215ArithmeticFormulaDepthTwentythreeSat E b) $;

theorem bb215ArithmeticFormulaDepthTwentythreeSat_all (E: set) (a: nat) {x: nat}: $ bb215ArithmeticFormulaDepthTwentythreeSat E (paFormulaAll a) <-> A. x bb215ArithmeticFormulaDepthTwentytwoSat (paNatTermConsEnvironment E x) a $;

theorem bb215ArithmeticFormulaDepthTwentythreeSat_ex (E: set) (a: nat) {x: nat}: $ bb215ArithmeticFormulaDepthTwentythreeSat E (paFormulaEx a) <-> E. x bb215ArithmeticFormulaDepthTwentytwoSat (paNatTermConsEnvironment E x) a $;
