import "source_k0_qsep_marker_point.mm0";

import "quotation_substitution.mm0";

import "quotation_binders_absent.mm0";

import "k218q_specialization.mm0";

import "k218_role_substitution.mm0";

-- The arbitrary matrix is transformed from the x environment to the t
-- environment using the checked source substitution theorem, not frozen.
theorem sfK0QSep_general_profile_substitution (E: set) (n t a b c x K theta: nat)
 (hf: $ sfBound (suc n) theta $) (hz: $ x != 0 $)
 (ht: $ t != x $) (ha: $ a != x $) (hb: $ b != x $) (hc: $ c != x $)
 (he: $ sqEnvAvoid E n x $) (hxK: $ x < K $) (htK: $ t < K $):
 $ kSubst (sfK0QSepRawProfile t a b c x (sfNamedTemplate (sqEnvCons x E) K 0 theta)) x t = (sfK0QSepRawProfile t a b c t (sfNamedTemplate (sqEnvCons t E) K 0 theta)) $;

theorem sfK0QSep_general_profile_specialization (E: set) (n t a b c x K theta: nat)
 (hf: $ sfBound (suc n) theta $) (hz: $ x != 0 $)
 (ht: $ t != x $) (ha: $ a != x $) (hb: $ b != x $) (hc: $ c != x $)
 (he: $ sqEnvAvoid E n x $) (hxK: $ x < K $) (htK: $ t < K $) (htx: $ t < x $):
 $ k218QProvable (kImp (kAll x (sfK0QSepRawProfile t a b c x (sfNamedTemplate (sqEnvCons x E) K 0 theta))) (sfK0QSepRawProfile t a b c t (sfNamedTemplate (sqEnvCons t E) K 0 theta))) $;

theorem sfK0QSep_general_marker_from_profile (E: set) (n t a b c x K theta: nat)
 (hf: $ sfBound (suc n) theta $) (hz: $ x != 0 $)
 (ht: $ t != x $) (ha: $ a != x $) (hb: $ b != x $) (hc: $ c != x $)
 (he: $ sqEnvAvoid E n x $) (hxK: $ x < K $) (htK: $ t < K $) (htx: $ t < x $):
 $ k218QProvable (kImp (kAll x (sfK0QSepRawProfile t a b c x (sfNamedTemplate (sqEnvCons x E) K 0 theta))) (kMem t c)) $;
