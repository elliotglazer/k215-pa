theorem k215UnpairAt4631AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt4631State k215PNum4631 0 b (suc n) c) (k215UnpairAt4631State k215PNum4631 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
