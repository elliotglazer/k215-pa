theorem k215UnpairAt4631Step12 (a b n c: nat): $ k215PStep (k215UnpairAt4631State k215PNum4634 a b n c) = (k215UnpairAt4631State k215PNum4638 a b n c) $ = '(k215PAtCB k215PLookupUnpair4631_4634);

theorem k215UnpairAt4631Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt4631State k215PNum4634 a b n c) (k215UnpairAt4631State k215PNum4638 a b n c) $ = '(k215PReach_step k215UnpairAt4631Step12);

