pub theorem k215UnpairAt4631Advance (a b n c: nat): $ k215PReach (k215UnpairAt4631State k215PNum4631 a b (suc n) c) (k215UnpairAt4631State k215PNum4631 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
