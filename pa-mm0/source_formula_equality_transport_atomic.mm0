import "source_local_extra.mm0";

import "source_structural_induction.mm0";

def sfFormulaEqualityContext: nat = $ zfcRefl : (zfcSym : (zfcTrans : (zfcEqElem : 0))) $;

theorem sfFormulaEqualityContext_wf:
 $ sfContextWf sfFormulaEqualityContext $;

theorem sfFormulaEqualityContext_allowed:
 $ zfcContext sfFormulaEqualityContext $;

theorem sfFormulaEqualityContext_shift:
 $ sfContextShift sfFormulaEqualityContext = sfFormulaEqualityContext $;

theorem sfFormulaEquality_refl_local (a: nat):
 $ nsLocal sfFormulaEqualityContext (sfEq a a) $;

theorem sfFormulaEquality_sym_local (a b: nat):
 $ nsLocal sfFormulaEqualityContext (sfImp (sfEq a b) (sfEq b a)) $;

theorem sfFormulaEquality_trans_local (a b c: nat):
 $ nsLocal sfFormulaEqualityContext (sfImp (sfEq a b) (sfImp (sfEq b c) (sfEq a c))) $;

theorem sfFormulaEquality_element_local (a b c d: nat):
 $ nsLocal sfFormulaEqualityContext (sfImp (sfEq a c) (sfImp (sfEq b d) (sfImp (sfMem a b) (sfMem c d)))) $;
