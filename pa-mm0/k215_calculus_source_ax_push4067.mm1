theorem k215PairVectorInAt4067 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt4073State k215PNum4073 a6 a1 a7 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum4073 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215PairVectorOutAt4067 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt4073State k215PNum4083 0 0 (a7 + (a6, a1)) (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum4083 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

pub theorem k215PairMacro46_vectorAt4067 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat):
 $ k215PReach (k215PState k215PNum4073 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215PNum4083 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ =
 '(mpbi (k215PReacheq k215PairVectorInAt4067 k215PairVectorOutAt4067) k215PairMacro4073);

theorem k215PushAStage0At4067 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum4067 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum4070 (k215PVector u 0 w c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop4067Vector (k215PStateeq2 (k215PVectoreq7 add0))));

theorem k215PushAStage1At4067 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum4070 (k215PVector u 0 w c a b t 0 v)) (k215PState k215PNum4073 (k215PVector u w 0 c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop4070Vector (k215PStateeq2 (k215PVectoreq2 add0))));

theorem k215PushAStage2At4067 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum4073 (k215PVector u w 0 c a b t 0 v)) (k215PState k215PNum4083 (k215PVector u 0 0 c a b 0 (t, w) v)) $ = '(mpbi (k215PReacheq2 (k215PStateeq2 (k215PVectoreq8 add01))) k215PairMacro46_vectorAt4067);

theorem k215PushAStage3At4067 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum4083 (k215PVector u 0 0 c a b 0 (t, w) v)) (k215PState k215PNum4086 (k215PVector u 0 (t, w) c a b 0 0 v)) $ = '(k215PReach_intro (eqtr k215Loop4083Vector (k215PStateeq2 (k215PVectoreq3 add0))));

theorem k215PushAStage4At4067 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum4086 (k215PVector u 0 (t, w) c a b 0 0 v)) (k215PState k215PNum4090 (k215PVector u c (t, w) 0 a b c 0 v)) $ = '(k215PReach_intro (eqtr k215Loop4086Vector (k215PStateeq2 (k215PVectoreq eqid add0 eqid eqid eqid eqid add0 eqid eqid))));

theorem k215PushAStage5At4067 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum4090 (k215PVector u c (t, w) 0 a b c 0 v)) (k215PState k215PNum4093 (k215PVector u c (t, w) c a b 0 0 v)) $ = '(k215PReach_intro (eqtr k215Loop4090Vector (k215PStateeq2 (k215PVectoreq4 add0))));

pub theorem k215PushParam4067 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum4067 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum4093 (k215PVector u c (t, w) c a b 0 0 v)) $ = '(ax_mp (ax_mp k215PReach_trans k215PushAStage0At4067) (ax_mp (ax_mp k215PReach_trans k215PushAStage1At4067) (ax_mp (ax_mp k215PReach_trans k215PushAStage2At4067) (ax_mp (ax_mp k215PReach_trans k215PushAStage3At4067) (ax_mp (ax_mp k215PReach_trans k215PushAStage4At4067) k215PushAStage5At4067)))));

