import "source_relative_invariant.mm0";

theorem sfRelativeCase_II (D r p: nat) (hd: $ sfWf D $):
  $ sfRowWf r -> sfNDCaseII r p -> sfRelativeGood D p -> sfRelativeGood D r $;

theorem sfRelativeCase_Exp (D r p: nat) (hd: $ sfWf D $):
  $ sfRowWf r -> sfNDCaseExp r p -> sfRelativeGood D p -> sfRelativeGood D r $;

theorem sfRelativeCase_CE1 (D r p: nat) (hd: $ sfWf D $):
  $ sfRowWf r -> sfNDCaseCE1 r p -> sfRelativeGood D p -> sfRelativeGood D r $;

theorem sfRelativeCase_CE2 (D r p: nat) (hd: $ sfWf D $):
  $ sfRowWf r -> sfNDCaseCE2 r p -> sfRelativeGood D p -> sfRelativeGood D r $;

theorem sfRelativeCase_DI1 (D r p: nat) (hd: $ sfWf D $):
  $ sfRowWf r -> sfNDCaseDI1 r p -> sfRelativeGood D p -> sfRelativeGood D r $;

theorem sfRelativeCase_DI2 (D r p: nat) (hd: $ sfWf D $):
  $ sfRowWf r -> sfNDCaseDI2 r p -> sfRelativeGood D p -> sfRelativeGood D r $;

theorem sfRelativeCase_Ctx (D r: nat) (hd: $ sfWf D $):
  $ sfRowWf r -> sfNDCaseCtx r -> sfRelativeGood D r $;

theorem sfRelativeCase_Pc (D r: nat) (hd: $ sfWf D $):
  $ sfRowWf r -> sfNDCasePc r -> sfRelativeGood D r $;

theorem sfRelative_prop_base (D r: nat) (hd: $ sfWf D $):
  $ sfNDPropBase r -> sfRelativeGood D r $;

theorem sfRelative_common_bound {n: nat} (D p q: nat) (hd: $ sfWf D $):
  $ sfRelativeGood D p -> sfRelativeGood D q ->
    E. n (sfRelativeAt D n p /\ sfRelativeAt D n q) $;

theorem sfRelativeCase_Wk (D r p: nat) (hd: $ sfWf D $):
  $ sfRowWf r -> sfNDCaseWk r p -> sfRelativeGood D p -> sfRelativeGood D r $;

theorem sfRelative_prop_unary (D r p: nat) (hd: $ sfWf D $):
  $ sfNDPropUnary r p -> sfRelativeGood D p -> sfRelativeGood D r $;

theorem sfRelativeCase_IE (D r p q: nat) (hd: $ sfWf D $):
  $ sfRowWf r -> sfNDCaseIE r p q ->
    sfRelativeGood D p -> sfRelativeGood D q -> sfRelativeGood D r $;

theorem sfRelativeCase_CI (D r p q: nat) (hd: $ sfWf D $):
  $ sfRowWf r -> sfNDCaseCI r p q ->
    sfRelativeGood D p -> sfRelativeGood D q -> sfRelativeGood D r $;

theorem sfRelativeCase_BranchPair (D r p q: nat) (hd: $ sfWf D $):
  $ sfRowWf r -> sfNDCaseBranchPair r p q ->
    sfRelativeGood D p -> sfRelativeGood D q -> sfRelativeGood D r $;

theorem sfRelativeCase_DE (D r p q: nat) (hd: $ sfWf D $):
  $ sfRowWf r -> sfNDCaseDE r p q ->
    sfRelativeGood D p -> sfRelativeGood D q -> sfRelativeGood D r $;

theorem sfRelative_prop_binary (D r p q: nat) (hd: $ sfWf D $):
  $ sfNDPropBinary r p q -> sfRelativeGood D p -> sfRelativeGood D q -> sfRelativeGood D r $;

