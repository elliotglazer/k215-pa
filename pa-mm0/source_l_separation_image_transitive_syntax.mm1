import "source_l_common_level_transport.mm1";
import "source_l_common_level_members.mm1";

@_ def sfLSeparationTransitiveAt(Y:nat):nat =
 $ sfAll (sfImp (sfMem 0 (suc Y)) (sfCLSubset 0 (suc Y))) $;
def sfLSeparationStageTransBody(a Y:nat):nat =
 $ sfImp (sfCLOrdinalAt a) (sfImp (sfCLHierarchyAt a Y) (sfLSeparationTransitiveAt Y)) $;
def sfLSeparationStageTransNormal:nat =
 $ sfAll (sfAll (sfLSeparationStageTransBody 1 0)) $;
