import "b4_zfc_sound4.mm0";

theorem bdHas_mono (G: wff) (m v m2 v2 i g a b c d: nat) {kk: nat} (hs: $ G -> A. kk (bdCell m v kk -> bdCell m2 v2 kk) $): $ G -> bdHas m v i g a b c d -> bdHas m2 v2 i g a b c d $;
theorem bdTup_le (j g a b c d k: nat): $ bdTup j g a b c d k -> j <= k $;
theorem bdHasV1 (j k v i g a b c d: nat): $ k < v -> j < i /\ bdTup j g a b c d k -> j < v /\ bdTup j g a b c d k $;
theorem bdHas_v (m v i g a b c d: nat): $ bdHas m v i g a b c d -> bdHas m v v g a b c d $;
