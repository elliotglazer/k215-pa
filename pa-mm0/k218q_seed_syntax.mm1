import "k218q_base.mm1";

pub theorem k218Translate_kSubset (a b k: nat):
  $ k218Translate (kSubset a b k) = kSubset a b k $ =
'(eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq k218Translate_kMem k218Translate_kMem))));

pub theorem k218Translate_k218Vrel (a b c: nat):
  $ k218Translate (k218Vrel a b c) = k218Vrel a b c $ =
'(eqtr k218Translate_kImp (kImpeq k218Translate_kMem (eqtr k218Translate_kAll (kAlleq2 k218Translate_kMem))));

pub theorem k218Translate_k218SeedRequest (b k q: nat):
  $ k218Translate (k218SeedRequest b k q) = k218SeedRequest b k (k218Translate q) $ =
'(eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq eqid (eqtr k218Translate_kNot (kNoteq (eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq eqid (eqtr k218Translate_kNot (kNoteq k218Translate_kMem))))))))))));

pub theorem k218Translate_k218SeedClosure (a b k q: nat):
  $ k218Translate (k218SeedClosure a b k q) = k218SeedClosure a b k (k218Translate q) $ =
'(eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq k218Translate_kMem (eqtr k218Translate_kNot (kNoteq (eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq eqid (eqtr k218Translate_kNot (kNoteq (eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq (eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq k218Translate_kMem k218Translate_kMem)))) (eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq eqid (eqtr k218Translate_kNot (kNoteq (eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq eqid (eqtr k218Translate_kNot (kNoteq k218Translate_kMem))))))))))))))))))))))))))));

pub theorem k218Translate_k218SeedN (a b c q: nat):
  $ k218Translate (k218SeedN a b c q) = k218SeedN a b c (k218Translate q) $ =
'(eqtr k218Translate_kNot (kNoteq (eqtr k218Translate_kImp (kImpeq (eqtr k218Translate_kImp (kImpeq k218Translate_kMem (eqtr k218Translate_kAll (kAlleq2 k218Translate_kMem)))) (eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq (eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq k218Translate_kMem (eqtr k218Translate_kNot (kNoteq (eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq eqid (eqtr k218Translate_kNot (kNoteq (eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq (eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq k218Translate_kMem k218Translate_kMem)))) (eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq eqid (eqtr k218Translate_kNot (kNoteq (eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq eqid (eqtr k218Translate_kNot (kNoteq k218Translate_kMem)))))))))))))))))))))))))))) (eqtr k218Translate_kNot (kNoteq (eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq eqid (eqtr k218Translate_kNot (kNoteq (eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq eqid (eqtr k218Translate_kNot (kNoteq k218Translate_kMem))))))))))))))))))))));

pub theorem k218Translate_kRequest (b k q: nat):
  $ k218Translate (kRequest b k q) = kRequest b k (k218Translate q) $ =
'(eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq eqid (eqtr k218Translate_kExists (kExistseq2 (eqtr k218Translate_kAnd (kAndeq eqid k218Translate_kMem))))))));

pub theorem k218Translate_k218Closure (a b k q: nat):
  $ k218Translate (k218Closure a b k q) = k218Closure a b k (k218Translate q) $ =
'(eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq k218Translate_kMem (eqtr k218Translate_kExists (kExistseq2 (eqtr k218Translate_kAnd (kAndeq eqid (eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq (eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq k218Translate_kMem k218Translate_kMem)))) (eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq eqid (eqtr k218Translate_kExists (kExistseq2 (eqtr k218Translate_kAnd (kAndeq eqid k218Translate_kMem))))))))))))))))))));

pub theorem k218Translate_k218SeedY (a b c q: nat):
  $ k218Translate (k218SeedY a b c q) = k218SeedY a b c (k218Translate q) $ =
'(eqtr k218Translate_kNot (kNoteq (eqtr k218Translate_kImp (kImpeq (eqtr k218Translate_kImp (kImpeq k218Translate_kMem (eqtr k218Translate_kAll (kAlleq2 k218Translate_kMem)))) (eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq (eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq k218Translate_kMem (eqtr k218Translate_kExists (kExistseq2 (eqtr k218Translate_kAnd (kAndeq eqid (eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq (eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq k218Translate_kMem k218Translate_kMem)))) (eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq eqid (eqtr k218Translate_kExists (kExistseq2 (eqtr k218Translate_kAnd (kAndeq eqid k218Translate_kMem)))))))))))))))))))) (eqtr k218Translate_kNot (kNoteq (eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq eqid (eqtr k218Translate_kExists (kExistseq2 (eqtr k218Translate_kAnd (kAndeq eqid k218Translate_kMem))))))))))))))))));

pub theorem k218Translate_kCore (a b k q: nat):
  $ k218Translate (kCore a b k q) = kCore a b k (k218Translate q) $ =
'(eqtr k218Translate_kExists (kExistseq2 (eqtr k218Translate_kAnd (kAndeq (eqtr k218Translate_kImp (kImpeq eqid k218Translate_kMem)) (eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq k218Translate_kMem (eqtr k218Translate_kExists (kExistseq2 (eqtr k218Translate_kAnd (kAndeq eqid (eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq (eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq k218Translate_kMem k218Translate_kMem)))) (eqtr k218Translate_kAll (kAlleq2 (eqtr k218Translate_kImp (kImpeq eqid (eqtr k218Translate_kExists (kExistseq2 (eqtr k218Translate_kAnd (kAndeq eqid k218Translate_kMem))))))))))))))))))))))));
