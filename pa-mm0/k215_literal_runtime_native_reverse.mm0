import "k215_literal_runtime_native_iteration.mm0";

def k215PNativeReverseClaim (n: nat) (.s .g .w .r: nat): wff =
 $ A. s A. g A. w A. r
   (k215PInRange s -> k215TMQ (k215TMRun n (k215PConfigFrame g s w r)) = k215Num215 -> k215PHaltsFrom s) $;

def k215PNativeReverseFuture (n s w: nat) (.h .q: nat): wff =
 $ A. h A. q (k215TMQ (k215TMRun n (k215PConfigFrame h (k215PStep s) w q)) = k215Num215 ->
     k215PHaltsFrom (k215PStep s)) $;

theorem k215PNativeReverse_all (n: nat): $ k215PNativeLaw -> k215PNativeReverseClaim n $;

theorem k215PNative_literal_halts (s g w r: nat):
 $ k215PNativeLaw -> k215PInRange s -> k215TMHaltsFrom (k215PConfigFrame g s w r) -> k215PHaltsFrom s $;

theorem k215PNative_halting_equivalence (s g w r: nat):
 $ k215PNativeLaw -> k215PInRange s ->
   (k215TMHaltsFrom (k215PConfigFrame g s w r) <-> k215PHaltsFrom s) $;
