import "bb215_provability_qk_list.mm0";

-- QK semantics, the guarded finite cell and the suffix-sequence relation D (lane L07).

theorem bb215ProvabilityQK_le_of_mul (w x m: nat): $ 0 < x -> w * x = m -> w <= m $;

theorem bb215ProvabilityQK_dvd_guard (x m: nat) {w: nat}: $ 0 < x -> (E. w (w <= m /\ w * x = m) <-> x || m) $;

theorem bb215ProvabilityQKCell_iff (m c k: nat): $ bb215ProvabilityQKCell m c k <-> bb215ArithmeticFormulaFiniteCell m c k $;

theorem bb215ProvabilityQK_cell_le_aux (v x c: nat): $ 0 < c -> v * x = c -> x <= c $;

theorem bb215ProvabilityQKCell_bound (m c k: nat): $ bb215ProvabilityQKCell m c k -> k <= c $;

theorem bb215ProvabilityQKD_iff (m c i s: nat): $ bb215ProvabilityQKD m c i s <-> bb215ProvabilityQKCell m c (i, s) $;

theorem bb215ProvabilityQKD_bound (m c i s: nat): $ bb215ProvabilityQKD m c i s -> i <= c /\ s <= c $;

theorem bb215ProvabilityQKCell_iff_zero: $ bb215ProvabilityQKCell 0 0 0 <-> bb215ArithmeticFormulaFiniteCell 0 0 0 $;
