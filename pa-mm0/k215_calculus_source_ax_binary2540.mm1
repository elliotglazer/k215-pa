theorem k215BinaryUnpairInAt2540 (u t w c a b v: nat): $ (k215UnpairAt2540State k215PNum2540 0 0 w (k215PVector u t w c a b 0 0 v)) = (k215PState k215PNum2540 (k215PVector u t w c a b 0 0 v)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector eqid k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryUnpairOutAt2540 (u t w c a b v: nat): $ (k215UnpairAt2540State k215PNum2548 (fst w) (snd w) 0 (k215PVector u t w c a b 0 0 v)) = (k215PState k215PNum2548 (k215PVector u t 0 c a b (fst w) (snd w) v)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector eqid k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryUnpairAt2540 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum2540 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum2548 (k215PVector u t 0 c a b (fst w) (snd w) v)) $ =
 '(mpbi (k215PReacheq k215BinaryUnpairInAt2540 k215BinaryUnpairOutAt2540) k215UnpairMacro2540_clean);

theorem k215BinaryRestoreStackAt2540 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum2548 (k215PVector u t 0 c a b (fst w) (snd w) v)) (k215PState k215PNum2551 (k215PVector u t (snd w) c a b (fst w) 0 v)) $ =
 '(k215PReach_intro (eqtr k215Loop2548Vector (k215PStateeq2 (k215PVectoreq3 add0))));

theorem k215BinaryPairInAt2540 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt2551State k215PNum2551 a6 a1 a7 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum2551 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryPairOutAt2540 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt2551State k215PNum2561 0 0 (a7 + (a6, a1)) (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum2561 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryPairAt2540 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat):
 $ k215PReach (k215PState k215PNum2551 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215PNum2561 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ =
 '(mpbi (k215PReacheq k215BinaryPairInAt2540 k215BinaryPairOutAt2540) k215PairMacro2551);

theorem k215BinaryPairCleanAt2540 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum2551 (k215PVector u t (snd w) c a b (fst w) 0 v)) (k215PState k215PNum2561 (k215PVector u 0 (snd w) c a b 0 (fst w, t) v)) $ =
 '(mpbi (k215PReacheq2 (k215PStateeq2 (k215PVectoreq8 add01))) k215BinaryPairAt2540);
theorem k215BinaryFourAt2540 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum2561 (k215PVector u 0 (snd w) c a b 0 (fst w, t) v)) (k215PState k215PNum2567 (k215PVector u (4 * (fst w, t)) (snd w) c a b 0 0 v)) $ =
