theorem k215BinaryTagAllAt2540 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum2567 (k215PVector u (4 * (fst w, t)) (snd w) c a b 0 0 v)) (k215PState k215PNum2567 (k215PVector u (kImp (fst w) t) (snd w) c a b 0 0 v)) $ = 'k215PReach_refl;

pub theorem k215BinaryConstructor2540 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum2540 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum2567 (k215PVector u (kImp (fst w) t) (snd w) c a b 0 0 v)) $ = '(ax_mp (ax_mp k215PReach_trans k215BinaryUnpairAt2540) (ax_mp (ax_mp k215PReach_trans k215BinaryRestoreStackAt2540) (ax_mp (ax_mp k215PReach_trans k215BinaryPairCleanAt2540) (ax_mp (ax_mp k215PReach_trans k215BinaryFourAt2540) k215BinaryTagAllAt2540))));

