import "k215_calculus_source_decode_loops.mm0";
import "k215_calculus_source_nip_lookups.mm0";

def k215Loop4741State (pc x y z c: nat): nat = $ k215PState pc (k215PVector z (k215PR1 c) (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) y x (k215PR8 c)) $;

def k215Loop4741Claim (x c: nat) (.y .z: nat): wff =
 $ A. y A. z k215PIter (3 * x + 1) (k215Loop4741State k215PNum4741 x y z c) = (k215Loop4741State k215PNum4744 0 (x + y) z c) $;

theorem k215Loop4741Transfer (x y z c: nat): $ k215PIter (3 * x + 1) (k215Loop4741State k215PNum4741 x y z c) = (k215Loop4741State k215PNum4744 0 (x + y) z c) $;

theorem k215Loop4741Vector (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ k215PIter (3 * a7 + 1) (k215PState k215PNum4741 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) =
   k215PState k215PNum4744 (k215PVector a0 a1 a2 a3 a4 a5 (a7 + a6) 0 a8) $;

def k215Loop4745State (pc x y z c: nat): nat = $ k215PState pc (k215PVector z (k215PR1 c) y (k215PR3 c) (k215PR4 c) (k215PR5 c) (k215PR6 c) x (k215PR8 c)) $;

def k215Loop4745Claim (x c: nat) (.y .z: nat): wff =
 $ A. y A. z k215PIter (3 * x + 1) (k215Loop4745State k215PNum4745 x y z c) = (k215Loop4745State k215PNum4748 0 (x + y) z c) $;

theorem k215Loop4745Transfer (x y z c: nat): $ k215PIter (3 * x + 1) (k215Loop4745State k215PNum4745 x y z c) = (k215Loop4745State k215PNum4748 0 (x + y) z c) $;

theorem k215Loop4745Vector (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ k215PIter (3 * a7 + 1) (k215PState k215PNum4745 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) =
   k215PState k215PNum4748 (k215PVector a0 a1 (a7 + a2) a3 a4 a5 a6 0 a8) $;

def k215Loop4748State (pc x y z c: nat): nat = $ k215PState pc (k215PVector z (k215PR1 c) (k215PR2 c) (k215PR3 c) (k215PR4 c) y x (k215PR7 c) (k215PR8 c)) $;

def k215Loop4748Claim (x c: nat) (.y .z: nat): wff =
 $ A. y A. z k215PIter (3 * x + 1) (k215Loop4748State k215PNum4748 x y z c) = (k215Loop4748State 0 0 (x + y) z c) $;

theorem k215Loop4748Transfer (x y z c: nat): $ k215PIter (3 * x + 1) (k215Loop4748State k215PNum4748 x y z c) = (k215Loop4748State 0 0 (x + y) z c) $;

theorem k215Loop4748Vector (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ k215PIter (3 * a6 + 1) (k215PState k215PNum4748 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) =
   k215PState 0 (k215PVector a0 a1 a2 a3 a4 (a6 + a5) 0 a7 a8) $;
