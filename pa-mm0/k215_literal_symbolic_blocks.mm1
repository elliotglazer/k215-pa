import "k215_literal_symbolic_base.mm1";

@_ def k215SymC (v r: nat): nat = $ k215TmPush 1 (k215TmPush 0 (k215TmRepeat 1 v r)) $;
@_ def k215SymRB (v r: nat): nat = $ k215TmRepeat 1 (suc v) (k215TmPush 0 r) $;
