theorem k215PPC_state (pc regs: nat): $ k215PPC (k215PState pc regs) = pc $;

theorem k215PRegs_state (pc regs: nat): $ k215PRegs (k215PState pc regs) = regs $;

theorem k215PEPath_entry (path tag arg zero positive: nat): $ k215PEPath (k215PEntry path tag arg zero positive) = path $;

theorem k215PETag_entry (path tag arg zero positive: nat): $ k215PETag (k215PEntry path tag arg zero positive) = tag $;

theorem k215PEArg_entry (path tag arg zero positive: nat): $ k215PEArg (k215PEntry path tag arg zero positive) = arg $;

theorem k215PEZero_entry (path tag arg zero positive: nat): $ k215PEZero (k215PEntry path tag arg zero positive) = zero $;

theorem k215PEPositive_entry (path tag arg zero positive: nat): $ k215PEPositive (k215PEntry path tag arg zero positive) = positive $;

theorem k215PStep_state (pc regs: nat):
 $ k215PStep (k215PState pc regs) =
   if (k215PETag (k215PLookup pc) = 4) (k215PState pc regs)
     (k215PStepEntry (k215PLookup pc) regs) $;

theorem k215PStep_lookup (pc regs e: nat) (h: $ k215PLookup pc = e $):
 $ k215PStep (k215PState pc regs) =
   if (k215PETag e = 4) (k215PState pc regs) (k215PStepEntry e regs) $;

theorem k215PStepEntry_fields (path tag arg zero positive regs: nat):
 $ k215PStepEntry (k215PEntry path tag arg zero positive) regs =
   if (tag = 0) (k215PState positive (k215PSet arg (suc (k215PGet arg regs)) regs))
   (if (tag = 1)
      (if (k215PGet arg regs = 0) (k215PState zero regs)
        (k215PState positive (k215PSet arg (k215PGet arg regs - 1) regs)))
      (k215PState zero regs)) $;

theorem k215PAtCI (pc path arg zero positive regs: nat)
 (h: $ k215PLookup pc = k215PEntry path 0 arg zero positive $):
 $ k215PStep (k215PState pc regs) = (k215PState positive (k215PSet arg (suc (k215PGet arg regs)) regs)) $;

theorem k215PAtCD (pc path arg zero positive regs: nat)
 (h: $ k215PLookup pc = k215PEntry path 1 arg zero positive $):
 $ k215PStep (k215PState pc regs) = (if (k215PGet arg regs = 0) (k215PState zero regs) (k215PState positive (k215PSet arg (k215PGet arg regs - 1) regs))) $;

theorem k215PAtCB (pc path arg zero positive regs: nat)
 (h: $ k215PLookup pc = k215PEntry path 2 arg zero positive $):
 $ k215PStep (k215PState pc regs) = (k215PState zero regs) $;

theorem k215PAtCC (pc path arg zero positive regs: nat)
 (h: $ k215PLookup pc = k215PEntry path 3 arg zero positive $):
 $ k215PStep (k215PState pc regs) = (k215PState zero regs) $;
