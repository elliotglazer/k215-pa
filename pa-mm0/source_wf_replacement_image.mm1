@_ def sfWFReplacementDomainOne: nat = $ wfRImageF19 $;

@_ def sfWFReplacementMatrix (phi: nat): nat = $ sfAnd (sfAnd sfWFDomain sfWFReplacementDomainOne) (sfRelativize sfWFDomain phi) $;

theorem sfRMatrix_renameA (phi: nat):
 $ sfRename sfRepAMap 0 (sfWFReplacementMatrix phi) =
   sfAnd (sfAnd wfRImageF25
                 wfRImageF19)
      (sfRename sfRepAMap 0 (sfRelativize sfWFDomain phi)) $ =
'(eqtr sfRename_sfAnd (nsAnd_eq
  (eqtr sfRename_sfAnd (nsAnd_eq wfRImageRepRename48 wfRImageRepRename51)) eqid));

theorem sfRMatrix_renameB (phi: nat):
 $ sfRename sfRepBMap 0 (sfWFReplacementMatrix phi) =
   sfAnd (sfAnd wfRImageF25
                 wfRImageF22)
      (sfRename sfRepBMap 0 (sfRelativize sfWFDomain phi)) $ =
'(eqtr sfRename_sfAnd (nsAnd_eq
  (eqtr sfRename_sfAnd (nsAnd_eq wfRImageRepRename74 wfRImageRepRename77)) eqid));

theorem sfRMatrix_renameC (phi: nat):
 $ sfRename sfRepCMap 0 (sfWFReplacementMatrix phi) =
   sfAnd (sfAnd wfRImageF22
                 wfRImageF19)
      (sfRename sfRepCMap 0 (sfRelativize sfWFDomain phi)) $ =
'(eqtr sfRename_sfAnd (nsAnd_eq
  (eqtr sfRename_sfAnd (nsAnd_eq wfRImageRepRename100 wfRImageRepRename103)) eqid));

theorem sfRMatrix_raw_eq (phi: nat):
 $ sfReplacement
    (sfRename sfRepAMap 0 (sfWFReplacementMatrix phi))
    (sfRename sfRepBMap 0 (sfWFReplacementMatrix phi))
    (sfRename sfRepCMap 0 (sfWFReplacementMatrix phi)) =
   sfWFReplacementRaw
    (sfRename sfRepAMap 0 (sfRelativize sfWFDomain phi))
    (sfRename sfRepBMap 0 (sfRelativize sfWFDomain phi))
    (sfRename sfRepCMap 0 (sfRelativize sfWFDomain phi)) $ =
'(trud (sfReplacement_congr (a1i sfRMatrix_renameA)
   (a1i sfRMatrix_renameB) (a1i sfRMatrix_renameC)));

theorem sfRMatrix_bound (phi n: nat):
 $ sfBound (suc (suc n)) phi -> sfBound (suc (suc n)) (sfWFReplacementMatrix phi) $ =
'(syl (bi2 sfBound_sfAnd) (iand (a1i (mpbir sfBound_sfAnd (ian (ax_mp (ax_mp sfBound_mono wfRImageBound22) (mpbi lesuc (mpbi lesuc le01))) (ax_mp (ax_mp sfBound_mono wfRImageBound25) (mpbi lesuc (mpbi lesuc le01))))))
   (ax_mp sfRelativize_bound sfWFDomain_bound)));

pub theorem sfWFReplacement_relativize_eq (a b c: nat):
 $ sfRelativize sfWFDomain (sfReplacement a b c) =
   sfWFReplacementGuarded (sfRelativize sfWFDomain a)
    (sfRelativize sfWFDomain b) (sfRelativize sfWFDomain c) $ =
'(eqtr sfRelativize_sfImp (nsImp_eq (eqtr sfRelativize_sfAll (nsAll_eq (nsImp_eq eqid (eqtr sfRelativize_sfAll (nsAll_eq (nsImp_eq eqid (eqtr sfRelativize_sfAll (nsAll_eq (nsImp_eq eqid (eqtr sfRelativize_sfImp (nsImp_eq eqid (eqtr sfRelativize_sfImp (nsImp_eq eqid sfRelativize_sfEq))))))))))))) (eqtr sfRelativize_sfAll (nsAll_eq (nsImp_eq eqid (eqtr sfRelativize_sfEx (nsEx_eq (nsAnd_eq eqid (eqtr sfRelativize_sfAll (nsAll_eq (nsImp_eq eqid (eqtr sfRelativize_sfAnd (nsAnd_eq (eqtr sfRelativize_sfImp (nsImp_eq sfRelativize_sfMem (eqtr sfRelativize_sfEx (nsEx_eq (nsAnd_eq eqid (eqtr sfRelativize_sfAnd (nsAnd_eq sfRelativize_sfMem eqid))))))) (eqtr sfRelativize_sfImp (nsImp_eq (eqtr sfRelativize_sfEx (nsEx_eq (nsAnd_eq eqid (eqtr sfRelativize_sfAnd (nsAnd_eq sfRelativize_sfMem eqid))))) sfRelativize_sfMem)))))))))))))));

theorem sfRGuarded_congr (H: wff) (a b c d e f: nat)
 (ha: $ H -> a = b $) (hb: $ H -> c = d $) (hc: $ H -> e = f $):
 $ H -> sfWFReplacementGuarded a c e = sfWFReplacementGuarded b d f $ =
'(sfWFReplacementGuardedeqd ha hb hc);

theorem sfRGuarded_body_eq (phi n: nat):
 $ sfBound (suc (suc n)) phi ->
   sfWFReplacementGuarded
    (sfRename sfRepAMap 0 (sfRelativize sfWFDomain phi))
    (sfRename sfRepBMap 0 (sfRelativize sfWFDomain phi))
    (sfRename sfRepCMap 0 (sfRelativize sfWFDomain phi)) =
   sfRelativize sfWFDomain (sfReplacement
    (sfRename sfRepAMap 0 phi) (sfRename sfRepBMap 0 phi)
    (sfRename sfRepCMap 0 phi)) $ =
'(eqtrd (sfRGuarded_congr
  (syl (ax_mp sfRelativize_rename sfWFDomain_bound) sfBound_wf)
  (syl (ax_mp sfRelativize_rename sfWFDomain_bound) sfBound_wf)
  (syl (ax_mp sfRelativize_rename sfWFDomain_bound) sfBound_wf))
  (a1i (eqcom sfWFReplacement_relativize_eq)));

theorem sfRRaw_schema (phi n: nat):
 $ sfBound (suc (suc n)) phi -> sfTheoryProvable zfcCoreAxioms
   (sfWFReplacementRaw
    (sfRename sfRepAMap 0 (sfRelativize sfWFDomain phi))
    (sfRename sfRepBMap 0 (sfRelativize sfWFDomain phi))
    (sfRename sfRepCMap 0 (sfRelativize sfWFDomain phi))) $ =
'(syl (bi1 (trud (sfTheoryProvable_congr (a1i sfRMatrix_raw_eq)))) @
  syl (ax_mp sfTheoryProvable_prefix_elim zfcCoreAxioms_closed) @
  syl (ax_mp sfTheoryAxiom_provable_closed zfcCoreAxioms_closed) @
  syl zfcCoreReplacementCode_member sfRMatrix_bound);

theorem sfRGuarded_schema (phi n: nat):
 $ sfBound (suc (suc n)) phi -> sfTheoryProvable zfcCoreAxioms
   (sfWFReplacementGuarded
    (sfRename sfRepAMap 0 (sfRelativize sfWFDomain phi))
    (sfRename sfRepBMap 0 (sfRelativize sfWFDomain phi))
    (sfRename sfRepCMap 0 (sfRelativize sfWFDomain phi))) $ =
'(syl (ax_mp (sfWFReplacement_theory zfcCoreAxioms_closed
    sfRename_wf sfRename_wf sfRename_wf) sfWFClosure_core) sfRRaw_schema);

theorem sfRRelative_open_schema (phi n: nat):
 $ sfBound (suc (suc n)) phi -> sfTheoryProvable zfcCoreAxioms
   (sfRelativize sfWFDomain (sfReplacement
    (sfRename sfRepAMap 0 phi) (sfRename sfRepBMap 0 phi)
    (sfRename sfRepCMap 0 phi))) $ =
'(mpbid (sfTheoryProvable_congr sfRGuarded_body_eq) sfRGuarded_schema);

pub theorem sfWFReplacement_schema (phi n: nat):
 $ sfBound (suc (suc n)) phi -> sfTheoryProvable zfcCoreAxioms
   (sfRelativize sfWFDomain (zfcReplacementCode phi n)) $ =
'(syl (sfTheory_relative_prefix zfcCoreAxioms_closed sfWFDomain_wf)
 sfRRelative_open_schema);

