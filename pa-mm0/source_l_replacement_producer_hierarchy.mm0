import "source_l_replacement_producer_schema.mm0";

import "source_l_replacement_common_source.mm0";

import "source_l_replacement_common_extension_source.mm0";

import "source_l_replacement_common_producers.mm0";

import "source_piece_pcf_level_interfaces.mm0";

import "source_reflection_transfer_tv_producers.mm0";

import "source_reflection_transfer_ph_hierarchy.mm0";

import "source_l_power_collection_kernel.mm0";

theorem sfLReplacementExtension_from_hierarchy
 (hE:$ sfTheoryProvable zfrAxioms sfLUniversalHierarchyExists $)
 (hS:$ sfTheoryProvable zfrAxioms sfLPowerHierarchySubset $):
 $ sfTheoryProvable zfrAxioms sfLReplacementLevelExtension $;

theorem sfLReplacementAbove_from_hierarchy(count phi:nat)(hb:$ sfBound count phi $)
 (hE:$ sfTheoryProvable zfrAxioms sfLUniversalHierarchyExists $)
 (hU:$ sfTheoryProvable zfrAxioms sfLUniversalHierarchyUnique $)
 (hS:$ sfTheoryProvable zfrAxioms sfLPowerHierarchySubset $)
 (hL:$ sfTheoryProvable zfrAxioms (sfReflectionLimitLevelLimit sfLUniversalHierarchyRelation) $)
 (hM:$ sfTheoryProvable zfrAxioms (sfReflectionLimitLevelMono sfLUniversalHierarchyRelation) $):
 $ sfTheoryProvable zfrAxioms (sfLReplacementAboveLaw count phi) $;

theorem sfLReplacementLevelExists_from_hierarchy
 (hE:$ sfTheoryProvable zfrAxioms sfLUniversalHierarchyExists $):
 $ sfTheoryProvable zfrAxioms sfLReplacementLevelExistsLaw $;

theorem sfLReplacementSubset_from_hierarchy
 (hS:$ sfTheoryProvable zfrAxioms sfLPowerHierarchySubset $):
 $ sfTheoryProvable zfrAxioms (sfReflectionHierarchySubsetNormal sfCLHierarchy) $;

theorem sfLReplacementPowerBound_from_hierarchy
 (hE:$ sfTheoryProvable zfrAxioms sfLUniversalHierarchyExists $)
 (hS:$ sfTheoryProvable zfrAxioms sfLPowerHierarchySubset $):
 $ sfTheoryProvable zfrAxioms sfLPowerLevelBound $;

theorem sfLReplacementSeed_from_hierarchy(n phi:nat)(hb:$ sfBound (suc (suc n)) phi $)
 (hE:$ sfTheoryProvable zfrAxioms sfLUniversalHierarchyExists $)
 (hS:$ sfTheoryProvable zfrAxioms sfLPowerHierarchySubset $):
 $ sfTheoryProvable zfrAxioms (sfLReplacementSeedProducerFormula phi) $;

theorem sfLReplacementCommonReflected_from_hierarchy(params count phi:nat)
 (hb:$ sfBound count phi $)
 (hE:$ sfTheoryProvable zfrAxioms sfLUniversalHierarchyExists $)
 (hU:$ sfTheoryProvable zfrAxioms sfLUniversalHierarchyUnique $)
 (hS:$ sfTheoryProvable zfrAxioms sfLPowerHierarchySubset $)
 (hL:$ sfTheoryProvable zfrAxioms (sfReflectionLimitLevelLimit sfLUniversalHierarchyRelation) $)
 (hM:$ sfTheoryProvable zfrAxioms (sfReflectionLimitLevelMono sfLUniversalHierarchyRelation) $):
 $ sfTheoryProvable zfrAxioms (sfCLCommonReflectedLaw 0 params count phi) $;

theorem sfLReplacement_schema_from_hierarchy(n phi:nat)
 (hb:$ sfBound (suc (suc n)) phi $)
 (hE:$ sfTheoryProvable zfrAxioms sfLUniversalHierarchyExists $)
 (hU:$ sfTheoryProvable zfrAxioms sfLUniversalHierarchyUnique $)
 (hS:$ sfTheoryProvable zfrAxioms sfLPowerHierarchySubset $)
 (hL:$ sfTheoryProvable zfrAxioms (sfReflectionLimitLevelLimit sfLUniversalHierarchyRelation) $)
 (hM:$ sfTheoryProvable zfrAxioms (sfReflectionLimitLevelMono sfLUniversalHierarchyRelation) $)
 (hd:$ nsLocal (sfLReplacementProducerDefinableContext n phi)
  (sfLReplacementImageDefinable (sfLReplacementStartMap 7) sfLDomain (sfLReplacementPsi phi) 0) $):
 $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain (zfcReplacementCode phi n)) $;
