theorem k215N105R107Vector (g a0 a1 a2 a3 a4 a5 a6 a7 a8 w rest: nat): $ k215PNativeOutcome g (k215PState k215Num107 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) w rest $ = (named 'nativeWitness '(cases k215N105R107Zero (syl k215N105R107Exists (bi1 exsuc))));

