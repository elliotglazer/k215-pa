theorem k215BinaryUnpairInAt173 (u t w c a b v: nat): $ (k215UnpairAt173State k215Num173 0 0 w (k215PVector u t w c a b 0 0 v)) = (k215PState k215Num173 (k215PVector u t w c a b 0 0 v)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector eqid k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryUnpairOutAt173 (u t w c a b v: nat): $ (k215UnpairAt173State k215Num181 (fst w) (snd w) 0 (k215PVector u t w c a b 0 0 v)) = (k215PState k215Num181 (k215PVector u t 0 c a b (fst w) (snd w) v)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector eqid k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryUnpairAt173 (u t w c a b v: nat):
 $ k215PReach (k215PState k215Num173 (k215PVector u t w c a b 0 0 v)) (k215PState k215Num181 (k215PVector u t 0 c a b (fst w) (snd w) v)) $ =
 '(mpbi (k215PReacheq k215BinaryUnpairInAt173 k215BinaryUnpairOutAt173) k215UnpairMacro173_clean);

theorem k215BinaryRestoreStackAt173 (u t w c a b v: nat):
 $ k215PReach (k215PState k215Num181 (k215PVector u t 0 c a b (fst w) (snd w) v)) (k215PState k215Num184 (k215PVector u t (snd w) c a b (fst w) 0 v)) $ =
 '(k215PReach_intro (eqtr k215Loop181Vector (k215PStateeq2 (k215PVectoreq3 add0))));

theorem k215BinaryPairInAt173 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt184State k215Num184 a6 a1 a7 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215Num184 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryPairOutAt173 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt184State k215Num194 0 0 (a7 + (a6, a1)) (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215Num194 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryPairAt173 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat):
 $ k215PReach (k215PState k215Num184 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215Num194 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ =
 '(mpbi (k215PReacheq k215BinaryPairInAt173 k215BinaryPairOutAt173) k215PairMacro184);

theorem k215BinaryPairCleanAt173 (u t w c a b v: nat):
 $ k215PReach (k215PState k215Num184 (k215PVector u t (snd w) c a b (fst w) 0 v)) (k215PState k215Num194 (k215PVector u 0 (snd w) c a b 0 (fst w, t) v)) $ =
 '(mpbi (k215PReacheq2 (k215PStateeq2 (k215PVectoreq8 add01))) k215BinaryPairAt173);
theorem k215BinaryFourAt173 (u t w c a b v: nat):
 $ k215PReach (k215PState k215Num194 (k215PVector u 0 (snd w) c a b 0 (fst w, t) v)) (k215PState k215Num200 (k215PVector u (4 * (fst w, t)) (snd w) c a b 0 0 v)) $ =
 '(k215PReach_intro (eqtr k215Loop194Vector (k215PStateeq2 (k215PVectoreq2 add0))));

theorem k215BinaryTagAllAt173 (u t w c a b v: nat):
 $ k215PReach (k215PState k215Num200 (k215PVector u (4 * (fst w, t)) (snd w) c a b 0 0 v)) (k215PState k215Num200 (k215PVector u (kImp (fst w) t) (snd w) c a b 0 0 v)) $ = 'k215PReach_refl;

pub theorem k215BinaryConstructor173 (u t w c a b v: nat):
 $ k215PReach (k215PState k215Num173 (k215PVector u t w c a b 0 0 v)) (k215PState k215Num200 (k215PVector u (kImp (fst w) t) (snd w) c a b 0 0 v)) $ = '(ax_mp (ax_mp k215PReach_trans k215BinaryUnpairAt173) (ax_mp (ax_mp k215PReach_trans k215BinaryRestoreStackAt173) (ax_mp (ax_mp k215PReach_trans k215BinaryPairCleanAt173) (ax_mp (ax_mp k215PReach_trans k215BinaryFourAt173) k215BinaryTagAllAt173))));

