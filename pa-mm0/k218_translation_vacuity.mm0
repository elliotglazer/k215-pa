import "k218_translation_logic.mm0";
import "k218_equality_conditional.mm0";

def k218TranslatedVacuousClass (x .a: nat): set =
  $ {a | kFresh a x ->
    k218Provable (kImp (k218Translate a) (kAll x (k218Translate a)))} $;
theorem k218TranslatedVacuousClass_value (a x: nat):
  $ a e. k218TranslatedVacuousClass x <->
    (kFresh a x -> k218Provable (kImp (k218Translate a) (kAll x (k218Translate a)))) $;
theorem k218TranslatedVacuousClass_closed (x: nat):
  $ kRawConstructionClosed (k218TranslatedVacuousClass x) $;
theorem k218Translate_fresh_vacuity (a x: nat):
  $ kFresh a x -> k218Provable (kImp (k218Translate a) (kAll x (k218Translate a))) $;
