import "k215_calculus_source_decode_loops.mm0";
import "k215_calculus_source_ax_reads_lookups.mm0";

def k215Loop163State (pc x y z c: nat): nat = $ k215PState pc (k215PVector z (k215PR1 c) (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) y x (k215PR8 c)) $;

def k215Loop163Claim (x c: nat) (.y .z: nat): wff =
 $ A. y A. z k215PIter (3 * x + 1) (k215Loop163State k215Num163 x y z c) = (k215Loop163State k215Num166 0 (x + y) z c) $;

theorem k215Loop163Transfer (x y z c: nat): $ k215PIter (3 * x + 1) (k215Loop163State k215Num163 x y z c) = (k215Loop163State k215Num166 0 (x + y) z c) $;

theorem k215Loop163Vector (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ k215PIter (3 * a7 + 1) (k215PState k215Num163 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) =
   k215PState k215Num166 (k215PVector a0 a1 a2 a3 a4 a5 (a7 + a6) 0 a8) $;

