import "pa_source_interpretation_formula_eqd_support.mm0";

import "pa_formula_induction.mm0";

import "pa_formula_renaming.mm0";

import "pa_source_interpretation_term_rename_agreement.mm0";

import "pa_axiom_syntax_base.mm0";

theorem paFormulaRenameClosedTerm (R: set) (d c: nat): $ paTermBound d c -> paTermRename (sfRenameDepthMap R d) c = c $;

def paFormulaRenameClosedClass (R: set) (.n .c .d: nat): set = $ S\ n, {c | A. d (paFormulaBound d c -> paFormulaRename R d c = c)} $;

theorem paFormulaRename_closed (R: set) (d c: nat): $ paFormulaBound d c -> paFormulaRename R d c = c $;

theorem paAxiomLift_closed (c: nat): $ paFormulaBound 0 c -> paAxiomLift c = c $;
