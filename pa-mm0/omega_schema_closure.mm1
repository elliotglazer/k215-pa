import "extracted_omega_factored.mm1";

import "omega_schema_instances.mm1";

import "quotient_schema_images.mm1";

pub theorem oscAgrLiteral: $ eofAx9 = osiAgrFormula $ = 'eqid;

pub theorem oscAgrCode: $ eofAx9 = zfcSeparationCode osiAgrMatrix 2 $ = '(eqtr oscAgrLiteral (eqcom osiAgrCode));

pub theorem oscAgrImage: $ omegaSeparationImages -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 eofAx9) $ = '(syl (bi2 (k218IHypProvableeq2 (sqQuoteeq5 oscAgrCode))) (mpd (a1i osiAgrBound) oscSeparationAt));

pub theorem oscExaLiteral: $ eofAx10 = osiExaFormula $ = 'eqid;

pub theorem oscExaCode: $ eofAx10 = zfcSeparationCode osiExaMatrix 3 $ = '(eqtr oscExaLiteral (eqcom osiExaCode));

pub theorem oscExaImage: $ omegaSeparationImages -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 eofAx10) $ = '(syl (bi2 (k218IHypProvableeq2 (sqQuoteeq5 oscExaCode))) (mpd (a1i osiExaBound) oscSeparationAt));

pub theorem oscRRLiteral: $ eofAx11 = osiRRFormula $ = 'eqid;

pub theorem oscRRCode: $ eofAx11 = zfcReplacementCode osiRRMatrix 3 $ = '(eqtr oscRRLiteral (eqcom osiRRCode));

pub theorem oscRRImage: $ omegaReplacementImages -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 eofAx11) $ = '(syl (bi2 (k218IHypProvableeq2 (sqQuoteeq5 oscRRCode))) (mpd (a1i osiRRBound) oscReplacementAt));

pub theorem oscZmemLiteral: $ eofAx12 = osiZmemFormula $ = 'eqid;

pub theorem oscZmemCode: $ eofAx12 = zfcSeparationCode osiZmemMatrix 1 $ = '(eqtr oscZmemLiteral (eqcom osiZmemCode));

pub theorem oscZmemImage: $ omegaSeparationImages -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 eofAx12) $ = '(syl (bi2 (k218IHypProvableeq2 (sqQuoteeq5 oscZmemCode))) (mpd (a1i osiZmemBound) oscSeparationAt));

pub theorem oscOmLiteral: $ eofAx13 = osiOmFormula $ = 'eqid;

pub theorem oscOmCode: $ eofAx13 = zfcSeparationCode osiOmMatrix 0 $ = '(eqtr oscOmLiteral (eqcom osiOmCode));

pub theorem oscOmImage: $ omegaSeparationImages -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 eofAx13) $ = '(syl (bi2 (k218IHypProvableeq2 (sqQuoteeq5 oscOmCode))) (mpd (a1i osiOmBound) oscSeparationAt));

pub theorem omegaSchemas_supply_five: $ omegaSeparationImages -> omegaReplacementImages -> eofFiveImages $ = '(exp (iand (syl oscAgrImage anl) (iand (syl oscExaImage anl) (iand (syl oscRRImage anr) (iand (syl oscZmemImage anl) (syl oscOmImage anl))))));

pub theorem omegaSchemas_prove_Infinity: $ omegaSeparationImages -> omegaReplacementImages -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 zfcOmega) $ = '(exp (syl eofOmegaImage (iand (syl oscAgrImage anl) (iand (syl oscExaImage anl) (iand (syl oscRRImage anr) (iand (syl oscZmemImage anl) (syl oscOmImage anl)))))));
