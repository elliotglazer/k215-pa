import "source_reflection_least_cond_parameters.mm0";

def lopBF0: nat = $ sfMem 0 1 $;

def lopBF1: nat = $ sfMem 0 2 $;

def lopBF2: nat = $ sfImp lopBF0 lopBF1 $;

def lopBF3: nat = $ sfAll lopBF2 $;

def lopBF4: nat = $ sfImp lopBF0 lopBF3 $;

def lopBF5: nat = $ sfAll lopBF4 $;

def lopBF6: nat = $ sfImp lopBF0 lopBF5 $;

def lopBF7: nat = $ sfAll lopBF6 $;

def lopBF8: nat = $ sfAnd lopBF5 lopBF7 $;


theorem sfLeastOrdinalPredicate_bound: $ sfBound 1 sfLeastOrdinalPredicate $;

theorem sfLeastParam_bound(n phi x y:nat)(hb:$ sfBound (suc n) phi $)(hx:$ x < n + y $): $ sfBound (n + y) (sfLeastParam phi x y) $;

theorem sfLeastOrdinalParametersLaw_bound_meta(n phi:nat)(hb:$ sfBound (suc n) phi $): $ sfBound n (sfLeastOrdinalLaw phi) $;

theorem sfLeastOrdinalParametersLaw_bound(n phi:nat): $ sfBound (suc n) phi -> sfBound n (sfLeastOrdinalLaw phi) $;
