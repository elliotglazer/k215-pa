def k215Loop4698State (pc x y z c: nat): nat = $ k215PState pc (k215PVector z x (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) y (k215PR7 c) (k215PR8 c)) $;

def k215Loop4698Claim (x c: nat) (.y .z: nat): wff =
 $ A. y A. z k215PIter (3 * x + 1) (k215Loop4698State k215PNum4698 x y z c) = (k215Loop4698State k215PNum4701 0 (x + y) z c) $;

theorem k215Loop4698Transfer (x y z c: nat): $ k215PIter (3 * x + 1) (k215Loop4698State k215PNum4698 x y z c) = (k215Loop4698State k215PNum4701 0 (x + y) z c) $;

theorem k215Loop4698Vector (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ k215PIter (3 * a1 + 1) (k215PState k215PNum4698 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) =
   k215PState k215PNum4701 (k215PVector a0 0 a2 a3 a4 a5 (a1 + a6) a7 a8) $;

