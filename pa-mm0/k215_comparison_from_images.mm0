import "source_l_interpretation.mm0";

import "k215_core_transfer.mm0";

import "k215_source_transfer.mm0";

def k215ComparisonImageObligations: wff = $ sfZFCImageFamilies zfrAxioms sfLDomain /\ (omegaReplacementImages /\ k215SourceBundleImages) $;

theorem k215ZFC_refutation_from_images:
 $ sfZFCImageFamilies zfrAxioms sfLDomain -> omegaReplacementImages -> zfcInconsistent -> k215Inconsistent $;

theorem k215Inconsistency_iff_ZFC_from_images:
 $ k215ComparisonImageObligations -> (k215Inconsistent <-> zfcInconsistent) $;

theorem k215Consistency_iff_ZFC_from_images:
 $ k215ComparisonImageObligations -> (~k215Inconsistent <-> ~zfcInconsistent) $;
