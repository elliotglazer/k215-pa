import "source_l_ordinals_in_l_syntax.mm0";
import "source_l_omega_shell_replay.mm0";

import "extracted_ltrans_weak.mm0";

def slOEqF0: nat = $ sfMem 0 1 $;

def slOEqF1: nat = $ sfBot $;

def slOEqF2: nat = $ sfImp slOEqF0 slOEqF1 $;

def slOEqF3: nat = $ sfAll slOEqF2 $;

def slOEqF4: nat = $ sfImp sfLDomain slOEqF2 $;

def slOEqF5: nat = $ sfAll slOEqF4 $;

def slOEqF6: nat = $ sfAnd slOEqF3 slOEqF0 $;

def slOEqF7: nat = $ sfAnd slOEqF5 slOEqF0 $;

def slOEqF8: nat = $ sfEx slOEqF6 $;

def slOEqF9: nat = $ sfAnd sfLDomain slOEqF7 $;

def slOEqF10: nat = $ sfEx slOEqF9 $;

def slOEqF11: nat = $ sfMem 0 2 $;

def slOEqF12: nat = $ sfEq 0 2 $;

def slOEqF13: nat = $ sfOr slOEqF11 slOEqF12 $;

def slOEqF14: nat = $ sfImp slOEqF0 slOEqF13 $;

def slOEqF15: nat = $ sfImp slOEqF13 slOEqF0 $;

def slOEqF16: nat = $ sfAnd slOEqF14 slOEqF15 $;

def slOEqF17: nat = $ sfAll slOEqF16 $;

def slOEqF18: nat = $ sfImp sfLDomain slOEqF16 $;

def slOEqF19: nat = $ sfAll slOEqF18 $;

def slOEqF20: nat = $ sfAnd slOEqF17 slOEqF11 $;

def slOEqF21: nat = $ sfAnd slOEqF19 slOEqF11 $;

def slOEqF22: nat = $ sfEx slOEqF20 $;

def slOEqF23: nat = $ sfAnd sfLDomain slOEqF21 $;

def slOEqF24: nat = $ sfEx slOEqF23 $;

def slOEqF25: nat = $ sfImp slOEqF0 slOEqF22 $;

def slOEqF26: nat = $ sfImp slOEqF0 slOEqF24 $;

def slOEqF27: nat = $ sfAll slOEqF25 $;

def slOEqF28: nat = $ sfImp sfLDomain slOEqF26 $;

def slOEqF29: nat = $ sfAll slOEqF28 $;

def slOEqF30: nat = $ sfAnd slOEqF8 slOEqF27 $;

def slOEqF31: nat = $ sfAnd slOEqF10 slOEqF29 $;

def slOEqF32: nat = $ sfImp slOEqF11 slOEqF0 $;

def slOEqF33: nat = $ sfAll slOEqF32 $;

def slOEqF34: nat = $ sfImp sfLDomain slOEqF32 $;

def slOEqF35: nat = $ sfAll slOEqF34 $;

def slOEqF36: nat = $ sfImp slOEqF30 slOEqF33 $;

def slOEqF37: nat = $ sfImp slOEqF31 slOEqF35 $;

def slOEqF38: nat = $ sfAll slOEqF36 $;

def slOEqF39: nat = $ sfImp sfLDomain slOEqF37 $;

def slOEqF40: nat = $ sfAll slOEqF39 $;

def slOEqF41: nat = $ sfAnd slOEqF30 slOEqF38 $;

def slOEqF42: nat = $ sfAnd slOEqF31 slOEqF40 $;


theorem sfLOmegaShell_context: $ slOSContext = sfLBackground $;

theorem sfLOmegaShell_formula: $ slOSFormula = sfImp sfLTransitivity (sfImp sfLOrdinalsInL (sfRelativize sfLDomain zfcOmega)) $;

theorem sfLOmegaShell_local: $ nsLocal sfLBackground (sfImp sfLTransitivity (sfImp sfLOrdinalsInL (sfRelativize sfLDomain zfcOmega))) $;

theorem sfLOmegaShell_zfr: $ sfTheoryProvable zfrAxioms (sfImp sfLTransitivity (sfImp sfLOrdinalsInL (sfRelativize sfLDomain zfcOmega))) $;

theorem sfLOmega_from_ordinals: $ sfTheoryProvable zfrAxioms sfLOrdinalsInL -> sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcOmega) $;
