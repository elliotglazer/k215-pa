import "source_reflection_transfer_tv_row_fold.mm0";

import "source_reflection_transfer_function_enumeration.mm0";

import "source_reflection_transfer_tv_inputs.mm0";

theorem sfTVEnumRow_positive(D level G N C k c:nat)(hf:$ nsLocal G (sfTVFunctionRowLawConjunction D level (sfTVEnumRows D) (sfTVEnumLength N C)) $)(hp:$ nsLocal G (sfReflectionLimitProfile level (sfPieceFunctionBinary D (sfReflectionPCLevel level) (sfTVEnumRows D) (sfTVEnumLength N C))) $)(hl:$ nsLocal G (sfORBinary level 0 3) $)(hk:$ k <= N $)(hc:$ c <= C $)(hb:$ sfBound (suc k) c $): $ nsLocal G (sfTVRowBall D k (sfRelativize D c) 3) $;

theorem sfTVEnumRow_negative(D level G N C k c:nat)(hf:$ nsLocal G (sfTVFunctionRowLawConjunction D level (sfTVEnumRows D) (sfTVEnumLength N C)) $)(hp:$ nsLocal G (sfReflectionLimitProfile level (sfPieceFunctionBinary D (sfReflectionPCLevel level) (sfTVEnumRows D) (sfTVEnumLength N C))) $)(hl:$ nsLocal G (sfORBinary level 0 3) $)(hk:$ k <= N $)(hc:$ c <= C $)(hb:$ sfBound (suc k) c $): $ nsLocal G (sfTVRowBall D k (sfImp (sfRelativize D c) sfBot) 3) $;

theorem sfTVEnumRows_inputs(D level G N C:nat)(hf:$ nsLocal G (sfTVFunctionRowLawConjunction D level (sfTVEnumRows D) (sfTVEnumLength N C)) $)(hp:$ nsLocal G (sfReflectionLimitProfile level (sfPieceFunctionBinary D (sfReflectionPCLevel level) (sfTVEnumRows D) (sfTVEnumLength N C))) $)(hl:$ nsLocal G (sfORBinary level 0 3) $): $ sfTVRowInputs D G 3 N C $;
