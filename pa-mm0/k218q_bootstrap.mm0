import "k218q_source_theory.mm0";
import "k218q_source_empty.mm0";
import "k218q_seed_request.mm0";
import "k230_bootstrap_discharge.mm0";
import "source_core_theory.mm0";

def k218QDomainSeedCode: nat = $ k218QSeedCode (kEq 3 1) $;

theorem k218QBootstrap_domain_member: $ k218QProvable (kExists 3 (kMem 1 3)) $;

theorem k218QBootstrap_empty: $ k218QProvable kEmptyObject $;

theorem k218QBootstrap_domain_discharge: $ k218IHypProvable kQuotientContext kF -> k218IHypProvable (kEmptyMarker : 0) kF $;

theorem k218QBootstrap_marker_discharge: $ k218IHypProvable (kEmptyMarker : 0) kF -> k218QProvable kF $;

theorem k218QBootstrap_refutation: $ k218IHypProvable kQuotientContext kF -> k218QProvable kF $;
