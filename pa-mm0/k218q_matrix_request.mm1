import "k218q_leibniz.mm1";
import "k218_role_substitution.mm1";
import "quotation_binders_absent.mm1";

@_ def k218MatrixRequest (E: set) (B b a c f: nat): nat =
 $ kImp (kExists b (sfNamedTemplate (sqEnvCons b (sqEnvCons a E)) B 0 f))
     (kExists b (kAnd (kMem b c)
       (sfNamedTemplate (sqEnvCons b (sqEnvCons a E)) B 0 f))) $;

pub theorem k218MatrixRequest_substitution (E: set) (n B b a c p f: nat)
 (ha: $ a < B $) (ha0: $ a != 0 $) (hab: $ a != b $) (hac: $ a != c $)
 (he: $ sqEnvAvoid E n a $) (hf: $ sfBound (suc (suc n)) f $):
 $ kSubst (k218MatrixRequest E B b a c f) a p = k218MatrixRequest E B b p c f $ =
'(eqtr kSubst_kImp (kImpeq
  (eqtr (ax_mp (qsSubst_kExists ha0) (ax_mp necom hab))
    (kExistseq2 (k218RoleInput_substitution ha ha0 hab he hf)))
  (eqtr (ax_mp (qsSubst_kExists ha0) (ax_mp necom hab))
    (kExistseq2 (eqtr (qsSubst_kAnd ha0) (kAndeq
      (eqtr kSubst_kMem (kMemeq
        (ax_mp kReplace_miss (ax_mp necom hab))
        (ax_mp kReplace_miss (ax_mp necom hac))))
      (k218RoleInput_substitution ha ha0 hab he hf)))))));

pub theorem k218MatrixRequest_binder_absent (E: set) (B b a c f z: nat)
 (hz: $ z < B $) (hzb: $ z != b $) (hf: $ sfWf f $):
 $ kBinderAbsent (k218MatrixRequest E B b a c f) z $ =
'(mpbir kBinderAbsent_kImp (ian
  (ax_mp (ax_mp kBinderAbsent_exists_intro hzb)
    (ax_mp (sfNamedTemplate_binder_absent hz) hf))
  (ax_mp (ax_mp kBinderAbsent_exists_intro hzb)
    (ax_mp (ax_mp kBinderAbsent_and_intro kBinderAbsent_kMem)
      (ax_mp (sfNamedTemplate_binder_absent hz) hf)))));

pub theorem k218QMatrixRequest_congruence (E: set) (n B b a c p f: nat)
 (ha: $ a < B $) (hp: $ p < B $) (ha0: $ a != 0 $)
 (hab: $ a != b $) (hpb: $ p != b $) (hac: $ a != c $)
 (he: $ sqEnvAvoid E n a $) (hf: $ sfBound (suc (suc n)) f $):
 $ k218QProvable (kImp (kEq a p)
     (kImp (k218MatrixRequest E B b a c f) (k218MatrixRequest E B b p c f))) $ =
'(mpbi (k218QProvableeq (kImpeq2 (kImpeq2
    (k218MatrixRequest_substitution ha ha0 hab hac he hf))))
  (ax_mp k218ILeibniz_forward (ian
    (k218MatrixRequest_binder_absent ha hab (ax_mp sfBound_wf hf))
    (k218MatrixRequest_binder_absent hp hpb (ax_mp sfBound_wf hf)))));
