import "k230_deduction.mm1";

@_ abstract def kContextProofClass (G .a: nat): set = $ {a | kHypProvable G a} $;
@_ def kContextSupports (G H: nat): wff = $ traceClassAll (kContextProofClass G) H $;

pub theorem kContextProofClass_value (G a: nat):
 $ a e. kContextProofClass G <-> kHypProvable G a $ =
(named '(elabe ,eqtac));

pub theorem kContextSupports_member (G H a: nat):
 $ kContextSupports G H -> a IN H -> kHypProvable G a $ =
'(syl6 (bi1 kContextProofClass_value) traceClassAll_get);

pub theorem kContextSupports_self (G: nat): $ kContextSupports G G $ =
(named '(ax_gen @ syl (bi2 kContextProofClass_value) kHypProvable_assumption));

pub theorem kContextSupports_nil (G: nat): $ kContextSupports G 0 $ =
'traceClassAll_nil;

pub theorem kContextSupports_cons (G H a: nat):
 $ kContextSupports G H -> kHypProvable G a -> kContextSupports G (a : H) $ =
'(exp @ sylc traceClassAll_cons (syl (bi2 kContextProofClass_value) anr) anl);

theorem kCR_assumption (G H a: nat) (hs: $ kContextSupports G H $):
 $ a IN H -> a e. kContextProofClass G $ =
'(syl (bi2 kContextProofClass_value) (ax_mp kContextSupports_member hs));

theorem kCR_seed (G a: nat):
 $ a e. kTheorems -> a e. kContextProofClass G $ =
'(syl (bi2 kContextProofClass_value) @ syl kHypProvable_seed (bi1 kTheorems_value));

theorem kCR_trace_get (G l a: nat):
 $ traceClassAll (kContextProofClass G) l -> a IN l -> kHypProvable G a $ =
'(syl6 (bi1 kContextProofClass_value) traceClassAll_get);

theorem kCR_mp_payload (G l a b: nat):
 $ traceClassAll (kContextProofClass G) l ->
   (b IN l /\ kImp b a IN l) -> a e. kContextProofClass G $ =
'(exp @ syl (bi2 kContextProofClass_value) @
  sylc kHypProvable_mp
    (mpd (syl anl anr) (syl kCR_trace_get anl))
    (mpd (syl anr anr) (syl kCR_trace_get anl)));

theorem kCR_mp_exists {b: nat} (G l a: nat):
 $ traceClassAll (kContextProofClass G) l ->
   E. b (b IN l /\ kImp b a IN l) -> a e. kContextProofClass G $ =
(named '(eexd kCR_mp_payload));

theorem kCR_rule (G H l a: nat) (hs: $ kContextSupports G H $):
 $ traceClassAll (kContextProofClass G) l ->
   (a, l) e. kHypRules H -> a e. kContextProofClass G $ =
(named '(syl5bi kHypRules_value @ eord
  (a1i (kCR_assumption hs)) (eord (a1i kCR_seed) kCR_mp_exists)));

pub theorem kHypRules_refine_sound (G H: nat) (hs: $ kContextSupports G H $):
 $ traceRuleSound (kHypRules H) (kContextProofClass G) $ =
(named '(ax_gen @ ax_gen (kCR_rule hs)));

pub theorem kHypDerives_refine (G H p a: nat) (hs: $ kContextSupports G H $):
 $ kHypDerives H p a -> kHypProvable G a $ =
'(syl (bi1 kContextProofClass_value) (ax_mp traceDerives_class (kHypRules_refine_sound hs)));

pub theorem kHypProvable_refine (G H a: nat) (hs: $ kContextSupports G H $):
 $ kHypProvable H a -> kHypProvable G a $ =
(named '(eex (kHypDerives_refine hs)));

theorem kCR_assumption_d (G H a: nat):
 $ kContextSupports G H -> a IN H -> a e. kContextProofClass G $ =
'(syl6 (bi2 kContextProofClass_value) kContextSupports_member);

theorem kCR_rule_d (G H l a: nat):
 $ kContextSupports G H -> traceClassAll (kContextProofClass G) l ->
   (a, l) e. kHypRules H -> a e. kContextProofClass G $ =
(named '(exp @ syl5bi kHypRules_value @ eord
  (syl kCR_assumption_d anl)
  (eord (a1i kCR_seed) (syl kCR_mp_exists anr))));

theorem kCR_sound_d (G H: nat):
 $ kContextSupports G H -> traceRuleSound (kHypRules H) (kContextProofClass G) $ =
(named '(iald @ iald kCR_rule_d));

theorem kCR_derives_d (G H p a: nat):
 $ kContextSupports G H -> kHypDerives H p a -> kHypProvable G a $ =
'(syl6 (bi1 kContextProofClass_value) (syl traceDerives_class kCR_sound_d));

pub theorem kHypProvable_refine_d (G H a: nat):
 $ kContextSupports G H -> kHypProvable H a -> kHypProvable G a $ =
(named '(eexd kCR_derives_d));

theorem kContextIncludes_at {c: nat} (G H a: nat):
 $ A. c (c IN H -> c IN G) -> a IN H -> a IN G $ =
(named '(!! eale c ,eqtac));

pub theorem kContextSupports_inclusion {c: nat} (G H: nat)
 (hi: $ A. c (c IN H -> c IN G) $):
 $ kContextSupports G H $ =
(named '(ax_gen @ syl (bi2 kContextProofClass_value) @
  syl kHypProvable_assumption (ax_mp kContextIncludes_at hi)));

pub theorem kHypProvable_monotone {c: nat} (G H a: nat)
 (hi: $ A. c (c IN H -> c IN G) $):
 $ kHypProvable H a -> kHypProvable G a $ =
'(kHypProvable_refine (kContextSupports_inclusion hi));
