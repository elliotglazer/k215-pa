import "bb215_derivability_l2_mul_basic.mm0";
import "bb215_derivability_l2_subst_lift.mm0";

-- L05, layer L2 (lanes/L05.md): level-n instances of commutativity and associativity of +,
-- and S x * y = x * y + y inside PA. Generated by build_bb215_derivability_l2_add_basic.py.

theorem bb215L2_add_comm_inst (n s t: nat) (hs: $ paTermBound n s $) (ht: $ paTermBound n t $):
  $ paProvable n (paFormulaEqual (paTermAddition s t) (paTermAddition t s)) $;

theorem bb215L2_add_assoc_inst (n x y z: nat) (hx: $ paTermBound n x $) (hy: $ paTermBound n y $) (hz: $ paTermBound n z $):
  $ paProvable n (paFormulaEqual (paTermAddition (paTermAddition x y) z) (paTermAddition x (paTermAddition y z))) $;

-- PA |- A. y A. x (S x * y = x * y + y)

theorem bb215L2_mul_succ_left:
  $ paProvable 0 (paFormulaAll (paFormulaAll (paFormulaEqual (paTermMultiplication (paTermSuccessor (paTermVariable 0)) (paTermVariable 1)) (paTermAddition (paTermMultiplication (paTermVariable 0) (paTermVariable 1)) (paTermVariable 1))))) $;
