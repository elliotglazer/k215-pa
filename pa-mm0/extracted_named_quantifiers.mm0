import "quotation_rebase.mm0";
import "quotation_source_substitution.mm0";
import "k230_deduction.mm0";
import "quotation_supported_quantifiers.mm0";

-- Plain source syntax, with no second quotient interpretation.
theorem exNamed_allE_scoped (H: nat) (E: set) (n k y a: nat)
 (hz: $ k != 0 $) (hy: $ y < k $) (he: $ sqEnvAvoid E n k $)
 (ha: $ sfBound (suc n) a $):
 $ kHypProvable H (sfNamedTemplate E k 0 (sfAll a)) ->
   kHypProvable H (sfNamedTemplate (sqEnvCons y E) (suc k) 0 a) $;

theorem exNamed_exI_scoped (H: nat) (E: set) (n k y a: nat)
 (hz: $ k != 0 $) (hy: $ y < k $) (he: $ sqEnvAvoid E n k $)
 (ha: $ sfBound (suc n) a $):
 $ kHypProvable H (sfNamedTemplate (sqEnvCons y E) (suc k) 0 a) ->
   kHypProvable H (sfNamedTemplate E k 0 (sfEx a)) $;
