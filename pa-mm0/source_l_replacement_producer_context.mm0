import "source_l_replacement_schema_seed.mm0";

import "source_l_replacement_parameter_transport.mm0";

theorem sfLReplacementInput_lift(G n phi f:nat)
 (hf:$ sfShift 0 f = f $)
 (hp:$ nsLocal (sfLSeparationImageParameterContext sfLDomain n G) f $):
 $ nsLocal (sfLReplacementSchemaInput G n phi) f $;
