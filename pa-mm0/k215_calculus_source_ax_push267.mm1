theorem k215PairVectorInAt267 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt273State k215PNum273 a6 a1 a7 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum273 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215PairVectorOutAt267 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt273State k215PNum283 0 0 (a7 + (a6, a1)) (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum283 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

pub theorem k215PairMacro46_vectorAt267 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat):
 $ k215PReach (k215PState k215PNum273 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215PNum283 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ =
 '(mpbi (k215PReacheq k215PairVectorInAt267 k215PairVectorOutAt267) k215PairMacro273);

theorem k215PushAStage0At267 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum267 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum270 (k215PVector u 0 w c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop267Vector (k215PStateeq2 (k215PVectoreq7 add0))));

theorem k215PushAStage1At267 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum270 (k215PVector u 0 w c a b t 0 v)) (k215PState k215PNum273 (k215PVector u w 0 c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop270Vector (k215PStateeq2 (k215PVectoreq2 add0))));

theorem k215PushAStage2At267 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum273 (k215PVector u w 0 c a b t 0 v)) (k215PState k215PNum283 (k215PVector u 0 0 c a b 0 (t, w) v)) $ = '(mpbi (k215PReacheq2 (k215PStateeq2 (k215PVectoreq8 add01))) k215PairMacro46_vectorAt267);

theorem k215PushAStage3At267 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum283 (k215PVector u 0 0 c a b 0 (t, w) v)) (k215PState k215PNum286 (k215PVector u 0 (t, w) c a b 0 0 v)) $ = '(k215PReach_intro (eqtr k215Loop283Vector (k215PStateeq2 (k215PVectoreq3 add0))));

theorem k215PushAStage4At267 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum286 (k215PVector u 0 (t, w) c a b 0 0 v)) (k215PState k215PNum290 (k215PVector u a (t, w) c 0 b a 0 v)) $ = '(k215PReach_intro (eqtr k215Loop286Vector (k215PStateeq2 (k215PVectoreq eqid add0 eqid eqid eqid eqid add0 eqid eqid))));

theorem k215PushAStage5At267 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum290 (k215PVector u a (t, w) c 0 b a 0 v)) (k215PState k215PNum293 (k215PVector u a (t, w) c a b 0 0 v)) $ = '(k215PReach_intro (eqtr k215Loop290Vector (k215PStateeq2 (k215PVectoreq5 add0))));

pub theorem k215PushParam267 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum267 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum293 (k215PVector u a (t, w) c a b 0 0 v)) $ = '(ax_mp (ax_mp k215PReach_trans k215PushAStage0At267) (ax_mp (ax_mp k215PReach_trans k215PushAStage1At267) (ax_mp (ax_mp k215PReach_trans k215PushAStage2At267) (ax_mp (ax_mp k215PReach_trans k215PushAStage3At267) (ax_mp (ax_mp k215PReach_trans k215PushAStage4At267) k215PushAStage5At267)))));

