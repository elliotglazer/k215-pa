import "source_piece_pcf_rep_cover_laws_r39.mm1";

@_ abstract def pcr40Fresh(G C:nat):nat = $ sfMem 0 (suc C) : sfContextShift G $;

theorem pcr40_fresh_wf(G C:nat): $ sfContextWf (pcr40Fresh G C) $ = (named '(mpbir sfContextWf_cons (ian sfWf_mem sfContextShift_wf)));

pub theorem sfPieceRepCoverSuccessorClosed_from_law(G B C A:nat)(hs:$ nsLocal G sfPieceRepCoverStepLaw $)(hc:$ nsLocal G (sfPieceRepClosure B C) $)(ha:$ nsLocal G (sfMem A C) $): $ nsLocal G (sfPieceRepCoverSuccessorClosed A C) $ = (named '(ax_mp (sfLocal_allI (ax_mp nsLocal_context_wf hs)) (ax_mp nsLocal_II (ax_mp (ax_mp (ax_mp (ax_mp sfPieceRepCoverStepLaw_use (ax_mp (ax_mp (ax_mp nsLocal_weaken pcr40_fresh_wf) sfContextSub_cons) (sfRQ_rewrite sfPieceRepCoverStepLaw_shift (ax_mp sfSepLocal_shift hs)))) (ax_mp (ax_mp (ax_mp nsLocal_weaken pcr40_fresh_wf) sfContextSub_cons) (sfRQ_rewrite sfPieceRepClosure_shift (ax_mp sfSepLocal_shift hc)))) (ax_mp (ax_mp nsLocal_hyp pcr40_fresh_wf) sfContext_member_head)) (ax_mp (ax_mp (ax_mp nsLocal_weaken pcr40_fresh_wf) sfContextSub_cons) (sfRQ_rewrite (eqtr (eqcom (ax_mp sfRename_successor sfWf_mem)) (eqtr sfRename_sfMem (nsMem_eq (eqtr sfRenameIndex_zero sfSuccessorMap_value) (eqtr sfRenameIndex_zero sfSuccessorMap_value)))) (ax_mp sfSepLocal_shift ha)))))));

@_ abstract def pcr40G3(G:nat):nat = $ sfContextShift (sfContextShift (sfContextShift G)) $;

@_ abstract def pcr40Guard(G:nat):nat = $ sfPieceRepClosure 1 0 : sfPieceRepSuccessor 2 1 : pcr40G3 G $;

theorem pcr40_guard_wf(G:nat): $ sfContextWf (pcr40Guard G) $ = (named '(mpbir sfContextWf_cons (ian sfPieceRepClosure_wf (mpbir sfContextWf_cons (ian sfPieceRepSuccessor_wf sfContextShift_wf)))));

@_ abstract def sfPieceRepCoverFormula(n:nat):nat = $ sfAll (sfAll (sfAll (sfImp (sfPieceRepSuccessor 2 1) (sfImp (sfPieceRepClosure 1 0) (sfPieceRepEnvironmentCover 2 0 n))))) $;

pub theorem sfPieceRepCover_from_finite_laws(G n:nat)(hb:$ nsLocal G sfPieceRepCoverBaseLaw $)(ha:$ nsLocal G sfPieceRepCoverCarrierLaw $)(ht:$ nsLocal G sfPieceRepCoverStepLaw $): $ nsLocal G (sfPieceRepCoverFormula n) $ = (named '(ax_mp (sfLocal_allI (ax_mp nsLocal_context_wf hb)) (ax_mp (sfLocal_allI sfContextShift_wf) (ax_mp (sfLocal_allI sfContextShift_wf) (ax_mp nsLocal_II (ax_mp nsLocal_II (sfPieceRepEnvironmentCover_from_base_closed (sfPieceRepEnvironmentCover_zero_from_actual (ax_mp (ax_mp nsLocal_mp (ax_mp (ax_mp nsLocal_mp (ax_mp (ax_mp (ax_mp nsLocal_weaken pcr40_guard_wf) sfContextSub_cons) (ax_mp (ax_mp (ax_mp nsLocal_weaken (mpbir sfContextWf_cons (ian sfPieceRepSuccessor_wf sfContextShift_wf))) sfContextSub_cons) (ax_mp sfSepLocal_open (ax_mp sfSepLocal_open (ax_mp sfSepLocal_open hb)))))) (ax_mp (ax_mp nsLocal_hyp pcr40_guard_wf) (ax_mp sfContext_member_tail sfContext_member_head)))) (ax_mp (ax_mp nsLocal_hyp pcr40_guard_wf) sfContext_member_head))) (sfPieceRepCoverSuccessorClosed_from_law (ax_mp (ax_mp (ax_mp nsLocal_weaken pcr40_guard_wf) sfContextSub_cons) (ax_mp (ax_mp (ax_mp nsLocal_weaken (mpbir sfContextWf_cons (ian sfPieceRepSuccessor_wf sfContextShift_wf))) sfContextSub_cons) (sfRQ_rewrite sfPieceRepCoverStepLaw_shift (ax_mp sfSepLocal_shift (sfRQ_rewrite sfPieceRepCoverStepLaw_shift (ax_mp sfSepLocal_shift (sfRQ_rewrite sfPieceRepCoverStepLaw_shift (ax_mp sfSepLocal_shift ht)))))))) (ax_mp (ax_mp nsLocal_hyp pcr40_guard_wf) sfContext_member_head) (ax_mp (ax_mp nsLocal_mp (ax_mp (ax_mp nsLocal_mp (ax_mp (ax_mp (ax_mp nsLocal_weaken pcr40_guard_wf) sfContextSub_cons) (ax_mp (ax_mp (ax_mp nsLocal_weaken (mpbir sfContextWf_cons (ian sfPieceRepSuccessor_wf sfContextShift_wf))) sfContextSub_cons) (ax_mp sfSepLocal_open (ax_mp sfSepLocal_open (ax_mp sfSepLocal_open ha)))))) (ax_mp (ax_mp nsLocal_hyp pcr40_guard_wf) (ax_mp sfContext_member_tail sfContext_member_head)))) (ax_mp (ax_mp nsLocal_hyp pcr40_guard_wf) sfContext_member_head))))))))));
