import "source_l_separation_image_parameter_inputs.mm0";
import "source_l_replacement_common_collect.mm0";

def sfLSeparationImageInputContext(G n:nat):nat =
 $ sfLDomain : sfContextShift (sfLSeparationImageParameterContext sfLDomain n G) $;
def slSepCollectContext(G:nat):nat = $ sfLReplacementLevelExtension : G $;

theorem slSepCollect_weaken(G a:nat)(he:$ nsLocal G sfLReplacementLevelExtension $)(hp:$ nsLocal G a $):
 $ nsLocal (slSepCollectContext G) a $;
theorem sfLSeparationImage_collect_from_proof(G start count a seed:nat)
 (he:$ nsLocal G sfLReplacementLevelExtension $)
 (ho:$ nsLocal G (sfCLOrdinalAt a) $)(hl:$ nsLocal G (sfCLHierarchyAt a seed) $)
 (hi:$ nsLocal G (sfCLPredicates sfLDomain start count) $):
 $ nsLocal G (sfLReplacementSeededRecipe start count seed) $;
theorem sfLSeparationImage_collect_all_inputs(G n a seed:nat)(hg:$ sfContextWf G $)
 (he:$ nsLocal (sfLSeparationImageInputContext G n) sfLReplacementLevelExtension $)
 (ho:$ nsLocal (sfLSeparationImageInputContext G n) (sfCLOrdinalAt a) $)
 (hl:$ nsLocal (sfLSeparationImageInputContext G n) (sfCLHierarchyAt a seed) $):
 $ nsLocal (sfLSeparationImageInputContext G n) (sfLReplacementSeededRecipe 0 (suc n) seed) $;
