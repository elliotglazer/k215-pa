theorem bcSiS0_value (i: nat): $ paSITermSuccMap @ i = if (i = 0) 0 (suc i) $;
theorem bcSiS1_value (i: nat): $ paSITermLeftMap @ i = if (i = 0) 1 (suc (suc i)) $;
theorem bcSiS2_value (i: nat): $ paSITermRightMap @ i = if (i = 0) 0 (suc (suc i)) $;
theorem bcSiS3_value (i: nat): $ paSIFormulaLeftMap @ i = if (i = 0) 1 (suc i) $;
theorem bcSiMap_0 (i j: nat): $ bcSiMap 0 i j <-> j = paSITermSuccMap @ i $;
theorem bcSiMap_1 (i j: nat): $ bcSiMap 1 i j <-> j = paSITermLeftMap @ i $;
theorem bcSiMap_2 (i j: nat): $ bcSiMap 2 i j <-> j = paSITermRightMap @ i $;
theorem bcSiMap_3 (i j: nat): $ bcSiMap 3 i j <-> j = paSIFormulaLeftMap @ i $;
theorem bcSiIdxQ {u x: nat} (e d i j: nat) (R: set) (hM: $ bcSiMap e u x <-> x = R @ u $):
  $ d <= i -> (E. u (u <= i /\ d + u = i /\ E. x (x <= j /\ bcSiMap e u x /\ j = d + x)) <->
    j = d + (R @ (i - d))) $;
theorem bcCeIdxQ {u x: nat} (e d i j: nat) (R: set) (hM: $ bcCeMap e u x <-> x = R @ u $):
  $ d <= i -> (E. u (u <= i /\ d + u = i /\ E. x (x <= j /\ bcCeMap e u x /\ j = d + x)) <->
    j = d + (R @ (i - d))) $;
theorem bcSiIdx_0 (d i j: nat): $ bcSiIdx 0 d i j <-> j = sfRenameIndex paSITermSuccMap d i $;
theorem bcSiIdx_1 (d i j: nat): $ bcSiIdx 1 d i j <-> j = sfRenameIndex paSITermLeftMap d i $;
theorem bcSiIdx_2 (d i j: nat): $ bcSiIdx 2 d i j <-> j = sfRenameIndex paSITermRightMap d i $;
theorem bcSiIdx_3 (d i j: nat): $ bcSiIdx 3 d i j <-> j = sfRenameIndex paSIFormulaLeftMap d i $;
theorem bcCeIdx_iff {ii jj: nat} (R: set) (e d i j: nat) (hR: $ A. ii A. jj (bcCeMap e ii jj <-> jj = R @ ii) $):
  $ bcCeIdx e d i j <-> j = sfRenameIndex R d i $;
