import "k215_calculus_source_ax_stack_loops.mm1";
import "k215_literal_runtime_reach.mm1";
import "k215_calculus_source_pairing.mm1";
import "k215_calculus_source_ax_stack_lookups.mm1";

@_ def k215PairAt2891State (pc a b t c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) b (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) a t (k215PR8 c)) $;

do (apply (register-eqd 'k215PairAt2891State) '(k215PairAt2891Stateeqd));

theorem k215PairAt2891TransferIn (a b t c: nat): $ k215PIter (4 * b + 1) (k215PairAt2891State k215PNum2891 a b t c) = (k215PairAt2891State k215PNum2895 (a + b) 0 (t + b) c) $ =
 '(eqtr k215Loop2891Vector (k215PStateeq2 (k215PVectoreq eqid eqid eqid eqid eqid eqid addcom addcom eqid)));
theorem k215PairAt2891TransferBack (a t c: nat): $ k215PIter (3 * a + 1) (k215PairAt2891State k215PNum2897 a 0 t c) = (k215PairAt2891State k215PNum2900 0 a t c) $ =
 '(eqtr k215Loop2897Vector (k215PStateeq2 (k215PVectoreq2 add0)));
pub theorem k215PairAt2891ReachIn (a b t c: nat): $ k215PReach (k215PairAt2891State k215PNum2891 a b t c) (k215PairAt2891State k215PNum2895 (a + b) 0 (t + b) c) $ =
 '(k215PReach_intro k215PairAt2891TransferIn);
theorem k215PairAt2891ReachBack (a t c: nat): $ k215PReach (k215PairAt2891State k215PNum2897 a 0 t c) (k215PairAt2891State k215PNum2900 0 a t c) $ =
 '(k215PReach_intro k215PairAt2891TransferBack);


theorem k215PairAt2891Step50Z (b t c: nat): $ k215PStep (k215PairAt2891State k215PNum2895 0 b t c) = (k215PairAt2891State k215PNum2901 0 b t c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupPair2891_2895) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215PairAt2891Reach50Z (b t c: nat): $ k215PReach (k215PairAt2891State k215PNum2895 0 b t c) (k215PairAt2891State k215PNum2901 0 b t c) $ = '(k215PReach_step k215PairAt2891Step50Z);

theorem k215PairAt2891Step50S (a b t c: nat): $ k215PStep (k215PairAt2891State k215PNum2895 (suc a) b t c) = (k215PairAt2891State k215PNum2896 a b t c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupPair2891_2895) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215PairAt2891Reach50S (a b t c: nat): $ k215PReach (k215PairAt2891State k215PNum2895 (suc a) b t c) (k215PairAt2891State k215PNum2896 a b t c) $ = '(k215PReach_step k215PairAt2891Step50S);

theorem k215PairAt2891Step51 (a b t c: nat): $ k215PStep (k215PairAt2891State k215PNum2896 a b t c) = (k215PairAt2891State k215PNum2897 a b (suc t) c) $ = '(eqtr (k215PAtCI k215PLookupPair2891_2896) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215PairAt2891Reach51 (a b t c: nat): $ k215PReach (k215PairAt2891State k215PNum2896 a b t c) (k215PairAt2891State k215PNum2897 a b (suc t) c) $ = '(k215PReach_step k215PairAt2891Step51);

theorem k215PairAt2891Step55 (a b t c: nat): $ k215PStep (k215PairAt2891State k215PNum2900 a b t c) = (k215PairAt2891State k215PNum2891 a b t c) $ = '(k215PAtCC k215PLookupPair2891_2900);

theorem k215PairAt2891Reach55 (a b t c: nat): $ k215PReach (k215PairAt2891State k215PNum2900 a b t c) (k215PairAt2891State k215PNum2891 a b t c) $ = '(k215PReach_step k215PairAt2891Step55);

theorem k215PairAt2891Prefix (k t c: nat): $ k215PReach (k215PairAt2891State k215PNum2895 (suc k) 0 t c) (k215PairAt2891State k215PNum2891 0 k (suc t) c) $ = '(ax_mp (ax_mp k215PReach_trans k215PairAt2891Reach50S) (ax_mp (ax_mp k215PReach_trans k215PairAt2891Reach51) (ax_mp (ax_mp k215PReach_trans k215PairAt2891ReachBack) k215PairAt2891Reach55)));
theorem k215PairAt2891ReachSum (a b t k c: nat): $ a + b = suc k -> k215PReach (k215PairAt2891State k215PNum2891 a b t c) (k215PairAt2891State k215PNum2895 (suc k) 0 (t + b) c) $ =
 '(mpbid (k215PReacheq2d (k215PairAt2891Stateeq2d id)) (a1i k215PairAt2891ReachIn));
pub theorem k215PairAt2891Cycle (a b t k c: nat): $ a + b = suc k -> k215PReach (k215PairAt2891State k215PNum2891 a b t c) (k215PairAt2891State k215PNum2891 0 k (suc (t + b)) c) $ =
 '(mpd (a1i k215PairAt2891Prefix) (syl k215PReach_trans k215PairAt2891ReachSum));
theorem k215PairAt2891ReachZeroIn (t c: nat): $ k215PReach (k215PairAt2891State k215PNum2891 0 0 t c) (k215PairAt2891State k215PNum2895 0 0 t c) $ =
 '(mpbi (k215PReacheq2 (k215PairAt2891Stateeq eqid add0 eqid add0 eqid)) k215PairAt2891ReachIn);
pub theorem k215PairAt2891Base (t c: nat): $ k215PReach (k215PairAt2891State k215PNum2891 0 0 t c) (k215PairAt2891State k215PNum2901 0 0 t c) $ =
 '(ax_mp (ax_mp k215PReach_trans k215PairAt2891ReachZeroIn) k215PairAt2891Reach50Z);


@_ abstract def k215PairAt2891Run (a b t c: nat): wff =
 $ k215PReach (k215PairAt2891State k215PNum2891 a b t c) (k215PairAt2891State k215PNum2901 0 0 (t + (a, b)) c) $;
do (apply (register-eqd 'k215PairAt2891Run) '(k215PairAt2891Runeqd));
theorem k215PairAt2891RunZero (t c: nat): $ k215PairAt2891Run 0 0 t c $ =
 '(mpbi (k215PReacheq2 (k215PairAt2891Stateeq4 (eqcom (eqtr (addeq2 pr0) add0)))) k215PairAt2891Base);
theorem k215PairAt2891RunBase (a b t c: nat): $ a + b = 0 -> k215PairAt2891Run a b t c $ =
 '(mpbiri k215PairAt2891RunZero (k215PairAt2891Runeqd
   (syl anl (bi1 addeq0)) (syl anr (bi1 addeq0)) eqidd eqidd));
theorem k215PairAt2891SumStep (a b k: nat): $ a + b = suc k -> (a, b) = b + suc (0, k) $ =
 '(eqtrd (a1i preqadd) (eqtrd (addeq1d (preq1d id))
   (a1i (eqtr (addeq1 k215PairDiagonal_rotate) addcom))));
theorem k215PairAt2891Accumulator (a b t k: nat): $ a + b = suc k -> suc (t + b) + (0, k) = t + (a, b) $ =
 '(eqtrd
   (a1i (eqtr addS1 (eqtr (suceq addass)
     (eqtr (eqcom addS) (addeq2 (eqcom addS))))))
   (addeq2d (eqcomd k215PairAt2891SumStep)));
@_ abstract def k215PairAt2891Claim (k c: nat) (.a .b .t: nat): wff =
 $ A. a A. b A. t (a + b = k -> k215PairAt2891Run a b t c) $;
theorem k215PairAt2891Claim_at (a b t k c: nat): $ k215PairAt2891Claim k c -> a + b = k -> k215PairAt2891Run a b t c $ =
 (named '(!! ealie i @ !! ealde j @ !! ealde l @ bi1d ,eqtac));
theorem k215PairAt2891RunInductive (a b t k c: nat): $ k215PairAt2891Claim k c -> a + b = suc k -> k215PairAt2891Run a b t c $ =
 '(exp @ mpd
   (mpbid
     (k215PReacheq2d (k215PairAt2891Stateeq4d (syl k215PairAt2891Accumulator anr)))
     (mpd (a1i add01) (syl k215PairAt2891Claim_at anl)))
   (syl k215PReach_trans (syl k215PairAt2891Cycle anr)));
theorem k215PairAt2891Claim_all (k c: nat): $ k215PairAt2891Claim k c $ =
 (named @ induct '(ind) 'k
   '(ax_gen (ax_gen (ax_gen k215PairAt2891RunBase)))
   '(iald @ iald @ iald k215PairAt2891RunInductive));
pub theorem k215PairMacro2891 (a b t c: nat): $ k215PReach (k215PairAt2891State k215PNum2891 a b t c) (k215PairAt2891State k215PNum2901 0 0 (t + (a, b)) c) $ =
 '(ax_mp (ax_mp k215PairAt2891Claim_at k215PairAt2891Claim_all) eqid);


