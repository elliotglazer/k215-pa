import "source_l_replacement_core_assembly.mm0";

-- The Replacement/Separation definability law from the three closure facts and NextLevel.
theorem sfLReplacementDefinableLaw_from_parts(m psi:nat)(hb:$ sfBound (suc m) psi $)
 (hR:$ sfTheoryProvable zfrAxioms (sfLRepLaw m psi) $)
 (hE:$ sfTheoryProvable zfrAxioms (sfLEnvLaw m) $)
 (hO:$ sfTheoryProvable zfrAxioms sfLOp5Law $)
 (hL:$ sfTheoryProvable zfrAxioms sfLNextLevelLaw $):
 $ sfTheoryProvable zfrAxioms (sfLReplacementDefinableLaw m psi) $;

theorem sfLPowerSubsetFormula_bound: $ sfBound (suc 1) sfLPowerSubsetFormula $;

-- The power-set definability premise (literal form of sfLDefPower) from the same facts.
theorem sfLDefPowerLiteral_from_parts
 (hR:$ sfTheoryProvable zfrAxioms (sfLRepLaw 1 sfLPowerSubsetFormula) $)
 (hE:$ sfTheoryProvable zfrAxioms (sfLEnvLaw 1) $)
 (hO:$ sfTheoryProvable zfrAxioms sfLOp5Law $):
 $ sfTheoryProvable zfrAxioms sfLDefPowerLiteral $;
