import "source_reflection_cond_step.mm1";

import "source_omega_recursion_closure.mm1";

def sfReflectionCondClosedSet(level P:nat):nat = $ sfEx (sfAnd (sfMem 1 0) (sfAll (sfImp (sfMem 0 1) (sfEx (sfAnd (sfORBinary (sfReflectionCondStep level P) 1 0) (sfMem 0 2)))))) $;

def sfReflectionCondClosedSetAt(level P a:nat):nat = $ sfSubst 0 a (sfReflectionCondClosedSet level P) $;

pub theorem sfReflectionCondClosedSet_from_producers(level P:nat): $ (sfReflectionCondGuard level P /\ sfReflectionCondProducers level P) -> sfTheoryProvable zfrAxioms (sfReflectionCondClosedSet level P) $ = (named '(mpd sfReflectionCondGTot_from_producers (syl sfTheoryProvable_mp (mpd (syl sfReflectionCond_functional anl) (syl sfTheoryProvable_mp (syl sfOROmega_zfr (syl sfReflectionCondStep_bound anl)))))));

pub theorem sfReflectionCondClosedSetAt_from_producers(level P a:nat): $ (sfReflectionCondGuard level P /\ sfReflectionCondProducers level P) -> sfTheoryProvable zfrAxioms (sfReflectionCondClosedSetAt level P a) $ = (named '(syl sfTheoryProvable_allE (syl (ax_mp sfTheoryProvable_gen zfrAxioms_closed) sfReflectionCondClosedSet_from_producers)));
