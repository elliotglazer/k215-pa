@_ def sfLLevelMember: nat = $ slLMF2454 $;

pub theorem sfLLevelMember_context: $ slLMContext = sfLBackground $ = 'eqid;

pub theorem sfLLevelMember_formula: $ slLMFormula = sfImp sfLDefSelf (sfImp sfLPairNextLevel sfLLevelMember) $ = 'eqid;

pub theorem sfLLevelMember_local: $ nsLocal sfLBackground (sfImp sfLDefSelf (sfImp sfLPairNextLevel sfLLevelMember)) $ = '(mpbi (nsLocal_context_eq sfLLevelMember_context) (mpbi (nsLocal_formula_eq sfLLevelMember_formula) slLMCertificate));

pub theorem sfLLevelMember_factored_zfr: $ sfTheoryProvable zfrAxioms (sfImp sfLDefSelf (sfImp sfLPairNextLevel sfLLevelMember)) $ = '(ax_mp (sfTheory_local sfLBackground_zfr) sfLLevelMember_local);

