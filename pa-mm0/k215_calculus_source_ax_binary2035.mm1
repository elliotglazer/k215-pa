 $ k215PReach (k215PState k215PNum2056 (k215PVector u 0 (snd w) c a b 0 (fst w, t) v)) (k215PState k215PNum2062 (k215PVector u (4 * (fst w, t)) (snd w) c a b 0 0 v)) $ =
