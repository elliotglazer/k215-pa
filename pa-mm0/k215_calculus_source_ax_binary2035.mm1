theorem k215BinaryUnpairInAt2035 (u t w c a b v: nat): $ (k215UnpairAt2035State k215PNum2035 0 0 w (k215PVector u t w c a b 0 0 v)) = (k215PState k215PNum2035 (k215PVector u t w c a b 0 0 v)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector eqid k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryUnpairOutAt2035 (u t w c a b v: nat): $ (k215UnpairAt2035State k215PNum2043 (fst w) (snd w) 0 (k215PVector u t w c a b 0 0 v)) = (k215PState k215PNum2043 (k215PVector u t 0 c a b (fst w) (snd w) v)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector eqid k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

