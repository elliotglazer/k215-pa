import "source_l_replacement_reflected_image.mm0";

import "source_l_replacement_common_coverage.mm0";

import "source_renaming_extensional.mm0";

theorem sfLReplacementImageWitness_shift(T:set)(D psi:nat)
 (hd:$ sfBound 1 D $)(hf:$ sfWf psi $):
 $ sfShift 0 (sfLReplacementImageWitness T D psi) =
   sfLReplacementImageWitness (sfComposeMap sfSuccessorMap T) D psi $;

theorem sfLReplacementImageWitness_map{j:nat}(T U:set)(D psi:nat)
 (hf:$ sfWf psi $)(h:$ A. j T @ j = U @ j $):
 $ sfLReplacementImageWitness T D psi = sfLReplacementImageWitness U D psi $;

theorem sfLReplacementStartWitness_shift(start D psi:nat)
 (hd:$ sfBound 1 D $)(hf:$ sfWf psi $):
 $ sfShift 0 (sfLReplacementImageWitness (sfLReplacementStartMap start) D psi) =
   sfLReplacementImageWitness (sfLReplacementStartMap (suc start)) D psi $;

theorem sfLReplacementDoubleEx_eliminate(G A Q:nat)
 (ha:$ sfWf A $)(hq:$ sfWf Q $)
 (hp:$ nsLocal G (sfEx (sfEx A)) $)
 (hw:$ nsLocal (sfCLWitnessContext G A) (sfShift 0 (sfShift 0 Q)) $):
 $ nsLocal G Q $;
