@_ def pcdfOG17(a b r u v:nat):nat = $ (pcdfOF3 a b r u v) : 0 $;

@_ def pcdfOG18(a b r u v:nat):nat = $ (pcdfOF6 a b r u v) : (pcdfOG17 a b r u v) $;

