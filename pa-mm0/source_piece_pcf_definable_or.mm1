@_ def pcdfOF0(a b r u v:nat):nat = $ sfOr a b $;

@_ def pcdfOF1(a b r u v:nat):nat = $ sfImp r (pcdfOF0 a b r u v) $;

@_ def pcdfOF2(a b r u v:nat):nat = $ sfImp (pcdfOF0 a b r u v) r $;

