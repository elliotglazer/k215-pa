   k218IHypProvable kQuotientContext (sqQuote (sqNumericEnvironment (repeat 3 n)) 1 4 0 a) $;

theorem k218SQ_sqBootstrapConsequence_closed (n a: nat):
 $ sfBound 0 a -> k218SQ_sqBootstrapConsequence n a ->
   k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 a) $;

