import "k218q_closure_sequential.mm1";
import "k218q_matrix_rebase.mm1";

pub theorem k218QClosure_source_alignment {i j: nat} (E: set) (n B a b c f: nat)
 (hB: $ 0 < B $) (he: $ A. j (j < n -> E @ j < B) $)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218IEquivalent
     (k218ClosureSequential E n B a b c f)
     (k218NamedEmittedClosure E (suc (suc (k218ClosureSourceBase E B a b c f))) a c f) $ =
(named '(ax_mp k218IEquivalent_all (ax_mp k218IEquivalent_imp (ian k218IEquivalent_refl (ax_mp k218IEquivalent_exists (ax_mp k218IEquivalent_and (ian (k218QMatrix_pair_rebase hf (sqRebaseHygiene_below (lttr hB (lttr (lelttr leaddid1 k218ClosureChosen_range) (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr k218SQ_order1 k218SQ_order2) k218SQ_order3) k218SQ_order4) k218SQ_order5) k218SQ_order6) k218SQ_order7) k218SQ_order8) k218SQ_order9) k218SQ_order10) k218SQ_order11))) {(k218CRB_env_mono (lttr (lelttr leaddid1 k218ClosureChosen_range) (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr k218SQ_order1 k218SQ_order2) k218SQ_order3) k218SQ_order4) k218SQ_order5) k218SQ_order6) k218SQ_order7) k218SQ_order8) k218SQ_order9) k218SQ_order10) k218SQ_order11)) he) : $ A. i (i < n -> E @ i < (k218ClosureMatrixBase E B a b c f)) $}) (sqRebaseHygiene_below (lttr hB (lttr (lelttr leaddid1 k218ClosureChosen_range) (lttr (lttr (lttr (lttr (lttr (lttr (lttr k218SQ_order1 k218SQ_order2) k218SQ_order3) k218SQ_order4) k218SQ_order5) k218SQ_order6) k218SQ_order7) k218SQ_order8))) {(k218CRB_env_mono (lttr (lelttr leaddid1 k218ClosureChosen_range) (lttr (lttr (lttr (lttr (lttr (lttr (lttr k218SQ_order1 k218SQ_order2) k218SQ_order3) k218SQ_order4) k218SQ_order5) k218SQ_order6) k218SQ_order7) k218SQ_order8)) he) : $ A. i (i < n -> E @ i < (suc (suc (suc (suc (k218ClosureSourceBase E B a b c f)))))) $}) (sqAllocAvoid_below (lttr (lttr (lttr (lttr k218SQ_order7 k218SQ_order8) k218SQ_order9) k218SQ_order10) k218SQ_order11)) (sqAllocAvoid_below (lttr (lttr (lttr k218SQ_order8 k218SQ_order9) k218SQ_order10) k218SQ_order11)) (sqAllocAvoid_below (lttr k218SQ_order7 k218SQ_order8)) (sqAllocAvoid_below k218SQ_order8)) (ax_mp k218IEquivalent_all (ax_mp k218IEquivalent_imp (ian (ax_mp k218IEquivalent_all (ax_mp k218IEquivalent_imp (ian k218IEquivalent_refl k218IEquivalent_refl))) (ax_mp k218IEquivalent_all (ax_mp k218IEquivalent_imp (ian (k218QMatrix_pair_rebase hf (sqRebaseHygiene_below (lttr hB (lttr (lelttr leaddid1 k218ClosureChosen_range) (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr k218SQ_order1 k218SQ_order2) k218SQ_order3) k218SQ_order4) k218SQ_order5) k218SQ_order6) k218SQ_order7) k218SQ_order8) k218SQ_order9) k218SQ_order10) k218SQ_order11))) {(k218CRB_env_mono (lttr (lelttr leaddid1 k218ClosureChosen_range) (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr k218SQ_order1 k218SQ_order2) k218SQ_order3) k218SQ_order4) k218SQ_order5) k218SQ_order6) k218SQ_order7) k218SQ_order8) k218SQ_order9) k218SQ_order10) k218SQ_order11)) he) : $ A. i (i < n -> E @ i < (k218ClosureMatrixBase E B a b c f)) $}) (sqRebaseHygiene_below (lttr hB (lttr (lelttr leaddid1 k218ClosureChosen_range) (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr k218SQ_order1 k218SQ_order2) k218SQ_order3) k218SQ_order4) k218SQ_order5) k218SQ_order6) k218SQ_order7) k218SQ_order8) k218SQ_order9) k218SQ_order10))) {(k218CRB_env_mono (lttr (lelttr leaddid1 k218ClosureChosen_range) (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr k218SQ_order1 k218SQ_order2) k218SQ_order3) k218SQ_order4) k218SQ_order5) k218SQ_order6) k218SQ_order7) k218SQ_order8) k218SQ_order9) k218SQ_order10)) he) : $ A. i (i < n -> E @ i < (suc (suc (suc (suc (suc (suc (k218ClosureSourceBase E B a b c f)))))))) $}) (sqAllocAvoid_below (lttr k218SQ_order10 k218SQ_order11)) (sqAllocAvoid_below (lttr (lttr k218SQ_order9 k218SQ_order10) k218SQ_order11)) (sqAllocAvoid_below k218SQ_order10) (sqAllocAvoid_below (lttr k218SQ_order9 k218SQ_order10))) (ax_mp k218IEquivalent_exists (ax_mp k218IEquivalent_and (ian (k218QMatrix_pair_rebase hf (sqRebaseHygiene_below (lttr hB (lttr (lelttr leaddid1 k218ClosureChosen_range) (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr k218SQ_order1 k218SQ_order2) k218SQ_order3) k218SQ_order4) k218SQ_order5) k218SQ_order6) k218SQ_order7) k218SQ_order8) k218SQ_order9) k218SQ_order10) k218SQ_order11))) {(k218CRB_env_mono (lttr (lelttr leaddid1 k218ClosureChosen_range) (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr k218SQ_order1 k218SQ_order2) k218SQ_order3) k218SQ_order4) k218SQ_order5) k218SQ_order6) k218SQ_order7) k218SQ_order8) k218SQ_order9) k218SQ_order10) k218SQ_order11)) he) : $ A. i (i < n -> E @ i < (k218ClosureMatrixBase E B a b c f)) $}) (sqRebaseHygiene_below (lttr hB (lttr (lelttr leaddid1 k218ClosureChosen_range) (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr k218SQ_order1 k218SQ_order2) k218SQ_order3) k218SQ_order4) k218SQ_order5) k218SQ_order6) k218SQ_order7) k218SQ_order8) k218SQ_order9) k218SQ_order10) ltsucid))) {(k218CRB_env_mono (lttr (lelttr leaddid1 k218ClosureChosen_range) (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr (lttr k218SQ_order1 k218SQ_order2) k218SQ_order3) k218SQ_order4) k218SQ_order5) k218SQ_order6) k218SQ_order7) k218SQ_order8) k218SQ_order9) k218SQ_order10) ltsucid)) he) : $ A. i (i < n -> E @ i < (suc (suc (suc (suc (suc (suc (suc (k218ClosureSourceBase E B a b c f))))))))) $}) (sqAllocAvoid_below k218SQ_order11) (sqAllocAvoid_below (lttr (lttr k218SQ_order9 k218SQ_order10) k218SQ_order11)) (sqAllocAvoid_below ltsucid) (sqAllocAvoid_below (lttr (lttr k218SQ_order9 k218SQ_order10) ltsucid))) k218IEquivalent_refl))))))))))))))));

pub theorem k218QClosure_source {i j: nat} (E: set) (n B a b c f: nat)
 (ha0: $ 0 < a $) (hab: $ a < b $) (hbc: $ b < c $)
 (haB: $ a < B $) (hbB: $ b < B $)
 (heA: $ sqEnvAvoid E n a $) (heB: $ sqEnvAvoid E n b $)
 (he: $ A. j (j < n -> E @ j < B) $)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218IEquivalent
     (k218Closure a b c (sfNamedTemplate (sqEnvCons b (sqEnvCons a E)) B 0 f))
     (k218NamedEmittedClosure E (suc (suc (k218ClosureSourceBase E B a b c f))) a c f) $ =
(named '(ax_mp k218IEquivalent_trans (ian (ax_mp k218IEquivalent_trans (ian (ax_mp k218IEquivalent_trans (ian (k218QClosure_separate ha0 hab hbc haB hbB heA heB hf) (!! k218QClosure_chosen_rebase i j (lttr ha0 haB) he hf))) (!! k218QClosure_sequential j he hf))) (!! k218QClosure_source_alignment i j (lttr ha0 haB) he hf))));
