import "source_k0_qsep_carrier.mm0";

def qscSafeEnvironment (P: wff) (E: set) (.i: nat): set = $ {i | ifp P (i e. E) (i e. sqZeroEnvironment)} $;

def qscResult (E: set) (k phi: nat): nat = $ kImp kEmptyMarker (sqQuote E 1 k 0 (sfSeparation (sfRename sfSepMap 0 phi))) $;

theorem sfK0QSepCarrier_image_d (G: wff) (E: set) (n k phi: nat)
 (hf: $ G -> sfBound (suc n) phi $) (hk: $ G -> 2 < k $)
 (he: $ G -> sqEnvBelow E n k $):
 $ G -> k218QProvable (kImp kEmptyMarker (sqQuote E 1 k 0 (sfSeparation (sfRename sfSepMap 0 phi)))) $;

theorem sfK0QSepCarrier_image_curried (E: set) (n k phi: nat):
 $ sfBound (suc n) phi -> 2 < k -> sqEnvBelow E n k -> k218QProvable (kImp kEmptyMarker (sqQuote E 1 k 0 (sfSeparation (sfRename sfSepMap 0 phi)))) $;
