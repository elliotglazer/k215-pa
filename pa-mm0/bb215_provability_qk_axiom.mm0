theorem bb215ProvabilityQKAxRho8_sound (r: nat): $ bb215ProvabilityQKAxRho8 r -> r e. k215Axioms $;

theorem bb215ProvabilityQKAxRho8_complete (r a b c u: nat): $ (u <= a /\ r = kRho8 a b c u) -> bb215ProvabilityQKAxRho8 r $;

theorem bb215ProvabilityQKAxBundle_sound (r: nat): $ bb215ProvabilityQKAxBundle r -> r e. k215Axioms $;

theorem bb215ProvabilityQKAxBundle_complete (r a b c: nat): $ (c != a /\ c != b /\ r = k218Bundle a b c) -> bb215ProvabilityQKAxBundle r $;

theorem bb215ProvabilityQKAxiom_sound (r: nat): $ bb215ProvabilityQKAxiom r -> r e. k215Axioms $;

theorem bb215ProvabilityQKAxiom_complete (r: nat): $ r e. k215Axioms -> bb215ProvabilityQKAxiom r $;

theorem bb215ProvabilityQKAxiom_iff (r: nat): $ bb215ProvabilityQKAxiom r <-> r e. k215Axioms $;

theorem bb215ProvabilityQKAxiom_zero: $ bb215ProvabilityQKAxiom 0 $;
