import "bb215_provability_qk_kcode.mm0";

theorem bb215ProvabilityQKAxRho1_sound (r: nat): $ bb215ProvabilityQKAxRho1 r -> r e. k215Axioms $;

theorem bb215ProvabilityQKAxRho1_complete (r a b: nat): $ (r = kRho1 a b) -> bb215ProvabilityQKAxRho1 r $;

