pub theorem sfLSeparationOp5Extension_context: $ slOp5ExtContext = sfLBackground $ = 'eqid;
pub theorem sfLSeparationOp5Extension_exact: $ slOp5ExtFormula = sfAll (sfLSeparationOp5Extensions 0) $ = 'eqid;
pub theorem sfLSeparationOp5Extension_local: $ nsLocal sfLBackground (sfAll (sfLSeparationOp5Extensions 0)) $ =
 '(sfRQ_rewrite sfLSeparationOp5Extension_exact (mpbi (nsLocal_context_eq sfLSeparationOp5Extension_context) slOp5ExtCertificate));
pub theorem sfLSeparationOp5Extension_zfr: $ sfTheoryProvable zfrAxioms (sfAll (sfLSeparationOp5Extensions 0)) $ =
 '(ax_mp (sfTheory_local sfLBackground_zfr) sfLSeparationOp5Extension_local);
