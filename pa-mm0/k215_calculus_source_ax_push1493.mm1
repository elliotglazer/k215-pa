theorem k215PairVectorInAt1493 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt1499State k215PNum1499 a6 a1 a7 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum1499 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215PairVectorOutAt1493 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt1499State k215PNum1509 0 0 (a7 + (a6, a1)) (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum1509 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

pub theorem k215PairMacro46_vectorAt1493 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat):
 $ k215PReach (k215PState k215PNum1499 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215PNum1509 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ =
 '(mpbi (k215PReacheq k215PairVectorInAt1493 k215PairVectorOutAt1493) k215PairMacro1499);

theorem k215PushAStage0At1493 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum1493 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum1496 (k215PVector u 0 w c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop1493Vector (k215PStateeq2 (k215PVectoreq7 add0))));

theorem k215PushAStage1At1493 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum1496 (k215PVector u 0 w c a b t 0 v)) (k215PState k215PNum1499 (k215PVector u w 0 c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop1496Vector (k215PStateeq2 (k215PVectoreq2 add0))));

theorem k215PushAStage2At1493 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum1499 (k215PVector u w 0 c a b t 0 v)) (k215PState k215PNum1509 (k215PVector u 0 0 c a b 0 (t, w) v)) $ = '(mpbi (k215PReacheq2 (k215PStateeq2 (k215PVectoreq8 add01))) k215PairMacro46_vectorAt1493);

theorem k215PushAStage3At1493 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum1509 (k215PVector u 0 0 c a b 0 (t, w) v)) (k215PState k215PNum1512 (k215PVector u 0 (t, w) c a b 0 0 v)) $ = '(k215PReach_intro (eqtr k215Loop1509Vector (k215PStateeq2 (k215PVectoreq3 add0))));

theorem k215PushAStage4At1493 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum1512 (k215PVector u 0 (t, w) c a b 0 0 v)) (k215PState k215PNum1516 (k215PVector u b (t, w) c a 0 b 0 v)) $ = '(k215PReach_intro (eqtr k215Loop1512Vector (k215PStateeq2 (k215PVectoreq eqid add0 eqid eqid eqid eqid add0 eqid eqid))));

theorem k215PushAStage5At1493 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum1516 (k215PVector u b (t, w) c a 0 b 0 v)) (k215PState k215PNum1519 (k215PVector u b (t, w) c a b 0 0 v)) $ = '(k215PReach_intro (eqtr k215Loop1516Vector (k215PStateeq2 (k215PVectoreq6 add0))));

pub theorem k215PushParam1493 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum1493 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum1519 (k215PVector u b (t, w) c a b 0 0 v)) $ = '(ax_mp (ax_mp k215PReach_trans k215PushAStage0At1493) (ax_mp (ax_mp k215PReach_trans k215PushAStage1At1493) (ax_mp (ax_mp k215PReach_trans k215PushAStage2At1493) (ax_mp (ax_mp k215PReach_trans k215PushAStage3At1493) (ax_mp (ax_mp k215PReach_trans k215PushAStage4At1493) k215PushAStage5At1493)))));

