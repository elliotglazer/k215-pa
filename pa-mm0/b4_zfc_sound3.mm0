import "b4_zfc_sound2.mm0";

theorem bdFull_prop (a l: nat): $ (a, l) e. sfNDPropRules -> (a, l) e. sfNDFullRules $;
theorem bdFull_quant (a l: nat): $ (a, l) e. sfNDQuantRules -> (a, l) e. sfNDFullRules $;
theorem bdFinBase (r l R: nat): $ r = R -> sfNDPropBase R -> (r, l) e. sfNDFullRules $;
theorem bdFinU (r p l R P: nat): $ r = R -> p = P -> p IN l -> sfNDPropUnary R P -> (r, l) e. sfNDFullRules $;
theorem bdFinQU (r p l R P: nat): $ r = R -> p = P -> p IN l -> sfNDQuantUnary R P -> (r, l) e. sfNDFullRules $;
theorem bdFinB (r p q l R P Q: nat): $ r = R -> p = P -> q = Q -> p IN l -> q IN l -> sfNDPropBinary R P Q -> (r, l) e. sfNDFullRules $;
theorem bdFinQB (r p q l R P Q: nat): $ r = R -> p = P -> q = Q -> p IN l -> q IN l -> sfNDQuantBinary R P Q -> (r, l) e. sfNDFullRules $;
theorem bdBPh (a g c p: nat) {h: nat}: $ E. h (h <= p /\ bdCons a g h /\ bdSeq h c p) -> p = sfSequent (a : g) c $;
theorem bdExEh (m v i a g h: nat) {s: nat}: $ bdHasOK m v i -> E. s (s <= h /\ bdCons a s h /\ bdHas m v i bdtCShift g s 0 0) -> h = a : sfContextShift g $;
theorem bdNDc_Ctx (m v i r l: nat) {g a: nat}: $ bdHasOK m v i /\ sfRowWf r -> E. g (g <= r /\ (E. a (a <= r /\ bdSeq g a r /\ bdHas m v i bdtIn a g 0 0))) -> (r, l) e. sfNDFullRules $;
theorem bdNDc_Pc (m v i r l: nat) {g z y a x b: nat}: $ bdHasOK m v i /\ sfRowWf r -> E. g (g <= r /\ (E. z (z <= r /\ bdSeq g z r /\ (E. y (y <= z /\ (E. a (a <= z /\ bdNode 5 y a z /\ (E. x (x <= y /\ bdNode 5 x a y /\ (E. b (b <= x /\ bdNode 5 a b x))))))))))) -> (r, l) e. sfNDFullRules $;
theorem bdNDBase_sound (m v i r l: nat): $ bdHasOK m v i /\ sfRowWf r -> bdNDBase m v i r -> (r, l) e. sfNDFullRules $;
theorem bdNDc_II (m v i r p l: nat) {g y a b h: nat}: $ bdHasOK m v i /\ sfRowWf r /\ p IN l -> E. g (g <= r /\ (E. y (y <= r /\ bdSeq g y r /\ (E. a (a <= y /\ (E. b (b <= y /\ bdNode 5 a b y /\ (E. h (h <= p /\ bdCons a g h /\ bdSeq h b p))))))))) -> (r, l) e. sfNDFullRules $;
theorem bdNDc_Exp (m v i r p l: nat) {g a: nat}: $ bdHasOK m v i /\ sfRowWf r /\ p IN l -> E. g (g <= r /\ (E. a (a <= r /\ bdSeq g a r /\ bdSeq g 0 p))) -> (r, l) e. sfNDFullRules $;
theorem bdNDc_CE1 (m v i r p l: nat) {g a x b: nat}: $ bdHasOK m v i /\ sfRowWf r /\ p IN l -> E. g (g <= r /\ (E. a (a <= r /\ bdSeq g a r /\ (E. x (x <= p /\ bdSeq g x p /\ (E. b (b <= x /\ bdNode 3 a b x))))))) -> (r, l) e. sfNDFullRules $;
theorem bdNDc_CE2 (m v i r p l: nat) {g b x a: nat}: $ bdHasOK m v i /\ sfRowWf r /\ p IN l -> E. g (g <= r /\ (E. b (b <= r /\ bdSeq g b r /\ (E. x (x <= p /\ bdSeq g x p /\ (E. a (a <= x /\ bdNode 3 a b x))))))) -> (r, l) e. sfNDFullRules $;
theorem bdNDc_DI1 (m v i r p l: nat) {g x a b: nat}: $ bdHasOK m v i /\ sfRowWf r /\ p IN l -> E. g (g <= r /\ (E. x (x <= r /\ bdSeq g x r /\ (E. a (a <= x /\ (E. b (b <= x /\ bdNode 4 a b x /\ bdSeq g a p))))))) -> (r, l) e. sfNDFullRules $;
theorem bdNDc_DI2 (m v i r p l: nat) {g x a b: nat}: $ bdHasOK m v i /\ sfRowWf r /\ p IN l -> E. g (g <= r /\ (E. x (x <= r /\ bdSeq g x r /\ (E. a (a <= x /\ (E. b (b <= x /\ bdNode 4 a b x /\ bdSeq g b p))))))) -> (r, l) e. sfNDFullRules $;
theorem bdNDc_Wk (m v i r p l: nat) {h a g: nat}: $ bdHasOK m v i /\ sfRowWf r /\ p IN l -> E. h (h <= r /\ (E. a (a <= r /\ bdSeq h a r /\ (E. g (g <= p /\ bdSeq g a p /\ bdHas m v i bdtSub g h 0 0))))) -> (r, l) e. sfNDFullRules $;
theorem bdNDProp1_sound (m v i r p l: nat): $ bdHasOK m v i /\ sfRowWf r /\ p IN l -> bdNDProp1 m v i r p -> (r, l) e. sfNDFullRules $;
theorem bdNDc_AllI (m v B i r p l: nat) {g x a h: nat}: $ bdHasOK m v i /\ sfRowWf r /\ p IN l -> E. g (g <= r /\ (E. x (x <= r /\ bdSeq g x r /\ (E. a (a <= x /\ bdNode 6 a 0 x /\ (E. h (h <= p /\ bdSeq h a p /\ bdHas m v i bdtCShift g h 0 0))))))) -> (r, l) e. sfNDFullRules $;
theorem bdNDc_AllE (m v B i r p l: nat) {g y x a t: nat}: $ bdHasOK m v i /\ sfRowWf r /\ p IN l -> E. g (g <= r /\ (E. y (y <= r /\ bdSeq g y r /\ (E. x (x <= p /\ bdSeq g x p /\ (E. a (a <= x /\ bdNode 6 a 0 x /\ (E. t (t <= B /\ bdHas m v i bdtSubst 0 t a y))))))))) -> (r, l) e. sfNDFullRules $;
theorem bdNDc_ExI (m v B i r p l: nat) {g x a y t: nat}: $ bdHasOK m v i /\ sfRowWf r /\ p IN l -> E. g (g <= r /\ (E. x (x <= r /\ bdSeq g x r /\ (E. a (a <= x /\ bdNode 7 a 0 x /\ (E. y (y <= p /\ bdSeq g y p /\ (E. t (t <= B /\ bdHas m v i bdtSubst 0 t a y))))))))) -> (r, l) e. sfNDFullRules $;
theorem bdNDQuant1_sound (m v B i r p l: nat): $ bdHasOK m v i /\ sfRowWf r /\ p IN l -> bdNDQuant1 m v B i r p -> (r, l) e. sfNDFullRules $;
theorem bdNDc_IE (m v i r p q l: nat) {g b a x: nat}: $ bdHasOK m v i /\ sfRowWf r /\ p IN l /\ q IN l -> E. g (g <= r /\ (E. b (b <= r /\ bdSeq g b r /\ (E. a (a <= q /\ bdSeq g a q /\ (E. x (x <= p /\ bdSeq g x p /\ bdNode 5 a b x))))))) -> (r, l) e. sfNDFullRules $;
theorem bdNDc_CI (m v i r p q l: nat) {g x a b: nat}: $ bdHasOK m v i /\ sfRowWf r /\ p IN l /\ q IN l -> E. g (g <= r /\ (E. x (x <= r /\ bdSeq g x r /\ (E. a (a <= x /\ (E. b (b <= x /\ bdNode 3 a b x /\ bdSeq g a p /\ bdSeq g b q))))))) -> (r, l) e. sfNDFullRules $;
theorem bdNDc_BranchPair (m v i r p q l: nat) {g a b c h: nat}: $ bdHasOK m v i /\ sfRowWf r /\ p IN l /\ q IN l -> E. g (g <= r /\ (E. a (a <= r /\ (E. b (b <= r /\ (E. c (c <= r /\ bdBr g a b c r /\ (E. h (h <= p /\ bdCons a g h /\ bdSeq h c p)) /\ (E. h (h <= q /\ bdCons b g h /\ bdSeq h c q))))))))) -> (r, l) e. sfNDFullRules $;
theorem bdNDc_DE (m v i r p q l: nat) {g c x a b: nat}: $ bdHasOK m v i /\ sfRowWf r /\ p IN l /\ q IN l -> E. g (g <= r /\ (E. c (c <= r /\ bdSeq g c r /\ (E. x (x <= p /\ bdSeq g x p /\ (E. a (a <= x /\ (E. b (b <= x /\ bdNode 4 a b x /\ bdBr g a b c q))))))))) -> (r, l) e. sfNDFullRules $;
theorem bdNDc_ExE (m v i r p q l: nat) {g c x a h y s: nat}: $ bdHasOK m v i /\ sfRowWf r /\ p IN l /\ q IN l -> E. g (g <= r /\ (E. c (c <= r /\ bdSeq g c r /\ (E. x (x <= p /\ bdSeq g x p /\ (E. a (a <= x /\ bdNode 7 a 0 x /\ (E. h (h <= q /\ (E. y (y <= q /\ bdSeq h y q /\ (E. s (s <= h /\ bdCons a s h /\ bdHas m v i bdtCShift g s 0 0)) /\ bdHas m v i bdtShift 0 c y 0))))))))))) -> (r, l) e. sfNDFullRules $;
theorem bdND2_sound (m v i r p q l: nat): $ bdHasOK m v i /\ sfRowWf r /\ p IN l /\ q IN l -> bdND2 m v i r p q -> (r, l) e. sfNDFullRules $;
theorem bdValidU (m v B i r l: nat) {x: nat}: $ bdHasOK m v i /\ sfRowWf r -> E. x (x <= l /\ bdHas m v i bdtIn x l 0 0 /\ (bdNDProp1 m v i r x \/ bdNDQuant1 m v B i r x)) -> (r, l) e. sfNDFullRules $;
theorem bdValidB (m v i r l: nat) {x y: nat}: $ bdHasOK m v i /\ sfRowWf r -> E. x (x <= l /\ (E. y (y <= l /\ bdHas m v i bdtIn x l 0 0 /\ bdHas m v i bdtIn y l 0 0 /\ bdND2 m v i r x y))) -> (r, l) e. sfNDFullRules $;
theorem bdRValid_sound (m v B i p: nat): $ bdHasOK m v i -> bdRValid m v B i p -> traceValid sfNDFullRules p $;
theorem bdRAx_sound (m v B i z: nat): $ bdHasOK m v i -> bdRAx m v B i z -> z e. zfcAxioms $;
