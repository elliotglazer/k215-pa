pub theorem k215PPC_state (pc regs: nat): $ k215PPC (k215PState pc regs) = pc $ = 'fstpr;
pub theorem k215PRegs_state (pc regs: nat): $ k215PRegs (k215PState pc regs) = regs $ = 'sndpr;


pub theorem k215PEPath_entry (path tag arg zero positive: nat): $ k215PEPath (k215PEntry path tag arg zero positive) = path $ = '(eqtr (fsteq eqid) fstpr);

pub theorem k215PETag_entry (path tag arg zero positive: nat): $ k215PETag (k215PEntry path tag arg zero positive) = tag $ = '(eqtr (fsteq (eqtr (sndeq eqid) sndpr)) fstpr);

pub theorem k215PEArg_entry (path tag arg zero positive: nat): $ k215PEArg (k215PEntry path tag arg zero positive) = arg $ = '(eqtr (fsteq (eqtr (sndeq (eqtr (sndeq eqid) sndpr)) sndpr)) fstpr);

pub theorem k215PEZero_entry (path tag arg zero positive: nat): $ k215PEZero (k215PEntry path tag arg zero positive) = zero $ = '(eqtr (fsteq (eqtr (sndeq (eqtr (sndeq (eqtr (sndeq eqid) sndpr)) sndpr)) sndpr)) fstpr);

pub theorem k215PEPositive_entry (path tag arg zero positive: nat): $ k215PEPositive (k215PEntry path tag arg zero positive) = positive $ = '(eqtr (sndeq (eqtr (sndeq (eqtr (sndeq (eqtr (sndeq eqid) sndpr)) sndpr)) sndpr)) sndpr);

pub theorem k215PStep_state (pc regs: nat):
 $ k215PStep (k215PState pc regs) =
   if (k215PETag (k215PLookup pc) = 4) (k215PState pc regs)
     (k215PStepEntry (k215PLookup pc) regs) $ =
 '(ifeq (eqeq1 (k215PETageq (k215PLookupeq k215PPC_state))) eqid
        (k215PStepEntryeq (k215PLookupeq k215PPC_state) k215PRegs_state));
pub theorem k215PStep_lookup (pc regs e: nat) (h: $ k215PLookup pc = e $):
 $ k215PStep (k215PState pc regs) =
   if (k215PETag e = 4) (k215PState pc regs) (k215PStepEntry e regs) $ =
 '(eqtr k215PStep_state (ifeq (eqeq1 (k215PETageq h)) eqid (k215PStepEntryeq1 h)));


pub theorem k215PStepEntry_fields (path tag arg zero positive regs: nat):
 $ k215PStepEntry (k215PEntry path tag arg zero positive) regs =
   if (tag = 0) (k215PState positive (k215PSet arg (suc (k215PGet arg regs)) regs))
   (if (tag = 1)
      (if (k215PGet arg regs = 0) (k215PState zero regs)
        (k215PState positive (k215PSet arg (k215PGet arg regs - 1) regs)))
      (k215PState zero regs)) $ = '(ifeq (eqeq1 k215PETag_entry) (k215PStateeq k215PEPositive_entry (k215PSeteq k215PEArg_entry (suceq (k215PGeteq1 k215PEArg_entry)) eqid)) (ifeq (eqeq1 k215PETag_entry) (ifeq (eqeq1 (k215PGeteq1 k215PEArg_entry)) (k215PStateeq k215PEZero_entry eqid) (k215PStateeq k215PEPositive_entry (k215PSeteq k215PEArg_entry (subeq1 (k215PGeteq1 k215PEArg_entry)) eqid))) (k215PStateeq k215PEZero_entry eqid)));

pub theorem k215PAtCI (pc path arg zero positive regs: nat)
 (h: $ k215PLookup pc = k215PEntry path 0 arg zero positive $):
 $ k215PStep (k215PState pc regs) = (k215PState positive (k215PSet arg (suc (k215PGet arg regs)) regs)) $ = '(eqtr (k215PStep_lookup h) (eqtr (ifneg (mpbir (noteq (eqeq1 k215PETag_entry)) (ltne k215EqLess4_0))) (eqtr k215PStepEntry_fields (ifpos eqid))));

pub theorem k215PAtCD (pc path arg zero positive regs: nat)
 (h: $ k215PLookup pc = k215PEntry path 1 arg zero positive $):
 $ k215PStep (k215PState pc regs) = (if (k215PGet arg regs = 0) (k215PState zero regs) (k215PState positive (k215PSet arg (k215PGet arg regs - 1) regs))) $ = '(eqtr (k215PStep_lookup h) (eqtr (ifneg (mpbir (noteq (eqeq1 k215PETag_entry)) (ltne k215EqLess4_1))) (eqtr k215PStepEntry_fields (eqtr (ifneg (ltner k215EqLess1_0)) (ifpos eqid)))));

pub theorem k215PAtCB (pc path arg zero positive regs: nat)
 (h: $ k215PLookup pc = k215PEntry path 2 arg zero positive $):
 $ k215PStep (k215PState pc regs) = (k215PState zero regs) $ = '(eqtr (k215PStep_lookup h) (eqtr (ifneg (mpbir (noteq (eqeq1 k215PETag_entry)) (ltne k215EqLess4_2))) (eqtr k215PStepEntry_fields (eqtr (ifneg (ltner k215EqLess2_0)) (ifneg (ltner k215EqLess2_1))))));

pub theorem k215PAtCC (pc path arg zero positive regs: nat)
 (h: $ k215PLookup pc = k215PEntry path 3 arg zero positive $):
 $ k215PStep (k215PState pc regs) = (k215PState zero regs) $ = '(eqtr (k215PStep_lookup h) (eqtr (ifneg (mpbir (noteq (eqeq1 k215PETag_entry)) (ltne k215EqLess4_3))) (eqtr k215PStepEntry_fields (eqtr (ifneg (ltner k215EqLess3_0)) (ifneg (ltner k215EqLess3_1))))));

