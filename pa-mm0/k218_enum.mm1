-- Distinct SeedG abstract search. Explicit replay, independently checked; no literal-TM correspondence is assumed.
import "k218_stack.mm1";

do (apply (register-eqd 'k218Gate) '(k218Gateeqd));
do (apply (register-eqd 'k218AxStack) '(k218AxStackeqd));
do (apply (register-eqd 'k218Provable) '(k218Provable_congr));
do (apply (register-eqd 'k218GoodStack) '(k218GoodStackeqd));

-- Six-register abstract SeedG enumerator; concrete program correspondence is separate.
-- The Cantor tuple is a bijection: there are no malformed numeric states.
@_ def k218EnumState (pl np tw ws d h: nat): nat = $ (pl, np, tw, ws, d, h) $;
@_ def k218EnumPL (s: nat): nat = $ fst s $;
@_ def k218EnumNP (s: nat): nat = $ fst (snd s) $;
@_ def k218EnumTW (s: nat): nat = $ fst (snd (snd s)) $;
@_ def k218EnumWS (s: nat): nat = $ fst (snd (snd (snd s))) $;
@_ def k218EnumD (s: nat): nat = $ fst (snd (snd (snd (snd s)))) $;
@_ def k218EnumH (s: nat): nat = $ snd (snd (snd (snd (snd s)))) $;
@_ def k218EnumInitial: nat = $ k218EnumState 0 0 0 0 0 0 $;

-- Reload uses np itself for a first command; continuation uses pl - 1.
@_ def k218EnumList (s: nat): nat = $ if (k218EnumPL s = 0) (k218EnumNP s) (k218EnumPL s - 1) $;
@_ def k218EnumNext (s: nat): nat = $ if (k218EnumPL s = 0) (suc (k218EnumNP s)) (k218EnumNP s) $;
@_ def k218EnumSelector (s: nat): nat = $ fst (k218EnumList s) $;
@_ def k218EnumTail (s: nat): nat = $ snd (snd (k218EnumList s)) $;
@_ def k218EnumDelta (s: nat): nat = $ k218EnumD s + fst (snd (k218EnumList s)) $;
@_ def k218EnumAXState (s c tail next delta: nat): nat =
$ k218EnumState (snd (snd tail)) next
    (k218Gate delta (k218EnumH s + fst tail) c)
    (k218AxStack delta (k218EnumH s) (k218EnumH s + fst tail) c
      (fst (snd tail)) (k218EnumTW s) (k218EnumWS s)) 0 0 $;

-- Option encoding is 0 = None and suc state = Some state.
@_ def k218EnumCommand (s ac tail next delta: nat): nat =
$ if (ac = 0)
    (if (kImp (k218EnumTW s) delta = k218EnumH s)
      (suc (k218EnumState tail next delta (0, k218EnumWS s) delta 0))
      (suc (k218EnumState tail next 0 (k218EnumWS s) delta 0)))
  (if (ac = 1)
    (suc (k218EnumState tail next (k218EnumH s) (k218EnumTW s, k218EnumWS s) delta (k218EnumH s)))
  (if (ac = 2)
    (if (k218EnumH s = 1) 0
      (suc (k218EnumState tail next (k218EnumTW s) (snd (k218EnumWS s)) delta (fst (k218EnumWS s)))))
    (suc (k218EnumAXState s (ac - 3) tail next delta)))) $;
@_ def k218EnumStep (s: nat): nat =
$ k218EnumCommand s (k218EnumSelector s) (k218EnumTail s) (k218EnumNext s) (k218EnumDelta s) $;

pub theorem k218EnumState_PL (pl np tw ws d h: nat):
  $ k218EnumPL (k218EnumState pl np tw ws d h) = pl $ =
'fstpr;

pub theorem k218EnumState_NP (pl np tw ws d h: nat):
  $ k218EnumNP (k218EnumState pl np tw ws d h) = np $ =
'(eqtr (fsteq sndpr) fstpr);

pub theorem k218EnumState_TW (pl np tw ws d h: nat):
  $ k218EnumTW (k218EnumState pl np tw ws d h) = tw $ =
'(eqtr (fsteq (eqtr (sndeq sndpr) sndpr)) fstpr);

pub theorem k218EnumState_WS (pl np tw ws d h: nat):
  $ k218EnumWS (k218EnumState pl np tw ws d h) = ws $ =
'(eqtr (fsteq (eqtr (sndeq (eqtr (sndeq sndpr) sndpr)) sndpr)) fstpr);

pub theorem k218EnumState_D (pl np tw ws d h: nat):
  $ k218EnumD (k218EnumState pl np tw ws d h) = d $ =
'(eqtr (fsteq (eqtr (sndeq (eqtr (sndeq (eqtr (sndeq sndpr) sndpr)) sndpr)) sndpr)) fstpr);

pub theorem k218EnumState_H (pl np tw ws d h: nat):
  $ k218EnumH (k218EnumState pl np tw ws d h) = h $ =
'(eqtr (sndeq (eqtr (sndeq (eqtr (sndeq (eqtr (sndeq sndpr) sndpr)) sndpr)) sndpr)) sndpr);

pub theorem k218EnumState_rebuild (s: nat):
 $ k218EnumState (k218EnumPL s) (k218EnumNP s) (k218EnumTW s) (k218EnumWS s) (k218EnumD s) (k218EnumH s) = s $ =
'(eqtr (preq2 (eqtr (preq2 (eqtr (preq2 (eqtr (preq2 fstsnd) fstsnd)) fstsnd)) fstsnd)) fstsnd);

pub theorem k218EnumInitial_zero: $ k218EnumInitial = 0 $ =
'(eqtr (preq2 (eqtr (preq2 (eqtr (preq2 (eqtr (preq2 pr0) pr0)) pr0)) pr0)) pr0);

pub theorem k218EnumList_reload (s: nat): $ k218EnumPL s = 0 -> k218EnumList s = k218EnumNP s $ = 'ifpos;

pub theorem k218EnumList_continue (s: nat): $ k218EnumPL s != 0 -> k218EnumList s = k218EnumPL s - 1 $ = 'ifneg;

pub theorem k218EnumNext_reload (s: nat): $ k218EnumPL s = 0 -> k218EnumNext s = suc (k218EnumNP s) $ = 'ifpos;

pub theorem k218EnumNext_continue (s: nat): $ k218EnumPL s != 0 -> k218EnumNext s = k218EnumNP s $ = 'ifneg;

pub theorem k218EnumCommand_mp_hit (s tail next delta: nat):
 $ kImp (k218EnumTW s) delta = k218EnumH s -> k218EnumCommand s 0 tail next delta = suc (k218EnumState tail next delta (0, k218EnumWS s) delta 0) $ =
'(eqtrd (a1i (ifpos eqid)) ifpos);

pub theorem k218EnumCommand_mp_miss (s tail next delta: nat):
 $ kImp (k218EnumTW s) delta != k218EnumH s -> k218EnumCommand s 0 tail next delta = suc (k218EnumState tail next 0 (k218EnumWS s) delta 0) $ =
'(eqtrd (a1i (ifpos eqid)) ifneg);

pub theorem k218EnumCommand_drop (s tail next delta: nat):
 $ k218EnumCommand s 1 tail next delta = suc (k218EnumState tail next (k218EnumH s) (k218EnumTW s, k218EnumWS s) delta (k218EnumH s)) $ =
'(eqtr (ifneg d1ne0) (ifpos eqid));

pub theorem k218EnumCommand_nip_halt (s tail next delta: nat):
 $ k218EnumH s = 1 -> k218EnumCommand s 2 tail next delta = 0 $ =
'(eqtrd (a1i (ifneg d2ne0)) (eqtrd (a1i (ifneg (ltneri (mpbi ltsuc lt01S)))) (eqtrd (a1i (ifpos eqid)) ifpos)));

pub theorem k218EnumCommand_nip_pop (s tail next delta: nat):
 $ k218EnumH s != 1 -> k218EnumCommand s 2 tail next delta = suc (k218EnumState tail next (k218EnumTW s) (snd (k218EnumWS s)) delta (fst (k218EnumWS s))) $ =
'(eqtrd (a1i (ifneg d2ne0)) (eqtrd (a1i (ifneg (ltneri (mpbi ltsuc lt01S)))) (eqtrd (a1i (ifpos eqid)) ifneg)));

theorem k218Enum_suc3_ne1 (c: nat): $ suc (suc (suc c)) != 1 $ =
'(mpbir (noteq peano2) peano1);
theorem k218Enum_suc3_ne2 (c: nat): $ suc (suc (suc c)) != 2 $ =
'(mpbir (noteq peano2) (mpbir (noteq peano2) peano1));
theorem k218Enum_suc3_sub3 (c: nat): $ suc (suc (suc c)) - 3 = c $ =
'(eqtr subSS (eqtr subSS (eqtr subSS sub02)));
pub theorem k218EnumCommand_ax (s c tail next delta: nat):
 $ k218EnumCommand s (suc (suc (suc c))) tail next delta =
   suc (k218EnumAXState s c tail next delta) $ =
'(eqtr (ifneg peano1) (eqtr (ifneg k218Enum_suc3_ne1) (eqtr (ifneg k218Enum_suc3_ne2)
  (suceq (k218EnumAXStateeq2 k218Enum_suc3_sub3)))));

@_ def k218EnumStateGood (s: nat): wff =
$ k218Provable (k218EnumTW s) /\ k218Provable (k218EnumH s) /\ k218GoodStack (k218EnumWS s) $;
@_ def k218EnumOptionGood (r: nat): wff =
$ ifp (r = 0) (k218Provable 1) (k218EnumStateGood (r - 1)) $;

pub theorem k218EnumStep_mp_hit (s: nat):
 $ k218EnumSelector s = 0 -> kImp (k218EnumTW s) (k218EnumDelta s) = k218EnumH s -> k218EnumStep s = suc (k218EnumState (k218EnumTail s) (k218EnumNext s) (k218EnumDelta s) (0, k218EnumWS s) (k218EnumDelta s) 0) $ =
'(exp @ eqtrd (k218EnumCommandeq2d anl) (anwr k218EnumCommand_mp_hit));

pub theorem k218EnumStep_mp_miss (s: nat):
 $ k218EnumSelector s = 0 -> kImp (k218EnumTW s) (k218EnumDelta s) != k218EnumH s -> k218EnumStep s = suc (k218EnumState (k218EnumTail s) (k218EnumNext s) 0 (k218EnumWS s) (k218EnumDelta s) 0) $ =
'(exp @ eqtrd (k218EnumCommandeq2d anl) (anwr k218EnumCommand_mp_miss));

pub theorem k218EnumStep_drop (s: nat):
 $ k218EnumSelector s = 1 -> k218EnumStep s = suc (k218EnumState (k218EnumTail s) (k218EnumNext s) (k218EnumH s) (k218EnumTW s, k218EnumWS s) (k218EnumDelta s) (k218EnumH s)) $ =
'(eqtrd (k218EnumCommandeq2d id) (a1i k218EnumCommand_drop));

pub theorem k218EnumStep_nip_halt (s: nat):
 $ k218EnumSelector s = 2 -> k218EnumH s = 1 -> k218EnumStep s = 0 $ =
'(exp @ eqtrd (k218EnumCommandeq2d anl) (anwr k218EnumCommand_nip_halt));

pub theorem k218EnumStep_nip_pop (s: nat):
 $ k218EnumSelector s = 2 -> k218EnumH s != 1 -> k218EnumStep s = suc (k218EnumState (k218EnumTail s) (k218EnumNext s) (k218EnumTW s) (snd (k218EnumWS s)) (k218EnumDelta s) (fst (k218EnumWS s))) $ =
'(exp @ eqtrd (k218EnumCommandeq2d anl) (anwr k218EnumCommand_nip_pop));

pub theorem k218EnumStep_ax (s c: nat):
 $ k218EnumSelector s = suc (suc (suc c)) -> k218EnumStep s = suc (k218EnumAXState s c (k218EnumTail s) (k218EnumNext s) (k218EnumDelta s)) $ =
'(eqtrd (k218EnumCommandeq2d id) (a1i k218EnumCommand_ax));

theorem k218EnumGood_tw (s: nat): $ k218EnumStateGood s -> k218Provable (k218EnumTW s) $ = 'anll;
theorem k218EnumGood_h (s: nat): $ k218EnumStateGood s -> k218Provable (k218EnumH s) $ = 'anlr;
theorem k218EnumGood_stack (s: nat): $ k218EnumStateGood s -> k218GoodStack (k218EnumWS s) $ = 'anr;

theorem k218EnumGood_state (pl np tw ws d h: nat):
  $ k218EnumStateGood (k218EnumState pl np tw ws d h) <->
    k218Provable tw /\ k218Provable h /\ k218GoodStack ws $ =
'(aneq (aneq (k218Provable_eq k218EnumState_TW) (k218Provable_eq k218EnumState_H))
  (k218GoodStackeq k218EnumState_WS));
theorem k218EnumGood_intro (G: wff) (pl np tw ws d h: nat)
  (ht: $ G -> k218Provable tw $) (hh: $ G -> k218Provable h $)
  (hw: $ G -> k218GoodStack ws $):
  $ G -> k218EnumStateGood (k218EnumState pl np tw ws d h) $ =
'(syl (bi2 k218EnumGood_state) (iand (iand ht hh) hw));

theorem k218EnumOption_zero: $ k218EnumOptionGood 0 <-> k218Provable 1 $ = '(ifppos eqid);
theorem k218EnumOption_some (s: nat): $ k218EnumOptionGood (suc s) <-> k218EnumStateGood s $ =
'(bitr (ifpneg peano1) (k218EnumStateGoodeq sucsub1));
theorem k218EnumOption_some_intro (G: wff) (s: nat)
  (h: $ G -> k218EnumStateGood s $): $ G -> k218EnumOptionGood (suc s) $ =
'(syl (bi2 k218EnumOption_some) h);
theorem k218EnumOption_if (G p: wff) (a b: nat)
  (ha: $ G /\ p -> k218EnumOptionGood a $)
  (hb: $ G /\ ~p -> k218EnumOptionGood b $):
  $ G -> k218EnumOptionGood (if p a b) $ =
'(ifbothd (k218EnumOptionGoodeqd id) (k218EnumOptionGoodeqd id) ha hb);
theorem k218EnumOption_if_both (G p: wff) (a b: nat)
  (ha: $ G -> k218EnumOptionGood a $)
  (hb: $ G -> k218EnumOptionGood b $):
  $ G -> k218EnumOptionGood (if p a b) $ =
'(k218EnumOption_if (anwl ha) (anwl hb));

theorem k218EnumGood_mp_hit (s tail next delta: nat):
  $ k218EnumStateGood s /\ kImp (k218EnumTW s) delta = k218EnumH s ->
    k218EnumStateGood (k218EnumState tail next delta (0, k218EnumWS s) delta 0) $ =
'(k218EnumGood_intro
  (sylc k218Provable_mp (anwl k218EnumGood_tw)
    (mpbird (k218Provable_congr anr) (anwl k218EnumGood_h)))
  (a1i k218Provable_true)
  (sylc k218GoodStack_push (a1i k218Provable_true) (anwl k218EnumGood_stack)));
theorem k218EnumGood_mp_miss (s tail next delta: nat):
  $ k218EnumStateGood s ->
    k218EnumStateGood (k218EnumState tail next 0 (k218EnumWS s) delta 0) $ =
'(k218EnumGood_intro (a1i k218Provable_true) (a1i k218Provable_true) k218EnumGood_stack);
theorem k218EnumGood_drop (s tail next delta: nat):
  $ k218EnumStateGood s ->
    k218EnumStateGood (k218EnumState tail next (k218EnumH s) (k218EnumTW s, k218EnumWS s) delta (k218EnumH s)) $ =
'(k218EnumGood_intro k218EnumGood_h k218EnumGood_h
  (sylc k218GoodStack_push k218EnumGood_tw k218EnumGood_stack));
theorem k218EnumGood_nip (s tail next delta: nat):
  $ k218EnumStateGood s ->
    k218EnumStateGood (k218EnumState tail next (k218EnumTW s) (snd (k218EnumWS s)) delta (fst (k218EnumWS s))) $ =
'(k218EnumGood_intro k218EnumGood_tw (syl k218GoodStack_head k218EnumGood_stack)
  (syl k218GoodStack_pop k218EnumGood_stack));
theorem k218EnumGood_ax (s c tail next delta: nat):
  $ k218EnumStateGood s -> k218EnumStateGood (k218EnumAXState s c tail next delta) $ =
'(k218EnumGood_intro (a1i k218Gate_provable) (a1i k218Provable_true)
  (mpd k218EnumGood_stack (mpd k218EnumGood_h (syl k218AxStack_good k218EnumGood_tw))));

theorem k218EnumOption_mp (s tail next delta: nat):
  $ k218EnumStateGood s -> k218EnumOptionGood
    (if (kImp (k218EnumTW s) delta = k218EnumH s)
      (suc (k218EnumState tail next delta (0, k218EnumWS s) delta 0))
      (suc (k218EnumState tail next 0 (k218EnumWS s) delta 0))) $ =
'(k218EnumOption_if (k218EnumOption_some_intro k218EnumGood_mp_hit)
  (anwl (k218EnumOption_some_intro k218EnumGood_mp_miss)));
theorem k218EnumOption_nip (s tail next delta: nat):
  $ k218EnumStateGood s -> k218EnumOptionGood
    (if (k218EnumH s = 1) 0
      (suc (k218EnumState tail next (k218EnumTW s) (snd (k218EnumWS s)) delta (fst (k218EnumWS s))))) $ =
'(k218EnumOption_if
  (syl (bi2 k218EnumOption_zero) (mpbid (k218Provable_congr anr) (anwl k218EnumGood_h)))
  (anwl (k218EnumOption_some_intro k218EnumGood_nip)));

pub theorem k218EnumCommand_good (s ac tail next delta: nat):
  $ k218EnumStateGood s -> k218EnumOptionGood (k218EnumCommand s ac tail next delta) $ =
'(k218EnumOption_if_both k218EnumOption_mp
  (k218EnumOption_if_both (k218EnumOption_some_intro k218EnumGood_drop)
    (k218EnumOption_if_both k218EnumOption_nip (k218EnumOption_some_intro k218EnumGood_ax))));
pub theorem k218EnumStep_good (s: nat):
  $ k218EnumStateGood s -> k218EnumOptionGood (k218EnumStep s) $ = 'k218EnumCommand_good;
pub theorem k218EnumInitial_good: $ k218EnumStateGood k218EnumInitial $ =
'(trud @ k218EnumGood_intro (a1i k218Provable_true) (a1i k218Provable_true) (a1i k218GoodStack_zero));

pub theorem k218EnumStep_some_sound (s t: nat):
  $ k218EnumStateGood s -> k218EnumStep s = suc t -> k218EnumStateGood t $ =
'(exp @ syl (bi1 k218EnumOption_some)
  (mpbid (k218EnumOptionGoodeqd anr) (anwl k218EnumStep_good)));
pub theorem k218EnumStep_halt_sound (s: nat):
  $ k218EnumStateGood s -> k218EnumStep s = 0 -> k218Provable 1 $ =
'(exp @ syl (bi1 k218EnumOption_zero)
  (mpbid (k218EnumOptionGoodeqd anr) (anwl k218EnumStep_good)));
