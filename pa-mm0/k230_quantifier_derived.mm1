'(! kProvable_mp $ (kImp (kImp (kImp (kImp a b) (kImp c kF)) kF) (kImp a b)) $ $ (kImp (kImp (kImp (kImp (kImp a b) (kImp c kF)) kF) a) (kImp (kImp (kImp (kImp a b) (kImp c kF)) kF) b)) $ (! kQDerived51 $ a $ $ b $ $ c $) (! kPropS $ (kImp (kImp (kImp a b) (kImp c kF)) kF) $ $ a $ $ b $));

theorem kQDerived53 (a b c: nat): $ kProvable (kImp a (kImp (kImp (kImp (kImp (kImp a b) (kImp c kF)) kF) a) (kImp (kImp (kImp (kImp a b) (kImp c kF)) kF) b))) $ =
