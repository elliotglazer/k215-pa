'(! kQDerived55 $ a $ $ b $ $ c $);

pub theorem kProvable_syl (a b c: nat)
  (hab: $ kProvable (kImp a b) $) (hbc: $ kProvable (kImp b c) $):
  $ kProvable (kImp a c) $ =
'(kProvable_mp hbc (kProvable_mp hab kPropB));

pub theorem kAll_mono (x a b: nat) (h: $ kProvable (kImp a b) $):
  $ kProvable (kImp (kAll x a) (kAll x b)) $ =
'(kProvable_mp (kProvable_gen h) (kProvable_axiom kAxioms_rho2));

pub theorem kNot_mono (a b: nat) (h: $ kProvable (kImp a b) $):
  $ kProvable (kImp (kNot b) (kNot a)) $ =
'(kProvable_mp h kPropContra);

pub theorem kExists_mono (x a b: nat) (h: $ kProvable (kImp a b) $):
  $ kProvable (kImp (kExists x a) (kExists x b)) $ =
'(kNot_mono (kAll_mono (kNot_mono h)));

pub theorem kExists_collapse (x a: nat)
  (hv: $ kProvable (kImp a (kAll x a)) $):
  $ kProvable (kImp (kExists x a) a) $ =
'(kProvable_syl (kExists_mono hv) (kProvable_axiom kAxioms_rho6));

theorem kEqFresh (x: nat): $ suc x != x $ =
'(ltneri ltsucid);

theorem kEqVac (x: nat):
  $ kProvable (kImp (kEq x x) (kAll (suc x) (kEq x x))) $ =
'(kAnd_right (kBundle_vacuity (ian kEqFresh kEqFresh)));

theorem kEqWitness (x: nat):
  $ kProvable (kImp (kEq (suc x) x) (kEq x x)) $ =
'(kProvable_mp (kProvable_axiom kAxioms_rho7) kPropDuplicate);

pub theorem kEquality_reflexive (x: nat): $ kProvable (kEq x x) $ =
'(kProvable_mp
  (kProvable_mp (kProvable_axiom kAxioms_rho1) (kExists_mono kEqWitness))
  (kExists_collapse kEqVac));

pub theorem kCore_member (a b x m: nat) (hm: $ kProvable m $)
  (hc: $ kProvable (kCore a b x m) $):
  $ kProvable (kExists x (kMem b x)) $ =
(named '(kProvable_mp hc
  (kExists_mono
    {(kProvable_mp hm kPropUseConj) : $ kProvable (kImp (kAnd (kImp m (kMem b x)) (kAll b (kImp (kMem b x) (kExists a (kAnd m (kAll a (kImp (kSubset a b x) (kRequest b x m)))))))) (kMem b x)) $})));

theorem kEq_zero: $ kEq 0 0 = 3 $ =
'(eqtr (addeq1 (eqtr (muleq2 pr0) mul0)) add01);

theorem kQ_three: $ kProvable 3 $ =
'(mpbi (kProvableeq kEq_zero) kEquality_reflexive);

theorem kQ_ne34: $ 3 != 4 $ = '(ltnei ltsucid);

theorem kQ_ne31: $ 3 != 1 $ = '(ltneri (mpbi ltsuc lt01S));

pub theorem kBootstrap_domain_member: $ kProvable (kExists 3 (kMem 1 3)) $ =
'(kCore_member kQ_three (kBundle_core (ian kQ_ne34 kQ_ne31)));
