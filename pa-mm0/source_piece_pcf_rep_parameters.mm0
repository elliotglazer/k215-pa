import "source_reflection_limit_dn_elimination.mm0";

theorem sfPieceParameterMembers_weaken(T:set)(G H A n:nat)
 (hw:$ sfContextWf H $)(hs:$ sfContextSub G H $)
 (hm:$ sfReflectionDnMembers T G A n $):
 $ sfReflectionDnMembers T H A n $;

theorem sfPieceParameterMembers_cons(T:set)(G A v n:nat)
 (hv:$ nsLocal G (sfMem v A) $)(hm:$ sfReflectionDnMembers T G A n $):
 $ sfReflectionDnMembers (sqEnvCons v T) G A (suc n) $;

theorem sfPieceParameterMembers_head(T:set)(G A v n:nat)
 (hm:$ sfReflectionDnMembers (sqEnvCons v T) G A (suc n) $):
 $ nsLocal G (sfMem v A) $;

theorem sfPieceParameterMembers_tail(T:set)(G A v n:nat)
 (hm:$ sfReflectionDnMembers (sqEnvCons v T) G A (suc n) $):
 $ sfReflectionDnMembers T G A n $;
