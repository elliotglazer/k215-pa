import "bb215_table_arithmetic_action.mm0";

import "bb215_arithmetic_formula_list_graph.mm0";

import "bb215_arithmetic_formula_predecessor.mm0";

def bb215TableArithmeticLookupGraph (T q b a .i .v: nat): wff = $ E. i E. v (bb215ArithmeticFormulaPairGraph q b i /\ bb215ArithmeticFormulaListNthGraph i T v /\ bb215ArithmeticFormulaPredecessorGraph v a) $;

theorem bb215TableArithmeticLookupGraph_correct (T q b a: nat) {i v: nat}: $ bb215TableArithmeticLookupGraph T q b a <-> bb215Action T q b = a $;

def bb215TableArithmeticEntryGraph (T q b .a: nat): wff = $ E. a (bb215TableArithmeticLookupGraph T q b a /\ bb215TableArithmeticActionGraph a) $;

theorem bb215TableArithmeticEntryGraph_correct (T q b: nat) {a i v r t k: nat}: $ bb215TableArithmeticEntryGraph T q b <-> k215TMValidAction (bb215Action T q b) $;

def bb215TableArithmeticValidGraph (T .q .b: nat): wff = $ A. q A. b (q < k215Num215 -> b < 2 -> bb215TableArithmeticEntryGraph T q b) $;

theorem bb215TableArithmeticValidGraph_correct (T: nat) {q b a i v r t k: nat}: $ bb215TableArithmeticValidGraph T <-> bb215Valid T $;

theorem bb215TableArithmeticAction_missing (T q b: nat): $ nth (q, b) T = 0 -> bb215Action T q b = 0 $;

theorem bb215TableArithmeticDefault_valid: $ k215TMValidAction 0 $;
