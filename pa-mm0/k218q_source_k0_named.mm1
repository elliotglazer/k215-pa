import "k218q_source_k0.mm1";

pub theorem sfK218K0_named_proof (G n S k a: nat):
 $ sfTheoryContext sfK218K0Axioms G -> k218INamedAt n G a ->
   sqEnvironmentSafe S n 0 k ->
   k218QProvable (sfNamedTemplate (sqNumericEnvironment S) k 0 a) $ =
'(exp @ exp @ syl k218IHypProvable_empty @
 mpd (mpd (syl sqEnvironmentSafe_positive anr)
   (syl k218QClosedImage_support
     (syl (ax_mp sfTheoryContext_mono sfK218K0Axioms_subset_image) anll))) @
 mpd anr @ mpd (a1i leid) @ syl k218INamedAt_use anlr);
