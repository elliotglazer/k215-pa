import "source_piece_pcf_definable_existential_syntax.mm0";

theorem sfPieceDefinableExistential_some_to_value(T:set)(G n phi R A e:nat)(hb:$ sfBound (suc n) phi $)(hr:$ nsLocal G (sfPieceDefinableNamed (suc n) phi R A) $)(hm:$ sfReflectionDnMembers T G A n $)(hs:$ nsLocal G (sfPieceEnv T n e) $)(hp:$ nsLocal G (sfPieceDefinableExistentialSome R A e) $): $ nsLocal G (sfPieceDefinableExistentialValue T phi A) $;

theorem sfPieceDefinableExistential_value_to_some(T:set)(G n phi R A e:nat)(hb:$ sfBound (suc n) phi $)(hr:$ nsLocal G (sfPieceDefinableNamed (suc n) phi R A) $)(hm:$ sfReflectionDnMembers T G A n $)(hs:$ nsLocal G (sfPieceEnv T n e) $)(he:$ nsLocal G (sfLSeparationOp5Extensions e) $)(hv:$ nsLocal G (sfPieceDefinableExistentialValue T phi A) $): $ nsLocal G (sfPieceDefinableExistentialSome R A e) $;

theorem sfPieceDefinableExistential_some_iff(T:set)(G n phi R A e:nat)(hb:$ sfBound (suc n) phi $)(hr:$ nsLocal G (sfPieceDefinableNamed (suc n) phi R A) $)(hm:$ sfReflectionDnMembers T G A n $)(hs:$ nsLocal G (sfPieceEnv T n e) $)(he:$ nsLocal G (sfLSeparationOp5Extensions e) $): $ nsLocal G (sfIff (sfPieceDefinableExistentialSome R A e) (sfPieceDefinableExistentialValue T phi A)) $;

theorem sfPieceDefinableExistential_projection_point(T:set)(G n phi R A e Y X:nat)(hb:$ sfBound (suc n) phi $)(hr:$ nsLocal G (sfPieceDefinableNamed (suc n) phi R A) $)(hm:$ sfReflectionDnMembers T G A n $)(hs:$ nsLocal G (sfPieceEnv T n e) $)(hc:$ nsLocal G (sfMem e X) $)(hp:$ nsLocal G (sfIff (sfMem e Y) (sfAnd (sfMem e X) (sfPieceDefinableExistentialSome R A e))) $)(he:$ nsLocal G (sfLSeparationOp5Extensions e) $): $ nsLocal G (sfIff (sfMem e Y) (sfPieceDefinableExistentialValue T phi A)) $;

theorem sfPieceDefinableExistential_cover_projection_point(T:set)(G n phi R A e Y X:nat)(hb:$ sfBound (suc n) phi $)(hr:$ nsLocal G (sfPieceDefinableNamed (suc n) phi R A) $)(hm:$ sfReflectionDnMembers T G A n $)(hs:$ nsLocal G (sfPieceEnv T n e) $)(hc:$ nsLocal G (sfPieceRepEnvironmentCoverAt A X n) $)(hp:$ nsLocal G (sfIff (sfMem e Y) (sfAnd (sfMem e X) (sfPieceDefinableExistentialSome R A e))) $)(he:$ nsLocal G (sfLSeparationOp5Extensions e) $): $ nsLocal G (sfIff (sfMem e Y) (sfPieceDefinableExistentialValue T phi A)) $;
