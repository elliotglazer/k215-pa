 k218SQ_sqSQ_equiv_backward
 (k218SQ_sqSQ_child_rebase hk ht (mpd hi (syl sqSQ_below_at he)) he ha)
 (k218SQ_sqSQ_allE_scoped (syl (bi1 lt01) hk) (syl ltner ht)
  (mpd hi (syl sqSQ_below_at he)) (syl sqEnvBelow_avoid he) ha hp hd));

theorem k218SQ_sqSQ_exI_rebased (G: wff) (H: nat) (E: set) (n t k i a: nat)
 (hk: $ G -> 0 < k $) (ht: $ G -> t < k $)
 (he: $ G -> sqEnvBelow E n k $) (hi: $ G -> i < n $)
 (ha: $ G -> sfBound (suc n) a $)
 (hp: $ G -> k218IHypProvable H (sqQuote E t k 0 (sfSubst 0 i a)) $)
 (hd: $ G -> k218IHypProvable H (kMem t (E @ i)) $):
 $ G -> k218IHypProvable H (sqQuote E t k 0 (sfEx a)) $ =
'(k218SQ_sqSQ_exI_scoped (syl (bi1 lt01) hk) (syl ltner ht)
