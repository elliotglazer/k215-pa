pub theorem k218SQ_sqSupported_AllE (H S n t k i a: nat):
 $ sqEnvironmentSafe S n t k -> k218SQ_sqDomainSupport H S t -> i < n -> sfBound (suc n) a ->
 k218IHypProvable H (sqQuote (sqNumericEnvironment S) t k 0 (sfAll a)) ->
 k218IHypProvable H (sqQuote (sqNumericEnvironment S) t k 0 (sfSubst 0 i a)) $ =
'(exp @ exp @ exp @ exp @
 k218SQ_sqSQ_allE_rebased
 (syl sqEnvironmentSafe_positive (syl anl (syl anl (syl anl anl))))
 (syl sqEnvironmentSafe_tag (syl anl (syl anl (syl anl anl))))
 (syl sqEnvironmentSafe_live_below (syl anl (syl anl (syl anl anl))))
 (syl anr (syl anl anl)) (syl anr anl) anr
 (mpd (ltletrd (syl anr (syl anl anl))
   (syl sqEnvironmentSafe_length (syl anl (syl anl (syl anl anl)))))
  (syl k218SQ_sqDomainSupport_at (syl anr (syl anl (syl anl anl))))));

