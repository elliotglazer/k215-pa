theorem k218SQ_sqSQ_child_rebase (G: wff) (E: set) (n t k y a: nat)
 (hk: $ G -> 0 < k $) (ht: $ G -> t < k $) (hy: $ G -> y < k $)
 (he: $ G -> sqEnvBelow E n k $) (ha: $ G -> sfBound (suc n) a $):
 $ G -> k218IEquivalent (sqQuote (sqEnvCons y E) t k 0 a)
                       (sqQuote (sqEnvCons y E) t (suc k) 0 a) $ =
'(mpd (sqSQ_hygiene_use (a1i lt01S) (ltletrd ht (a1i lesucid))
  (syl sqEnvBelow_successor (mpd he (syl sqEnvBelow_cons hy)))) @
 mpd (sqSQ_hygiene_use hk ht (mpd he (syl sqEnvBelow_cons hy))) @
 syl k218SQ_sqQuote_fresh_base_equivalent ha);

theorem k218SQ_sqSQ_allE_rebased (G: wff) (H: nat) (E: set) (n t k i a: nat)
 (hk: $ G -> 0 < k $) (ht: $ G -> t < k $)
 (he: $ G -> sqEnvBelow E n k $) (hi: $ G -> i < n $)
 (ha: $ G -> sfBound (suc n) a $)
 (hp: $ G -> k218IHypProvable H (sqQuote E t k 0 (sfAll a)) $)
 (hd: $ G -> k218IHypProvable H (kMem t (E @ i)) $):
