theorem k218SQ_sqSQ_hyp_transport (G: wff) (H a b: nat)
 (he: $ G -> a = b $) (hp: $ G -> k218IHypProvable H b $):
 $ G -> k218IHypProvable H a $ = '(mpbird (k218IHypProvableeq2d he) hp);

theorem k218SQ_sqSQ_prov_transport (G: wff) (a b: nat)
 (he: $ G -> a = b $) (hp: $ G -> k218QProvable b $):
 $ G -> k218QProvable a $ = '(mpbird (k218QProvableeqd he) hp);

theorem k218SQ_sqSQ_hyp_mp (G: wff) (H a b: nat)
 (ha: $ G -> k218IHypProvable H a $) (hi: $ G -> k218IHypProvable H (kImp a b) $):
 $ G -> k218IHypProvable H b $ = '(sylc k218IHypProvable_mp ha hi);

theorem k218SQ_sqSQ_equiv_forward (G: wff) (H a b: nat)
 (he: $ G -> k218IEquivalent a b $) (ha: $ G -> k218IHypProvable H a $):
 $ G -> k218IHypProvable H b $ =
'(k218SQ_sqSQ_hyp_mp ha (syl k218IHypProvable_seed (syl anl he)));

theorem k218SQ_sqSQ_equiv_backward (G: wff) (H a b: nat)
 (he: $ G -> k218IEquivalent a b $) (hb: $ G -> k218IHypProvable H b $):
 $ G -> k218IHypProvable H a $ =
'(k218SQ_sqSQ_hyp_mp hb (syl k218IHypProvable_seed (syl anr he)));

theorem k218SQ_sqSQ_and_intro (G: wff) (H a b: nat)
 (ha: $ G -> k218IHypProvable H a $) (hb: $ G -> k218IHypProvable H b $):
 $ G -> k218IHypProvable H (kAnd a b) $ =
'(k218SQ_sqSQ_hyp_mp hb (k218SQ_sqSQ_hyp_mp ha (a1i (k218IHypProvable_seed k218IPropAndIntro))));

theorem k218SQ_sqSQ_allE_scoped (G: wff) (H: nat) (E: set) (n t k y a: nat)
 (hz: $ G -> k != 0 $) (ht: $ G -> k != t $) (hy: $ G -> y < k $)
 (he: $ G -> sqEnvAvoid E n k $) (ha: $ G -> sfBound (suc n) a $)
 (hp: $ G -> k218IHypProvable H (sqQuote E t k 0 (sfAll a)) $)
 (hd: $ G -> k218IHypProvable H (kMem t y) $):
 $ G -> k218IHypProvable H (sqQuote (sqEnvCons y E) t (suc k) 0 a) $ =
'(k218SQ_sqSQ_hyp_mp hd @ k218SQ_sqSQ_hyp_mp hp @ syl k218IHypProvable_seed @
 k218SQ_sqSQ_prov_transport
 (kImpeqd (syl sqQuote_all_cons (syl sfBound_wf ha)) (eqcomd (sqSQ_subst_all hz ht he ha)))
 (mpd (sqSQ_scope_all_absent (syl sfBound_wf ha) (ltletrd hy (a1i lesucid)))
  (mpd (sqSQ_scope_all_absent (syl sfBound_wf ha) (a1i ltsucid))
    (syl k218INamed_specialization (syl ltner hy)))));

theorem k218SQ_sqSQ_exI_scoped (G: wff) (H: nat) (E: set) (n t k y a: nat)
 (hz: $ G -> k != 0 $) (ht: $ G -> k != t $) (hy: $ G -> y < k $)
 (he: $ G -> sqEnvAvoid E n k $) (ha: $ G -> sfBound (suc n) a $)
 (hp: $ G -> k218IHypProvable H (sqQuote (sqEnvCons y E) t (suc k) 0 a) $)
 (hd: $ G -> k218IHypProvable H (kMem t y) $):
 $ G -> k218IHypProvable H (sqQuote E t k 0 (sfEx a)) $ =
