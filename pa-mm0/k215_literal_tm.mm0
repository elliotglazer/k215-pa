def k215TMAction (q b: nat): nat = $ k215TMActionBlock0 q b $;

def k215TMState (q l r: nat): nat = $ (q, l, r) $;

def k215TMQ (s: nat): nat = $ fst s $;

def k215TML (s: nat): nat = $ fst (snd s) $;

def k215TMR (s: nat): nat = $ snd (snd s) $;

def k215TMWrite (a: nat): nat = $ fst a $;

def k215TMDir (a: nat): nat = $ fst (snd a) $;

def k215TMTarget (a: nat): nat = $ snd (snd a) $;

def k215TMMove (a l r: nat): nat =
$ if (k215TMDir a = 0)
    (k215TMState (k215TMTarget a) (l // 2) (l % 2 + 2 * k215TMWrite a + 4 * (r // 2)))
    (k215TMState (k215TMTarget a) (2 * l + k215TMWrite a) (r // 2)) $;

def k215TMStep (s: nat): nat =
$ if (k215TMQ s < k215Num215)
    (k215TMMove (k215TMAction (k215TMQ s) (k215TMR s % 2)) (k215TML s) (k215TMR s)) s $;

def k215TMInitial: nat = $ k215TMState 0 0 0 $;

def k215TMValidAction (a: nat): wff =
$ k215TMWrite a <= 1 /\ k215TMDir a <= 1 /\ k215TMTarget a <= k215Num215 $;

def k215TMStateBound (s: nat): wff = $ k215TMQ s <= k215Num215 $;

def k215TMRun (n s .x: nat): nat = $ rec s (\ x, k215TMStep x) n $;

def k215LiteralHalts (.n: nat): wff = $ E. n k215TMQ (k215TMRun n k215TMInitial) = k215Num215 $;

theorem k215TMState_Q (q l r: nat): $ k215TMQ (k215TMState q l r) = q $;

theorem k215TMState_L (q l r: nat): $ k215TML (k215TMState q l r) = l $;

theorem k215TMState_R (q l r: nat): $ k215TMR (k215TMState q l r) = r $;

theorem k215TMState_rebuild (s: nat): $ k215TMState (k215TMQ s) (k215TML s) (k215TMR s) = s $;

theorem k215TMAction_valid (q b: nat): $ k215TMValidAction (k215TMAction q b) $;

theorem k215TMMove_Q (a l r: nat): $ k215TMQ (k215TMMove a l r) = k215TMTarget a $;

theorem k215TMMove_bound (a l r: nat): $ k215TMValidAction a -> k215TMStateBound (k215TMMove a l r) $;

theorem k215TMStep_active (s: nat): $ k215TMQ s < k215Num215 ->
 k215TMStep s = k215TMMove (k215TMAction (k215TMQ s) (k215TMR s % 2)) (k215TML s) (k215TMR s) $;

theorem k215TMStep_halted (s: nat): $ ~k215TMQ s < k215Num215 -> k215TMStep s = s $;

theorem k215TMStep_bound (s: nat): $ k215TMStateBound s -> k215TMStateBound (k215TMStep s) $;

theorem k215TMInitial_zero: $ k215TMInitial = 0 $;

theorem k215TMRun_zero (s: nat): $ k215TMRun 0 s = s $;

theorem k215TMRun_succ (n s: nat): $ k215TMRun (suc n) s = k215TMStep (k215TMRun n s) $;

theorem k215TMRun_bound (n s: nat): $ k215TMStateBound s -> k215TMStateBound (k215TMRun n s) $;

theorem k215TMRun_initial_bound (n: nat): $ k215TMStateBound (k215TMRun n k215TMInitial) $;
