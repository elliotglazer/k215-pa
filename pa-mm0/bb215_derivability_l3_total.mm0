import "bb215_derivability_l3_succcases.mm0";

-- L05, layer L3a (lanes/L05.md): totality of <= inside PA, A. y A. x (x <= y \/ S y <= x).
-- Generated by build_bb215_derivability_l3_total.py (with bb215_l3_engine.py).

-- From Lift c -> g one level up, infer c -> A. g.

theorem bb215L3_all_intro_hyp (n c g: nat) (hc: $ paFormulaBound n c $) (hg: $ paFormulaBound (suc n) g $)
  (h: $ paProvable (suc n) (paFormulaImp (paAxiomLift c) g) $): $ paProvable n (paFormulaImp c (paFormulaAll g)) $;

-- PA |- A. y A. x (x <= y \/ S y <= x)  (<= written as E. z (x + z = y))

theorem bb215L3_le_total:
  $ paProvable 0 (paFormulaAll (paFormulaAll (paFormulaOr (paFormulaEx (paFormulaEqual (paTermAddition (paTermVariable 1) (paTermVariable 0)) (paTermVariable 2))) (paFormulaEx (paFormulaEqual (paTermAddition (paTermSuccessor (paTermVariable 2)) (paTermVariable 0)) (paTermVariable 1)))))) $;
