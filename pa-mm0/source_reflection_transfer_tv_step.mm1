import "source_reflection_transfer_tv_quantifiers.mm1";

import "source_l_common_level_setrel.mm1";

pub theorem sfTVExists_local(G D a b y:nat)(hd:$ sfWf D $)(ha:$ sfWf a $)(hb:$ sfWf b $)(hI:$ nsLocal G (sfAll (sfImp (sfMem 0 (suc y)) (sfIff a b))) $)(hC:$ nsLocal G (sfAll (sfImp (sfMem 0 (suc y)) D)) $)(hE:$ nsLocal G (sfReflectionEwAt D a y) $): $ nsLocal G (sfIff (sfEx (sfAnd D a)) (sfEx (sfAnd (sfMem 0 (suc y)) b))) $ = (named '(ax_mp (ax_mp nsLocal_mp (ax_mp (ax_mp nsLocal_mp (ax_mp (ax_mp nsLocal_mp (ax_mp (ax_mp (ax_mp nsLocal_weaken (ax_mp nsLocal_context_wf hI)) all0) (sfTVExists_pure hd sfWf_mem ha hb))) hI)) hC)) hE));

pub theorem sfTVAll_local(G D a b y:nat)(hd:$ sfWf D $)(ha:$ sfWf a $)(hb:$ sfWf b $)(hI:$ nsLocal G (sfAll (sfImp (sfMem 0 (suc y)) (sfIff a b))) $)(hC:$ nsLocal G (sfAll (sfImp (sfMem 0 (suc y)) D)) $)(hE:$ nsLocal G (sfReflectionEwAt D (sfImp a sfBot) y) $): $ nsLocal G (sfIff (sfAll (sfImp D a)) (sfAll (sfImp (sfMem 0 (suc y)) b))) $ = (named '(ax_mp (ax_mp nsLocal_mp (ax_mp (ax_mp nsLocal_mp (ax_mp (ax_mp nsLocal_mp (ax_mp (ax_mp (ax_mp nsLocal_weaken (ax_mp nsLocal_context_wf hI)) all0) (sfTVAll_pure hd sfWf_mem ha hb))) hI)) hC)) hE));

pub theorem sfTV_Ex_relativizations(G D phi y:nat)(hd:$ sfWf D $)(hI:$ nsLocal G (sfAll (sfImp (sfMem 0 (suc y)) (sfIff (sfRelativize D phi) (sfCLSetRel (suc y) phi)))) $)(hC:$ nsLocal G (sfAll (sfImp (sfMem 0 (suc y)) D)) $)(hE:$ nsLocal G (sfReflectionEwAt D (sfRelativize D phi) y) $): $ nsLocal G (sfIff (sfRelativize D (sfEx phi)) (sfCLSetRel y (sfEx phi))) $ = (named '(mpbi (nsLocal_formula_eq (nsAnd_eq (nsImp_eq (eqcom sfRelativize_sfEx) (eqcom sfCLSetRel_sfEx)) (nsImp_eq (eqcom sfCLSetRel_sfEx) (eqcom sfRelativize_sfEx)))) (sfTVExists_local hd (ax_mp sfRelativize_wf hd) sfCLSetRel_wf hI hC hE)));

pub theorem sfTV_All_relativizations(G D phi y:nat)(hd:$ sfWf D $)(hI:$ nsLocal G (sfAll (sfImp (sfMem 0 (suc y)) (sfIff (sfRelativize D phi) (sfCLSetRel (suc y) phi)))) $)(hC:$ nsLocal G (sfAll (sfImp (sfMem 0 (suc y)) D)) $)(hE:$ nsLocal G (sfReflectionEwAt D (sfImp (sfRelativize D phi) sfBot) y) $): $ nsLocal G (sfIff (sfRelativize D (sfAll phi)) (sfCLSetRel y (sfAll phi))) $ = (named '(mpbi (nsLocal_formula_eq (nsAnd_eq (nsImp_eq (eqcom sfRelativize_sfAll) (eqcom sfCLSetRel_sfAll)) (nsImp_eq (eqcom sfCLSetRel_sfAll) (eqcom sfRelativize_sfAll)))) (sfTVAll_local hd (ax_mp sfRelativize_wf hd) sfCLSetRel_wf hI hC hE)));
