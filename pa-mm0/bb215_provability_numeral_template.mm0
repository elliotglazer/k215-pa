import "pa_proof_syntax_formula_evaluation_closed.mm0";

def bb215PBSafeFormula (p: nat): nat = $ if (sfWf p) p sfBot $;

theorem bb215PB_graph_instance_template (c graph p: nat): $ sfWf c /\ sfWf graph /\ sfWf p -> zfcProvable (sfImp (paSourceEqualityGraphEvaluation c graph p) (sfImp (sfEx graph) (sfAnd (sfImp (sfEx (sfAnd graph c)) p) (sfImp p (sfEx (sfAnd graph c)))))) $;

theorem bb215PB_graph_instance_equivalence (c graph p: nat): $ sfWf c /\ sfWf graph /\ sfWf p -> zfcProvable (paSourceEqualityGraphEvaluation c graph p) -> zfcProvable (sfEx graph) -> zfcProvable (sfAnd (sfImp (sfEx (sfAnd graph c)) p) (sfImp p (sfEx (sfAnd graph c)))) $;
