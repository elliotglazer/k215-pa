import "source_named_renaming.mm0";

import "zfc_schema_maps.mm0";

import "source_bounds.mm0";

import "quotation_binders.mm0";

theorem sfK0QRepQuote_A (E: set) (x y z: nat) (n t k phi: nat): $ sfBound (suc (suc n)) phi -> sqQuote (sqEnvCons z (sqEnvCons y (sqEnvCons x E))) t k 0 (sfRename sfRepAMap 0 phi) = sqQuote (sqEnvCons x (sqEnvCons y E)) t k 0 phi $;

theorem sfK0QRepQuote_B (E: set) (x y z: nat) (n t k phi: nat): $ sfBound (suc (suc n)) phi -> sqQuote (sqEnvCons z (sqEnvCons y (sqEnvCons x E))) t k 0 (sfRename sfRepBMap 0 phi) = sqQuote (sqEnvCons x (sqEnvCons z E)) t k 0 phi $;

theorem sfK0QRepQuote_C (E: set) (x y c a: nat) (n t k phi: nat): $ sfBound (suc (suc n)) phi -> sqQuote (sqEnvCons x (sqEnvCons y (sqEnvCons c (sqEnvCons a E)))) t k 0 (sfRename sfRepCMap 0 phi) = sqQuote (sqEnvCons x (sqEnvCons y E)) t k 0 phi $;
