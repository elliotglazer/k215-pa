theorem k215UnpairAt4247AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt4247State k215PNum4247 0 b (suc n) c) (k215UnpairAt4247State k215PNum4247 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
