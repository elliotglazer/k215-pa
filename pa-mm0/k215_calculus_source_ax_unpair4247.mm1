@_ abstract def k215UnpairAt4247Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt4247Run n a b c $;
theorem k215UnpairAt4247Claim_at (n a b c: nat): $ k215UnpairAt4247Claim n c -> k215UnpairAt4247Run n a b c $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
