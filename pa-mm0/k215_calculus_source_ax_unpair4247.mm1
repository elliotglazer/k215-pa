@_ abstract def k215UnpairAt4247Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt4247State k215PNum4247 a b n c) (k215UnpairAt4247State k215PNum4255 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
