theorem k215UnpairAt4247Claim_all (n c: nat): $ k215UnpairAt4247Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt4247RunZero)) '(iald @ iald k215UnpairAt4247RunInductive));
pub theorem k215UnpairMacro4247 (n a b c: nat): $ k215PReach (k215UnpairAt4247State k215PNum4247 a b n c) (k215UnpairAt4247State k215PNum4255 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
