import "k215_calculus_source_ax_stack_loops.mm1";
import "k215_literal_runtime_reach.mm1";
import "k215_calculus_source_pairing.mm1";
import "k215_calculus_source_ax_stack_lookups.mm1";

@_ def k215UnpairAt2801State (pc a b n c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) n (k215PR3 c) (k215PR4 c) (k215PR5 c) a b (k215PR8 c)) $;

do (apply (register-eqd 'k215UnpairAt2801State) '(k215UnpairAt2801Stateeqd));

theorem k215UnpairAt2801Transfer (b n c: nat): $ k215PIter (3 * b + 1) (k215UnpairAt2801State k215PNum2805 0 b n c) = (k215UnpairAt2801State k215PNum2808 b 0 n c) $ =
 '(eqtr k215Loop2805Vector (k215PStateeq2 (k215PVectoreq7 add0)));
theorem k215UnpairAt2801ReachTransfer (b n c: nat): $ k215PReach (k215UnpairAt2801State k215PNum2805 0 b n c) (k215UnpairAt2801State k215PNum2808 b 0 n c) $ =
 '(k215PReach_intro k215UnpairAt2801Transfer);


theorem k215UnpairAt2801Step9Z (a b c: nat): $ k215PStep (k215UnpairAt2801State k215PNum2801 a b 0 c) = (k215UnpairAt2801State k215PNum2809 a b 0 c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair2801_2801) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt2801Reach9Z (a b c: nat): $ k215PReach (k215UnpairAt2801State k215PNum2801 a b 0 c) (k215UnpairAt2801State k215PNum2809 a b 0 c) $ = '(k215PReach_step k215UnpairAt2801Step9Z);

theorem k215UnpairAt2801Step9S (a b n c: nat): $ k215PStep (k215UnpairAt2801State k215PNum2801 a b (suc n) c) = (k215UnpairAt2801State k215PNum2802 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair2801_2801) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet2_vector)) (eqtr k215PSet2_vector (k215PVectoreq3 (eqtr subSS sub02))))));

theorem k215UnpairAt2801Reach9S (a b n c: nat): $ k215PReach (k215UnpairAt2801State k215PNum2801 a b (suc n) c) (k215UnpairAt2801State k215PNum2802 a b n c) $ = '(k215PReach_step k215UnpairAt2801Step9S);

theorem k215UnpairAt2801Step10 (a b n c: nat): $ k215PStep (k215UnpairAt2801State k215PNum2802 a b n c) = (k215UnpairAt2801State k215PNum2803 a (suc b) n c) $ = '(eqtr (k215PAtCI k215PLookupUnpair2801_2802) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215UnpairAt2801Reach10 (a b n c: nat): $ k215PReach (k215UnpairAt2801State k215PNum2802 a b n c) (k215UnpairAt2801State k215PNum2803 a (suc b) n c) $ = '(k215PReach_step k215UnpairAt2801Step10);

theorem k215UnpairAt2801Step11Z (b n c: nat): $ k215PStep (k215UnpairAt2801State k215PNum2803 0 b n c) = (k215UnpairAt2801State k215PNum2805 0 b n c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair2801_2803) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt2801Reach11Z (b n c: nat): $ k215PReach (k215UnpairAt2801State k215PNum2803 0 b n c) (k215UnpairAt2801State k215PNum2805 0 b n c) $ = '(k215PReach_step k215UnpairAt2801Step11Z);

theorem k215UnpairAt2801Step11S (a b n c: nat): $ k215PStep (k215UnpairAt2801State k215PNum2803 (suc a) b n c) = (k215UnpairAt2801State k215PNum2804 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair2801_2803) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215UnpairAt2801Reach11S (a b n c: nat): $ k215PReach (k215UnpairAt2801State k215PNum2803 (suc a) b n c) (k215UnpairAt2801State k215PNum2804 a b n c) $ = '(k215PReach_step k215UnpairAt2801Step11S);

theorem k215UnpairAt2801Step12 (a b n c: nat): $ k215PStep (k215UnpairAt2801State k215PNum2804 a b n c) = (k215UnpairAt2801State k215PNum2808 a b n c) $ = '(k215PAtCB k215PLookupUnpair2801_2804);

theorem k215UnpairAt2801Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt2801State k215PNum2804 a b n c) (k215UnpairAt2801State k215PNum2808 a b n c) $ = '(k215PReach_step k215UnpairAt2801Step12);

theorem k215UnpairAt2801Step16 (a b n c: nat): $ k215PStep (k215UnpairAt2801State k215PNum2808 a b n c) = (k215UnpairAt2801State k215PNum2801 a b n c) $ = '(k215PAtCC k215PLookupUnpair2801_2808);

theorem k215UnpairAt2801Reach16 (a b n c: nat): $ k215PReach (k215UnpairAt2801State k215PNum2808 a b n c) (k215UnpairAt2801State k215PNum2801 a b n c) $ = '(k215PReach_step k215UnpairAt2801Step16);

theorem k215UnpairAt2801CycleZero (b n c: nat): $ k215PReach (k215UnpairAt2801State k215PNum2801 0 b (suc n) c) (k215UnpairAt2801State k215PNum2801 (suc b) 0 n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt2801Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2801Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2801Reach11Z) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2801ReachTransfer) k215UnpairAt2801Reach16))));
theorem k215UnpairAt2801CycleSucc (a b n c: nat): $ k215PReach (k215UnpairAt2801State k215PNum2801 (suc a) b (suc n) c) (k215UnpairAt2801State k215PNum2801 a (suc b) n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt2801Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2801Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2801Reach11S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2801Reach12) k215UnpairAt2801Reach16))));


theorem k215UnpairAt2801AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt2801State k215PNum2801 0 b (suc n) c) (k215UnpairAt2801State k215PNum2801 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt2801Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215PairDiagonal_rotate)) (eqtr (eqcom sndpr) (sndeq k215PairDiagonal_rotate)) eqid eqid)) k215UnpairAt2801CycleZero);

theorem k215UnpairAt2801AdvanceSucc (a b n c: nat): $ k215PReach (k215UnpairAt2801State k215PNum2801 (suc a) b (suc n) c) (k215UnpairAt2801State k215PNum2801 (fst (suc ((suc a), b))) (snd (suc ((suc a), b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt2801Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215Pair_next)) (eqtr (eqcom sndpr) (sndeq k215Pair_next)) eqid eqid)) k215UnpairAt2801CycleSucc);

pub theorem k215UnpairAt2801Advance (a b n c: nat): $ k215PReach (k215UnpairAt2801State k215PNum2801 a b (suc n) c) (k215UnpairAt2801State k215PNum2801 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
 (named @ induct '(ind) 'a 'k215UnpairAt2801AdvanceZero '(a1i k215UnpairAt2801AdvanceSucc));
@_ abstract def k215UnpairAt2801Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt2801State k215PNum2801 a b n c) (k215UnpairAt2801State k215PNum2809 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
theorem k215UnpairAt2801RunZero (a b c: nat): $ k215UnpairAt2801Run 0 a b c $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt2801Stateeq eqid
     (eqcom (eqtr (fsteq add0) fstpr))
     (eqcom (eqtr (sndeq add0) sndpr)) eqid eqid)) k215UnpairAt2801Reach9Z);
@_ abstract def k215UnpairAt2801Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt2801Run n a b c $;
theorem k215UnpairAt2801Claim_at (n a b c: nat): $ k215UnpairAt2801Claim n c -> k215UnpairAt2801Run n a b c $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215UnpairAt2801CodeStep (a b n: nat): $ (fst (suc (a, b)), snd (suc (a, b))) + n = (a, b) + suc n $ =
 '(eqtr (addeq1 fstsnd) addSass);
theorem k215UnpairAt2801RunInductive (n a b c: nat): $ k215UnpairAt2801Claim n c -> k215UnpairAt2801Run (suc n) a b c $ =
 '(syl (ax_mp k215PReach_trans k215UnpairAt2801Advance)
   (mpbid (a1i (k215PReacheq2 (k215UnpairAt2801Stateeq eqid
     (fsteq k215UnpairAt2801CodeStep) (sndeq k215UnpairAt2801CodeStep) eqid eqid))) k215UnpairAt2801Claim_at));
theorem k215UnpairAt2801Claim_all (n c: nat): $ k215UnpairAt2801Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt2801RunZero)) '(iald @ iald k215UnpairAt2801RunInductive));
pub theorem k215UnpairMacro2801 (n a b c: nat): $ k215PReach (k215UnpairAt2801State k215PNum2801 a b n c) (k215UnpairAt2801State k215PNum2809 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
 '(ax_mp k215UnpairAt2801Claim_at k215UnpairAt2801Claim_all);
pub theorem k215UnpairMacro2801_clean (n c: nat): $ k215PReach (k215UnpairAt2801State k215PNum2801 0 0 n c) (k215UnpairAt2801State k215PNum2809 (fst n) (snd n) 0 c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt2801Stateeq eqid
   (fsteq (eqtr (addeq1 pr0) add01))
   (sndeq (eqtr (addeq1 pr0) add01)) eqid eqid)) k215UnpairMacro2801);


