   (eqtr k215PIter_succ (eqtr (k215PStepeq k215PIter_zero)
     (eqtr k215Loop13StepZ (k215Loop13Stateeq eqid eqid (eqcom add01) eqid eqid)))));
theorem k215Loop13Inductive (x y z c: nat): $ k215Loop13Claim x c -> k215PIter (3 * suc x + 1) (k215Loop13State k215Num13 (suc x) y z c) = (k215Loop13State k215Num16 0 (suc x + y) z c) $ =
 '(eqtrd (a1i (eqtr (k215PItereq1 k215EqTime_succ)
     (eqtr k215PIter_add (k215PItereq2 k215Loop13Cycle3))))
   (eqtrd k215Loop13At (a1i (k215Loop13Stateeq eqid eqid (eqtr addS (eqcom addS1)) eqid eqid))));
