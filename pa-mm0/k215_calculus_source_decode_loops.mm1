theorem k215Loop13Step1 (x y z c: nat): $ k215PStep (k215Loop13State k215Num14 x y z c) = (k215Loop13State k215Num15 x (suc y) z c) $ = '(eqtr (k215PAtCI k215PLookupDecode_14) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet6_vector)) k215PSet6_vector)));

theorem k215Loop13Back (x y z c: nat): $ k215PStep (k215Loop13State k215Num15 x y z c) = (k215Loop13State k215Num13 x y z c) $ = '(k215PAtCC k215PLookupDecode_15);

theorem k215Loop13Cycle1 (x y z c: nat): $ k215PIter 1 (k215Loop13State k215Num13 (suc x) y z c) = (k215Loop13State k215Num14 x y z c) $ = '(eqtr k215PIter_succ (eqtr (k215PStepeq k215PIter_zero) k215Loop13StepS));

theorem k215Loop13Cycle2 (x y z c: nat): $ k215PIter 2 (k215Loop13State k215Num13 (suc x) y z c) = (k215Loop13State k215Num15 x (suc y) z c) $ = '(eqtr k215PIter_succ (eqtr (k215PStepeq k215Loop13Cycle1) k215Loop13Step1));

theorem k215Loop13Cycle3 (x y z c: nat): $ k215PIter 3 (k215Loop13State k215Num13 (suc x) y z c) = (k215Loop13State k215Num13 x (suc y) z c) $ = '(eqtr k215PIter_succ (eqtr (k215PStepeq k215Loop13Cycle2) k215Loop13Back));

@_ abstract def k215Loop13Claim (x c: nat) (.y .z: nat): wff =
 $ A. y A. z k215PIter (3 * x + 1) (k215Loop13State k215Num13 x y z c) = (k215Loop13State k215Num16 0 (x + y) z c) $;
theorem k215Loop13At (x y z c: nat): $ k215Loop13Claim x c -> k215PIter (3 * x + 1) (k215Loop13State k215Num13 x y z c) = (k215Loop13State k215Num16 0 (x + y) z c) $ =
