pub theorem k215Loop13Vector (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ k215PIter (3 * a7 + 1) (k215PState k215Num13 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) =
   k215PState k215Num16 (k215PVector a0 a1 a2 a3 a4 a5 (a7 + a6) 0 a8) $ =
 '(eqtr (k215PItereq2 (eqcom k215Loop13VectorIn)) (eqtr k215Loop13Transfer k215Loop13VectorOut));

