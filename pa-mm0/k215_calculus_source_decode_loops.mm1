theorem k215Loop20VectorIn (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215Loop20State k215Num20 a6 a3 a0 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = k215PState k215Num20 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8) $ = '(k215PStateeq2 (k215PVectoreq eqid k215PR1_vector k215PR2_vector eqid k215PR4_vector k215PR5_vector eqid k215PR7_vector k215PR8_vector));

theorem k215Loop20VectorOut (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215Loop20State k215Num23 0 (a6 + a3) a0 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = k215PState k215Num23 (k215PVector a0 a1 a2 (a6 + a3) a4 a5 0 a7 a8) $ = '(k215PStateeq2 (k215PVectoreq eqid k215PR1_vector k215PR2_vector eqid k215PR4_vector k215PR5_vector eqid k215PR7_vector k215PR8_vector));

pub theorem k215Loop20Vector (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ k215PIter (3 * a6 + 1) (k215PState k215Num20 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) =
   k215PState k215Num23 (k215PVector a0 a1 a2 (a6 + a3) a4 a5 0 a7 a8) $ =
 '(eqtr (k215PItereq2 (eqcom k215Loop20VectorIn)) (eqtr k215Loop20Transfer k215Loop20VectorOut));

