import "source_l_universal_hierarchy_interface.mm0";

import "source_l_power_hierarchy_syntax.mm0";

import "source_l_common_level_members.mm0";

import "source_theory_local.mm0";

def sfPieceHierarchySubsetNormal(level:nat):nat = $ sfAll (sfAll (sfAll (sfAll (sfImp (sfSubst 0 3 sfLeastOrdinalPredicate) (sfImp (sfSubst 0 2 sfLeastOrdinalPredicate) (sfImp (sfCLSubset 2 3) (sfImp (sfORBinary level 3 1) (sfImp (sfORBinary level 2 0) (sfCLSubset 0 1))))))))) $;

theorem sfPieceHierarchySubset_normal_eq: $ sfLPowerHierarchySubset = sfPieceHierarchySubsetNormal sfLUniversalHierarchyRelation $;

theorem sfPieceHierarchySubset_normal(hl:$ sfTheoryProvable zfrAxioms sfLPowerHierarchySubset $): $ sfTheoryProvable zfrAxioms (sfPieceHierarchySubsetNormal sfLUniversalHierarchyRelation) $;
