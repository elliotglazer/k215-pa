import "source_l_common_level_two_wf.mm0";
import "source_piece_pcf_subset_normal.mm0";

theorem sfCL2_hierarchy_relation (a y: nat):
 $ sfCLHierarchyAt a y = sfORBinary sfLUniversalHierarchyRelation a y $;

theorem sfCL2Sub_eq: $ sfCL2Sub = sfPieceHierarchySubsetNormal sfLUniversalHierarchyRelation $;

theorem sfCL2Sub_from_hierarchy (h: $ sfTheoryProvable zfrAxioms sfLPowerHierarchySubset $):
 $ sfTheoryProvable zfrAxioms sfCL2Sub $;
