import "source_reflection_least_cond_ord_maps.mm0";

theorem sfLCBinary_rename_tail{j:nat}(R:set)(d phi x y z zz:nat)(hf:$ sfWf phi $)(ht:$ A. j (sfRenameDepthMap R d @ (j + z) = j + zz) $): $ sfRename R d (sfLCBinary phi x y z) = sfLCBinary phi (sfRenameDepthMap R d @ x) (sfRenameDepthMap R d @ y) zz $;
