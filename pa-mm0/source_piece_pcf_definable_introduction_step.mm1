import "source_piece_pcf_definable_realization.mm1";

@_ abstract def sfPieceDefinableDnIntroductionMap(R:set): set = $ sfComposeMap (sfRenameDepthMap R 1) sfPieceRotate $;

@_ abstract def sfPieceDefinableDnIntroductionGuard(R:set): nat = $ sfMem 0 (suc (R @ 1)) $;

@_ abstract def sfPieceDefinableDnIntroductionContext(R:set)(G:nat): nat = $ sfPieceDefinableDnIntroductionGuard R : sfContextShift G $;

pub theorem sfPieceDefinableDnIntroductionMap_zero(R:set): $ sfPieceDefinableDnIntroductionMap R @ 0 = suc (R @ 0) $ = (named '(eqtr sfComposeMap_value (eqtr (appeq2 sfPieceRotate_zero) (eqtr sfRenameDepthMap_value (eqtr sfRenameIndex_lift (suceq sfRenameIndex_zero))))));

pub theorem sfPieceDefinableDnIntroductionMap_one(R:set): $ sfPieceDefinableDnIntroductionMap R @ 1 = suc (R @ 1) $ = (named '(eqtr sfComposeMap_value (eqtr (appeq2 sfPieceRotate_one) (eqtr sfRenameDepthMap_value (eqtr sfRenameIndex_lift (suceq sfRenameIndex_zero))))));

pub theorem sfPieceDefinableDnIntroductionMap_two(R:set): $ sfPieceDefinableDnIntroductionMap R @ 2 = 0 $ = (named '(eqtr sfComposeMap_value (eqtr (appeq2 sfPieceRotate_two) (eqtr sfRenameDepthMap_value (ax_mp sfRenameIndex_bound lt01S)))));

pub theorem sfPieceDefinableDnIntroduction_unfold(R:set)(n body:nat)(hf:$ sfWf (sfPieceDn n body) $): $ sfRename R 0 (sfPieceDn (suc n) body) = sfAll (sfImp (sfPieceDefinableDnIntroductionGuard R) (sfRename (sfPieceDefinableDnIntroductionMap R) 0 (sfPieceDn n body))) $ = (named '(eqtr (trud (sfRename_congr_formula (a1i sfPieceDn_suc))) (eqtr sfRename_sfAll (sfAlleq (eqtr sfRename_sfImp (sfImpeq (eqtr sfRename_sfMem (sfMemeq (ax_mp sfRenameIndex_bound lt01S) (eqtr sfRenameIndex_lift (suceq sfRenameIndex_zero)))) (ax_mp sfRename_mixed_compose hf)))))));

pub theorem sfPieceDefinableDnIntroduction_close(R:set)(G n body:nat)(hg:$ sfContextWf G $)(hf:$ sfWf (sfPieceDn n body) $)(hp:$ nsLocal (sfPieceDefinableDnIntroductionContext R G) (sfRename (sfPieceDefinableDnIntroductionMap R) 0 (sfPieceDn n body)) $): $ nsLocal G (sfRename R 0 (sfPieceDn (suc n) body)) $ = (named '(sfRQ_rewrite (eqcom (sfPieceDefinableDnIntroduction_unfold hf)) (ax_mp (sfLocal_allI hg) (ax_mp nsLocal_II hp))));

pub theorem sfPieceDefinableDnIntroduction_open(R:set)(G n body:nat)(hf:$ sfWf (sfPieceDn n body) $)(hp:$ nsLocal G (sfRename R 0 (sfPieceDn (suc n) body)) $): $ nsLocal (sfPieceDefinableDnIntroductionContext R G) (sfRename (sfPieceDefinableDnIntroductionMap R) 0 (sfPieceDn n body)) $ = (named '(ax_mp (ax_mp nsLocal_mp (ax_mp (ax_mp (ax_mp nsLocal_weaken (mpbir sfContextWf_cons (ian sfWf_mem (ax_mp sfContextShift_preserves_wf (ax_mp nsLocal_context_wf hp))))) sfContextSub_cons) (ax_mp sfSepLocal_open (sfRQ_rewrite (sfPieceDefinableDnIntroduction_unfold hf) hp)))) (ax_mp (ax_mp nsLocal_hyp (mpbir sfContextWf_cons (ian sfWf_mem (ax_mp sfContextShift_preserves_wf (ax_mp nsLocal_context_wf hp))))) sfContext_member_head)));
