import "b4b_bc_sound4.mm0";

theorem g2Tup_le (j g a b c d k: nat): $ bdTup j g a b c d k -> b <= k $;
theorem g2Has_lt (m v i g a b c d: nat): $ bdHas m v i g a b c d -> b < v $;
theorem bcRNum_mono (G: wff) (m v i n t m2 v2: nat) {kk: nat} (hs: $ G -> A. kk (bdCell m v kk -> bdCell m2 v2 kk) $): $ G -> bcRNum m v i n t -> bcRNum m2 v2 i n t $;
theorem bcRTLift_mono (G: wff) (m v i k t y m2 v2: nat) {kk: nat} (hs: $ G -> A. kk (bdCell m v kk -> bdCell m2 v2 kk) $): $ G -> bcRTLift m v i k t y -> bcRTLift m2 v2 i k t y $;
theorem bcRTRen_mono (G: wff) (m v i e d t y m2 v2: nat) {kk: nat} (hs: $ G -> A. kk (bdCell m v kk -> bdCell m2 v2 kk) $): $ G -> bcRTRen m v i e d t y -> bcRTRen m2 v2 i e d t y $;
theorem bcRTSub_mono (G: wff) (m v i d a t y m2 v2: nat) {kk: nat} (hs: $ G -> A. kk (bdCell m v kk -> bdCell m2 v2 kk) $): $ G -> bcRTSub m v i d a t y -> bcRTSub m2 v2 i d a t y $;
theorem bcRFSub_mono (G: wff) (m v i d a c y m2 v2: nat) {kk: nat} (hs: $ G -> A. kk (bdCell m v kk -> bdCell m2 v2 kk) $): $ G -> bcRFSub m v i d a c y -> bcRFSub m2 v2 i d a c y $;
theorem bcRFRen_mono (G: wff) (m v i e d c y m2 v2: nat) {kk: nat} (hs: $ G -> A. kk (bdCell m v kk -> bdCell m2 v2 kk) $): $ G -> bcRFRen m v i e d c y -> bcRFRen m2 v2 i e d c y $;
theorem bcRSRen_mono (G: wff) (m v i e d c y m2 v2: nat) {kk: nat} (hs: $ G -> A. kk (bdCell m v kk -> bdCell m2 v2 kk) $): $ G -> bcRSRen m v i e d c y -> bcRSRen m2 v2 i e d c y $;
theorem bcRTSrc_mono (G: wff) (m v i t y m2 v2: nat) {kk: nat} (hs: $ G -> A. kk (bdCell m v kk -> bdCell m2 v2 kk) $): $ G -> bcRTSrc m v i t y -> bcRTSrc m2 v2 i t y $;
theorem bcRFSrc_mono (G: wff) (m v i c y m2 v2: nat) {kk: nat} (hs: $ G -> A. kk (bdCell m v kk -> bdCell m2 v2 kk) $): $ G -> bcRFSrc m v i c y -> bcRFSrc m2 v2 i c y $;
theorem bcRule_mono (G: wff) (m v i g a b c d m2 v2: nat) {kk: nat} (hs: $ G -> A. kk (bdCell m v kk -> bdCell m2 v2 kk) $): $ G -> bcRule m v i g a b c d -> bcRule m2 v2 i g a b c d $;
--| some justified fact set (m, v) holds the fact (g, a, b, c, d).
def bcCertF (g a b c d .m .v: nat): wff =
$ E. m E. v (bcJust m v /\ bdHas m v v g a b c d) $;
theorem bcJ_inst (m v e: nat) {i g a b c d: nat}: $ bcJust m v -> bdCell m v e -> E. i (i <= e /\ (E. g (g <= e /\ (E. a (a <= e /\ (E. b (b <= e /\ (E. c (c <= e /\ (E. d (d <= e /\ bdTup i g a b c d e /\ bcRule m v i g a b c d))))))))))) $;
theorem bcJ_mono (G: wff) (m v m2 v2 e: nat) {i g a b c d kk: nat} (hs: $ G -> A. kk (bdCell m v kk -> bdCell m2 v2 kk) $): $ G -> E. i (i <= e /\ (E. g (g <= e /\ (E. a (a <= e /\ (E. b (b <= e /\ (E. c (c <= e /\ (E. d (d <= e /\ bdTup i g a b c d e /\ bcRule m v i g a b c d))))))))))) -> E. i (i <= e /\ (E. g (g <= e /\ (E. a (a <= e /\ (E. b (b <= e /\ (E. c (c <= e /\ (E. d (d <= e /\ bdTup i g a b c d e /\ bcRule m2 v2 i g a b c d))))))))))) $;
theorem bcJust_intro (m v: nat) {k i g a b c d: nat}: $ A. k (bdCell m v k -> E. i (i <= k /\ (E. g (g <= k /\ (E. a (a <= k /\ (E. b (b <= k /\ (E. c (c <= k /\ (E. d (d <= k /\ bdTup i g a b c d k /\ bcRule m v i g a b c d)))))))))))) -> bcJust m v $;
theorem bcEmpty {k m v: nat}: $ E. m E. v bcJust m v $;
theorem bcJoin_sub1 (m1 v1 m2 v2 m v: nat) {k kk: nat}: $ A. k (bdCell m v k <-> k < v1 + v2 /\ (bdCell m1 v1 k \/ bdCell m2 v2 k)) -> A. kk (bdCell m1 v1 kk -> bdCell m v kk) $;
theorem bcJoin_sub2 (m1 v1 m2 v2 m v: nat) {k kk: nat}: $ A. k (bdCell m v k <-> k < v1 + v2 /\ (bdCell m1 v1 k \/ bdCell m2 v2 k)) -> A. kk (bdCell m2 v2 kk -> bdCell m v kk) $;
theorem bcJoin_just (m1 v1 m2 v2 m v: nat) {k kk i g a b c d: nat}: $ bcJust m1 v1 -> bcJust m2 v2 -> A. k (bdCell m v k <-> k < v1 + v2 /\ (bdCell m1 v1 k \/ bdCell m2 v2 k)) -> bcJust m v $;
theorem bcJoin (m1 v1 m2 v2: nat) {kk m v: nat}: $ bcJust m1 v1 -> bcJust m2 v2 -> E. m E. v (bcJust m v /\ A. kk (bdCell m1 v1 kk -> bdCell m v kk) /\ A. kk (bdCell m2 v2 kk -> bdCell m v kk)) $;
theorem bcAdd_sub (m v m2 v2 g a b c d: nat) {k kk: nat}: $ A. k (bdCell m2 v2 k <-> k < suc (v + (v, g, a, b, c, d)) /\ (bdCell m v k \/ k = (v, g, a, b, c, d))) -> A. kk (bdCell m v kk -> bdCell m2 v2 kk) $;
theorem bcAdd_K (m v m2 v2 g a b c d: nat) {k: nat}: $ A. k (bdCell m2 v2 k <-> k < suc (v + (v, g, a, b, c, d)) /\ (bdCell m v k \/ k = (v, g, a, b, c, d))) -> bdCell m2 v2 (v, g, a, b, c, d) $;
theorem bcAdd_just (m v m2 v2 g a b c d: nat) {k kk: nat}: $ bcJust m v -> bcRule m v v g a b c d -> A. k (bdCell m2 v2 k <-> k < suc (v + (v, g, a, b, c, d)) /\ (bdCell m v k \/ k = (v, g, a, b, c, d))) -> bcJust m2 v2 $;
theorem bcAdd_has (m v m2 v2 g a b c d: nat) {k j: nat}: $ bdCell m2 v2 (v, g, a, b, c, d) -> bdHas m2 v2 v2 g a b c d $;
theorem bcAdd (m v g a b c d: nat) {kk m2 v2: nat}: $ bcJust m v -> bcRule m v v g a b c d -> E. m2 E. v2 (bcJust m2 v2 /\ A. kk (bdCell m v kk -> bdCell m2 v2 kk) /\ bdHas m2 v2 v2 g a b c d) $;
theorem bcCF_intro (m v g a b c d: nat): $ bcJust m v -> bdHas m v v g a b c d -> bcCertF g a b c d $;
theorem bcCC_1 (gK aK bK cK eK gL aL bL cL eL: nat) {mA vA m v: nat}: $ E. mA E. vA (bcJust mA vA /\ bdHas mA vA vA gK aK bK cK eK) -> bcCertF gL aL bL cL eL -> E. m E. v (bcJust m v /\ bdHas m v v gK aK bK cK eK /\ bdHas m v v gL aL bL cL eL) $;
theorem bcCC_2 (gK aK bK cK eK gL aL bL cL eL gM aM bM cM eM: nat) {mA vA m v: nat}: $ E. mA E. vA (bcJust mA vA /\ bdHas mA vA vA gK aK bK cK eK /\ bdHas mA vA vA gL aL bL cL eL) -> bcCertF gM aM bM cM eM -> E. m E. v (bcJust m v /\ bdHas m v v gK aK bK cK eK /\ bdHas m v v gL aL bL cL eL /\ bdHas m v v gM aM bM cM eM) $;
theorem bcCC_3 (gK aK bK cK eK gL aL bL cL eL gM aM bM cM eM gN aN bN cN eN: nat) {mA vA m v: nat}: $ E. mA E. vA (bcJust mA vA /\ bdHas mA vA vA gK aK bK cK eK /\ bdHas mA vA vA gL aL bL cL eL /\ bdHas mA vA vA gM aM bM cM eM) -> bcCertF gN aN bN cN eN -> E. m E. v (bcJust m v /\ bdHas m v v gK aK bK cK eK /\ bdHas m v v gL aL bL cL eL /\ bdHas m v v gM aM bM cM eM /\ bdHas m v v gN aN bN cN eN) $;
theorem bcCC_4 (gK aK bK cK eK gL aL bL cL eL gM aM bM cM eM gN aN bN cN eN gP aP bP cP eP: nat) {mA vA m v: nat}: $ E. mA E. vA (bcJust mA vA /\ bdHas mA vA vA gK aK bK cK eK /\ bdHas mA vA vA gL aL bL cL eL /\ bdHas mA vA vA gM aM bM cM eM /\ bdHas mA vA vA gN aN bN cN eN) -> bcCertF gP aP bP cP eP -> E. m E. v (bcJust m v /\ bdHas m v v gK aK bK cK eK /\ bdHas m v v gL aL bL cL eL /\ bdHas m v v gM aM bM cM eM /\ bdHas m v v gN aN bN cN eN /\ bdHas m v v gP aP bP cP eP) $;
theorem bcCC_5 (gK aK bK cK eK gL aL bL cL eL gM aM bM cM eM gN aN bN cN eN gP aP bP cP eP gQ aQ bQ cQ eQ: nat) {mA vA m v: nat}: $ E. mA E. vA (bcJust mA vA /\ bdHas mA vA vA gK aK bK cK eK /\ bdHas mA vA vA gL aL bL cL eL /\ bdHas mA vA vA gM aM bM cM eM /\ bdHas mA vA vA gN aN bN cN eN /\ bdHas mA vA vA gP aP bP cP eP) -> bcCertF gQ aQ bQ cQ eQ -> E. m E. v (bcJust m v /\ bdHas m v v gK aK bK cK eK /\ bdHas m v v gL aL bL cL eL /\ bdHas m v v gM aM bM cM eM /\ bdHas m v v gN aN bN cN eN /\ bdHas m v v gP aP bP cP eP /\ bdHas m v v gQ aQ bQ cQ eQ) $;
theorem bcCStep_0 (G: wff) (g a b c d: nat) {m v: nat} (h: $ G -> A. m A. v (bcJust m v -> bcRule m v v g a b c d) $): $ G -> bcCertF g a b c d $;
theorem bcCStep_1 (G: wff) (gK aK bK cK eK g a b c d: nat) {mA vA m v: nat} (h: $ G -> A. m A. v (bcJust m v -> bdHas m v v gK aK bK cK eK -> bcRule m v v g a b c d) $): $ G -> E. mA E. vA (bcJust mA vA /\ bdHas mA vA vA gK aK bK cK eK) -> bcCertF g a b c d $;
theorem bcCStep_2 (G: wff) (gK aK bK cK eK gL aL bL cL eL g a b c d: nat) {mA vA m v: nat} (h: $ G -> A. m A. v (bcJust m v -> bdHas m v v gK aK bK cK eK -> bdHas m v v gL aL bL cL eL -> bcRule m v v g a b c d) $): $ G -> E. mA E. vA (bcJust mA vA /\ bdHas mA vA vA gK aK bK cK eK /\ bdHas mA vA vA gL aL bL cL eL) -> bcCertF g a b c d $;
theorem bcCStep_3 (G: wff) (gK aK bK cK eK gL aL bL cL eL gM aM bM cM eM g a b c d: nat) {mA vA m v: nat} (h: $ G -> A. m A. v (bcJust m v -> bdHas m v v gK aK bK cK eK -> bdHas m v v gL aL bL cL eL -> bdHas m v v gM aM bM cM eM -> bcRule m v v g a b c d) $): $ G -> E. mA E. vA (bcJust mA vA /\ bdHas mA vA vA gK aK bK cK eK /\ bdHas mA vA vA gL aL bL cL eL /\ bdHas mA vA vA gM aM bM cM eM) -> bcCertF g a b c d $;
theorem bcCStep_4 (G: wff) (gK aK bK cK eK gL aL bL cL eL gM aM bM cM eM gN aN bN cN eN g a b c d: nat) {mA vA m v: nat} (h: $ G -> A. m A. v (bcJust m v -> bdHas m v v gK aK bK cK eK -> bdHas m v v gL aL bL cL eL -> bdHas m v v gM aM bM cM eM -> bdHas m v v gN aN bN cN eN -> bcRule m v v g a b c d) $): $ G -> E. mA E. vA (bcJust mA vA /\ bdHas mA vA vA gK aK bK cK eK /\ bdHas mA vA vA gL aL bL cL eL /\ bdHas mA vA vA gM aM bM cM eM /\ bdHas mA vA vA gN aN bN cN eN) -> bcCertF g a b c d $;
theorem bcCStep_5 (G: wff) (gK aK bK cK eK gL aL bL cL eL gM aM bM cM eM gN aN bN cN eN gP aP bP cP eP g a b c d: nat) {mA vA m v: nat} (h: $ G -> A. m A. v (bcJust m v -> bdHas m v v gK aK bK cK eK -> bdHas m v v gL aL bL cL eL -> bdHas m v v gM aM bM cM eM -> bdHas m v v gN aN bN cN eN -> bdHas m v v gP aP bP cP eP -> bcRule m v v g a b c d) $): $ G -> E. mA E. vA (bcJust mA vA /\ bdHas mA vA vA gK aK bK cK eK /\ bdHas mA vA vA gL aL bL cL eL /\ bdHas mA vA vA gM aM bM cM eM /\ bdHas mA vA vA gN aN bN cN eN /\ bdHas mA vA vA gP aP bP cP eP) -> bcCertF g a b c d $;
theorem bcCStep_6 (G: wff) (gK aK bK cK eK gL aL bL cL eL gM aM bM cM eM gN aN bN cN eN gP aP bP cP eP gQ aQ bQ cQ eQ g a b c d: nat) {mA vA m v: nat} (h: $ G -> A. m A. v (bcJust m v -> bdHas m v v gK aK bK cK eK -> bdHas m v v gL aL bL cL eL -> bdHas m v v gM aM bM cM eM -> bdHas m v v gN aN bN cN eN -> bdHas m v v gP aP bP cP eP -> bdHas m v v gQ aQ bQ cQ eQ -> bcRule m v v g a b c d) $): $ G -> E. mA E. vA (bcJust mA vA /\ bdHas mA vA vA gK aK bK cK eK /\ bdHas mA vA vA gL aL bL cL eL /\ bdHas mA vA vA gM aM bM cM eM /\ bdHas mA vA vA gN aN bN cN eN /\ bdHas mA vA vA gP aP bP cP eP /\ bdHas mA vA vA gQ aQ bQ cQ eQ) -> bcCertF g a b c d $;
