import "k215_calculus_source_cycle_bridge.mm0";
import "k215_assembly_bb_explosion.mm0";

-- L10 assembly at the source-program level (no literal-runtime import).
-- Proved link used: k215PInitialHalts <-> k215Inconsistent (cycle bridge).
-- The K-to-ZFC direction is the open refutation transfer
--   k215Inconsistent -> zfcInconsistent,
-- which L01 is to obtain as M3L applied to G2L (lanes/L01.md, Assignment 4).
-- It appears only as an explicit antecedent below.

theorem k215AssemblyProgram_halts_ZFC_given_transfer:
 $ (k215Inconsistent -> zfcInconsistent) -> k215PInitialHalts -> zfcInconsistent $;

theorem k215AssemblyProgram_consistent_nonhalting_given_transfer:
 $ (k215Inconsistent -> zfcInconsistent) -> ~zfcInconsistent -> ~k215PInitialHalts $;

theorem k215AssemblyProgram_BB_nonhalting_given_transfer {b: nat}:
 $ (k215Inconsistent -> zfcInconsistent) ->
   (A. b ~zfcProvable (bb215ArithmeticSentenceSource b)) -> ~k215PInitialHalts $;
