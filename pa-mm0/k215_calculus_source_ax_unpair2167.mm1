@_ def k215UnpairAt2167State (pc a b n c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) n (k215PR3 c) (k215PR4 c) (k215PR5 c) a b (k215PR8 c)) $;

do (apply (register-eqd 'k215UnpairAt2167State) '(k215UnpairAt2167Stateeqd));

theorem k215UnpairAt2167Transfer (b n c: nat): $ k215PIter (3 * b + 1) (k215UnpairAt2167State k215PNum2171 0 b n c) = (k215UnpairAt2167State k215PNum2174 b 0 n c) $ =
 '(eqtr k215Loop2171Vector (k215PStateeq2 (k215PVectoreq7 add0)));
theorem k215UnpairAt2167ReachTransfer (b n c: nat): $ k215PReach (k215UnpairAt2167State k215PNum2171 0 b n c) (k215UnpairAt2167State k215PNum2174 b 0 n c) $ =
 '(k215PReach_intro k215UnpairAt2167Transfer);


theorem k215UnpairAt2167Step9Z (a b c: nat): $ k215PStep (k215UnpairAt2167State k215PNum2167 a b 0 c) = (k215UnpairAt2167State k215PNum2175 a b 0 c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair2167_2167) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt2167Reach9Z (a b c: nat): $ k215PReach (k215UnpairAt2167State k215PNum2167 a b 0 c) (k215UnpairAt2167State k215PNum2175 a b 0 c) $ = '(k215PReach_step k215UnpairAt2167Step9Z);

theorem k215UnpairAt2167Step9S (a b n c: nat): $ k215PStep (k215UnpairAt2167State k215PNum2167 a b (suc n) c) = (k215UnpairAt2167State k215PNum2168 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair2167_2167) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet2_vector)) (eqtr k215PSet2_vector (k215PVectoreq3 (eqtr subSS sub02))))));

theorem k215UnpairAt2167Reach9S (a b n c: nat): $ k215PReach (k215UnpairAt2167State k215PNum2167 a b (suc n) c) (k215UnpairAt2167State k215PNum2168 a b n c) $ = '(k215PReach_step k215UnpairAt2167Step9S);

theorem k215UnpairAt2167Step10 (a b n c: nat): $ k215PStep (k215UnpairAt2167State k215PNum2168 a b n c) = (k215UnpairAt2167State k215PNum2169 a (suc b) n c) $ = '(eqtr (k215PAtCI k215PLookupUnpair2167_2168) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215UnpairAt2167Reach10 (a b n c: nat): $ k215PReach (k215UnpairAt2167State k215PNum2168 a b n c) (k215UnpairAt2167State k215PNum2169 a (suc b) n c) $ = '(k215PReach_step k215UnpairAt2167Step10);

theorem k215UnpairAt2167Step11Z (b n c: nat): $ k215PStep (k215UnpairAt2167State k215PNum2169 0 b n c) = (k215UnpairAt2167State k215PNum2171 0 b n c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair2167_2169) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt2167Reach11Z (b n c: nat): $ k215PReach (k215UnpairAt2167State k215PNum2169 0 b n c) (k215UnpairAt2167State k215PNum2171 0 b n c) $ = '(k215PReach_step k215UnpairAt2167Step11Z);

theorem k215UnpairAt2167Step11S (a b n c: nat): $ k215PStep (k215UnpairAt2167State k215PNum2169 (suc a) b n c) = (k215UnpairAt2167State k215PNum2170 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair2167_2169) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215UnpairAt2167Reach11S (a b n c: nat): $ k215PReach (k215UnpairAt2167State k215PNum2169 (suc a) b n c) (k215UnpairAt2167State k215PNum2170 a b n c) $ = '(k215PReach_step k215UnpairAt2167Step11S);

theorem k215UnpairAt2167Step12 (a b n c: nat): $ k215PStep (k215UnpairAt2167State k215PNum2170 a b n c) = (k215UnpairAt2167State k215PNum2174 a b n c) $ = '(k215PAtCB k215PLookupUnpair2167_2170);

theorem k215UnpairAt2167Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt2167State k215PNum2170 a b n c) (k215UnpairAt2167State k215PNum2174 a b n c) $ = '(k215PReach_step k215UnpairAt2167Step12);

theorem k215UnpairAt2167Step16 (a b n c: nat): $ k215PStep (k215UnpairAt2167State k215PNum2174 a b n c) = (k215UnpairAt2167State k215PNum2167 a b n c) $ = '(k215PAtCC k215PLookupUnpair2167_2174);

theorem k215UnpairAt2167Reach16 (a b n c: nat): $ k215PReach (k215UnpairAt2167State k215PNum2174 a b n c) (k215UnpairAt2167State k215PNum2167 a b n c) $ = '(k215PReach_step k215UnpairAt2167Step16);

theorem k215UnpairAt2167CycleZero (b n c: nat): $ k215PReach (k215UnpairAt2167State k215PNum2167 0 b (suc n) c) (k215UnpairAt2167State k215PNum2167 (suc b) 0 n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt2167Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2167Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2167Reach11Z) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2167ReachTransfer) k215UnpairAt2167Reach16))));
theorem k215UnpairAt2167CycleSucc (a b n c: nat): $ k215PReach (k215UnpairAt2167State k215PNum2167 (suc a) b (suc n) c) (k215UnpairAt2167State k215PNum2167 a (suc b) n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt2167Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2167Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2167Reach11S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2167Reach12) k215UnpairAt2167Reach16))));


theorem k215UnpairAt2167AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt2167State k215PNum2167 0 b (suc n) c) (k215UnpairAt2167State k215PNum2167 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt2167Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215PairDiagonal_rotate)) (eqtr (eqcom sndpr) (sndeq k215PairDiagonal_rotate)) eqid eqid)) k215UnpairAt2167CycleZero);

theorem k215UnpairAt2167AdvanceSucc (a b n c: nat): $ k215PReach (k215UnpairAt2167State k215PNum2167 (suc a) b (suc n) c) (k215UnpairAt2167State k215PNum2167 (fst (suc ((suc a), b))) (snd (suc ((suc a), b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt2167Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215Pair_next)) (eqtr (eqcom sndpr) (sndeq k215Pair_next)) eqid eqid)) k215UnpairAt2167CycleSucc);

pub theorem k215UnpairAt2167Advance (a b n c: nat): $ k215PReach (k215UnpairAt2167State k215PNum2167 a b (suc n) c) (k215UnpairAt2167State k215PNum2167 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
 (named @ induct '(ind) 'a 'k215UnpairAt2167AdvanceZero '(a1i k215UnpairAt2167AdvanceSucc));
@_ abstract def k215UnpairAt2167Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt2167State k215PNum2167 a b n c) (k215UnpairAt2167State k215PNum2175 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
theorem k215UnpairAt2167RunZero (a b c: nat): $ k215UnpairAt2167Run 0 a b c $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt2167Stateeq eqid
     (eqcom (eqtr (fsteq add0) fstpr))
     (eqcom (eqtr (sndeq add0) sndpr)) eqid eqid)) k215UnpairAt2167Reach9Z);
@_ abstract def k215UnpairAt2167Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt2167Run n a b c $;
theorem k215UnpairAt2167Claim_at (n a b c: nat): $ k215UnpairAt2167Claim n c -> k215UnpairAt2167Run n a b c $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215UnpairAt2167CodeStep (a b n: nat): $ (fst (suc (a, b)), snd (suc (a, b))) + n = (a, b) + suc n $ =
 '(eqtr (addeq1 fstsnd) addSass);
theorem k215UnpairAt2167RunInductive (n a b c: nat): $ k215UnpairAt2167Claim n c -> k215UnpairAt2167Run (suc n) a b c $ =
 '(syl (ax_mp k215PReach_trans k215UnpairAt2167Advance)
   (mpbid (a1i (k215PReacheq2 (k215UnpairAt2167Stateeq eqid
     (fsteq k215UnpairAt2167CodeStep) (sndeq k215UnpairAt2167CodeStep) eqid eqid))) k215UnpairAt2167Claim_at));
theorem k215UnpairAt2167Claim_all (n c: nat): $ k215UnpairAt2167Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt2167RunZero)) '(iald @ iald k215UnpairAt2167RunInductive));
pub theorem k215UnpairMacro2167 (n a b c: nat): $ k215PReach (k215UnpairAt2167State k215PNum2167 a b n c) (k215UnpairAt2167State k215PNum2175 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
 '(ax_mp k215UnpairAt2167Claim_at k215UnpairAt2167Claim_all);
pub theorem k215UnpairMacro2167_clean (n c: nat): $ k215PReach (k215UnpairAt2167State k215PNum2167 0 0 n c) (k215UnpairAt2167State k215PNum2175 (fst n) (snd n) 0 c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt2167Stateeq eqid
   (fsteq (eqtr (addeq1 pr0) add01))
   (sndeq (eqtr (addeq1 pr0) add01)) eqid eqid)) k215UnpairMacro2167);


