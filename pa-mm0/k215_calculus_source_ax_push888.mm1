import "k215_calculus_source_ax_pair894.mm1";
import "k215_calculus_source_ax_stack_loops.mm1";

theorem k215PairVectorInAt888 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt894State k215PNum894 a6 a1 a7 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum894 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215PairVectorOutAt888 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt894State k215PNum904 0 0 (a7 + (a6, a1)) (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum904 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

pub theorem k215PairMacro46_vectorAt888 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat):
 $ k215PReach (k215PState k215PNum894 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215PNum904 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ =
 '(mpbi (k215PReacheq k215PairVectorInAt888 k215PairVectorOutAt888) k215PairMacro894);

theorem k215PushAStage0At888 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum888 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum891 (k215PVector u 0 w c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop888Vector (k215PStateeq2 (k215PVectoreq7 add0))));

theorem k215PushAStage1At888 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum891 (k215PVector u 0 w c a b t 0 v)) (k215PState k215PNum894 (k215PVector u w 0 c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop891Vector (k215PStateeq2 (k215PVectoreq2 add0))));

theorem k215PushAStage2At888 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum894 (k215PVector u w 0 c a b t 0 v)) (k215PState k215PNum904 (k215PVector u 0 0 c a b 0 (t, w) v)) $ = '(mpbi (k215PReacheq2 (k215PStateeq2 (k215PVectoreq8 add01))) k215PairMacro46_vectorAt888);

theorem k215PushAStage3At888 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum904 (k215PVector u 0 0 c a b 0 (t, w) v)) (k215PState k215PNum907 (k215PVector u 0 (t, w) c a b 0 0 v)) $ = '(k215PReach_intro (eqtr k215Loop904Vector (k215PStateeq2 (k215PVectoreq3 add0))));

theorem k215PushAStage4At888 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum907 (k215PVector u 0 (t, w) c a b 0 0 v)) (k215PState k215PNum911 (k215PVector u a (t, w) c 0 b a 0 v)) $ = '(k215PReach_intro (eqtr k215Loop907Vector (k215PStateeq2 (k215PVectoreq eqid add0 eqid eqid eqid eqid add0 eqid eqid))));

theorem k215PushAStage5At888 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum911 (k215PVector u a (t, w) c 0 b a 0 v)) (k215PState k215PNum914 (k215PVector u a (t, w) c a b 0 0 v)) $ = '(k215PReach_intro (eqtr k215Loop911Vector (k215PStateeq2 (k215PVectoreq5 add0))));

pub theorem k215PushParam888 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum888 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum914 (k215PVector u a (t, w) c a b 0 0 v)) $ = '(ax_mp (ax_mp k215PReach_trans k215PushAStage0At888) (ax_mp (ax_mp k215PReach_trans k215PushAStage1At888) (ax_mp (ax_mp k215PReach_trans k215PushAStage2At888) (ax_mp (ax_mp k215PReach_trans k215PushAStage3At888) (ax_mp (ax_mp k215PReach_trans k215PushAStage4At888) k215PushAStage5At888)))));

