import "b4b_mvschema.mm0";

theorem g2join {m v m1 v1 m2 v2 kk: nat} (P: wff m1 v1) (Q: wff m2 v2) (P2 Q2: wff m v)
  (h1: $ E. m1 E. v1 (bcJust m1 v1 /\ P) $) (h2: $ E. m2 E. v2 (bcJust m2 v2 /\ Q) $)
  (l1: $ A. kk (bdCell m1 v1 kk -> bdCell m v kk) -> P -> P2 $)
  (l2: $ A. kk (bdCell m2 v2 kk -> bdCell m v kk) -> Q -> Q2 $):
  $ E. m E. v (bcJust m v /\ (P2 /\ Q2)) $;
theorem g2certfin {m v: nat} (X Y: wff m v)
  (h: $ E. m E. v (bcJust m v /\ X) $) (i: $ bcJust m v /\ X -> Y $):
  $ E. m E. v (bcJust m v /\ Y) $;
theorem bcNumK215_sound (m v z c d: nat):
  $ bcJust m v -> bdHas m v v bctNum (bdNum 2 1 5) z c d -> z = paTermNumeral k215Num215 $;
theorem bcNumK215_cert {m v: nat}:
  $ E. m E. v (bcJust m v /\ bdHas m v v bctNum (bdNum 2 1 5) (paTermNumeral k215Num215) 0 0) $;
