import "k215_calculus_source_ax_gen.mm0";
import "k215_calculus_source_ax_stack.mm0";
import "k215_calculus_source_ax_gate.mm0";
import "k215_calculus_source_commands.mm0";

theorem k215AXFrom26 (u t w c d h fields: nat):
 $ k215PReach (k215PState k215Num26 (k215PVector u t w c d h 0 0 fields))
   (k215PState 0 (k215PVector u
      (k218Gate (d + fst (snd fields)) (h + fst fields) c)
      (k215AxStack (d + fst (snd fields)) h (h + fst fields) c d t w)
      0 0 0 0 0 (snd (snd fields)))) $;

theorem k215AXSourceInterval (u t w c d h fields: nat):
 $ k215PReach
   (k215PState k215Num23 (k215PVector u t w (suc (suc (suc c))) d h 0 0 fields))
   (k215PState 0 (k215PVector u
      (k218Gate (d + fst (snd fields)) (h + fst fields) c)
      (k215AxStack (d + fst (snd fields)) h (h + fst fields) c d t w)
      0 0 0 0 0 (snd (snd fields)))) $;

theorem k215PCommandAX (s c fields next: nat):
 $ k215PCommandResult (k215PCommandInput s (suc (suc (suc c))) fields next)
     (k215EnumCommand s (suc (suc (suc c))) fields next) $;
