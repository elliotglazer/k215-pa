-- Dominated-rho8 K215 calculus. Shared arithmetic codes only; no K218 provability import.
import "k218_codes.mm0";

-- The numeric axiom family of Thm222.v, with no formula-class parameter.
def k215AxBody (n a b c u: nat): wff =
$ n = kRho1 a b \/ (n = kRho2 a b c \/ (n = kRho3 a b c \/
 (n = kRho4 a b c \/ (n = kRho5 a b c \/ (n = kRho6 a b \/
 (n = k218RhoG a b c \/ ((u <= a /\ n = kRho8 a b c u) \/
 (c != a /\ c != b /\ n = k218Bundle a b c)))))))) $;

def k215Axioms (.n .a .b .c .u: nat): set =
$ {n | n = 0 \/ E. a E. b E. c E. u k215AxBody n a b c u} $;

theorem k215Axioms_value {a b c u: nat} (n: nat):
  $ n e. k215Axioms <-> n = 0 \/ E. a E. b E. c E. u k215AxBody n a b c u $;
theorem k215Axioms_true: $ 0 e. k215Axioms $;
theorem k215Axioms_instance (n a b c u: nat):
  $ k215AxBody n a b c u -> n e. k215Axioms $;
theorem k215Axioms_rho1 (a b: nat): $ kRho1 a b e. k215Axioms $;
theorem k215Axioms_rho2 (a b c: nat): $ kRho2 a b c e. k215Axioms $;
theorem k215Axioms_rho3 (a b c: nat): $ kRho3 a b c e. k215Axioms $;
theorem k215Axioms_rho4 (a b c: nat): $ kRho4 a b c e. k215Axioms $;
theorem k215Axioms_rho5 (a b c: nat): $ kRho5 a b c e. k215Axioms $;
theorem k215Axioms_rho6 (a b: nat): $ kRho6 a b e. k215Axioms $;
theorem k215Axioms_G (a b c: nat): $ k218RhoG a b c e. k215Axioms $;
theorem k215Axioms_rho8_dominated (a b c u: nat): $ u <= a -> kRho8 a b c u e. k215Axioms $;

theorem k215Axioms_bundle (a b c: nat): $ c != a /\ c != b -> k218Bundle a b c e. k215Axioms $;
