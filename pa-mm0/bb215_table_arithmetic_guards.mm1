pub theorem bb215TableArithmeticWorkingCode_bound: $ paFormulaBound 1 bb215TableArithmeticWorkingCode $ = (named '(mpbir paFormulaBound_ex (mpbir paFormulaBound_equal (ian (mpbir paTermBound_addition (ian (mpbir paTermBound_variable ltsucid) (mpbir paTermBound_successor (mpbir paTermBound_variable lt01S)))) paNatTermNumeral_bound))));

pub theorem bb215TableArithmeticWorkingBody_satisfies (E: set): $ bb215ArithmeticFormulaQFSat E bb215TableArithmeticWorkingBody <-> bb215TableArithmeticWorkingMatrix (E @ 1) (E @ 0) $ = (named '(bitr bb215ArithmeticFormulaQFSat_equal (eqeq (eqtr bb215ArithmeticFormulaTermValue_addition (addeq bb215ArithmeticFormulaTermValue_variable (eqtr bb215ArithmeticFormulaTermValue_successor (suceq bb215ArithmeticFormulaTermValue_variable)))) paNatTermValue_numeral)));

pub theorem bb215TableArithmeticWorkingBody_instance (E: set) (h: nat): $ bb215ArithmeticFormulaQFSat (paNatTermConsEnvironment E h) bb215TableArithmeticWorkingBody <-> bb215TableArithmeticWorkingMatrix (E @ 0) h $ = (named '(bitr bb215TableArithmeticWorkingBody_satisfies (bb215TableArithmeticWorkingMatrixeq paNatTermConsEnvironment_suc paNatTermConsEnvironment_zero)));

pub theorem bb215TableArithmeticWorkingCode_represents (E: set) {h: nat}: $ bb215ArithmeticFormulaDepthOneSat E bb215TableArithmeticWorkingCode <-> (E @ 0) < k215Num215 $ = (named '(bitr bb215ArithmeticFormulaDepthOneSat_ex (bitr (!! exeqi h bb215TableArithmeticWorkingBody_instance) bb215TableArithmeticWorkingGraph_correct)));

pub theorem bb215TableArithmeticWorkingSource_exact: $ paFormulaSource bb215TableArithmeticWorkingCode = bb215TableArithmeticWorkingSource $ = (named '(eqtr paFormulaSource_ex (paSourceFormulaExeq (eqtr paFormulaSource_equal (paSourceFormulaEqualeq (eqtr paTermSource_addition (paSourceTermAdditioneq paTermSource_variable (eqtr paTermSource_successor (paSourceTermSuccessoreq paTermSource_variable)))) paTermNumeral_source_graph)))));

pub theorem bb215TableArithmeticWorkingSource_bound: $ sfBound 1 bb215TableArithmeticWorkingSource $ = (named '(mpbi (sfBoundeq2 bb215TableArithmeticWorkingSource_exact) (paFormulaSource_bound bb215TableArithmeticWorkingCode_bound)));

