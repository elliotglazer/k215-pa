@_ abstract def bb215TableArithmeticWorkingGraph (q .h: nat): wff = $ E. h q + suc h = k215Num215 $;

pub theorem bb215TableArithmeticWorkingGraph_correct (q: nat) {h: nat}: $ bb215TableArithmeticWorkingGraph q <-> q < k215Num215 $ = (named '(bicom (bitr dfle (!! exeqi h (eqeq1 addSass)))));

@_ abstract def bb215TableArithmeticWorkingMatrix (q h: nat): wff = $ q + suc h = k215Num215 $;

@_ abstract def bb215TableArithmeticWorkingBody: nat = $ paFormulaEqual (paTermAddition (paTermVariable 1) (paTermSuccessor (paTermVariable 0))) (paTermNumeral k215Num215) $;

@_ abstract def bb215TableArithmeticWorkingCode: nat = $ paFormulaEx bb215TableArithmeticWorkingBody $;

