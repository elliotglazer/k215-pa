pub theorem bb215TableArithmeticBinaryCode_represents (E: set): $ bb215ArithmeticFormulaQFSat E bb215TableArithmeticBinaryCode <-> (E @ 0) < 2 $ = (named '(bitr (bitr bb215ArithmeticFormulaQFSat_or (oreqi (bitr bb215ArithmeticFormulaQFSat_equal (eqeq bb215ArithmeticFormulaTermValue_variable bb215ArithmeticFormulaTermValue_zero)) (bitr bb215ArithmeticFormulaQFSat_equal (eqeq bb215ArithmeticFormulaTermValue_variable (eqtr bb215ArithmeticFormulaTermValue_successor (suceq bb215ArithmeticFormulaTermValue_zero)))))) (bicom bool01)));

pub theorem bb215TableArithmeticBinarySource_exact: $ paFormulaSource bb215TableArithmeticBinaryCode = bb215TableArithmeticBinarySource $ = (named '(eqtr paFormulaSource_or (sfOreq (eqtr paFormulaSource_equal (paSourceFormulaEqualeq paTermSource_variable paTermSource_zero)) (eqtr paFormulaSource_equal (paSourceFormulaEqualeq paTermSource_variable (eqtr paTermSource_successor (paSourceTermSuccessoreq paTermSource_zero)))))));

