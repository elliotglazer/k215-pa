theorem k215PairMacro46_vectorAt346 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat):
 $ k215PReach (k215PState k215PNum352 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215PNum362 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $;

theorem k215PushParam346 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum346 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum372 (k215PVector u b (t, w) c a b 0 0 v)) $;
