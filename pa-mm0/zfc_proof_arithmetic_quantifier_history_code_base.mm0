theorem zfcProofArithmeticQuantifierHistoryCodeSubstGraph_packed (t d f v: nat) {m c A: nat}: $ zfcProofArithmeticQuantifierHistoryCodeSubstGraph t d f v <-> zfcProofArithmeticQuantifierSubstGraph t d f v $;

