def zfcProofArithmeticQuantifierHistoryCodeSubstLocal (t m c K: nat): wff = $ zfcProofArithmeticQuantifierHistoryCodeSubstRow_zero t m c K /\ zfcProofArithmeticQuantifierHistoryCodeSubstRow_mem t m c K /\ zfcProofArithmeticQuantifierHistoryCodeSubstRow_eq t m c K /\ zfcProofArithmeticQuantifierHistoryCodeSubstRow_and t m c K /\ zfcProofArithmeticQuantifierHistoryCodeSubstRow_or t m c K /\ zfcProofArithmeticQuantifierHistoryCodeSubstRow_imp t m c K /\ zfcProofArithmeticQuantifierHistoryCodeSubstRow_all t m c K /\ zfcProofArithmeticQuantifierHistoryCodeSubstRow_ex t m c K /\ zfcProofArithmeticQuantifierHistoryCodeSubstRow_bad6 t m c K /\ zfcProofArithmeticQuantifierHistoryCodeSubstRow_bad7 t m c K $;

