def zfcProofArithmeticQuantifierHistoryCodeSubstFinal (t m c K v .y: nat): wff = $ zfcProofArithmeticQuantifierHistoryCodeSubstLocal t m c K /\ A. y (bb215ArithmeticFormulaHistoryPairGraph m c K y -> y = v) $;

