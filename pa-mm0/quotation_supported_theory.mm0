import "quotation_supported_transport.mm0";
import "quotation_supported_contexts.mm0";
import "quotation_bootstrap.mm0";
import "source_theory.mm0";
import "quotation_supported_trace.mm0";

-- The remaining mathematical obligation is explicit: actual K proofs of
-- the fixed-base quotient images of the source theory's axioms.
def sqTheoryImageClass (.a: nat): set =
 $ {a | kHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 a)} $;

def sqTheoryImages (A: set): wff = $ A C_ sqTheoryImageClass $;

theorem sqTheoryImageClass_value (a: nat):
 $ a e. sqTheoryImageClass <->
   kHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 a) $;

theorem sqTheoryImages_member (A: set) (a: nat):
 $ sqTheoryImages A -> a e. A ->
   kHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 a) $;

theorem sqTheoryImages_source_support (A: set) (G S: nat):
 $ sqTheoryImages A -> sfTheoryClosed A -> sfTheoryContext A G ->
   sqSourceSupport kQuotientContext S 1 4 G $;

theorem sqTheoryImages_refutation_at (A: set) (G n: nat):
 $ sqTheoryImages A -> sfTheoryClosed A -> sfTheoryContext A G ->
   sqSupportedAt n (sfSequent G sfBot) -> kProvable kF $;

theorem sqTheoryImages_refutation_good (A: set) (G: nat):
 $ sqTheoryImages A -> sfTheoryClosed A -> sfTheoryContext A G ->
   sqSupportedGood (sfSequent G sfBot) -> kProvable kF $;

theorem sqTheoryImages_refutation_trace (A: set) (G p: nat):
 $ sqTheoryImages A -> sfTheoryClosed A -> sfTheoryContext A G ->
   sfNDFullDerives p (sfSequent G sfBot) -> kProvable kF $;

theorem sqTheoryImages_refutation (A: set):
 $ sqTheoryImages A -> sfTheoryClosed A -> sfTheoryProvable A sfBot -> kProvable kF $;
