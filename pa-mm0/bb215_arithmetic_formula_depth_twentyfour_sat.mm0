def bb215ArithmeticFormulaDepthTwentyfourSatBody (E: set) (c h .x: nat): wff = $ ifp (c = 0) (0 != 0) (ifp (sfTag c = 1) (bb215ArithmeticFormulaTermValue E (sfLeft c) = bb215ArithmeticFormulaTermValue E (sfRight c)) (ifp (sfTag c = 3) (sfLeft c e. h /\ sfRight c e. h) (ifp (sfTag c = 4) (sfLeft c e. h \/ sfRight c e. h) (ifp (sfTag c = 5) (sfLeft c e. h -> sfRight c e. h) (ifp (sfTag c = 6 /\ sfRight c = 0) (A. x bb215ArithmeticFormulaDepthTwentythreeSat (paNatTermConsEnvironment E x) (sfLeft c)) (ifp (sfTag c = 7 /\ sfRight c = 0) (E. x bb215ArithmeticFormulaDepthTwentythreeSat (paNatTermConsEnvironment E x) (sfLeft c)) (0 != 0))))))) $;

def bb215ArithmeticFormulaDepthTwentyfourSatStep (E: set) (.c .h: nat): set = $ S\ c, {h | bb215ArithmeticFormulaDepthTwentyfourSatBody E c h} $;

def bb215ArithmeticFormulaDepthTwentyfourSat (E: set) (c: nat): wff = $ srecp (bb215ArithmeticFormulaDepthTwentyfourSatStep E) c $;

def bb215ArithmeticFormulaDepthTwentyfourSatPrevious (E: set) (c .i: nat): nat = $ sep (upto c) {i | srecp (bb215ArithmeticFormulaDepthTwentyfourSatStep E) i} $;

theorem bb215ArithmeticFormulaDepthTwentyfourSatStep_value (E: set) (c h: nat): $ (c, h) e. bb215ArithmeticFormulaDepthTwentyfourSatStep E <-> bb215ArithmeticFormulaDepthTwentyfourSatBody E c h $;

theorem bb215ArithmeticFormulaDepthTwentyfourSatPrevious_value (E: set) (c a: nat): $ a e. bb215ArithmeticFormulaDepthTwentyfourSatPrevious E c <-> a < c /\ bb215ArithmeticFormulaDepthTwentyfourSat E a $;

theorem bb215ArithmeticFormulaDepthTwentyfourSat_unfold (E: set) (c: nat): $ bb215ArithmeticFormulaDepthTwentyfourSat E c <-> bb215ArithmeticFormulaDepthTwentyfourSatBody E c (bb215ArithmeticFormulaDepthTwentyfourSatPrevious E c) $;

theorem bb215ArithmeticFormulaDepthTwentyfourSat_false (E: set): $ bb215ArithmeticFormulaDepthTwentyfourSat E paFormulaFalse <-> 0 != 0 $;

theorem bb215ArithmeticFormulaDepthTwentyfourSat_equal (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthTwentyfourSat E (paFormulaEqual a b) <-> bb215ArithmeticFormulaTermValue E a = bb215ArithmeticFormulaTermValue E b $;

theorem bb215ArithmeticFormulaDepthTwentyfourSat_and (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthTwentyfourSat E (paFormulaAnd a b) <-> (bb215ArithmeticFormulaDepthTwentyfourSat E a /\ bb215ArithmeticFormulaDepthTwentyfourSat E b) $;

theorem bb215ArithmeticFormulaDepthTwentyfourSat_or (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthTwentyfourSat E (paFormulaOr a b) <-> (bb215ArithmeticFormulaDepthTwentyfourSat E a \/ bb215ArithmeticFormulaDepthTwentyfourSat E b) $;

theorem bb215ArithmeticFormulaDepthTwentyfourSat_imp (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthTwentyfourSat E (paFormulaImp a b) <-> (bb215ArithmeticFormulaDepthTwentyfourSat E a -> bb215ArithmeticFormulaDepthTwentyfourSat E b) $;

theorem bb215ArithmeticFormulaDepthTwentyfourSat_all (E: set) (a: nat) {x: nat}: $ bb215ArithmeticFormulaDepthTwentyfourSat E (paFormulaAll a) <-> A. x bb215ArithmeticFormulaDepthTwentythreeSat (paNatTermConsEnvironment E x) a $;

theorem bb215ArithmeticFormulaDepthTwentyfourSat_ex (E: set) (a: nat) {x: nat}: $ bb215ArithmeticFormulaDepthTwentyfourSat E (paFormulaEx a) <-> E. x bb215ArithmeticFormulaDepthTwentythreeSat (paNatTermConsEnvironment E x) a $;
