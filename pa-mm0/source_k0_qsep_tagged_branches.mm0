import "source_k0_qsep_matrix_alignment.mm0";

import "k218q_equality.mm0";

import "k218q_quantifier_macros.mm0";

import "k218q_bound_vacuity.mm0";

theorem sfK0QSepTagged_root_exists (E: set) (r t b c y k theta: nat) (hf: $ sfWf theta $) (hyr: $ y != r $) (hyt: $ y != t $) (hyb: $ y != b $) (hyc: $ y != c $):
 $ k218QProvable (kImp (kImp (kEq r t) kF) (kImp (kAll y (kNot (sfK0QSepNamedSingleton y r k))) (kImp (kExists y (kAnd (kMem y c) (sfK0QSepNamedTagged E r t b r y k theta))) (kMem b c)))) $;

theorem sfK0QSepTagged_marker_exists (E: set) (r t b c y k theta: nat) (hf: $ sfWf theta $) (hyr: $ y != r $) (hyt: $ y != t $) (hyb: $ y != b $) (hyc: $ y != c $):
 $ k218QProvable (kImp (kImp (kEq t r) kF) (kImp (kAll y (kNot (kMem y t))) (kImp (kExists y (kAnd (kMem y c) (sfK0QSepNamedTagged E r t b t y k theta))) (kMem t c)))) $;
