import "source_l_common_level_setrel.mm0";

import "source_structural_induction.mm0";

import "source_syntax_laws.mm0";

def sfCLSetRelBoundClass (.c .n .d: nat): set = $ {c | A. n A. d (sfBound n c -> d < n -> sfBound n (sfCLSetRel d c))} $;

theorem sfCLSetRel_bound (d n c: nat): $ sfBound n c -> d < n -> sfBound n (sfCLSetRel d c) $;

theorem sfCLSetRel_reflection_bound (count phi: nat) (hp: $ sfBound count phi $): $ sfBound (suc count) (sfCLSetRel count phi) $;
