import "k215_bundle_images_source.mm0";
import "source_zfc_interpretation.mm0";
import "source_l_domain.mm0";
import "source_core_theory.mm0";

-- G2L: ZFC proves every closed K215 bundle axiom (the universal closure sfAllPrefix n of a
-- decoded bundle, see k215BundleClosed) relativized to L; relativizing the closure makes its
-- free variables range over L.
def k215BundleImagesL: wff = $ k215BundleAxioms C_ sfRelativeAxiomClass zfcAxioms sfLDomain $;

-- Every axiom of S = ZFC + bundle closures has a provable L-relativization, given the
-- ZF(C) images in L (G1 form, over ZFR) and G2L.
theorem k215BundleSource_relative_images
 (hz:$ sfZFCImageFamilies zfrAxioms sfLDomain $)
 (hb:$ k215BundleImagesL $):
 $ sfRelativeAxiomImages k215BundleSourceAxioms zfcAxioms sfLDomain $;

-- M3L: the relativized refutation transfer.
theorem k215BundleImagesL_refutation_transfer
 (hz:$ sfZFCImageFamilies zfrAxioms sfLDomain $)
 (hn:$ sfTheoryProvable zfrAxioms (sfEx sfLDomain) $)
 (hb:$ k215BundleImagesL $):
 $ k215Inconsistent -> zfcInconsistent $;
