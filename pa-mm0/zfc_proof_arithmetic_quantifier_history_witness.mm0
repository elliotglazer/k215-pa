import "zfc_proof_arithmetic_quantifier_history_base.mm0";

theorem zfcProofArithmeticQuantifierShiftNode_zero (d a b: nat): $ sfShift (d) (sfNode 0 a b) = 0 $;

theorem zfcProofArithmeticQuantifierShiftNode_bad6 (d a b: nat): $ b != 0 -> sfShift (d) (sfNode 6 a b) = 0 $;

theorem zfcProofArithmeticQuantifierShiftNode_bad7 (d a b: nat): $ b != 0 -> sfShift (d) (sfNode 7 a b) = 0 $;

theorem zfcProofArithmeticQuantifierShiftCharacterization_local (A K: nat): $ zfcProofArithmeticQuantifierShiftCharacterization A K -> zfcProofArithmeticQuantifierShiftLocal A K $;

def zfcProofArithmeticQuantifierShiftCertificate (A d c v: nat) (.y: nat): wff = $ zfcProofArithmeticQuantifierShiftLocal A (d, c) /\ A. y (bb215ArithmeticFormulaHistoryCell A ((d, c)) (y) -> y = v) $;

def zfcProofArithmeticQuantifierShiftGraph (d c v: nat) (.A: nat): wff = $ E. A zfcProofArithmeticQuantifierShiftCertificate A d c v $;

theorem zfcProofArithmeticQuantifierShiftCharacterization_certificate (A d c: nat): $ zfcProofArithmeticQuantifierShiftCharacterization A (d, c) -> zfcProofArithmeticQuantifierShiftCertificate A d c (sfShift (d) (c)) $;

theorem zfcProofArithmeticQuantifierShiftGraph_witness (d c: nat): $ zfcProofArithmeticQuantifierShiftGraph d c (sfShift (d) (c)) $;

theorem zfcProofArithmeticQuantifierSubstNode_zero (t d a b: nat): $ sfSubst (d) t (sfNode 0 a b) = 0 $;

theorem zfcProofArithmeticQuantifierSubstNode_bad6 (t d a b: nat): $ b != 0 -> sfSubst (d) t (sfNode 6 a b) = 0 $;

theorem zfcProofArithmeticQuantifierSubstNode_bad7 (t d a b: nat): $ b != 0 -> sfSubst (d) t (sfNode 7 a b) = 0 $;

theorem zfcProofArithmeticQuantifierSubstCharacterization_local (t A K: nat): $ zfcProofArithmeticQuantifierSubstCharacterization t A K -> zfcProofArithmeticQuantifierSubstLocal t A K $;

def zfcProofArithmeticQuantifierSubstCertificate (t A d c v: nat) (.y: nat): wff = $ zfcProofArithmeticQuantifierSubstLocal t A (d, c) /\ A. y (bb215ArithmeticFormulaHistoryCell A ((d, c)) (y) -> y = v) $;

def zfcProofArithmeticQuantifierSubstGraph (t d c v: nat) (.A: nat): wff = $ E. A zfcProofArithmeticQuantifierSubstCertificate t A d c v $;

theorem zfcProofArithmeticQuantifierSubstCharacterization_certificate (t A d c: nat): $ zfcProofArithmeticQuantifierSubstCharacterization t A (d, c) -> zfcProofArithmeticQuantifierSubstCertificate t A d c (sfSubst (d) t (c)) $;

theorem zfcProofArithmeticQuantifierSubstGraph_witness (t d c: nat): $ zfcProofArithmeticQuantifierSubstGraph t d c (sfSubst (d) t (c)) $;
