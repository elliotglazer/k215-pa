import "quotation_binders.mm1";
import "source_renaming_laws.mm1";

theorem exNamedIndex_below (E R: set) (k d i: nat):
 $ i < d -> sfNamedIndex E k d (sfRenameIndex R d i) =
   sfNamedIndex (sfComposeMap E R) k d i $ =
'(eqtrd (sfNamedIndexeq4d sfRenameIndex_bound) @
 eqtrd sfNamedIndex_bound (eqcomd sfNamedIndex_bound));

theorem exNamedIndex_free (E R: set) (k d i: nat):
 $ ~i < d -> sfNamedIndex E k d (sfRenameIndex R d i) =
   sfNamedIndex (sfComposeMap E R) k d i $ =
'(eqtrd (syl sfNamedIndex_free (syl (bi1 lenlt) sfRL_free_le)) @
 eqtrd (appeq2d (subeq1d sfRenameIndex_free)) @
 eqtrd (a1i (appeq2 pncan2)) @
 eqtrd (a1i (eqcom sfComposeMap_value)) (eqcomd sfNamedIndex_free));

pub theorem exNamedIndex_rename (E R: set) (k d i: nat):
 $ sfNamedIndex E k d (sfRenameIndex R d i) =
   sfNamedIndex (sfComposeMap E R) k d i $ =
'(cases exNamedIndex_below exNamedIndex_free);

@_ abstract def exNamedRenameClass (E R: set) (k .c .d: nat): set =
$ {c | A. d (sfNamedTemplate E k d (sfRename R d c) =
              sfNamedTemplate (sfComposeMap E R) k d c)} $;

pub theorem exNamedRename_value {d: nat} (E R: set) (k c: nat):
 $ c e. exNamedRenameClass E R k <->
   A. d (sfNamedTemplate E k d (sfRename R d c) =
         sfNamedTemplate (sfComposeMap E R) k d c) $ =
(named '(elabe ,eqtac));

theorem exNamedRename_depth (E R: set) (k d c: nat):
 $ A. j (sfNamedTemplate E k j (sfRename R j c) =
         sfNamedTemplate (sfComposeMap E R) k j c) ->
   sfNamedTemplate E k d (sfRename R d c) =
   sfNamedTemplate (sfComposeMap E R) k d c $ =
(named '(!! eale j ,eqtac));

theorem exNamedRename_at (E R: set) (k d c: nat):
 $ c e. exNamedRenameClass E R k ->
   sfNamedTemplate E k d (sfRename R d c) =
   sfNamedTemplate (sfComposeMap E R) k d c $ =
(named '(syl exNamedRename_depth {(bi1 exNamedRename_value) :
 $ c e. exNamedRenameClass E R k ->
   A. j (sfNamedTemplate E k j (sfRename R j c) =
         sfNamedTemplate (sfComposeMap E R) k j c) $}));

theorem exNamedRename_bot (E R: set) (k: nat):
 $ sfBot e. exNamedRenameClass E R k $ =
(named '(mpbir exNamedRename_value @ ax_gen @
 eqtr (sfNamedTemplateeq4 sfRename_bot) @
 eqtr sfNamedTemplate_bot (eqcom sfNamedTemplate_bot)));

theorem exNamedRename_mem (E R: set) (k a b: nat):
 $ sfMem a b e. exNamedRenameClass E R k $ =
(named '(mpbir exNamedRename_value @ ax_gen @
 eqtr (sfNamedTemplateeq4 sfRename_sfMem) @
 eqtr sfNamedTemplate_sfMem @
 eqtr (kMemeq exNamedIndex_rename exNamedIndex_rename)
 (eqcom sfNamedTemplate_sfMem)));

theorem exNamedRename_eq (E R: set) (k a b: nat):
 $ sfEq a b e. exNamedRenameClass E R k $ =
(named '(mpbir exNamedRename_value @ ax_gen @
 eqtr (sfNamedTemplateeq4 sfRename_sfEq) @
 eqtr sfNamedTemplate_sfEq @
 eqtr (kEqeq exNamedIndex_rename exNamedIndex_rename)
 (eqcom sfNamedTemplate_sfEq)));

theorem exNamedRename_atomic (E R: set) (k: nat):
 $ sfAtomicClosed (exNamedRenameClass E R k) $ =
(named '(ax_gen @ ax_gen @ ian exNamedRename_mem exNamedRename_eq));

theorem exNamedRename_and (E R: set) (k a b: nat):
 $ a e. exNamedRenameClass E R k /\ b e. exNamedRenameClass E R k ->
   sfAnd a b e. exNamedRenameClass E R k $ =
(named '(mpbird (a1i exNamedRename_value) @ !! iald d @
 eqtrd (a1i (sfNamedTemplateeq4 sfRename_sfAnd)) @
 eqtrd (a1i sfNamedTemplate_sfAnd) @
 eqtrd (kAndeqd (syl exNamedRename_at anl) (syl exNamedRename_at anr))
 (a1i (eqcom sfNamedTemplate_sfAnd))));

theorem exNamedRename_or (E R: set) (k a b: nat):
 $ a e. exNamedRenameClass E R k /\ b e. exNamedRenameClass E R k ->
   sfOr a b e. exNamedRenameClass E R k $ =
(named '(mpbird (a1i exNamedRename_value) @ !! iald d @
 eqtrd (a1i (sfNamedTemplateeq4 sfRename_sfOr)) @
 eqtrd (a1i sfNamedTemplate_sfOr) @
 eqtrd (kDisjeqd (syl exNamedRename_at anl) (syl exNamedRename_at anr))
 (a1i (eqcom sfNamedTemplate_sfOr))));

theorem exNamedRename_imp (E R: set) (k a b: nat):
 $ a e. exNamedRenameClass E R k /\ b e. exNamedRenameClass E R k ->
   sfImp a b e. exNamedRenameClass E R k $ =
(named '(mpbird (a1i exNamedRename_value) @ !! iald d @
 eqtrd (a1i (sfNamedTemplateeq4 sfRename_sfImp)) @
 eqtrd (a1i sfNamedTemplate_sfImp) @
 eqtrd (kImpeqd (syl exNamedRename_at anl) (syl exNamedRename_at anr))
 (a1i (eqcom sfNamedTemplate_sfImp))));

theorem exNamedRename_binary (E R: set) (k: nat):
 $ sfBinaryClosed (exNamedRenameClass E R k) $ =
(named '(ax_gen @ ax_gen @
 iand (iand exNamedRename_and exNamedRename_or) exNamedRename_imp));

theorem exNamedRename_all (E R: set) (k a: nat):
 $ a e. exNamedRenameClass E R k -> sfAll a e. exNamedRenameClass E R k $ =
(named '(mpbird (a1i exNamedRename_value) @ !! iald d @
 eqtrd (a1i (sfNamedTemplateeq4 sfRename_sfAll)) @
 eqtrd (a1i sfNamedTemplate_sfAll) @
 eqtrd (kAlleqd eqidd exNamedRename_at)
 (a1i (eqcom sfNamedTemplate_sfAll))));

theorem exNamedRename_ex (E R: set) (k a: nat):
 $ a e. exNamedRenameClass E R k -> sfEx a e. exNamedRenameClass E R k $ =
(named '(mpbird (a1i exNamedRename_value) @ !! iald d @
 eqtrd (a1i (sfNamedTemplateeq4 sfRename_sfEx)) @
 eqtrd (a1i sfNamedTemplate_sfEx) @
 eqtrd (kExistseqd eqidd exNamedRename_at)
 (a1i (eqcom sfNamedTemplate_sfEx))));

theorem exNamedRename_quantifier (E R: set) (k: nat):
 $ sfQuantifierClosed (exNamedRenameClass E R k) $ =
(named '(ax_gen @ iand exNamedRename_all exNamedRename_ex));

theorem exNamedRename_closed (E R: set) (k: nat):
 $ sfConstructionClosed (exNamedRenameClass E R k) $ =
'(ian (ian (ian exNamedRename_bot exNamedRename_atomic)
 exNamedRename_binary) exNamedRename_quantifier);

pub theorem exNamedTemplate_rename (E R: set) (k d c: nat):
 $ sfWf c -> sfNamedTemplate E k d (sfRename R d c) =
   sfNamedTemplate (sfComposeMap E R) k d c $ =
'(syl exNamedRename_at (ax_mp sfWf_induction exNamedRename_closed));
