theorem k215PushAStage4At346 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum365 (k215PVector u 0 (t, w) c a b 0 0 v)) (k215PState k215PNum369 (k215PVector u b (t, w) c a 0 b 0 v)) $ = '(k215PReach_intro (eqtr k215Loop365Vector (k215PStateeq2 (k215PVectoreq eqid add0 eqid eqid eqid eqid add0 eqid eqid))));

theorem k215PushAStage5At346 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum369 (k215PVector u b (t, w) c a 0 b 0 v)) (k215PState k215PNum372 (k215PVector u b (t, w) c a b 0 0 v)) $ = '(k215PReach_intro (eqtr k215Loop369Vector (k215PStateeq2 (k215PVectoreq6 add0))));

pub theorem k215PushParam346 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum346 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum372 (k215PVector u b (t, w) c a b 0 0 v)) $ = '(ax_mp (ax_mp k215PReach_trans k215PushAStage0At346) (ax_mp (ax_mp k215PReach_trans k215PushAStage1At346) (ax_mp (ax_mp k215PReach_trans k215PushAStage2At346) (ax_mp (ax_mp k215PReach_trans k215PushAStage3At346) (ax_mp (ax_mp k215PReach_trans k215PushAStage4At346) k215PushAStage5At346)))));

