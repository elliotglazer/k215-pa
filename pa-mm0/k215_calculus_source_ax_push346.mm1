theorem k215PairVectorInAt346 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt352State k215PNum352 a6 a1 a7 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum352 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215PairVectorOutAt346 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt352State k215PNum362 0 0 (a7 + (a6, a1)) (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum362 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

pub theorem k215PairMacro46_vectorAt346 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat):
 $ k215PReach (k215PState k215PNum352 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215PNum362 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ =
 '(mpbi (k215PReacheq k215PairVectorInAt346 k215PairVectorOutAt346) k215PairMacro352);

theorem k215PushAStage0At346 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum346 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum349 (k215PVector u 0 w c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop346Vector (k215PStateeq2 (k215PVectoreq7 add0))));

theorem k215PushAStage1At346 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum349 (k215PVector u 0 w c a b t 0 v)) (k215PState k215PNum352 (k215PVector u w 0 c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop349Vector (k215PStateeq2 (k215PVectoreq2 add0))));

theorem k215PushAStage2At346 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum352 (k215PVector u w 0 c a b t 0 v)) (k215PState k215PNum362 (k215PVector u 0 0 c a b 0 (t, w) v)) $ = '(mpbi (k215PReacheq2 (k215PStateeq2 (k215PVectoreq8 add01))) k215PairMacro46_vectorAt346);

