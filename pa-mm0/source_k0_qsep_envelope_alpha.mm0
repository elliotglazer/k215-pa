import "source_k0_qsep_envelope_facts.mm0";

import "k218q_alpha.mm0";

theorem sfK0QSepEnvelope_alpha (t a b z x: nat)
 (hz0: $ z != 0 $) (htz: $ t != z $) (haz: $ a != z $) (hbz: $ b != z $)
 (hx0: $ x != 0 $) (hxt: $ x != t $) (hxa: $ x != a $) (hxb: $ x != b $) (hxz: $ x != z $):
 $ k218QProvable (kImp (kAll z (sfK0QSepEnvelopeBody t a b z)) (kAll x (sfK0QSepEnvelopeBody t a b x))) $;
