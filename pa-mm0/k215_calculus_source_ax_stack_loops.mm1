   (eqtr k215PIter_succ (eqtr (k215PStepeq k215PIter_zero)
     (eqtr k215Loop4550StepZ (k215Loop4550Stateeq eqid eqid (eqcom (eqtr (addeq1 mul0) add01)) eqid eqid)))));
theorem k215Loop4550Inductive (x y z c: nat): $ k215Loop4550Claim x c -> k215PIter (6 * suc x + 1) (k215Loop4550State k215PNum4550 (suc x) y z c) = (k215Loop4550State k215PNum4556 0 (4 * suc x + y) z c) $ =
 '(eqtrd (a1i (eqtr (k215PItereq1 k215EqTime_succ)
     (eqtr k215PIter_add (k215PItereq2 k215Loop4550Cycle6))))
   (eqtrd k215Loop4550At (a1i (k215Loop4550Stateeq eqid eqid k215AXStackLoopFourShift eqid eqid))));
theorem k215Loop4550All (x c: nat): $ k215Loop4550Claim x c $ =
 (named @ induct '(ind) 'x '(ax_gen (ax_gen k215Loop4550Base)) '(iald @ iald k215Loop4550Inductive));
pub theorem k215Loop4550Transfer (x y z c: nat): $ k215PIter (6 * x + 1) (k215Loop4550State k215PNum4550 x y z c) = (k215Loop4550State k215PNum4556 0 (4 * x + y) z c) $ =
 '(ax_mp k215Loop4550At k215Loop4550All);


theorem k215Loop4550VectorIn (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215Loop4550State k215PNum4550 a7 a1 a0 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = k215PState k215PNum4550 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8) $ = '(k215PStateeq2 (k215PVectoreq eqid eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector k215PR6_vector eqid k215PR8_vector));

theorem k215Loop4550VectorOut (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215Loop4550State k215PNum4556 0 (4 * a7 + a1) a0 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = k215PState k215PNum4556 (k215PVector a0 (4 * a7 + a1) a2 a3 a4 a5 a6 0 a8) $ = '(k215PStateeq2 (k215PVectoreq eqid eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector k215PR6_vector eqid k215PR8_vector));

pub theorem k215Loop4550Vector (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ k215PIter (6 * a7 + 1) (k215PState k215PNum4550 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) =
   k215PState k215PNum4556 (k215PVector a0 (4 * a7 + a1) a2 a3 a4 a5 a6 0 a8) $ =
 '(eqtr (k215PItereq2 (eqcom k215Loop4550VectorIn)) (eqtr k215Loop4550Transfer k215Loop4550VectorOut));

