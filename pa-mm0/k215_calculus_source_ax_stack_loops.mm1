import "k215_calculus_source_decode_loops.mm1";
import "k215_calculus_source_ax_stack_lookups.mm1";

theorem k215AXStackLoopFourAdd (y: nat): $ 4 + y = suc (suc (suc (suc y))) $ = '(eqtr addS1 (suceq (eqtr addS1 (suceq (eqtr addS1 (suceq (eqtr addS1 (suceq add01))))))));

theorem k215AXStackLoopFourShift (x y: nat): $ 4 * x + suc (suc (suc (suc y))) = 4 * suc x + y $ =
 '(eqtr (addeq2 (eqcom k215AXStackLoopFourAdd))
   (eqtr (eqcom addass) (addeq1 (eqcom mulS))));


@_ def k215Loop107State (pc x y z c: nat): nat = $ k215PState pc (k215PVector z x (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) y (k215PR7 c) (k215PR8 c)) $;

do (apply (register-eqd 'k215Loop107State) '(k215Loop107Stateeqd));

theorem k215Loop107StepZ (y z c: nat): $ k215PStep (k215Loop107State k215Num107 0 y z c) = (k215Loop107State k215Num110 0 y z c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupExtraLoopsaxstack_107) (ifeq (eqeq1 k215PGet1_vector) eqid eqid)) (ifpos eqid));

theorem k215Loop107StepS (x y z c: nat): $ k215PStep (k215Loop107State k215Num107 (suc x) y z c) = (k215Loop107State k215Num108 x y z c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupExtraLoopsaxstack_107) (ifeq (eqeq1 k215PGet1_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet1_vector)) (eqtr k215PSet1_vector (k215PVectoreq2 (eqtr subSS sub02))))));

theorem k215Loop107Step1 (x y z c: nat): $ k215PStep (k215Loop107State k215Num108 x y z c) = (k215Loop107State k215Num109 x (suc y) z c) $ = '(eqtr (k215PAtCI k215PLookupExtraLoopsaxstack_108) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet6_vector)) k215PSet6_vector)));

theorem k215Loop107Back (x y z c: nat): $ k215PStep (k215Loop107State k215Num109 x y z c) = (k215Loop107State k215Num107 x y z c) $ = '(k215PAtCC k215PLookupExtraLoopsaxstack_109);

theorem k215Loop107Cycle1 (x y z c: nat): $ k215PIter 1 (k215Loop107State k215Num107 (suc x) y z c) = (k215Loop107State k215Num108 x y z c) $ = '(eqtr k215PIter_succ (eqtr (k215PStepeq k215PIter_zero) k215Loop107StepS));

theorem k215Loop107Cycle2 (x y z c: nat): $ k215PIter 2 (k215Loop107State k215Num107 (suc x) y z c) = (k215Loop107State k215Num109 x (suc y) z c) $ = '(eqtr k215PIter_succ (eqtr (k215PStepeq k215Loop107Cycle1) k215Loop107Step1));

theorem k215Loop107Cycle3 (x y z c: nat): $ k215PIter 3 (k215Loop107State k215Num107 (suc x) y z c) = (k215Loop107State k215Num107 x (suc y) z c) $ = '(eqtr k215PIter_succ (eqtr (k215PStepeq k215Loop107Cycle2) k215Loop107Back));

@_ abstract def k215Loop107Claim (x c: nat) (.y .z: nat): wff =
 $ A. y A. z k215PIter (3 * x + 1) (k215Loop107State k215Num107 x y z c) = (k215Loop107State k215Num110 0 (x + y) z c) $;
theorem k215Loop107At (x y z c: nat): $ k215Loop107Claim x c -> k215PIter (3 * x + 1) (k215Loop107State k215Num107 x y z c) = (k215Loop107State k215Num110 0 (x + y) z c) $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215Loop107Base (y z c: nat): $ k215PIter (3 * 0 + 1) (k215Loop107State k215Num107 0 y z c) = (k215Loop107State k215Num110 0 (0 + y) z c) $ =
 '(eqtr (k215PItereq1 (eqtr (addeq1 mul0) add01))
   (eqtr k215PIter_succ (eqtr (k215PStepeq k215PIter_zero)
     (eqtr k215Loop107StepZ (k215Loop107Stateeq eqid eqid (eqcom add01) eqid eqid)))));
theorem k215Loop107Inductive (x y z c: nat): $ k215Loop107Claim x c -> k215PIter (3 * suc x + 1) (k215Loop107State k215Num107 (suc x) y z c) = (k215Loop107State k215Num110 0 (suc x + y) z c) $ =
 '(eqtrd (a1i (eqtr (k215PItereq1 k215EqTime_succ)
     (eqtr k215PIter_add (k215PItereq2 k215Loop107Cycle3))))
   (eqtrd k215Loop107At (a1i (k215Loop107Stateeq eqid eqid (eqtr addS (eqcom addS1)) eqid eqid))));
theorem k215Loop107All (x c: nat): $ k215Loop107Claim x c $ =
 (named @ induct '(ind) 'x '(ax_gen (ax_gen k215Loop107Base)) '(iald @ iald k215Loop107Inductive));
pub theorem k215Loop107Transfer (x y z c: nat): $ k215PIter (3 * x + 1) (k215Loop107State k215Num107 x y z c) = (k215Loop107State k215Num110 0 (x + y) z c) $ =
 '(ax_mp k215Loop107At k215Loop107All);


theorem k215Loop107VectorIn (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215Loop107State k215Num107 a1 a6 a0 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = k215PState k215Num107 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8) $ = '(k215PStateeq2 (k215PVectoreq eqid eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid k215PR7_vector k215PR8_vector));

theorem k215Loop107VectorOut (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215Loop107State k215Num110 0 (a1 + a6) a0 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = k215PState k215Num110 (k215PVector a0 0 a2 a3 a4 a5 (a1 + a6) a7 a8) $ = '(k215PStateeq2 (k215PVectoreq eqid eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid k215PR7_vector k215PR8_vector));

pub theorem k215Loop107Vector (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ k215PIter (3 * a1 + 1) (k215PState k215Num107 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) =
   k215PState k215Num110 (k215PVector a0 0 a2 a3 a4 a5 (a1 + a6) a7 a8) $ =
 '(eqtr (k215PItereq2 (eqcom k215Loop107VectorIn)) (eqtr k215Loop107Transfer k215Loop107VectorOut));

