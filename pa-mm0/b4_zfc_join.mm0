import "b4_zfc_mono.mm0";

--| some justified fact set (m, v) with bound B holds the fact (g, a, b, c, d).
def bdCertF (g a b c d .m .v .B: nat): wff =
$ E. m E. v E. B (bdZfcJust m v B /\ bdHas m v v g a b c d) $;
theorem bdJ_inst (m v B e: nat) {i g a b c d: nat}: $ bdZfcJust m v B -> bdCell m v e -> E. i (i <= e /\ (E. g (g <= e /\ (E. a (a <= e /\ (E. b (b <= e /\ (E. c (c <= e /\ (E. d (d <= e /\ bdTup i g a b c d e /\ bdZfcRule m v B i g a b c d))))))))))) $;
theorem bdJ_mono (G: wff) (m v B m2 v2 B2 e: nat) {i g a b c d kk: nat} (hs: $ G -> A. kk (bdCell m v kk -> bdCell m2 v2 kk) $) (hb: $ G -> B <= B2 $): $ G -> E. i (i <= e /\ (E. g (g <= e /\ (E. a (a <= e /\ (E. b (b <= e /\ (E. c (c <= e /\ (E. d (d <= e /\ bdTup i g a b c d e /\ bdZfcRule m v B i g a b c d))))))))))) -> E. i (i <= e /\ (E. g (g <= e /\ (E. a (a <= e /\ (E. b (b <= e /\ (E. c (c <= e /\ (E. d (d <= e /\ bdTup i g a b c d e /\ bdZfcRule m2 v2 B2 i g a b c d))))))))))) $;
theorem bdJust_intro (m v B: nat) {k i g a b c d: nat}: $ A. k (bdCell m v k -> E. i (i <= k /\ (E. g (g <= k /\ (E. a (a <= k /\ (E. b (b <= k /\ (E. c (c <= k /\ (E. d (d <= k /\ bdTup i g a b c d k /\ bdZfcRule m v B i g a b c d)))))))))))) -> bdZfcJust m v B $;
theorem bdHasLift (m v m2 v2 g a b c d: nat) {kk: nat}: $ A. kk (bdCell m v kk -> bdCell m2 v2 kk) -> bdHas m v v g a b c d -> bdHas m2 v2 v2 g a b c d $;
theorem bdJust_raise (m v B B2: nat) {kk: nat}: $ B <= B2 -> bdZfcJust m v B -> bdZfcJust m v B2 $;
theorem bdEmpty (B: nat) {k m v: nat}: $ E. m E. v bdZfcJust m v B $;
theorem bdJoin_sub1 (m1 v1 m2 v2 m v: nat) {k kk: nat}: $ A. k (bdCell m v k <-> k < v1 + v2 /\ (bdCell m1 v1 k \/ bdCell m2 v2 k)) -> A. kk (bdCell m1 v1 kk -> bdCell m v kk) $;
theorem bdJoin_sub2 (m1 v1 m2 v2 m v: nat) {k kk: nat}: $ A. k (bdCell m v k <-> k < v1 + v2 /\ (bdCell m1 v1 k \/ bdCell m2 v2 k)) -> A. kk (bdCell m2 v2 kk -> bdCell m v kk) $;
theorem bdJoin_just (m1 v1 B1 m2 v2 B2 m v: nat) {k kk i g a b c d: nat}: $ bdZfcJust m1 v1 B1 -> bdZfcJust m2 v2 B2 -> A. k (bdCell m v k <-> k < v1 + v2 /\ (bdCell m1 v1 k \/ bdCell m2 v2 k)) -> bdZfcJust m v (B1 + B2) $;
theorem bdJoin (m1 v1 B1 m2 v2 B2: nat) {kk m v: nat}: $ bdZfcJust m1 v1 B1 -> bdZfcJust m2 v2 B2 -> E. m E. v (bdZfcJust m v (B1 + B2) /\ A. kk (bdCell m1 v1 kk -> bdCell m v kk) /\ A. kk (bdCell m2 v2 kk -> bdCell m v kk)) $;
theorem bdAdd_sub (m v m2 v2 g a b c d: nat) {k kk: nat}: $ A. k (bdCell m2 v2 k <-> k < suc (v + (v, g, a, b, c, d)) /\ (bdCell m v k \/ k = (v, g, a, b, c, d))) -> A. kk (bdCell m v kk -> bdCell m2 v2 kk) $;
theorem bdAdd_K (m v m2 v2 g a b c d: nat) {k: nat}: $ A. k (bdCell m2 v2 k <-> k < suc (v + (v, g, a, b, c, d)) /\ (bdCell m v k \/ k = (v, g, a, b, c, d))) -> bdCell m2 v2 (v, g, a, b, c, d) $;
theorem bdAdd_just (m v B m2 v2 g a b c d: nat) {k kk: nat}: $ bdZfcJust m v B -> bdZfcRule m v B v g a b c d -> A. k (bdCell m2 v2 k <-> k < suc (v + (v, g, a, b, c, d)) /\ (bdCell m v k \/ k = (v, g, a, b, c, d))) -> bdZfcJust m2 v2 B $;
theorem bdAdd_has (m v m2 v2 g a b c d: nat) {k j: nat}: $ bdCell m2 v2 (v, g, a, b, c, d) -> bdHas m2 v2 v2 g a b c d $;
theorem bdAdd (m v B g a b c d: nat) {kk m2 v2: nat}: $ bdZfcJust m v B -> bdZfcRule m v B v g a b c d -> E. m2 E. v2 (bdZfcJust m2 v2 B /\ A. kk (bdCell m v kk -> bdCell m2 v2 kk) /\ bdHas m2 v2 v2 g a b c d) $;
theorem bdCF_intro (m v B g a b c d: nat): $ bdZfcJust m v B -> bdHas m v v g a b c d -> bdCertF g a b c d $;
theorem bdCC_1 (gK aK bK cK eK gL aL bL cL eL: nat) {mA vA BA m v B: nat}: $ E. mA E. vA E. BA (bdZfcJust mA vA BA /\ bdHas mA vA vA gK aK bK cK eK) -> bdCertF gL aL bL cL eL -> E. m E. v E. B (bdZfcJust m v B /\ bdHas m v v gK aK bK cK eK /\ bdHas m v v gL aL bL cL eL) $;
theorem bdCC_2 (gK aK bK cK eK gL aL bL cL eL gM aM bM cM eM: nat) {mA vA BA m v B: nat}: $ E. mA E. vA E. BA (bdZfcJust mA vA BA /\ bdHas mA vA vA gK aK bK cK eK /\ bdHas mA vA vA gL aL bL cL eL) -> bdCertF gM aM bM cM eM -> E. m E. v E. B (bdZfcJust m v B /\ bdHas m v v gK aK bK cK eK /\ bdHas m v v gL aL bL cL eL /\ bdHas m v v gM aM bM cM eM) $;
theorem bdCC_3 (gK aK bK cK eK gL aL bL cL eL gM aM bM cM eM gN aN bN cN eN: nat) {mA vA BA m v B: nat}: $ E. mA E. vA E. BA (bdZfcJust mA vA BA /\ bdHas mA vA vA gK aK bK cK eK /\ bdHas mA vA vA gL aL bL cL eL /\ bdHas mA vA vA gM aM bM cM eM) -> bdCertF gN aN bN cN eN -> E. m E. v E. B (bdZfcJust m v B /\ bdHas m v v gK aK bK cK eK /\ bdHas m v v gL aL bL cL eL /\ bdHas m v v gM aM bM cM eM /\ bdHas m v v gN aN bN cN eN) $;
theorem bdCC_4 (gK aK bK cK eK gL aL bL cL eL gM aM bM cM eM gN aN bN cN eN gP aP bP cP eP: nat) {mA vA BA m v B: nat}: $ E. mA E. vA E. BA (bdZfcJust mA vA BA /\ bdHas mA vA vA gK aK bK cK eK /\ bdHas mA vA vA gL aL bL cL eL /\ bdHas mA vA vA gM aM bM cM eM /\ bdHas mA vA vA gN aN bN cN eN) -> bdCertF gP aP bP cP eP -> E. m E. v E. B (bdZfcJust m v B /\ bdHas m v v gK aK bK cK eK /\ bdHas m v v gL aL bL cL eL /\ bdHas m v v gM aM bM cM eM /\ bdHas m v v gN aN bN cN eN /\ bdHas m v v gP aP bP cP eP) $;
theorem bdCC_5 (gK aK bK cK eK gL aL bL cL eL gM aM bM cM eM gN aN bN cN eN gP aP bP cP eP gQ aQ bQ cQ eQ: nat) {mA vA BA m v B: nat}: $ E. mA E. vA E. BA (bdZfcJust mA vA BA /\ bdHas mA vA vA gK aK bK cK eK /\ bdHas mA vA vA gL aL bL cL eL /\ bdHas mA vA vA gM aM bM cM eM /\ bdHas mA vA vA gN aN bN cN eN /\ bdHas mA vA vA gP aP bP cP eP) -> bdCertF gQ aQ bQ cQ eQ -> E. m E. v E. B (bdZfcJust m v B /\ bdHas m v v gK aK bK cK eK /\ bdHas m v v gL aL bL cL eL /\ bdHas m v v gM aM bM cM eM /\ bdHas m v v gN aN bN cN eN /\ bdHas m v v gP aP bP cP eP /\ bdHas m v v gQ aQ bQ cQ eQ) $;
theorem bdCStep_0 (G: wff) (g a b c d N0: nat) {m v B: nat} (h: $ G -> A. m A. v A. B (bdZfcJust m v B -> N0 <= B -> bdZfcRule m v B v g a b c d) $): $ G -> bdCertF g a b c d $;
theorem bdCStep_1 (G: wff) (gK aK bK cK eK g a b c d N0: nat) {mA vA BA m v B: nat} (h: $ G -> A. m A. v A. B (bdZfcJust m v B -> N0 <= B -> bdHas m v v gK aK bK cK eK -> bdZfcRule m v B v g a b c d) $): $ G -> E. mA E. vA E. BA (bdZfcJust mA vA BA /\ bdHas mA vA vA gK aK bK cK eK) -> bdCertF g a b c d $;
theorem bdCStep_2 (G: wff) (gK aK bK cK eK gL aL bL cL eL g a b c d N0: nat) {mA vA BA m v B: nat} (h: $ G -> A. m A. v A. B (bdZfcJust m v B -> N0 <= B -> bdHas m v v gK aK bK cK eK -> bdHas m v v gL aL bL cL eL -> bdZfcRule m v B v g a b c d) $): $ G -> E. mA E. vA E. BA (bdZfcJust mA vA BA /\ bdHas mA vA vA gK aK bK cK eK /\ bdHas mA vA vA gL aL bL cL eL) -> bdCertF g a b c d $;
theorem bdCStep_3 (G: wff) (gK aK bK cK eK gL aL bL cL eL gM aM bM cM eM g a b c d N0: nat) {mA vA BA m v B: nat} (h: $ G -> A. m A. v A. B (bdZfcJust m v B -> N0 <= B -> bdHas m v v gK aK bK cK eK -> bdHas m v v gL aL bL cL eL -> bdHas m v v gM aM bM cM eM -> bdZfcRule m v B v g a b c d) $): $ G -> E. mA E. vA E. BA (bdZfcJust mA vA BA /\ bdHas mA vA vA gK aK bK cK eK /\ bdHas mA vA vA gL aL bL cL eL /\ bdHas mA vA vA gM aM bM cM eM) -> bdCertF g a b c d $;
theorem bdCStep_4 (G: wff) (gK aK bK cK eK gL aL bL cL eL gM aM bM cM eM gN aN bN cN eN g a b c d N0: nat) {mA vA BA m v B: nat} (h: $ G -> A. m A. v A. B (bdZfcJust m v B -> N0 <= B -> bdHas m v v gK aK bK cK eK -> bdHas m v v gL aL bL cL eL -> bdHas m v v gM aM bM cM eM -> bdHas m v v gN aN bN cN eN -> bdZfcRule m v B v g a b c d) $): $ G -> E. mA E. vA E. BA (bdZfcJust mA vA BA /\ bdHas mA vA vA gK aK bK cK eK /\ bdHas mA vA vA gL aL bL cL eL /\ bdHas mA vA vA gM aM bM cM eM /\ bdHas mA vA vA gN aN bN cN eN) -> bdCertF g a b c d $;
theorem bdCStep_5 (G: wff) (gK aK bK cK eK gL aL bL cL eL gM aM bM cM eM gN aN bN cN eN gP aP bP cP eP g a b c d N0: nat) {mA vA BA m v B: nat} (h: $ G -> A. m A. v A. B (bdZfcJust m v B -> N0 <= B -> bdHas m v v gK aK bK cK eK -> bdHas m v v gL aL bL cL eL -> bdHas m v v gM aM bM cM eM -> bdHas m v v gN aN bN cN eN -> bdHas m v v gP aP bP cP eP -> bdZfcRule m v B v g a b c d) $): $ G -> E. mA E. vA E. BA (bdZfcJust mA vA BA /\ bdHas mA vA vA gK aK bK cK eK /\ bdHas mA vA vA gL aL bL cL eL /\ bdHas mA vA vA gM aM bM cM eM /\ bdHas mA vA vA gN aN bN cN eN /\ bdHas mA vA vA gP aP bP cP eP) -> bdCertF g a b c d $;
theorem bdCStep_6 (G: wff) (gK aK bK cK eK gL aL bL cL eL gM aM bM cM eM gN aN bN cN eN gP aP bP cP eP gQ aQ bQ cQ eQ g a b c d N0: nat) {mA vA BA m v B: nat} (h: $ G -> A. m A. v A. B (bdZfcJust m v B -> N0 <= B -> bdHas m v v gK aK bK cK eK -> bdHas m v v gL aL bL cL eL -> bdHas m v v gM aM bM cM eM -> bdHas m v v gN aN bN cN eN -> bdHas m v v gP aP bP cP eP -> bdHas m v v gQ aQ bQ cQ eQ -> bdZfcRule m v B v g a b c d) $): $ G -> E. mA E. vA E. BA (bdZfcJust mA vA BA /\ bdHas mA vA vA gK aK bK cK eK /\ bdHas mA vA vA gL aL bL cL eL /\ bdHas mA vA vA gM aM bM cM eM /\ bdHas mA vA vA gN aN bN cN eN /\ bdHas mA vA vA gP aP bP cP eP /\ bdHas mA vA vA gQ aQ bQ cQ eQ) -> bdCertF g a b c d $;
theorem bdCertFeqd (G: wff) (g a b c d gZ aZ bZ cZ dZ: nat) (h1: $ G -> g = gZ $) (h2: $ G -> a = aZ $) (h3: $ G -> b = bZ $) (h4: $ G -> c = cZ $) (h5: $ G -> d = dZ $): $ G -> (bdCertF g a b c d <-> bdCertF gZ aZ bZ cZ dZ) $;
