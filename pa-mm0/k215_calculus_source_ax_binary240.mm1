import "k215_calculus_source_ax_unpair240.mm1";
import "k215_calculus_source_ax_pair251.mm1";
import "k218_codes.mm1";

theorem k215BinaryUnpairInAt240 (u t w c a b v: nat): $ (k215UnpairAt240State k215PNum240 0 0 w (k215PVector u t w c a b 0 0 v)) = (k215PState k215PNum240 (k215PVector u t w c a b 0 0 v)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector eqid k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryUnpairOutAt240 (u t w c a b v: nat): $ (k215UnpairAt240State k215PNum248 (fst w) (snd w) 0 (k215PVector u t w c a b 0 0 v)) = (k215PState k215PNum248 (k215PVector u t 0 c a b (fst w) (snd w) v)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector eqid k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryUnpairAt240 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum240 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum248 (k215PVector u t 0 c a b (fst w) (snd w) v)) $ =
 '(mpbi (k215PReacheq k215BinaryUnpairInAt240 k215BinaryUnpairOutAt240) k215UnpairMacro240_clean);

theorem k215BinaryRestoreStackAt240 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum248 (k215PVector u t 0 c a b (fst w) (snd w) v)) (k215PState k215PNum251 (k215PVector u t (snd w) c a b (fst w) 0 v)) $ =
 '(k215PReach_intro (eqtr k215Loop248Vector (k215PStateeq2 (k215PVectoreq3 add0))));

theorem k215BinaryPairInAt240 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt251State k215PNum251 a6 a1 a7 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum251 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryPairOutAt240 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt251State k215PNum261 0 0 (a7 + (a6, a1)) (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum261 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryPairAt240 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat):
 $ k215PReach (k215PState k215PNum251 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215PNum261 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ =
 '(mpbi (k215PReacheq k215BinaryPairInAt240 k215BinaryPairOutAt240) k215PairMacro251);

theorem k215BinaryPairCleanAt240 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum251 (k215PVector u t (snd w) c a b (fst w) 0 v)) (k215PState k215PNum261 (k215PVector u 0 (snd w) c a b 0 (fst w, t) v)) $ =
 '(mpbi (k215PReacheq2 (k215PStateeq2 (k215PVectoreq8 add01))) k215BinaryPairAt240);
theorem k215BinaryFourAt240 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum261 (k215PVector u 0 (snd w) c a b 0 (fst w, t) v)) (k215PState k215PNum267 (k215PVector u (4 * (fst w, t)) (snd w) c a b 0 0 v)) $ =
 '(k215PReach_intro (eqtr k215Loop261Vector (k215PStateeq2 (k215PVectoreq2 add0))));

theorem k215BinaryTagAllAt240 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum267 (k215PVector u (4 * (fst w, t)) (snd w) c a b 0 0 v)) (k215PState k215PNum267 (k215PVector u (kImp (fst w) t) (snd w) c a b 0 0 v)) $ = 'k215PReach_refl;

pub theorem k215BinaryConstructor240 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum240 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum267 (k215PVector u (kImp (fst w) t) (snd w) c a b 0 0 v)) $ = '(ax_mp (ax_mp k215PReach_trans k215BinaryUnpairAt240) (ax_mp (ax_mp k215PReach_trans k215BinaryRestoreStackAt240) (ax_mp (ax_mp k215PReach_trans k215BinaryPairCleanAt240) (ax_mp (ax_mp k215PReach_trans k215BinaryFourAt240) k215BinaryTagAllAt240))));

