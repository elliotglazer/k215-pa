import "pa_source_interpretation_term_induction.mm0";

import "pa_source_interpretation_term_substitution.mm0";

theorem paTermSubstVariable_shift (d a i: nat): $ paTermSubstVariable d a (sfShiftIndex d i) = paTermVariable i $;

def paTermSubstShiftClass (d a: nat) (.c: nat): set = $ {c | paTermSubst d a (paTermShift d c) = c} $;

theorem paTermSubst_shift (d a n c: nat): $ paTermBound n c -> paTermSubst d a (paTermShift d c) = c $;
