import "source_k0_qsep_tagged_substitution.mm0";

import "k218q_quantifier_macros.mm0";

import "k218q_bound_vacuity.mm0";

def sfK0QSepSimpleCases (E: set) (t b x K theta: nat): nat = $ (kImp (kImp (kEq x b) kF) (kImp (kImp (kEq x t) kF) (kImp (kImp (kMem x b) (kImp (sfNamedTemplate (sqEnvCons x E) K 0 theta) kF)) kF))) $;

def sfK0QSepTaggedSupport (E: set) (r t b c x p K theta: nat): nat = $ kAll x (kImp (kMem x c) (kExists p (sfK0QSepNamedTagged E r t b p x K theta))) $;

theorem sfK0QSepTagged_support_at (E: set) (n r t b c x p K theta: nat) (hf: $ sfBound (suc n) theta $) (hp0: $ p != 0 $) (hpK: $ p < K $)
 (hpx: $ p != x $) (hpb: $ p != b $) (hpt: $ p != t $) (he: $ sqEnvAvoid E n p $):
 $ k218QProvable (kImp (kImp (kImp (kImp (kImp (kEq p r) (kImp (kEq x b) kF)) kF) kF) (kImp (kImp (kImp (kImp (kEq p t) (kImp (kEq x t) kF)) kF) kF) (kImp (kImp (sfK0QSepNamedSingleton x p K) (kImp (kImp (kImp (kMem x b) (kImp (sfNamedTemplate (sqEnvCons x E) K 0 theta) kF)) kF) kF)) kF))) (kImp (kImp (kEq x b) kF) (kImp (kImp (kEq x t) kF) (kImp (kImp (kMem x b) (kImp (sfNamedTemplate (sqEnvCons x E) K 0 theta) kF)) kF)))) $;

theorem sfK0QSepTagged_support_exists (E: set) (n r t b c x p K theta: nat) (hf: $ sfBound (suc n) theta $) (hp0: $ p != 0 $) (hpK: $ p < K $)
 (hpx: $ p != x $) (hpb: $ p != b $) (hpt: $ p != t $) (he: $ sqEnvAvoid E n p $):
 $ k218QProvable (kImp (kImp (kAll p (kImp (kImp (kImp (kImp (kImp (kEq p r) (kImp (kEq x b) kF)) kF) kF) (kImp (kImp (kImp (kImp (kEq p t) (kImp (kEq x t) kF)) kF) kF) (kImp (kImp (sfK0QSepNamedSingleton x p K) (kImp (kImp (kImp (kMem x b) (kImp (sfNamedTemplate (sqEnvCons x E) K 0 theta) kF)) kF) kF)) kF))) kF)) kF) (kImp (kImp (kEq x b) kF) (kImp (kImp (kEq x t) kF) (kImp (kImp (kMem x b) (kImp (sfNamedTemplate (sqEnvCons x E) K 0 theta) kF)) kF)))) $;

theorem qsepSupportMembershipPoint (E: set) (n r t b c x p K theta: nat) (hf: $ sfBound (suc n) theta $) (hp0: $ p != 0 $) (hpK: $ p < K $)
 (hpx: $ p != x $) (hpb: $ p != b $) (hpt: $ p != t $) (he: $ sqEnvAvoid E n p $):
 $ k218QProvable (kImp (kImp (kMem x c) (kImp (kAll p (kImp (kImp (kImp (kImp (kImp (kEq p r) (kImp (kEq x b) kF)) kF) kF) (kImp (kImp (kImp (kImp (kEq p t) (kImp (kEq x t) kF)) kF) kF) (kImp (kImp (sfK0QSepNamedSingleton x p K) (kImp (kImp (kImp (kMem x b) (kImp (sfNamedTemplate (sqEnvCons x E) K 0 theta) kF)) kF) kF)) kF))) kF)) kF)) (kImp (kMem x c) (kImp (kImp (kEq x b) kF) (kImp (kImp (kEq x t) kF) (kImp (kImp (kMem x b) (kImp (sfNamedTemplate (sqEnvCons x E) K 0 theta) kF)) kF))))) $;

theorem sfK0QSepTagged_support_profile (E: set) (n r t b c x p K theta: nat) (hf: $ sfBound (suc n) theta $) (hp0: $ p != 0 $) (hpK: $ p < K $)
 (hpx: $ p != x $) (hpb: $ p != b $) (hpt: $ p != t $) (he: $ sqEnvAvoid E n p $):
 $ k218QProvable (kImp (sfK0QSepTaggedSupport E r t b c x p K theta) (kAll x (kImp (kMem x c) (sfK0QSepSimpleCases E t b x K theta)))) $;
