import "source_piece_pcf_rep_case_common.mm0";

import "source_piece_pcf_definable_difference_use.mm0";

import "source_piece_pcf_definable_union_use.mm0";

import "source_piece_pcf_definable_existential_recipe.mm0";

import "source_piece_pcf_rep_cover_bridge_r46.mm0";

-- Imp case of the uniform representation theorem (Rocq Z_cl.rep_ex, Imp branch:
-- (A^n - R1) u R2), in hypothesis form. Closure over the stock mm0-c capacity (B1).

theorem sfPieceRepCaseImp_rule (G n a b w A l r U d: nat)
  (hg: $ sfContextWf G $) (hba: $ sfBound n a $) (hbb: $ sfBound n b $)
  (hL: $ nsLocal G (sfPieceDefinableNamed n a l A) $)
  (hR: $ nsLocal G (sfPieceDefinableNamed n b r A) $)
  (hD: $ nsLocal G (sfPieceDefinableConjunctionDifference U l d) $)
  (hU: $ nsLocal G (sfPieceRepImplicationNamedUnion d r w) $)
  (hC: $ nsLocal G (sfPieceRepEnvironmentCoverAt A U n) $):
  $ nsLocal G (sfPieceDefinableNamed n (sfImp a b) w A) $;

theorem sfPieceRepCaseImp (G A B C n a b: nat)
  (hg: $ sfContextWf G $) (hbg: $ sfContextSub sfLBackground G $)
  (hs: $ nsLocal G (sfPieceRepSuccessor A B) $)
  (hc: $ nsLocal G (sfPieceRepClosure B C) $)
  (hba: $ sfBound n a $) (hbb: $ sfBound n b $)
  (hwa: $ nsLocal G (sfPieceDefinableWitness A C n a) $)
  (hwb: $ nsLocal G (sfPieceDefinableWitness A C n b) $):
  $ nsLocal G (sfPieceDefinableWitness A C n (sfImp a b)) $;
