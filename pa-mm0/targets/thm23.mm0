import "../k215_literal_tm.mm0";
import "../zfc_proofs.mm0";
import "../bb215_arithmetic_sentence_syntax.mm0";

-- Theorems 2 and 3 as proved in this repository (text verbatim from the frozen K215 target specification).
-- K215: 215 working states, 430 rows, separate halt label 215.
-- bb215ArithmeticSentenceSource b: the translation into the language of set theory of the PA sentence "BB(215) = b"
-- (busy beaver value over all 215-state binary machines, at the numeral b; bb215_arithmetic_sentence_syntax.mm0).

theorem ZFC_consistent_iff_BB215_no_value_provable {b: nat}:
  $ ~zfcInconsistent <-> A. b ~zfcProvable (bb215ArithmeticSentenceSource b) $;

theorem K215_full_consistency_BB215_nonprovability {b: nat}:
  $ (~zfcInconsistent <-> ~k215LiteralHalts) /\
    (~k215LiteralHalts <-> A. b ~zfcProvable (bb215ArithmeticSentenceSource b)) $;
