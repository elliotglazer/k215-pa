import "k215_literal_runtime_native_completion.mm0";
import "k215_literal_runtime_startup_frame.mm0";
import "k215_literal_reach_halt_equiv.mm0";

theorem k215NativeInitial_halting_equivalence:
 $ k215PNativeLaw ->
   (k215TMHaltsFrom (k215PConfigFrame 1 k215PInitial 1 (repeat 1 k215Num39))
    <-> k215PHaltsFrom k215PInitial) $;

theorem k215LiteralHalts_iff_initial_frame:
 $ k215LiteralHalts <->
   k215TMHaltsFrom (k215PConfigFrame 1 k215PInitial 1 (repeat 1 k215Num39)) $;

theorem k215LiteralHalts_iff_program_given_native_law:
 $ k215PNativeLaw -> (k215LiteralHalts <-> k215PInitialHalts) $;
