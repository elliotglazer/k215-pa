theorem qrepMapCAgree (E: set) (x y c a: nat) (n: nat): $ sqEnvAgree (sfComposeMap (sqEnvCons x (sqEnvCons y (sqEnvCons c (sqEnvCons a E)))) sfRepCMap) (sqEnvCons x (sqEnvCons y E)) n $ = (named '(ax_gen (a1i qrepMapCPoint)));

pub theorem sfK0QRepQuote_C (E: set) (x y c a: nat) (n t k phi: nat): $ sfBound (suc (suc n)) phi -> sqQuote (sqEnvCons x (sqEnvCons y (sqEnvCons c (sqEnvCons a E)))) t k 0 (sfRename sfRepCMap 0 phi) = sqQuote (sqEnvCons x (sqEnvCons y E)) t k 0 phi $ = '(eqtrd (syl sqQuote_source_renaming sfBound_wf) (syl (sqQuote_environment qrepMapCAgree) (bi2 (sfBoundeq1 add01))));
