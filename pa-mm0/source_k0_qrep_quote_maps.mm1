theorem qrepMapC0 (E: set) (x y c a: nat): $ sfComposeMap (sqEnvCons x (sqEnvCons y (sqEnvCons c (sqEnvCons a E)))) sfRepCMap @ 0 = (sqEnvCons x (sqEnvCons y E)) @ 0 $ = '(eqtr sfComposeMap_value (eqtr (appeq2 sfRepCMap_zero) (eqtr sqEnvCons_zero (eqcom sqEnvCons_zero))));

