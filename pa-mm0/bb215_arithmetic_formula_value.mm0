import "bb215_arithmetic_formula_run_scalar.mm0";

import "bb215_arithmetic_formula_projections.mm0";

import "bb215_table_arithmetic_valid_universal.mm0";

def bb215ArithmeticFormulaHaltedGraph (T n .s: nat): wff = $ E. s (bb215ArithmeticFormulaRunScalarGraph T n s /\ bb215ArithmeticFormulaFstGraph s k215Num215) $;

theorem bb215ArithmeticFormulaHaltedGraph_correct (T n: nat) {s: nat}: $ bb215ArithmeticFormulaHaltedGraph T n <-> bb215Halted T n $;

def bb215ArithmeticFormulaHaltsGraph (T .n: nat): wff = $ E. n bb215ArithmeticFormulaHaltedGraph T n $;

theorem bb215ArithmeticFormulaHaltsGraph_correct (T: nat) {n: nat}: $ bb215ArithmeticFormulaHaltsGraph T <-> bb215Halts T $;

def bb215ArithmeticFormulaNonHaltedGraph (T n: nat): wff = $ bb215ArithmeticFormulaHaltedGraph T n -> 0 != 0 $;

theorem bb215ArithmeticFormulaNonHaltedGraph_correct (T n: nat): $ bb215ArithmeticFormulaNonHaltedGraph T n <-> ~bb215Halted T n $;

def bb215ArithmeticFormulaLessGraph (n b .h: nat): wff = $ E. h suc n + h = b $;

theorem bb215ArithmeticFormulaLessGraph_correct (n b: nat) {h: nat}: $ bb215ArithmeticFormulaLessGraph n b <-> n < b $;

def bb215ArithmeticFormulaUpperGraph (b .T: nat): wff = $ A. T (bb215TableArithmeticValidPolynomial T -> bb215ArithmeticFormulaHaltsGraph T -> bb215ArithmeticFormulaHaltedGraph T b) $;

theorem bb215ArithmeticFormulaUpperGraph_correct (b: nat) {T: nat}: $ bb215ArithmeticFormulaUpperGraph b <-> bb215Upper b $;

def bb215ArithmeticFormulaFirstGraph (T b .n: nat): wff = $ bb215ArithmeticFormulaHaltedGraph T b /\ A. n (bb215ArithmeticFormulaLessGraph n b -> bb215ArithmeticFormulaNonHaltedGraph T n) $;

theorem bb215ArithmeticFormulaFirstGraph_correct (T b: nat) {n: nat}: $ bb215ArithmeticFormulaFirstGraph T b <-> bb215First T b $;

def bb215ArithmeticFormulaValueGraph (b .T: nat): wff = $ bb215ArithmeticFormulaUpperGraph b /\ E. T (bb215TableArithmeticValidPolynomial T /\ bb215ArithmeticFormulaFirstGraph T b) $;

theorem bb215ArithmeticFormulaValueGraph_correct (b: nat) {T: nat}: $ bb215ArithmeticFormulaValueGraph b <-> bb215Value b $;
