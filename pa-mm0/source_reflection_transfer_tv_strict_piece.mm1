pub theorem sfTVStrictPiece_conditional_zfr(level P:nat)(hl:$ sfBound 2 level $)(hp:$ sfBound 2 P $): $ sfTheoryProvable zfrAxioms (sfImp (sfTVStrictPieceBound P) (sfReflectionCondPiecesBound level P)) $ = (named '(ax_mp sfTheory_pure (sfTVStrictPiece_conditional hl hp)));

pub theorem sfTVStrictPieceBound_from_witnesses(level P:nat)(hl:$ sfBound 2 level $)(hp:$ sfBound 2 P $)(hm:$ sfTheoryProvable zfrAxioms (sfPieceMonoCode P) $)(he:$ sfTheoryProvable zfrAxioms (sfPieceHasOrdinal P) $): $ sfTheoryProvable zfrAxioms (sfTVStrictPieceBound P) $ = (named '(ax_mp (ax_mp sfTheoryProvable_gen zfrAxioms_closed) (ax_mp (ax_mp sfTheoryProvable_gen zfrAxioms_closed) (sfTVTheory_syllogism zfrAxioms_closed (sfTVTheory_syllogism zfrAxioms_closed sfTVStrictMember_exists_if_ordinal (ax_mp (ax_mp sfTheoryProvable_mp (ax_mp (ax_mp sfTheoryProvable_mp (ax_mp (ax_mp sfTheoryProvable_mp (sfPieceJoin_zfr (ax_mp sfBound_wf hp) sfWf_mem)) (ax_mp (ax_mp sfTheoryProvable_shift zfrAxioms_closed) hm))) (ax_mp (ax_mp sfTheoryProvable_shift zfrAxioms_closed) sfTVStrictMember_mono_zfr))) he)) (sfTVStrictPiece_reorder_zfr hl hp)))));

pub theorem sfTVCondPiecesBound_from_witnesses(level P:nat)(hl:$ sfBound 2 level $)(hp:$ sfBound 2 P $)(hm:$ sfTheoryProvable zfrAxioms (sfPieceMonoCode P) $)(he:$ sfTheoryProvable zfrAxioms (sfPieceHasOrdinal P) $): $ sfTheoryProvable zfrAxioms (sfReflectionCondPiecesBound level P) $ = (named '(ax_mp (ax_mp sfTheoryProvable_mp (sfTVStrictPiece_conditional_zfr hl hp)) (sfTVStrictPieceBound_from_witnesses hl hp hm he)));
