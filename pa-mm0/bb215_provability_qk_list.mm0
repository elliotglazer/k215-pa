import "bb215_provability_qk_graph.mm0";

-- QK semantics, list lemmas over L06's tail-recursive drop (lane L07).

theorem bb215ProvabilityQK_head_eq0 (l: nat): $ bb215ArithmeticFormulaListHead l = 0 <-> l = 0 $;

theorem bb215ProvabilityQK_cons_decomp (l: nat): $ l != 0 -> l = fst (l - 1) : bb215ArithmeticFormulaListTail l $;

theorem bb215ProvabilityQK_head_suc (l b: nat): $ bb215ArithmeticFormulaListHead l = suc b -> l = b : bb215ArithmeticFormulaListTail l $;

theorem bb215ProvabilityQK_drop_comp (d k l: nat): $ bb215ArithmeticFormulaListDrop d (bb215ArithmeticFormulaListDrop k l) = bb215ArithmeticFormulaListDrop (d + k) l $;

theorem bb215ProvabilityQK_drop_ne0 (i l: nat): $ bb215ArithmeticFormulaListDrop i l != 0 <-> i < len l $;

theorem bb215ProvabilityQK_drop_len (l: nat): $ bb215ArithmeticFormulaListDrop (len l) l = 0 $;

theorem bb215ProvabilityQK_head_drop_mem (j k l b: nat): $ bb215ArithmeticFormulaListHead (bb215ArithmeticFormulaListDrop j l) = suc b /\ k <= j -> b IN bb215ArithmeticFormulaListDrop k l $;

theorem bb215ProvabilityQK_mem_drop_head (b k l: nat) {j: nat}: $ b IN bb215ArithmeticFormulaListDrop k l -> E. j (k <= j /\ bb215ArithmeticFormulaListHead (bb215ArithmeticFormulaListDrop j l) = suc b) $;

theorem bb215ProvabilityQK_valid_tail (R: set) (l: nat): $ traceValid R l -> traceValid R (bb215ArithmeticFormulaListTail l) $;

theorem bb215ProvabilityQK_valid_drop (R: set) (i l: nat): $ traceValid R l -> traceValid R (bb215ArithmeticFormulaListDrop i l) $;

theorem bb215ProvabilityQK_cons_le1 (a l: nat): $ a <= a : l $;

theorem bb215ProvabilityQK_cons_le2 (a l: nat): $ l <= a : l $;

theorem bb215ProvabilityQK_drop_len_zero: $ bb215ArithmeticFormulaListDrop (len 0) 0 = 0 $;
