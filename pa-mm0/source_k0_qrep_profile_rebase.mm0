import "source_k0_qrep_profile.mm0";

import "k218q_quotient_mixed_rebase.mm0";

theorem sfK0QRepRelation_rebase (E: set) (n t u v R S phi: nat) (hf: $ sfBound (suc (suc n)) phi $) (hR: $ 0 < R $) (hS: $ 0 < S $) (htR: $ t < R $) (htS: $ t < S $) (huR: $ u < R $) (huS: $ u < S $) (hvR: $ v < R $) (hvS: $ v < S $) (heR: $ sqEnvBelow E n R $) (heS: $ sqEnvBelow E n S $):
 $ k218IEquivalent (sfK0QRepRelation E t R u v phi) (sfK0QRepRelation E t S u v phi) $;

theorem sfK0QRepRawProfile_rebase (E: set) (n t a c u w y x R S phi: nat) (hf: $ sfBound (suc (suc n)) phi $) (hR: $ 0 < R $) (hS: $ 0 < S $) (htR: $ t < R $) (htS: $ t < S $) (huR: $ u < R $) (huS: $ u < S $) (hwR: $ w < R $) (hwS: $ w < S $) (hyR: $ y < R $) (hyS: $ y < S $) (hxR: $ x < R $) (hxS: $ x < S $) (heR: $ sqEnvBelow E n R $) (heS: $ sqEnvBelow E n S $):
 $ k218IEquivalent (sfK0QRepRawProfile E t a c u w y x R phi) (sfK0QRepRawProfile E t a c u w y x S phi) $;
