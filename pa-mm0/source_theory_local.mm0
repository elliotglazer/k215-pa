import "source_theory_support.mm0";
import "source_local_extra.mm0";

theorem sfTheory_local (T: set) (G a: nat)
  (hg: $ sfTheoryContext T G $):
  $ nsLocal G a -> sfTheoryProvable T a $;

theorem sfTheory_pure (T: set) (a: nat):
  $ nsLocal 0 a -> sfTheoryProvable T a $;

-- A finite source derivation may use already proved lemmas. Their
-- individual finite axiom supports are combined inside PA.
theorem sfTheory_lemma_context (T: set) (G a: nat)
  (ht: $ sfTheoryClosed T $):
  $ all (sfTheoryProofClass T) G -> nsLocal G a -> sfTheoryProvable T a $;
