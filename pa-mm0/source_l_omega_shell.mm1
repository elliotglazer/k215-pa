pub theorem sfLOmegaShell_context: $ slOSContext = sfLBackground $ = 'eqid;

pub theorem sfLOmegaShell_formula: $ slOSFormula = sfImp sfLTransitivity (sfImp sfLOrdinalsInL (sfRelativize sfLDomain zfcOmega)) $ = '(nsImp_eq eqid (nsImp_eq eqid (eqcom slOEqRel59)));

pub theorem sfLOmegaShell_local: $ nsLocal sfLBackground (sfImp sfLTransitivity (sfImp sfLOrdinalsInL (sfRelativize sfLDomain zfcOmega))) $ = '(mpbi (nsLocal_context_eq sfLOmegaShell_context) (mpbi (nsLocal_formula_eq sfLOmegaShell_formula) slOSCertificate));

pub theorem sfLOmegaShell_zfr: $ sfTheoryProvable zfrAxioms (sfImp sfLTransitivity (sfImp sfLOrdinalsInL (sfRelativize sfLDomain zfcOmega))) $ = '(ax_mp (sfTheory_local sfLBackground_zfr) sfLOmegaShell_local);

pub theorem sfLOmega_from_ordinals: $ sfTheoryProvable zfrAxioms sfLOrdinalsInL -> sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcOmega) $ = '(ax_mp sfTheoryProvable_mp (ax_mp (ax_mp sfTheoryProvable_mp sfLOmegaShell_zfr) sfLTransitivity_weak_zfr));
