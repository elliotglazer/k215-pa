import "source_piece_pcf_rep_empty_replay.mm1";
import "source_l_background.mm1";
import "source_theory_local.mm1";

def sfPieceRepEmptyFormula:nat = $ pcfrEFormula $;
pub theorem sfPieceRepEmpty_context: $ pcfrEContext = sfLBackground $ = 'eqid;
pub theorem sfPieceRepEmpty_local: $ nsLocal sfLBackground sfPieceRepEmptyFormula $ =
 '(mpbi (nsLocal_context_eq sfPieceRepEmpty_context) pcfrECertificate);
pub theorem sfPieceRepEmpty_zfr: $ sfTheoryProvable zfrAxioms sfPieceRepEmptyFormula $ =
 '(ax_mp (sfTheory_local sfLBackground_zfr) sfPieceRepEmpty_local);
