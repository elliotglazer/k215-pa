pub theorem k215UnpairMacro2248 (n a b c: nat): $ k215PReach (k215UnpairAt2248State k215PNum2248 a b n c) (k215UnpairAt2248State k215PNum2256 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
