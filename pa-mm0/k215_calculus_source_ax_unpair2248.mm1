theorem k215UnpairAt2248AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt2248State k215PNum2248 0 b (suc n) c) (k215UnpairAt2248State k215PNum2248 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
