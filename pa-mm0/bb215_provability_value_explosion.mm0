import "bb215_arithmetic_sentence_syntax.mm0";

import "raw_source_falsity.mm0";

-- Easy half of the BB215 clause: an inconsistent ZFC proves every numeral value,
-- so if no value is ZFC-provable then ZFC is consistent.

theorem bb215ProvabilityValue_explosion (b: nat): $ zfcInconsistent -> zfcProvable (bb215ArithmeticSentenceSource b) $;

theorem bb215ProvabilityValue_none_consistent {b: nat}: $ (A. b ~zfcProvable (bb215ArithmeticSentenceSource b)) -> ~zfcInconsistent $;

theorem bb215ProvabilityValue_inconsistent_provable {b: nat}: $ zfcInconsistent -> ~(A. b ~zfcProvable (bb215ArithmeticSentenceSource b)) $;
