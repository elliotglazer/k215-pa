import "source_reflection_cond_ordinal_nd.mm0";

import "source_core_theory.mm0";

import "source_theory_local.mm0";

import "zfc_irreflexive.mm0";

def rcondOrdF0: nat = $ sfMem 0 1 $;

def rcondOrdF1: nat = $ sfBot $;

def rcondOrdF2: nat = $ sfImp rcondOrdF0 rcondOrdF1 $;

def rcondOrdF3: nat = $ sfAll rcondOrdF2 $;

def rcondOrdF4: nat = $ sfEx rcondOrdF3 $;

def rcondOrdG5: nat = $ rcondOrdF4 : 0 $;

def rcondOrdF6: nat = $ sfMem 0 2 $;

def rcondOrdF7: nat = $ sfImp rcondOrdF0 rcondOrdF6 $;

def rcondOrdF8: nat = $ sfAll rcondOrdF7 $;

def rcondOrdF9: nat = $ sfImp rcondOrdF0 rcondOrdF8 $;

def rcondOrdF10: nat = $ sfAll rcondOrdF9 $;

def rcondOrdF11: nat = $ sfImp rcondOrdF0 rcondOrdF10 $;

def rcondOrdF12: nat = $ sfAll rcondOrdF11 $;

def rcondOrdF13: nat = $ sfAnd rcondOrdF10 rcondOrdF12 $;

def rcondOrdF14: nat = $ sfEx rcondOrdF13 $;

def sfReflectionCondOrdinalAxiom0:nat = $ rcondOrdF4 $;

def sfReflectionCondOrdinalContext:nat = $ rcondOrdG5 $;

def sfReflectionCondOrdinalWitness:nat = $ rcondOrdF14 $;

theorem sfReflectionCondOrdinalAxiom0_zfr: $ sfReflectionCondOrdinalAxiom0 e. zfrAxioms $;

theorem sfReflectionCondOrdinal_pure: $ nsLocal sfReflectionCondOrdinalContext sfReflectionCondOrdinalWitness $;

theorem sfReflectionCondOrdinal_closed: $ sfBound 0 sfReflectionCondOrdinalWitness $;

theorem sfReflectionCondOrdinalContext_zfr: $ sfTheoryContext zfrAxioms sfReflectionCondOrdinalContext $;

theorem sfReflectionCondOrdinalWitness_zfr: $ sfTheoryProvable zfrAxioms sfReflectionCondOrdinalWitness $;
