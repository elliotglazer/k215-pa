import "k218q_matrix_rebase.mm1";
import "k218q_closure_relabel.mm1";

pub theorem k218QClosure_matrix_rebase (E: set) (n B L a b c u v p w x y f: nat)
 (hf: $ sfBound (suc (suc n)) f $)
 (hB: $ sqRebaseHygiene E n B f 0 $) (hL: $ sqRebaseHygiene E n L f 0 $)
 (huB: $ sqAllocAvoid B (suc f) u $)
 (huL: $ sqAllocAvoid L (suc f) u $)
 (hvB: $ sqAllocAvoid B (suc f) v $)
 (hvL: $ sqAllocAvoid L (suc f) v $)
 (hpB: $ sqAllocAvoid B (suc f) p $)
 (hpL: $ sqAllocAvoid L (suc f) p $)
 (hxB: $ sqAllocAvoid B (suc f) x $)
 (hxL: $ sqAllocAvoid L (suc f) x $)
 (hyB: $ sqAllocAvoid B (suc f) y $)
 (hyL: $ sqAllocAvoid L (suc f) y $):
 $ k218IEquivalent
     (k218ClosureSeparated E n B a b c u v p w x y f)
     (k218ClosureSeparated E n L a b c u v p w x y f) $ =
'(ax_mp k218IEquivalent_all (ax_mp k218IEquivalent_imp (ian k218IEquivalent_refl (ax_mp k218IEquivalent_exists (ax_mp k218IEquivalent_and (ian (k218QMatrix_pair_rebase hf hB hL huB hvB huL hvL) (ax_mp k218IEquivalent_all (ax_mp k218IEquivalent_imp (ian (ax_mp k218IEquivalent_all (ax_mp k218IEquivalent_imp (ian k218IEquivalent_refl k218IEquivalent_refl))) (ax_mp k218IEquivalent_all (ax_mp k218IEquivalent_imp (ian (k218QMatrix_pair_rebase hf hB hL hxB hpB hxL hpL) (ax_mp k218IEquivalent_exists (ax_mp k218IEquivalent_and (ian (k218QMatrix_pair_rebase hf hB hL hyB hpB hyL hpL) k218IEquivalent_refl)))))))))))))));
