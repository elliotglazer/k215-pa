import "k215_literal_symbolic_base.mm0";

def k215SymC (v r: nat): nat = $ k215TmPush 1 (k215TmPush 0 (k215TmRepeat 1 v r)) $;

def k215SymRB (v r: nat): nat = $ k215TmRepeat 1 (suc v) (k215TmPush 0 r) $;

def k215SymRC (v r: nat): nat = $ k215TmRepeat 1 v (k215TmPush 0 (k215TmPush 1 r)) $;

theorem k215SymBlock0 (a0 l r: nat): $ k215TMReach (k215TMState k215Num64 l (k215TmRegister a0 r)) (k215TMState k215Num64 (k215SymRB a0 l) r) $;

theorem k215SymBlock1 (a0 l r: nat): $ k215TMReach (k215TMState 0 l (k215TmRegister a0 r)) (k215TMState 0 (k215SymRC a0 l) r) $;

theorem k215SymBlock2 (a0 l r: nat): $ k215TMReach (k215TmLeftState k215Num40 (k215SymRB a0 l) r) (k215TmLeftState k215Num40 l (k215TmRegister a0 r)) $;

theorem k215SymBlock3 (a0 l r: nat): $ k215TMReach (k215TmLeftState k215Num96 (k215SymRC a0 l) r) (k215TmLeftState k215Num96 l (k215TmRegister a0 r)) $;
