import "source_piece_pcf_rep_prefix_r29.mm0";

import "source_piece_pcf_triple_maps.mm0";

theorem pcr30_rotate0: $ sfPieceRepRotate3 @ 0 = 1 $;

theorem pcr30_rotate1: $ sfPieceRepRotate3 @ 1 = 2 $;

theorem pcr30_rotate2: $ sfPieceRepRotate3 @ 2 = 3 $;

theorem pcr30_rotate3: $ sfPieceRepRotate3 @ 3 = 0 $;

theorem pcr30_rotate_tail(i:nat): $ sfPieceRepRotate3 @ (suc (suc (suc (suc i)))) = suc (suc (suc (suc i))) $;

theorem sfPieceRepPrefix_insert_rotate(r a:nat)(hr:$ sfPieceRepRotate3 @ r = suc r $)(hf:$ sfWf a $): $ sfRename (sfLCBinaryMap r 1 3) 1 (sfRename sfPieceRotate 0 a) = sfRename sfPieceRepRotate3 0 (sfRename (sfLCBinaryMap r 1 3) 0 a) $;

theorem sfPieceRepPrefix_old_wf(n a:nat)(hf:$ sfWf a $): $ sfWf (sfPieceDn n a) $;

theorem sfPieceRepPrefix_new_wf(n a:nat)(hf:$ sfWf a $): $ sfWf (sfPieceRepDn3Core n a) $;

theorem sfPieceRepPrefix_insert(r n a:nat)(hr:$ sfPieceRepRotate3 @ r = suc r $)(hf:$ sfWf a $): $ sfRename (sfLCBinaryMap r 1 3) 0 (sfPieceDn n a) = sfPieceRepDn3Core n (sfRename (sfLCBinaryMap r 1 3) 0 a) $;
