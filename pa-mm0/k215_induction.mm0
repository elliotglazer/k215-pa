-- Dominated-rho8 K215 calculus. Shared arithmetic codes only; no K218 provability import.
import "k215_proofs.mm0";
import "trace_soundness.mm0";

-- P is a formula abstraction over numbers, not a quantified set object.
def k215MPClosed (P: set) (.a .b: nat): wff =
  $ A. a A. b (a e. P /\ kImp a b e. P -> b e. P) $;
def k215GenClosed (P: set) (.a .b: nat): wff =
  $ A. a A. b (b e. P -> kAll a b e. P) $;
def k215Closed (P: set): wff =
  $ k215Axioms C_ P /\ k215MPClosed P /\ k215GenClosed P $;
def k215Provable (a: nat) (.p: nat): wff = $ E. p k215Derives p a $;
def k215Theorems (.a: nat): set = $ {a | k215Provable a} $;

theorem k215MPClosed_apply (P: set) (a b: nat):
  $ k215MPClosed P -> a e. P /\ kImp a b e. P -> b e. P $;
theorem k215GenClosed_apply (P: set) (a b: nat):
  $ k215GenClosed P -> b e. P -> kAll a b e. P $;
theorem k215Closed_ruleSound (P: set): $ k215Closed P -> traceRuleSound k215Rules P $;
theorem k215Derives_induction (P: set) (p a: nat):
  $ k215Closed P -> k215Derives p a -> a e. P $;
theorem k215Provable_intro (p a: nat): $ k215Derives p a -> k215Provable a $;
theorem k215Provable_induction (P: set) (a: nat):
  $ k215Closed P -> k215Provable a -> a e. P $;
theorem k215Provable_axiom (a: nat): $ a e. k215Axioms -> k215Provable a $;
theorem k215Provable_mp (a b: nat):
  $ k215Provable a -> k215Provable (kImp a b) -> k215Provable b $;
theorem k215Provable_gen (a b: nat): $ k215Provable b -> k215Provable (kAll a b) $;
theorem k215Theorems_value (a: nat): $ a e. k215Theorems <-> k215Provable a $;
theorem k215Theorems_closed: $ k215Closed k215Theorems $;
theorem k215Theorems_least (P: set): $ k215Closed P -> k215Theorems C_ P $;
