import "bb215_arithmetic_formula_depth_four_sat.mm0";

import "pa_source_interpretation_nat_term_assignment.mm0";

def bb215ArithmeticFormulaDepthFiveSatBody (E: set) (c h .x: nat): wff = $ ifp (c = 0) (0 != 0) (ifp (sfTag c = 1) (bb215ArithmeticFormulaTermValue E (sfLeft c) = bb215ArithmeticFormulaTermValue E (sfRight c)) (ifp (sfTag c = 3) (sfLeft c e. h /\ sfRight c e. h) (ifp (sfTag c = 4) (sfLeft c e. h \/ sfRight c e. h) (ifp (sfTag c = 5) (sfLeft c e. h -> sfRight c e. h) (ifp (sfTag c = 6 /\ sfRight c = 0) (A. x bb215ArithmeticFormulaDepthFourSat (paNatTermConsEnvironment E x) (sfLeft c)) (ifp (sfTag c = 7 /\ sfRight c = 0) (E. x bb215ArithmeticFormulaDepthFourSat (paNatTermConsEnvironment E x) (sfLeft c)) (0 != 0))))))) $;

def bb215ArithmeticFormulaDepthFiveSatStep (E: set) (.c .h: nat): set = $ S\ c, {h | bb215ArithmeticFormulaDepthFiveSatBody E c h} $;

def bb215ArithmeticFormulaDepthFiveSat (E: set) (c: nat): wff = $ srecp (bb215ArithmeticFormulaDepthFiveSatStep E) c $;

def bb215ArithmeticFormulaDepthFiveSatPrevious (E: set) (c .i: nat): nat = $ sep (upto c) {i | srecp (bb215ArithmeticFormulaDepthFiveSatStep E) i} $;

theorem bb215ArithmeticFormulaDepthFiveSatStep_value (E: set) (c h: nat): $ (c, h) e. bb215ArithmeticFormulaDepthFiveSatStep E <-> bb215ArithmeticFormulaDepthFiveSatBody E c h $;

theorem bb215ArithmeticFormulaDepthFiveSatPrevious_value (E: set) (c a: nat): $ a e. bb215ArithmeticFormulaDepthFiveSatPrevious E c <-> a < c /\ bb215ArithmeticFormulaDepthFiveSat E a $;

theorem bb215ArithmeticFormulaDepthFiveSat_unfold (E: set) (c: nat): $ bb215ArithmeticFormulaDepthFiveSat E c <-> bb215ArithmeticFormulaDepthFiveSatBody E c (bb215ArithmeticFormulaDepthFiveSatPrevious E c) $;

theorem bb215ArithmeticFormulaDepthFiveSat_false (E: set): $ bb215ArithmeticFormulaDepthFiveSat E paFormulaFalse <-> 0 != 0 $;

theorem bb215ArithmeticFormulaDepthFiveSat_equal (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthFiveSat E (paFormulaEqual a b) <-> bb215ArithmeticFormulaTermValue E a = bb215ArithmeticFormulaTermValue E b $;

theorem bb215ArithmeticFormulaDepthFiveSat_and (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthFiveSat E (paFormulaAnd a b) <-> (bb215ArithmeticFormulaDepthFiveSat E a /\ bb215ArithmeticFormulaDepthFiveSat E b) $;

theorem bb215ArithmeticFormulaDepthFiveSat_or (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthFiveSat E (paFormulaOr a b) <-> (bb215ArithmeticFormulaDepthFiveSat E a \/ bb215ArithmeticFormulaDepthFiveSat E b) $;

theorem bb215ArithmeticFormulaDepthFiveSat_imp (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthFiveSat E (paFormulaImp a b) <-> (bb215ArithmeticFormulaDepthFiveSat E a -> bb215ArithmeticFormulaDepthFiveSat E b) $;

theorem bb215ArithmeticFormulaDepthFiveSat_all (E: set) (a: nat) {x: nat}: $ bb215ArithmeticFormulaDepthFiveSat E (paFormulaAll a) <-> A. x bb215ArithmeticFormulaDepthFourSat (paNatTermConsEnvironment E x) a $;

theorem bb215ArithmeticFormulaDepthFiveSat_ex (E: set) (a: nat) {x: nat}: $ bb215ArithmeticFormulaDepthFiveSat E (paFormulaEx a) <-> E. x bb215ArithmeticFormulaDepthFourSat (paNatTermConsEnvironment E x) a $;
