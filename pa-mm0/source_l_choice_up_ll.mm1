'(! cu_ex_U $ G $ $ srcLHierarchyInterfaceF797 $ hg clw_797 (clu_U_797 (cu_ux_w hg) (cu_ux_t hg ht) (cu_ux_0 hg) (cu_ux_l hg h0) (cu_ux_l hg h2)));
theorem clu_U_799 (G: nat) (hg: $ sfContextWf G $) (ht: $ nsLocal G sfLTransC $) (h1: $ nsLocal G (sfLChoiceD 1) $):
 $ nsLocal G (sfImp (sfRelativize sfLDomain srcLHierarchyInterfaceF799) srcLHierarchyInterfaceF799) $ =
'(! cu_ex_U $ G $ $ srcLHierarchyInterfaceF798 $ hg clw_798 (clu_U_798 (cu_ux_w hg) (cu_ux_t hg ht) (cu_ux_0 hg) (cu_ux_l hg h1)));

-- LL(1,0) is the tree above.
theorem clu_ll_eq: $ srcLHierarchyInterfaceF799 = sfCLHierarchyAt 1 0 $ =
'(eqtr (eqcom srcLHierarchyInterfacePoint2752) (eqcom sfCL2_hierarchy_relation));

theorem clu_ctx_shift: $ sfContextShift (sfLTransC : 0) = sfLTransC : 0 $ =
'(eqtr sfContextShift_cons (conseq (ax_mp sfShift_closed_identity cu_trans_bound) sfContextShift_nil));

theorem clu_ctx_wf: $ sfContextWf (sfLTransC : 0) $ =
'(cu_cons_wf (ax_mp sfBound_wf cu_trans_bound) sfContextWf_nil);

theorem clu_g3_wf:
 $ sfContextWf (sfRelativize sfLDomain (sfCLHierarchyAt 1 0) : (sfLChoiceD 0 : (sfLChoiceD 1 : (sfLTransC : 0)))) $ =
'(cu_cons_wf chi_relwf (cu_cons_wf chi_dwf (cu_cons_wf chi_dwf clu_ctx_wf)));

theorem clu_g3:
 $ nsLocal (sfRelativize sfLDomain (sfCLHierarchyAt 1 0) : (sfLChoiceD 0 : (sfLChoiceD 1 : (sfLTransC : 0))))
   (sfCLHierarchyAt 1 0) $ =
'(ax_mp (ax_mp nsLocal_mp
  (mpbi (nsLocal_formula_eq (nsImp_eq (sfRelativizeeq2 clu_ll_eq) clu_ll_eq))
   (clu_U_799 clu_g3_wf
    (ax_mp (ax_mp nsLocal_hyp clu_g3_wf)
     (ax_mp sfContext_member_tail (ax_mp sfContext_member_tail (ax_mp sfContext_member_tail sfContext_member_head))))
    (ax_mp (ax_mp nsLocal_hyp clu_g3_wf) (ax_mp sfContext_member_tail (ax_mp sfContext_member_tail sfContext_member_head))))))
  (ax_mp (ax_mp nsLocal_hyp clu_g3_wf) sfContext_member_head));

theorem clu_up_local: $ nsLocal (sfLTransC : 0) sfLChoiceUp $ =
'(ax_mp (sfLocal_allI clu_ctx_wf) (mpbir (nsLocal_context_eq clu_ctx_shift)
  (ax_mp (sfLocal_allI clu_ctx_wf) (mpbir (nsLocal_context_eq clu_ctx_shift)
   (ax_mp nsLocal_II (ax_mp nsLocal_II (ax_mp nsLocal_II clu_g3)))))));

pub theorem sfLChoiceUp_from_trans (hT: $ sfTheoryProvable zfrAxioms sfLTransC $):
 $ sfTheoryProvable zfrAxioms sfLChoiceUp $ =
'(ax_mp (ax_mp sfTheoryProvable_mp (ax_mp (sfTheory_local sfTheoryContext_nil) (ax_mp nsLocal_II clu_up_local))) hT);

pub theorem sfLChoice_from_hierarchy_trans
 (hi: $ sfRelativeAxiomImages zfrAxioms zfrAxioms sfLDomain $)
 (hN: $ sfTheoryProvable zfrAxioms (sfEx sfLDomain) $)
 (hE: $ sfTheoryProvable zfrAxioms sfLUniversalHierarchyExists $)
 (hU: $ sfTheoryProvable zfrAxioms sfLUniversalHierarchyUnique $)
 (h2: $ sfTheoryProvable zfrAxioms sfLChoiceT2 $)
 (hT: $ sfTheoryProvable zfrAxioms sfLTransC $)
 (hOL: $ sfTheoryProvable zfrAxioms sfLChoiceOrdL $):
 $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcChoice) $ =
'(sfLChoice_from_hierarchy_laws hi hN hE hU h2 (sfLChoiceUp_from_trans hT) hOL);

