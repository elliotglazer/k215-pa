import "pa_source_interpretation_term_role_shifts.mm0";

import "source_formula_equality_transport.mm0";

import "pa_source_interpretation_natural.mm0";

import "pa_source_interpretation_rebase.mm0";

import "source_renaming_agreement.mm0";

import "source_theory_local.mm0";

import "source_wf_separation_logic.mm0";

def paTMGEMapCons (a: nat) (R: set) (.i: nat): set = $ \ i, if (i = 0) a (R @ (i - 1)) $;

def paTMGEMapAdd (t .i: nat): set = $ \ i, i + t $;

def paSITermGraphEqualityF0 (phi: nat): nat = $ sfEq 1 0 $;

def paTMGEMap1: set = $ paTMGEMapAdd 1 $;

def paSITermGraphEqualityF1 (phi: nat): nat = $ sfRename paTMGEMap1 0 phi $;

def paTMGEMap3: set = $ paTMGEMapAdd 2 $;

def paTMGEMap2: set = $ paTMGEMapCons 0 paTMGEMap3 $;

def paSITermGraphEqualityF2 (phi: nat): nat = $ sfRename paTMGEMap2 0 phi $;

def paSITermGraphEqualityF3 (phi: nat): nat = $ sfImp (paSITermGraphEqualityF1 phi) (paSITermGraphEqualityF2 phi) $;

def paSITermGraphEqualityF4 (phi: nat): nat = $ sfImp (paSITermGraphEqualityF0 phi) (paSITermGraphEqualityF3 phi) $;

def paSITermGraphEqualityF5 (phi: nat): nat = $ sfAll (paSITermGraphEqualityF4 phi) $;

def paSourceTermOutputTransportLiteral (phi: nat): nat = $ sfAll (paSITermGraphEqualityF5 phi) $;

def paTMGEMap5: set = $ paTMGEMapAdd 3 $;

def paTMGEMap4: set = $ paTMGEMapCons 0 paTMGEMap5 $;

def paSourceTermOutputTransport (phi: nat): nat = $ sfAll (sfAll (sfImp (sfEq 1 0) (sfImp (sfShift 0 phi) (sfShift 1 phi)))) $;

theorem paSourceTermOutputTransport_exact (phi n: nat) (hf: $ sfBound (suc n) phi $): $ paSourceTermOutputTransport phi = paSourceTermOutputTransportLiteral phi $;

theorem paSourceTermOutputTransport_provable (phi n: nat) (hf: $ sfBound (suc n) phi $): $ zfcProvable (paSourceTermOutputTransport phi) $;

def paTMGEMap7: set = $ paTMGEMapAdd 4 $;

def paTMGEMap6: set = $ paTMGEMapCons 1 paTMGEMap7 $;

def paSITermGraphEqualityF6 (phi: nat): nat = $ sfRename paTMGEMap6 0 phi $;

def paTMGEMap8: set = $ paTMGEMapCons 0 paTMGEMap7 $;

def paSITermGraphEqualityF7 (phi: nat): nat = $ sfRename paTMGEMap8 0 phi $;

def paSITermGraphEqualityF8 (phi: nat): nat = $ sfImp (paSITermGraphEqualityF6 phi) (paSITermGraphEqualityF7 phi) $;

def paSITermGraphEqualityF9 (phi: nat): nat = $ sfImp (paSITermGraphEqualityF0 phi) (paSITermGraphEqualityF8 phi) $;

def paSITermGraphEqualityF10 (phi: nat): nat = $ sfAll (paSITermGraphEqualityF9 phi) $;

def paSITermGraphEqualityF11 (phi: nat): nat = $ sfAll (paSITermGraphEqualityF10 phi) $;

def paSITermGraphEqualityF12 (phi: nat): nat = $ sfImp (paSITermGraphEqualityF7 phi) (paSITermGraphEqualityF0 phi) $;

def paSITermGraphEqualityF13 (phi: nat): nat = $ sfImp (paSITermGraphEqualityF6 phi) (paSITermGraphEqualityF12 phi) $;

def paSITermGraphEqualityF14 (phi: nat): nat = $ sfAll (paSITermGraphEqualityF13 phi) $;

def paSITermGraphEqualityF15 (phi: nat): nat = $ sfAll (paSITermGraphEqualityF14 phi) $;

def paSITermGraphEqualityF16 (phi: nat): nat = $ sfRename paTMGEMap3 0 phi $;

def paSITermGraphEqualityF17 (phi: nat): nat = $ sfRename paTMGEMap4 0 phi $;

def paSITermGraphEqualityF18 (phi: nat): nat = $ sfEq 2 0 $;

def paSITermGraphEqualityF19 (phi: nat): nat = $ sfImp (paSITermGraphEqualityF17 phi) (paSITermGraphEqualityF18 phi) $;

def paSITermGraphEqualityF20 (phi: nat): nat = $ sfImp (paSITermGraphEqualityF16 phi) (paSITermGraphEqualityF19 phi) $;

def paSITermGraphEqualityF21 (phi: nat): nat = $ sfAll (paSITermGraphEqualityF20 phi) $;

def paSITermGraphEqualityF22 (phi: nat): nat = $ sfImp (paSITermGraphEqualityF2 phi) (paSITermGraphEqualityF0 phi) $;

def paSITermGraphEqualityF23 (phi: nat): nat = $ sfImp (paSITermGraphEqualityF1 phi) (paSITermGraphEqualityF22 phi) $;

def paSITermGraphEqualityF24 (phi: nat): nat = $ sfEq 0 2 $;

def paSITermGraphEqualityF25 (phi: nat): nat = $ sfImp (paSITermGraphEqualityF18 phi) (paSITermGraphEqualityF24 phi) $;

def paSITermGraphEqualityF26 (phi: nat): nat = $ sfAll (paSITermGraphEqualityF25 phi) $;

def paSITermGraphEqualityF27 (phi: nat): nat = $ sfEq 0 1 $;

def paSITermGraphEqualityF28 (phi: nat): nat = $ sfImp (paSITermGraphEqualityF0 phi) (paSITermGraphEqualityF27 phi) $;

def paSITermGraphEqualityF29 (phi: nat): nat = $ sfImp (paSITermGraphEqualityF2 phi) (paSITermGraphEqualityF27 phi) $;

def paSITermGraphEqualityF30 (phi: nat): nat = $ sfAll (paSITermGraphEqualityF28 phi) $;

def paSITermGraphEqualityF31 (phi: nat): nat = $ sfImp (paSITermGraphEqualityF27 phi) (paSITermGraphEqualityF0 phi) $;

def paSITermGraphEqualityF32 (phi: nat): nat = $ sfImp (paSITermGraphEqualityF16 phi) (paSITermGraphEqualityF17 phi) $;

def paSITermGraphEqualityF33 (phi: nat): nat = $ sfImp (paSITermGraphEqualityF18 phi) (paSITermGraphEqualityF32 phi) $;

def paSITermGraphEqualityF34 (phi: nat): nat = $ sfAll (paSITermGraphEqualityF33 phi) $;

def paSITermGraphEqualityF35 (phi: nat): nat = $ sfImp (paSITermGraphEqualityF27 phi) (paSITermGraphEqualityF2 phi) $;

def paSITermGraphEqualityF36 (phi: nat): nat = $ sfAnd (paSITermGraphEqualityF29 phi) (paSITermGraphEqualityF35 phi) $;

def paSITermGraphEqualityF37 (phi: nat): nat = $ sfImp (paSITermGraphEqualityF1 phi) (paSITermGraphEqualityF36 phi) $;

def paTMGEMap9: set = $ paTMGEMapCons 1 paTMGEMap5 $;

def paSITermGraphEqualityF38 (phi: nat): nat = $ sfRename paTMGEMap9 0 phi $;

def paSITermGraphEqualityF39 (phi: nat): nat = $ sfImp (paSITermGraphEqualityF38 phi) (paSITermGraphEqualityF17 phi) $;

def paSITermGraphEqualityF40 (phi: nat): nat = $ sfImp (paSITermGraphEqualityF0 phi) (paSITermGraphEqualityF39 phi) $;

def paSITermGraphEqualityF41 (phi: nat): nat = $ sfAll (paSITermGraphEqualityF40 phi) $;

def paSITermGraphEqualityF42 (phi: nat): nat = $ sfAll (paSITermGraphEqualityF41 phi) $;

def paSITermGraphEqualityF43 (phi: nat): nat = $ sfImp (paSITermGraphEqualityF17 phi) (paSITermGraphEqualityF0 phi) $;

def paSITermGraphEqualityF44 (phi: nat): nat = $ sfImp (paSITermGraphEqualityF38 phi) (paSITermGraphEqualityF43 phi) $;

def paSITermGraphEqualityF45 (phi: nat): nat = $ sfAll (paSITermGraphEqualityF44 phi) $;

def paSITermGraphEqualityF46 (phi: nat): nat = $ sfAll (paSITermGraphEqualityF45 phi) $;

def paSITermGraphEqualityF47 (phi: nat): nat = $ sfAll (paSITermGraphEqualityF37 phi) $;

def paSITermGraphEqualityF48 (phi: nat): nat = $ sfAll (paSITermGraphEqualityF23 phi) $;

def paSITermGraphEqualityF49 (phi: nat): nat = $ sfAll (paSITermGraphEqualityF48 phi) $;

def paSITermGraphEqualityF50 (phi: nat): nat = $ sfAll (paSITermGraphEqualityF47 phi) $;

def paSITermGraphEqualityF51 (phi: nat): nat = $ sfImp (paSITermGraphEqualityF49 phi) (paSITermGraphEqualityF50 phi) $;

def paSourceTermGraphEqualityRuleLiteral (phi: nat): nat = $ sfImp (paSITermGraphEqualityF49 phi) (paSITermGraphEqualityF50 phi) $;

theorem paSourceTermGraphEqualityRule_local (phi n: nat) (hf: $ sfBound (suc n) phi $): $ nsLocal ((paSourceTermOutputTransportLiteral phi) : (zfcSym : 0)) (paSourceTermGraphEqualityRuleLiteral phi) $;

def paSourceTermGraphEquality (phi: nat): nat = $ sfAll (sfAll (sfImp (sfShift 0 phi) (sfAnd (sfImp (sfShift 1 phi) (sfEq 0 1)) (sfImp (sfEq 0 1) (sfShift 1 phi))))) $;

def paSourceTermGraphEqualityRule (phi: nat): nat = $ sfImp (paSourceTermFunctional phi) (paSourceTermGraphEquality phi) $;

theorem paSourceTermGraphEqualityRule_exact (phi n: nat) (hf: $ sfBound (suc n) phi $): $ paSourceTermGraphEqualityRule phi = paSourceTermGraphEqualityRuleLiteral phi $;

theorem paSourceTermGraphEqualityRule_provable (phi n: nat) (hf: $ sfBound (suc n) phi $): $ zfcProvable (paSourceTermGraphEqualityRule phi) $;
