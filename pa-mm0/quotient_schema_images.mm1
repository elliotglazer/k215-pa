import "k218q_quotation_supported_theory.mm1";

@_ abstract def omegaSeparationImages (.phi .n: nat): wff = $ A. phi A. n (sfBound (suc n) phi -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 (zfcSeparationCode phi n))) $;

pub theorem oscSeparationFormula {m: nat} (phi: nat): $ omegaSeparationImages -> A. m (sfBound (suc m) phi -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 (zfcSeparationCode phi m))) $ = (named '(!! eale p ,eqtac));

pub theorem oscSeparationPrefix {m: nat} (phi n: nat): $ (A. m (sfBound (suc m) phi -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 (zfcSeparationCode phi m)))) -> sfBound (suc n) phi -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 (zfcSeparationCode phi n)) $ = (named '(!! eale m ,eqtac));

pub theorem oscSeparationAt (phi n: nat): $ omegaSeparationImages -> sfBound (suc n) phi -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 (zfcSeparationCode phi n)) $ = (named '(syl oscSeparationPrefix {oscSeparationFormula : $ omegaSeparationImages -> A. m (sfBound (suc m) phi -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 (zfcSeparationCode phi m))) $}));

@_ abstract def omegaReplacementImages (.phi .n: nat): wff = $ A. phi A. n (sfBound (suc (suc n)) phi -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 (zfcReplacementCode phi n))) $;

pub theorem oscReplacementFormula {m: nat} (phi: nat): $ omegaReplacementImages -> A. m (sfBound (suc (suc m)) phi -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 (zfcReplacementCode phi m))) $ = (named '(!! eale p ,eqtac));

pub theorem oscReplacementPrefix {m: nat} (phi n: nat): $ (A. m (sfBound (suc (suc m)) phi -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 (zfcReplacementCode phi m)))) -> sfBound (suc (suc n)) phi -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 (zfcReplacementCode phi n)) $ = (named '(!! eale m ,eqtac));

pub theorem oscReplacementAt (phi n: nat): $ omegaReplacementImages -> sfBound (suc (suc n)) phi -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 (zfcReplacementCode phi n)) $ = (named '(syl oscReplacementPrefix {oscReplacementFormula : $ omegaReplacementImages -> A. m (sfBound (suc (suc m)) phi -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 (zfcReplacementCode phi m))) $}));
