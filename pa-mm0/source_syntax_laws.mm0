import "source_contexts.mm0";
import "source_substitution.mm0";
import "source_bounds.mm0";

theorem sfSubst_shift_index_cancel (d t i: nat):
  $ sfSubstIndex d t (sfShiftIndex d i) = i $;

theorem sfSubst_shift_cancel (d t c: nat):
  $ sfWf c -> sfSubst d t (sfShift d c) = c $;

theorem sfBound_mono_le (n m c: nat): $ n <= m -> sfBound n c -> sfBound m c $;
theorem sfBound_mono (n m c: nat): $ sfBound n c -> n <= m -> sfBound m c $;

theorem sfShift_bound_identity (d c: nat): $ sfBound d c -> sfShift d c = c $;
theorem sfShift_closed_identity (c: nat): $ sfBound 0 c -> sfShift 0 c = c $;

theorem sfWf_code_bound (c: nat): $ sfWf c -> sfBound c c $;
theorem sfWf_upper_bound (c: nat): $ sfWf c -> sfBound (suc c) c $;
