import "b4_k215_halt.mm0";
import "b4_zfc_final.mm0";

theorem K215_sigma1_of {h w: nat} (hT: $ k215LiteralHalts <-> zfcInconsistent $):
  $ A. h (bdK215Halt h -> E. w bdZfcBot w) $;
theorem K215_sigma2_of {h w: nat} (hT: $ k215LiteralHalts <-> zfcInconsistent $):
  $ A. w (bdZfcBot w -> E. h bdK215Halt h) $;
