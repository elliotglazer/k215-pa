import "k218q_seed_instance.mm0";

theorem k218EqInd_larger (a b: nat): $ kEq a b < k218EqInd a b $;
def k218GrowthClass (.c: nat): set = $ {c | c <= k218Translate c} $;
theorem k218Translate_nondecreasing (c: nat): $ c <= k218Translate c $;
theorem k218QSeedCode_above_source (d: nat): $ d < k218QSeedCode d $;
theorem k218QSeedCode_source_fresh (d: nat): $ kFresh d (k218QSeedCode d) $;
theorem k218QSeedCode_matrix_fresh (d: nat): $ kFresh (kNot (kNot d)) (k218QSeedCode d) $;
