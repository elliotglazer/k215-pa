@_ def k215UnpairAt1091State (pc a b n c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) n (k215PR3 c) (k215PR4 c) (k215PR5 c) a b (k215PR8 c)) $;

do (apply (register-eqd 'k215UnpairAt1091State) '(k215UnpairAt1091Stateeqd));

theorem k215UnpairAt1091Transfer (b n c: nat): $ k215PIter (3 * b + 1) (k215UnpairAt1091State k215PNum1095 0 b n c) = (k215UnpairAt1091State k215PNum1098 b 0 n c) $ =
 '(eqtr k215Loop1095Vector (k215PStateeq2 (k215PVectoreq7 add0)));
theorem k215UnpairAt1091ReachTransfer (b n c: nat): $ k215PReach (k215UnpairAt1091State k215PNum1095 0 b n c) (k215UnpairAt1091State k215PNum1098 b 0 n c) $ =
 '(k215PReach_intro k215UnpairAt1091Transfer);


theorem k215UnpairAt1091Step9Z (a b c: nat): $ k215PStep (k215UnpairAt1091State k215PNum1091 a b 0 c) = (k215UnpairAt1091State k215PNum1099 a b 0 c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair1091_1091) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt1091Reach9Z (a b c: nat): $ k215PReach (k215UnpairAt1091State k215PNum1091 a b 0 c) (k215UnpairAt1091State k215PNum1099 a b 0 c) $ = '(k215PReach_step k215UnpairAt1091Step9Z);

theorem k215UnpairAt1091Step9S (a b n c: nat): $ k215PStep (k215UnpairAt1091State k215PNum1091 a b (suc n) c) = (k215UnpairAt1091State k215PNum1092 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair1091_1091) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet2_vector)) (eqtr k215PSet2_vector (k215PVectoreq3 (eqtr subSS sub02))))));

theorem k215UnpairAt1091Reach9S (a b n c: nat): $ k215PReach (k215UnpairAt1091State k215PNum1091 a b (suc n) c) (k215UnpairAt1091State k215PNum1092 a b n c) $ = '(k215PReach_step k215UnpairAt1091Step9S);

theorem k215UnpairAt1091Step10 (a b n c: nat): $ k215PStep (k215UnpairAt1091State k215PNum1092 a b n c) = (k215UnpairAt1091State k215PNum1093 a (suc b) n c) $ = '(eqtr (k215PAtCI k215PLookupUnpair1091_1092) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215UnpairAt1091Reach10 (a b n c: nat): $ k215PReach (k215UnpairAt1091State k215PNum1092 a b n c) (k215UnpairAt1091State k215PNum1093 a (suc b) n c) $ = '(k215PReach_step k215UnpairAt1091Step10);

theorem k215UnpairAt1091Step11Z (b n c: nat): $ k215PStep (k215UnpairAt1091State k215PNum1093 0 b n c) = (k215UnpairAt1091State k215PNum1095 0 b n c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair1091_1093) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt1091Reach11Z (b n c: nat): $ k215PReach (k215UnpairAt1091State k215PNum1093 0 b n c) (k215UnpairAt1091State k215PNum1095 0 b n c) $ = '(k215PReach_step k215UnpairAt1091Step11Z);

theorem k215UnpairAt1091Step11S (a b n c: nat): $ k215PStep (k215UnpairAt1091State k215PNum1093 (suc a) b n c) = (k215UnpairAt1091State k215PNum1094 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair1091_1093) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215UnpairAt1091Reach11S (a b n c: nat): $ k215PReach (k215UnpairAt1091State k215PNum1093 (suc a) b n c) (k215UnpairAt1091State k215PNum1094 a b n c) $ = '(k215PReach_step k215UnpairAt1091Step11S);

theorem k215UnpairAt1091Step12 (a b n c: nat): $ k215PStep (k215UnpairAt1091State k215PNum1094 a b n c) = (k215UnpairAt1091State k215PNum1098 a b n c) $ = '(k215PAtCB k215PLookupUnpair1091_1094);

theorem k215UnpairAt1091Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt1091State k215PNum1094 a b n c) (k215UnpairAt1091State k215PNum1098 a b n c) $ = '(k215PReach_step k215UnpairAt1091Step12);

theorem k215UnpairAt1091Step16 (a b n c: nat): $ k215PStep (k215UnpairAt1091State k215PNum1098 a b n c) = (k215UnpairAt1091State k215PNum1091 a b n c) $ = '(k215PAtCC k215PLookupUnpair1091_1098);

theorem k215UnpairAt1091Reach16 (a b n c: nat): $ k215PReach (k215UnpairAt1091State k215PNum1098 a b n c) (k215UnpairAt1091State k215PNum1091 a b n c) $ = '(k215PReach_step k215UnpairAt1091Step16);

theorem k215UnpairAt1091CycleZero (b n c: nat): $ k215PReach (k215UnpairAt1091State k215PNum1091 0 b (suc n) c) (k215UnpairAt1091State k215PNum1091 (suc b) 0 n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt1091Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt1091Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt1091Reach11Z) (ax_mp (ax_mp k215PReach_trans k215UnpairAt1091ReachTransfer) k215UnpairAt1091Reach16))));
theorem k215UnpairAt1091CycleSucc (a b n c: nat): $ k215PReach (k215UnpairAt1091State k215PNum1091 (suc a) b (suc n) c) (k215UnpairAt1091State k215PNum1091 a (suc b) n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt1091Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt1091Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt1091Reach11S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt1091Reach12) k215UnpairAt1091Reach16))));


theorem k215UnpairAt1091AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt1091State k215PNum1091 0 b (suc n) c) (k215UnpairAt1091State k215PNum1091 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt1091Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215PairDiagonal_rotate)) (eqtr (eqcom sndpr) (sndeq k215PairDiagonal_rotate)) eqid eqid)) k215UnpairAt1091CycleZero);

theorem k215UnpairAt1091AdvanceSucc (a b n c: nat): $ k215PReach (k215UnpairAt1091State k215PNum1091 (suc a) b (suc n) c) (k215UnpairAt1091State k215PNum1091 (fst (suc ((suc a), b))) (snd (suc ((suc a), b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt1091Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215Pair_next)) (eqtr (eqcom sndpr) (sndeq k215Pair_next)) eqid eqid)) k215UnpairAt1091CycleSucc);

pub theorem k215UnpairAt1091Advance (a b n c: nat): $ k215PReach (k215UnpairAt1091State k215PNum1091 a b (suc n) c) (k215UnpairAt1091State k215PNum1091 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
 (named @ induct '(ind) 'a 'k215UnpairAt1091AdvanceZero '(a1i k215UnpairAt1091AdvanceSucc));
@_ abstract def k215UnpairAt1091Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt1091State k215PNum1091 a b n c) (k215UnpairAt1091State k215PNum1099 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
theorem k215UnpairAt1091RunZero (a b c: nat): $ k215UnpairAt1091Run 0 a b c $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt1091Stateeq eqid
     (eqcom (eqtr (fsteq add0) fstpr))
     (eqcom (eqtr (sndeq add0) sndpr)) eqid eqid)) k215UnpairAt1091Reach9Z);
@_ abstract def k215UnpairAt1091Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt1091Run n a b c $;
theorem k215UnpairAt1091Claim_at (n a b c: nat): $ k215UnpairAt1091Claim n c -> k215UnpairAt1091Run n a b c $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215UnpairAt1091CodeStep (a b n: nat): $ (fst (suc (a, b)), snd (suc (a, b))) + n = (a, b) + suc n $ =
 '(eqtr (addeq1 fstsnd) addSass);
theorem k215UnpairAt1091RunInductive (n a b c: nat): $ k215UnpairAt1091Claim n c -> k215UnpairAt1091Run (suc n) a b c $ =
 '(syl (ax_mp k215PReach_trans k215UnpairAt1091Advance)
   (mpbid (a1i (k215PReacheq2 (k215UnpairAt1091Stateeq eqid
     (fsteq k215UnpairAt1091CodeStep) (sndeq k215UnpairAt1091CodeStep) eqid eqid))) k215UnpairAt1091Claim_at));
theorem k215UnpairAt1091Claim_all (n c: nat): $ k215UnpairAt1091Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt1091RunZero)) '(iald @ iald k215UnpairAt1091RunInductive));
pub theorem k215UnpairMacro1091 (n a b c: nat): $ k215PReach (k215UnpairAt1091State k215PNum1091 a b n c) (k215UnpairAt1091State k215PNum1099 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
 '(ax_mp k215UnpairAt1091Claim_at k215UnpairAt1091Claim_all);
pub theorem k215UnpairMacro1091_clean (n c: nat): $ k215PReach (k215UnpairAt1091State k215PNum1091 0 0 n c) (k215UnpairAt1091State k215PNum1099 (fst n) (snd n) 0 c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt1091Stateeq eqid
   (fsteq (eqtr (addeq1 pr0) add01))
   (sndeq (eqtr (addeq1 pr0) add01)) eqid eqid)) k215UnpairMacro1091);


