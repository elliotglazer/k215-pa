import "source_l_common_level_members.mm0";

import "source_l_common_level_reflection.mm0";

theorem sfCLPoint_pair (G start params beta y: nat):
 $ nsLocal G (sfCLPoint start params beta y) ->
   nsLocal G (sfAnd (sfCLOrdinalAt beta) (sfCLHierarchyAt beta y)) $;

theorem sfCLPoint_members (G start params beta y: nat):
 $ nsLocal G (sfCLPoint start params beta y) -> nsLocal G (sfCLMembership start y params) $;

theorem sfCLPoint_build (G start params beta y: nat)
 (ho: $ nsLocal G (sfCLOrdinalAt beta) $) (hl: $ nsLocal G (sfCLHierarchyAt beta y) $):
 $ nsLocal G (sfCLMembership start y params) -> nsLocal G (sfCLPoint start params beta y) $;

theorem sfCLPoint_append (G start params beta y: nat)
 (hp: $ nsLocal G (sfCLPoint start params beta y) $):
 $ nsLocal G (sfMem (params + start) y) -> nsLocal G (sfCLPoint start (suc params) beta y) $;

theorem sfCLPoint_from_inclusion (G start params seed oldY beta y: nat)
 (hp: $ nsLocal G (sfCLPoint start params seed oldY) $)
 (hs: $ nsLocal G (sfCLSubset oldY y) $)
 (ho: $ nsLocal G (sfCLOrdinalAt beta) $)
 (hl: $ nsLocal G (sfCLHierarchyAt beta y) $):
 $ nsLocal G (sfCLPoint start params beta y) $;

theorem sfCLReflectedPoint_from_inclusion (G start params count phi seed oldY beta y: nat)
 (hp: $ nsLocal G (sfCLPoint start params seed oldY) $)
 (hs: $ nsLocal G (sfCLSubset oldY y) $)
 (ho: $ nsLocal G (sfCLOrdinalAt beta) $)
 (hl: $ nsLocal G (sfCLHierarchyAt beta y) $):
 $ nsLocal G (sfCLReflection sfLDomain count phi beta) ->
   nsLocal G (sfCLReflectedPoint start params count phi beta y) $;

theorem sfCLReflectedPoint_forget (G start params count phi beta y: nat):
 $ nsLocal G (sfCLReflectedPoint start params count phi beta y) ->
   nsLocal G (sfCLPoint start params beta y) $;

theorem sfCLReflectedPoint_reflection (G start params count phi beta y: nat):
 $ nsLocal G (sfCLReflectedPoint start params count phi beta y) ->
   nsLocal G (sfCLReflection sfLDomain count phi beta) $;
