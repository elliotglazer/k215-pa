-- Replayed in the distinct exact SeedG calculus. No K230 proof predicate is assumed.
import "k218_derived.mm0";



-- Derived rules of the exact numerical K calculus.

theorem k218PropContra (a b: nat): $ k218Provable (kImp (kImp a b) (kImp (kImp b kF) (kImp a kF))) $;

theorem k218PropDuplicate (a b: nat): $ k218Provable (kImp (kImp a (kImp a b)) (kImp a b)) $;

theorem k218PropUseConj (a b c: nat): $ k218Provable (kImp a (kImp (kImp (kImp (kImp a b) (kImp c kF)) kF) b)) $;

theorem k218Provable_syl (a b c: nat)
  (hab: $ k218Provable (kImp a b) $) (hbc: $ k218Provable (kImp b c) $):
  $ k218Provable (kImp a c) $;

theorem k218All_mono (x a b: nat) (h: $ k218Provable (kImp a b) $):
  $ k218Provable (kImp (kAll x a) (kAll x b)) $;

theorem k218Not_mono (a b: nat) (h: $ k218Provable (kImp a b) $):
  $ k218Provable (kImp (kNot b) (kNot a)) $;

theorem k218Exists_mono (x a b: nat) (h: $ k218Provable (kImp a b) $):
  $ k218Provable (kImp (kExists x a) (kExists x b)) $;

theorem k218Exists_collapse (x a: nat)
  (hv: $ k218Provable (kImp a (kAll x a)) $):
  $ k218Provable (kImp (kExists x a) a) $;

