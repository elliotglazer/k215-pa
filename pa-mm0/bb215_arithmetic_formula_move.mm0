def bb215ArithmeticFormulaMoveValue (w d q l r: nat): nat = $ if (d = 0) (k215TMState q (l // 2) (l % 2 + 2 * w + 4 * (r // 2))) (k215TMState q (2 * l + w) (r // 2)) $;

theorem bb215ArithmeticFormulaMoveBody_correct (w d q l rq lq lb u: nat): $ bb215ArithmeticFormulaMoveBody w d q l rq lq lb u <-> if (d = 0) (k215TMState q lq (lb + 2 * w + 4 * rq)) (k215TMState q (2 * l + w) rq) = u $;

def bb215ArithmeticFormulaMoveGraph (w d q l r u .rq .lq .lb: nat): wff = $ E. rq (bb215ArithmeticFormulaDivisionTwoGraph r rq /\ E. lq E. lb (bb215ArithmeticFormulaHalvingGraph l lq lb /\ bb215ArithmeticFormulaMoveBody w d q l rq lq lb u)) $;

theorem bb215ArithmeticFormulaMoveGraph_correct (w d q l r u: nat) {rq: nat}: $ bb215ArithmeticFormulaMoveGraph w d q l r u <-> bb215ArithmeticFormulaMoveValue w d q l r = u $;

theorem bb215ArithmeticFormulaMoveValue_actual (a l r: nat): $ bb215ArithmeticFormulaMoveValue (k215TMWrite a) (k215TMDir a) (k215TMTarget a) l r = k215TMMove a l r $;

