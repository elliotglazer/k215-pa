import "source_reflection_transfer_tv_enumeration.mm0";

import "source_piece_pcf_function_opening.mm0";

theorem sfTVEnumFunction_count(D i:nat): $ sfPieceFunctionCount (sfTVEnumRows D) i = fst i $;

theorem sfTVEnumFunction_matrix(D i:nat): $ sfPieceFunctionMatrix (sfTVEnumRows D) i = sfTVEnumMatrix D i $;

theorem sfTVEnumFunction_valid(D n:nat)(hd:$ sfBound 1 D $): $ sfPieceFunctionTableValid (sfTVEnumRows D) n $;

theorem sfTVEnumFunction_positive_count(D k c:nat)(hb:$ sfBound (suc k) c $): $ sfPieceFunctionCount (sfTVEnumRows D) (sfTVEnumIndex k c 0) = k $;

theorem sfTVEnumFunction_positive_matrix(D k c:nat)(hb:$ sfBound (suc k) c $): $ sfPieceFunctionMatrix (sfTVEnumRows D) (sfTVEnumIndex k c 0) = sfRelativize D c $;

theorem sfTVEnumFunction_negative_count(D k c:nat)(hb:$ sfBound (suc k) c $): $ sfPieceFunctionCount (sfTVEnumRows D) (sfTVEnumIndex k c 1) = k $;

theorem sfTVEnumFunction_negative_matrix(D k c:nat)(hb:$ sfBound (suc k) c $): $ sfPieceFunctionMatrix (sfTVEnumRows D) (sfTVEnumIndex k c 1) = sfImp (sfRelativize D c) sfBot $;
