pub theorem sfK0QRep_member_intro (M y z c: nat) (hM: $ 1 < M $) (hy: $ y < M $) (hz: $ z < M $) (hc: $ c < M $):
 $ k218QProvable (kImp (kAnd (kAnd (kMem 1 z) (kMem z c)) (sqEqual 1 y z (suc M))) (sqMember 1 y c M)) $ =
'(mpbi (k218QProvableeq (kImpeq (! qrepMemberIntro_subst $ M $ $ y $ $ z $ $ c $ hM hy hz hc) (eqcom sfK0QSepMember_unfold))) (ax_mp (ax_mp (ax_mp k218INamed_exists_intro (ltner hz)) (! qrepMemberIntro_absent_M $ M $ $ y $ $ z $ $ c $ hM hy hz hc)) (! qrepMemberIntro_absent_z $ M $ $ y $ $ z $ $ c $ hM hy hz hc)));
