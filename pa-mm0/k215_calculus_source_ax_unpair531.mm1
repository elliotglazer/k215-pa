do (apply (register-eqd 'k215UnpairAt531State) '(k215UnpairAt531Stateeqd));

theorem k215UnpairAt531Transfer (b n c: nat): $ k215PIter (3 * b + 1) (k215UnpairAt531State k215PNum535 0 b n c) = (k215UnpairAt531State k215PNum538 b 0 n c) $ =
