pub theorem k215UnpairAt531Advance (a b n c: nat): $ k215PReach (k215UnpairAt531State k215PNum531 a b (suc n) c) (k215UnpairAt531State k215PNum531 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
 (named @ induct '(ind) 'a 'k215UnpairAt531AdvanceZero '(a1i k215UnpairAt531AdvanceSucc));
@_ abstract def k215UnpairAt531Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt531State k215PNum531 a b n c) (k215UnpairAt531State k215PNum539 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
theorem k215UnpairAt531RunZero (a b c: nat): $ k215UnpairAt531Run 0 a b c $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt531Stateeq eqid
     (eqcom (eqtr (fsteq add0) fstpr))
     (eqcom (eqtr (sndeq add0) sndpr)) eqid eqid)) k215UnpairAt531Reach9Z);
@_ abstract def k215UnpairAt531Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt531Run n a b c $;
theorem k215UnpairAt531Claim_at (n a b c: nat): $ k215UnpairAt531Claim n c -> k215UnpairAt531Run n a b c $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215UnpairAt531CodeStep (a b n: nat): $ (fst (suc (a, b)), snd (suc (a, b))) + n = (a, b) + suc n $ =
 '(eqtr (addeq1 fstsnd) addSass);
theorem k215UnpairAt531RunInductive (n a b c: nat): $ k215UnpairAt531Claim n c -> k215UnpairAt531Run (suc n) a b c $ =
 '(syl (ax_mp k215PReach_trans k215UnpairAt531Advance)
   (mpbid (a1i (k215PReacheq2 (k215UnpairAt531Stateeq eqid
     (fsteq k215UnpairAt531CodeStep) (sndeq k215UnpairAt531CodeStep) eqid eqid))) k215UnpairAt531Claim_at));
theorem k215UnpairAt531Claim_all (n c: nat): $ k215UnpairAt531Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt531RunZero)) '(iald @ iald k215UnpairAt531RunInductive));
pub theorem k215UnpairMacro531 (n a b c: nat): $ k215PReach (k215UnpairAt531State k215PNum531 a b n c) (k215UnpairAt531State k215PNum539 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
 '(ax_mp k215UnpairAt531Claim_at k215UnpairAt531Claim_all);
pub theorem k215UnpairMacro531_clean (n c: nat): $ k215PReach (k215UnpairAt531State k215PNum531 0 0 n c) (k215UnpairAt531State k215PNum539 (fst n) (snd n) 0 c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt531Stateeq eqid
   (fsteq (eqtr (addeq1 pr0) add01))
   (sndeq (eqtr (addeq1 pr0) add01)) eqid eqid)) k215UnpairMacro531);


