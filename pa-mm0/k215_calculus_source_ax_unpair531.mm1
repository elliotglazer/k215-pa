theorem k215UnpairAt531ReachTransfer (b n c: nat): $ k215PReach (k215UnpairAt531State k215PNum535 0 b n c) (k215UnpairAt531State k215PNum538 b 0 n c) $ =
 '(k215PReach_intro k215UnpairAt531Transfer);


theorem k215UnpairAt531Step9Z (a b c: nat): $ k215PStep (k215UnpairAt531State k215PNum531 a b 0 c) = (k215UnpairAt531State k215PNum539 a b 0 c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair531_531) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifpos eqid));

