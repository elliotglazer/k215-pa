theorem k215UnpairAt531Reach9S (a b n c: nat): $ k215PReach (k215UnpairAt531State k215PNum531 a b (suc n) c) (k215UnpairAt531State k215PNum532 a b n c) $ = '(k215PReach_step k215UnpairAt531Step9S);

theorem k215UnpairAt531Step10 (a b n c: nat): $ k215PStep (k215UnpairAt531State k215PNum532 a b n c) = (k215UnpairAt531State k215PNum533 a (suc b) n c) $ = '(eqtr (k215PAtCI k215PLookupUnpair531_532) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215UnpairAt531Reach10 (a b n c: nat): $ k215PReach (k215UnpairAt531State k215PNum532 a b n c) (k215UnpairAt531State k215PNum533 a (suc b) n c) $ = '(k215PReach_step k215UnpairAt531Step10);

theorem k215UnpairAt531Step11Z (b n c: nat): $ k215PStep (k215UnpairAt531State k215PNum533 0 b n c) = (k215UnpairAt531State k215PNum535 0 b n c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair531_533) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt531Reach11Z (b n c: nat): $ k215PReach (k215UnpairAt531State k215PNum533 0 b n c) (k215UnpairAt531State k215PNum535 0 b n c) $ = '(k215PReach_step k215UnpairAt531Step11Z);

theorem k215UnpairAt531Step11S (a b n c: nat): $ k215PStep (k215UnpairAt531State k215PNum533 (suc a) b n c) = (k215UnpairAt531State k215PNum534 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair531_533) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215UnpairAt531Reach11S (a b n c: nat): $ k215PReach (k215UnpairAt531State k215PNum533 (suc a) b n c) (k215UnpairAt531State k215PNum534 a b n c) $ = '(k215PReach_step k215UnpairAt531Step11S);

theorem k215UnpairAt531Step12 (a b n c: nat): $ k215PStep (k215UnpairAt531State k215PNum534 a b n c) = (k215UnpairAt531State k215PNum538 a b n c) $ = '(k215PAtCB k215PLookupUnpair531_534);

theorem k215UnpairAt531Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt531State k215PNum534 a b n c) (k215UnpairAt531State k215PNum538 a b n c) $ = '(k215PReach_step k215UnpairAt531Step12);

theorem k215UnpairAt531Step16 (a b n c: nat): $ k215PStep (k215UnpairAt531State k215PNum538 a b n c) = (k215UnpairAt531State k215PNum531 a b n c) $ = '(k215PAtCC k215PLookupUnpair531_538);

theorem k215UnpairAt531Reach16 (a b n c: nat): $ k215PReach (k215UnpairAt531State k215PNum538 a b n c) (k215UnpairAt531State k215PNum531 a b n c) $ = '(k215PReach_step k215UnpairAt531Step16);

theorem k215UnpairAt531CycleZero (b n c: nat): $ k215PReach (k215UnpairAt531State k215PNum531 0 b (suc n) c) (k215UnpairAt531State k215PNum531 (suc b) 0 n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt531Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt531Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt531Reach11Z) (ax_mp (ax_mp k215PReach_trans k215UnpairAt531ReachTransfer) k215UnpairAt531Reach16))));
theorem k215UnpairAt531CycleSucc (a b n c: nat): $ k215PReach (k215UnpairAt531State k215PNum531 (suc a) b (suc n) c) (k215UnpairAt531State k215PNum531 a (suc b) n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt531Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt531Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt531Reach11S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt531Reach12) k215UnpairAt531Reach16))));


theorem k215UnpairAt531AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt531State k215PNum531 0 b (suc n) c) (k215UnpairAt531State k215PNum531 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt531Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215PairDiagonal_rotate)) (eqtr (eqcom sndpr) (sndeq k215PairDiagonal_rotate)) eqid eqid)) k215UnpairAt531CycleZero);

theorem k215UnpairAt531AdvanceSucc (a b n c: nat): $ k215PReach (k215UnpairAt531State k215PNum531 (suc a) b (suc n) c) (k215UnpairAt531State k215PNum531 (fst (suc ((suc a), b))) (snd (suc ((suc a), b))) n c) $ =
