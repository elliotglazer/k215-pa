import "source_piece_pcf_rep_background_r18.mm1";
import "source_piece_pcf_rep_atoms_uniform_r20.mm1";
import "source_piece_pcf_rep_kernel_env_domain_base.mm1";

import "source_piece_pcf_rep_r16_kernel_env_domain_step.mm1";

import "source_piece_pcf_rep_r16_kernel_env_lookup_head.mm1";

import "source_piece_pcf_rep_r16_kernel_env_lookup_tail.mm1";

import "source_piece_pcf_rep_r16_kernel_member_from_lookups.mm1";

import "source_piece_pcf_rep_r16_kernel_equal_from_lookups.mm1";

import "source_piece_pcf_rep_r17_kernel_empty_exists.mm1";

import "source_piece_pcf_rep_r17_kernel_successor_total.mm1";

theorem pcrw_empty_exists_eq:
 $ sfPieceRepR17KernelEmptyExistsFormula = sfPieceRepEmptyExists $ =
 'eqid;

theorem pcrw_empty_exists_local:
 $ (nsLocal sfLBackground sfPieceRepEmptyExists) $ =
 '(mpbi (nsLocal_formula_eq pcrw_empty_exists_eq) sfPieceRepR17KernelEmptyExists_local);

theorem pcrw_total_eq:
 $ sfPieceRepR17KernelSuccessorTotalFormula = sfPieceRepSuccessorTotal $ =
 'eqid;

theorem pcrw_total_local:
 $ (nsLocal sfLBackground sfPieceRepSuccessorTotal) $ =
 '(mpbi (nsLocal_formula_eq pcrw_total_eq) sfPieceRepR17KernelSuccessorTotal_local);

theorem pcrw_domain_base_eq:
 $ sfPieceRepKernelEnvDomainBaseFormula = sfPieceRepDomainBaseLaw $ =
 'eqid;

theorem pcrw_domain_base_local:
 $ (nsLocal sfLBackground sfPieceRepDomainBaseLaw) $ =
 '(mpbi (nsLocal_formula_eq pcrw_domain_base_eq) sfPieceRepKernelEnvDomainBase_local);

theorem pcrw_domain_step_eq:
 $ sfPieceRepR16KernelEnvDomainStepFormula = sfPieceRepDomainStepLaw $ =
 'eqid;

theorem pcrw_domain_step_local:
 $ (nsLocal sfLBackground sfPieceRepDomainStepLaw) $ =
 '(mpbi (nsLocal_formula_eq pcrw_domain_step_eq) sfPieceRepR16KernelEnvDomainStep_local);

theorem pcrw_head_eq:
 $ sfPieceRepR16KernelEnvLookupHeadFormula = sfPieceRepLookupHeadLaw $ =
 'eqid;

theorem pcrw_head_local:
 $ (nsLocal sfLBackground sfPieceRepLookupHeadLaw) $ =
 '(mpbi (nsLocal_formula_eq pcrw_head_eq) sfPieceRepR16KernelEnvLookupHead_local);

theorem pcrw_tail_eq:
 $ sfPieceRepR16KernelEnvLookupTailFormula = sfPieceRepLookupTailLaw $ =
 'eqid;

theorem pcrw_tail_local:
 $ (nsLocal sfLBackground sfPieceRepLookupTailLaw) $ =
 '(mpbi (nsLocal_formula_eq pcrw_tail_eq) sfPieceRepR16KernelEnvLookupTail_local);

theorem pcrw_member_eq:
 $ sfPieceRepR16KernelMemberFromLookupsFormula = sfPieceRepMemberLookupLaw $ =
 'eqid;

theorem pcrw_member_local:
 $ (nsLocal sfLBackground sfPieceRepMemberLookupLaw) $ =
 '(mpbi (nsLocal_formula_eq pcrw_member_eq) sfPieceRepR16KernelMemberFromLookups_local);

theorem pcrw_equal_eq:
 $ sfPieceRepR16KernelEqualFromLookupsFormula = sfPieceRepEqualLookupLaw $ =
 'eqid;

theorem pcrw_equal_local:
 $ (nsLocal sfLBackground sfPieceRepEqualLookupLaw) $ =
 '(mpbi (nsLocal_formula_eq pcrw_equal_eq) sfPieceRepR16KernelEqualFromLookups_local);

pub theorem sfPieceRepLookupLaws_background:
 $ (nsLocal sfLBackground sfPieceRepLookupLaws) $ =
 '(sfLocal_and pcrw_empty_exists_local (sfLocal_and pcrw_total_local (sfLocal_and pcrb_EmptyUnique_local (sfLocal_and pcrb_SuccessorUnique_local (sfLocal_and pcrb_SuccessorLift_local (sfLocal_and pcrb_NoSelf_local (sfLocal_and pcrw_domain_base_local (sfLocal_and pcrw_domain_step_local (sfLocal_and pcrw_head_local pcrw_tail_local)))))))));

theorem pcrw_laws(G:nat)(hg:$ sfContextWf G $)(hb:$ sfContextSub sfLBackground G $):
 $ (nsLocal G sfPieceRepLookupLaws) $ =
 '(pcrb_weaken hg hb sfPieceRepLookupLaws_background);

pub theorem sfPieceNumeralSome_background(G k:nat)(hg:$ sfContextWf G $)(hb:$ sfContextSub sfLBackground G $):
 $ (nsLocal G (sfPieceNumeralSome k)) $ =
 '(sfPieceNumeralSome_from_laws (pcrb_weaken hg hb pcrw_empty_exists_local) (pcrb_weaken hg hb pcrw_total_local));

pub theorem sfPieceEnv_domain(T:set)(G n e d:nat)(hg:$ sfContextWf G $)(hb:$ sfContextSub sfLBackground G $)(he:$ nsLocal G (sfPieceEnv T n e) $)(hd:$ nsLocal G (sfPieceNumeral n d) $):
 $ (nsLocal G (sfPieceRepDomain e d)) $ =
 '(sfPieceEnv_domain_from_laws (pcrb_weaken hg hb pcrw_domain_base_local) (pcrb_weaken hg hb pcrw_domain_step_local) he hd);

pub theorem sfPieceEnv_lookup(T:set)(G n i e x w:nat)(hg:$ sfContextWf G $)(hb:$ sfContextSub sfLBackground G $)(hi:$ i < n $)(he:$ nsLocal G (sfPieceEnv T n e) $)(hx:$ nsLocal G (sfPieceNumeral (n - 1 - i) x) $):
 $ (nsLocal G (sfPieceRepIff (sfPieceRepApplication e x w) (sfEq w (T @ i)))) $ =
 '(sfPieceEnv_lookup_from_laws (ax_mp (ax_mp sfContextSub_trans sfPieceEquality_background) hb) (pcrw_laws hg hb) hi he hx);

pub theorem sfPieceEnv_lookup_all(T:set)(G n i e x:nat)(hg:$ sfContextWf G $)(hb:$ sfContextSub sfLBackground G $)(hi:$ i < n $)(he:$ nsLocal G (sfPieceEnv T n e) $)(hx:$ nsLocal G (sfPieceNumeral (n - 1 - i) x) $):
 $ (nsLocal G (sfPieceRepLookup e x (T @ i))) $ =
 '(sfPieceEnv_lookup_all_from_laws (ax_mp (ax_mp sfContextSub_trans sfPieceEquality_background) hb) (pcrw_laws hg hb) hi he hx);

pub theorem sfPieceEnv_member_test(T:set)(G n i j e x y:nat)(hg:$ sfContextWf G $)(hb:$ sfContextSub sfLBackground G $)(hi:$ i < n $)(hj:$ j < n $)(he:$ nsLocal G (sfPieceEnv T n e) $)(hx:$ nsLocal G (sfPieceNumeral (n - 1 - i) x) $)(hy:$ nsLocal G (sfPieceNumeral (n - 1 - j) y) $):
 $ (nsLocal G (sfPieceRepIff (sfPieceRepMemberTest x y e) (sfMem (T @ i) (T @ j)))) $ =
 '(sfPieceEnv_member_test_from_laws (ax_mp (ax_mp sfContextSub_trans sfPieceEquality_background) hb) (pcrw_laws hg hb) (pcrb_weaken hg hb pcrw_member_local) hi hj he hx hy);

pub theorem sfPieceEnv_equal_test(T:set)(G n i j e x y:nat)(hg:$ sfContextWf G $)(hb:$ sfContextSub sfLBackground G $)(hi:$ i < n $)(hj:$ j < n $)(he:$ nsLocal G (sfPieceEnv T n e) $)(hx:$ nsLocal G (sfPieceNumeral (n - 1 - i) x) $)(hy:$ nsLocal G (sfPieceNumeral (n - 1 - j) y) $):
 $ (nsLocal G (sfPieceRepIff (sfPieceRepEqualTest x y e) (sfEq (T @ i) (T @ j)))) $ =
 '(sfPieceEnv_equal_test_from_laws (ax_mp (ax_mp sfContextSub_trans sfPieceEquality_background) hb) (pcrw_laws hg hb) (pcrb_weaken hg hb pcrw_equal_local) hi hj he hx hy);
