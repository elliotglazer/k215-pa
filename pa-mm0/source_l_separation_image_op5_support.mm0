import "source_l_separation_image_op5_profile.mm0";

theorem sfLSeparationOp5Extensions_wf(s:nat):
 $ sfWf (sfLSeparationOp5Extensions s) $;

theorem sfLSeparationOp5Extensions_rename(T:set)(s:nat):
 $ sfRename T 0 (sfLSeparationOp5Extensions s) = sfLSeparationOp5Extensions (T @ s) $;

theorem sfLSeparationOp5Extensions_eq(s t:nat)(he:$ s = t $):
 $ sfLSeparationOp5Extensions s = sfLSeparationOp5Extensions t $;

theorem sfLSeparationOp5Extensions_subst(d t s:nat):
 $ sfSubst d t (sfLSeparationOp5Extensions s) = sfLSeparationOp5Extensions (sfSubstIndex d t s) $;

theorem sfLSeparationOp5Extensions_instance(G s:nat)
 (he:$ nsLocal G (sfAll (sfLSeparationOp5Extensions 0)) $):
 $ nsLocal G (sfLSeparationOp5Extensions s) $;

theorem sfLSeparationOp5_profile_from_total(T:set)(G n phi R A s Y:nat)
 (hb:$ sfBound (suc n) phi $)
 (hr:$ nsLocal G (sfPieceDefinableNamed (suc n) phi R A) $)
 (hm:$ sfReflectionDnMembers T G A n $)
 (hs:$ nsLocal G (sfPieceEnv T n s) $)
 (ho:$ nsLocal G (sfLSeparationOp5 R s A Y) $)
 (he:$ nsLocal G (sfAll (sfLSeparationOp5Extensions 0)) $):
 $ nsLocal G (sfPieceDefinableProfile T phi A Y) $;
