@_ def k215UnpairAt319State (pc a b n c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) n (k215PR3 c) (k215PR4 c) (k215PR5 c) a b (k215PR8 c)) $;

do (apply (register-eqd 'k215UnpairAt319State) '(k215UnpairAt319Stateeqd));

theorem k215UnpairAt319Transfer (b n c: nat): $ k215PIter (3 * b + 1) (k215UnpairAt319State k215PNum323 0 b n c) = (k215UnpairAt319State k215PNum326 b 0 n c) $ =
 '(eqtr k215Loop323Vector (k215PStateeq2 (k215PVectoreq7 add0)));
theorem k215UnpairAt319ReachTransfer (b n c: nat): $ k215PReach (k215UnpairAt319State k215PNum323 0 b n c) (k215UnpairAt319State k215PNum326 b 0 n c) $ =
 '(k215PReach_intro k215UnpairAt319Transfer);


theorem k215UnpairAt319Step9Z (a b c: nat): $ k215PStep (k215UnpairAt319State k215PNum319 a b 0 c) = (k215UnpairAt319State k215PNum327 a b 0 c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair319_319) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt319Reach9Z (a b c: nat): $ k215PReach (k215UnpairAt319State k215PNum319 a b 0 c) (k215UnpairAt319State k215PNum327 a b 0 c) $ = '(k215PReach_step k215UnpairAt319Step9Z);

theorem k215UnpairAt319Step9S (a b n c: nat): $ k215PStep (k215UnpairAt319State k215PNum319 a b (suc n) c) = (k215UnpairAt319State k215PNum320 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair319_319) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet2_vector)) (eqtr k215PSet2_vector (k215PVectoreq3 (eqtr subSS sub02))))));

theorem k215UnpairAt319Reach9S (a b n c: nat): $ k215PReach (k215UnpairAt319State k215PNum319 a b (suc n) c) (k215UnpairAt319State k215PNum320 a b n c) $ = '(k215PReach_step k215UnpairAt319Step9S);

theorem k215UnpairAt319Step10 (a b n c: nat): $ k215PStep (k215UnpairAt319State k215PNum320 a b n c) = (k215UnpairAt319State k215PNum321 a (suc b) n c) $ = '(eqtr (k215PAtCI k215PLookupUnpair319_320) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215UnpairAt319Reach10 (a b n c: nat): $ k215PReach (k215UnpairAt319State k215PNum320 a b n c) (k215UnpairAt319State k215PNum321 a (suc b) n c) $ = '(k215PReach_step k215UnpairAt319Step10);

theorem k215UnpairAt319Step11Z (b n c: nat): $ k215PStep (k215UnpairAt319State k215PNum321 0 b n c) = (k215UnpairAt319State k215PNum323 0 b n c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair319_321) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt319Reach11Z (b n c: nat): $ k215PReach (k215UnpairAt319State k215PNum321 0 b n c) (k215UnpairAt319State k215PNum323 0 b n c) $ = '(k215PReach_step k215UnpairAt319Step11Z);

theorem k215UnpairAt319Step11S (a b n c: nat): $ k215PStep (k215UnpairAt319State k215PNum321 (suc a) b n c) = (k215UnpairAt319State k215PNum322 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair319_321) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215UnpairAt319Reach11S (a b n c: nat): $ k215PReach (k215UnpairAt319State k215PNum321 (suc a) b n c) (k215UnpairAt319State k215PNum322 a b n c) $ = '(k215PReach_step k215UnpairAt319Step11S);

theorem k215UnpairAt319Step12 (a b n c: nat): $ k215PStep (k215UnpairAt319State k215PNum322 a b n c) = (k215UnpairAt319State k215PNum326 a b n c) $ = '(k215PAtCB k215PLookupUnpair319_322);

theorem k215UnpairAt319Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt319State k215PNum322 a b n c) (k215UnpairAt319State k215PNum326 a b n c) $ = '(k215PReach_step k215UnpairAt319Step12);

theorem k215UnpairAt319Step16 (a b n c: nat): $ k215PStep (k215UnpairAt319State k215PNum326 a b n c) = (k215UnpairAt319State k215PNum319 a b n c) $ = '(k215PAtCC k215PLookupUnpair319_326);

theorem k215UnpairAt319Reach16 (a b n c: nat): $ k215PReach (k215UnpairAt319State k215PNum326 a b n c) (k215UnpairAt319State k215PNum319 a b n c) $ = '(k215PReach_step k215UnpairAt319Step16);

theorem k215UnpairAt319CycleZero (b n c: nat): $ k215PReach (k215UnpairAt319State k215PNum319 0 b (suc n) c) (k215UnpairAt319State k215PNum319 (suc b) 0 n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt319Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt319Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt319Reach11Z) (ax_mp (ax_mp k215PReach_trans k215UnpairAt319ReachTransfer) k215UnpairAt319Reach16))));
theorem k215UnpairAt319CycleSucc (a b n c: nat): $ k215PReach (k215UnpairAt319State k215PNum319 (suc a) b (suc n) c) (k215UnpairAt319State k215PNum319 a (suc b) n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt319Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt319Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt319Reach11S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt319Reach12) k215UnpairAt319Reach16))));


theorem k215UnpairAt319AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt319State k215PNum319 0 b (suc n) c) (k215UnpairAt319State k215PNum319 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt319Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215PairDiagonal_rotate)) (eqtr (eqcom sndpr) (sndeq k215PairDiagonal_rotate)) eqid eqid)) k215UnpairAt319CycleZero);

theorem k215UnpairAt319AdvanceSucc (a b n c: nat): $ k215PReach (k215UnpairAt319State k215PNum319 (suc a) b (suc n) c) (k215UnpairAt319State k215PNum319 (fst (suc ((suc a), b))) (snd (suc ((suc a), b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt319Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215Pair_next)) (eqtr (eqcom sndpr) (sndeq k215Pair_next)) eqid eqid)) k215UnpairAt319CycleSucc);

pub theorem k215UnpairAt319Advance (a b n c: nat): $ k215PReach (k215UnpairAt319State k215PNum319 a b (suc n) c) (k215UnpairAt319State k215PNum319 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
 (named @ induct '(ind) 'a 'k215UnpairAt319AdvanceZero '(a1i k215UnpairAt319AdvanceSucc));
@_ abstract def k215UnpairAt319Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt319State k215PNum319 a b n c) (k215UnpairAt319State k215PNum327 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
theorem k215UnpairAt319RunZero (a b c: nat): $ k215UnpairAt319Run 0 a b c $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt319Stateeq eqid
     (eqcom (eqtr (fsteq add0) fstpr))
     (eqcom (eqtr (sndeq add0) sndpr)) eqid eqid)) k215UnpairAt319Reach9Z);
@_ abstract def k215UnpairAt319Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt319Run n a b c $;
theorem k215UnpairAt319Claim_at (n a b c: nat): $ k215UnpairAt319Claim n c -> k215UnpairAt319Run n a b c $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215UnpairAt319CodeStep (a b n: nat): $ (fst (suc (a, b)), snd (suc (a, b))) + n = (a, b) + suc n $ =
 '(eqtr (addeq1 fstsnd) addSass);
theorem k215UnpairAt319RunInductive (n a b c: nat): $ k215UnpairAt319Claim n c -> k215UnpairAt319Run (suc n) a b c $ =
 '(syl (ax_mp k215PReach_trans k215UnpairAt319Advance)
   (mpbid (a1i (k215PReacheq2 (k215UnpairAt319Stateeq eqid
     (fsteq k215UnpairAt319CodeStep) (sndeq k215UnpairAt319CodeStep) eqid eqid))) k215UnpairAt319Claim_at));
theorem k215UnpairAt319Claim_all (n c: nat): $ k215UnpairAt319Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt319RunZero)) '(iald @ iald k215UnpairAt319RunInductive));
pub theorem k215UnpairMacro319 (n a b c: nat): $ k215PReach (k215UnpairAt319State k215PNum319 a b n c) (k215UnpairAt319State k215PNum327 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
 '(ax_mp k215UnpairAt319Claim_at k215UnpairAt319Claim_all);
pub theorem k215UnpairMacro319_clean (n c: nat): $ k215PReach (k215UnpairAt319State k215PNum319 0 0 n c) (k215UnpairAt319State k215PNum327 (fst n) (snd n) 0 c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt319Stateeq eqid
   (fsteq (eqtr (addeq1 pr0) add01))
   (sndeq (eqtr (addeq1 pr0) add01)) eqid eqid)) k215UnpairMacro319);


