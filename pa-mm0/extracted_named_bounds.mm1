import "extracted_named_at_eigen.mm1";
pub theorem exNamedSourceBound_nil (p: nat): $ sqSourceBound p 0 $ =
(named '(ax_gen (absurd lmem0)));
pub theorem exNamedSourceBound_cons (p G a: nat)
 (ha: $ sfBound p a $) (hg: $ sqSourceBound p G $):
 $ sqSourceBound p (a : G) $ =
(named '(!! ax_gen b @ syl (eori
 (mpbird (sfBoundeq2d id) (a1i ha))
 (ax_mp sqSourceBound_at hg)) (bi1 lmemS)));
