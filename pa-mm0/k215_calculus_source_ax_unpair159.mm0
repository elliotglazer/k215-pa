import "k215_calculus_source_ax_reads_loops.mm0";
import "k215_literal_runtime_reach.mm0";
import "k215_calculus_source_pairing.mm0";
import "k215_calculus_source_ax_reads_lookups.mm0";

def k215UnpairAt159State (pc a b n c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) a b n) $;

theorem k215UnpairAt159Advance (a b n c: nat): $ k215PReach (k215UnpairAt159State k215Num159 a b (suc n) c) (k215UnpairAt159State k215Num159 (fst (suc (a, b))) (snd (suc (a, b))) n c) $;

def k215UnpairAt159Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt159State k215Num159 a b n c) (k215UnpairAt159State k215Num167 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;

def k215UnpairAt159Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt159Run n a b c $;

theorem k215UnpairMacro159 (n a b c: nat): $ k215PReach (k215UnpairAt159State k215Num159 a b n c) (k215UnpairAt159State k215Num167 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;

theorem k215UnpairMacro159_clean (n c: nat): $ k215PReach (k215UnpairAt159State k215Num159 0 0 n c) (k215UnpairAt159State k215Num167 (fst n) (snd n) 0 c) $;
