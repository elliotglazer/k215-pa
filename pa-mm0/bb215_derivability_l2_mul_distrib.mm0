import "bb215_derivability_l2_mul_comm.mm0";

-- L05, layer L2 (lanes/L05.md): left distributivity of * over + inside PA, by induction on z
-- with A. x A. y inside. Generated by build_bb215_derivability_l2_add_basic.py.

theorem bb215L2_eq_mul_rule (n s1 t1 s2 t2: nat) (h1: $ paProvable n (paFormulaEqual s1 t1) $) (h2: $ paProvable n (paFormulaEqual s2 t2) $):
  $ paProvable n (paFormulaEqual (paTermMultiplication s1 s2) (paTermMultiplication t1 t2)) $;

-- PA |- A. z A. x A. y (x * (y + z) = x * y + x * z)

theorem bb215L2_mul_distrib:
  $ paProvable 0 (paFormulaAll (paFormulaAll (paFormulaAll (paFormulaEqual (paTermMultiplication (paTermVariable 1) (paTermAddition (paTermVariable 0) (paTermVariable 2))) (paTermAddition (paTermMultiplication (paTermVariable 1) (paTermVariable 0)) (paTermMultiplication (paTermVariable 1) (paTermVariable 2))))))) $;

theorem bb215L2_mul_distrib_inst (n x y z: nat) (hx: $ paTermBound n x $) (hy: $ paTermBound n y $) (hz: $ paTermBound n z $):
  $ paProvable n (paFormulaEqual (paTermMultiplication x (paTermAddition y z)) (paTermAddition (paTermMultiplication x y) (paTermMultiplication x z))) $;

-- PA |- A. z A. x A. y ((x * y) * z = x * (y * z))

theorem bb215L2_mul_assoc:
  $ paProvable 0 (paFormulaAll (paFormulaAll (paFormulaAll (paFormulaEqual (paTermMultiplication (paTermMultiplication (paTermVariable 1) (paTermVariable 0)) (paTermVariable 2)) (paTermMultiplication (paTermVariable 1) (paTermMultiplication (paTermVariable 0) (paTermVariable 2))))))) $;
