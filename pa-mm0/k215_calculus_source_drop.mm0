import "k215_calculus_source_decode.mm0";
import "k215_calculus_source_drop_push.mm0";
import "k215_calculus_source_drop_lookups.mm0";

theorem k215DropSourceInterval (u t w d h v: nat):
 $ k215PReach (k215PState k215Num23 (k215PVector u t w 1 d h 0 0 v))
   (k215PState 0 (k215PVector u h (t, w) 0 d h 0 0 v)) $;
