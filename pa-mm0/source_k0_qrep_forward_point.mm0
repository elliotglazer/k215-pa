import "source_k0_qrep_raw_member.mm0";

import "source_k0_qrep_transport_reverse.mm0";

import "source_k0_qsep_quotient_witness.mm0";

theorem sfK0QRep_forward_witness_point (E: set) (n a x y M R phi: nat) (hf: $ sfBound (suc (suc n)) phi $)
 (hM: $ 1 < M $) (hMR: $ M < R $) (ha: $ a < M $)
 (hx: $ x < M $) (hy: $ y < M $) (hx0: $ x != 0 $)
 (hx1: $ x != 1 $) (hx2: $ x != 2 $) (hxy: $ x != y $)
 (he: $ sqEnvBelow E n R $):
 $ k218QProvable (kImp (kImp (kImp kEmptyMarker (kImp (sqEqual 1 y M (suc M)) kF)) kF) (kImp (kImp (kImp (kImp (kImp (kMem 1 x) (kImp (kMem x a) kF)) kF) (kImp (sqQuote (sqEnvCons x (sqEnvCons M E)) 1 R 0 phi) kF)) kF) (kImp (kImp (kImp (kImp (kMem 1 x) (kImp (sqMember 1 x a (suc M)) kF)) kF) (kImp (sqQuote (sqEnvCons x (sqEnvCons y E)) 1 R 0 phi) kF)) kF))) $;

theorem sfK0QRep_forward_witness_exists (E: set) (n a x y M R phi: nat) (hf: $ sfBound (suc (suc n)) phi $)
 (hM: $ 1 < M $) (hMR: $ M < R $) (ha: $ a < M $)
 (hx: $ x < M $) (hy: $ y < M $) (hx0: $ x != 0 $)
 (hx1: $ x != 1 $) (hx2: $ x != 2 $) (hxy: $ x != y $)
 (he: $ sqEnvBelow E n R $):
 $ k218QProvable (kImp (kImp (kImp kEmptyMarker (kImp (sqEqual 1 y M (suc M)) kF)) kF) (kImp (kExists x (kImp (kImp (kImp (kImp (kMem 1 x) (kImp (kMem x a) kF)) kF) (kImp (sqQuote (sqEnvCons x (sqEnvCons M E)) 1 R 0 phi) kF)) kF)) (kExists x (kImp (kImp (kImp (kImp (kMem 1 x) (kImp (sqMember 1 x a (suc M)) kF)) kF) (kImp (sqQuote (sqEnvCons x (sqEnvCons y E)) 1 R 0 phi) kF)) kF)))) $;
