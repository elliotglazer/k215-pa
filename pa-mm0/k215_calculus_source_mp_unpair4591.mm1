@_ def k215UnpairAt4591State (pc a b n c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) a b n) $;

do (apply (register-eqd 'k215UnpairAt4591State) '(k215UnpairAt4591Stateeqd));

theorem k215UnpairAt4591Transfer (b n c: nat): $ k215PIter (3 * b + 1) (k215UnpairAt4591State k215PNum4595 0 b n c) = (k215UnpairAt4591State k215PNum4598 b 0 n c) $ =
 '(eqtr k215Loop4595Vector (k215PStateeq2 (k215PVectoreq7 add0)));
theorem k215UnpairAt4591ReachTransfer (b n c: nat): $ k215PReach (k215UnpairAt4591State k215PNum4595 0 b n c) (k215UnpairAt4591State k215PNum4598 b 0 n c) $ =
 '(k215PReach_intro k215UnpairAt4591Transfer);


theorem k215UnpairAt4591Step9Z (a b c: nat): $ k215PStep (k215UnpairAt4591State k215PNum4591 a b 0 c) = (k215UnpairAt4591State k215PNum4599 a b 0 c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair4591_4591) (ifeq (eqeq1 k215PGet8_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt4591Reach9Z (a b c: nat): $ k215PReach (k215UnpairAt4591State k215PNum4591 a b 0 c) (k215UnpairAt4591State k215PNum4599 a b 0 c) $ = '(k215PReach_step k215UnpairAt4591Step9Z);

theorem k215UnpairAt4591Step9S (a b n c: nat): $ k215PStep (k215UnpairAt4591State k215PNum4591 a b (suc n) c) = (k215UnpairAt4591State k215PNum4592 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair4591_4591) (ifeq (eqeq1 k215PGet8_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet8_vector)) (eqtr k215PSet8_vector (k215PVectoreq9 (eqtr subSS sub02))))));

theorem k215UnpairAt4591Reach9S (a b n c: nat): $ k215PReach (k215UnpairAt4591State k215PNum4591 a b (suc n) c) (k215UnpairAt4591State k215PNum4592 a b n c) $ = '(k215PReach_step k215UnpairAt4591Step9S);

theorem k215UnpairAt4591Step10 (a b n c: nat): $ k215PStep (k215UnpairAt4591State k215PNum4592 a b n c) = (k215UnpairAt4591State k215PNum4593 a (suc b) n c) $ = '(eqtr (k215PAtCI k215PLookupUnpair4591_4592) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215UnpairAt4591Reach10 (a b n c: nat): $ k215PReach (k215UnpairAt4591State k215PNum4592 a b n c) (k215UnpairAt4591State k215PNum4593 a (suc b) n c) $ = '(k215PReach_step k215UnpairAt4591Step10);

theorem k215UnpairAt4591Step11Z (b n c: nat): $ k215PStep (k215UnpairAt4591State k215PNum4593 0 b n c) = (k215UnpairAt4591State k215PNum4595 0 b n c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair4591_4593) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt4591Reach11Z (b n c: nat): $ k215PReach (k215UnpairAt4591State k215PNum4593 0 b n c) (k215UnpairAt4591State k215PNum4595 0 b n c) $ = '(k215PReach_step k215UnpairAt4591Step11Z);

theorem k215UnpairAt4591Step11S (a b n c: nat): $ k215PStep (k215UnpairAt4591State k215PNum4593 (suc a) b n c) = (k215UnpairAt4591State k215PNum4594 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair4591_4593) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215UnpairAt4591Reach11S (a b n c: nat): $ k215PReach (k215UnpairAt4591State k215PNum4593 (suc a) b n c) (k215UnpairAt4591State k215PNum4594 a b n c) $ = '(k215PReach_step k215UnpairAt4591Step11S);

theorem k215UnpairAt4591Step12 (a b n c: nat): $ k215PStep (k215UnpairAt4591State k215PNum4594 a b n c) = (k215UnpairAt4591State k215PNum4598 a b n c) $ = '(k215PAtCB k215PLookupUnpair4591_4594);

theorem k215UnpairAt4591Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt4591State k215PNum4594 a b n c) (k215UnpairAt4591State k215PNum4598 a b n c) $ = '(k215PReach_step k215UnpairAt4591Step12);

theorem k215UnpairAt4591Step16 (a b n c: nat): $ k215PStep (k215UnpairAt4591State k215PNum4598 a b n c) = (k215UnpairAt4591State k215PNum4591 a b n c) $ = '(k215PAtCC k215PLookupUnpair4591_4598);

theorem k215UnpairAt4591Reach16 (a b n c: nat): $ k215PReach (k215UnpairAt4591State k215PNum4598 a b n c) (k215UnpairAt4591State k215PNum4591 a b n c) $ = '(k215PReach_step k215UnpairAt4591Step16);

theorem k215UnpairAt4591CycleZero (b n c: nat): $ k215PReach (k215UnpairAt4591State k215PNum4591 0 b (suc n) c) (k215UnpairAt4591State k215PNum4591 (suc b) 0 n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt4591Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt4591Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt4591Reach11Z) (ax_mp (ax_mp k215PReach_trans k215UnpairAt4591ReachTransfer) k215UnpairAt4591Reach16))));
theorem k215UnpairAt4591CycleSucc (a b n c: nat): $ k215PReach (k215UnpairAt4591State k215PNum4591 (suc a) b (suc n) c) (k215UnpairAt4591State k215PNum4591 a (suc b) n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt4591Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt4591Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt4591Reach11S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt4591Reach12) k215UnpairAt4591Reach16))));


theorem k215UnpairAt4591AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt4591State k215PNum4591 0 b (suc n) c) (k215UnpairAt4591State k215PNum4591 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt4591Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215PairDiagonal_rotate)) (eqtr (eqcom sndpr) (sndeq k215PairDiagonal_rotate)) eqid eqid)) k215UnpairAt4591CycleZero);

theorem k215UnpairAt4591AdvanceSucc (a b n c: nat): $ k215PReach (k215UnpairAt4591State k215PNum4591 (suc a) b (suc n) c) (k215UnpairAt4591State k215PNum4591 (fst (suc ((suc a), b))) (snd (suc ((suc a), b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt4591Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215Pair_next)) (eqtr (eqcom sndpr) (sndeq k215Pair_next)) eqid eqid)) k215UnpairAt4591CycleSucc);

pub theorem k215UnpairAt4591Advance (a b n c: nat): $ k215PReach (k215UnpairAt4591State k215PNum4591 a b (suc n) c) (k215UnpairAt4591State k215PNum4591 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
 (named @ induct '(ind) 'a 'k215UnpairAt4591AdvanceZero '(a1i k215UnpairAt4591AdvanceSucc));
@_ abstract def k215UnpairAt4591Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt4591State k215PNum4591 a b n c) (k215UnpairAt4591State k215PNum4599 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
theorem k215UnpairAt4591RunZero (a b c: nat): $ k215UnpairAt4591Run 0 a b c $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt4591Stateeq eqid
     (eqcom (eqtr (fsteq add0) fstpr))
     (eqcom (eqtr (sndeq add0) sndpr)) eqid eqid)) k215UnpairAt4591Reach9Z);
@_ abstract def k215UnpairAt4591Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt4591Run n a b c $;
theorem k215UnpairAt4591Claim_at (n a b c: nat): $ k215UnpairAt4591Claim n c -> k215UnpairAt4591Run n a b c $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215UnpairAt4591CodeStep (a b n: nat): $ (fst (suc (a, b)), snd (suc (a, b))) + n = (a, b) + suc n $ =
 '(eqtr (addeq1 fstsnd) addSass);
theorem k215UnpairAt4591RunInductive (n a b c: nat): $ k215UnpairAt4591Claim n c -> k215UnpairAt4591Run (suc n) a b c $ =
 '(syl (ax_mp k215PReach_trans k215UnpairAt4591Advance)
   (mpbid (a1i (k215PReacheq2 (k215UnpairAt4591Stateeq eqid
     (fsteq k215UnpairAt4591CodeStep) (sndeq k215UnpairAt4591CodeStep) eqid eqid))) k215UnpairAt4591Claim_at));
theorem k215UnpairAt4591Claim_all (n c: nat): $ k215UnpairAt4591Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt4591RunZero)) '(iald @ iald k215UnpairAt4591RunInductive));
pub theorem k215UnpairMacro4591 (n a b c: nat): $ k215PReach (k215UnpairAt4591State k215PNum4591 a b n c) (k215UnpairAt4591State k215PNum4599 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
 '(ax_mp k215UnpairAt4591Claim_at k215UnpairAt4591Claim_all);
pub theorem k215UnpairMacro4591_clean (n c: nat): $ k215PReach (k215UnpairAt4591State k215PNum4591 0 0 n c) (k215UnpairAt4591State k215PNum4599 (fst n) (snd n) 0 c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt4591Stateeq eqid
   (fsteq (eqtr (addeq1 pr0) add01))
   (sndeq (eqtr (addeq1 pr0) add01)) eqid eqid)) k215UnpairMacro4591);


