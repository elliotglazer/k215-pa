import "extracted_named_quantifiers.mm0";
import "k218q_specialization.mm0";

theorem k218INamed_allE_scoped (H: nat) (E: set) (n k y a: nat)
 (hz: $ k != 0 $) (hy: $ y < k $) (he: $ sqEnvAvoid E n k $)
 (ha: $ sfBound (suc n) a $):
 $ k218IHypProvable H (sfNamedTemplate E k 0 (sfAll a)) ->
   k218IHypProvable H (sfNamedTemplate (sqEnvCons y E) (suc k) 0 a) $;
theorem k218INamed_exI_scoped (H: nat) (E: set) (n k y a: nat)
 (hz: $ k != 0 $) (hy: $ y < k $) (he: $ sqEnvAvoid E n k $)
 (ha: $ sfBound (suc n) a $):
 $ k218IHypProvable H (sfNamedTemplate (sqEnvCons y E) (suc k) 0 a) ->
   k218IHypProvable H (sfNamedTemplate E k 0 (sfEx a)) $;
