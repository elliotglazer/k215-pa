import "pa_formula_substitution.mm1";

theorem paFSubBound_cond (G p I J: wff) (b x y: nat) (hp: $ G /\ p -> I -> paFormulaBound b x $) (hn: $ G -> J -> paFormulaBound b y $): $ G -> ifp p I J -> paFormulaBound b (if p x y) $ = (named '(eord (impd @ exp @ sylibrd hp (srecpeq2d (preq2d (syl ifpos anr)))) (impd @ exp @ sylibrd (syl hn anl) (srecpeq2d (preq2d (syl ifneg anr))))));

theorem paFSubBound_ind_at (n a c b: nat): $ A. j (j < c -> A. q (paFormulaBound (q + suc n) j -> paFormulaBound (q + n) (paFormulaSubst q a j))) -> b < c -> A. q (paFormulaBound (q + suc n) b -> paFormulaBound (q + n) (paFormulaSubst q a b)) $ = (named '(!! eale j ,eqtac));

theorem paFSubBound_specialize (d n a b: nat): $ A. q (paFormulaBound (q + suc n) b -> paFormulaBound (q + n) (paFormulaSubst q a b)) -> paFormulaBound (d + suc n) b -> paFormulaBound (d + n) (paFormulaSubst d a b) $ = (named '(!! eale q ,eqtac));

theorem paFSubBound_use {j q: nat} (G: wff j q) (d n a c b: nat) (hi: $ G -> A. j (j < c -> A. q (paFormulaBound (q + suc n) j -> paFormulaBound (q + n) (paFormulaSubst q a j))) $) (hb: $ G -> b < c $): $ G -> paFormulaBound (d + suc n) b -> paFormulaBound (d + n) (paFormulaSubst d a b) $ = (named '(syl paFSubBound_specialize @ mpd hb (syl paFSubBound_ind_at hi)));

theorem paFSubBound_history {j q: nat} (G: wff j q) (d e n a c b: nat) (hi: $ G -> A. j (j < c -> A. q (paFormulaBound (q + suc n) j -> paFormulaBound (q + n) (paFormulaSubst q a j))) $) (hb: $ G -> b < c $) (hk: $ G -> (e, b) < (d, c) $): $ G -> paFormulaBound (e + suc n) b -> paFormulaBound (e + n) (paFormulaSubstHistory d a c @ (e, b)) $ = (named '(sylibrd (paFSubBound_use hi hb) (srecpeq2d (preq2d (syl paFormulaSubstHistory_lookup hk)))));

theorem paFSubBound_source_history (n c m b: nat): $ (m, b) e. paFormulaBoundPrevious n c -> paFormulaBound m b $ = (named '(syl anr (bi1 paFormulaBoundPrevious_value)));

theorem paFSubBound_lift_input (d n b: nat): $ paFormulaBound (suc (d + suc n)) b -> paFormulaBound (suc d + suc n) b $ = (named '(bi2 (paFormulaBoundeq1 addS1)));

theorem paFSubBound_lift_output (d n b: nat): $ paFormulaBound (suc d + n) b -> paFormulaBound (suc (d + n)) b $ = (named '(bi1 (paFormulaBoundeq1 addS1)));

theorem paFSubBound_body {j q: nat} (G: wff j q) (d n a c: nat) (hr: $ G -> paTermBound n a $) (hi: $ G -> A. j (j < c -> A. q (paFormulaBound (q + suc n) j -> paFormulaBound (q + n) (paFormulaSubst q a j))) $): $ G -> paFormulaBoundAllowed (d + suc n) c (paFormulaBoundPrevious (d + suc n) c) -> paFormulaBound (d + n) (paFormulaSubstBody d a c (paFormulaSubstHistory d a c)) $ = (named '(paFSubBound_cond (a1i (a1i paFormulaBound_false)) (paFSubBound_cond (exp @ syl (bi2 paFormulaBound_equal) (iand (sylc paTermSubst_bound (syl hr anll) anrl) (sylc paTermSubst_bound (syl hr anll) anrr))) (paFSubBound_cond (exp @ syl (bi2 paFormulaBound_and) (iand (mpd (syl paFSubBound_source_history anrl) (paFSubBound_history (syl hi anll) (syl sfLeft_lt (sfRename_code_positive anlr (ltneri lt01S))) (syl sfKey_lt (syl sfLeft_lt (sfRename_code_positive anlr (ltneri lt01S)))))) (mpd (syl paFSubBound_source_history anrr) (paFSubBound_history (syl hi anll) (syl sfRight_lt (sfRename_code_positive anlr (ltneri lt01S))) (syl sfKey_lt (syl sfRight_lt (sfRename_code_positive anlr (ltneri lt01S)))))))) (paFSubBound_cond (exp @ syl (bi2 paFormulaBound_or) (iand (mpd (syl paFSubBound_source_history anrl) (paFSubBound_history (syl hi anll) (syl sfLeft_lt (sfRename_code_positive anlr (ltneri lt01S))) (syl sfKey_lt (syl sfLeft_lt (sfRename_code_positive anlr (ltneri lt01S)))))) (mpd (syl paFSubBound_source_history anrr) (paFSubBound_history (syl hi anll) (syl sfRight_lt (sfRename_code_positive anlr (ltneri lt01S))) (syl sfKey_lt (syl sfRight_lt (sfRename_code_positive anlr (ltneri lt01S)))))))) (paFSubBound_cond (exp @ syl (bi2 paFormulaBound_imp) (iand (mpd (syl paFSubBound_source_history anrl) (paFSubBound_history (syl hi anll) (syl sfLeft_lt (sfRename_code_positive anlr (ltneri lt01S))) (syl sfKey_lt (syl sfLeft_lt (sfRename_code_positive anlr (ltneri lt01S)))))) (mpd (syl paFSubBound_source_history anrr) (paFSubBound_history (syl hi anll) (syl sfRight_lt (sfRename_code_positive anlr (ltneri lt01S))) (syl sfKey_lt (syl sfRight_lt (sfRename_code_positive anlr (ltneri lt01S)))))))) (paFSubBound_cond (exp @ syl (bi2 paFormulaBound_all) (syl paFSubBound_lift_output (mpd (syl paFSubBound_lift_input (syl paFSubBound_source_history anr)) (paFSubBound_history (syl hi anll) (syl sfLeft_lt (sfRename_code_positive (syl anl anlr) (ltneri lt01S))) (syl sfKey_underBinder_lt (syl sfLeft_lt (sfRename_code_positive (syl anl anlr) (ltneri lt01S)))))))) (paFSubBound_cond (exp @ syl (bi2 paFormulaBound_ex) (syl paFSubBound_lift_output (mpd (syl paFSubBound_lift_input (syl paFSubBound_source_history anr)) (paFSubBound_history (syl hi anll) (syl sfLeft_lt (sfRename_code_positive (syl anl anlr) (ltneri lt01S))) (syl sfKey_underBinder_lt (syl sfLeft_lt (sfRename_code_positive (syl anl anlr) (ltneri lt01S)))))))) (a1i (a1i paFormulaBound_false))))))))));

theorem paFSubBound_actual {j q: nat} (G: wff j q) (d n a c: nat) (hr: $ G -> paTermBound n a $) (hi: $ G -> A. j (j < c -> A. q (paFormulaBound (q + suc n) j -> paFormulaBound (q + n) (paFormulaSubst q a j))) $): $ G -> paFormulaBound (d + suc n) c -> paFormulaBound (d + n) (paFormulaSubst d a c) $ = (named '(syl5bi paFormulaBound_unfold @ sylibrd (paFSubBound_body hr hi) (a1i (srecpeq2 (preq2 paFormulaSubst_unfold)))));

theorem paFSubBound_alpha (n a c: nat): $ A. k (paFormulaBound (k + suc n) c -> paFormulaBound (k + n) (paFormulaSubst k a c)) <-> A. q (paFormulaBound (q + suc n) c -> paFormulaBound (q + n) (paFormulaSubst q a c)) $ = (named '(cbval ,eqtac));

theorem paFSubBound_step {j q: nat} (G: wff j q) (n a c: nat) (hr: $ G -> paTermBound n a $) (hi: $ G -> A. j (j < c -> A. q (paFormulaBound (q + suc n) j -> paFormulaBound (q + n) (paFormulaSubst q a j))) $): $ G -> A. q (paFormulaBound (q + suc n) c -> paFormulaBound (q + n) (paFormulaSubst q a c)) $ = (named '(sylib paFSubBound_alpha @ !! iald k @ paFSubBound_actual hr hi));

theorem paFSubBound_all (n a c: nat): $ paTermBound n a -> A. q (paFormulaBound (q + suc n) c -> paFormulaBound (q + n) (paFormulaSubst q a c)) $ = (named '(!! indstr j y {,eqtac : $ j = c -> ((A. q (paFormulaBound (q + suc n) j -> paFormulaBound (q + n) (paFormulaSubst q a j))) <-> (A. q (paFormulaBound (q + suc n) c -> paFormulaBound (q + n) (paFormulaSubst q a c)))) $} ,eqtac (paFSubBound_step anl anr)));

pub theorem paFormulaSubst_bound (d n a c: nat): $ paTermBound n a -> paFormulaBound (d + suc n) c -> paFormulaBound (d + n) (paFormulaSubst d a c) $ = (named '(syl paFSubBound_specialize paFSubBound_all));
