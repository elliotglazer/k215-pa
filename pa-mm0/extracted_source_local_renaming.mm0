import "zfc_irreflexive.mm0";
import "source_nd_renaming.mm0";

-- Local closure of the existing numerical FullND renaming theorem.
-- The existential proof witness is transformed with the correct depth
-- changes across AllI and ExE; no pointwise fixed-depth row map is assumed.
theorem exLocalRename (R: set) (d G a: nat):
  $ nsLocal G a ->
    nsLocal (sfContextRename R d G) (sfRename R d a) $;
