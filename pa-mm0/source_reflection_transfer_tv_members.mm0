import "source_reflection_transfer_tv_inputs.mm0";

def sfTVShiftMemberRow(H:wff)(G y k j:nat):wff = $ H -> j < suc k -> nsLocal ((sfMem 0 (suc y)) : sfContextShift G) (sfMem (sfIdentityMap @ j) (suc y)) $;

theorem sfTVMembers_shift_if(H:wff)(G y k:nat)(hm:$ H -> sfReflectionDnMembers sfIdentityMap G y k $): $ H -> sfReflectionDnMembers sfIdentityMap ((sfMem 0 (suc y)) : sfContextShift G) (suc y) (suc k) $;

theorem sfTVMembers_shift(G y k:nat)(hm:$ sfReflectionDnMembers sfIdentityMap G y k $): $ sfReflectionDnMembers sfIdentityMap ((sfMem 0 (suc y)) : sfContextShift G) (suc y) (suc k) $;
