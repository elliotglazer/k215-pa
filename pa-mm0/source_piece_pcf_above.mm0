import "source_piece_pcf_d0_instance.mm0";

import "source_piece_pcf_above_kernel.mm0";

theorem sfPieceLevelAbove_from_exists_subset
 (he:$ sfTheoryProvable zfrAxioms sfPieceLevelEx $)
 (hs:$ sfTheoryProvable zfrAxioms sfPieceLevelSub $):
 $ sfTheoryProvable zfrAxioms sfPieceLevelAbove $;

theorem sfPieceDnD0_from_exists_subset(count phi:nat)(hf:$ sfWf phi $)
 (he:$ sfTheoryProvable zfrAxioms sfPieceLevelEx $)
 (hs:$ sfTheoryProvable zfrAxioms sfPieceLevelSub $):
 $ sfTheoryProvable zfrAxioms (sfPieceDnExistenceCode count (sfPieceD0Canonical phi)) $;
