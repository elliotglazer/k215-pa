import "pa_proof_numeral_bounded_logic.mm0";

def paProofNumeralBoundedQFFalseElimWitness (n a: nat): nat = $ paAxiomWitness 3 a 0 0 $;

def paProofNumeralBoundedQFFalseElimRow (n a: nat): nat = $ paProofNumeralAxiomRow n (paAxiomFalseElim a) (paProofNumeralBoundedQFFalseElimWitness n a) $;

def paProofNumeralBoundedQFFalseElimProof (n a: nat): nat = $ paProofNumeralAxiomProof n (paAxiomFalseElim a) (paProofNumeralBoundedQFFalseElimWitness n a) $;

theorem paProofNumeralBoundedQFFalseElim_derives (n a: nat): $ paFormulaBound n a -> paProofDerives (paProofNumeralBoundedQFFalseElimProof n a) (paProofNumeralBoundedQFFalseElimRow n a) $;

def paProofNumeralBoundedQFAndLeftWitness (n a b: nat): nat = $ paAxiomWitness 4 a b 0 $;

def paProofNumeralBoundedQFAndLeftRow (n a b: nat): nat = $ paProofNumeralAxiomRow n (paAxiomAndLeft a b) (paProofNumeralBoundedQFAndLeftWitness n a b) $;

def paProofNumeralBoundedQFAndLeftProof (n a b: nat): nat = $ paProofNumeralAxiomProof n (paAxiomAndLeft a b) (paProofNumeralBoundedQFAndLeftWitness n a b) $;

theorem paProofNumeralBoundedQFAndLeft_derives (n a b: nat): $ paFormulaBound n a /\ paFormulaBound n b -> paProofDerives (paProofNumeralBoundedQFAndLeftProof n a b) (paProofNumeralBoundedQFAndLeftRow n a b) $;

def paProofNumeralBoundedQFAndRightWitness (n a b: nat): nat = $ paAxiomWitness 5 a b 0 $;

def paProofNumeralBoundedQFAndRightRow (n a b: nat): nat = $ paProofNumeralAxiomRow n (paAxiomAndRight a b) (paProofNumeralBoundedQFAndRightWitness n a b) $;

def paProofNumeralBoundedQFAndRightProof (n a b: nat): nat = $ paProofNumeralAxiomProof n (paAxiomAndRight a b) (paProofNumeralBoundedQFAndRightWitness n a b) $;

theorem paProofNumeralBoundedQFAndRight_derives (n a b: nat): $ paFormulaBound n a /\ paFormulaBound n b -> paProofDerives (paProofNumeralBoundedQFAndRightProof n a b) (paProofNumeralBoundedQFAndRightRow n a b) $;

def paProofNumeralBoundedQFAndIntroWitness (n a b: nat): nat = $ paAxiomWitness 6 a b 0 $;

def paProofNumeralBoundedQFAndIntroRow (n a b: nat): nat = $ paProofNumeralAxiomRow n (paAxiomAndIntro a b) (paProofNumeralBoundedQFAndIntroWitness n a b) $;

def paProofNumeralBoundedQFAndIntroProof (n a b: nat): nat = $ paProofNumeralAxiomProof n (paAxiomAndIntro a b) (paProofNumeralBoundedQFAndIntroWitness n a b) $;

theorem paProofNumeralBoundedQFAndIntro_derives (n a b: nat): $ paFormulaBound n a /\ paFormulaBound n b -> paProofDerives (paProofNumeralBoundedQFAndIntroProof n a b) (paProofNumeralBoundedQFAndIntroRow n a b) $;

def paProofNumeralBoundedQFOrLeftWitness (n a b: nat): nat = $ paAxiomWitness 7 a b 0 $;

def paProofNumeralBoundedQFOrLeftRow (n a b: nat): nat = $ paProofNumeralAxiomRow n (paAxiomOrLeft a b) (paProofNumeralBoundedQFOrLeftWitness n a b) $;

def paProofNumeralBoundedQFOrLeftProof (n a b: nat): nat = $ paProofNumeralAxiomProof n (paAxiomOrLeft a b) (paProofNumeralBoundedQFOrLeftWitness n a b) $;

theorem paProofNumeralBoundedQFOrLeft_derives (n a b: nat): $ paFormulaBound n a /\ paFormulaBound n b -> paProofDerives (paProofNumeralBoundedQFOrLeftProof n a b) (paProofNumeralBoundedQFOrLeftRow n a b) $;

def paProofNumeralBoundedQFOrRightWitness (n a b: nat): nat = $ paAxiomWitness 8 a b 0 $;

def paProofNumeralBoundedQFOrRightRow (n a b: nat): nat = $ paProofNumeralAxiomRow n (paAxiomOrRight a b) (paProofNumeralBoundedQFOrRightWitness n a b) $;

def paProofNumeralBoundedQFOrRightProof (n a b: nat): nat = $ paProofNumeralAxiomProof n (paAxiomOrRight a b) (paProofNumeralBoundedQFOrRightWitness n a b) $;

theorem paProofNumeralBoundedQFOrRight_derives (n a b: nat): $ paFormulaBound n a /\ paFormulaBound n b -> paProofDerives (paProofNumeralBoundedQFOrRightProof n a b) (paProofNumeralBoundedQFOrRightRow n a b) $;

def paProofNumeralBoundedQFOrElimWitness (n a b c: nat): nat = $ paAxiomWitness 9 a b c $;

def paProofNumeralBoundedQFOrElimRow (n a b c: nat): nat = $ paProofNumeralAxiomRow n (paAxiomOrElim a b c) (paProofNumeralBoundedQFOrElimWitness n a b c) $;

def paProofNumeralBoundedQFOrElimProof (n a b c: nat): nat = $ paProofNumeralAxiomProof n (paAxiomOrElim a b c) (paProofNumeralBoundedQFOrElimWitness n a b c) $;

theorem paProofNumeralBoundedQFOrElim_derives (n a b c: nat): $ paFormulaBound n a /\ paFormulaBound n b /\ paFormulaBound n c -> paProofDerives (paProofNumeralBoundedQFOrElimProof n a b c) (paProofNumeralBoundedQFOrElimRow n a b c) $;

def paProofNumeralBoundedQFIdentityFirstAnnotation (n a: nat): nat = $ paProofNumeralBoundedMPAnnotation n (paFormulaImp a (paFormulaImp (paFormulaImp a a) a)) (paFormulaImp (paFormulaImp a (paFormulaImp a a)) (paFormulaImp a a)) (paProofAxiomAnnotation (paProofNumeralBoundedProp1Witness n a (paFormulaImp a a))) (paProofAxiomAnnotation (paProofNumeralBoundedProp2Witness n a (paFormulaImp a a) a)) $;

def paProofNumeralBoundedQFIdentityFirstProof (n a: nat): nat = $ paProofNumeralBoundedMPProof n (paFormulaImp a (paFormulaImp (paFormulaImp a a) a)) (paFormulaImp (paFormulaImp a (paFormulaImp a a)) (paFormulaImp a a)) (paProofAxiomAnnotation (paProofNumeralBoundedProp1Witness n a (paFormulaImp a a))) (paProofAxiomAnnotation (paProofNumeralBoundedProp2Witness n a (paFormulaImp a a) a)) (paProofNumeralBoundedProp1Proof n a (paFormulaImp a a)) (paProofNumeralBoundedProp2Proof n a (paFormulaImp a a) a) $;

def paProofNumeralBoundedQFIdentityAnnotation (n a: nat): nat = $ paProofNumeralBoundedMPAnnotation n (paFormulaImp a (paFormulaImp a a)) (paFormulaImp a a) (paProofAxiomAnnotation (paProofNumeralBoundedProp1Witness n a a)) (paProofNumeralBoundedQFIdentityFirstAnnotation n a) $;

def paProofNumeralBoundedQFIdentityRow (n a: nat): nat = $ paProofRow n (paFormulaImp a a) (paProofNumeralBoundedQFIdentityAnnotation n a) $;

def paProofNumeralBoundedQFIdentityProof (n a: nat): nat = $ paProofNumeralBoundedMPProof n (paFormulaImp a (paFormulaImp a a)) (paFormulaImp a a) (paProofAxiomAnnotation (paProofNumeralBoundedProp1Witness n a a)) (paProofNumeralBoundedQFIdentityFirstAnnotation n a) (paProofNumeralBoundedProp1Proof n a a) (paProofNumeralBoundedQFIdentityFirstProof n a) $;

theorem paProofNumeralBoundedQFIdentity_derives (n a: nat): $ paFormulaBound n a -> paProofDerives (paProofNumeralBoundedQFIdentityProof n a) (paProofNumeralBoundedQFIdentityRow n a) $;
