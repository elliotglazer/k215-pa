import "k218q_named_support.mm0";
import "k218q_equality.mm0";
import "zfc_fixed.mm0";

theorem k218QSourceRefl_syntax (E: set) (k: nat):
 $ sfNamedTemplate E k 0 zfcRefl = (kAll (k + 0) (kEq (k + 0) (k + 0))) $;

theorem k218QSourceRefl (E: set) (k: nat):
 $ k218QProvable (sfNamedTemplate E k 0 zfcRefl) $;

theorem k218QSourceSym_syntax (E: set) (k: nat):
 $ sfNamedTemplate E k 0 zfcSym = (kAll (k + 0) (kAll (k + 1) (kImp (kEq (k + 0) (k + 1)) (kEq (k + 1) (k + 0))))) $;

theorem k218QSourceSym (E: set) (k: nat):
 $ k218QProvable (sfNamedTemplate E k 0 zfcSym) $;

theorem k218QSourceTrans_syntax (E: set) (k: nat):
 $ sfNamedTemplate E k 0 zfcTrans = (kAll (k + 0) (kAll (k + 1) (kAll (k + 2) (kImp (kEq (k + 0) (k + 1)) (kImp (kEq (k + 1) (k + 2)) (kEq (k + 0) (k + 2))))))) $;

theorem k218QSourceTrans (E: set) (k: nat):
 $ k218QProvable (sfNamedTemplate E k 0 zfcTrans) $;

theorem k218QSourceEqElem_syntax (E: set) (k: nat):
 $ sfNamedTemplate E k 0 zfcEqElem = (kAll (k + 0) (kAll (k + 1) (kAll (k + 2) (kAll (k + 3) (kImp (kEq (k + 0) (k + 2)) (kImp (kEq (k + 1) (k + 3)) (kImp (kMem (k + 0) (k + 1)) (kMem (k + 2) (k + 3))))))))) $;

theorem k218QSourceEqElem (E: set) (k: nat):
 $ k218QProvable (sfNamedTemplate E k 0 zfcEqElem) $;

def k218QEqualityContext: nat = $ zfcRefl : (zfcSym : (zfcTrans : (zfcEqElem : 0))) $;

theorem k218QEqualityContext_support (H S k: nat):
 $ k218INamedSupport H S k k218QEqualityContext $;
