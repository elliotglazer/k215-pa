import "bb215_table_arithmetic_valid_graph.mm0";

import "bb215_table_arithmetic_guards.mm0";

import "bb215_arithmetic_formula_nth_scalar.mm0";

def bb215TableArithmeticStoredActionValid (v .a: nat): wff = $ E. a (bb215ArithmeticFormulaPredecessorGraph v a /\ bb215TableArithmeticActionGraph a) $;

theorem bb215TableArithmeticStoredActionValid_correct (v: nat) {a r t k: nat}: $ bb215TableArithmeticStoredActionValid v <-> k215TMValidAction (v - 1) $;

def bb215TableArithmeticUniversalEntry (T q b .i .v: nat): wff = $ A. i A. v (bb215ArithmeticFormulaPairGraph q b i /\ bb215ArithmeticFormulaNthScalarGraph i T v -> bb215TableArithmeticStoredActionValid v) $;

theorem bb215TableArithmeticUniversalEntry_correct (T q b: nat) {i v a r t k: nat}: $ bb215TableArithmeticUniversalEntry T q b <-> k215TMValidAction (bb215Action T q b) $;

def bb215TableArithmeticValidPolynomial (T .q .b: nat): wff = $ A. q A. b ((bb215TableArithmeticWorkingGraph q /\ (b = 0 \/ b = 1)) -> bb215TableArithmeticUniversalEntry T q b) $;

theorem bb215TableArithmeticValidPolynomial_correct (T: nat) {q b i v a r t k h: nat}: $ bb215TableArithmeticValidPolynomial T <-> bb215Valid T $;
