import "source_l_separation_image_op5_extension.mm0";
import "source_l_separation_image_op5_support.mm0";

theorem sfLSeparationOp5_profile_from_background(T:set)(G n phi R A s Y:nat)
 (hb:$ sfBound (suc n) phi $)
 (hg:$ sfContextWf G $)(hi:$ sfContextSub sfLBackground G $)
 (hr:$ nsLocal G (sfPieceDefinableNamed (suc n) phi R A) $)
 (hm:$ sfReflectionDnMembers T G A n $)
 (hs:$ nsLocal G (sfPieceEnv T n s) $)
 (ho:$ nsLocal G (sfLSeparationOp5 R s A Y) $):
 $ nsLocal G (sfPieceDefinableProfile T phi A Y) $;
