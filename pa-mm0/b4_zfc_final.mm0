import "b4_zfc_c7.mm0";

theorem bdZfcBot_intro (mm vv BB GG pp: nat): $ bdZfcJust mm vv BB /\ GG <= BB /\ pp <= BB /\ sfSequent GG 0 <= pp /\ bdHas mm vv vv bdtCax GG 0 0 0 /\ bdHas mm vv vv bdtValid pp 0 0 0 /\ bdHas mm vv vv bdtIn (sfSequent GG 0) pp 0 0 -> bdZfcBot (mm, (vv, BB)) $;
theorem bdZfcBot_cert (GG pp: nat) {w: nat}: $ zfcContext GG -> traceValid sfNDFullRules pp -> sfSequent GG 0 IN pp -> E. w bdZfcBot w $;
theorem bdZfcBot_complete {w: nat}: $ zfcInconsistent -> E. w bdZfcBot w $;
theorem bdZfcBot_iff {w: nat}: $ zfcInconsistent <-> E. w bdZfcBot w $;
