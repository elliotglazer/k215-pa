pub theorem sfK0QSepCut_profile_alignment (E: set) (n t a b k theta: nat) (hf: $ sfBound (suc n) theta $) (hk: $ 0 < k $)
 (ht: $ t < k $) (ha: $ a < k $) (hb: $ b < k $) (he: $ sqEnvBelow E n k $):
 $ (kExists (suc (suc (suc (suc (suc k))))) (sfK0QSepSeedProfile (sqEnvCons a (sqEnvCons t E)) t b (suc (suc (suc (suc (suc k))))) (suc (suc (suc k))) (suc (suc (suc (suc (suc (suc (suc (suc k)))))))) (sfK0QSepDomainCut theta))) = (kExists (suc (suc (suc (suc (suc k))))) (kAll (suc (suc (suc k))) (sfK0QSepRawProfile t a b (suc (suc (suc (suc (suc k))))) (suc (suc (suc k))) (sfNamedTemplate (sqEnvCons (suc (suc (suc k))) E) (suc (suc (suc (suc (suc (suc (suc (suc k)))))))) 0 theta)))) $ =
(named '(kExistseq2 (kAlleq2 (kAndeq (kImpeq2 (kDisjeq2 (kDisjeq2 (kAndeq2 (sfK0QSepCut_named (ax_mp sfBound_wf hf)))))) (kImpeq1 (kDisjeq2 (kDisjeq2 (kAndeq2 (sfK0QSepCut_named (ax_mp sfBound_wf hf))))))))));

pub theorem sfK0QSepCut_profile (E: set) (n t a b k theta: nat) (hf: $ sfBound (suc n) theta $) (hk: $ 0 < k $)
 (ht: $ t < k $) (ha: $ a < k $) (hb: $ b < k $) (he: $ sqEnvBelow E n k $):
 $ k218QProvable (kImp (kAnd (kAll (suc (suc (suc (suc (suc (suc (suc k))))))) (kNot (kMem (suc (suc (suc (suc (suc (suc (suc k))))))) t))) (kNot (kEq b t))) (kExists (suc (suc (suc (suc (suc k))))) (kAll (suc (suc (suc k))) (sfK0QSepRawProfile t a b (suc (suc (suc (suc (suc k))))) (suc (suc (suc k))) (sfNamedTemplate (sqEnvCons (suc (suc (suc k))) E) (suc (suc (suc (suc (suc (suc (suc (suc k)))))))) 0 theta))))) $ =
(named '(mpbi (k218QProvableeq (kImpeq2 (sfK0QSepCut_profile_alignment hf hk ht ha hb he))) (! sfK0QSepPair_profile $ (sqEnvCons a (sqEnvCons t E)) $ $ (suc (suc n)) $ $ b $ $ t $ $ k $ $ (sfK0QSepDomainCut theta) $ (sfK0QSepDomainCut_bound hf) hk hb ht (ax_mp (ax_mp sqEnvBelow_cons ha) (ax_mp (ax_mp sqEnvBelow_cons ht) he)))));
