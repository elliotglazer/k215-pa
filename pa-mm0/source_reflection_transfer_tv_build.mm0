import "source_reflection_transfer_tv_members.mm0";

def sfTVBuildClass(D N C:nat)(.c .g .y .k:nat):set = $ {c | A. g A. y A. k (sfContextWf g -> k + c <= N -> c <= C -> sfBound k c -> sfReflectionDnMembers sfIdentityMap g y k -> nsLocal g zfcRefl -> sfTVRowInputs D g y N C -> nsLocal g (sfTVRequirements D y c))} $;

theorem sfTVRequirements_from_rows(D N C c G y k:nat)(hd:$ sfBound 1 D $)(hg:$ sfContextWf G $)(hn:$ k + c <= N $)(hc:$ c <= C $)(hb:$ sfBound k c $)(hm:$ sfReflectionDnMembers sfIdentityMap G y k $)(he:$ nsLocal G zfcRefl $)(hr:$ sfTVRowInputs D G y N C $): $ nsLocal G (sfTVRequirements D y c) $;
