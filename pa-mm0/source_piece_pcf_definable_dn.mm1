pub theorem sfPieceDefinableDn_apply (G n a b:nat)(ha:$ sfWf a $)(hb:$ sfWf b $)(hi:$ nsLocal G (sfPieceDn n (sfImp a b)) $)(hp:$ nsLocal G (sfPieceDn n a) $): $ nsLocal G (sfPieceDn n b) $ = (named '(ax_mp (ax_mp nsLocal_mp (ax_mp (ax_mp nsLocal_mp (ax_mp (ax_mp (ax_mp nsLocal_weaken (ax_mp nsLocal_context_wf hi)) all0) (sfPieceDefinableDn_apply_pure ha hb))) hi)) hp));
