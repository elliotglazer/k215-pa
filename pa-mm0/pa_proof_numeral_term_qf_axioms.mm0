import "pa_proof_numeral_term_inequality.mm0";

import "pa_source_interpretation_nat_qf_induction.mm0";

import "bb215_arithmetic_formula_qf_sat.mm0";

def paProofNumeralTermQFFalseElimWitness (a: nat): nat = $ paAxiomWitness 3 a 0 0 $;

def paProofNumeralTermQFFalseElimRow (a: nat): nat = $ paProofNumeralAxiomRow 0 (paAxiomFalseElim a) (paProofNumeralTermQFFalseElimWitness a) $;

def paProofNumeralTermQFFalseElimProof (a: nat): nat = $ paProofNumeralAxiomProof 0 (paAxiomFalseElim a) (paProofNumeralTermQFFalseElimWitness a) $;

theorem paProofNumeralTermQFFalseElim_derives (a: nat): $ paFormulaBound 0 a -> paProofDerives (paProofNumeralTermQFFalseElimProof a) (paProofNumeralTermQFFalseElimRow a) $;

def paProofNumeralTermQFAndLeftWitness (a b: nat): nat = $ paAxiomWitness 4 a b 0 $;

def paProofNumeralTermQFAndLeftRow (a b: nat): nat = $ paProofNumeralAxiomRow 0 (paAxiomAndLeft a b) (paProofNumeralTermQFAndLeftWitness a b) $;

def paProofNumeralTermQFAndLeftProof (a b: nat): nat = $ paProofNumeralAxiomProof 0 (paAxiomAndLeft a b) (paProofNumeralTermQFAndLeftWitness a b) $;

theorem paProofNumeralTermQFAndLeft_derives (a b: nat): $ paFormulaBound 0 a /\ paFormulaBound 0 b -> paProofDerives (paProofNumeralTermQFAndLeftProof a b) (paProofNumeralTermQFAndLeftRow a b) $;

def paProofNumeralTermQFAndRightWitness (a b: nat): nat = $ paAxiomWitness 5 a b 0 $;

def paProofNumeralTermQFAndRightRow (a b: nat): nat = $ paProofNumeralAxiomRow 0 (paAxiomAndRight a b) (paProofNumeralTermQFAndRightWitness a b) $;

def paProofNumeralTermQFAndRightProof (a b: nat): nat = $ paProofNumeralAxiomProof 0 (paAxiomAndRight a b) (paProofNumeralTermQFAndRightWitness a b) $;

theorem paProofNumeralTermQFAndRight_derives (a b: nat): $ paFormulaBound 0 a /\ paFormulaBound 0 b -> paProofDerives (paProofNumeralTermQFAndRightProof a b) (paProofNumeralTermQFAndRightRow a b) $;

def paProofNumeralTermQFAndIntroWitness (a b: nat): nat = $ paAxiomWitness 6 a b 0 $;

def paProofNumeralTermQFAndIntroRow (a b: nat): nat = $ paProofNumeralAxiomRow 0 (paAxiomAndIntro a b) (paProofNumeralTermQFAndIntroWitness a b) $;

def paProofNumeralTermQFAndIntroProof (a b: nat): nat = $ paProofNumeralAxiomProof 0 (paAxiomAndIntro a b) (paProofNumeralTermQFAndIntroWitness a b) $;

theorem paProofNumeralTermQFAndIntro_derives (a b: nat): $ paFormulaBound 0 a /\ paFormulaBound 0 b -> paProofDerives (paProofNumeralTermQFAndIntroProof a b) (paProofNumeralTermQFAndIntroRow a b) $;

def paProofNumeralTermQFOrLeftWitness (a b: nat): nat = $ paAxiomWitness 7 a b 0 $;

def paProofNumeralTermQFOrLeftRow (a b: nat): nat = $ paProofNumeralAxiomRow 0 (paAxiomOrLeft a b) (paProofNumeralTermQFOrLeftWitness a b) $;

def paProofNumeralTermQFOrLeftProof (a b: nat): nat = $ paProofNumeralAxiomProof 0 (paAxiomOrLeft a b) (paProofNumeralTermQFOrLeftWitness a b) $;

theorem paProofNumeralTermQFOrLeft_derives (a b: nat): $ paFormulaBound 0 a /\ paFormulaBound 0 b -> paProofDerives (paProofNumeralTermQFOrLeftProof a b) (paProofNumeralTermQFOrLeftRow a b) $;

def paProofNumeralTermQFOrRightWitness (a b: nat): nat = $ paAxiomWitness 8 a b 0 $;

def paProofNumeralTermQFOrRightRow (a b: nat): nat = $ paProofNumeralAxiomRow 0 (paAxiomOrRight a b) (paProofNumeralTermQFOrRightWitness a b) $;

def paProofNumeralTermQFOrRightProof (a b: nat): nat = $ paProofNumeralAxiomProof 0 (paAxiomOrRight a b) (paProofNumeralTermQFOrRightWitness a b) $;

theorem paProofNumeralTermQFOrRight_derives (a b: nat): $ paFormulaBound 0 a /\ paFormulaBound 0 b -> paProofDerives (paProofNumeralTermQFOrRightProof a b) (paProofNumeralTermQFOrRightRow a b) $;

def paProofNumeralTermQFOrElimWitness (a b c: nat): nat = $ paAxiomWitness 9 a b c $;

def paProofNumeralTermQFOrElimRow (a b c: nat): nat = $ paProofNumeralAxiomRow 0 (paAxiomOrElim a b c) (paProofNumeralTermQFOrElimWitness a b c) $;

def paProofNumeralTermQFOrElimProof (a b c: nat): nat = $ paProofNumeralAxiomProof 0 (paAxiomOrElim a b c) (paProofNumeralTermQFOrElimWitness a b c) $;

theorem paProofNumeralTermQFOrElim_derives (a b c: nat): $ paFormulaBound 0 a /\ paFormulaBound 0 b /\ paFormulaBound 0 c -> paProofDerives (paProofNumeralTermQFOrElimProof a b c) (paProofNumeralTermQFOrElimRow a b c) $;

def paProofNumeralTermQFIdentityFirstAnnotation (a: nat): nat = $ paProofNumeralMPAnnotation (paFormulaImp a (paFormulaImp (paFormulaImp a a) a)) (paFormulaImp (paFormulaImp a (paFormulaImp a a)) (paFormulaImp a a)) (paProofAxiomAnnotation (paProofNumeralTermProp1Witness a (paFormulaImp a a))) (paProofAxiomAnnotation (paProofNumeralTermProp2Witness a (paFormulaImp a a) a)) $;

def paProofNumeralTermQFIdentityFirstProof (a: nat): nat = $ paProofNumeralMPProof (paFormulaImp a (paFormulaImp (paFormulaImp a a) a)) (paFormulaImp (paFormulaImp a (paFormulaImp a a)) (paFormulaImp a a)) (paProofAxiomAnnotation (paProofNumeralTermProp1Witness a (paFormulaImp a a))) (paProofAxiomAnnotation (paProofNumeralTermProp2Witness a (paFormulaImp a a) a)) (paProofNumeralTermProp1Proof a (paFormulaImp a a)) (paProofNumeralTermProp2Proof a (paFormulaImp a a) a) $;

def paProofNumeralTermQFIdentityAnnotation (a: nat): nat = $ paProofNumeralMPAnnotation (paFormulaImp a (paFormulaImp a a)) (paFormulaImp a a) (paProofAxiomAnnotation (paProofNumeralTermProp1Witness a a)) (paProofNumeralTermQFIdentityFirstAnnotation a) $;

def paProofNumeralTermQFIdentityRow (a: nat): nat = $ paProofRow 0 (paFormulaImp a a) (paProofNumeralTermQFIdentityAnnotation a) $;

def paProofNumeralTermQFIdentityProof (a: nat): nat = $ paProofNumeralMPProof (paFormulaImp a (paFormulaImp a a)) (paFormulaImp a a) (paProofAxiomAnnotation (paProofNumeralTermProp1Witness a a)) (paProofNumeralTermQFIdentityFirstAnnotation a) (paProofNumeralTermProp1Proof a a) (paProofNumeralTermQFIdentityFirstProof a) $;

theorem paProofNumeralTermQFIdentity_derives (a: nat): $ paFormulaBound 0 a -> paProofDerives (paProofNumeralTermQFIdentityProof a) (paProofNumeralTermQFIdentityRow a) $;
