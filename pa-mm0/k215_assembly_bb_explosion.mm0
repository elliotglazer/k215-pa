import "bb215_arithmetic_sentence_syntax.mm0";
import "raw_source_falsity.mm0";

-- L10 assembly. The easy half of the BB215 clause of targets/final.mm0:
-- an inconsistent source ZFC proves every frozen BB(215)=b sentence, so if no
-- value is provable then ZFC is consistent. No hypothesis is added.

theorem k215AssemblyBB_explosion (b: nat):
 $ zfcInconsistent -> zfcProvable (bb215ArithmeticSentenceSource b) $;

theorem k215AssemblyBB_all_provable {b: nat}:
 $ zfcInconsistent -> A. b zfcProvable (bb215ArithmeticSentenceSource b) $;

theorem k215AssemblyBB_none_implies_consistent {b: nat}:
 $ (A. b ~zfcProvable (bb215ArithmeticSentenceSource b)) -> ~zfcInconsistent $;
