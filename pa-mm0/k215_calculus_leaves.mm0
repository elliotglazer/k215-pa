theorem k215BundleLeaf_run (a b c r np t w: nat):
 $ k215EnumIter k215BundleLeafTime (k218EnumState (suc (k215BundleLeafPrefix a b c r)) np t w 0 0) =
   suc (k218EnumState r np (k218Gate a b c) w 0 0) $;

theorem k215BundleLeaf_enabled_run (a b c r np t w: nat):
 $ c != a /\ c != b ->
   k215EnumIter k215BundleLeafTime (k218EnumState (suc (k215BundleLeafPrefix a b c r)) np t w 0 0) =
   suc (k218EnumState r np (k218Bundle a b c) w 0 0) $;

theorem k215BundleLeaf_run_first (a b c r t w: nat):
 $ k215EnumIter k215BundleLeafTime (k218EnumState 0 (k215BundleLeafPrefix a b c r) t w 0 0) =
   suc (k218EnumState r (suc (k215BundleLeafPrefix a b c r)) (k218Gate a b c) w 0 0) $;

theorem k215BundleLeaf_enabled_run_first (a b c r t w: nat):
 $ c != a /\ c != b ->
   k215EnumIter k215BundleLeafTime (k218EnumState 0 (k215BundleLeafPrefix a b c r) t w 0 0) =
   suc (k218EnumState r (suc (k215BundleLeafPrefix a b c r)) (k218Bundle a b c) w 0 0) $;
