import "k215_calculus_operational.mm0";

def k215LeafTail (j r: nat): nat =
 $ k215NipPrefix j (suc (k215CmdDROP (k215NipPrefix ((suc 10) - j) r))) $;

def k215LeafPrefix (j a b c r: nat): nat =
 $ k215DiscardPrefix (suc (k215CmdAX c b a (k215LeafTail j r))) $;

def k215BundleLeafPrefix (a b c r: nat): nat =
 $ k215DiscardPrefix (suc (k215CmdAX c b a (k215NipPrefix 10 r))) $;

def k215LeafTime: nat = $ (suc (suc (suc 10))) + (suc (suc 10)) $;

def k215BundleLeafTime: nat = $ (suc 10) + (suc (suc 10)) $;

theorem k215LeafR1_run (a b c r np t w: nat):
 $ k215EnumIter k215LeafTime (k218EnumState (suc (k215LeafPrefix 1 a b c r)) np t w 0 0) =
   suc (k218EnumState r np (kRho1 a b) w 0 0) $;

theorem k215LeafR1_run_first (a b c r t w: nat):
 $ k215EnumIter k215LeafTime (k218EnumState 0 (k215LeafPrefix 1 a b c r) t w 0 0) =
   suc (k218EnumState r (suc (k215LeafPrefix 1 a b c r)) (kRho1 a b) w 0 0) $;

