 $ k215EnumIter k215LeafTime (k218EnumState (suc (k215LeafPrefix 2 a b c r)) np t w 0 0) =
   suc (k218EnumState r np (kRho2 a b c) w 0 0) $;

theorem k215LeafR2_run_first (a b c r t w: nat):
 $ k215EnumIter k215LeafTime (k218EnumState 0 (k215LeafPrefix 2 a b c r) t w 0 0) =
   suc (k218EnumState r (suc (k215LeafPrefix 2 a b c r)) (kRho2 a b c) w 0 0) $;

