import "source_l_level_member_names.mm0";

theorem sfLMemberBlock_subst1 (start n t: nat):
 $ sfSubst 1 t (sfCLMembership (suc (suc start)) 0 n) = sfCLMembership (suc start) 0 n $;

theorem sfLMemberBlock_subst0 (start n t: nat):
 $ sfSubst 0 t (sfCLMembership (suc start) 0 n) = sfCLMembership start t n $;

theorem sfLPoint_subst1 (start n t: nat):
 $ sfSubst 1 t (sfCLPoint (suc (suc start)) n 1 0) = sfCLPoint (suc start) n (suc t) 0 $;

theorem sfLPoint_subst0 (start n beta y: nat):
 $ sfSubst 0 y (sfCLPoint (suc start) n (suc beta) 0) = sfCLPoint start n beta y $;

theorem sfLRecipe_intro (G start n beta y: nat)
 (hp: $ nsLocal G (sfCLPoint start n beta y) $):
 $ nsLocal G (sfCLRecipe start n) $;
