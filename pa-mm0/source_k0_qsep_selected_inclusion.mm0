import "source_k0_qsep_request_selected.mm0";

import "source_k0_qsep_singleton_exists.mm0";

def sfK0QSepSelectedFacts (E: set) (r t b c x u y K theta: nat): nat = $ (kImp (kImp (kAll y (kImp (kMem y t) kF)) (kImp (kImp (kImp (kMem b r) (kImp (kImp (kImp (kMem t r) (kImp (kImp (kImp (kImp (kEq b t) kF) (kImp (kImp (kImp (kMem b c) (kImp (kImp (kImp (kAll u (kImp (kDisj (kEq u r) (kExists y (kAnd (kMem y c) (kAll K (kImp (kMem K u) (kMem K y)))))) (kImp (kExists y (kDisj (kAnd (kEq u r) (kEq y b)) (kDisj (kAnd (kEq u t) (kEq y t)) (kAnd (kAnd (kMem y u) (kAll K (kImp (kMem K u) (kEq K y)))) (kAnd (kMem y b) (sfNamedTemplate (sqEnvCons y E) K 0 theta)))))) (kExists y (kAnd (kMem y c) (kDisj (kAnd (kEq u r) (kEq y b)) (kDisj (kAnd (kEq u t) (kEq y t)) (kAnd (kAnd (kMem y u) (kAll K (kImp (kMem K u) (kEq K y)))) (kAnd (kMem y b) (sfNamedTemplate (sqEnvCons y E) K 0 theta)))))))))) (kImp (kImp (kImp (kMem x b) (kImp (sfNamedTemplate (sqEnvCons x E) K 0 theta) kF)) kF) kF)) kF) kF)) kF) kF)) kF) kF)) kF) kF)) kF) kF)) kF) $;

theorem sfK0QSepSelected_inclusion (E: set) (n a r t b c p x u y K theta: nat)
 (hf: $ sfBound (suc n) theta $) (hu0: $ u != 0 $) (hy0: $ y != 0 $)
 (huK: $ u < K $) (hyK: $ y < K $) (hpK: $ p < K $) (hxK: $ x < K $)
 (hbK: $ b < K $) (htK: $ t < K $) (hrK: $ r < K $)
 (hru: $ r != u $) (htu: $ t != u $) (hbu: $ b != u $) (hcu: $ c != u $)
 (hyu: $ y != u $) (huy: $ u < y $) (hpy: $ p < y $)
 (hyr: $ y != r $) (hyt: $ y != t $) (hyb: $ y != b $) (hyc: $ y != c $)
 (hyp: $ y != p $) (hyx: $ y != x $)
 (heu: $ sqEnvAvoid E n u $) (hey: $ sqEnvAvoid E n y $) (hpu: $ p != u $)
 (ha0: $ 0 < a $) (hxa: $ x < a $) (hp0: $ p != 0 $)
 (hpr: $ p != r $) (hpt: $ p != t $) (hpb: $ p != b $) (hpc: $ p != c $) (hpx: $ p != x $)
 (hep: $ sqEnvAvoid E n p $)
 (hpA1: $ p != suc a $) (hpA2: $ p != suc (suc a) $) (hKA2: $ K != suc (suc a) $):
 $ k218QProvable (kImp (sfK0QSepSelectedFacts E r t b c x u y K theta) (kMem x c)) $;
