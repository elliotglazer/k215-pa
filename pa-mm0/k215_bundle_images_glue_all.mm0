import "k215_bundle_images_glue.mm0";
import "k215_bundle_images_tmpl_wp.mm0";
import "k215_bundle_images_tmpl_wa.mm0";
import "k215_bundle_images_tmpl_wb.mm0";
import "k215_bundle_images_tmpl_wk.mm0";
import "k215_bundle_images_tmpl_dp.mm0";
import "k215_bundle_images_tmpl_da.mm0";
import "k215_bundle_images_tmpl_dk.mm0";

theorem k215Glue_X (a b k q: nat):
  $ sfTheoryProvable zfrAxioms (k215GX (k215GPhi a b q) (k215GS a b k @ b) (k215GS a b k @ 0)) $;

-- The glue: ZFC proves (bound principle for the normalised matrix) -> (decoded core).
theorem k215Glue (a b k q: nat) (hka: $ k != a $) (hkb: $ k != b $) (hqk: $ q <= k $):
  $ zfcProvable (sfImp (k215BoundF (k215GPhi a b q)) (k215DecBundleGz a b k 0 (rawDecode q))) $;
