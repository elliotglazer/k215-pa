import "omega_schema_closure.mm0";

def quotientCoreSchemas: wff = $ omegaSeparationImages /\ omegaReplacementImages $;

theorem quotientCoreFixed_image (z: nat): $ quotientCoreSchemas -> zfcCoreFixed z -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 z) $;

theorem quotientCoreSep_image {phi n: nat} (z: nat): $ quotientCoreSchemas -> zfcClosedSeparation z -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 z) $;

theorem quotientCoreRep_image {phi n: nat} (z: nat): $ quotientCoreSchemas -> zfcClosedReplacement z -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 z) $;

theorem quotientCoreAxiom_image (z: nat): $ quotientCoreSchemas -> z e. zfcCoreAxioms -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 z) $;

theorem quotientCore_images: $ quotientCoreSchemas -> k218SQ_sqTheoryImages zfcCoreAxioms $;

theorem quotientCore_refutation: $ quotientCoreSchemas -> sfTheoryProvable zfcCoreAxioms sfBot -> k218QProvable kF $;

theorem quotientCore_inconsistency: $ quotientCoreSchemas -> sfTheoryProvable zfcCoreAxioms sfBot -> k218Inconsistent $;
