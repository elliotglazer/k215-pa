import "k218q_quotient_mixed_rebase.mm1";

theorem qrepMemberQuote (t k x y: nat):
 $ sqQuote (sqEnvCons x (sqEnvCons y sqZeroEnvironment)) t k 0 (sfMem 0 1) = sqMember t x y k $ =
'(eqtr sqQuote_sfMem (sqMembereq eqid (eqtr sfNamedIndex_zero sqEnvCons_zero) (eqtr sfNamedIndex_zero (eqtr sqEnvCons_suc sqEnvCons_zero)) add02));

theorem qrepMemberBound:
 $ sfBound 2 (sfMem 0 1) $ =
'(mpbir sfBound_sfMem (ian (lttr lt01S ltsucid) ltsucid));

pub theorem sfK0QRep_member_rebase (G: wff) (t k l x y: nat) (hk: $ G -> 0 < k $) (hl: $ G -> 0 < l $) (htk: $ G -> t < k $) (htl: $ G -> t < l $) (hxk: $ G -> x < k $) (hxl: $ G -> x < l $) (hyk: $ G -> y < k $) (hyl: $ G -> y < l $):
 $ G -> k218IEquivalent (sqMember t x y k) (sqMember t x y l) $ =
'(mpbid (k218IEquivalenteqd (a1i qrepMemberQuote) (a1i qrepMemberQuote)) (k218QM_quote_rebase (a1i qrepMemberBound) hk hl htk htl (k218QM_below_two hxk hyk) (k218QM_below_two hxl hyl)));
