import "k218q_kp0_source.mm0";
import "k218q_named_eigen.mm0";
import "k218_source_core_bounds.mm0";

theorem k218QSourceSeededCore_at {i j: nat} (E: set) (n B k f: nat)
 (hB: $ 3 < B $) (he1: $ sqEnvAvoid E n 1 $) (he3: $ sqEnvAvoid E n 3 $)
 (he: $ A. j (j < n -> E @ j < B) $) (hk: $ B <= k $)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218QProvable (sfNamedTemplate E k 0 (sfK218SeededCore f)) $;

theorem k218QSourceKp0_at {i j: nat} (E: set) (n B k f: nat)
 (hB: $ 3 < B $) (he1: $ sqEnvAvoid E n 1 $) (he3: $ sqEnvAvoid E n 3 $)
 (he: $ A. j (j < n -> E @ j < B) $) (hk: $ B <= k $)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218QProvable (sfNamedTemplate E k 0 (sfK218Kp0 f)) $;
