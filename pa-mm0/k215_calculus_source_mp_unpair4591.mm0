import "k215_calculus_source_mp_loops.mm0";
import "k215_literal_runtime_reach.mm0";
import "k215_calculus_source_pairing.mm0";
import "k215_calculus_source_mp_lookups.mm0";

def k215UnpairAt4591State (pc a b n c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) a b n) $;

theorem k215UnpairAt4591Advance (a b n c: nat): $ k215PReach (k215UnpairAt4591State k215PNum4591 a b (suc n) c) (k215UnpairAt4591State k215PNum4591 (fst (suc (a, b))) (snd (suc (a, b))) n c) $;

def k215UnpairAt4591Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt4591State k215PNum4591 a b n c) (k215UnpairAt4591State k215PNum4599 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;

def k215UnpairAt4591Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt4591Run n a b c $;

theorem k215UnpairMacro4591 (n a b c: nat): $ k215PReach (k215UnpairAt4591State k215PNum4591 a b n c) (k215UnpairAt4591State k215PNum4599 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;

theorem k215UnpairMacro4591_clean (n c: nat): $ k215PReach (k215UnpairAt4591State k215PNum4591 0 0 n c) (k215UnpairAt4591State k215PNum4599 (fst n) (snd n) 0 c) $;
