@_ abstract def k215UnpairAt966Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt966State k215PNum966 a b n c) (k215UnpairAt966State k215PNum974 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
