theorem k215UnpairAt966AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt966State k215PNum966 0 b (suc n) c) (k215UnpairAt966State k215PNum966 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
