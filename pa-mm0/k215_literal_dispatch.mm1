import "k215_literal_registers.mm1";

do (apply (register-eqd 'k215TmPush) '(k215TmPusheqd));
do (apply (register-eqd 'k215TmRepeat) '(k215TmRepeateqd));
do (apply (register-eqd 'k215TmFile) '(k215TmFileeqd));
do (apply (register-eqd 'k215TMState) '(k215TMStateeqd));

@_ abstract def k215TmPathTapeStep (.z: nat): set = $ \ z, k215TmPush (fst z) (pi22 z) $;
@_ abstract def k215TmPathTape (p r: nat): nat = $ lrec r k215TmPathTapeStep p $;
theorem k215TmPathTapeStep_apply (b p r: nat):
 $ k215TmPathTapeStep @ (b, p, r) = k215TmPush b r $ =
 (named '(!! applame j @ k215TmPusheqd
   (syl6eq fstpr @ fsteqd id) (syl6eq pi22pr @ pi22eqd id)));
pub theorem k215TmPathTape_nil (r: nat): $ k215TmPathTape 0 r = r $ = 'lrec0;
pub theorem k215TmPathTape_cons (b p r: nat):
 $ k215TmPathTape (b : p) r = k215TmPush b (k215TmPathTape p r) $ =
 '(eqtr lrecS k215TmPathTapeStep_apply);
pub theorem k215TmPathTape_append (p q r: nat):
 $ k215TmPathTape (p ++ q) r = k215TmPathTape p (k215TmPathTape q r) $ =
 (named @ induct '(listind) 'p
  '(eqtr (k215TmPathTapeeq1 append0) (eqcom k215TmPathTape_nil))
  '(eqtrd (a1i (k215TmPathTapeeq1 appendS))
    (eqtrd (a1i k215TmPathTape_cons)
      (eqtrd (k215TmPusheq2d id) (a1i (eqcom k215TmPathTape_cons))))));
pub theorem k215TmPathTape_repeat (b n r: nat):
 $ k215TmPathTape (repeat b n) r = k215TmRepeat b n r $ =
 (named @ induct '(ind) 'n
  '(eqtr (k215TmPathTapeeq1 repeat0) (eqtr k215TmPathTape_nil (eqcom k215TmRepeat_zero)))
  '(eqtrd (a1i (k215TmPathTapeeq1 repeatS))
    (eqtrd (a1i k215TmPathTape_cons)
      (eqtrd (k215TmPusheq2d id) (a1i (eqcom k215TmRepeat_succ))))));
pub theorem k215TmRepeat_add (b m n r: nat):
 $ k215TmRepeat b (m + n) r = k215TmRepeat b m (k215TmRepeat b n r) $ =
 (named @ induct '(ind) 'm
  '(eqtr (k215TmRepeateq2 add01) (eqcom k215TmRepeat_zero))
  '(eqtrd (a1i (k215TmRepeateq2 addS1))
    (eqtrd (a1i k215TmRepeat_succ)
      (eqtrd (k215TmPusheq2d id) (a1i (eqcom k215TmRepeat_succ))))));

@_ def k215TmDispatchState (path gap file: nat): nat =
 $ k215TMState k215Num83 1 (k215TmPathTape path (k215TmRepeat 0 gap (k215TmPush 1 (k215TmFile file 0)))) $;
pub theorem k215TmDispatchState_Q (path gap file: nat):
 $ k215TMQ (k215TmDispatchState path gap file) = k215Num83 $ = 'k215TMState_Q;
pub theorem k215TmDispatchState_L (path gap file: nat):
 $ k215TML (k215TmDispatchState path gap file) = 1 $ = 'k215TMState_L;
pub theorem k215TmDispatchState_R (path gap file: nat):
 $ k215TMR (k215TmDispatchState path gap file) = k215TmPathTape path (k215TmRepeat 0 gap (k215TmPush 1 (k215TmFile file 0))) $ = 'k215TMState_R;
pub theorem k215TmDispatchState_zeroPadding (path m n file: nat):
 $ k215TmDispatchState (path ++ repeat 0 m) n file = k215TmDispatchState path (m + n) file $ =
 '(k215TMStateeq3 (eqtr k215TmPathTape_append (k215TmPathTapeeq2 (eqtr k215TmPathTape_repeat (eqcom k215TmRepeat_add)))));
