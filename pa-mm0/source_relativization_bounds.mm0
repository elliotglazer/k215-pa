import "source_relativization.mm0";
import "source_renaming_laws.mm0";
import "source_syntax_laws.mm0";

-- A unary domain has no parameters beyond its single displayed variable.
theorem sfRelativize_bound (d n c: nat):
  $ sfBound 1 d -> sfBound n c -> sfBound n (sfRelativize d c) $;
theorem sfRelativize_closed (d c: nat):
  $ sfBound 1 d -> sfBound 0 c -> sfBound 0 (sfRelativize d c) $;
