import "source_k0_qsep_singleton_transport.mm0";

import "source_k0_qsep_empty.mm0";

theorem sfK0QSepSelected_not_root (b t r p x y K: nat) (hb: $ b < K $) (ht: $ t < K $) (hr: $ r < K $) (hp: $ p < K $) (hx: $ x < K $) (hy0: $ y != 0 $) (hty: $ t != y $) (hyx: $ y != x $):
 $ k218QProvable (kImp (kMem b r) (kImp (kMem t r) (kImp (kImp (kEq b t) kF) (kImp (kImp (kImp (kMem x p) (kImp (kAll K (kImp (kMem K p) (kEq K x))) kF)) kF) (kImp (kEq p r) kF))))) $;

theorem sfK0QSepSelected_not_marker (b t r p x y K: nat) (hb: $ b < K $) (ht: $ t < K $) (hr: $ r < K $) (hp: $ p < K $) (hx: $ x < K $) (hy0: $ y != 0 $) (hty: $ t != y $) (hyx: $ y != x $):
 $ k218QProvable (kImp (kAll y (kImp (kMem y t) kF)) (kImp (kImp (kImp (kMem x p) (kImp (kAll K (kImp (kMem K p) (kEq K x))) kF)) kF) (kImp (kEq p t) kF))) $;

theorem sfK0QSepSeed_not_marker (b t r p x y K: nat) (hb: $ b < K $) (ht: $ t < K $) (hr: $ r < K $) (hp: $ p < K $) (hx: $ x < K $) (hy0: $ y != 0 $) (hty: $ t != y $) (hyx: $ y != x $):
 $ k218QProvable (kImp (kAll y (kImp (kMem y t) kF)) (kImp (kMem t r) (kImp (kEq r t) kF))) $;

theorem sfK0QSepSeed_not_marker_reverse (b t r p x y K: nat) (hb: $ b < K $) (ht: $ t < K $) (hr: $ r < K $) (hp: $ p < K $) (hx: $ x < K $) (hy0: $ y != 0 $) (hty: $ t != y $) (hyx: $ y != x $):
 $ k218QProvable (kImp (kImp (kEq r t) kF) (kImp (kEq t r) kF)) $;
