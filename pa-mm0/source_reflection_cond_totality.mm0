import "source_reflection_cond_kernel.mm0";

def sfReflectionCondProducers(level P:nat):wff = $ sfTheoryProvable zfrAxioms (sfReflectionCondLevelExists level) /\ (sfTheoryProvable zfrAxioms (sfReflectionCondLevelUnique level) /\ sfTheoryProvable zfrAxioms (sfReflectionCondPiecesBound level P)) $;

theorem sfReflectionCondExistence_from_producers(level P:nat): $ (sfReflectionCondGuard level P /\ sfReflectionCondProducers level P) -> sfTheoryProvable zfrAxioms (sfReflectionLeastExistence (sfReflectionCondCandidate level P)) $;

theorem sfReflectionCondGTot_from_producers(level P:nat): $ (sfReflectionCondGuard level P /\ sfReflectionCondProducers level P) -> sfTheoryProvable zfrAxioms (sfReflectionLeastGTot (sfReflectionCondCandidate level P)) $;

theorem sfReflectionCondGFun_from_guard(level P:nat): $ sfReflectionCondGuard level P -> sfTheoryProvable zfrAxioms (sfReflectionLeastGFun (sfReflectionCondCandidate level P)) $;
