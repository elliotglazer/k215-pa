theorem k215UnpairAt4453Reach9S (a b n c: nat): $ k215PReach (k215UnpairAt4453State k215PNum4453 a b (suc n) c) (k215UnpairAt4453State k215PNum4454 a b n c) $ = '(k215PReach_step k215UnpairAt4453Step9S);

theorem k215UnpairAt4453Step10 (a b n c: nat): $ k215PStep (k215UnpairAt4453State k215PNum4454 a b n c) = (k215UnpairAt4453State k215PNum4455 a (suc b) n c) $ = '(eqtr (k215PAtCI k215PLookupUnpair4453_4454) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215UnpairAt4453Reach10 (a b n c: nat): $ k215PReach (k215UnpairAt4453State k215PNum4454 a b n c) (k215UnpairAt4453State k215PNum4455 a (suc b) n c) $ = '(k215PReach_step k215UnpairAt4453Step10);

theorem k215UnpairAt4453Step11Z (b n c: nat): $ k215PStep (k215UnpairAt4453State k215PNum4455 0 b n c) = (k215UnpairAt4453State k215PNum4457 0 b n c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair4453_4455) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt4453Reach11Z (b n c: nat): $ k215PReach (k215UnpairAt4453State k215PNum4455 0 b n c) (k215UnpairAt4453State k215PNum4457 0 b n c) $ = '(k215PReach_step k215UnpairAt4453Step11Z);

theorem k215UnpairAt4453Step11S (a b n c: nat): $ k215PStep (k215UnpairAt4453State k215PNum4455 (suc a) b n c) = (k215UnpairAt4453State k215PNum4456 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair4453_4455) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215UnpairAt4453Reach11S (a b n c: nat): $ k215PReach (k215UnpairAt4453State k215PNum4455 (suc a) b n c) (k215UnpairAt4453State k215PNum4456 a b n c) $ = '(k215PReach_step k215UnpairAt4453Step11S);

theorem k215UnpairAt4453Step12 (a b n c: nat): $ k215PStep (k215UnpairAt4453State k215PNum4456 a b n c) = (k215UnpairAt4453State k215PNum4460 a b n c) $ = '(k215PAtCB k215PLookupUnpair4453_4456);

theorem k215UnpairAt4453Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt4453State k215PNum4456 a b n c) (k215UnpairAt4453State k215PNum4460 a b n c) $ = '(k215PReach_step k215UnpairAt4453Step12);

theorem k215UnpairAt4453Step16 (a b n c: nat): $ k215PStep (k215UnpairAt4453State k215PNum4460 a b n c) = (k215UnpairAt4453State k215PNum4453 a b n c) $ = '(k215PAtCC k215PLookupUnpair4453_4460);

theorem k215UnpairAt4453Reach16 (a b n c: nat): $ k215PReach (k215UnpairAt4453State k215PNum4460 a b n c) (k215UnpairAt4453State k215PNum4453 a b n c) $ = '(k215PReach_step k215UnpairAt4453Step16);

theorem k215UnpairAt4453CycleZero (b n c: nat): $ k215PReach (k215UnpairAt4453State k215PNum4453 0 b (suc n) c) (k215UnpairAt4453State k215PNum4453 (suc b) 0 n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt4453Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt4453Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt4453Reach11Z) (ax_mp (ax_mp k215PReach_trans k215UnpairAt4453ReachTransfer) k215UnpairAt4453Reach16))));
theorem k215UnpairAt4453CycleSucc (a b n c: nat): $ k215PReach (k215UnpairAt4453State k215PNum4453 (suc a) b (suc n) c) (k215UnpairAt4453State k215PNum4453 a (suc b) n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt4453Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt4453Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt4453Reach11S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt4453Reach12) k215UnpairAt4453Reach16))));


theorem k215UnpairAt4453AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt4453State k215PNum4453 0 b (suc n) c) (k215UnpairAt4453State k215PNum4453 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt4453Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215PairDiagonal_rotate)) (eqtr (eqcom sndpr) (sndeq k215PairDiagonal_rotate)) eqid eqid)) k215UnpairAt4453CycleZero);

theorem k215UnpairAt4453AdvanceSucc (a b n c: nat): $ k215PReach (k215UnpairAt4453State k215PNum4453 (suc a) b (suc n) c) (k215UnpairAt4453State k215PNum4453 (fst (suc ((suc a), b))) (snd (suc ((suc a), b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt4453Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215Pair_next)) (eqtr (eqcom sndpr) (sndeq k215Pair_next)) eqid eqid)) k215UnpairAt4453CycleSucc);

pub theorem k215UnpairAt4453Advance (a b n c: nat): $ k215PReach (k215UnpairAt4453State k215PNum4453 a b (suc n) c) (k215UnpairAt4453State k215PNum4453 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
 (named @ induct '(ind) 'a 'k215UnpairAt4453AdvanceZero '(a1i k215UnpairAt4453AdvanceSucc));
@_ abstract def k215UnpairAt4453Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt4453State k215PNum4453 a b n c) (k215UnpairAt4453State k215PNum4461 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
theorem k215UnpairAt4453RunZero (a b c: nat): $ k215UnpairAt4453Run 0 a b c $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt4453Stateeq eqid
     (eqcom (eqtr (fsteq add0) fstpr))
     (eqcom (eqtr (sndeq add0) sndpr)) eqid eqid)) k215UnpairAt4453Reach9Z);
@_ abstract def k215UnpairAt4453Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt4453Run n a b c $;
theorem k215UnpairAt4453Claim_at (n a b c: nat): $ k215UnpairAt4453Claim n c -> k215UnpairAt4453Run n a b c $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215UnpairAt4453CodeStep (a b n: nat): $ (fst (suc (a, b)), snd (suc (a, b))) + n = (a, b) + suc n $ =
 '(eqtr (addeq1 fstsnd) addSass);
theorem k215UnpairAt4453RunInductive (n a b c: nat): $ k215UnpairAt4453Claim n c -> k215UnpairAt4453Run (suc n) a b c $ =
 '(syl (ax_mp k215PReach_trans k215UnpairAt4453Advance)
   (mpbid (a1i (k215PReacheq2 (k215UnpairAt4453Stateeq eqid
     (fsteq k215UnpairAt4453CodeStep) (sndeq k215UnpairAt4453CodeStep) eqid eqid))) k215UnpairAt4453Claim_at));
theorem k215UnpairAt4453Claim_all (n c: nat): $ k215UnpairAt4453Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt4453RunZero)) '(iald @ iald k215UnpairAt4453RunInductive));
pub theorem k215UnpairMacro4453 (n a b c: nat): $ k215PReach (k215UnpairAt4453State k215PNum4453 a b n c) (k215UnpairAt4453State k215PNum4461 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
 '(ax_mp k215UnpairAt4453Claim_at k215UnpairAt4453Claim_all);
pub theorem k215UnpairMacro4453_clean (n c: nat): $ k215PReach (k215UnpairAt4453State k215PNum4453 0 0 n c) (k215UnpairAt4453State k215PNum4461 (fst n) (snd n) 0 c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt4453Stateeq eqid
   (fsteq (eqtr (addeq1 pr0) add01))
   (sndeq (eqtr (addeq1 pr0) add01)) eqid eqid)) k215UnpairMacro4453);


