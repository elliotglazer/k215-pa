@_ def k215UnpairAt4453State (pc a b n c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) n (k215PR3 c) (k215PR4 c) (k215PR5 c) a b (k215PR8 c)) $;

do (apply (register-eqd 'k215UnpairAt4453State) '(k215UnpairAt4453Stateeqd));

theorem k215UnpairAt4453Transfer (b n c: nat): $ k215PIter (3 * b + 1) (k215UnpairAt4453State k215PNum4457 0 b n c) = (k215UnpairAt4453State k215PNum4460 b 0 n c) $ =
 '(eqtr k215Loop4457Vector (k215PStateeq2 (k215PVectoreq7 add0)));
theorem k215UnpairAt4453ReachTransfer (b n c: nat): $ k215PReach (k215UnpairAt4453State k215PNum4457 0 b n c) (k215UnpairAt4453State k215PNum4460 b 0 n c) $ =
 '(k215PReach_intro k215UnpairAt4453Transfer);


theorem k215UnpairAt4453Step9Z (a b c: nat): $ k215PStep (k215UnpairAt4453State k215PNum4453 a b 0 c) = (k215UnpairAt4453State k215PNum4461 a b 0 c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair4453_4453) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifpos eqid));

