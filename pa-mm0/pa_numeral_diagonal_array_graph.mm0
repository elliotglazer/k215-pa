import "pa_numeral_formula_array.mm0";

import "pa_numeral_diagonal_graph.mm0";

def paNumeralDiagonalArrayMatrix (c t z nm nv wm wv fm fv k: nat): wff = $ paNumeralFormulaArrayMatrix 0 c c t z nm nv wm wv fm fv k $;

def paNumeralDiagonalArrayGraph (c t: nat): wff = $ paNumeralFormulaArrayGraph 0 c c t $;

theorem paNumeralDiagonalArrayGraph_correct (c t m: nat): $ paFormulaBound m c -> (paNumeralDiagonalArrayGraph c t <-> t = paNumeralDiagonal c) $;

theorem paNumeralDiagonalArrayGraph_original (c t m: nat): $ paFormulaBound m c -> (paNumeralDiagonalArrayGraph c t <-> paNumeralDiagonalGraph c t) $;

theorem paNumeralDiagonalArrayGraph_total (c: nat): $ paNumeralDiagonalArrayGraph c (paNumeralDiagonal c) $;

theorem paNumeralDiagonalArrayGraph_closed (c t: nat): $ paFormulaBound 1 c -> paNumeralDiagonalArrayGraph c t -> paFormulaBound 0 t $;
