import "k218q_quotient_mixed_logic.mm0";

theorem k218QM_below_zero (E: set) (k: nat): $ sqEnvBelow E 0 k $;

theorem k218QM_below_one (G: wff) (E: set) (k x: nat) (hx: $ G -> x < k $): $ G -> sqEnvBelow (sqEnvCons x E) 1 k $;

theorem k218QM_below_two (G: wff) (E: set) (k x y: nat) (hx: $ G -> x < k $) (hy: $ G -> y < k $): $ G -> sqEnvBelow (sqEnvCons x (sqEnvCons y E)) 2 k $;

theorem k218QM_quote_rebase (G: wff) (E: set) (n t k l c: nat) (hb: $ G -> sfBound n c $) (hk: $ G -> 0 < k $) (hl: $ G -> 0 < l $) (htk: $ G -> t < k $) (htl: $ G -> t < l $) (hek: $ G -> sqEnvBelow E n k $) (hel: $ G -> sqEnvBelow E n l $): $ G -> k218IEquivalent (sqQuote E t k 0 c) (sqQuote E t l 0 c) $;

theorem k218QM_equal_quote (t k x y: nat): $ sqQuote (sqEnvCons x (sqEnvCons y sqZeroEnvironment)) t k 0 (sfEq 0 1) = sqEqual t x y k $;

theorem k218QM_equal_rebase (G: wff) (t k l x y: nat) (hk: $ G -> 0 < k $) (hl: $ G -> 0 < l $) (htk: $ G -> t < k $) (htl: $ G -> t < l $) (hxk: $ G -> x < k $) (hxl: $ G -> x < l $) (hyk: $ G -> y < k $) (hyl: $ G -> y < l $): $ G -> k218IEquivalent (sqEqual t x y k) (sqEqual t x y l) $;

theorem k218QM_empty_named (t k: nat): $ sfNamedTemplate (sqEnvCons t sqZeroEnvironment) k 0 (sfAll (sfImp (sfMem 0 1) sfBot)) = k218QAEmpty t k $;

theorem k218QM_empty_rebase (G: wff) (t k l: nat) (hk: $ G -> 0 < k $) (hl: $ G -> 0 < l $) (htk: $ G -> t < k $) (htl: $ G -> t < l $): $ G -> k218IEquivalent (k218QAEmpty t k) (k218QAEmpty t l) $;

theorem k218QM_mixed_rebase (G: wff) (H t k l x y: nat) (hk: $ G -> 0 < k $) (hl: $ G -> 0 < l $) (htk: $ G -> t < k $) (htl: $ G -> t < l $) (hxk: $ G -> x < k $) (hxl: $ G -> x < l $) (hyk: $ G -> y < k $) (hyl: $ G -> y < l $) (hr: $ G -> k218QMixed H t k x y $): $ G -> k218QMixed H t l x y $;
