import "source_piece_pcf_rep_cover_prefix_r35.mm0";

import "source_piece_pcf_definable_realization.mm0";

theorem sfPieceDefinableCoverRealization_map(T:set)(X A i:nat): $ sfComposeMap (sfPieceEnvironment T X A) (sfPieceRepCoverTail 2) @ i = T @ i $;

theorem sfPieceDefinableCoverRealization_matrix(T:set)(n X A:nat): $ sfRename (sfPieceEnvironment T X A) 0 (sfPieceRepCoverMatrix n) = sfPieceRepCoverPoint T n X $;

theorem sfPieceDefinableCoverRealization_point(T:set)(G n X A:nat)(hc:$ nsLocal G (sfPieceRepEnvironmentCoverAt A X n) $)(hm:$ sfReflectionDnMembers T G A n $): $ nsLocal G (sfPieceRepCoverPoint T n X) $;

theorem sfPieceDefinableCoverRealization_member(T:set)(G n X A e:nat)(hc:$ nsLocal G (sfPieceRepEnvironmentCoverAt A X n) $)(hm:$ sfReflectionDnMembers T G A n $)(he:$ nsLocal G (sfPieceEnv T n e) $): $ nsLocal G (sfMem e X) $;
