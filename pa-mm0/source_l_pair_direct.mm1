import "source_l_pair_direct_replay.mm1";

@_ def sfLDefPair: nat = $ slPDFormula $;
pub theorem sfLDefPair_context: $ slPDContext = sfLBackground $ = 'eqid;
pub theorem sfLDefPair_local: $ nsLocal sfLBackground sfLDefPair $ = '(mpbi (nsLocal_context_eq sfLDefPair_context) slPDCertificate);
pub theorem sfLDefPair_zfr: $ sfTheoryProvable zfrAxioms sfLDefPair $ = '(ax_mp (sfTheory_local sfLBackground_zfr) sfLDefPair_local);
