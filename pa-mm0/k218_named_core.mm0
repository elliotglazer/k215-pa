import "k218_role_env.mm0";

def k218NamedEmittedClosure (E: set) (k a c phi: nat): nat =
 $ (kAll k (kImp (kMem k c) (kExists (suc k) (kAnd (sfNamedTemplate (sqEnvCons k (sqEnvCons (suc k) E)) (suc (suc k)) 0 phi) (kAll (suc (suc k)) (kImp (kAll (suc (suc (suc k))) (kImp (kMem (suc (suc (suc k))) (suc (suc k))) (kMem (suc (suc (suc k))) k))) (kAll (suc (suc (suc k))) (kImp (sfNamedTemplate (sqEnvCons (suc (suc (suc k))) (sqEnvCons (suc (suc k)) E)) (suc (suc (suc (suc k)))) 0 phi) (kExists (suc (suc (suc (suc k)))) (kAnd (sfNamedTemplate (sqEnvCons (suc (suc (suc (suc k)))) (sqEnvCons (suc (suc k)) E)) (suc (suc (suc (suc (suc k))))) 0 phi) (kMem (suc (suc (suc (suc k)))) c))))))))))) $;

theorem k218NamedEmittedClosure_source (E: set) (k a c phi: nat)
 (hf: $ sfWf phi $):
 $ sfNamedTemplate (sqEnvCons c (sqEnvCons a E)) k 0 (sfK218EmittedClosure phi) =
   k218NamedEmittedClosure E k a c phi $;

def k218NamedSeededCore (E: set) (k phi: nat): nat =
 $ (kAll k (kExists (suc k) (kAnd (kImp (kExists (suc (suc k)) (sfNamedTemplate (sqEnvCons (suc (suc k)) (sqEnvCons k E)) (suc (suc (suc k))) 0 phi)) (kExists (suc (suc k)) (kAnd (kMem (suc (suc k)) (suc k)) (sfNamedTemplate (sqEnvCons (suc (suc k)) (sqEnvCons k E)) (suc (suc (suc k))) 0 phi)))) (kAll (suc (suc k)) (kImp (kMem (suc (suc k)) (suc k)) (kExists (suc (suc (suc k))) (kAnd (sfNamedTemplate (sqEnvCons (suc (suc k)) (sqEnvCons (suc (suc (suc k))) E)) (suc (suc (suc (suc k)))) 0 phi) (kAll (suc (suc (suc (suc k)))) (kImp (kAll (suc (suc (suc (suc (suc k))))) (kImp (kMem (suc (suc (suc (suc (suc k))))) (suc (suc (suc (suc k))))) (kMem (suc (suc (suc (suc (suc k))))) (suc (suc k))))) (kAll (suc (suc (suc (suc (suc k))))) (kImp (sfNamedTemplate (sqEnvCons (suc (suc (suc (suc (suc k))))) (sqEnvCons (suc (suc (suc (suc k)))) E)) (suc (suc (suc (suc (suc (suc k)))))) 0 phi) (kExists (suc (suc (suc (suc (suc (suc k)))))) (kAnd (sfNamedTemplate (sqEnvCons (suc (suc (suc (suc (suc (suc k)))))) (sqEnvCons (suc (suc (suc (suc k)))) E)) (suc (suc (suc (suc (suc (suc (suc k))))))) 0 phi) (kMem (suc (suc (suc (suc (suc (suc k)))))) (suc k))))))))))))))) $;

theorem k218NamedSeededCore_source (E: set) (k phi: nat)
 (hf: $ sfWf phi $):
 $ sfNamedTemplate E k 0 (sfK218SeededCore phi) =
   k218NamedSeededCore E k phi $;

def k218NamedKp0 (E: set) (k phi: nat): nat =
 $ (kAll k (kExists (suc k) (kAnd (kAll (suc (suc k)) (kImp (kDisj (kEq (suc (suc k)) k) (kExists (suc (suc (suc k))) (kAnd (kMem (suc (suc (suc k))) (suc k)) (kAll (suc (suc (suc (suc k)))) (kImp (kMem (suc (suc (suc (suc k)))) (suc (suc k))) (kMem (suc (suc (suc (suc k)))) (suc (suc (suc k))))))))) (kImp (kExists (suc (suc (suc k))) (sfNamedTemplate (sqEnvCons (suc (suc (suc k))) (sqEnvCons (suc (suc k)) E)) (suc (suc (suc (suc k)))) 0 phi)) (kExists (suc (suc (suc k))) (kAnd (kMem (suc (suc (suc k))) (suc k)) (sfNamedTemplate (sqEnvCons (suc (suc (suc k))) (sqEnvCons (suc (suc k)) E)) (suc (suc (suc (suc k)))) 0 phi)))))) (kAll (suc (suc k)) (kImp (kMem (suc (suc k)) (suc k)) (kExists (suc (suc (suc k))) (sfNamedTemplate (sqEnvCons (suc (suc k)) (sqEnvCons (suc (suc (suc k))) E)) (suc (suc (suc (suc k)))) 0 phi))))))) $;

theorem k218NamedKp0_source (E: set) (k phi: nat)
 (hf: $ sfWf phi $):
 $ sfNamedTemplate E k 0 (sfK218Kp0 phi) =
   k218NamedKp0 E k phi $;
