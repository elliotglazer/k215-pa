import "source_l_separation_image_seed_logic.mm0";
import "source_domain_discharge.mm0";

def sfLSeparationSeedPoint(O R i:nat):nat = $ sfAnd O (sfAnd (sfMem i 0) R) $;
def sfLSeparationSeedWitness(O R:nat):nat = $ sfEx (sfLSeparationSeedPoint O R 1) $;

theorem slSeedPoint_wf(O R i:nat)(ho:$ sfWf O $)(hr:$ sfWf R $): $ sfWf (sfLSeparationSeedPoint O R i) $;
theorem slSeedPoint_shift_one(O R:nat)(ho:$ sfBound 1 O $)(hr:$ sfBound 1 R $): $ sfShift 1 (sfLSeparationSeedPoint O R 1) = sfLSeparationSeedPoint O R 2 $;
theorem slSeedPoint_shift_two(O R:nat)(ho:$ sfBound 1 O $)(hr:$ sfBound 1 R $): $ sfShift 1 (sfLSeparationSeedPoint O R 2) = sfLSeparationSeedPoint O R 3 $;
theorem slSeedPoint_subst_three(O R:nat)(ho:$ sfBound 1 O $)(hr:$ sfBound 1 R $): $ sfSubst 0 0 (sfLSeparationSeedPoint O R 3) = sfLSeparationSeedPoint O R 2 $;
theorem sfLSeparationSeedWitness_shift_two(O R:nat)(ho:$ sfBound 1 O $)(hr:$ sfBound 1 R $): $ sfShift 0 (sfShift 0 (sfLSeparationSeedWitness O R)) = sfEx (sfLSeparationSeedPoint O R 3) $;
theorem sfLSeparationSeedWitness_intro(G O R:nat)(ho:$ sfBound 1 O $)(hr:$ sfBound 1 R $)(hO:$ nsLocal G O $)(hm:$ nsLocal G (sfMem 2 0) $)(hR:$ nsLocal G R $): $ nsLocal G (sfShift 0 (sfShift 0 (sfLSeparationSeedWitness O R))) $;
