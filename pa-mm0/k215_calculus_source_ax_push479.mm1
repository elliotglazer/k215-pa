import "k215_calculus_source_ax_pair485.mm1";
import "k215_calculus_source_ax_stack_loops.mm1";

theorem k215PairVectorInAt479 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt485State k215PNum485 a6 a1 a7 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum485 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215PairVectorOutAt479 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt485State k215PNum495 0 0 (a7 + (a6, a1)) (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum495 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

pub theorem k215PairMacro46_vectorAt479 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat):
 $ k215PReach (k215PState k215PNum485 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215PNum495 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ =
 '(mpbi (k215PReacheq k215PairVectorInAt479 k215PairVectorOutAt479) k215PairMacro485);

theorem k215PushAStage0At479 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum479 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum482 (k215PVector u 0 w c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop479Vector (k215PStateeq2 (k215PVectoreq7 add0))));

theorem k215PushAStage1At479 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum482 (k215PVector u 0 w c a b t 0 v)) (k215PState k215PNum485 (k215PVector u w 0 c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop482Vector (k215PStateeq2 (k215PVectoreq2 add0))));

theorem k215PushAStage2At479 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum485 (k215PVector u w 0 c a b t 0 v)) (k215PState k215PNum495 (k215PVector u 0 0 c a b 0 (t, w) v)) $ = '(mpbi (k215PReacheq2 (k215PStateeq2 (k215PVectoreq8 add01))) k215PairMacro46_vectorAt479);

theorem k215PushAStage3At479 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum495 (k215PVector u 0 0 c a b 0 (t, w) v)) (k215PState k215PNum498 (k215PVector u 0 (t, w) c a b 0 0 v)) $ = '(k215PReach_intro (eqtr k215Loop495Vector (k215PStateeq2 (k215PVectoreq3 add0))));

theorem k215PushAStage4At479 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum498 (k215PVector u 0 (t, w) c a b 0 0 v)) (k215PState k215PNum502 (k215PVector u c (t, w) 0 a b c 0 v)) $ = '(k215PReach_intro (eqtr k215Loop498Vector (k215PStateeq2 (k215PVectoreq eqid add0 eqid eqid eqid eqid add0 eqid eqid))));

theorem k215PushAStage5At479 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum502 (k215PVector u c (t, w) 0 a b c 0 v)) (k215PState k215PNum505 (k215PVector u c (t, w) c a b 0 0 v)) $ = '(k215PReach_intro (eqtr k215Loop502Vector (k215PStateeq2 (k215PVectoreq4 add0))));

pub theorem k215PushParam479 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum479 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum505 (k215PVector u c (t, w) c a b 0 0 v)) $ = '(ax_mp (ax_mp k215PReach_trans k215PushAStage0At479) (ax_mp (ax_mp k215PReach_trans k215PushAStage1At479) (ax_mp (ax_mp k215PReach_trans k215PushAStage2At479) (ax_mp (ax_mp k215PReach_trans k215PushAStage3At479) (ax_mp (ax_mp k215PReach_trans k215PushAStage4At479) k215PushAStage5At479)))));

