import "source_l_clstage_atom_case.mm0";
import "source_l_clstage_definability.mm0";

-- Lane L02: the core Definability Lemma and the DefPower literal with rep_ex discharged.
theorem sfLCoreDefinabilityLaw_zfr(m psi:nat)(hb:$ sfBound (suc m) psi $):
 $ sfTheoryProvable zfrAxioms (sfLCoreDefinabilityLaw m psi) $;

theorem sfLDefPowerLiteral_zfr: $ sfTheoryProvable zfrAxioms sfLDefPowerLiteral $;
