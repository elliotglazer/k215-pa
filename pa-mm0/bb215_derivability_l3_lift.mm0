import "bb215_derivability_l3_order.mm0";
import "source_renaming_laws.mm0";
import "pa_source_interpretation_term_rename_algebra.mm0";

-- L05, layer L3a (lanes/L05.md): lifting s <= t, exchange of antecedents, existential introduction
-- in implication form, and s <= t -> s <= S t (existential elimination with witness S z).
-- Generated by build_bb215_derivability_l2_add_basic.py.

-- Lifting s <= t past one more free variable lifts both terms.

theorem bb215L3_lift_le (n s t: nat) (hs: $ paTermBound n s $) (ht: $ paTermBound n t $):
  $ paAxiomLift (bb215L3Le s t) = bb215L3Le (paTermLift 1 s) (paTermLift 1 t) $;

theorem bb215L3_imp_com (n p q r: nat) (hp: $ paFormulaBound n p $) (hq: $ paFormulaBound n q $) (h: $ paProvable n (paFormulaImp p (paFormulaImp q r)) $):
  $ paProvable n (paFormulaImp q (paFormulaImp p r)) $;

theorem bb215L3_ex_intro_imp (n a t: nat) (ha: $ paFormulaBound (suc n) a $) (ht: $ paTermBound n t $):
  $ paProvable n (paFormulaImp (paFormulaSubst 0 t a) (paFormulaEx a)) $;

theorem bb215L3_le_succ (n s t: nat) (hs: $ paTermBound n s $) (ht: $ paTermBound n t $):
  $ paProvable n (paFormulaImp (bb215L3Le s t) (bb215L3Le s (paTermSuccessor t))) $;
