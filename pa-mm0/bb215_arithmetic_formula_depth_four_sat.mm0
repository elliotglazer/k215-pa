import "bb215_arithmetic_formula_depth_three_sat.mm0";

import "pa_source_interpretation_nat_term_assignment.mm0";

def bb215ArithmeticFormulaDepthFourSatBody (E: set) (c h .x: nat): wff = $ ifp (c = 0) (0 != 0) (ifp (sfTag c = 1) (bb215ArithmeticFormulaTermValue E (sfLeft c) = bb215ArithmeticFormulaTermValue E (sfRight c)) (ifp (sfTag c = 3) (sfLeft c e. h /\ sfRight c e. h) (ifp (sfTag c = 4) (sfLeft c e. h \/ sfRight c e. h) (ifp (sfTag c = 5) (sfLeft c e. h -> sfRight c e. h) (ifp (sfTag c = 6 /\ sfRight c = 0) (A. x bb215ArithmeticFormulaDepthThreeSat (paNatTermConsEnvironment E x) (sfLeft c)) (ifp (sfTag c = 7 /\ sfRight c = 0) (E. x bb215ArithmeticFormulaDepthThreeSat (paNatTermConsEnvironment E x) (sfLeft c)) (0 != 0))))))) $;

def bb215ArithmeticFormulaDepthFourSatStep (E: set) (.c .h: nat): set = $ S\ c, {h | bb215ArithmeticFormulaDepthFourSatBody E c h} $;

def bb215ArithmeticFormulaDepthFourSat (E: set) (c: nat): wff = $ srecp (bb215ArithmeticFormulaDepthFourSatStep E) c $;

def bb215ArithmeticFormulaDepthFourSatPrevious (E: set) (c .i: nat): nat = $ sep (upto c) {i | srecp (bb215ArithmeticFormulaDepthFourSatStep E) i} $;

theorem bb215ArithmeticFormulaDepthFourSatStep_value (E: set) (c h: nat): $ (c, h) e. bb215ArithmeticFormulaDepthFourSatStep E <-> bb215ArithmeticFormulaDepthFourSatBody E c h $;

theorem bb215ArithmeticFormulaDepthFourSatPrevious_value (E: set) (c a: nat): $ a e. bb215ArithmeticFormulaDepthFourSatPrevious E c <-> a < c /\ bb215ArithmeticFormulaDepthFourSat E a $;

theorem bb215ArithmeticFormulaDepthFourSat_unfold (E: set) (c: nat): $ bb215ArithmeticFormulaDepthFourSat E c <-> bb215ArithmeticFormulaDepthFourSatBody E c (bb215ArithmeticFormulaDepthFourSatPrevious E c) $;

theorem bb215ArithmeticFormulaDepthFourSat_false (E: set): $ bb215ArithmeticFormulaDepthFourSat E paFormulaFalse <-> 0 != 0 $;

theorem bb215ArithmeticFormulaDepthFourSat_equal (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthFourSat E (paFormulaEqual a b) <-> bb215ArithmeticFormulaTermValue E a = bb215ArithmeticFormulaTermValue E b $;

theorem bb215ArithmeticFormulaDepthFourSat_and (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthFourSat E (paFormulaAnd a b) <-> (bb215ArithmeticFormulaDepthFourSat E a /\ bb215ArithmeticFormulaDepthFourSat E b) $;

theorem bb215ArithmeticFormulaDepthFourSat_or (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthFourSat E (paFormulaOr a b) <-> (bb215ArithmeticFormulaDepthFourSat E a \/ bb215ArithmeticFormulaDepthFourSat E b) $;

theorem bb215ArithmeticFormulaDepthFourSat_imp (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthFourSat E (paFormulaImp a b) <-> (bb215ArithmeticFormulaDepthFourSat E a -> bb215ArithmeticFormulaDepthFourSat E b) $;

theorem bb215ArithmeticFormulaDepthFourSat_all (E: set) (a: nat) {x: nat}: $ bb215ArithmeticFormulaDepthFourSat E (paFormulaAll a) <-> A. x bb215ArithmeticFormulaDepthThreeSat (paNatTermConsEnvironment E x) a $;

theorem bb215ArithmeticFormulaDepthFourSat_ex (E: set) (a: nat) {x: nat}: $ bb215ArithmeticFormulaDepthFourSat E (paFormulaEx a) <-> E. x bb215ArithmeticFormulaDepthThreeSat (paNatTermConsEnvironment E x) a $;
