import "k215_calculus_source_ax_stack_loops.mm1";
import "k215_literal_runtime_reach.mm1";
import "k215_calculus_source_pairing.mm1";
import "k215_calculus_source_ax_stack_lookups.mm1";

@_ def k215PairAt894State (pc a b t c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) b (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) a t (k215PR8 c)) $;

do (apply (register-eqd 'k215PairAt894State) '(k215PairAt894Stateeqd));

theorem k215PairAt894TransferIn (a b t c: nat): $ k215PIter (4 * b + 1) (k215PairAt894State k215PNum894 a b t c) = (k215PairAt894State k215PNum898 (a + b) 0 (t + b) c) $ =
 '(eqtr k215Loop894Vector (k215PStateeq2 (k215PVectoreq eqid eqid eqid eqid eqid eqid addcom addcom eqid)));
theorem k215PairAt894TransferBack (a t c: nat): $ k215PIter (3 * a + 1) (k215PairAt894State k215PNum900 a 0 t c) = (k215PairAt894State k215PNum903 0 a t c) $ =
 '(eqtr k215Loop900Vector (k215PStateeq2 (k215PVectoreq2 add0)));
pub theorem k215PairAt894ReachIn (a b t c: nat): $ k215PReach (k215PairAt894State k215PNum894 a b t c) (k215PairAt894State k215PNum898 (a + b) 0 (t + b) c) $ =
 '(k215PReach_intro k215PairAt894TransferIn);
theorem k215PairAt894ReachBack (a t c: nat): $ k215PReach (k215PairAt894State k215PNum900 a 0 t c) (k215PairAt894State k215PNum903 0 a t c) $ =
 '(k215PReach_intro k215PairAt894TransferBack);


theorem k215PairAt894Step50Z (b t c: nat): $ k215PStep (k215PairAt894State k215PNum898 0 b t c) = (k215PairAt894State k215PNum904 0 b t c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupPair894_898) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215PairAt894Reach50Z (b t c: nat): $ k215PReach (k215PairAt894State k215PNum898 0 b t c) (k215PairAt894State k215PNum904 0 b t c) $ = '(k215PReach_step k215PairAt894Step50Z);

theorem k215PairAt894Step50S (a b t c: nat): $ k215PStep (k215PairAt894State k215PNum898 (suc a) b t c) = (k215PairAt894State k215PNum899 a b t c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupPair894_898) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215PairAt894Reach50S (a b t c: nat): $ k215PReach (k215PairAt894State k215PNum898 (suc a) b t c) (k215PairAt894State k215PNum899 a b t c) $ = '(k215PReach_step k215PairAt894Step50S);

theorem k215PairAt894Step51 (a b t c: nat): $ k215PStep (k215PairAt894State k215PNum899 a b t c) = (k215PairAt894State k215PNum900 a b (suc t) c) $ = '(eqtr (k215PAtCI k215PLookupPair894_899) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215PairAt894Reach51 (a b t c: nat): $ k215PReach (k215PairAt894State k215PNum899 a b t c) (k215PairAt894State k215PNum900 a b (suc t) c) $ = '(k215PReach_step k215PairAt894Step51);

theorem k215PairAt894Step55 (a b t c: nat): $ k215PStep (k215PairAt894State k215PNum903 a b t c) = (k215PairAt894State k215PNum894 a b t c) $ = '(k215PAtCC k215PLookupPair894_903);

theorem k215PairAt894Reach55 (a b t c: nat): $ k215PReach (k215PairAt894State k215PNum903 a b t c) (k215PairAt894State k215PNum894 a b t c) $ = '(k215PReach_step k215PairAt894Step55);

theorem k215PairAt894Prefix (k t c: nat): $ k215PReach (k215PairAt894State k215PNum898 (suc k) 0 t c) (k215PairAt894State k215PNum894 0 k (suc t) c) $ = '(ax_mp (ax_mp k215PReach_trans k215PairAt894Reach50S) (ax_mp (ax_mp k215PReach_trans k215PairAt894Reach51) (ax_mp (ax_mp k215PReach_trans k215PairAt894ReachBack) k215PairAt894Reach55)));
theorem k215PairAt894ReachSum (a b t k c: nat): $ a + b = suc k -> k215PReach (k215PairAt894State k215PNum894 a b t c) (k215PairAt894State k215PNum898 (suc k) 0 (t + b) c) $ =
 '(mpbid (k215PReacheq2d (k215PairAt894Stateeq2d id)) (a1i k215PairAt894ReachIn));
pub theorem k215PairAt894Cycle (a b t k c: nat): $ a + b = suc k -> k215PReach (k215PairAt894State k215PNum894 a b t c) (k215PairAt894State k215PNum894 0 k (suc (t + b)) c) $ =
 '(mpd (a1i k215PairAt894Prefix) (syl k215PReach_trans k215PairAt894ReachSum));
theorem k215PairAt894ReachZeroIn (t c: nat): $ k215PReach (k215PairAt894State k215PNum894 0 0 t c) (k215PairAt894State k215PNum898 0 0 t c) $ =
 '(mpbi (k215PReacheq2 (k215PairAt894Stateeq eqid add0 eqid add0 eqid)) k215PairAt894ReachIn);
pub theorem k215PairAt894Base (t c: nat): $ k215PReach (k215PairAt894State k215PNum894 0 0 t c) (k215PairAt894State k215PNum904 0 0 t c) $ =
 '(ax_mp (ax_mp k215PReach_trans k215PairAt894ReachZeroIn) k215PairAt894Reach50Z);


@_ abstract def k215PairAt894Run (a b t c: nat): wff =
 $ k215PReach (k215PairAt894State k215PNum894 a b t c) (k215PairAt894State k215PNum904 0 0 (t + (a, b)) c) $;
do (apply (register-eqd 'k215PairAt894Run) '(k215PairAt894Runeqd));
theorem k215PairAt894RunZero (t c: nat): $ k215PairAt894Run 0 0 t c $ =
 '(mpbi (k215PReacheq2 (k215PairAt894Stateeq4 (eqcom (eqtr (addeq2 pr0) add0)))) k215PairAt894Base);
theorem k215PairAt894RunBase (a b t c: nat): $ a + b = 0 -> k215PairAt894Run a b t c $ =
 '(mpbiri k215PairAt894RunZero (k215PairAt894Runeqd
   (syl anl (bi1 addeq0)) (syl anr (bi1 addeq0)) eqidd eqidd));
theorem k215PairAt894SumStep (a b k: nat): $ a + b = suc k -> (a, b) = b + suc (0, k) $ =
 '(eqtrd (a1i preqadd) (eqtrd (addeq1d (preq1d id))
   (a1i (eqtr (addeq1 k215PairDiagonal_rotate) addcom))));
theorem k215PairAt894Accumulator (a b t k: nat): $ a + b = suc k -> suc (t + b) + (0, k) = t + (a, b) $ =
 '(eqtrd
   (a1i (eqtr addS1 (eqtr (suceq addass)
     (eqtr (eqcom addS) (addeq2 (eqcom addS))))))
   (addeq2d (eqcomd k215PairAt894SumStep)));
@_ abstract def k215PairAt894Claim (k c: nat) (.a .b .t: nat): wff =
 $ A. a A. b A. t (a + b = k -> k215PairAt894Run a b t c) $;
theorem k215PairAt894Claim_at (a b t k c: nat): $ k215PairAt894Claim k c -> a + b = k -> k215PairAt894Run a b t c $ =
 (named '(!! ealie i @ !! ealde j @ !! ealde l @ bi1d ,eqtac));
theorem k215PairAt894RunInductive (a b t k c: nat): $ k215PairAt894Claim k c -> a + b = suc k -> k215PairAt894Run a b t c $ =
 '(exp @ mpd
   (mpbid
     (k215PReacheq2d (k215PairAt894Stateeq4d (syl k215PairAt894Accumulator anr)))
     (mpd (a1i add01) (syl k215PairAt894Claim_at anl)))
   (syl k215PReach_trans (syl k215PairAt894Cycle anr)));
theorem k215PairAt894Claim_all (k c: nat): $ k215PairAt894Claim k c $ =
 (named @ induct '(ind) 'k
   '(ax_gen (ax_gen (ax_gen k215PairAt894RunBase)))
   '(iald @ iald @ iald k215PairAt894RunInductive));
pub theorem k215PairMacro894 (a b t c: nat): $ k215PReach (k215PairAt894State k215PNum894 a b t c) (k215PairAt894State k215PNum904 0 0 (t + (a, b)) c) $ =
 '(ax_mp (ax_mp k215PairAt894Claim_at k215PairAt894Claim_all) eqid);


