import "source_relative_invariant.mm0";

import "source_relative_prop_closure.mm0";

theorem sfRelative_AllI_good (D G a: nat) (hd: $ sfBound 1 D $):
 $ sfRowWf (sfSequent G (sfAll a)) ->
 sfRelativeGood D (sfSequent (sfContextShift G) a) ->
 sfRelativeGood D (sfSequent G (sfAll a)) $;

theorem sfRelative_AllE_good (D G a t: nat) (hd: $ sfBound 1 D $):
 $ sfRowWf (sfSequent G (sfSubst 0 t a)) ->
 sfRelativeGood D (sfSequent G (sfAll a)) ->
 sfRelativeGood D (sfSequent G (sfSubst 0 t a)) $;

theorem sfRelative_ExI_good (D G a t: nat) (hd: $ sfBound 1 D $):
 $ sfRowWf (sfSequent G (sfEx a)) ->
 sfRelativeGood D (sfSequent G (sfSubst 0 t a)) ->
 sfRelativeGood D (sfSequent G (sfEx a)) $;

theorem sfRelative_ExE_good (D G a c: nat) (hd: $ sfBound 1 D $):
 $ sfRowWf (sfSequent G c) ->
 sfRelativeGood D (sfSequent G (sfEx a)) ->
 sfRelativeGood D (sfSequent (a : sfContextShift G) (sfShift 0 c)) ->
 sfRelativeGood D (sfSequent G c) $;

theorem sfRelativeCase_AllI (D r p: nat) (hd: $ sfBound 1 D $):
 $ sfRowWf r -> sfNDCaseAllI r p -> sfRelativeGood D p -> sfRelativeGood D r $;

theorem sfRelativeCase_AllE (D r p: nat) (hd: $ sfBound 1 D $):
 $ sfRowWf r -> sfNDCaseAllE r p -> sfRelativeGood D p -> sfRelativeGood D r $;

theorem sfRelativeCase_ExI (D r p: nat) (hd: $ sfBound 1 D $):
 $ sfRowWf r -> sfNDCaseExI r p -> sfRelativeGood D p -> sfRelativeGood D r $;

theorem sfRelativeCase_ExE (D r p q: nat) (hd: $ sfBound 1 D $):
 $ sfRowWf r -> sfNDCaseExE r p q ->
 sfRelativeGood D p -> sfRelativeGood D q -> sfRelativeGood D r $;

theorem sfRelative_quant_unary (D r p: nat) (hd: $ sfBound 1 D $):
 $ sfNDQuantUnary r p -> sfRelativeGood D p -> sfRelativeGood D r $;

theorem sfRelative_quant_binary (D r p q: nat) (hd: $ sfBound 1 D $):
 $ sfNDQuantBinary r p q -> sfRelativeGood D p -> sfRelativeGood D q -> sfRelativeGood D r $;
