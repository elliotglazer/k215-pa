-- Route B (mm0-pa-ha) node B4: the two Pi2 sentences of K215 Theorem 1, over the full Theorem 1 tree.
-- Proof: b4_final.mm1 (K215_sigma{1,2}_of applied to K215_halts_iff_ZFC_inconsistent_final).
import "k215_final_thm1.mm0";
import "b4_sigma.mm0";

--| sigma1: K215 Theorem 1, halting -> inconsistency, as a Pi2 sentence.
theorem K215_sigma1 {h w: nat}: $ A. h (bdK215Halt h -> E. w bdZfcBot w) $;

--| sigma2: K215 Theorem 1, inconsistency -> halting, as a Pi2 sentence.
theorem K215_sigma2 {h w: nat}: $ A. w (bdZfcBot w -> E. h bdK215Halt h) $;
