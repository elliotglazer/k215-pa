import "k218q_quotient_mixed_formula.mm0";

def k218QMixedEnvironments (E F: set) (H n t k .i: nat): wff = $ A. i (i < n -> k218QMixed H t k (E @ i) (F @ i)) $;

theorem k218QM_formula_invariance_arbitrary (E F: set) (H n t k c: nat): $ sfBound n c -> 0 < k -> t < k -> sqEnvBelow E n k -> sqEnvBelow F n k -> k218IHypProvable H (k218QAEmpty t k) -> (k218QMixedEnvironments E F H n t k) -> k218QHEquiv H (sqQuote E t k 0 c) (sqQuote F t k 0 c) $;
