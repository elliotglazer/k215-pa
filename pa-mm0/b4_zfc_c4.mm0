import "b4_zfc_c3.mm0";

theorem RI_Ax_fix (m v B i z: nat): $ bdZfcFixed z -> bdRAx m v B i z $;
theorem CI_Ax_fix (z: nat): $ bdZfcFixed z -> bdCertF bdtAx z 0 0 0 $;
theorem RI_Ax_sep (m v B i z u e rr: nat): $ u + e + rr + (sfSeparation rr) <= B /\ bdHas m v i bdtBnd 0 z 0 0 /\ bdHas m v i bdtBnd (suc e) u 0 0 /\ bdHas m v i bdtRen 0 0 u rr /\ bdHas m v i bdtAllPre e (sfSeparation rr) z 0 -> bdRAx m v B i z $;
theorem CI_Ax_sep (z u e rr: nat): $ bdCertF bdtBnd 0 z 0 0 -> bdCertF bdtBnd (suc e) u 0 0 -> bdCertF bdtRen 0 0 u rr -> bdCertF bdtAllPre e (sfSeparation rr) z 0 -> bdCertF bdtAx z 0 0 0 $;
theorem RI_Ax_rep (m v B i z u e pp qq rr: nat): $ u + e + pp + qq + rr + (sfReplacement pp qq rr) <= B /\ bdHas m v i bdtBnd 0 z 0 0 /\ bdHas m v i bdtBnd (suc (suc e)) u 0 0 /\ bdHas m v i bdtRen 1 0 u pp /\ bdHas m v i bdtRen 2 0 u qq /\ bdHas m v i bdtRen 3 0 u rr /\ bdHas m v i bdtAllPre e (sfReplacement pp qq rr) z 0 -> bdRAx m v B i z $;
theorem CI_Ax_rep (z u e pp qq rr: nat): $ bdCertF bdtBnd 0 z 0 0 -> bdCertF bdtBnd (suc (suc e)) u 0 0 -> bdCertF bdtRen 1 0 u pp -> bdCertF bdtRen 2 0 u qq -> bdCertF bdtRen 3 0 u rr -> bdCertF bdtAllPre e (sfReplacement pp qq rr) z 0 -> bdCertF bdtAx z 0 0 0 $;
theorem bdAx_sep_cert (z: nat) {u e: nat}: $ sfBound 0 z /\ E. u E. e (sfBound (suc e) u /\ z = zfcSeparationCode u e) -> bdCertF bdtAx z 0 0 0 $;
theorem bdAx_rep_cert (z: nat) {u e: nat}: $ sfBound 0 z /\ E. u E. e (sfBound (suc (suc e)) u /\ z = zfcReplacementCode u e) -> bdCertF bdtAx z 0 0 0 $;
theorem bdAx_cert (z: nat): $ z e. zfcAxioms -> bdCertF bdtAx z 0 0 0 $;
theorem bdCax_cert (q: nat) {x yy ll: nat}: $ zfcContext q -> bdCertF bdtCax q 0 0 0 $;
