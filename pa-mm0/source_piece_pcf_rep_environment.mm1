mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S))))))) (mpbir sfBound_sfOr (ian (mpbir sfBound_sfMem (ian lt01S (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S)))))) (mpbir sfBound_sfEq (ian lt01S (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S)))))))))))) (mpbir sfBound_sfAll (mpbir sfBound_sfImp (ian (mpbir sfBound_sfMem (ian lt01S (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S)))))) (mpbir sfBound_sfMem (ian lt01S (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S)))))))))))))))))))));
theorem pcre_bound_zero: $ sfBound 1 (sfPieceEnvCore 0) $ =
 '(mpbir (pcre_bformula sfPieceEnvCore_zero)
   (mpbi (pcre_bformula sfPieceNumeralCore_zero) sfPieceNumeralCore_bound));
theorem pcre_bound_suc(n:nat):
 $ sfBound (suc n) (sfPieceEnvCore n) -> sfBound (suc (suc n)) (sfPieceEnvCore (suc n)) $ =
 '(mpbird (a1i (pcre_bformula sfPieceEnvCore_suc))
   (syl (bi2 sfBound_sfEx) (syl (bi2 sfBound_sfAnd)
    (iand pcre_skip_bound (a1i pcre_extension_bound)))));
pub theorem sfPieceEnvCore_bound(n:nat): $ sfBound (suc n) (sfPieceEnvCore n) $ =
 (named @ induct '(ind) 'n 'pcre_bound_zero 'pcre_bound_suc);

pub theorem sfPieceRepRest_cons_at(T:set)(v i:nat):
 $ sfPieceRepRest (sqEnvCons v T) @ i = T @ i $ =
 '(eqtr sfPieceRepRest_at sqEnvCons_suc);
pub theorem sfPieceEnv_cons_intro(T:set)(G n v prev e:nat)
 (ht:$ nsLocal G (sfPieceEnv T n prev) $)
 (he:$ nsLocal G (sfPieceRepExtension prev v e) $):
 $ nsLocal G (sfPieceEnv (sqEnvCons v T) (suc n) e) $ =
 (named '(sfPieceEnv_suc_intro
   (mpbir (nsLocal_formula_eq (sfPieceEnv_eq eqid (ax_gen sfPieceRepRest_cons_at))) ht)
   (mpbir (nsLocal_formula_eq (sfPieceRepExtension_eq eqid sqEnvCons_zero eqid)) he)));
pub theorem sfPieceEnv_suc_eliminate(T:set)(G n e out:nat)
 (ho:$ sfWf out $)(hn:$ nsLocal G (sfPieceEnv T (suc n) e) $)
 (hc:$ nsLocal (sfAnd (sfPieceEnv (sfPieceRepLiftRest T) n 0)
   (sfPieceRepExtension 0 (suc (T @ 0)) (suc e)) : sfContextShift G) (sfShift 0 out) $):
 $ nsLocal G out $ =
 '(ax_mp (ax_mp (sfLocal_exE ho)
   (mpbi (nsLocal_formula_eq sfPieceEnv_suc) hn)) hc);
