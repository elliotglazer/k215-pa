import "source_k0_collection_profile.mm0";

import "source_k0_qsep_open_witness.mm0";

def sfK0CollectionWitness (E: set) (root b t r a k psi: nat): nat = $ (kExists (suc k) (kAnd (kAll (suc (suc k)) (kImp (kDisj (kEq (suc (suc k)) root) (kExists (suc (suc (suc k))) (kAnd (kMem (suc (suc (suc k))) (suc k)) (kAll (suc (suc (suc (suc k)))) (kImp (kMem (suc (suc (suc (suc k)))) (suc (suc k))) (kMem (suc (suc (suc (suc k)))) (suc (suc (suc k))))))))) (kImp (kExists (suc (suc (suc k))) (sfK0CollectionTagged E b t r a (suc (suc k)) (suc (suc (suc k))) (suc (suc (suc (suc k)))) (suc (suc (suc (suc (suc k))))) psi)) (kExists (suc (suc (suc k))) (kAnd (kMem (suc (suc (suc k))) (suc k)) (sfK0CollectionTagged E b t r a (suc (suc k)) (suc (suc (suc k))) (suc (suc (suc (suc k)))) (suc (suc (suc (suc (suc k))))) psi)))))) (kAll (suc (suc k)) (kImp (kMem (suc (suc k)) (suc k)) (kExists (suc (suc (suc k))) (sfK0CollectionTagged E b t r a (suc (suc (suc k))) (suc (suc k)) (suc (suc (suc (suc k)))) (suc (suc (suc (suc (suc k))))) psi)))))) $;

theorem sfK0CollectionWitness_source (E: set) (n root b t r a k psi: nat) (hf: $ sfBound (suc (suc n)) psi $):
 $ sfNamedTemplate (sqEnvCons root (sqEnvCons b (sqEnvCons t (sqEnvCons r (sqEnvCons a E))))) (suc k) 0 (sfK0QSepKp0UseBody (sfK0QRepCollectionMatrix psi)) = (sfK0CollectionWitness E root b t r a k psi) $;

theorem sfK0CollectionWitness_open (E: set) (n root b t r a k psi: nat)
 (hf: $ sfBound (suc (suc n)) psi $) (hk: $ 0 < k $)
 (he: $ sqEnvBelow (sqEnvCons b (sqEnvCons t (sqEnvCons r (sqEnvCons a E)))) (suc (suc (suc (suc n)))) k $) (hr: $ root < k $):
 $ k218QProvable (sfK0CollectionWitness E root b t r a k psi) $;
