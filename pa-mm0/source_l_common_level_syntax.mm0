def sfCLOrdinal: nat = $ srcCLSyntaxF8 $;

def sfCLHierarchy: nat = $ srcCLSyntaxF769 $;

def sfCLPairMap (d y: nat) (.i: nat): set = $ \ i, if (i = 0) d y $;

def sfCLOrdinalAt (d: nat): nat = $ sfRename (sfCLPairMap d d) 0 sfCLOrdinal $;

def sfCLHierarchyAt (d y: nat): nat = $ sfRename (sfCLPairMap d y) 0 sfCLHierarchy $;

def sfCLPoint (start count d y: nat): nat =
 $ sfAnd (sfAnd (sfCLOrdinalAt d) (sfCLHierarchyAt d y)) (sfCLMembership start y count) $;

def sfCLRecipe (start count: nat): nat =
 $ sfEx (sfEx (sfCLPoint (suc (suc start)) count 1 0)) $;

theorem sfCLOrdinal_bound: $ sfBound 1 sfCLOrdinal $;

theorem sfCLHierarchy_bound: $ sfBound 2 sfCLHierarchy $;

theorem sfCLOrdinal_wf: $ sfWf sfCLOrdinal $;

theorem sfCLHierarchy_wf: $ sfWf sfCLHierarchy $;

theorem sfCLOrdinalAt_bound (d k: nat) (hd: $ d < k $):
 $ sfBound k (sfCLOrdinalAt d) $;

theorem sfCLHierarchyAt_bound (d y k: nat) (hd: $ d < k $) (hy: $ y < k $):
 $ sfBound k (sfCLHierarchyAt d y) $;

theorem sfCLOrdinalAt_wf (d: nat): $ sfWf (sfCLOrdinalAt d) $;

theorem sfCLHierarchyAt_wf (d y: nat): $ sfWf (sfCLHierarchyAt d y) $;

theorem sfCLPoint_wf (start count d y: nat): $ sfWf (sfCLPoint start count d y) $;

theorem sfCLRecipe_wf (start count: nat): $ sfWf (sfCLRecipe start count) $;

theorem sfCLPoint_bound (start count d y k: nat) (hd: $ d < k $) (hy: $ y < k $):
 $ sfCLNamesBound start count k -> sfBound k (sfCLPoint start count d y) $;

theorem sfCLNamesBound_shift (start count k: nat):
 $ sfCLNamesBound start count k -> sfCLNamesBound (suc start) count (suc k) $;

theorem sfCLRecipe_bound (start count k: nat):
 $ sfCLNamesBound start count k -> sfBound k (sfCLRecipe start count) $;
