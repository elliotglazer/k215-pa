import "quotation_supported_eigenvariables.mm0";

theorem sqSupported_AllE_at (m G a i: nat):
 $ sfRowWf (sfSequent G (sfSubst 0 i a)) -> sqSupportedAt m (sfSequent G (sfAll a)) ->
 sqSupportedAt (sfSequent G (sfSubst 0 i a) + m + suc i) (sfSequent G (sfSubst 0 i a)) $;

theorem sqSupported_AllE_good (G a i: nat):
 $ sfRowWf (sfSequent G (sfSubst 0 i a)) -> sqSupportedGood (sfSequent G (sfAll a)) ->
 sqSupportedGood (sfSequent G (sfSubst 0 i a)) $;

theorem sqSupported_ExI_at (m G a i: nat):
 $ sfRowWf (sfSequent G (sfEx a)) -> sqSupportedAt m (sfSequent G (sfSubst 0 i a)) ->
 sqSupportedAt (sfSequent G (sfEx a) + m + suc i) (sfSequent G (sfEx a)) $;

theorem sqSupported_ExI_good (G a i: nat):
 $ sfRowWf (sfSequent G (sfEx a)) -> sqSupportedGood (sfSequent G (sfSubst 0 i a)) ->
 sqSupportedGood (sfSequent G (sfEx a)) $;

theorem sqSupported_ExE_at (m j G a c: nat):
 $ sfRowWf (sfSequent G c) -> sqSupportedAt m (sfSequent G (sfEx a)) ->
 sqSupportedAt j (sfSequent (a : sfContextShift G) (sfShift 0 c)) ->
 sqSupportedAt (sfSequent G c + m + j) (sfSequent G c) $;

theorem sqSupported_ExE (G a c: nat):
 $ sfRowWf (sfSequent G c) -> sqSupportedGood (sfSequent G (sfEx a)) ->
 sqSupportedGood (sfSequent (a : sfContextShift G) (sfShift 0 c)) ->
 sqSupportedGood (sfSequent G c) $;

theorem sqSupportedCase_AllI (r p: nat):
 $ sfRowWf r -> sfNDCaseAllI r p -> sqSupportedGood p -> sqSupportedGood r $;

theorem sqSupportedCase_AllE (r p: nat):
 $ sfRowWf r -> sfNDCaseAllE r p -> sqSupportedGood p -> sqSupportedGood r $;

theorem sqSupportedCase_ExI (r p: nat):
 $ sfRowWf r -> sfNDCaseExI r p -> sqSupportedGood p -> sqSupportedGood r $;

theorem sqSupportedCase_ExE (r p q: nat):
 $ sfRowWf r -> sfNDCaseExE r p q -> sqSupportedGood p -> sqSupportedGood q -> sqSupportedGood r $;

theorem sqSupported_quant_unary (r p: nat):
 $ sfNDQuantUnary r p -> sqSupportedGood p -> sqSupportedGood r $;

theorem sqSupported_quant_binary (r p q: nat):
 $ sfNDQuantBinary r p q -> sqSupportedGood p -> sqSupportedGood q -> sqSupportedGood r $;

