theorem osiOr_eq (a b c d: nat) (ha: $ a = b $) (hc: $ c = d $): $ sfOr a c = sfOr b d $;

theorem osiImp_eq (a b c d: nat) (ha: $ a = b $) (hc: $ c = d $): $ sfImp a c = sfImp b d $;

theorem osiAll_eq (a b: nat) (ha: $ a = b $): $ sfAll a = sfAll b $;

theorem osiEx_eq (a b: nat) (ha: $ a = b $): $ sfEx a = sfEx b $;

