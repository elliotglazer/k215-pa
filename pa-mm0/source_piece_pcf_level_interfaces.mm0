import "source_piece_pcf_above_kernel.mm0";

import "source_l_universal_hierarchy_syntax.mm0";

import "source_l_power_hierarchy_syntax.mm0";

theorem sfPieceLevelExists_hierarchy_eq:
 $ sfPieceLevelExistsSource = sfLUniversalHierarchyExists $;

theorem sfPieceLevelSubset_hierarchy_eq:
 $ sfPieceLevelSubsetSource = sfLPowerHierarchySubset $;

theorem sfPieceLevelExists_from_hierarchy
 (he:$ sfTheoryProvable zfrAxioms sfLUniversalHierarchyExists $):
 $ sfTheoryProvable zfrAxioms sfPieceLevelExistsSource $;

theorem sfPieceLevelSubset_from_hierarchy
 (hs:$ sfTheoryProvable zfrAxioms sfLPowerHierarchySubset $):
 $ sfTheoryProvable zfrAxioms sfPieceLevelSubsetSource $;

theorem sfPieceAbove_from_hierarchy
 (he:$ sfTheoryProvable zfrAxioms sfLUniversalHierarchyExists $)
 (hs:$ sfTheoryProvable zfrAxioms sfLPowerHierarchySubset $):
 $ sfTheoryProvable zfrAxioms sfPieceLevelAboveSource $;
