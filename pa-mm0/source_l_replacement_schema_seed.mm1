import "source_l_replacement_seed_consumer.mm1";
import "source_l_replacement_parameters.mm1";

pub theorem sfLReplacementSeedOutput_from_range(G phi:nat)(hf:$ sfWf phi $)
 (hp:$ nsLocal G (sfEx (sfLReplacementSeedRange (sfLReplacementSeedMatrix phi) sfLReplacementSeedMetadata)) $):
 $ nsLocal G (sfLReplacementSeedImageOutput phi) $ =
 '(sfRQ_rewrite (sfLReplacementSeedImageOutput_exact hf) hp);

@_ def sfLReplacementSchemaInput(G n phi:nat):nat =
 $ sfLReplacementInputOverContext (sfLSeparationImageParameterContext sfLDomain n G) phi $;
@_ def sfLReplacementSchemaDefinableContext(G n phi:nat):nat =
 $ sfLReplacementSeedDefinableContext (sfLReplacementSchemaInput G n phi) n phi $;

pub theorem sfLReplacement_schema_from_actual_seed(G phi n:nat)
 (hg:$ sfContextWf G $)(hbase:$ all (sfTheoryProofClass zfrAxioms) G $)
 (hb:$ sfBound (suc (suc n)) phi $)
 (he:$ nsLocal (sfLReplacementSchemaInput G n phi) sfLReplacementLevelExtension $)
 (hA:$ nsLocal (sfLReplacementSchemaInput G n phi)
     (sfLReplacementAboveLaw (suc (suc n)) (sfLReplacementPsi phi)) $)
 (hL:$ nsLocal (sfLReplacementSchemaInput G n phi) sfLReplacementLevelExistsLaw $)
 (hS:$ nsLocal (sfLReplacementSchemaInput G n phi) (sfReflectionHierarchySubsetNormal sfCLHierarchy) $)
 (hp:$ nsLocal (sfLReplacementSchemaInput G n phi)
     (sfEx (sfLReplacementSeedRange (sfLReplacementSeedMatrix phi) sfLReplacementSeedMetadata)) $)
 (hd:$ nsLocal (sfLReplacementSchemaDefinableContext G n phi)
  (sfLReplacementImageDefinable (sfLReplacementStartMap 7) sfLDomain (sfLReplacementPsi phi) 0) $):
 $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain (zfcReplacementCode phi n)) $ =
 '(sfLReplacement_schema_from_parameter_witness hg hbase hb
  (sfLReplacementWitness_from_seed_output hb he hA hL hS
   (sfLReplacement_parameter_inputs hg)
   (sfLReplacementSeedOutput_from_range (ax_mp sfBound_wf hb) hp) hd));
