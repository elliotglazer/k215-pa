import "k215_calculus_source_ax_loops.mm1";
import "k215_literal_runtime_reach.mm1";
import "k215_calculus_source_pairing.mm1";
import "k215_calculus_source_ax_lookups.mm1";

@_ def k215UnpairAt78State (pc a b n c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) n (k215PR3 c) (k215PR4 c) (k215PR5 c) a b (k215PR8 c)) $;

do (apply (register-eqd 'k215UnpairAt78State) '(k215UnpairAt78Stateeqd));

theorem k215UnpairAt78Transfer (b n c: nat): $ k215PIter (3 * b + 1) (k215UnpairAt78State k215Num82 0 b n c) = (k215UnpairAt78State k215Num85 b 0 n c) $ =
 '(eqtr k215Loop82Vector (k215PStateeq2 (k215PVectoreq7 add0)));
theorem k215UnpairAt78ReachTransfer (b n c: nat): $ k215PReach (k215UnpairAt78State k215Num82 0 b n c) (k215UnpairAt78State k215Num85 b 0 n c) $ =
 '(k215PReach_intro k215UnpairAt78Transfer);


theorem k215UnpairAt78Step9Z (a b c: nat): $ k215PStep (k215UnpairAt78State k215Num78 a b 0 c) = (k215UnpairAt78State k215Num86 a b 0 c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair78_78) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt78Reach9Z (a b c: nat): $ k215PReach (k215UnpairAt78State k215Num78 a b 0 c) (k215UnpairAt78State k215Num86 a b 0 c) $ = '(k215PReach_step k215UnpairAt78Step9Z);

theorem k215UnpairAt78Step9S (a b n c: nat): $ k215PStep (k215UnpairAt78State k215Num78 a b (suc n) c) = (k215UnpairAt78State k215Num79 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair78_78) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet2_vector)) (eqtr k215PSet2_vector (k215PVectoreq3 (eqtr subSS sub02))))));

theorem k215UnpairAt78Reach9S (a b n c: nat): $ k215PReach (k215UnpairAt78State k215Num78 a b (suc n) c) (k215UnpairAt78State k215Num79 a b n c) $ = '(k215PReach_step k215UnpairAt78Step9S);

theorem k215UnpairAt78Step10 (a b n c: nat): $ k215PStep (k215UnpairAt78State k215Num79 a b n c) = (k215UnpairAt78State k215Num80 a (suc b) n c) $ = '(eqtr (k215PAtCI k215PLookupUnpair78_79) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215UnpairAt78Reach10 (a b n c: nat): $ k215PReach (k215UnpairAt78State k215Num79 a b n c) (k215UnpairAt78State k215Num80 a (suc b) n c) $ = '(k215PReach_step k215UnpairAt78Step10);

theorem k215UnpairAt78Step11Z (b n c: nat): $ k215PStep (k215UnpairAt78State k215Num80 0 b n c) = (k215UnpairAt78State k215Num82 0 b n c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair78_80) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt78Reach11Z (b n c: nat): $ k215PReach (k215UnpairAt78State k215Num80 0 b n c) (k215UnpairAt78State k215Num82 0 b n c) $ = '(k215PReach_step k215UnpairAt78Step11Z);

theorem k215UnpairAt78Step11S (a b n c: nat): $ k215PStep (k215UnpairAt78State k215Num80 (suc a) b n c) = (k215UnpairAt78State k215Num81 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair78_80) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215UnpairAt78Reach11S (a b n c: nat): $ k215PReach (k215UnpairAt78State k215Num80 (suc a) b n c) (k215UnpairAt78State k215Num81 a b n c) $ = '(k215PReach_step k215UnpairAt78Step11S);

theorem k215UnpairAt78Step12 (a b n c: nat): $ k215PStep (k215UnpairAt78State k215Num81 a b n c) = (k215UnpairAt78State k215Num85 a b n c) $ = '(k215PAtCB k215PLookupUnpair78_81);

theorem k215UnpairAt78Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt78State k215Num81 a b n c) (k215UnpairAt78State k215Num85 a b n c) $ = '(k215PReach_step k215UnpairAt78Step12);

theorem k215UnpairAt78Step16 (a b n c: nat): $ k215PStep (k215UnpairAt78State k215Num85 a b n c) = (k215UnpairAt78State k215Num78 a b n c) $ = '(k215PAtCC k215PLookupUnpair78_85);

theorem k215UnpairAt78Reach16 (a b n c: nat): $ k215PReach (k215UnpairAt78State k215Num85 a b n c) (k215UnpairAt78State k215Num78 a b n c) $ = '(k215PReach_step k215UnpairAt78Step16);

theorem k215UnpairAt78CycleZero (b n c: nat): $ k215PReach (k215UnpairAt78State k215Num78 0 b (suc n) c) (k215UnpairAt78State k215Num78 (suc b) 0 n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt78Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt78Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt78Reach11Z) (ax_mp (ax_mp k215PReach_trans k215UnpairAt78ReachTransfer) k215UnpairAt78Reach16))));
theorem k215UnpairAt78CycleSucc (a b n c: nat): $ k215PReach (k215UnpairAt78State k215Num78 (suc a) b (suc n) c) (k215UnpairAt78State k215Num78 a (suc b) n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt78Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt78Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt78Reach11S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt78Reach12) k215UnpairAt78Reach16))));


theorem k215UnpairAt78AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt78State k215Num78 0 b (suc n) c) (k215UnpairAt78State k215Num78 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt78Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215PairDiagonal_rotate)) (eqtr (eqcom sndpr) (sndeq k215PairDiagonal_rotate)) eqid eqid)) k215UnpairAt78CycleZero);

theorem k215UnpairAt78AdvanceSucc (a b n c: nat): $ k215PReach (k215UnpairAt78State k215Num78 (suc a) b (suc n) c) (k215UnpairAt78State k215Num78 (fst (suc ((suc a), b))) (snd (suc ((suc a), b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt78Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215Pair_next)) (eqtr (eqcom sndpr) (sndeq k215Pair_next)) eqid eqid)) k215UnpairAt78CycleSucc);

pub theorem k215UnpairAt78Advance (a b n c: nat): $ k215PReach (k215UnpairAt78State k215Num78 a b (suc n) c) (k215UnpairAt78State k215Num78 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
 (named @ induct '(ind) 'a 'k215UnpairAt78AdvanceZero '(a1i k215UnpairAt78AdvanceSucc));
@_ abstract def k215UnpairAt78Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt78State k215Num78 a b n c) (k215UnpairAt78State k215Num86 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
theorem k215UnpairAt78RunZero (a b c: nat): $ k215UnpairAt78Run 0 a b c $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt78Stateeq eqid
     (eqcom (eqtr (fsteq add0) fstpr))
     (eqcom (eqtr (sndeq add0) sndpr)) eqid eqid)) k215UnpairAt78Reach9Z);
@_ abstract def k215UnpairAt78Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt78Run n a b c $;
theorem k215UnpairAt78Claim_at (n a b c: nat): $ k215UnpairAt78Claim n c -> k215UnpairAt78Run n a b c $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215UnpairAt78CodeStep (a b n: nat): $ (fst (suc (a, b)), snd (suc (a, b))) + n = (a, b) + suc n $ =
 '(eqtr (addeq1 fstsnd) addSass);
theorem k215UnpairAt78RunInductive (n a b c: nat): $ k215UnpairAt78Claim n c -> k215UnpairAt78Run (suc n) a b c $ =
 '(syl (ax_mp k215PReach_trans k215UnpairAt78Advance)
   (mpbid (a1i (k215PReacheq2 (k215UnpairAt78Stateeq eqid
     (fsteq k215UnpairAt78CodeStep) (sndeq k215UnpairAt78CodeStep) eqid eqid))) k215UnpairAt78Claim_at));
theorem k215UnpairAt78Claim_all (n c: nat): $ k215UnpairAt78Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt78RunZero)) '(iald @ iald k215UnpairAt78RunInductive));
pub theorem k215UnpairMacro78 (n a b c: nat): $ k215PReach (k215UnpairAt78State k215Num78 a b n c) (k215UnpairAt78State k215Num86 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
 '(ax_mp k215UnpairAt78Claim_at k215UnpairAt78Claim_all);
pub theorem k215UnpairMacro78_clean (n c: nat): $ k215PReach (k215UnpairAt78State k215Num78 0 0 n c) (k215UnpairAt78State k215Num86 (fst n) (snd n) 0 c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt78Stateeq eqid
   (fsteq (eqtr (addeq1 pr0) add01))
   (sndeq (eqtr (addeq1 pr0) add01)) eqid eqid)) k215UnpairMacro78);


