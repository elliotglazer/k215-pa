import "source_syntax.mm1";

-- Exact finite branch of the pinned source ZFC axiom predicate.
-- This file does not include Separation or Replacement.
-- All formula numbers use the eight-tag source constructors.

@_ def zfcRefl: nat = $ sfAll (sfEq 0 0) $;

@_ def zfcSym: nat = $ sfAll (sfAll (sfImp (sfEq 1 0) (sfEq 0 1))) $;

@_ def zfcTrans: nat = $ sfAll (sfAll (sfAll (sfImp (sfEq 2 1) (sfImp (sfEq 1 0) (sfEq 2 0))))) $;

@_ def zfcEqElem: nat = $ sfAll (sfAll (sfAll (sfAll (sfImp (sfEq 3 1) (sfImp (sfEq 2 0) (sfImp (sfMem 3 2) (sfMem 1 0))))))) $;

@_ def zfcExt: nat = $ sfAll (sfAll (sfImp (sfAll (sfImp (sfMem 0 2) (sfMem 0 1))) (sfImp (sfAll (sfImp (sfMem 0 1) (sfMem 0 2))) (sfEq 1 0)))) $;

@_ def zfcEmpty: nat = $ sfEx (sfAll (sfImp (sfMem 0 1) (sfBot))) $;

@_ def zfcPair: nat = $ sfAll (sfAll (sfEx (sfAll (sfAnd (sfImp (sfMem 0 1) (sfOr (sfEq 0 3) (sfEq 0 2))) (sfImp (sfOr (sfEq 0 3) (sfEq 0 2)) (sfMem 0 1)))))) $;

@_ def zfcUnion: nat = $ sfAll (sfEx (sfAll (sfAnd (sfImp (sfMem 0 1) (sfEx (sfAnd (sfMem 0 3) (sfMem 1 0)))) (sfImp (sfEx (sfAnd (sfMem 0 3) (sfMem 1 0))) (sfMem 0 1))))) $;

@_ def zfcPower: nat = $ sfAll (sfEx (sfAll (sfAnd (sfImp (sfMem 0 1) (sfAll (sfImp (sfMem 0 1) (sfMem 0 3)))) (sfImp (sfAll (sfImp (sfMem 0 1) (sfMem 0 3))) (sfMem 0 1))))) $;

@_ def zfcOmega: nat = $ sfEx (sfAnd (sfAnd (sfEx (sfAnd (sfAll (sfImp (sfMem 0 1) (sfBot))) (sfMem 0 1))) (sfAll (sfImp (sfMem 0 1) (sfEx (sfAnd (sfAll (sfAnd (sfImp (sfMem 0 1) (sfOr (sfMem 0 2) (sfEq 0 2))) (sfImp (sfOr (sfMem 0 2) (sfEq 0 2)) (sfMem 0 1)))) (sfMem 0 2)))))) (sfAll (sfImp (sfAnd (sfEx (sfAnd (sfAll (sfImp (sfMem 0 1) (sfBot))) (sfMem 0 1))) (sfAll (sfImp (sfMem 0 1) (sfEx (sfAnd (sfAll (sfAnd (sfImp (sfMem 0 1) (sfOr (sfMem 0 2) (sfEq 0 2))) (sfImp (sfOr (sfMem 0 2) (sfEq 0 2)) (sfMem 0 1)))) (sfMem 0 2)))))) (sfAll (sfImp (sfMem 0 2) (sfMem 0 1)))))) $;

@_ def zfcFoundation: nat = $ sfAll (sfImp (sfEx (sfMem 0 1)) (sfEx (sfAnd (sfMem 0 1) (sfAll (sfImp (sfMem 0 1) (sfImp (sfMem 0 2) (sfBot))))))) $;

@_ def zfcChoice: nat = $ sfAll (sfImp (sfAll (sfImp (sfMem 0 1) (sfEx (sfMem 0 1)))) (sfImp (sfAll (sfImp (sfMem 0 1) (sfAll (sfImp (sfMem 0 2) (sfImp (sfImp (sfEq 1 0) (sfBot)) (sfImp (sfEx (sfAnd (sfMem 0 2) (sfMem 0 1))) (sfBot))))))) (sfEx (sfAll (sfImp (sfMem 0 2) (sfEx (sfAnd (sfAnd (sfMem 0 1) (sfMem 0 2)) (sfAll (sfImp (sfMem 0 2) (sfImp (sfMem 0 3) (sfEq 0 1))))))))))) $;

@_ def zfcFixed (n: nat): wff = $ n = zfcRefl \/ (n = zfcSym \/ (n = zfcTrans \/ (n = zfcEqElem \/ (n = zfcExt \/ (n = zfcEmpty \/ (n = zfcPair \/ (n = zfcUnion \/ (n = zfcPower \/ (n = zfcOmega \/ (n = zfcFoundation \/ (n = zfcChoice))))))))))) $;

