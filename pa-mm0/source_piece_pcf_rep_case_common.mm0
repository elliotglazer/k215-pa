import "source_piece_pcf_definable_witness_transport.mm0";

import "source_l_background.mm0";

import "source_piece_pcf_definable_calibration.mm0";

import "source_piece_pcf_definable_existential_syntax.mm0";

import "source_reflection_transfer_tv_existential.mm0";

import "extracted_rename_prefix.mm0";

-- Shared bookkeeping for the hypothesis-form case lemmas of the uniform representation
-- theorem (no large replay in this closure).

theorem sfPieceRepCase_named01 (n phi: nat) (hb: $ sfBound n phi $):
  $ sfPieceDefinableNamed n phi 0 1 = sfPieceDefinableRecipe n phi $;

theorem sfPieceRepCase_wshift (A C n phi: nat) (hb: $ sfBound n phi $):
  $ sfShift 0 (sfPieceDefinableWitness A C n phi) =
    sfPieceDefinableWitness (suc A) (suc C) n phi $;

theorem sfPieceRepCase_mshift (a b: nat): $ sfShift 0 (sfMem a b) = sfMem (suc a) (suc b) $;

theorem sfPieceRepCase_bg_under (G h: nat) (hg: $ sfContextWf G $)
  (hb: $ sfContextSub sfLBackground G $):
  $ sfContextSub sfLBackground (h : sfContextShift G) $;

theorem sfPieceRepCase_ctx (G h: nat) (hh: $ sfWf h $): $ sfContextWf (h : sfContextShift G) $;

theorem sfPieceRepCase_head (G h: nat) (hh: $ sfWf h $): $ nsLocal (h : sfContextShift G) h $;
