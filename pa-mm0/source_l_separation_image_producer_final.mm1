import "source_l_separation_image_producer_context.mm1";
import "source_l_replacement_producer_closed.mm1";
import "source_l_separation_image_transitive_producer.mm1";

pub theorem sfLSeparationImage_schema_from_generic_candidate(n phi:nat)
 (hb:$ sfBound (suc n) phi $)
 (hD:$ nsLocal (sfLSeparationProducerDefinableContext n phi)
   (sfLSeparationImageCandidate (sfLSeparationImageParameterMap 2) sfLDomain phi 0 2) $):
 $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain (zfcSeparationCode phi n)) $ =
 '(sfLSeparationImage_schema_from_source_proofs hb
   sfLReplacementExtension_zfr (sfLReplacementAbove_zfr hb)
   sfLReplacementLevelExists_zfr sfLReplacementSubset_zfr
   sfLSeparationStageTrans_zfr sfCLZero_zfr hD);
