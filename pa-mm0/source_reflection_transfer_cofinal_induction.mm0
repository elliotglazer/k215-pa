import "source_reflection_transfer_cofinal_build.mm0";

def sfReflectionCofinalFallback(T:set)(start n level K:nat):nat = $ (sfReflectionCofinalCommon T start n level K) : ((sfReflectionCofinalHit level K ((T @ n) + start)) : ((sfReflectionCofinalMergeLaw level K) : 0)) $;

theorem sfReflectionCofinal_extend_conditional(H:wff)(T:set)(G start n level K:nat)(hl:$ sfBound 2 level $)(hC:$ H -> nsLocal G (sfReflectionCofinalCommon T start n level K) $)(hH:$ H -> nsLocal G (sfReflectionCofinalHit level K ((T @ n) + start)) $)(hM:$ H -> nsLocal G (sfReflectionCofinalMergeLaw level K) $): $ H -> nsLocal G (sfReflectionCofinalCommon T start (suc n) level K) $;

def sfReflectionCofinalBuildLaw(T:set)(G start level K Y n:nat):wff = $ nsLocal G (sfReflectionTuple T start Y n) -> nsLocal G (sfReflectionCofinalCommon T start n level K) $;

theorem sfReflectionCofinal_build(T:set)(G start level K Y n:nat)(hl:$ sfBound 2 level $)(hs:$ nsLocal G (sfReflectionCofinalSeed level K) $)(hc:$ nsLocal G (sfReflectionCofinalCover level K Y) $)(hm:$ nsLocal G (sfReflectionCofinalMergeLaw level K) $): $ sfReflectionCofinalBuildLaw T G start level K Y n $;
