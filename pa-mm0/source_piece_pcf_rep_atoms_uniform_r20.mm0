import "source_piece_pcf_rep_lookup_all_r19.mm0";

theorem sfPieceRepLookup_eq(e x v ep xp vp:nat)(h0:$ e = ep $)(h1:$ x = xp $)(h2:$ v = vp $):
 $ sfPieceRepLookup e x v = sfPieceRepLookup ep xp vp $;

theorem sfPieceRepLookup_rename(R:set)(d e x v:nat):
 $ sfRename R d (sfPieceRepLookup e x v) = sfPieceRepLookup (sfRenameIndex R d e) (sfRenameIndex R d x) (sfRenameIndex R d v) $;

theorem sfPieceRepLookup_subst(d t e x v:nat):
 $ sfSubst d t (sfPieceRepLookup e x v) = sfPieceRepLookup (sfSubstIndex d t e) (sfSubstIndex d t x) (sfSubstIndex d t v) $;

def sfPieceRepMemberTest(x y e:nat):nat = $ (sfEx (sfAnd (sfMem 0 (suc e)) (sfEx (sfAnd (sfMem 0 1) (sfEx (sfAnd (sfMem 0 1) (sfAnd (sfAnd (sfAnd (sfEx (sfAnd (sfMem 0 3) (sfAnd (sfMem (suc (suc (suc (suc x)))) 0) (sfAll (sfImp (sfMem 0 1) (sfEq 0 (suc (suc (suc (suc (suc x))))))))))) (sfEx (sfAnd (sfMem 0 3) (sfAnd (sfAnd (sfMem (suc (suc (suc (suc x)))) 0) (sfMem 1 0)) (sfAll (sfImp (sfMem 0 1) (sfOr (sfEq 0 (suc (suc (suc (suc (suc x)))))) (sfEq 0 2)))))))) (sfAll (sfImp (sfMem 0 3) (sfOr (sfAnd (sfMem (suc (suc (suc (suc x)))) 0) (sfAll (sfImp (sfMem 0 1) (sfEq 0 (suc (suc (suc (suc (suc x))))))))) (sfAnd (sfAnd (sfMem (suc (suc (suc (suc x)))) 0) (sfMem 1 0)) (sfAll (sfImp (sfMem 0 1) (sfOr (sfEq 0 (suc (suc (suc (suc (suc x)))))) (sfEq 0 2))))))))) (sfEx (sfAnd (sfMem 0 (suc (suc (suc (suc e))))) (sfEx (sfAnd (sfMem 0 1) (sfEx (sfAnd (sfMem 0 1) (sfAnd (sfAnd (sfAnd (sfEx (sfAnd (sfMem 0 3) (sfAnd (sfMem (suc (suc (suc (suc (suc (suc (suc y))))))) 0) (sfAll (sfImp (sfMem 0 1) (sfEq 0 (suc (suc (suc (suc (suc (suc (suc (suc y)))))))))))))) (sfEx (sfAnd (sfMem 0 3) (sfAnd (sfAnd (sfMem (suc (suc (suc (suc (suc (suc (suc y))))))) 0) (sfMem 1 0)) (sfAll (sfImp (sfMem 0 1) (sfOr (sfEq 0 (suc (suc (suc (suc (suc (suc (suc (suc y))))))))) (sfEq 0 2)))))))) (sfAll (sfImp (sfMem 0 3) (sfOr (sfAnd (sfMem (suc (suc (suc (suc (suc (suc (suc y))))))) 0) (sfAll (sfImp (sfMem 0 1) (sfEq 0 (suc (suc (suc (suc (suc (suc (suc (suc y)))))))))))) (sfAnd (sfAnd (sfMem (suc (suc (suc (suc (suc (suc (suc y))))))) 0) (sfMem 1 0)) (sfAll (sfImp (sfMem 0 1) (sfOr (sfEq 0 (suc (suc (suc (suc (suc (suc (suc (suc y))))))))) (sfEq 0 2))))))))) (sfMem 3 0))))))))))))))) $;

theorem sfPieceRepMemberTest_wf(x y e:nat):
 $ sfWf (sfPieceRepMemberTest x y e) $;

theorem sfPieceRepMemberTest_eq(x y e xp yp ep:nat)(h0:$ x = xp $)(h1:$ y = yp $)(h2:$ e = ep $):
 $ sfPieceRepMemberTest x y e = sfPieceRepMemberTest xp yp ep $;

theorem sfPieceRepMemberTest_rename(R:set)(d x y e:nat):
 $ sfRename R d (sfPieceRepMemberTest x y e) = sfPieceRepMemberTest (sfRenameIndex R d x) (sfRenameIndex R d y) (sfRenameIndex R d e) $;

theorem sfPieceRepMemberTest_subst(d t x y e:nat):
 $ sfSubst d t (sfPieceRepMemberTest x y e) = sfPieceRepMemberTest (sfSubstIndex d t x) (sfSubstIndex d t y) (sfSubstIndex d t e) $;

def sfPieceRepEqualTest(x y e:nat):nat = $ (sfEx (sfAnd (sfMem 0 (suc e)) (sfEx (sfAnd (sfMem 0 1) (sfEx (sfAnd (sfMem 0 1) (sfAnd (sfAnd (sfAnd (sfEx (sfAnd (sfMem 0 3) (sfAnd (sfMem (suc (suc (suc (suc x)))) 0) (sfAll (sfImp (sfMem 0 1) (sfEq 0 (suc (suc (suc (suc (suc x))))))))))) (sfEx (sfAnd (sfMem 0 3) (sfAnd (sfAnd (sfMem (suc (suc (suc (suc x)))) 0) (sfMem 1 0)) (sfAll (sfImp (sfMem 0 1) (sfOr (sfEq 0 (suc (suc (suc (suc (suc x)))))) (sfEq 0 2)))))))) (sfAll (sfImp (sfMem 0 3) (sfOr (sfAnd (sfMem (suc (suc (suc (suc x)))) 0) (sfAll (sfImp (sfMem 0 1) (sfEq 0 (suc (suc (suc (suc (suc x))))))))) (sfAnd (sfAnd (sfMem (suc (suc (suc (suc x)))) 0) (sfMem 1 0)) (sfAll (sfImp (sfMem 0 1) (sfOr (sfEq 0 (suc (suc (suc (suc (suc x)))))) (sfEq 0 2))))))))) (sfEx (sfAnd (sfMem 0 (suc (suc (suc (suc e))))) (sfEx (sfAnd (sfMem 0 1) (sfEx (sfAnd (sfMem 0 1) (sfAnd (sfAnd (sfAnd (sfEx (sfAnd (sfMem 0 3) (sfAnd (sfMem (suc (suc (suc (suc (suc (suc (suc y))))))) 0) (sfAll (sfImp (sfMem 0 1) (sfEq 0 (suc (suc (suc (suc (suc (suc (suc (suc y)))))))))))))) (sfEx (sfAnd (sfMem 0 3) (sfAnd (sfAnd (sfMem (suc (suc (suc (suc (suc (suc (suc y))))))) 0) (sfMem 1 0)) (sfAll (sfImp (sfMem 0 1) (sfOr (sfEq 0 (suc (suc (suc (suc (suc (suc (suc (suc y))))))))) (sfEq 0 2)))))))) (sfAll (sfImp (sfMem 0 3) (sfOr (sfAnd (sfMem (suc (suc (suc (suc (suc (suc (suc y))))))) 0) (sfAll (sfImp (sfMem 0 1) (sfEq 0 (suc (suc (suc (suc (suc (suc (suc (suc y)))))))))))) (sfAnd (sfAnd (sfMem (suc (suc (suc (suc (suc (suc (suc y))))))) 0) (sfMem 1 0)) (sfAll (sfImp (sfMem 0 1) (sfOr (sfEq 0 (suc (suc (suc (suc (suc (suc (suc (suc y))))))))) (sfEq 0 2))))))))) (sfEq 3 0))))))))))))))) $;

theorem sfPieceRepEqualTest_wf(x y e:nat):
 $ sfWf (sfPieceRepEqualTest x y e) $;

theorem sfPieceRepEqualTest_eq(x y e xp yp ep:nat)(h0:$ x = xp $)(h1:$ y = yp $)(h2:$ e = ep $):
 $ sfPieceRepEqualTest x y e = sfPieceRepEqualTest xp yp ep $;

theorem sfPieceRepEqualTest_rename(R:set)(d x y e:nat):
 $ sfRename R d (sfPieceRepEqualTest x y e) = sfPieceRepEqualTest (sfRenameIndex R d x) (sfRenameIndex R d y) (sfRenameIndex R d e) $;

theorem sfPieceRepEqualTest_subst(d t x y e:nat):
 $ sfSubst d t (sfPieceRepEqualTest x y e) = sfPieceRepEqualTest (sfSubstIndex d t x) (sfSubstIndex d t y) (sfSubstIndex d t e) $;

def sfPieceRepMemberLookupLaw:nat = $ (sfAll (sfAll (sfAll (sfAll (sfAll (sfImp (sfPieceRepLookup 4 3 1) (sfImp (sfPieceRepLookup 4 2 0) (sfAnd (sfImp (sfPieceRepMemberTest 3 2 4) (sfMem 1 0)) (sfImp (sfMem 1 0) (sfPieceRepMemberTest 3 2 4)))))))))) $;

theorem sfPieceRepMemberLookup_use(G e x y a b:nat):
 $ (nsLocal G sfPieceRepMemberLookupLaw) -> (nsLocal G (sfPieceRepLookup e x a)) -> (nsLocal G (sfPieceRepLookup e y b)) -> (nsLocal G (sfAnd (sfImp (sfPieceRepMemberTest x y e) (sfMem a b)) (sfImp (sfMem a b) (sfPieceRepMemberTest x y e)))) $;

theorem sfPieceEnv_member_test_from_laws(T:set)(G n i j e x y:nat)(hq:$ sfContextSub sfFormulaEqualityContext G $)(hl:$ nsLocal G sfPieceRepLookupLaws $)(ha:$ nsLocal G sfPieceRepMemberLookupLaw $)(hi:$ i < n $)(hj:$ j < n $)(he:$ nsLocal G (sfPieceEnv T n e) $)(hx:$ nsLocal G (sfPieceNumeral (n - 1 - i) x) $)(hy:$ nsLocal G (sfPieceNumeral (n - 1 - j) y) $):
 $ (nsLocal G (sfPieceRepIff (sfPieceRepMemberTest x y e) (sfMem (T @ i) (T @ j)))) $;

def sfPieceRepEqualLookupLaw:nat = $ (sfAll (sfAll (sfAll (sfAll (sfAll (sfImp (sfPieceRepLookup 4 3 1) (sfImp (sfPieceRepLookup 4 2 0) (sfAnd (sfImp (sfPieceRepEqualTest 3 2 4) (sfEq 1 0)) (sfImp (sfEq 1 0) (sfPieceRepEqualTest 3 2 4)))))))))) $;

theorem sfPieceRepEqualLookup_use(G e x y a b:nat):
 $ (nsLocal G sfPieceRepEqualLookupLaw) -> (nsLocal G (sfPieceRepLookup e x a)) -> (nsLocal G (sfPieceRepLookup e y b)) -> (nsLocal G (sfAnd (sfImp (sfPieceRepEqualTest x y e) (sfEq a b)) (sfImp (sfEq a b) (sfPieceRepEqualTest x y e)))) $;

theorem sfPieceEnv_equal_test_from_laws(T:set)(G n i j e x y:nat)(hq:$ sfContextSub sfFormulaEqualityContext G $)(hl:$ nsLocal G sfPieceRepLookupLaws $)(ha:$ nsLocal G sfPieceRepEqualLookupLaw $)(hi:$ i < n $)(hj:$ j < n $)(he:$ nsLocal G (sfPieceEnv T n e) $)(hx:$ nsLocal G (sfPieceNumeral (n - 1 - i) x) $)(hy:$ nsLocal G (sfPieceNumeral (n - 1 - j) y) $):
 $ (nsLocal G (sfPieceRepIff (sfPieceRepEqualTest x y e) (sfEq (T @ i) (T @ j)))) $;
