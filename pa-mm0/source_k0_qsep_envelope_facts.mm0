import "source_k0_qsep_domain_point.mm0";

import "source_k0_qsep_empty.mm0";

def sfK0QSepEnvelopeBody (t a b x: nat): nat = $ (kImp (kImp (kImp (kMem x b) (kImp (kImp (kEq x a) kF) (kImp (kImp (kMem x a) (kImp (kMem t x) kF)) kF))) (kImp (kImp (kImp (kImp (kEq x a) kF) (kImp (kImp (kMem x a) (kImp (kMem t x) kF)) kF)) (kMem x b)) kF)) kF) $;

theorem sfK0QSepEnvelope_substitution (t a b x v: nat) (hx0: $ x != 0 $) (htx: $ t != x $) (hax: $ a != x $) (hbx: $ b != x $):
 $ kSubst (sfK0QSepEnvelopeBody t a b x) x v = sfK0QSepEnvelopeBody t a b v $;

theorem sfK0QSepEnvelope_at (t a b x v: nat) (hx0: $ x != 0 $) (htx: $ t != x $) (hax: $ a != x $) (hbx: $ b != x $) (hxv: $ x != v $):
 $ k218QProvable (kImp (kAll x (sfK0QSepEnvelopeBody t a b x)) (sfK0QSepEnvelopeBody t a b v)) $;

theorem sfK0QSepEnvelope_facts (t a b x y: nat) (hx0: $ x != 0 $) (htx: $ t != x $) (hax: $ a != x $) (hbx: $ b != x $)
 (hy0: $ y != 0 $) (hty: $ t != y $) (hya: $ y != a $):
 $ k218QProvable (kImp (kImp (kImp (kAll y (kImp (kMem y t) kF)) (kImp (kImp (kImp (kMem t a) (kImp (kAll x (kImp (kImp (kImp (kMem x b) (kImp (kImp (kEq x a) kF) (kImp (kImp (kMem x a) (kImp (kMem t x) kF)) kF))) (kImp (kImp (kImp (kImp (kEq x a) kF) (kImp (kImp (kMem x a) (kImp (kMem t x) kF)) kF)) (kMem x b)) kF)) kF)) kF)) kF) kF)) kF) (kImp (kImp (kAll y (kImp (kMem y t) kF)) (kImp (kImp (kImp (kImp (kEq b t) kF) (kImp (kImp (kImp (kImp (kMem t b) kF) (kImp (kAll x (sfK0QSepRawEnvelope t a b x)) kF)) kF) kF)) kF) kF)) kF)) $;
