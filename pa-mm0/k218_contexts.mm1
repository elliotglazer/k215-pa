-- Contextual SeedG logic; every generalization/vacuity premise remains explicit.
import "k218_deduction.mm1";

@_ abstract def k218ContextProofClass (G .a: nat): set = $ {a | k218HypProvable G a} $;
@_ def k218ContextSupports (G H: nat): wff = $ traceClassAll (k218ContextProofClass G) H $;

pub theorem k218ContextProofClass_value (G a: nat):
 $ a e. k218ContextProofClass G <-> k218HypProvable G a $ =
(named '(elabe ,eqtac));

pub theorem k218ContextSupports_member (G H a: nat):
 $ k218ContextSupports G H -> a IN H -> k218HypProvable G a $ =
'(syl6 (bi1 k218ContextProofClass_value) traceClassAll_get);

pub theorem k218ContextSupports_self (G: nat): $ k218ContextSupports G G $ =
(named '(ax_gen @ syl (bi2 k218ContextProofClass_value) k218HypProvable_assumption));

pub theorem k218ContextSupports_nil (G: nat): $ k218ContextSupports G 0 $ =
'traceClassAll_nil;

pub theorem k218ContextSupports_cons (G H a: nat):
 $ k218ContextSupports G H -> k218HypProvable G a -> k218ContextSupports G (a : H) $ =
'(exp @ sylc traceClassAll_cons (syl (bi2 k218ContextProofClass_value) anr) anl);

theorem k218CR_assumption (G H a: nat) (hs: $ k218ContextSupports G H $):
 $ a IN H -> a e. k218ContextProofClass G $ =
'(syl (bi2 k218ContextProofClass_value) (ax_mp k218ContextSupports_member hs));

theorem k218CR_seed (G a: nat):
 $ a e. k218Theorems -> a e. k218ContextProofClass G $ =
'(syl (bi2 k218ContextProofClass_value) @ syl k218HypProvable_seed (bi1 k218Theorems_value));

theorem k218CR_trace_get (G l a: nat):
 $ traceClassAll (k218ContextProofClass G) l -> a IN l -> k218HypProvable G a $ =
'(syl6 (bi1 k218ContextProofClass_value) traceClassAll_get);

theorem k218CR_mp_payload (G l a b: nat):
 $ traceClassAll (k218ContextProofClass G) l ->
   (b IN l /\ kImp b a IN l) -> a e. k218ContextProofClass G $ =
'(exp @ syl (bi2 k218ContextProofClass_value) @
  sylc k218HypProvable_mp
    (mpd (syl anl anr) (syl k218CR_trace_get anl))
    (mpd (syl anr anr) (syl k218CR_trace_get anl)));

theorem k218CR_mp_exists {b: nat} (G l a: nat):
 $ traceClassAll (k218ContextProofClass G) l ->
   E. b (b IN l /\ kImp b a IN l) -> a e. k218ContextProofClass G $ =
(named '(eexd k218CR_mp_payload));

theorem k218CR_rule (G H l a: nat) (hs: $ k218ContextSupports G H $):
 $ traceClassAll (k218ContextProofClass G) l ->
   (a, l) e. k218HypRules H -> a e. k218ContextProofClass G $ =
(named '(syl5bi k218HypRules_value @ eord
  (a1i (k218CR_assumption hs)) (eord (a1i k218CR_seed) k218CR_mp_exists)));

pub theorem k218HypRules_refine_sound (G H: nat) (hs: $ k218ContextSupports G H $):
 $ traceRuleSound (k218HypRules H) (k218ContextProofClass G) $ =
(named '(ax_gen @ ax_gen (k218CR_rule hs)));

pub theorem k218HypDerives_refine (G H p a: nat) (hs: $ k218ContextSupports G H $):
 $ k218HypDerives H p a -> k218HypProvable G a $ =
'(syl (bi1 k218ContextProofClass_value) (ax_mp traceDerives_class (k218HypRules_refine_sound hs)));

pub theorem k218HypProvable_refine (G H a: nat) (hs: $ k218ContextSupports G H $):
 $ k218HypProvable H a -> k218HypProvable G a $ =
(named '(eex (k218HypDerives_refine hs)));

theorem k218CR_assumption_d (G H a: nat):
 $ k218ContextSupports G H -> a IN H -> a e. k218ContextProofClass G $ =
'(syl6 (bi2 k218ContextProofClass_value) k218ContextSupports_member);

theorem k218CR_rule_d (G H l a: nat):
 $ k218ContextSupports G H -> traceClassAll (k218ContextProofClass G) l ->
   (a, l) e. k218HypRules H -> a e. k218ContextProofClass G $ =
(named '(exp @ syl5bi k218HypRules_value @ eord
  (syl k218CR_assumption_d anl)
  (eord (a1i k218CR_seed) (syl k218CR_mp_exists anr))));

theorem k218CR_sound_d (G H: nat):
 $ k218ContextSupports G H -> traceRuleSound (k218HypRules H) (k218ContextProofClass G) $ =
(named '(iald @ iald k218CR_rule_d));

theorem k218CR_derives_d (G H p a: nat):
 $ k218ContextSupports G H -> k218HypDerives H p a -> k218HypProvable G a $ =
'(syl6 (bi1 k218ContextProofClass_value) (syl traceDerives_class k218CR_sound_d));

pub theorem k218HypProvable_refine_d (G H a: nat):
 $ k218ContextSupports G H -> k218HypProvable H a -> k218HypProvable G a $ =
(named '(eexd k218CR_derives_d));

theorem k218ContextIncludes_at {c: nat} (G H a: nat):
 $ A. c (c IN H -> c IN G) -> a IN H -> a IN G $ =
(named '(!! eale c ,eqtac));

pub theorem k218ContextSupports_inclusion {c: nat} (G H: nat)
 (hi: $ A. c (c IN H -> c IN G) $):
 $ k218ContextSupports G H $ =
(named '(ax_gen @ syl (bi2 k218ContextProofClass_value) @
  syl k218HypProvable_assumption (ax_mp k218ContextIncludes_at hi)));

pub theorem k218HypProvable_monotone {c: nat} (G H a: nat)
 (hi: $ A. c (c IN H -> c IN G) $):
 $ k218HypProvable H a -> k218HypProvable G a $ =
'(k218HypProvable_refine (k218ContextSupports_inclusion hi));
