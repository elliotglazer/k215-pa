import "source_k0_qsep_matrix_alignment.mm0";

import "k218q_source_core_at.mm0";

import "k218q_named_quantifiers.mm0";

def sfK0QSepKp0UseBody (f: nat): nat = $ (sfEx (sfAnd (sfAll (sfImp (sfOr (sfEq 0 2) (sfEx (sfAnd (sfMem 0 2) (sfAll (sfImp (sfMem 0 2) (sfMem 0 1)))))) (sfImp (sfEx (sfRename sfK218KpRequestMap 0 f)) (sfEx (sfAnd (sfMem 0 2) (sfRename sfK218KpRequestMap 0 f)))))) (sfAll (sfImp (sfMem 0 1) (sfEx (sfRename sfK218SupportMap 0 f)))))) $;

theorem sfK0QSepKp0UseBody_bound (n f: nat) (hf: $ sfBound (suc (suc n)) f $):
 $ sfBound (suc n) (sfK0QSepKp0UseBody f) $;

theorem sfK0QSep_all_specialization (E: set) (n k y a: nat) (hz: $ k != 0 $) (hy: $ y < k $) (he: $ sqEnvAvoid E n k $)
 (ha: $ sfBound (suc n) a $):
 $ k218QProvable (kImp (sfNamedTemplate E k 0 (sfAll a)) (sfNamedTemplate (sqEnvCons y E) (suc k) 0 a)) $;

theorem sfK0QSepKp0_use {i j: nat} (E: set) (n B k y f: nat)
 (hB: $ 3 < B $) (he1: $ sqEnvAvoid E n 1 $) (he3: $ sqEnvAvoid E n 3 $)
 (he: $ A. j (j < n -> E @ j < B) $) (hk: $ B <= k $)
 (hz: $ k != 0 $) (hy: $ y < k $) (hek: $ sqEnvAvoid E n k $)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218QProvable (sfNamedTemplate (sqEnvCons y E) (suc k) 0 (sfK0QSepKp0UseBody f)) $;

def sfK0QSepTaggedWitness (E: set) (a r t b k theta: nat): nat = $ (kExists (suc k) (kAnd (kAll (suc (suc k)) (kImp (kDisj (kEq (suc (suc k)) a) (kExists (suc (suc (suc k))) (kAnd (kMem (suc (suc (suc k))) (suc k)) (kAll (suc (suc (suc (suc k)))) (kImp (kMem (suc (suc (suc (suc k)))) (suc (suc k))) (kMem (suc (suc (suc (suc k)))) (suc (suc (suc k))))))))) (kImp (kExists (suc (suc (suc k))) (sfK0QSepNamedTagged E r t b (suc (suc k)) (suc (suc (suc k))) (suc (suc (suc (suc k)))) theta)) (kExists (suc (suc (suc k))) (kAnd (kMem (suc (suc (suc k))) (suc k)) (sfK0QSepNamedTagged E r t b (suc (suc k)) (suc (suc (suc k))) (suc (suc (suc (suc k)))) theta)))))) (kAll (suc (suc k)) (kImp (kMem (suc (suc k)) (suc k)) (kExists (suc (suc (suc k))) (sfK0QSepNamedTagged E r t b (suc (suc (suc k))) (suc (suc k)) (suc (suc (suc (suc k)))) theta)))))) $;

theorem sfK0QSepTaggedWitness_source (E: set) (n a r t b k theta: nat) (hf: $ sfBound (suc n) theta $):
 $ sfNamedTemplate (sqEnvCons a (sqEnvCons b (sqEnvCons t (sqEnvCons r E)))) (suc k) 0 (sfK0QSepKp0UseBody (sfK0QSepTagged theta)) = sfK0QSepTaggedWitness E a r t b k theta $;

theorem sfK0QSepTaggedWitness_proved {i j: nat} (E: set) (n B a r t b k theta: nat)
 (hB: $ 3 < B $)
 (he1: $ sqEnvAvoid (sqEnvCons b (sqEnvCons t (sqEnvCons r E))) (suc (suc (suc n))) 1 $)
 (he3: $ sqEnvAvoid (sqEnvCons b (sqEnvCons t (sqEnvCons r E))) (suc (suc (suc n))) 3 $)
 (he: $ A. j (j < suc (suc (suc n)) -> (sqEnvCons b (sqEnvCons t (sqEnvCons r E))) @ j < B) $)
 (hk: $ B <= k $) (hz: $ k != 0 $) (ha: $ a < k $)
 (hek: $ sqEnvAvoid (sqEnvCons b (sqEnvCons t (sqEnvCons r E))) (suc (suc (suc n))) k $)
 (hf: $ sfBound (suc n) theta $):
 $ k218QProvable (sfK0QSepTaggedWitness E a r t b k theta) $;
