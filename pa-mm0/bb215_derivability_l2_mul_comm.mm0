import "bb215_derivability_l2_mul_succ.mm0";

-- L05, layer L2 (lanes/L05.md): commutativity of * inside PA, with level-n instances of
-- 0 * x = 0 and S x * y = x * y + y. Generated by build_bb215_derivability_l2_add_basic.py.

theorem bb215L2_mul_zero_left_inst (n t: nat) (ht: $ paTermBound n t $):
  $ paProvable n (paFormulaEqual (paTermMultiplication paTermZero t) paTermZero) $;

theorem bb215L2_mul_succ_left_inst (n s t: nat) (hs: $ paTermBound n s $) (ht: $ paTermBound n t $):
  $ paProvable n (paFormulaEqual (paTermMultiplication (paTermSuccessor s) t) (paTermAddition (paTermMultiplication s t) t)) $;

-- PA |- A. y A. x (x * y = y * x)

theorem bb215L2_mul_comm:
  $ paProvable 0 (paFormulaAll (paFormulaAll (paFormulaEqual (paTermMultiplication (paTermVariable 0) (paTermVariable 1)) (paTermMultiplication (paTermVariable 1) (paTermVariable 0))))) $;
