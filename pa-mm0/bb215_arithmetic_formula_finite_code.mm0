import "bb215_arithmetic_formula_pair.mm0";

def bb215ArithmeticFormulaFiniteCell (m v k .x: nat): wff = $ 0 < m /\ 0 < v /\ A. x (0 < x /\ x <= k -> x || m) /\ suc (m * suc k) || v $;

theorem bb215ArithmeticFormulaFiniteCode_exists (E: set) (n: nat) {a i y: nat}: $ E. a A. i A. y (bb215ArithmeticFormulaFiniteCell (fst a) (snd a) (i, y) <-> i < n /\ y = E @ i) $;
