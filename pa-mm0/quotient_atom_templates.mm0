theorem sqMemberSource_bound: $ sfBound 3 sqMemberSource $;

theorem sqMemberSource_wf: $ sfWf sqMemberSource $;

theorem sqAtomEnvironment_0 (t x y: nat): $ sqAtomEnvironment t x y @ 0 = t $;

theorem sqAtomEnvironment_1 (t x y: nat): $ sqAtomEnvironment t x y @ 1 = x $;

theorem sqAtomEnvironment_2 (t x y: nat): $ sqAtomEnvironment t x y @ 2 = y $;

theorem sqEqual_positive (t x y k: nat): $ 0 < sqEqual t x y k $;

theorem sqMember_positive (t x y k: nat): $ 0 < sqMember t x y k $;
