def sqAtomEnvironment (t x y .i: nat): set = $ \ i, if (i = 0) t (if (i = 1) x y) $;

def sqEqual (t x y k: nat): nat = $ sfNamedTemplate (sqAtomEnvironment t x y) k 0 sqEqualSource $;

