import "k218q_parameter_close.mm0";

theorem k218QClosedSeededCore {i j: nat} (n f: nat)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218QProvable (sfNamedTemplate (sqNumericEnvironment 0) 4 0
     (sfAllPrefix n (sfK218SeededCore f))) $;

theorem k218QClosedKp0 {i j: nat} (n f: nat)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218QProvable (sfNamedTemplate (sqNumericEnvironment 0) 4 0
     (sfAllPrefix n (sfK218Kp0 f))) $;
