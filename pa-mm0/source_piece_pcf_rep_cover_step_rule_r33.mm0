import "source_piece_pcf_rep_prefix_lift_r32.mm0";

theorem sfPieceRepEnvironmentCoverStep_shift(A X Y:nat): $ sfShift 0 (sfPieceRepEnvironmentCoverStep A X Y) = sfPieceRepEnvironmentCoverStep (suc A) (suc X) (suc Y) $;

theorem sfPieceRepEnvironmentCoverStep_use(G A X Y e v z:nat): $ nsLocal G (sfPieceRepEnvironmentCoverStep A X Y) -> nsLocal G (sfMem e X) -> nsLocal G (sfMem v A) -> nsLocal G (sfPieceRepExtension e v z) -> nsLocal G (sfMem z Y) $;

theorem sfPieceRepEnvironmentCoverStep_canonical_bound: $ sfBound 3 (sfPieceRepEnvironmentCoverStep 1 0 2) $;

theorem sfPieceRepEnvironmentCoverStep_prefix_lift(G n:nat)(hs:$ nsLocal G (sfPieceRepEnvironmentCoverStep 1 0 2) $): $ nsLocal G (sfPieceRepDn3Core n (sfPieceRepEnvironmentCoverStep 1 0 2)) $;
