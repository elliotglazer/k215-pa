@_ def pcrvGoodAt3(T:set)(n G r h .i .e .x .w:nat):wff = $ A. i A. e A. x A. w (sfContextSub sfFormulaEqualityContext G -> (nsLocal G sfPieceRepLookupLaws) -> i < n -> (nsLocal G (sfPieceEnv (sfPieceRepOffset T r h) n e)) -> (nsLocal G (sfPieceNumeral (n - 1 - i) x)) -> (nsLocal G (sfPieceRepLookupResult e x w (h + (T @ (r + i)))))) $;

theorem pcrv_good_part3(T:set)(n G r h:nat):
 $ pcrvGoodAt2 T n G r -> pcrvGoodAt3 T n G r h $ =
