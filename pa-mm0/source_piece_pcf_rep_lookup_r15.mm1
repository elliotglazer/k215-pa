@_ def pcrvGoodAt2(T:set)(n G r .h .i .e .x .w:nat):wff = $ A. h A. i A. e A. x A. w (sfContextSub sfFormulaEqualityContext G -> (nsLocal G sfPieceRepLookupLaws) -> i < n -> (nsLocal G (sfPieceEnv (sfPieceRepOffset T r h) n e)) -> (nsLocal G (sfPieceNumeral (n - 1 - i) x)) -> (nsLocal G (sfPieceRepLookupResult e x w (h + (T @ (r + i)))))) $;

theorem pcrv_good_part2(T:set)(n G r:nat):
 $ pcrvGoodAt1 T n G -> pcrvGoodAt2 T n G r $ =
