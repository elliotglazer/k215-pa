import "k215_calculus_source_ax_stack_loops.mm1";
import "k215_literal_runtime_reach.mm1";
import "k215_calculus_source_pairing.mm1";
import "k215_calculus_source_ax_stack_lookups.mm1";

@_ def k215UnpairAt613State (pc a b n c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) n (k215PR3 c) (k215PR4 c) (k215PR5 c) a b (k215PR8 c)) $;

do (apply (register-eqd 'k215UnpairAt613State) '(k215UnpairAt613Stateeqd));

theorem k215UnpairAt613Transfer (b n c: nat): $ k215PIter (3 * b + 1) (k215UnpairAt613State k215PNum617 0 b n c) = (k215UnpairAt613State k215PNum620 b 0 n c) $ =
 '(eqtr k215Loop617Vector (k215PStateeq2 (k215PVectoreq7 add0)));
theorem k215UnpairAt613ReachTransfer (b n c: nat): $ k215PReach (k215UnpairAt613State k215PNum617 0 b n c) (k215UnpairAt613State k215PNum620 b 0 n c) $ =
 '(k215PReach_intro k215UnpairAt613Transfer);


theorem k215UnpairAt613Step9Z (a b c: nat): $ k215PStep (k215UnpairAt613State k215PNum613 a b 0 c) = (k215UnpairAt613State k215PNum621 a b 0 c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair613_613) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt613Reach9Z (a b c: nat): $ k215PReach (k215UnpairAt613State k215PNum613 a b 0 c) (k215UnpairAt613State k215PNum621 a b 0 c) $ = '(k215PReach_step k215UnpairAt613Step9Z);

theorem k215UnpairAt613Step9S (a b n c: nat): $ k215PStep (k215UnpairAt613State k215PNum613 a b (suc n) c) = (k215UnpairAt613State k215PNum614 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair613_613) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet2_vector)) (eqtr k215PSet2_vector (k215PVectoreq3 (eqtr subSS sub02))))));

theorem k215UnpairAt613Reach9S (a b n c: nat): $ k215PReach (k215UnpairAt613State k215PNum613 a b (suc n) c) (k215UnpairAt613State k215PNum614 a b n c) $ = '(k215PReach_step k215UnpairAt613Step9S);

theorem k215UnpairAt613Step10 (a b n c: nat): $ k215PStep (k215UnpairAt613State k215PNum614 a b n c) = (k215UnpairAt613State k215PNum615 a (suc b) n c) $ = '(eqtr (k215PAtCI k215PLookupUnpair613_614) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215UnpairAt613Reach10 (a b n c: nat): $ k215PReach (k215UnpairAt613State k215PNum614 a b n c) (k215UnpairAt613State k215PNum615 a (suc b) n c) $ = '(k215PReach_step k215UnpairAt613Step10);

theorem k215UnpairAt613Step11Z (b n c: nat): $ k215PStep (k215UnpairAt613State k215PNum615 0 b n c) = (k215UnpairAt613State k215PNum617 0 b n c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair613_615) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt613Reach11Z (b n c: nat): $ k215PReach (k215UnpairAt613State k215PNum615 0 b n c) (k215UnpairAt613State k215PNum617 0 b n c) $ = '(k215PReach_step k215UnpairAt613Step11Z);

theorem k215UnpairAt613Step11S (a b n c: nat): $ k215PStep (k215UnpairAt613State k215PNum615 (suc a) b n c) = (k215UnpairAt613State k215PNum616 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair613_615) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215UnpairAt613Reach11S (a b n c: nat): $ k215PReach (k215UnpairAt613State k215PNum615 (suc a) b n c) (k215UnpairAt613State k215PNum616 a b n c) $ = '(k215PReach_step k215UnpairAt613Step11S);

theorem k215UnpairAt613Step12 (a b n c: nat): $ k215PStep (k215UnpairAt613State k215PNum616 a b n c) = (k215UnpairAt613State k215PNum620 a b n c) $ = '(k215PAtCB k215PLookupUnpair613_616);

theorem k215UnpairAt613Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt613State k215PNum616 a b n c) (k215UnpairAt613State k215PNum620 a b n c) $ = '(k215PReach_step k215UnpairAt613Step12);

theorem k215UnpairAt613Step16 (a b n c: nat): $ k215PStep (k215UnpairAt613State k215PNum620 a b n c) = (k215UnpairAt613State k215PNum613 a b n c) $ = '(k215PAtCC k215PLookupUnpair613_620);

theorem k215UnpairAt613Reach16 (a b n c: nat): $ k215PReach (k215UnpairAt613State k215PNum620 a b n c) (k215UnpairAt613State k215PNum613 a b n c) $ = '(k215PReach_step k215UnpairAt613Step16);

theorem k215UnpairAt613CycleZero (b n c: nat): $ k215PReach (k215UnpairAt613State k215PNum613 0 b (suc n) c) (k215UnpairAt613State k215PNum613 (suc b) 0 n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt613Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt613Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt613Reach11Z) (ax_mp (ax_mp k215PReach_trans k215UnpairAt613ReachTransfer) k215UnpairAt613Reach16))));
theorem k215UnpairAt613CycleSucc (a b n c: nat): $ k215PReach (k215UnpairAt613State k215PNum613 (suc a) b (suc n) c) (k215UnpairAt613State k215PNum613 a (suc b) n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt613Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt613Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt613Reach11S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt613Reach12) k215UnpairAt613Reach16))));


theorem k215UnpairAt613AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt613State k215PNum613 0 b (suc n) c) (k215UnpairAt613State k215PNum613 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt613Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215PairDiagonal_rotate)) (eqtr (eqcom sndpr) (sndeq k215PairDiagonal_rotate)) eqid eqid)) k215UnpairAt613CycleZero);

theorem k215UnpairAt613AdvanceSucc (a b n c: nat): $ k215PReach (k215UnpairAt613State k215PNum613 (suc a) b (suc n) c) (k215UnpairAt613State k215PNum613 (fst (suc ((suc a), b))) (snd (suc ((suc a), b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt613Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215Pair_next)) (eqtr (eqcom sndpr) (sndeq k215Pair_next)) eqid eqid)) k215UnpairAt613CycleSucc);

pub theorem k215UnpairAt613Advance (a b n c: nat): $ k215PReach (k215UnpairAt613State k215PNum613 a b (suc n) c) (k215UnpairAt613State k215PNum613 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
 (named @ induct '(ind) 'a 'k215UnpairAt613AdvanceZero '(a1i k215UnpairAt613AdvanceSucc));
@_ abstract def k215UnpairAt613Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt613State k215PNum613 a b n c) (k215UnpairAt613State k215PNum621 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
theorem k215UnpairAt613RunZero (a b c: nat): $ k215UnpairAt613Run 0 a b c $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt613Stateeq eqid
     (eqcom (eqtr (fsteq add0) fstpr))
     (eqcom (eqtr (sndeq add0) sndpr)) eqid eqid)) k215UnpairAt613Reach9Z);
@_ abstract def k215UnpairAt613Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt613Run n a b c $;
theorem k215UnpairAt613Claim_at (n a b c: nat): $ k215UnpairAt613Claim n c -> k215UnpairAt613Run n a b c $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215UnpairAt613CodeStep (a b n: nat): $ (fst (suc (a, b)), snd (suc (a, b))) + n = (a, b) + suc n $ =
 '(eqtr (addeq1 fstsnd) addSass);
theorem k215UnpairAt613RunInductive (n a b c: nat): $ k215UnpairAt613Claim n c -> k215UnpairAt613Run (suc n) a b c $ =
 '(syl (ax_mp k215PReach_trans k215UnpairAt613Advance)
   (mpbid (a1i (k215PReacheq2 (k215UnpairAt613Stateeq eqid
     (fsteq k215UnpairAt613CodeStep) (sndeq k215UnpairAt613CodeStep) eqid eqid))) k215UnpairAt613Claim_at));
theorem k215UnpairAt613Claim_all (n c: nat): $ k215UnpairAt613Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt613RunZero)) '(iald @ iald k215UnpairAt613RunInductive));
pub theorem k215UnpairMacro613 (n a b c: nat): $ k215PReach (k215UnpairAt613State k215PNum613 a b n c) (k215UnpairAt613State k215PNum621 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
 '(ax_mp k215UnpairAt613Claim_at k215UnpairAt613Claim_all);
pub theorem k215UnpairMacro613_clean (n c: nat): $ k215PReach (k215UnpairAt613State k215PNum613 0 0 n c) (k215UnpairAt613State k215PNum621 (fst n) (snd n) 0 c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt613Stateeq eqid
   (fsteq (eqtr (addeq1 pr0) add01))
   (sndeq (eqtr (addeq1 pr0) add01)) eqid eqid)) k215UnpairMacro613);


