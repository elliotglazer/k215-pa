import "k215_calculus_source_decode_loops.mm0";
import "k215_calculus_source_ax_gate_lookups.mm0";

def k215Loop4556State (pc x y z c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) (k215PR2 c) x (k215PR4 c) (k215PR5 c) z y (k215PR8 c)) $;

def k215Loop4556Claim (x c: nat) (.y .z: nat): wff =
 $ A. y A. z k215PIter (4 * x + 1) (k215Loop4556State k215PNum4556 x y z c) = (k215Loop4556State k215PNum4560 0 (x + y) (x + z) c) $;

theorem k215Loop4556Transfer (x y z c: nat): $ k215PIter (4 * x + 1) (k215Loop4556State k215PNum4556 x y z c) = (k215Loop4556State k215PNum4560 0 (x + y) (x + z) c) $;

theorem k215Loop4556Vector (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ k215PIter (4 * a3 + 1) (k215PState k215PNum4556 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) =
   k215PState k215PNum4560 (k215PVector a0 a1 a2 0 a4 a5 (a3 + a6) (a3 + a7) a8) $;

def k215Loop4572State (pc x y z c: nat): nat = $ k215PState pc (k215PVector z (k215PR1 c) (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) y x (k215PR8 c)) $;

def k215Loop4572Claim (x c: nat) (.y .z: nat): wff =
 $ A. y A. z k215PIter (3 * x + 1) (k215Loop4572State k215PNum4572 x y z c) = (k215Loop4572State k215PNum4575 0 (x + y) z c) $;

theorem k215Loop4572Transfer (x y z c: nat): $ k215PIter (3 * x + 1) (k215Loop4572State k215PNum4572 x y z c) = (k215Loop4572State k215PNum4575 0 (x + y) z c) $;

theorem k215Loop4572Vector (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ k215PIter (3 * a7 + 1) (k215PState k215PNum4572 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) =
   k215PState k215PNum4575 (k215PVector a0 a1 a2 a3 a4 a5 (a7 + a6) 0 a8) $;

def k215Loop4575State (pc x y z c: nat): nat = $ k215PState pc (k215PVector z (k215PR1 c) (k215PR2 c) (k215PR3 c) x y (k215PR6 c) (k215PR7 c) (k215PR8 c)) $;

def k215Loop4575Claim (x c: nat) (.y .z: nat): wff =
 $ A. y A. z k215PIter (3 * x + 1) (k215Loop4575State k215PNum4575 x y z c) = (k215Loop4575State k215PNum4578 0 (x + y) z c) $;

theorem k215Loop4575Transfer (x y z c: nat): $ k215PIter (3 * x + 1) (k215Loop4575State k215PNum4575 x y z c) = (k215Loop4575State k215PNum4578 0 (x + y) z c) $;

theorem k215Loop4575Vector (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ k215PIter (3 * a4 + 1) (k215PState k215PNum4575 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) =
   k215PState k215PNum4578 (k215PVector a0 a1 a2 a3 0 (a4 + a5) a6 a7 a8) $;
