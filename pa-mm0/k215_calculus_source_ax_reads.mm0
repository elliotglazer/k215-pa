import "k215_calculus_source_ax_unpair159.mm0";
import "k215_calculus_source_ax_unpair200.mm0";

theorem k215AXRead159 (u t w c d h fields: nat): $ k215PReach (k215PState k215Num159 (k215PVector u t w c d h 0 0 fields)) (k215PState k215Num173 (k215PVector u t w c d (h + fst fields) 0 0 (snd fields))) $;

theorem k215AXRead200 (u t w c d h fields: nat): $ k215PReach (k215PState k215Num200 (k215PVector u t w c d h 0 0 fields)) (k215PState k215Num214 (k215PVector u t w c (d + fst fields) h 0 0 (snd fields))) $;
