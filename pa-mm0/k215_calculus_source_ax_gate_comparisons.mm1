pub theorem k215PEq4560ClearX (x z: nat): $ k215PIter (2 * x + 3) (k215PEq4560State 5 x 0 z) = (k215PEq4560State k215CalEqN11 0 0 z) $ =
 (named @ induct '(ind) 'x
  '(eqtr (k215PItereq1 (eqtr (addeq1 mul0) add01)) k215PEq4560CleanXBaseS3)
  '(eqtrd (a1i (k215PItereq1 k215EqTime_succ))
    (eqtrd (a1i k215PIter_add)
      (eqtrd (a1i (k215PItereq2 k215PEq4560CleanXCycleS2)) id))));

