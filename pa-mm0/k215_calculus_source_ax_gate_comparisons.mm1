pub theorem k215PEq4560GreaterX (x y z: nat): $ k215PIter (3 * y + (3 + (2 * x + 3))) (k215PEq4560State 0 (suc x + y) y z) = (k215PEq4560State k215CalEqN11 0 0 z) $ =
 (named @ induct '(ind) 'y
  '(eqtr (k215PItereq (eqtr (addeq1 mul0) add01) (k215PEq4560Stateeq2 add0)) (eqtr k215PIter_add (eqtr (k215PItereq2 k215PEq4560StartXS3) k215PEq4560ClearX)))
  '(eqtrd (a1i (eqtr (k215PItereq k215EqTime_succ (k215PEq4560Stateeq2 addS)) (eqtr k215PIter_add (k215PItereq2 k215PEq4560PairS3)))) id));

