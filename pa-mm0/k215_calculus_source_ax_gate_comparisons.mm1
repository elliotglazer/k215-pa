  '(eqtrd (a1i (eqtr (k215PItereq k215EqTime_succ (k215PEq4578Stateeq3 addS)) (eqtr k215PIter_add (k215PItereq2 k215PEq4578PairS3)))) id));

@_ abstract def k215PEq4578Done (a b z out: nat) (.n: nat): wff =
 $ E. n k215PIter n (k215PEq4578State 0 a b z) = k215PEq4578State out 0 0 z $;
do (apply (register-eqd 'k215PEq4578Done) '(k215PEq4578Doneeqd));
theorem k215PEq4578Done_intro (a b z out n: nat): $ k215PIter n (k215PEq4578State 0 a b z) = k215PEq4578State out 0 0 z -> k215PEq4578Done a b z out $ =
 (named '(iexe ,eqtac));
theorem k215PEq4578Done_equal (a b z: nat): $ a = b -> k215PEq4578Done a b z k215CalEqN10 $ =
 '(mpbii (ax_mp k215PEq4578Done_intro k215PEq4578Equal) (k215PEq4578Doneeq2d id));
theorem k215PEq4578Done_greaterX (a b z: nat): $ b < a -> k215PEq4578Done a b z k215CalEqN11 $ =
 '(mpbii (ax_mp k215PEq4578Done_intro k215PEq4578GreaterX) (k215PEq4578Doneeq1d k215EqPositiveDifference));
theorem k215PEq4578Done_greaterY (a b z: nat): $ a < b -> k215PEq4578Done a b z k215CalEqN11 $ =
 '(mpbii (ax_mp k215PEq4578Done_intro k215PEq4578GreaterY) (k215PEq4578Doneeq2d k215EqPositiveDifference));
theorem k215PEq4578Done_different (a b z: nat): $ a != b -> k215PEq4578Done a b z k215CalEqN11 $ =
 '(syl (eor k215PEq4578Done_greaterY k215PEq4578Done_greaterX) (bi1 neltlt));
pub theorem k215PEq4578Done_all (a b z: nat): $ k215PEq4578Done a b z (if (a = b) k215CalEqN10 k215CalEqN11) $ =
 '(cases (mpbid (k215PEq4578Doneeq4d (eqcomd ifpos)) k215PEq4578Done_equal)
         (mpbid (k215PEq4578Doneeq4d (eqcomd ifneg)) k215PEq4578Done_different));


