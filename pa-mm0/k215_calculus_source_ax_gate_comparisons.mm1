@_ def k215PEq4560Location (pc: nat): nat = $ if (pc = 0) k215PNum4560 (if (pc = 1) k215PNum4561 (if (pc = 2) k215PNum4562 (if (pc = 3) k215PNum4563 (if (pc = 4) k215PNum4564 (if (pc = 5) k215PNum4565 (if (pc = 6) k215PNum4566 (if (pc = 7) k215PNum4567 (if (pc = 8) k215PNum4568 (if (pc = 9) k215PNum4569 (if (pc = k215CalEqN10) k215PNum4570 (k215PNum4572))))))))))) $;

@_ def k215PEq4560State (pc x y z: nat): nat = $ k215PState (k215PEq4560Location pc) (k215PVector (k215PR0 z) (k215PR1 z) (k215PR2 z) (k215PR3 z) (k215PR4 z) x y (k215PR7 z) (k215PR8 z)) $;

do (apply (register-eqd 'k215PEq4560State) '(k215PEq4560Stateeqd));

