  '(eqtr (k215PItereq (eqtr (addeq1 mul0) add01) (k215PEq4578Stateeq2 add0)) (eqtr k215PIter_add (eqtr (k215PItereq2 k215PEq4578StartXS3) k215PEq4578ClearX)))
  '(eqtrd (a1i (eqtr (k215PItereq k215EqTime_succ (k215PEq4578Stateeq2 addS)) (eqtr k215PIter_add (k215PItereq2 k215PEq4578PairS3)))) id));

