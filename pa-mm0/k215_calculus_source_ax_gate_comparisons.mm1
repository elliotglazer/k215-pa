      (eqtrd (a1i (k215PItereq2 k215PEq4560CleanYCycleS3)) id))));

pub theorem k215PEq4560Equal (x z: nat): $ k215PIter (3 * x + 2) (k215PEq4560State 0 x x z) = (k215PEq4560State k215CalEqN10 0 0 z) $ =
 (named @ induct '(ind) 'x
  '(eqtr (k215PItereq1 (eqtr (addeq1 mul0) add01)) k215PEq4560EqualBaseS2)
  '(eqtrd (a1i (k215PItereq1 k215EqTime_succ))
    (eqtrd (a1i k215PIter_add)
