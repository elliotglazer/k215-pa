theorem k215Loop4572Step1 (x y z c: nat): $ k215PStep (k215Loop4572State k215PNum4573 x y z c) = (k215Loop4572State k215PNum4574 x (suc y) z c) $ = '(eqtr (k215PAtCI k215PLookupExtraLoopsaxgate_4573) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet6_vector)) k215PSet6_vector)));

theorem k215Loop4572Back (x y z c: nat): $ k215PStep (k215Loop4572State k215PNum4574 x y z c) = (k215Loop4572State k215PNum4572 x y z c) $ = '(k215PAtCC k215PLookupExtraLoopsaxgate_4574);

theorem k215Loop4572Cycle1 (x y z c: nat): $ k215PIter 1 (k215Loop4572State k215PNum4572 (suc x) y z c) = (k215Loop4572State k215PNum4573 x y z c) $ = '(eqtr k215PIter_succ (eqtr (k215PStepeq k215PIter_zero) k215Loop4572StepS));

theorem k215Loop4572Cycle2 (x y z c: nat): $ k215PIter 2 (k215Loop4572State k215PNum4572 (suc x) y z c) = (k215Loop4572State k215PNum4574 x (suc y) z c) $ = '(eqtr k215PIter_succ (eqtr (k215PStepeq k215Loop4572Cycle1) k215Loop4572Step1));

theorem k215Loop4572Cycle3 (x y z c: nat): $ k215PIter 3 (k215Loop4572State k215PNum4572 (suc x) y z c) = (k215Loop4572State k215PNum4572 x (suc y) z c) $ = '(eqtr k215PIter_succ (eqtr (k215PStepeq k215Loop4572Cycle2) k215Loop4572Back));

@_ abstract def k215Loop4572Claim (x c: nat) (.y .z: nat): wff =
 $ A. y A. z k215PIter (3 * x + 1) (k215Loop4572State k215PNum4572 x y z c) = (k215Loop4572State k215PNum4575 0 (x + y) z c) $;
theorem k215Loop4572At (x y z c: nat): $ k215Loop4572Claim x c -> k215PIter (3 * x + 1) (k215Loop4572State k215PNum4572 x y z c) = (k215Loop4572State k215PNum4575 0 (x + y) z c) $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215Loop4572Base (y z c: nat): $ k215PIter (3 * 0 + 1) (k215Loop4572State k215PNum4572 0 y z c) = (k215Loop4572State k215PNum4575 0 (0 + y) z c) $ =
 '(eqtr (k215PItereq1 (eqtr (addeq1 mul0) add01))
   (eqtr k215PIter_succ (eqtr (k215PStepeq k215PIter_zero)
     (eqtr k215Loop4572StepZ (k215Loop4572Stateeq eqid eqid (eqcom add01) eqid eqid)))));
theorem k215Loop4572Inductive (x y z c: nat): $ k215Loop4572Claim x c -> k215PIter (3 * suc x + 1) (k215Loop4572State k215PNum4572 (suc x) y z c) = (k215Loop4572State k215PNum4575 0 (suc x + y) z c) $ =
 '(eqtrd (a1i (eqtr (k215PItereq1 k215EqTime_succ)
     (eqtr k215PIter_add (k215PItereq2 k215Loop4572Cycle3))))
   (eqtrd k215Loop4572At (a1i (k215Loop4572Stateeq eqid eqid (eqtr addS (eqcom addS1)) eqid eqid))));
theorem k215Loop4572All (x c: nat): $ k215Loop4572Claim x c $ =
 (named @ induct '(ind) 'x '(ax_gen (ax_gen k215Loop4572Base)) '(iald @ iald k215Loop4572Inductive));
pub theorem k215Loop4572Transfer (x y z c: nat): $ k215PIter (3 * x + 1) (k215Loop4572State k215PNum4572 x y z c) = (k215Loop4572State k215PNum4575 0 (x + y) z c) $ =
 '(ax_mp k215Loop4572At k215Loop4572All);


theorem k215Loop4572VectorIn (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215Loop4572State k215PNum4572 a7 a6 a0 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = k215PState k215PNum4572 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8) $ = '(k215PStateeq2 (k215PVectoreq eqid k215PR1_vector k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215Loop4572VectorOut (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215Loop4572State k215PNum4575 0 (a7 + a6) a0 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = k215PState k215PNum4575 (k215PVector a0 a1 a2 a3 a4 a5 (a7 + a6) 0 a8) $ = '(k215PStateeq2 (k215PVectoreq eqid k215PR1_vector k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

pub theorem k215Loop4572Vector (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ k215PIter (3 * a7 + 1) (k215PState k215PNum4572 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) =
   k215PState k215PNum4575 (k215PVector a0 a1 a2 a3 a4 a5 (a7 + a6) 0 a8) $ =
 '(eqtr (k215PItereq2 (eqcom k215Loop4572VectorIn)) (eqtr k215Loop4572Transfer k215Loop4572VectorOut));

