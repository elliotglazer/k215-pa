import "k215_calculus_source_decode_loops.mm1";
import "k215_calculus_source_ax_gate_lookups.mm1";

theorem k215AXGateLoopFourAdd (y: nat): $ 4 + y = suc (suc (suc (suc y))) $ = '(eqtr addS1 (suceq (eqtr addS1 (suceq (eqtr addS1 (suceq (eqtr addS1 (suceq add01))))))));

theorem k215AXGateLoopFourShift (x y: nat): $ 4 * x + suc (suc (suc (suc y))) = 4 * suc x + y $ =
 '(eqtr (addeq2 (eqcom k215AXGateLoopFourAdd))
   (eqtr (eqcom addass) (addeq1 (eqcom mulS))));


@_ def k215Loop4556State (pc x y z c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) (k215PR2 c) x (k215PR4 c) (k215PR5 c) z y (k215PR8 c)) $;

do (apply (register-eqd 'k215Loop4556State) '(k215Loop4556Stateeqd));

theorem k215Loop4556StepZ (y z c: nat): $ k215PStep (k215Loop4556State k215PNum4556 0 y z c) = (k215Loop4556State k215PNum4560 0 y z c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupExtraLoopsaxgate_4556) (ifeq (eqeq1 k215PGet3_vector) eqid eqid)) (ifpos eqid));

theorem k215Loop4556StepS (x y z c: nat): $ k215PStep (k215Loop4556State k215PNum4556 (suc x) y z c) = (k215Loop4556State k215PNum4557 x y z c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupExtraLoopsaxgate_4556) (ifeq (eqeq1 k215PGet3_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet3_vector)) (eqtr k215PSet3_vector (k215PVectoreq4 (eqtr subSS sub02))))));

theorem k215Loop4556Step1 (x y z c: nat): $ k215PStep (k215Loop4556State k215PNum4557 x y z c) = (k215Loop4556State k215PNum4558 x (suc y) z c) $ = '(eqtr (k215PAtCI k215PLookupExtraLoopsaxgate_4557) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215Loop4556Step2 (x y z c: nat): $ k215PStep (k215Loop4556State k215PNum4558 x y z c) = (k215Loop4556State k215PNum4559 x y (suc z) c) $ = '(eqtr (k215PAtCI k215PLookupExtraLoopsaxgate_4558) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet6_vector)) k215PSet6_vector)));

theorem k215Loop4556Back (x y z c: nat): $ k215PStep (k215Loop4556State k215PNum4559 x y z c) = (k215Loop4556State k215PNum4556 x y z c) $ = '(k215PAtCC k215PLookupExtraLoopsaxgate_4559);

theorem k215Loop4556Cycle1 (x y z c: nat): $ k215PIter 1 (k215Loop4556State k215PNum4556 (suc x) y z c) = (k215Loop4556State k215PNum4557 x y z c) $ = '(eqtr k215PIter_succ (eqtr (k215PStepeq k215PIter_zero) k215Loop4556StepS));

theorem k215Loop4556Cycle2 (x y z c: nat): $ k215PIter 2 (k215Loop4556State k215PNum4556 (suc x) y z c) = (k215Loop4556State k215PNum4558 x (suc y) z c) $ = '(eqtr k215PIter_succ (eqtr (k215PStepeq k215Loop4556Cycle1) k215Loop4556Step1));

theorem k215Loop4556Cycle3 (x y z c: nat): $ k215PIter 3 (k215Loop4556State k215PNum4556 (suc x) y z c) = (k215Loop4556State k215PNum4559 x (suc y) (suc z) c) $ = '(eqtr k215PIter_succ (eqtr (k215PStepeq k215Loop4556Cycle2) k215Loop4556Step2));

theorem k215Loop4556Cycle4 (x y z c: nat): $ k215PIter 4 (k215Loop4556State k215PNum4556 (suc x) y z c) = (k215Loop4556State k215PNum4556 x (suc y) (suc z) c) $ = '(eqtr k215PIter_succ (eqtr (k215PStepeq k215Loop4556Cycle3) k215Loop4556Back));

@_ abstract def k215Loop4556Claim (x c: nat) (.y .z: nat): wff =
 $ A. y A. z k215PIter (4 * x + 1) (k215Loop4556State k215PNum4556 x y z c) = (k215Loop4556State k215PNum4560 0 (x + y) (x + z) c) $;
theorem k215Loop4556At (x y z c: nat): $ k215Loop4556Claim x c -> k215PIter (4 * x + 1) (k215Loop4556State k215PNum4556 x y z c) = (k215Loop4556State k215PNum4560 0 (x + y) (x + z) c) $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215Loop4556Base (y z c: nat): $ k215PIter (4 * 0 + 1) (k215Loop4556State k215PNum4556 0 y z c) = (k215Loop4556State k215PNum4560 0 (0 + y) (0 + z) c) $ =
 '(eqtr (k215PItereq1 (eqtr (addeq1 mul0) add01))
   (eqtr k215PIter_succ (eqtr (k215PStepeq k215PIter_zero)
     (eqtr k215Loop4556StepZ (k215Loop4556Stateeq eqid eqid (eqcom add01) (eqcom add01) eqid)))));
theorem k215Loop4556Inductive (x y z c: nat): $ k215Loop4556Claim x c -> k215PIter (4 * suc x + 1) (k215Loop4556State k215PNum4556 (suc x) y z c) = (k215Loop4556State k215PNum4560 0 (suc x + y) (suc x + z) c) $ =
 '(eqtrd (a1i (eqtr (k215PItereq1 k215EqTime_succ)
     (eqtr k215PIter_add (k215PItereq2 k215Loop4556Cycle4))))
   (eqtrd k215Loop4556At (a1i (k215Loop4556Stateeq eqid eqid (eqtr addS (eqcom addS1)) (eqtr addS (eqcom addS1)) eqid))));
theorem k215Loop4556All (x c: nat): $ k215Loop4556Claim x c $ =
 (named @ induct '(ind) 'x '(ax_gen (ax_gen k215Loop4556Base)) '(iald @ iald k215Loop4556Inductive));
pub theorem k215Loop4556Transfer (x y z c: nat): $ k215PIter (4 * x + 1) (k215Loop4556State k215PNum4556 x y z c) = (k215Loop4556State k215PNum4560 0 (x + y) (x + z) c) $ =
 '(ax_mp k215Loop4556At k215Loop4556All);


theorem k215Loop4556VectorIn (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215Loop4556State k215PNum4556 a3 a7 a6 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = k215PState k215PNum4556 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector k215PR2_vector eqid k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215Loop4556VectorOut (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215Loop4556State k215PNum4560 0 (a3 + a7) (a3 + a6) (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = k215PState k215PNum4560 (k215PVector a0 a1 a2 0 a4 a5 (a3 + a6) (a3 + a7) a8) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector k215PR2_vector eqid k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

pub theorem k215Loop4556Vector (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ k215PIter (4 * a3 + 1) (k215PState k215PNum4556 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) =
   k215PState k215PNum4560 (k215PVector a0 a1 a2 0 a4 a5 (a3 + a6) (a3 + a7) a8) $ =
 '(eqtr (k215PItereq2 (eqcom k215Loop4556VectorIn)) (eqtr k215Loop4556Transfer k215Loop4556VectorOut));

@_ def k215Loop4572State (pc x y z c: nat): nat = $ k215PState pc (k215PVector z (k215PR1 c) (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) y x (k215PR8 c)) $;

do (apply (register-eqd 'k215Loop4572State) '(k215Loop4572Stateeqd));

theorem k215Loop4572StepZ (y z c: nat): $ k215PStep (k215Loop4572State k215PNum4572 0 y z c) = (k215Loop4572State k215PNum4575 0 y z c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupExtraLoopsaxgate_4572) (ifeq (eqeq1 k215PGet7_vector) eqid eqid)) (ifpos eqid));

