import "source_l_common_level_reflection.mm0";

import "source_renaming_laws.mm0";

import "source_syntax_laws.mm0";

def sfCLBallRenameLaw (R: set) (n body .k .y: nat): wff =
 $ A. k A. y sfRename R k (sfCLBall n y body) =
   sfCLBall n (sfRenameIndex R k y) (sfRename R (n + k) body) $;

theorem sfCLBall_rename (R: set) (n y body k: nat):
 $ sfRename R k (sfCLBall n y body) =
   sfCLBall n (sfRenameIndex R k y) (sfRename R (n + k) body) $;

def sfCLBallSubstLaw (t: nat) (n body .k .y: nat): wff =
 $ A. k A. y sfSubst k t (sfCLBall n y body) =
   sfCLBall n (sfSubstIndex k t y) (sfSubst (n + k) t body) $;

theorem sfCLBall_subst (t: nat) (n y body k: nat):
 $ sfSubst k t (sfCLBall n y body) =
   sfCLBall n (sfSubstIndex k t y) (sfSubst (n + k) t body) $;
