import "source_piece_pcf_definable_context_transport.mm1";

import "source_piece_pcf_definable_and.mm1";

@_ abstract def sfPieceDefinableConjunctionDifference(a b r:nat): nat = $ sfAll (sfIff (sfMem 0 (suc r)) (sfAnd (sfMem 0 (suc a)) (sfImp (sfMem 0 (suc b)) sfBot))) $;

@_ abstract def sfPieceDefinableConjunctionPointContext(n G:nat): nat = $ (sfPieceDefinableRecipeEnvironment n) : sfContextShift (sfPieceDefinableParametersContext n G) $;

pub theorem sfPieceDefinableConjunctionDifference_wf(a b r:nat): $ sfWf (sfPieceDefinableConjunctionDifference a b r) $ = (named '(ax_mp sfWf_all (ax_mp (ax_mp sfWf_and (ax_mp (ax_mp sfWf_imp sfWf_mem) (ax_mp (ax_mp sfWf_and sfWf_mem) (ax_mp (ax_mp sfWf_imp sfWf_mem) sfWf_bot)))) (ax_mp (ax_mp sfWf_imp (ax_mp (ax_mp sfWf_and sfWf_mem) (ax_mp (ax_mp sfWf_imp sfWf_mem) sfWf_bot))) sfWf_mem))));

theorem sfPieceDefinableConjunction_mem_rename(R:set)(a:nat): $ sfRename R 1 (sfMem 0 (suc a)) = sfMem 0 (suc (R @ a)) $ = (named '(eqtr sfRename_sfMem (sfMemeq (ax_mp sfRenameIndex_bound lt01S) (eqtr sfRenameIndex_lift (suceq sfRenameIndex_zero)))));

pub theorem sfPieceDefinableConjunctionDifference_rename(R:set)(a b r:nat): $ sfRename R 0 (sfPieceDefinableConjunctionDifference a b r) = sfPieceDefinableConjunctionDifference (R @ a) (R @ b) (R @ r) $ = (named '(eqtr sfRename_sfAll (sfAlleq (eqtr sfRename_sfAnd (sfAndeq (eqtr sfRename_sfImp (sfImpeq (! sfPieceDefinableConjunction_mem_rename $ R $ $ r $) (eqtr sfRename_sfAnd (sfAndeq (! sfPieceDefinableConjunction_mem_rename $ R $ $ a $) (eqtr sfRename_sfImp (sfImpeq (! sfPieceDefinableConjunction_mem_rename $ R $ $ b $) sfRename_bot)))))) (eqtr sfRename_sfImp (sfImpeq (eqtr sfRename_sfAnd (sfAndeq (! sfPieceDefinableConjunction_mem_rename $ R $ $ a $) (eqtr sfRename_sfImp (sfImpeq (! sfPieceDefinableConjunction_mem_rename $ R $ $ b $) sfRename_bot)))) (! sfPieceDefinableConjunction_mem_rename $ R $ $ r $))))))));

pub theorem sfPieceDefinableConjunctionDifference_congr(a b r aa bb rr:nat)(ha:$ a = aa $)(hb:$ b = bb $)(hr:$ r = rr $): $ sfPieceDefinableConjunctionDifference a b r = sfPieceDefinableConjunctionDifference aa bb rr $ = (named '(trud (sfPieceDefinableConjunctionDifferenceeqd (a1i ha) (a1i hb) (a1i hr))));

theorem sfPieceDefinableConjunction_mem_subst(e a:nat): $ sfSubst 0 e (sfMem 0 (suc a)) = sfMem e a $ = (named '(eqtr sfSubst_sfMem (sfMemeq sfSubstIndex_zero sfSubstIndex_successor)));

pub theorem sfPieceDefinableConjunctionDifference_open(e a b r:nat): $ sfSubst 0 e (sfIff (sfMem 0 (suc r)) (sfAnd (sfMem 0 (suc a)) (sfImp (sfMem 0 (suc b)) sfBot))) = sfIff (sfMem e r) (sfAnd (sfMem e a) (sfImp (sfMem e b) sfBot)) $ = (named '(eqtr sfSubst_sfAnd (sfAndeq (eqtr sfSubst_sfImp (sfImpeq (! sfPieceDefinableConjunction_mem_subst $ e $ $ r $) (eqtr sfSubst_sfAnd (sfAndeq (! sfPieceDefinableConjunction_mem_subst $ e $ $ a $) (eqtr sfSubst_sfImp (sfImpeq (! sfPieceDefinableConjunction_mem_subst $ e $ $ b $) sfSubst_bot)))))) (eqtr sfSubst_sfImp (sfImpeq (eqtr sfSubst_sfAnd (sfAndeq (! sfPieceDefinableConjunction_mem_subst $ e $ $ a $) (eqtr sfSubst_sfImp (sfImpeq (! sfPieceDefinableConjunction_mem_subst $ e $ $ b $) sfSubst_bot)))) (! sfPieceDefinableConjunction_mem_subst $ e $ $ r $))))));

pub theorem sfPieceDefinableConjunctionDifference_member(G a b r e:nat)(hp:$ nsLocal G (sfPieceDefinableConjunctionDifference a b r) $): $ nsLocal G (sfIff (sfMem e r) (sfAnd (sfMem e a) (sfImp (sfMem e b) sfBot))) $ = (named '(sfRQ_rewrite sfPieceDefinableConjunctionDifference_open (ax_mp nsLocal_AllE hp)));

pub theorem sfPieceDefinableConjunctionDifference_shift(a b r:nat): $ sfShift 0 (sfPieceDefinableConjunctionDifference a b r) = sfPieceDefinableConjunctionDifference (suc a) (suc b) (suc r) $ = (named '(eqtr (eqcom (ax_mp sfRename_successor sfPieceDefinableConjunctionDifference_wf)) (eqtr sfPieceDefinableConjunctionDifference_rename (sfPieceDefinableConjunctionDifference_congr sfSuccessorMap_value sfSuccessorMap_value sfSuccessorMap_value))));

pub theorem sfPieceDefinableConjunctionDifference_context(n G a b r:nat)(hp:$ nsLocal G (sfPieceDefinableConjunctionDifference a b r) $): $ nsLocal (sfPieceDefinableParametersContext n G) (sfPieceDefinableConjunctionDifference (sfPieceDefinableContextTransportMap n @ a) (sfPieceDefinableContextTransportMap n @ b) (sfPieceDefinableContextTransportMap n @ r)) $ = (named '(sfRQ_rewrite sfPieceDefinableConjunctionDifference_rename (sfPieceDefinableContextTransport_all sfPieceDefinableConjunctionDifference_wf hp)));

pub theorem sfPieceDefinableConjunction_named_shift_code(n phi r A:nat)(hb:$ sfBound n phi $): $ sfShift 0 (sfPieceDefinableNamed n phi r A) = sfPieceDefinableNamed n phi (suc r) (suc A) $ = (named '(eqtr (eqcom (ax_mp sfRename_successor sfORBinary_wf)) (eqtr (sfPieceDefinableNamed_rename hb) (sfPieceDefinableNamed_congr hb (eqtr sfRenameIndex_zero sfSuccessorMap_value) (eqtr sfRenameIndex_zero sfSuccessorMap_value)))));

pub theorem sfPieceDefinableConjunction_named_shift(G n phi r A:nat)(hb:$ sfBound n phi $)(hp:$ nsLocal G (sfPieceDefinableNamed n phi r A) $): $ nsLocal (sfContextShift G) (sfPieceDefinableNamed n phi (suc r) (suc A)) $ = (named '(sfRQ_rewrite (sfPieceDefinableConjunction_named_shift_code hb) (ax_mp sfSepLocal_shift hp)));

theorem sfPieceDefinableConjunction_add3(i:nat): $ 3 + i = suc (suc (suc i)) $ = (named '(eqtr addS1 (suceq (eqtr addS1 (suceq (eqtr addS1 (suceq add01)))))));

theorem sfPieceDefinableConjunction_shifted_parameter(i:nat): $ sfShift 0 (sfMem (sfPieceDefinableCanonicalMap @ i) 1) = sfMem (sfPieceDefinableRecipeMap @ i) 2 $ = (named '(eqtr sfShift_sfMem (sfMemeq (eqtr sfShiftIndex_zero (eqtr (suceq sfPieceDefinableCanonicalMap_at) (eqcom (eqtr sfPieceDefinableRecipeMap_at sfPieceDefinableConjunction_add3)))) sfShiftIndex_zero)));

theorem sfPieceDefinableConjunction_shifted_member_each(n G i:nat): $ i < n -> nsLocal (sfContextShift (sfPieceDefinableParametersContext n G)) (sfMem (sfPieceDefinableRecipeMap @ i) 2) $ = (named '(syl (bi1 (nsLocal_formula_eq sfPieceDefinableConjunction_shifted_parameter)) (syl sfSepLocal_shift (ax_mp sfReflectionDnMembers_at sfPieceDefinableCanonical_members))));

pub theorem sfPieceDefinableConjunction_shifted_members(n G:nat): $ sfReflectionDnMembers sfPieceDefinableRecipeMap (sfContextShift (sfPieceDefinableParametersContext n G)) 2 n $ = (named '(ax_gen sfPieceDefinableConjunction_shifted_member_each));

pub theorem sfPieceDefinableConjunctionPointContext_wf(n G:nat): $ sfContextWf (sfPieceDefinableConjunctionPointContext n G) $ = (named '(mpbir sfContextWf_cons (ian sfPieceEnv_wf sfContextShift_wf)));

pub theorem sfPieceDefinableConjunction_members(n G:nat): $ sfReflectionDnMembers sfPieceDefinableRecipeMap (sfPieceDefinableConjunctionPointContext n G) 2 n $ = (named '(sfPieceParameterMembers_weaken sfPieceDefinableConjunctionPointContext_wf sfContextSub_cons sfPieceDefinableConjunction_shifted_members));

pub theorem sfPieceDefinableConjunction_environment(n G:nat): $ nsLocal (sfPieceDefinableConjunctionPointContext n G) (sfPieceDefinableRecipeEnvironment n) $ = (named '(ax_mp (ax_mp nsLocal_hyp sfPieceDefinableConjunctionPointContext_wf) sfContext_member_head));

pub theorem sfPieceDefinableConjunction_point(G n phi psi l r d:nat)(hl:$ sfBound n phi $)(hr:$ sfBound n psi $)(hL:$ nsLocal G (sfPieceDefinableNamed n phi l 1) $)(hR:$ nsLocal G (sfPieceDefinableNamed n psi r 1) $)(hD:$ nsLocal G (sfPieceDefinableConjunctionDifference l r d) $)(hN:$ nsLocal G (sfPieceDefinableConjunctionDifference l d 0) $): $ nsLocal (sfPieceDefinableParametersContext n G) (sfPieceDefinableRecipePoint n (sfAnd phi psi)) $ = (named '(ax_mp (sfLocal_allI (ax_mp nsLocal_context_wf (sfPieceDefinableContextTransport_named hl hL))) (ax_mp nsLocal_II (sfPieceDefinableAnd_represents (sfPieceDefinableConjunctionDifference_member (ax_mp (ax_mp (ax_mp nsLocal_weaken sfPieceDefinableConjunctionPointContext_wf) sfContextSub_cons) (sfRQ_rewrite sfPieceDefinableConjunctionDifference_shift (ax_mp sfSepLocal_shift (sfPieceDefinableConjunctionDifference_context hD))))) (sfPieceDefinableConjunctionDifference_member (ax_mp (ax_mp (ax_mp nsLocal_weaken sfPieceDefinableConjunctionPointContext_wf) sfContextSub_cons) (sfRQ_rewrite sfPieceDefinableConjunctionDifference_shift (ax_mp sfSepLocal_shift (sfRQ_rewrite (sfPieceDefinableConjunctionDifference_congr eqid eqid sfLCB_zero) (sfPieceDefinableConjunctionDifference_context hN)))))) (sfPieceDefinableRealization_local hl (ax_mp (ax_mp (ax_mp nsLocal_weaken sfPieceDefinableConjunctionPointContext_wf) sfContextSub_cons) (sfPieceDefinableConjunction_named_shift hl (sfRQ_rewrite (sfPieceDefinableNamed_congr hl eqid sfLCB_one) (sfPieceDefinableContextTransport_named hl hL)))) sfPieceDefinableConjunction_members sfPieceDefinableConjunction_environment) (sfPieceDefinableRealization_local hr (ax_mp (ax_mp (ax_mp nsLocal_weaken sfPieceDefinableConjunctionPointContext_wf) sfContextSub_cons) (sfPieceDefinableConjunction_named_shift hr (sfRQ_rewrite (sfPieceDefinableNamed_congr hr eqid sfLCB_one) (sfPieceDefinableContextTransport_named hr hR)))) sfPieceDefinableConjunction_members sfPieceDefinableConjunction_environment)))));

pub theorem sfPieceDefinableConjunction_recipe(G n phi psi l r d:nat)(hl:$ sfBound n phi $)(hr:$ sfBound n psi $)(hL:$ nsLocal G (sfPieceDefinableNamed n phi l 1) $)(hR:$ nsLocal G (sfPieceDefinableNamed n psi r 1) $)(hD:$ nsLocal G (sfPieceDefinableConjunctionDifference l r d) $)(hN:$ nsLocal G (sfPieceDefinableConjunctionDifference l d 0) $): $ nsLocal G (sfPieceDefinableRecipe n (sfAnd phi psi)) $ = (named '(sfPieceDefinableCanonical_recipe (ax_mp nsLocal_context_wf hL) (sfPieceDefinableConjunction_point hl hr hL hR hD hN)));
