import "k218q_safe_prefix.mm0";

def k218ParameterNames (n .S: nat): nat =
 $ rec 0 (\ S, (4 + len S) : S) n $;
def k218ParameterAvoid (S n x: nat): wff =
 $ sqEnvAvoid (sqNumericEnvironment S) n x $;
def k218ParameterBelow (S n k: nat): wff =
 $ sqEnvBelow (sqNumericEnvironment S) n k $;

theorem k218ParameterNames_zero: $ k218ParameterNames 0 = 0 $;
theorem k218ParameterNames_length (n: nat): $ len (k218ParameterNames n) = n $;
theorem k218ParameterNames_suc (n: nat):
 $ k218ParameterNames (suc n) = (4 + n) : k218ParameterNames n $;
theorem k218ParameterNames_avoid1 (n: nat):
 $ k218ParameterAvoid (k218ParameterNames n) n 1 $;
theorem k218ParameterNames_avoid3 (n: nat):
 $ k218ParameterAvoid (k218ParameterNames n) n 3 $;
theorem k218ParameterNames_below (n: nat):
 $ k218ParameterBelow (k218ParameterNames n) n (4 + n) $;
