pub theorem sfPieceDefinableExistentialSome_depth(T:set)(k R A e:nat): $ sfRename T k (sfPieceDefinableExistentialSome R A e) = sfPieceDefinableExistentialSome (sfRenameIndex T k R) (sfRenameIndex T k A) (sfRenameIndex T k e) $ = (named '(eqtr (ax_mp sfRename_as_map sfPieceDefinableExistentialSome_wf) (eqtr sfPieceDefinableExistentialSome_rename (sfPieceDefinableExistentialSome_congr sfRenameDepthMap_value sfRenameDepthMap_value sfRenameDepthMap_value))));

pub theorem sfPieceDefinableExistentialProjection_rename(T:set)(R X A Y:nat): $ sfRename T 0 (sfPieceDefinableExistentialProjection R X A Y) = sfPieceDefinableExistentialProjection (T @ R) (T @ X) (T @ A) (T @ Y) $ = (named '(eqtr sfRename_sfAll (sfAlleq (eqtr sfRename_sfAnd (sfAndeq (eqtr sfRename_sfImp (sfImpeq (eqtr sfRename_sfMem (sfMemeq (ax_mp sfRenameIndex_bound lt01S) (eqtr sfRenameIndex_lift (suceq sfRenameIndex_zero)))) (eqtr sfRename_sfAnd (sfAndeq (eqtr sfRename_sfMem (sfMemeq (ax_mp sfRenameIndex_bound lt01S) (eqtr sfRenameIndex_lift (suceq sfRenameIndex_zero)))) (eqtr sfPieceDefinableExistentialSome_depth (sfPieceDefinableExistentialSome_congr (eqtr sfRenameIndex_lift (suceq sfRenameIndex_zero)) (eqtr sfRenameIndex_lift (suceq sfRenameIndex_zero)) (ax_mp sfRenameIndex_bound lt01S))))))) (eqtr sfRename_sfImp (sfImpeq (eqtr sfRename_sfAnd (sfAndeq (eqtr sfRename_sfMem (sfMemeq (ax_mp sfRenameIndex_bound lt01S) (eqtr sfRenameIndex_lift (suceq sfRenameIndex_zero)))) (eqtr sfPieceDefinableExistentialSome_depth (sfPieceDefinableExistentialSome_congr (eqtr sfRenameIndex_lift (suceq sfRenameIndex_zero)) (eqtr sfRenameIndex_lift (suceq sfRenameIndex_zero)) (ax_mp sfRenameIndex_bound lt01S))))) (eqtr sfRename_sfMem (sfMemeq (ax_mp sfRenameIndex_bound lt01S) (eqtr sfRenameIndex_lift (suceq sfRenameIndex_zero)))))))))));

pub theorem sfPieceDefinableExistentialProjection_congr(R X A Y R1 X1 A1 Y1:nat)(hr:$ R = R1 $)(hx:$ X = X1 $)(ha:$ A = A1 $)(hy:$ Y = Y1 $): $ sfPieceDefinableExistentialProjection R X A Y = sfPieceDefinableExistentialProjection R1 X1 A1 Y1 $ = (named '(sfAlleq (sfAndeq (sfImpeq (sfMemeq eqid (suceq hy)) (sfAndeq (sfMemeq eqid (suceq hx)) (sfPieceDefinableExistentialSome_congr (suceq hr) (suceq ha) eqid))) (sfImpeq (sfAndeq (sfMemeq eqid (suceq hx)) (sfPieceDefinableExistentialSome_congr (suceq hr) (suceq ha) eqid)) (sfMemeq eqid (suceq hy))))));

pub theorem sfPieceDefinableExistentialProjection_instance(R X A Y e:nat): $ sfSubst 0 e (sfIff (sfMem 0 (suc Y)) (sfAnd (sfMem 0 (suc X)) (sfPieceDefinableExistentialSome (suc R) (suc A) 0))) = sfIff (sfMem e Y) (sfAnd (sfMem e X) (sfPieceDefinableExistentialSome R A e)) $ = (named '(eqtr sfSubst_sfAnd (sfAndeq (eqtr sfSubst_sfImp (sfImpeq (eqtr sfSubst_sfMem (sfMemeq sfSubstIndex_zero sfSubstIndex_successor)) (eqtr sfSubst_sfAnd (sfAndeq (eqtr sfSubst_sfMem (sfMemeq sfSubstIndex_zero sfSubstIndex_successor)) (eqtr (ax_mp sfSubst_as_map sfPieceDefinableExistentialSome_wf) (eqtr sfPieceDefinableExistentialSome_rename (sfPieceDefinableExistentialSome_congr (eqtr sfSubstDepthMap_value sfSubstIndex_successor) (eqtr sfSubstDepthMap_value sfSubstIndex_successor) (eqtr sfSubstDepthMap_value sfSubstIndex_zero)))))))) (eqtr sfSubst_sfImp (sfImpeq (eqtr sfSubst_sfAnd (sfAndeq (eqtr sfSubst_sfMem (sfMemeq sfSubstIndex_zero sfSubstIndex_successor)) (eqtr (ax_mp sfSubst_as_map sfPieceDefinableExistentialSome_wf) (eqtr sfPieceDefinableExistentialSome_rename (sfPieceDefinableExistentialSome_congr (eqtr sfSubstDepthMap_value sfSubstIndex_successor) (eqtr sfSubstDepthMap_value sfSubstIndex_successor) (eqtr sfSubstDepthMap_value sfSubstIndex_zero)))))) (eqtr sfSubst_sfMem (sfMemeq sfSubstIndex_zero sfSubstIndex_successor)))))));

