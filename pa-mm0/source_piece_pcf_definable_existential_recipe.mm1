pub theorem sfPieceDefinableExistentialProjection_shift(R X A Y:nat): $ sfShift 0 (sfPieceDefinableExistentialProjection R X A Y) = sfPieceDefinableExistentialProjection (suc R) (suc X) (suc A) (suc Y) $ = (named '(eqtr (eqcom (ax_mp sfRename_successor sfPieceDefinableExistentialProjection_wf)) (eqtr sfPieceDefinableExistentialProjection_rename (sfPieceDefinableExistentialProjection_congr sfSuccessorMap_value sfSuccessorMap_value sfSuccessorMap_value sfSuccessorMap_value))));

