import "k218q_matrix_rebase.mm0";
import "k218q_closure_relabel.mm0";

theorem k218QClosure_matrix_rebase (E: set) (n B L a b c u v p w x y f: nat)
 (hf: $ sfBound (suc (suc n)) f $)
 (hB: $ sqRebaseHygiene E n B f 0 $) (hL: $ sqRebaseHygiene E n L f 0 $)
 (huB: $ sqAllocAvoid B (suc f) u $)
 (huL: $ sqAllocAvoid L (suc f) u $)
 (hvB: $ sqAllocAvoid B (suc f) v $)
 (hvL: $ sqAllocAvoid L (suc f) v $)
 (hpB: $ sqAllocAvoid B (suc f) p $)
 (hpL: $ sqAllocAvoid L (suc f) p $)
 (hxB: $ sqAllocAvoid B (suc f) x $)
 (hxL: $ sqAllocAvoid L (suc f) x $)
 (hyB: $ sqAllocAvoid B (suc f) y $)
 (hyL: $ sqAllocAvoid L (suc f) y $):
 $ k218IEquivalent
     (k218ClosureSeparated E n B a b c u v p w x y f)
     (k218ClosureSeparated E n L a b c u v p w x y f) $;
