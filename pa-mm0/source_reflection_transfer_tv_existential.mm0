theorem sfTVClosedContext_sub_shift(G J:nat)(hG:$ sfTheoryContext sfClosedFormulaClass G $)(hj:$ sfContextWf J $)(hs:$ sfContextSub G J $): $ sfContextSub G (sfContextShift J) $;

theorem sfTVContextSub_cons(a G J:nat)(hs:$ sfContextSub G J $): $ sfContextSub (a : G) (a : J) $;

theorem sfTVEx2_project_closed(G A Q:nat)(hG:$ sfTheoryContext sfClosedFormulaClass G $)(ha:$ sfWf A $)(hq:$ sfBound 0 Q $)(hp:$ nsLocal (A : G) Q $): $ nsLocal G (sfImp (sfEx (sfEx A)) Q) $;
