pub theorem osiMem_eq (a b c d: nat) (ha: $ a = b $) (hc: $ c = d $): $ sfMem a c = sfMem b d $ = '(addeq1 (muleq2 (preq ha hc)));

pub theorem osiEq_eq (a b c d: nat) (ha: $ a = b $) (hc: $ c = d $): $ sfEq a c = sfEq b d $ = '(addeq1 (muleq2 (preq ha hc)));

pub theorem osiAnd_eq (a b c d: nat) (ha: $ a = b $) (hc: $ c = d $): $ sfAnd a c = sfAnd b d $ = '(addeq1 (muleq2 (preq ha hc)));

pub theorem osiOr_eq (a b c d: nat) (ha: $ a = b $) (hc: $ c = d $): $ sfOr a c = sfOr b d $ = '(addeq1 (muleq2 (preq ha hc)));

pub theorem osiImp_eq (a b c d: nat) (ha: $ a = b $) (hc: $ c = d $): $ sfImp a c = sfImp b d $ = '(addeq1 (muleq2 (preq ha hc)));

pub theorem osiAll_eq (a b: nat) (ha: $ a = b $): $ sfAll a = sfAll b $ = '(addeq1 (muleq2 (preq1 ha)));

pub theorem osiEx_eq (a b: nat) (ha: $ a = b $): $ sfEx a = sfEx b $ = '(addeq1 (muleq2 (preq1 ha)));

theorem osiBound0: $ sfBound 7 osiF0 $ = '(mpbir sfBound_sfMem (ian lt01S (mpbi ltsuc lt01S)));

theorem osiBound1: $ sfBound 8 osiF0 $ = '(mpbir sfBound_sfMem (ian lt01S (mpbi ltsuc lt01S)));

