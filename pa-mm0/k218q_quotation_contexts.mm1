-- Generated Q replay candidate; not a checked theorem until check.py passes.
import "quotation_contexts.mm1";
import "k218q_bootstrap.mm1";
import "k218q_quotation_propositional.mm1";
import "source_contexts.mm1";

theorem k218SQ_sqContext_support_member (E: set) (t k d G H a: nat):
 $ sfContextSub G H -> a IN sqContext E t k d G ->
   a e. k218IContextProofClass (sqContext E t k d H) $ =
'(syl6 (bi2 k218IContextProofClass_value)
  (syl6 k218IHypProvable_assumption sqContext_sub_member));

pub theorem k218SQ_sqContext_support (E: set) (t k d G H: nat):
 $ sfContextSub G H -> k218IContextSupports (sqContext E t k d H) (sqContext E t k d G) $ =
(named '(iald k218SQ_sqContext_support_member));

pub theorem k218SQ_sqLocal_context_weaken (E: set) (t k d G H a: nat):
 $ sfContextSub G H -> k218SQ_sqLocal (sqContext E t k d G) E t k d a ->
   k218SQ_sqLocal (sqContext E t k d H) E t k d a $ =
'(syl k218IHypProvable_refine_d k218SQ_sqContext_support);
