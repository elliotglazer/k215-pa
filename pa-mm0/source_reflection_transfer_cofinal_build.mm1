import "source_reflection_transfer_cofinal_cover.mm1";

theorem rfcb_merge_shift2(level K:nat)(hl:$ sfBound 2 level $): $ sfShift 0 (sfShift 0 (sfReflectionCofinalMergeLaw level K)) = sfReflectionCofinalMergeLaw level (suc (suc K)) $ = (named '(eqtr (sfShifteq2 (sfReflectionCofinalMergeLaw_shift hl)) (sfReflectionCofinalMergeLaw_shift hl)));

theorem rfcb_hit_shift2(level K a:nat)(hl:$ sfBound 2 level $): $ sfShift 0 (sfShift 0 (sfReflectionCofinalHit level K a)) = sfReflectionCofinalHit level (suc (suc K)) (suc (suc a)) $ = (named '(eqtr (sfShifteq2 (sfReflectionCofinalHit_shift hl)) (sfReflectionCofinalHit_shift hl)));

theorem rfcb_point_hit_branch(T:set)(G start n level K k X:nat)(hl:$ sfBound 2 level $)(hPoint:$ nsLocal G (sfReflectionCofinalPoint T start n level K k X) $)(hHit:$ nsLocal G (sfReflectionCofinalHit level K ((T @ n) + start)) $)(hM:$ nsLocal G (sfReflectionCofinalMergeLaw level K) $): $ nsLocal (sfReflectionCofinalContext G (sfReflectionCofinalHitPoint level (suc (suc K)) (suc (suc ((T @ n) + start))) 1 0)) (sfShift 0 (sfShift 0 (sfReflectionCofinalCommon T start (suc n) level K))) $ = (named '(mpbir (nsLocal_formula_eq (rfcstep_common_shift2 hl)) (sfReflectionCofinal_merge_tuple hl (ax_mp nsLocal_CE2 (ax_mp nsLocal_CE2 (mpbi (nsLocal_formula_eq (sfReflectionCofinalPoint_shift2 hl)) (sfReflectionCofinal_lift2 (rfcc_hitpoint_wf hl) hPoint)))) (mpbi (nsLocal_formula_eq (nsMem_eq (eqcom rfcstep_add2) eqid)) (ax_mp nsLocal_CE2 (ax_mp nsLocal_CE2 (ax_mp (ax_mp nsLocal_hyp (rfc_context_wf (rfcc_hitpoint_wf hl))) sfContext_member_head)))) (sfReflectionCofinalMergeLaw_use hl (mpbi (nsLocal_formula_eq (rfcb_merge_shift2 hl)) (sfReflectionCofinal_lift2 (rfcc_hitpoint_wf hl) hM)) (ax_mp nsLocal_CE1 (mpbi (nsLocal_formula_eq (sfReflectionCofinalPoint_shift2 hl)) (sfReflectionCofinal_lift2 (rfcc_hitpoint_wf hl) hPoint))) (ax_mp nsLocal_CE1 (ax_mp nsLocal_CE2 (mpbi (nsLocal_formula_eq (sfReflectionCofinalPoint_shift2 hl)) (sfReflectionCofinal_lift2 (rfcc_hitpoint_wf hl) hPoint)))) (ax_mp nsLocal_CE1 (ax_mp (ax_mp nsLocal_hyp (rfc_context_wf (rfcc_hitpoint_wf hl))) sfContext_member_head)) (ax_mp nsLocal_CE1 (ax_mp nsLocal_CE2 (ax_mp (ax_mp nsLocal_hyp (rfc_context_wf (rfcc_hitpoint_wf hl))) sfContext_member_head)))))));

pub theorem sfReflectionCofinal_point_hit(T:set)(G start n level K k X:nat)(hl:$ sfBound 2 level $)(hPoint:$ nsLocal G (sfReflectionCofinalPoint T start n level K k X) $)(hHit:$ nsLocal G (sfReflectionCofinalHit level K ((T @ n) + start)) $)(hM:$ nsLocal G (sfReflectionCofinalMergeLaw level K) $): $ nsLocal G (sfReflectionCofinalCommon T start (suc n) level K) $ = (named '(ax_mp (sfReflectionCofinal_double_eliminate (rfcc_hitpoint_wf hl) (sfReflectionCofinalCommon_wf hl) hHit) (rfcb_point_hit_branch hl hPoint hHit hM)));

theorem rfcb_extend_branch(T:set)(G start n level K:nat)(hl:$ sfBound 2 level $)(hCommon:$ nsLocal G (sfReflectionCofinalCommon T start n level K) $)(hHit:$ nsLocal G (sfReflectionCofinalHit level K ((T @ n) + start)) $)(hM:$ nsLocal G (sfReflectionCofinalMergeLaw level K) $): $ nsLocal (sfReflectionCofinalContext G (sfReflectionCofinalPoint T (suc (suc start)) n level (suc (suc K)) 1 0)) (sfShift 0 (sfShift 0 (sfReflectionCofinalCommon T start (suc n) level K))) $ = (named '(mpbir (nsLocal_formula_eq (rfcstep_common_shift2 hl)) (sfReflectionCofinal_point_hit hl (ax_mp (ax_mp nsLocal_hyp (rfc_context_wf (sfReflectionCofinalPoint_wf hl))) sfContext_member_head) (mpbi (nsLocal_formula_eq (eqtr (rfcb_hit_shift2 hl) (rfcc_hit_congr hl eqid (eqcom rfcstep_add2)))) (sfReflectionCofinal_lift2 (sfReflectionCofinalPoint_wf hl) hHit)) (mpbi (nsLocal_formula_eq (rfcb_merge_shift2 hl)) (sfReflectionCofinal_lift2 (sfReflectionCofinalPoint_wf hl) hM)))));

pub theorem sfReflectionCofinal_extend(T:set)(G start n level K:nat)(hl:$ sfBound 2 level $)(hCommon:$ nsLocal G (sfReflectionCofinalCommon T start n level K) $)(hHit:$ nsLocal G (sfReflectionCofinalHit level K ((T @ n) + start)) $)(hM:$ nsLocal G (sfReflectionCofinalMergeLaw level K) $): $ nsLocal G (sfReflectionCofinalCommon T start (suc n) level K) $ = (named '(ax_mp (sfReflectionCofinal_double_eliminate (sfReflectionCofinalPoint_wf hl) (sfReflectionCofinalCommon_wf hl) hCommon) (rfcb_extend_branch hl hCommon hHit hM)));
