theorem k215Const1071PairIn (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt1077State k215PNum1077 a6 a1 a7 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum1077 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215Const1071PairOut (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt1077State k215PNum1087 0 0 (a7 + (a6, a1)) (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum1087 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215Const1071Pair (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ k215PReach (k215PState k215PNum1077 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215PNum1087 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ = '(mpbi (k215PReacheq k215Const1071PairIn k215Const1071PairOut) k215PairMacro1077);

theorem k215Const1071Stage0 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum1071 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum1074 (k215PVector u 0 w c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop1071Vector (k215PStateeq2 (k215PVectoreq7 add0))));

theorem k215Const1071Stage1 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum1074 (k215PVector u 0 w c a b t 0 v)) (k215PState k215PNum1077 (k215PVector u w 0 c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop1074Vector (k215PStateeq2 (k215PVectoreq2 add0))));

theorem k215Const1071Stage2 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum1077 (k215PVector u w 0 c a b t 0 v)) (k215PState k215PNum1087 (k215PVector u 0 0 c a b 0 (t, w) v)) $ = '(mpbi (k215PReacheq2 (k215PStateeq2 (k215PVectoreq8 add01))) k215Const1071Pair);

theorem k215Const1071Stage3 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum1087 (k215PVector u 0 0 c a b 0 (t, w) v)) (k215PState k215PNum1090 (k215PVector u 0 (t, w) c a b 0 0 v)) $ = '(k215PReach_intro (eqtr k215Loop1087Vector (k215PStateeq2 (k215PVectoreq3 add0))));

theorem k215Const1071Stage4 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum1090 (k215PVector u 0 (t, w) c a b 0 0 v)) (k215PState k215PNum1091 (k215PVector u 1 (t, w) c a b 0 0 v)) $ = '(k215PReach_step (eqtr (k215PAtCI k215PLookupConst1071_1090) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet1_vector)) k215PSet1_vector))));

pub theorem k215PushConstant1071 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum1071 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum1091 (k215PVector u 1 (t, w) c a b 0 0 v)) $ = '(ax_mp (ax_mp k215PReach_trans k215Const1071Stage0) (ax_mp (ax_mp k215PReach_trans k215Const1071Stage1) (ax_mp (ax_mp k215PReach_trans k215Const1071Stage2) (ax_mp (ax_mp k215PReach_trans k215Const1071Stage3) k215Const1071Stage4))));

