import "bb215_arithmetic_formula_qf_sat.mm0";

import "pa_source_interpretation_nat_term_assignment.mm0";

def bb215ArithmeticFormulaExQFSat (E: set) (c .x: nat): wff = $ ifp (sfTag c = 7 /\ sfRight c = 0) (E. x bb215ArithmeticFormulaQFSat (paNatTermConsEnvironment E x) (sfLeft c)) (0 != 0) $;

theorem bb215ArithmeticFormulaExQFSat_ex (E: set) (c: nat) {x: nat}: $ bb215ArithmeticFormulaExQFSat E (paFormulaEx c) <-> E. x bb215ArithmeticFormulaQFSat (paNatTermConsEnvironment E x) c $;
