def sfPieceMonoCollectionPrelude(phi:nat):nat = $ sfShift 0 (sfShift 0 (sfAll (sfPieceMonoCode phi))) $;

def sfPieceMonoCollectionLaw(phi:nat):nat = $ sfImp (sfPieceMonoCollectionPrelude phi) (sfOrdinalCollectionMono (sfRename sfPieceQMap 0 phi)) $;


def pcmcQMap(x y z:nat):set = $ sfComposeMap (sfLCBinaryMap x y z) sfPieceQMap $;
theorem pcmcQ_zero(x y z:nat): $ pcmcQMap x y z @ 0 = sfPieceTripleMap x z y (suc z) @ 0 $ =
'(eqtr sfComposeMap_value (eqtr (appeq2 pcdo_q_zero) (eqtr sfLCB_zero (eqcom sfPCT_zero))));
theorem pcmcQ_one(x y z:nat): $ pcmcQMap x y z @ 1 = sfPieceTripleMap x z y (suc z) @ 1 $ =
'(eqtr sfComposeMap_value (eqtr (appeq2 pcdo_q_one) (eqtr sfLCB_tail (eqtr add01 (eqcom sfPCT_one)))));
theorem pcmcQ_two(x y z:nat): $ pcmcQMap x y z @ 2 = sfPieceTripleMap x z y (suc z) @ 2 $ =
'(eqtr sfComposeMap_value (eqtr (appeq2 pcdo_q_two) (eqtr sfLCB_one (eqcom sfPCT_two))));
theorem pcmcQ_tail(x y z i:nat): $ pcmcQMap x y z @ suc (suc (suc i)) = sfPieceTripleMap x z y (suc z) @ suc (suc (suc i)) $ =
'(eqtr sfComposeMap_value (eqtr (appeq2 pcdo_q_tail) (eqtr sfLCB_tail (eqtr addSass (eqcom sfPCT_tail)))));
theorem pcmcQ_ss(x y z i:nat): $ pcmcQMap x y z @ suc (suc i) = sfPieceTripleMap x z y (suc z) @ suc (suc i) $ =
(named @ induct '(ind) 'i 'pcmcQ_two '(a1i pcmcQ_tail));
theorem pcmcQ_s(x y z i:nat): $ pcmcQMap x y z @ suc i = sfPieceTripleMap x z y (suc z) @ suc i $ =
(named @ induct '(ind) 'i 'pcmcQ_one '(a1i pcmcQ_ss));
theorem pcmcQ_at(x y z i:nat): $ pcmcQMap x y z @ i = sfPieceTripleMap x z y (suc z) @ i $ =
(named @ induct '(ind) 'i 'pcmcQ_zero '(a1i pcmcQ_s));


pub theorem sfPieceQ_binary(phi x y z:nat)(hf:$ sfWf phi $): $ sfLCBinary (sfRename sfPieceQMap 0 phi) x y z = sfPieceTriple phi x z y (suc z) $ = (named '(eqtr (ax_mp sfRename_compose hf) (ax_mp (sfRename_extensional (ax_gen pcmcQ_at)) hf)));

pub theorem sfPieceMonoCollection_literal(phi:nat)(hf:$ sfWf phi $): $ (pcmcF113 phi) = sfPieceMonoCollectionLaw phi $ = (named '(nsImp_eq (eqtr (eqcom (pcmcShift347 hf)) (trud (sfRL_Shift_formula (a1i (eqtr (eqcom (pcmcShift357 hf)) (trud (sfRL_Shift_formula (a1i (nsAll_eq (nsAll_eq (nsAll_eq (nsAll_eq (nsImp_eq eqid (nsImp_eq eqid (nsImp_eq eqid (nsImp_eq (sfPieceTriple_binary hf) (sfPieceTriple_binary hf))))))))))))))))) (nsAll_eq (nsAll_eq (nsAll_eq (nsImp_eq (eqcom (pcmcInst372 hf)) (nsImp_eq eqid (nsImp_eq eqid (nsImp_eq (eqcom (sfPieceQ_binary hf)) (eqcom (sfPieceQ_binary hf)))))))))));

pub theorem sfPieceMonoCollection_nd(phi:nat)(hf:$ sfWf phi $): $ nsLocal 0 (sfPieceMonoCollectionLaw phi) $ = (named '(sfRQ_rewrite (sfPieceMonoCollection_literal hf) (! pcmcP337 phi hf)));

pub theorem sfPieceMonoCollection_pure(T:set)(phi:nat)(hf:$ sfWf phi $): $ sfTheoryProvable T (sfPieceMonoCollectionLaw phi) $ = (named '(ax_mp sfTheory_pure (sfPieceMonoCollection_nd hf)));

theorem pcmc_prelude_rule(T:set)(phi:nat)(ht:$ sfTheoryClosed T $): $ sfTheoryProvable T (sfPieceMonoCode phi) -> sfTheoryProvable T (sfPieceMonoCollectionPrelude phi) $ = (named '(syl (ax_mp sfTheoryProvable_shift ht) (syl (ax_mp sfTheoryProvable_shift ht) (ax_mp sfTheoryProvable_gen ht))));

pub theorem sfPieceMonoCollection_rule(T:set)(phi:nat)(ht:$ sfTheoryClosed T $)(hf:$ sfWf phi $): $ sfTheoryProvable T (sfPieceMonoCode phi) -> sfTheoryProvable T (sfOrdinalCollectionMono (sfRename sfPieceQMap 0 phi)) $ = (named '(syl (ax_mp sfTheoryProvable_mp (sfPieceMonoCollection_pure hf)) (pcmc_prelude_rule ht)));
