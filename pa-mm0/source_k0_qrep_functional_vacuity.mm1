import "source_k0_qrep_functional_allocated.mm1";

import "k218q_bound_vacuity.mm1";

pub theorem sfK0QRepCanonicalFunctional_vacuity (E: set) (n t k phi: nat) (hf: $ sfBound (suc (suc n)) phi $):
 $ k218QProvable (kImp (sfK0QRepCanonicalFunctional E t k phi) (kAll k (sfK0QRepCanonicalFunctional E t k phi))) $ =
'(k218QBound_all_vacuity (mpbir kBinderAbsent_kImp (ian kBinderAbsent_kMem (ax_mp (ax_mp kBinderAbsent_all_intro (ltne ltsucid)) (mpbir kBinderAbsent_kImp (ian kBinderAbsent_kMem (ax_mp (ax_mp kBinderAbsent_all_intro (ltne (lttr ltsucid ltsucid))) (mpbir kBinderAbsent_kImp (ian kBinderAbsent_kMem (mpbir kBinderAbsent_kImp (ian (ax_mp (sqQuote_binder_absent (lttr ltsucid (lttr ltsucid ltsucid))) (ax_mp sfBound_wf hf)) (mpbir kBinderAbsent_kImp (ian (ax_mp (sqQuote_binder_absent (lttr ltsucid (lttr ltsucid ltsucid))) (ax_mp sfBound_wf hf)) (sqEqual_binder_absent (lttr ltsucid (lttr ltsucid ltsucid))))))))))))))));

pub theorem sfK0QRepMarkerFunctional_vacuity (E: set) (n k phi: nat) (hf: $ sfBound (suc (suc n)) phi $) (hk: $ 2 < k $):
 $ k218QProvable (kImp (kAnd kEmptyMarker (sfK0QRepCanonicalFunctional E 1 k phi)) (kAll k (kAnd kEmptyMarker (sfK0QRepCanonicalFunctional E 1 k phi)))) $ =
'(k218IVacuity_negation (k218IVacuity_implication (ax_mp k218QFresh_vacuity (ax_mp (ax_mp kFresh_all_intro (ltner hk)) (mpbir kFresh_kNot (ian (mpbir kFresh_kMem (ian (ltner hk) (ltner (lttr (mpbi ltsuc lt01S) hk)))) (ltner (lttr lt01S (lttr (mpbi ltsuc lt01S) hk))))))) (k218IVacuity_negation (! sfK0QRepCanonicalFunctional_vacuity $ E $ $ n $ $ 1 $ $ k $ $ phi $ hf))));
