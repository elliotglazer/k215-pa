import "bb215_provability_qr_aux.mm0";

-- Q' soundness (lane L07): every member of rank k of a valid ranked set is K215-provable,
-- by induction on k (premises have smaller rank; k215Provable is closed under axioms, MP, Gen).

theorem bb215ProvabilityQR_ih_rename (m c y: nat) {j f f1: nat}: $ A. j (j < y -> A. f (bb215ProvabilityQKD m c j f -> k215Provable f)) -> A. j (j < y -> A. f1 (bb215ProvabilityQKD m c j f1 -> k215Provable f1)) $;

theorem bb215ProvabilityQR_ih_rename2 (m c y: nat) {j f j1 f1: nat}: $ A. j (j < y -> A. f (bb215ProvabilityQKD m c j f -> k215Provable f)) -> A. j1 (j1 < y -> A. f1 (bb215ProvabilityQKD m c j1 f1 -> k215Provable f1)) $;

theorem bb215ProvabilityQR_rank (m c y: nat) {j f: nat}: $ bb215ProvabilityQROk m c -> A. j (j < y -> A. f (bb215ProvabilityQKD m c j f -> k215Provable f)) $;

theorem bb215ProvabilityQR_sound (y: nat): $ bb215ProvabilityQRGraph y -> k215Provable y $;

theorem bb215ProvabilityQR_sound_zero: $ bb215ProvabilityQRGraph 0 -> k215Provable 0 $;
