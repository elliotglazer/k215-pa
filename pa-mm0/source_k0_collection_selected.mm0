import "source_k0_collection_substitution.mm0";

import "source_k0_collection_singleton.mm0";

import "k218q_quantifier_macros.mm0";

theorem sfK0Collection_selected_substitution (E: set) (n b t r a p w x v R psi: nat) (hf: $ sfBound (suc (suc n)) psi $)
 (hx0: $ x != 0 $) (hxR: $ x < R $) (hvR: $ v < R $) (hpR: $ p < R $)
 (hwx: $ w != x $) (htx: $ t != x $) (hax: $ a != x $) (hpx: $ p != x $)
 (hvx: $ v != x $) (hbx: $ b != x $) (he: $ sqEnvAvoid E n x $):
 $ kSubst (kImp (kImp (kImp (kImp (kMem x p) (kImp (kAll R (kImp (kMem R p) (kEq R x))) kF)) kF) (kImp (kImp (kImp (kImp (kImp (kMem t x) (kImp (kMem x a) kF)) kF) (kImp (kImp (kImp (kMem t w) (kImp (sfK0CollectionRel E R w x psi) kF)) kF) kF)) kF) kF)) kF) x v = (kImp (kImp (kImp (kImp (kMem v p) (kImp (kAll R (kImp (kMem R p) (kEq R v))) kF)) kF) (kImp (kImp (kImp (kImp (kImp (kMem t v) (kImp (kMem v a) kF)) kF) (kImp (kImp (kImp (kMem t w) (kImp (sfK0CollectionRel E R w v psi) kF)) kF) kF)) kF) kF)) kF) $;

theorem sfK0Collection_selected_exists_intro (E: set) (n b t r a p w x v R psi: nat) (hf: $ sfBound (suc (suc n)) psi $)
 (hx0: $ x != 0 $) (hxR: $ x < R $) (hvR: $ v < R $) (hpR: $ p < R $)
 (hwx: $ w != x $) (htx: $ t != x $) (hax: $ a != x $) (hpx: $ p != x $)
 (hvx: $ v != x $) (hbx: $ b != x $) (he: $ sqEnvAvoid E n x $):
 $ k218QProvable (kImp (kImp (kImp (kImp (kImp (kMem v p) (kImp (kAll R (kImp (kMem R p) (kEq R v))) kF)) kF) (kImp (kImp (kImp (kImp (kImp (kMem t v) (kImp (kMem v a) kF)) kF) (kImp (kImp (kImp (kMem t w) (kImp (sfK0CollectionRel E R w v psi) kF)) kF) kF)) kF) kF)) kF) (kImp (kAll x (kImp (kImp (kImp (kImp (kImp (kMem x p) (kImp (kAll R (kImp (kMem R p) (kEq R x))) kF)) kF) (kImp (kImp (kImp (kImp (kImp (kMem t x) (kImp (kMem x a) kF)) kF) (kImp (kImp (kImp (kMem t w) (kImp (sfK0CollectionRel E R w x psi) kF)) kF) kF)) kF) kF)) kF) kF)) kF)) $;

theorem sfK0Collection_selected_seed (E: set) (n b t r a p w x v R psi: nat) (hf: $ sfBound (suc (suc n)) psi $)
 (hx0: $ x != 0 $) (hxR: $ x < R $) (hvR: $ v < R $) (hpR: $ p < R $)
 (hwx: $ w != x $) (htx: $ t != x $) (hax: $ a != x $) (hpx: $ p != x $)
 (hvx: $ v != x $) (hbx: $ b != x $) (he: $ sqEnvAvoid E n x $):
 $ k218QProvable (kImp (kImp (kImp (kImp (kImp (kMem v p) (kImp (kAll R (kImp (kMem R p) (kEq R v))) kF)) kF) (kImp (kImp (kImp (kImp (kImp (kMem t v) (kImp (kMem v a) kF)) kF) (kImp (kImp (kImp (kMem t w) (kImp (sfK0CollectionRel E R w v psi) kF)) kF) kF)) kF) kF)) kF) (kImp (kImp (kImp (kImp (kEq p r) (kImp (kEq w b) kF)) kF) kF) (kImp (kImp (kImp (kImp (kEq p t) (kImp (kEq w t) kF)) kF) kF) (kImp (kAll x (kImp (kImp (kImp (kImp (kImp (kMem x p) (kImp (kAll R (kImp (kMem R p) (kEq R x))) kF)) kF) (kImp (kImp (kImp (kImp (kImp (kMem t x) (kImp (kMem x a) kF)) kF) (kImp (kImp (kImp (kMem t w) (kImp (sfK0CollectionRel E R w x psi) kF)) kF) kF)) kF) kF)) kF) kF)) kF)))) $;

theorem sfK0Collection_singleton_subset (E: set) (n b t r a p w x v R psi: nat) (hf: $ sfBound (suc (suc n)) psi $)
 (hx0: $ x != 0 $) (hxR: $ x < R $) (hvR: $ v < R $) (hpR: $ p < R $)
 (hwx: $ w != x $) (htx: $ t != x $) (hax: $ a != x $) (hpx: $ p != x $)
 (hvx: $ v != x $) (hbx: $ b != x $) (he: $ sqEnvAvoid E n x $):
 $ k218QProvable (kImp (kImp (kImp (kMem v p) (kImp (kAll R (kImp (kMem R p) (kEq R v))) kF)) kF) (kImp (kMem v b) (kAll x (kImp (kMem x p) (kMem x b))))) $;
