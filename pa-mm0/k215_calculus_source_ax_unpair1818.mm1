@_ def k215UnpairAt1818State (pc a b n c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) n (k215PR3 c) (k215PR4 c) (k215PR5 c) a b (k215PR8 c)) $;

do (apply (register-eqd 'k215UnpairAt1818State) '(k215UnpairAt1818Stateeqd));

theorem k215UnpairAt1818Transfer (b n c: nat): $ k215PIter (3 * b + 1) (k215UnpairAt1818State k215PNum1822 0 b n c) = (k215UnpairAt1818State k215PNum1825 b 0 n c) $ =
 '(eqtr k215Loop1822Vector (k215PStateeq2 (k215PVectoreq7 add0)));
theorem k215UnpairAt1818ReachTransfer (b n c: nat): $ k215PReach (k215UnpairAt1818State k215PNum1822 0 b n c) (k215UnpairAt1818State k215PNum1825 b 0 n c) $ =
 '(k215PReach_intro k215UnpairAt1818Transfer);


theorem k215UnpairAt1818Step9Z (a b c: nat): $ k215PStep (k215UnpairAt1818State k215PNum1818 a b 0 c) = (k215UnpairAt1818State k215PNum1826 a b 0 c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair1818_1818) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt1818Reach9Z (a b c: nat): $ k215PReach (k215UnpairAt1818State k215PNum1818 a b 0 c) (k215UnpairAt1818State k215PNum1826 a b 0 c) $ = '(k215PReach_step k215UnpairAt1818Step9Z);

theorem k215UnpairAt1818Step9S (a b n c: nat): $ k215PStep (k215UnpairAt1818State k215PNum1818 a b (suc n) c) = (k215UnpairAt1818State k215PNum1819 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair1818_1818) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet2_vector)) (eqtr k215PSet2_vector (k215PVectoreq3 (eqtr subSS sub02))))));

theorem k215UnpairAt1818Reach9S (a b n c: nat): $ k215PReach (k215UnpairAt1818State k215PNum1818 a b (suc n) c) (k215UnpairAt1818State k215PNum1819 a b n c) $ = '(k215PReach_step k215UnpairAt1818Step9S);

theorem k215UnpairAt1818Step10 (a b n c: nat): $ k215PStep (k215UnpairAt1818State k215PNum1819 a b n c) = (k215UnpairAt1818State k215PNum1820 a (suc b) n c) $ = '(eqtr (k215PAtCI k215PLookupUnpair1818_1819) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215UnpairAt1818Reach10 (a b n c: nat): $ k215PReach (k215UnpairAt1818State k215PNum1819 a b n c) (k215UnpairAt1818State k215PNum1820 a (suc b) n c) $ = '(k215PReach_step k215UnpairAt1818Step10);

theorem k215UnpairAt1818Step11Z (b n c: nat): $ k215PStep (k215UnpairAt1818State k215PNum1820 0 b n c) = (k215UnpairAt1818State k215PNum1822 0 b n c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair1818_1820) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt1818Reach11Z (b n c: nat): $ k215PReach (k215UnpairAt1818State k215PNum1820 0 b n c) (k215UnpairAt1818State k215PNum1822 0 b n c) $ = '(k215PReach_step k215UnpairAt1818Step11Z);

theorem k215UnpairAt1818Step11S (a b n c: nat): $ k215PStep (k215UnpairAt1818State k215PNum1820 (suc a) b n c) = (k215UnpairAt1818State k215PNum1821 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair1818_1820) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215UnpairAt1818Reach11S (a b n c: nat): $ k215PReach (k215UnpairAt1818State k215PNum1820 (suc a) b n c) (k215UnpairAt1818State k215PNum1821 a b n c) $ = '(k215PReach_step k215UnpairAt1818Step11S);

theorem k215UnpairAt1818Step12 (a b n c: nat): $ k215PStep (k215UnpairAt1818State k215PNum1821 a b n c) = (k215UnpairAt1818State k215PNum1825 a b n c) $ = '(k215PAtCB k215PLookupUnpair1818_1821);

theorem k215UnpairAt1818Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt1818State k215PNum1821 a b n c) (k215UnpairAt1818State k215PNum1825 a b n c) $ = '(k215PReach_step k215UnpairAt1818Step12);

theorem k215UnpairAt1818Step16 (a b n c: nat): $ k215PStep (k215UnpairAt1818State k215PNum1825 a b n c) = (k215UnpairAt1818State k215PNum1818 a b n c) $ = '(k215PAtCC k215PLookupUnpair1818_1825);

theorem k215UnpairAt1818Reach16 (a b n c: nat): $ k215PReach (k215UnpairAt1818State k215PNum1825 a b n c) (k215UnpairAt1818State k215PNum1818 a b n c) $ = '(k215PReach_step k215UnpairAt1818Step16);

theorem k215UnpairAt1818CycleZero (b n c: nat): $ k215PReach (k215UnpairAt1818State k215PNum1818 0 b (suc n) c) (k215UnpairAt1818State k215PNum1818 (suc b) 0 n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt1818Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt1818Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt1818Reach11Z) (ax_mp (ax_mp k215PReach_trans k215UnpairAt1818ReachTransfer) k215UnpairAt1818Reach16))));
theorem k215UnpairAt1818CycleSucc (a b n c: nat): $ k215PReach (k215UnpairAt1818State k215PNum1818 (suc a) b (suc n) c) (k215UnpairAt1818State k215PNum1818 a (suc b) n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt1818Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt1818Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt1818Reach11S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt1818Reach12) k215UnpairAt1818Reach16))));


theorem k215UnpairAt1818AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt1818State k215PNum1818 0 b (suc n) c) (k215UnpairAt1818State k215PNum1818 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt1818Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215PairDiagonal_rotate)) (eqtr (eqcom sndpr) (sndeq k215PairDiagonal_rotate)) eqid eqid)) k215UnpairAt1818CycleZero);

theorem k215UnpairAt1818AdvanceSucc (a b n c: nat): $ k215PReach (k215UnpairAt1818State k215PNum1818 (suc a) b (suc n) c) (k215UnpairAt1818State k215PNum1818 (fst (suc ((suc a), b))) (snd (suc ((suc a), b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt1818Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215Pair_next)) (eqtr (eqcom sndpr) (sndeq k215Pair_next)) eqid eqid)) k215UnpairAt1818CycleSucc);

pub theorem k215UnpairAt1818Advance (a b n c: nat): $ k215PReach (k215UnpairAt1818State k215PNum1818 a b (suc n) c) (k215UnpairAt1818State k215PNum1818 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
 (named @ induct '(ind) 'a 'k215UnpairAt1818AdvanceZero '(a1i k215UnpairAt1818AdvanceSucc));
@_ abstract def k215UnpairAt1818Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt1818State k215PNum1818 a b n c) (k215UnpairAt1818State k215PNum1826 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
theorem k215UnpairAt1818RunZero (a b c: nat): $ k215UnpairAt1818Run 0 a b c $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt1818Stateeq eqid
     (eqcom (eqtr (fsteq add0) fstpr))
     (eqcom (eqtr (sndeq add0) sndpr)) eqid eqid)) k215UnpairAt1818Reach9Z);
@_ abstract def k215UnpairAt1818Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt1818Run n a b c $;
theorem k215UnpairAt1818Claim_at (n a b c: nat): $ k215UnpairAt1818Claim n c -> k215UnpairAt1818Run n a b c $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215UnpairAt1818CodeStep (a b n: nat): $ (fst (suc (a, b)), snd (suc (a, b))) + n = (a, b) + suc n $ =
 '(eqtr (addeq1 fstsnd) addSass);
theorem k215UnpairAt1818RunInductive (n a b c: nat): $ k215UnpairAt1818Claim n c -> k215UnpairAt1818Run (suc n) a b c $ =
 '(syl (ax_mp k215PReach_trans k215UnpairAt1818Advance)
   (mpbid (a1i (k215PReacheq2 (k215UnpairAt1818Stateeq eqid
     (fsteq k215UnpairAt1818CodeStep) (sndeq k215UnpairAt1818CodeStep) eqid eqid))) k215UnpairAt1818Claim_at));
theorem k215UnpairAt1818Claim_all (n c: nat): $ k215UnpairAt1818Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt1818RunZero)) '(iald @ iald k215UnpairAt1818RunInductive));
pub theorem k215UnpairMacro1818 (n a b c: nat): $ k215PReach (k215UnpairAt1818State k215PNum1818 a b n c) (k215UnpairAt1818State k215PNum1826 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
 '(ax_mp k215UnpairAt1818Claim_at k215UnpairAt1818Claim_all);
pub theorem k215UnpairMacro1818_clean (n c: nat): $ k215PReach (k215UnpairAt1818State k215PNum1818 0 0 n c) (k215UnpairAt1818State k215PNum1826 (fst n) (snd n) 0 c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt1818Stateeq eqid
   (fsteq (eqtr (addeq1 pr0) add01))
   (sndeq (eqtr (addeq1 pr0) add01)) eqid eqid)) k215UnpairMacro1818);


