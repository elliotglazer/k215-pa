import "source_reflection_transfer_tv_role_maps.mm0";

theorem sfTVBallContext_axioms_sub(A:set)(G0 G y n:nat)(ht:$ sfTheoryClosed A $)(h0:$ sfTheoryContext A G0 $)(hg:$ sfContextWf G $)(hs:$ sfContextSub G0 G $): $ sfContextSub G0 (sfTVBallContext G y n) $;

def sfTVPHPoint(D L P k matrix:nat):nat = $ sfImp (sfReflectionLimitProfile L P) (sfImp (sfORBinary L 0 3) (sfImp (sfReflectionTuple sfIdentityMap 4 3 k) (sfReflectionTupleEw sfIdentityMap 4 D matrix 3))) $;

def sfTVPHPointLift(D L P n k matrix:nat):nat = $ sfImp (sfTVLift n (sfReflectionLimitProfile L P)) (sfImp (sfTVLift n (sfORBinary L 0 3)) (sfImp (sfReflectionTuple sfIdentityMap 0 (3 + n) k) (sfReflectionEwAt D matrix (3 + n)))) $;

theorem sfTVPHPoint_normalize(D L P n k matrix:nat)(hd:$ sfBound 1 D $)(hl:$ sfBound 2 L $)(hp:$ sfBound 2 P $)(hm:$ sfWf matrix $): $ sfRename (sfTVRoleMap n) 0 (sfTVPHPoint D L P k matrix) = sfTVPHPointLift D L P n k matrix $;

theorem sfTVPHPoint_in_context(A:set)(D L P n k matrix G0 G y:nat)(ht:$ sfTheoryClosed A $)(h0:$ sfTheoryContext A G0 $)(hg:$ sfContextWf G $)(hs:$ sfContextSub G0 G $)(hd:$ sfBound 1 D $)(hl:$ sfBound 2 L $)(hp:$ sfBound 2 P $)(hm:$ sfWf matrix $)(hPH:$ nsLocal G0 (sfTVPHPoint D L P k matrix) $): $ nsLocal (sfTVBallContext G y n) (sfTVPHPointLift D L P n k matrix) $;
