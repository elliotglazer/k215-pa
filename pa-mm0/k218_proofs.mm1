-- Replayed in the distinct exact SeedG calculus. No K230 proof predicate is assumed.
import "k218_axioms.mm1";

theorem k218Imp_congr (G: wff) (a b c d: nat)
  (h1: $ G -> a = b $) (h2: $ G -> c = d $):
  $ G -> kImp a c = kImp b d $ = '(muleq2d (preqd h1 h2));
theorem k218Imp_congr_left (G: wff) (a b c: nat) (h: $ G -> a = b $):
  $ G -> kImp a c = kImp b c $ = '(k218Imp_congr h eqidd);
theorem k218Imp_congr_right (G: wff) (a b c: nat) (h: $ G -> b = c $):
  $ G -> kImp a b = kImp a c $ = '(k218Imp_congr eqidd h);
theorem k218All_congr (G: wff) (a b c d: nat)
  (h1: $ G -> a = b $) (h2: $ G -> c = d $):
  $ G -> kAll a c = kAll b d $ = '(addeq1d (muleq2d (preqd h1 h2)));
theorem k218All_congr_left (G: wff) (a b c: nat) (h: $ G -> a = b $):
  $ G -> kAll a c = kAll b c $ = '(k218All_congr h eqidd);
theorem k218All_congr_right (G: wff) (a b c: nat) (h: $ G -> b = c $):
  $ G -> kAll a b = kAll a c $ = '(k218All_congr eqidd h);
do (apply (register-eqd 'kImp) '(k218Imp_congr k218Imp_congr_left k218Imp_congr_right));
do (apply (register-eqd 'kAll) '(k218All_congr k218All_congr_left k218All_congr_right));

@_ abstract def k218MpRules (.c .l .b: nat): set =
$ S\ c, {l | c e. k218Axioms \/ E. b (b IN l /\ kImp b c IN l)} $;
@_ abstract def k218GenRules (.c .l .a .b: nat): set =
$ S\ c, {l | E. a E. b (b IN l /\ c = kAll a b)} $;
@_ def k218Rules: set = $ k218MpRules u. k218GenRules $;
@_ def k218Derives (p a: nat): wff = $ traceDerives k218Rules p a $;
@_ def k218Inconsistent (.p: nat): wff = $ E. p k218Derives p kF $;

pub theorem k218MpRules_value {b: nat} (c l: nat):
  $ (c, l) e. k218MpRules <-> c e. k218Axioms \/ E. b (b IN l /\ kImp b c IN l) $ =
(named '(elsabe @ elabed ,eqtac));
pub theorem k218GenRules_value {a b: nat} (c l: nat):
  $ (c, l) e. k218GenRules <-> E. a E. b (b IN l /\ c = kAll a b) $ =
(named '(elsabe @ elabed ,eqtac));

theorem k218List_append_left (a p q: nat): $ a IN p -> a IN p ++ q $ =
'(syl (bi2 lmemappend) orl);
theorem k218List_append_right (a p q: nat): $ a IN q -> a IN p ++ q $ =
'(syl (bi2 lmemappend) orr);

theorem k218MpRules_extend (c l r: nat):
  $ (c, l) e. k218MpRules -> (c, l ++ r) e. k218MpRules $ =
(named '(syl (bi2 k218MpRules_value) @ syl
  (orim2 @ eximi @ iand (syl k218List_append_left anl) (syl k218List_append_left anr))
  (bi1 k218MpRules_value)));
theorem k218GenRules_extend (c l r: nat):
  $ (c, l) e. k218GenRules -> (c, l ++ r) e. k218GenRules $ =
(named '(syl (bi2 k218GenRules_value) @ syl
  (eximi @ eximi @ iand (syl k218List_append_left anl) anr)
  (bi1 k218GenRules_value)));
theorem k218Rules_extend (c l r: nat):
  $ (c, l) e. k218Rules -> (c, l ++ r) e. k218Rules $ =
'(syl (bi2 elun) @ syl (orim k218MpRules_extend k218GenRules_extend) (bi1 elun));
pub theorem k218Rules_stable: $ traceAppendStable k218Rules $ =
(named '(ax_gen @ ax_gen @ ax_gen k218Rules_extend));

theorem k218Rules_axiom (a l: nat): $ a e. k218Axioms -> (a, l) e. k218Rules $ =
(named '(syl elun1 @ syl (bi2 k218MpRules_value) orl));
pub theorem k218Derives_axiom (a: nat): $ a e. k218Axioms -> k218Derives (a : 0) a $ =
'(syl traceDerives_head @ iand (a1i traceValid_nil) k218Rules_axiom);
pub theorem k218Derives_true: $ k218Derives (0 : 0) 0 $ = '(k218Derives_axiom k218Axioms_true);

theorem k218Rules_mp (a b l: nat):
  $ a IN l /\ kImp a b IN l -> (b, l) e. k218Rules $ =
(named '(syl elun1 @ syl (bi2 k218MpRules_value) @ syl orr (iexe ,eqtac)));
theorem k218Valid_append (p q: nat):
  $ traceValid k218Rules p -> traceValid k218Rules q -> traceValid k218Rules (p ++ q) $ =
'(traceValid_append k218Rules_stable);
pub theorem k218Derives_mp (p q a b: nat):
  $ k218Derives p a -> k218Derives q (kImp a b) -> k218Derives (b : (p ++ q)) b $ =
'(exp @ syl traceDerives_head @ iand
  (mpd (syl anl anr) (syl k218Valid_append (syl anl anl)))
  (syl k218Rules_mp @ iand
    (syl k218List_append_left (syl anr anl))
    (syl k218List_append_right (syl anr anr))));

theorem k218GenRules_intro (a b p: nat):
  $ b IN p -> (kAll a b, p) e. k218GenRules $ =
(named '(syl (bi2 k218GenRules_value) @ syl (iexe ,eqtac) @ syl (iexe ,eqtac)
  (iand id (a1i eqid))));
pub theorem k218Derives_gen (p a b: nat):
  $ k218Derives p b -> k218Derives (kAll a b : p) (kAll a b) $ =
'(syl traceDerives_head @ iand anl (syl (syl elun2 k218GenRules_intro) anr));

pub theorem k218Derives_bundle (a b c: nat):
  $ c != a /\ c != b -> k218Derives (k218Bundle a b c : 0) (k218Bundle a b c) $ =
'(syl k218Derives_axiom k218Axioms_bundle);
