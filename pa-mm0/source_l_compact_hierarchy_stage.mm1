pub theorem sfLCompactHierarchyStage_reflection_zfr: $ sfTheoryProvable zfrAxioms (sfReflectionLimitLevelMono sfLUniversalHierarchyRelation) $ = '(sfLReflectionMono_from_compact_local sfLUniversalHierarchyExists_zfr sfLUniversalHierarchyUnique_zfr (sfLCompactHierarchyTrans_from_checked sfLWeakStageTrans_zfr) sfLCompactHierarchyStage_local);
