import "pa_source_interpretation_term_substitution.mm0";

theorem paTermSubstVariable_bound (d n a i: nat): $ paTermBound n a -> i < d + suc n -> paTermBound (d + n) (paTermSubstVariable d a i) $;

theorem paTermSubst_bound (d n a c: nat): $ paTermBound n a -> paTermBound (d + suc n) c -> paTermBound (d + n) (paTermSubst d a c) $;
