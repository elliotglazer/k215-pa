import "k215_literal_runtime_registers.mm0";

theorem k215PIter_zero (s: nat): $ k215PIter 0 s = s $;

theorem k215PIter_succ (n s: nat): $ k215PIter (suc n) s = k215PStep (k215PIter n s) $;

theorem k215PIter_add (m n s: nat): $ k215PIter (m + n) s = k215PIter n (k215PIter m s) $;

def k215PReach (s t: nat) (.n: nat): wff =
 $ E. n k215PIter n s = t $;

theorem k215PReach_intro (n s t: nat):
 $ k215PIter n s = t -> k215PReach s t $;

theorem k215PReach_refl (s: nat): $ k215PReach s s $;

theorem k215PIter_splice (m n s t: nat):
 $ k215PIter m s = t -> k215PIter (m + n) s = k215PIter n t $;

theorem k215PReach_trans (s t u: nat):
 $ k215PReach s t -> k215PReach t u -> k215PReach s u $;

theorem k215PReach_step (s t: nat): $ k215PStep s = t -> k215PReach s t $;
