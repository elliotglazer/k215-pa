import "k218q_quotient_mixed_arbitrary.mm0";

import "source_theory_prefix.mm0";

def k218QOpenCutoff (E: set) (q .i: nat): set = $ \ i, if (i < q) (E @ i) 0 $;

theorem k218QOpen_named (E: set) (q k D p a: nat): $ sfBound q a -> 0 < k -> sqEnvBelow E q k -> sfTheoryContext sfK218K0Axioms D -> k218INamedAt p D a -> k218QProvable (sfNamedTemplate E k 0 a) $;

theorem k218QOpen_trace (E: set) (q k D p a: nat): $ sfBound q a -> 0 < k -> sqEnvBelow E q k -> sfTheoryContext sfK218K0Axioms D -> sfNDFullDerives p (sfSequent D a) -> k218QProvable (sfNamedTemplate E k 0 a) $;

theorem sfK218K0_open_proof (E: set) (q k a: nat): $ sfBound q a -> 0 < k -> sqEnvBelow E q k -> sfTheoryProvable sfK218K0Axioms a -> k218QProvable (sfNamedTemplate E k 0 a) $;

theorem sfK218Kp0_bound_internal (n f: nat): $ sfBound (suc (suc n)) f -> sfBound n (sfK218Kp0 f) $;

theorem sfK218Kp0_closed_internal (n f: nat): $ sfBound (suc (suc n)) f -> sfBound 0 (sfAllPrefix n (sfK218Kp0 f)) $;

theorem sfK218Kp0_source_provable (n f: nat): $ sfBound (suc (suc n)) f -> sfTheoryProvable sfK218K0Axioms (sfK218Kp0 f) $;

theorem k218QSourceKp0_unrestricted (E: set) (n k f: nat): $ sfBound (suc (suc n)) f -> 0 < k -> sqEnvBelow E n k -> k218QProvable (sfNamedTemplate E k 0 (sfK218Kp0 f)) $;
