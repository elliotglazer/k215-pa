@_ def sfWFReplacementRaw (a b c: nat): nat = $ (wfRUniformF27 a b c) $;

@_ def sfWFReplacementGuarded (a b c: nat): nat = $ (wfRUniformF82 a b c) $;

@_ def sfWFReplacementContext (a b c: nat): nat = $ sfWFClosure : (sfWFReplacementRaw a b c : 0) $;

pub theorem sfWFReplacement_local (a b c: nat) (ha: $ sfWf a $) (hb: $ sfWf b $) (hc: $ sfWf c $): $ nsLocal (sfWFReplacementContext a b c) (sfWFReplacementGuarded a b c) $ = '(wfRUniformP151 ha hb hc);

pub theorem sfWFReplacement_theory (T: set) (a b c: nat)
 (ht: $ sfTheoryClosed T $) (ha: $ sfWf a $) (hb: $ sfWf b $) (hc: $ sfWf c $):
 $ sfTheoryProvable T sfWFClosure -> sfTheoryProvable T (sfWFReplacementRaw a b c) ->
   sfTheoryProvable T (sfWFReplacementGuarded a b c) $ =
'(exp @ mpi (sfWFReplacement_local ha hb hc) @ syl (sfTheory_lemma_context ht) @
 syl (bi2 allS) @ iand (syl (bi2 sfTheoryProofClass_value) anl)
  (syl (bi2 allS) @ iand (syl (bi2 sfTheoryProofClass_value) anr) (a1i all0)));

