'(! kProvable_mp $ (kImp (kImp (kEq b bp) (kImp (kEq a b) (kEq ap b))) (kImp (kEq b bp) (kImp (kEq a b) (kEq ap bp)))) $ $ (kImp (kEq a ap) (kImp (kImp (kEq b bp) (kImp (kEq a b) (kEq ap b))) (kImp (kEq b bp) (kImp (kEq a b) (kEq ap bp))))) $ (! kTransportStep250 $ a $ $ ap $ $ b $ $ bp $) (! kPropK $ (kImp (kImp (kEq b bp) (kImp (kEq a b) (kEq ap b))) (kImp (kEq b bp) (kImp (kEq a b) (kEq ap bp)))) $ $ (kEq a ap) $));

theorem kTransportStep252 (a ap b bp: nat): $ kProvable (kImp (kImp (kEq a ap) (kImp (kEq b bp) (kImp (kEq a b) (kEq ap b)))) (kImp (kEq a ap) (kImp (kEq b bp) (kImp (kEq a b) (kEq ap bp))))) $ =
'(! kProvable_mp $ (kImp (kEq a ap) (kImp (kImp (kEq b bp) (kImp (kEq a b) (kEq ap b))) (kImp (kEq b bp) (kImp (kEq a b) (kEq ap bp))))) $ $ (kImp (kImp (kEq a ap) (kImp (kEq b bp) (kImp (kEq a b) (kEq ap b)))) (kImp (kEq a ap) (kImp (kEq b bp) (kImp (kEq a b) (kEq ap bp))))) $ (! kTransportStep251 $ a $ $ ap $ $ b $ $ bp $) (! kPropS $ (kEq a ap) $ $ (kImp (kEq b bp) (kImp (kEq a b) (kEq ap b))) $ $ (kImp (kEq b bp) (kImp (kEq a b) (kEq ap bp))) $));

theorem kTransportStep253 (a ap b bp: nat): $ kProvable (kImp (kEq a ap) (kImp (kEq b bp) (kImp (kEq a b) (kEq ap bp)))) $ =
'(! kProvable_mp $ (kImp (kEq a ap) (kImp (kEq b bp) (kImp (kEq a b) (kEq ap b)))) $ $ (kImp (kEq a ap) (kImp (kEq b bp) (kImp (kEq a b) (kEq ap bp)))) $ (! kTransportStep240 $ a $ $ ap $ $ b $ $ bp $) (! kTransportStep252 $ a $ $ ap $ $ b $ $ bp $));

pub theorem kEquality_equal_transport (a ap b bp: nat): $ kProvable (kImp (kEq a ap) (kImp (kEq b bp) (kImp (kEq a b) (kEq ap bp)))) $ =
'(! kTransportStep253 $ a $ $ ap $ $ b $ $ bp $);

pub theorem kTransport_refl (h a: nat):
  $ kProvable (kImp h (kImp a a)) $ =
'(kProvable_mp kPropI kPropK);

pub theorem kTransport_all (h z a b: nat)
  (hv: $ kProvable (kImp h (kAll z h)) $)
  (hab: $ kProvable (kImp h (kImp a b)) $):
  $ kProvable (kImp h (kImp (kAll z a) (kAll z b))) $ =
'(kProvable_syl (kProvable_syl hv (kAll_mono hab)) (kProvable_axiom kAxioms_rho2));
