@_ abstract def bb215ArithmeticFormulaHalvingGraph (a q r: nat): wff = $ (r = 0 \/ r = 1) /\ 2 * q + r = a $;

@_ abstract def bb215ArithmeticFormulaHalvingCode: nat = $ paFormulaAnd (paFormulaOr (paFormulaEqual (paTermVariable 2) (paTermZero)) (paFormulaEqual (paTermVariable 2) (paTermSuccessor (paTermZero)))) (paFormulaEqual (paTermAddition (paTermMultiplication (paTermSuccessor (paTermSuccessor (paTermZero))) (paTermVariable 1)) (paTermVariable 2)) (paTermVariable 0)) $;

@_ abstract def bb215ArithmeticFormulaHalvingSource: nat = $ sfAnd (sfOr (paSourceFormulaEqual (paSourceTermVariable 2) (paSourceTermZero)) (paSourceFormulaEqual (paSourceTermVariable 2) (paSourceTermSuccessor (paSourceTermZero)))) (paSourceFormulaEqual (paSourceTermAddition (paSourceTermMultiplication (paSourceTermSuccessor (paSourceTermSuccessor (paSourceTermZero))) (paSourceTermVariable 1)) (paSourceTermVariable 2)) (paSourceTermVariable 0)) $;

pub theorem bb215ArithmeticFormulaHalvingGraph_correct (a q r: nat): $ bb215ArithmeticFormulaHalvingGraph a q r <-> a // 2 = q /\ a % 2 = r $ = (named '(ibii (eqdivmod (syl (bi2 bool01) anl) anr) (iand (mpbid (oreqd (eqeq1d anr) (eqeq1d anr)) (a1i (mpbi bool01 (modlt d2ne0)))) (eqtr3d (addeqd (muleq2d anl) anr) (a1i divmod)))));

pub theorem bb215ArithmeticFormulaHalvingCode_bound: $ paFormulaBound 3 bb215ArithmeticFormulaHalvingCode $ = (named '(mpbir paFormulaBound_and (ian (mpbir paFormulaBound_or (ian (mpbir paFormulaBound_equal (ian (mpbir paTermBound_variable ltsucid) paTermBound_zero)) (mpbir paFormulaBound_equal (ian (mpbir paTermBound_variable ltsucid) (mpbir paTermBound_successor paTermBound_zero))))) (mpbir paFormulaBound_equal (ian (mpbir paTermBound_addition (ian (mpbir paTermBound_multiplication (ian (mpbir paTermBound_successor (mpbir paTermBound_successor paTermBound_zero)) (mpbir paTermBound_variable (ltletr ltsucid lesucid)))) (mpbir paTermBound_variable ltsucid))) (mpbir paTermBound_variable lt01S))))));

pub theorem bb215ArithmeticFormulaHalvingCode_satisfies (E: set): $ bb215ArithmeticFormulaQFSat E bb215ArithmeticFormulaHalvingCode <-> bb215ArithmeticFormulaHalvingGraph (E @ 0) (E @ 1) (E @ 2) $ = (named '(bitr bb215ArithmeticFormulaQFSat_and (aneq (bitr bb215ArithmeticFormulaQFSat_or (oreq (bitr bb215ArithmeticFormulaQFSat_equal (eqeq bb215ArithmeticFormulaTermValue_variable bb215ArithmeticFormulaTermValue_zero)) (bitr bb215ArithmeticFormulaQFSat_equal (eqeq bb215ArithmeticFormulaTermValue_variable (eqtr bb215ArithmeticFormulaTermValue_successor (suceq bb215ArithmeticFormulaTermValue_zero)))))) (bitr bb215ArithmeticFormulaQFSat_equal (eqeq (eqtr bb215ArithmeticFormulaTermValue_addition (addeq (eqtr bb215ArithmeticFormulaTermValue_multiplication (muleq (eqtr bb215ArithmeticFormulaTermValue_successor (suceq (eqtr bb215ArithmeticFormulaTermValue_successor (suceq bb215ArithmeticFormulaTermValue_zero)))) bb215ArithmeticFormulaTermValue_variable)) bb215ArithmeticFormulaTermValue_variable)) bb215ArithmeticFormulaTermValue_variable)))));

pub theorem bb215ArithmeticFormulaHalvingCode_represents (E: set): $ bb215ArithmeticFormulaQFSat E bb215ArithmeticFormulaHalvingCode <-> (E @ 0) // 2 = E @ 1 /\ (E @ 0) % 2 = E @ 2 $ = (named '(bitr bb215ArithmeticFormulaHalvingCode_satisfies bb215ArithmeticFormulaHalvingGraph_correct));

pub theorem bb215ArithmeticFormulaHalvingSource_exact: $ paFormulaSource bb215ArithmeticFormulaHalvingCode = bb215ArithmeticFormulaHalvingSource $ = (named '(eqtr paFormulaSource_and (sfAndeq (eqtr paFormulaSource_or (sfOreq (eqtr paFormulaSource_equal (paSourceFormulaEqualeq paTermSource_variable paTermSource_zero)) (eqtr paFormulaSource_equal (paSourceFormulaEqualeq paTermSource_variable (eqtr paTermSource_successor (paSourceTermSuccessoreq paTermSource_zero)))))) (eqtr paFormulaSource_equal (paSourceFormulaEqualeq (eqtr paTermSource_addition (paSourceTermAdditioneq (eqtr paTermSource_multiplication (paSourceTermMultiplicationeq (eqtr paTermSource_successor (paSourceTermSuccessoreq (eqtr paTermSource_successor (paSourceTermSuccessoreq paTermSource_zero)))) paTermSource_variable)) paTermSource_variable)) paTermSource_variable)))));

pub theorem bb215ArithmeticFormulaHalvingSource_bound: $ sfBound 3 bb215ArithmeticFormulaHalvingSource $ = (named '(mpbi (sfBoundeq2 bb215ArithmeticFormulaHalvingSource_exact) (paFormulaSource_bound bb215ArithmeticFormulaHalvingCode_bound)));
