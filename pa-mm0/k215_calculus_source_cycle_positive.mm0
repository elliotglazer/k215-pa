import "k215_calculus_source_decode.mm0";
import "k215_literal_runtime_progress.mm0";

theorem k215PReach_split (s t: nat):
 $ k215PReach s t -> (s = t \/ k215PProgress s t) $;

theorem k215PReach_positive_ne (s t: nat):
 $ s != t -> k215PReach s t -> k215PProgress s t $;

theorem k215PDecodeEnum_positive (s: nat):
 $ k215PProgress (k215PEnumConfig s) (k215PDecodedConfig s) $;

theorem k215PEnumConfig_status (s: nat):
 $ k215PStatus (k215PEnumConfig s) = 1 $;
