import "k218_source_core.mm0";
import "zfc_schemas.mm0";

theorem sfK218RequestMap_upper (i: nat): $ sfK218RequestMap @ i <= i + 1 $;

theorem sfK218RequestMap_bound (n i: nat): $ i < (suc (suc n)) -> sfK218RequestMap @ i < (suc (suc (suc n))) $;

theorem sfK218SupportMap_upper (i: nat): $ sfK218SupportMap @ i <= i + 2 $;

theorem sfK218SupportMap_bound (n i: nat): $ i < (suc (suc n)) -> sfK218SupportMap @ i < (suc (suc (suc (suc n)))) $;

theorem sfK218ClosureInputMap_upper (i: nat): $ sfK218ClosureInputMap @ i <= i + 4 $;

theorem sfK218ClosureInputMap_bound (n i: nat): $ i < (suc (suc n)) -> sfK218ClosureInputMap @ i < (suc (suc (suc (suc (suc (suc n)))))) $;

theorem sfK218ClosureOutputMap_upper (i: nat): $ sfK218ClosureOutputMap @ i <= i + 5 $;

theorem sfK218ClosureOutputMap_bound (n i: nat): $ i < (suc (suc n)) -> sfK218ClosureOutputMap @ i < (suc (suc (suc (suc (suc (suc (suc n))))))) $;

theorem sfK218KpRequestMap_upper (i: nat): $ sfK218KpRequestMap @ i <= i + 2 $;

theorem sfK218KpRequestMap_bound (n i: nat): $ i < (suc (suc n)) -> sfK218KpRequestMap @ i < (suc (suc (suc (suc n)))) $;

theorem sfK218EmittedClosure_bound (n phi: nat) (hf: $ sfBound (suc (suc n)) phi $): $ sfBound (suc (suc n)) (sfK218EmittedClosure phi) $;

theorem sfK218SeededCore_bound (n phi: nat) (hf: $ sfBound (suc (suc n)) phi $): $ sfBound n (sfK218SeededCore phi) $;

theorem sfK218Kp0_bound (n phi: nat) (hf: $ sfBound (suc (suc n)) phi $): $ sfBound n (sfK218Kp0 phi) $;

theorem sfK218SeededCore_closed (n phi: nat) (hf: $ sfBound (suc (suc n)) phi $): $ sfBound 0 (sfAllPrefix n (sfK218SeededCore phi)) $;

theorem sfK218Kp0_closed (n phi: nat) (hf: $ sfBound (suc (suc n)) phi $): $ sfBound 0 (sfAllPrefix n (sfK218Kp0 phi)) $;
