import "source_named_renaming.mm0";

import "source_quotient_bounds.mm0";

import "quotation_environment.mm0";

theorem sfQuotientMem_named (E: set) (z a b k: nat): $ sfNamedTemplate E k 0 (sfQuotientMem z a b) = sqMember (E @ z) (E @ a) (E @ b) k $;

theorem sqQuote_mem_zero (E: set) (t k a b: nat): $ sqQuote E t k 0 (sfMem a b) = sqMember t (E @ a) (E @ b) k $;

theorem sfQuotient_mem_quote (E: set) (z a b k: nat): $ sfNamedTemplate E k 0 (sfQuotient z (sfMem a b)) = sqQuote E (E @ z) k 0 (sfMem a b) $;

theorem sfQuotientEq_named (E: set) (z a b k: nat): $ sfNamedTemplate E k 0 (sfQuotientEq z a b) = sqEqual (E @ z) (E @ a) (E @ b) k $;

theorem sqQuote_eq_zero (E: set) (t k a b: nat): $ sqQuote E t k 0 (sfEq a b) = sqEqual t (E @ a) (E @ b) k $;

theorem sfQuotient_eq_quote (E: set) (z a b k: nat): $ sfNamedTemplate E k 0 (sfQuotient z (sfEq a b)) = sqQuote E (E @ z) k 0 (sfEq a b) $;
