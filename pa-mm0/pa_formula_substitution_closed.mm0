import "pa_source_interpretation_formula_eqd_support.mm0";

import "pa_formula_induction.mm0";

import "pa_formula_substitution.mm0";

import "pa_source_interpretation_term_induction.mm0";

def paFormulaSubstClosedTermClass (d a: nat) (.c: nat): set = $ {c | paTermSubst d a c = c} $;

theorem paTermSubst_closed (d a c: nat): $ paTermBound d c -> paTermSubst d a c = c $;

def paFormulaSubstClosedClass (a: nat) (.n .c .d: nat): set = $ S\ n, {c | A. d (paFormulaBound d c -> paFormulaSubst d a c = c)} $;

theorem paFormulaSubst_closed (d a c: nat): $ paFormulaBound d c -> paFormulaSubst d a c = c $;
