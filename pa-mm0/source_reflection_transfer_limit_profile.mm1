import "source_reflection_transfer_witness_geometry.mm1";

import "source_reflection_limit_kernel.mm1";

pub theorem sfReflectionLimitProfile_next_eq(level P:nat): $ rflF257 level P = sfReflectionPHNextOn level P 1 $ = (named 'eqid);

pub theorem sfReflectionLimitProfile_ordinals_eq(level P:nat): $ rflF209 level P = sfReflectionCofinalOrdinals 1 $ = (named 'eqid);

pub theorem sfReflectionLimitProfile_member(G level P:nat)(h:$ nsLocal G (sfReflectionLimitProfile level P) $): $ nsLocal G (sfMem 2 1) $ = (named '(ax_mp nsLocal_CE1 (ax_mp nsLocal_CE1 h)));

pub theorem sfReflectionLimitProfile_ordinals(G level P:nat)(h:$ nsLocal G (sfReflectionLimitProfile level P) $): $ nsLocal G (sfReflectionCofinalOrdinals 1) $ = (named '(mpbi (nsLocal_formula_eq sfReflectionLimitProfile_ordinals_eq) (ax_mp nsLocal_CE2 (ax_mp nsLocal_CE1 h))));

pub theorem sfReflectionLimitProfile_next(G level P:nat)(h:$ nsLocal G (sfReflectionLimitProfile level P) $): $ nsLocal G (sfReflectionPHNextOn level P 1) $ = (named '(mpbi (nsLocal_formula_eq sfReflectionLimitProfile_next_eq) (ax_mp nsLocal_CE1 (ax_mp nsLocal_CE2 h))));

pub theorem sfReflectionPH_from_limit_profile(T F:set)(G start domain level sb sc n i z:nat)(hd:$ sfBound 1 domain $)(hl:$ sfBound 2 level $)(hv:$ sfPieceTableValid sb sc n $)(hi:$ i < n $)(hProfile:$ nsLocal G (sfReflectionLimitProfile level (sfPieceBinary domain (sfReflectionPCLevel level) sb sc n)) $)(hLE:$ nsLocal G (sfReflectionCondLevelExists level) $)(hCover:$ nsLocal G (sfReflectionCofinalCover level 1 z) $)(hMerge:$ nsLocal G (sfReflectionCofinalMergeLaw level 1) $)(hT:$ nsLocal G (sfReflectionTuple T start z (sfPieceCount sb sc i)) $)(hS:$ nsLocal G (sfReflectionPHSubsetOn level 1 z) $): $ nsLocal G (sfReflectionTupleEw T start domain (sfPieceMatrix sb sc i) z) $ = (named '(! sfReflectionPH_from $ T $ $ F $ $ G $ $ start $ $ domain $ $ level $ $ sb $ $ sc $ $ n $ $ i $ $ 1 $ $ 2 $ $ z $ hd hl hv hi (sfReflectionLimitProfile_member hProfile) (sfReflectionLimitProfile_ordinals hProfile) hLE hCover hMerge hT (sfReflectionLimitProfile_next hProfile) hS));
