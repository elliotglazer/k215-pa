import "source_l_fixed_family.mm1";

import "source_l_empty.mm1";

pub theorem sfTVLFixedImages_from_actual_images(hTrans:$ sfTheoryProvable zfrAxioms sfLTransitivity $)(hPair:$ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcPair) $)(hUnion:$ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcUnion) $)(hPower:$ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcPower) $)(hOmega:$ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcOmega) $)(hChoice:$ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcChoice) $): $ sfZFCFixedImages zfrAxioms sfLDomain $ = (named '(ax_mp (ax_mp sfLFixedImages_from_remaining hTrans) (ian sfLEmpty_zfr (ian hPair (ian hUnion (ian hPower (ian hOmega hChoice)))))));

pub theorem sfTVLImageFamilies_from_actual_images(hTrans:$ sfTheoryProvable zfrAxioms sfLTransitivity $)(hPair:$ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcPair) $)(hUnion:$ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcUnion) $)(hPower:$ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcPower) $)(hOmega:$ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcOmega) $)(hChoice:$ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcChoice) $)(hSep:$ sfZFCSeparationImages zfrAxioms sfLDomain $)(hRep:$ sfZFCReplacementImages zfrAxioms sfLDomain $): $ sfZFCImageFamilies zfrAxioms sfLDomain $ = (named '(ian (sfTVLFixedImages_from_actual_images hTrans hPair hUnion hPower hOmega hChoice) (ian hSep hRep)));

pub theorem sfTVLRelativeAxioms_from_actual_images(hTrans:$ sfTheoryProvable zfrAxioms sfLTransitivity $)(hPair:$ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcPair) $)(hUnion:$ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcUnion) $)(hPower:$ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcPower) $)(hOmega:$ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcOmega) $)(hChoice:$ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcChoice) $)(hSep:$ sfZFCSeparationImages zfrAxioms sfLDomain $)(hRep:$ sfZFCReplacementImages zfrAxioms sfLDomain $): $ sfRelativeAxiomImages zfcAxioms zfrAxioms sfLDomain $ = (named '(ax_mp sfZFCImageFamilies_relative (ian (sfTVLFixedImages_from_actual_images hTrans hPair hUnion hPower hOmega hChoice) (ian hSep hRep))));
