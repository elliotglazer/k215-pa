-- every set is a subset of itself
def sfOmegaSubRefl: nat = $ omegaTBF13 $;
theorem sfOmegaSubRefl_bound: $ sfBound 0 sfOmegaSubRefl $;
theorem sfOmegaSubRefl_zfr: $ sfTheoryProvable zfrAxioms sfOmegaSubRefl $;
-- ordinals are transitive: x in y in a gives x in a
