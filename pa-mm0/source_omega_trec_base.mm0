theorem sfOmegaOrdElSub_bound: $ sfBound 0 sfOmegaOrdElSub $;
theorem sfOmegaOrdElSub_zfr: $ sfTheoryProvable zfrAxioms sfOmegaOrdElSub $;
-- members of ordinals are ordinals
