theorem sfOmegaOrdTr_bound: $ sfBound 0 sfOmegaOrdTr $;
theorem sfOmegaOrdTr_zfr: $ sfTheoryProvable zfrAxioms sfOmegaOrdTr $;
-- a member of an ordinal is a subset of it
