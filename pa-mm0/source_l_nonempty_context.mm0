import "source_contexts.mm0";

theorem sfLNEContext_skip (a G D: nat) (h: $ sfContextSub G D $):
  $ sfContextSub G (a : D) $;
theorem sfLNEContext_adjoin (a G D: nat)
  (ha: $ a IN D $) (h: $ sfContextSub G D $):
  $ sfContextSub (a : G) D $;
theorem sfLNEContext_keep (a G D: nat) (h: $ sfContextSub G D $):
  $ sfContextSub (a : G) (a : D) $;
