pub theorem k218Vacuity_universal (x y p: nat)
  (hv: $ k218Provable (kImp p (kAll y p)) $):
  $ k218Provable (kImp (kAll x p) (kAll y (kAll x p))) $ =
'(k218Provable_syl (k218All_mono hv) (k218Provable_axiom k218Axioms_rho4));

pub theorem k218Vacuity_truth (x: nat):
  $ k218Provable (kImp 0 (kAll x 0)) $ =
'(k218Provable_mp (k218Provable_gen (k218Provable_axiom k218Axioms_true)) k218PropK);


pub theorem k218Exists_elimination (x p q: nat)
  (hv: $ k218Provable (kImp q (kAll x q)) $):
  $ k218Provable (kImp (kAll x (kImp p q)) (kImp (kExists x p) q)) $ =
'(k218Provable_syl k218All_exists
  (k218Provable_mp (k218Exists_collapse hv)
    (k218Provable_mp k218PropB k218Cd103)));
