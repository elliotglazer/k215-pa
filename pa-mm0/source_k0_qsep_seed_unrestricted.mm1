theorem qsepOpenProfile (E: set) (n r t b k theta: nat) (hf: $ sfBound (suc n) theta $) (hk0: $ 0 < k $) 
 (hr: $ r < k $) (ht: $ t < k $) (hb: $ b < k $) (he: $ sqEnvBelow E n k $):
 $ k218QProvable (kImp (sfK0QSepSeedFacts r t b (suc (suc (suc (suc k))))) (kImp (kExists (suc (suc k)) (sfK0QSepSeedClauses E r t b (suc (suc k)) (suc (suc (suc k))) (suc (suc (suc (suc k)))) (suc (suc (suc (suc (suc k))))) theta)) (kExists (suc (suc k)) (sfK0QSepSeedProfile E t b (suc (suc k)) k (suc (suc (suc (suc (suc k))))) theta)))) $ =
(named '(! sfK0QSepSeed_profile_exists $ E $ $ n $ $ (suc k) $ $ r $ $ t $ $ b $ $ (suc (suc k)) $ $ (suc k) $ $ k $ $ (suc (suc (suc k))) $ $ (suc (suc (suc (suc k)))) $ $ (suc (suc (suc (suc (suc k))))) $ $ theta $ hf peano1 peano1 qsepOpenLt35 qsepOpenLt45 qsepOpenLt15 qsepOpenLt05 (lttr hb qsepOpenLt05) (lttr ht qsepOpenLt05) (lttr hr qsepOpenLt05) (ltne (lttr hr qsepOpenLt03)) (ltne (lttr ht qsepOpenLt03)) (ltne (lttr hb qsepOpenLt03)) (ltne qsepOpenLt23) (ltner qsepOpenLt34) qsepOpenLt34 qsepOpenLt14 (ltner (lttr hr qsepOpenLt04)) (ltner (lttr ht qsepOpenLt04)) (ltner (lttr hb qsepOpenLt04)) (ltner qsepOpenLt24) (ltner qsepOpenLt14) (ltner qsepOpenLt04) (ax_mp sqEnvBelow_avoid (ax_mp sqEnvBelow_successor (ax_mp sqEnvBelow_successor (ax_mp sqEnvBelow_successor he)))) (ax_mp sqEnvBelow_avoid (ax_mp sqEnvBelow_successor (ax_mp sqEnvBelow_successor (ax_mp sqEnvBelow_successor (ax_mp sqEnvBelow_successor he))))) (ltne qsepOpenLt13) lt01S qsepOpenLt01 peano1 (ltner (lttr hr qsepOpenLt01)) (ltner (lttr ht qsepOpenLt01)) (ltner (lttr hb qsepOpenLt01)) (ltne qsepOpenLt12) (ltner qsepOpenLt01) (ax_mp sqEnvBelow_avoid (ax_mp sqEnvBelow_successor he)) (ltne qsepOpenLt12) (ltne qsepOpenLt13) (ltner qsepOpenLt35) (ltner hk0) (ltner hr) (ltner ht) (ltner hb) (ltne qsepOpenLt02) (ltne qsepOpenLt03) (ax_mp sqEnvBelow_avoid he) (lttr hr qsepOpenLt04) (lttr hb qsepOpenLt04) (lttr ht qsepOpenLt04) peano1 peano1 (ltner (lttr hr qsepOpenLt02)) (ltner (lttr ht qsepOpenLt02)) (ltner (lttr hb qsepOpenLt02))));

theorem qsepOpenEnvironment (E: set) (n r t b k theta: nat) (hf: $ sfBound (suc n) theta $) (hk0: $ 0 < k $) 
 (hr: $ r < k $) (ht: $ t < k $) (hb: $ b < k $) (he: $ sqEnvBelow E n k $):
 $ sqEnvBelow (sqEnvCons b (sqEnvCons t (sqEnvCons r E))) (suc (suc (suc n))) k $ =
'(ax_mp (ax_mp sqEnvBelow_cons hb) (ax_mp (ax_mp sqEnvBelow_cons ht) (ax_mp (ax_mp sqEnvBelow_cons hr) he)));

pub theorem sfK0QSepUnrestricted_clauses (E: set) (n r t b k theta: nat) (hf: $ sfBound (suc n) theta $) (hk0: $ 0 < k $) 
 (hr: $ r < k $) (ht: $ t < k $) (hb: $ b < k $) (he: $ sqEnvBelow E n k $):
 $ k218QProvable (kExists (suc (suc k)) (sfK0QSepSeedClauses E r t b (suc (suc k)) (suc (suc (suc k))) (suc (suc (suc (suc k)))) (suc (suc (suc (suc (suc k))))) theta)) $ =
(named '(! sfK0QSepTaggedWitness_open $ E $ $ n $ $ r $ $ r $ $ t $ $ b $ $ (suc k) $ $ theta $ hf lt01S (ax_mp sqEnvBelow_successor (! qsepOpenEnvironment $ E $ $ n $ $ r $ $ t $ $ b $ $ k $ $ theta $ hf hk0 hr ht hb he)) (lttr hr ltsucid)));

pub theorem sfK0QSepUnrestricted_profile (E: set) (n r t b k theta: nat) (hf: $ sfBound (suc n) theta $) (hk0: $ 0 < k $) 
 (hr: $ r < k $) (ht: $ t < k $) (hb: $ b < k $) (he: $ sqEnvBelow E n k $):
 $ k218QProvable (kImp (sfK0QSepSeedFacts r t b (suc (suc (suc (suc k))))) (kExists (suc (suc k)) (sfK0QSepSeedProfile E t b (suc (suc k)) k (suc (suc (suc (suc (suc k))))) theta))) $ =
(named '(k218IImp_apply_right (sfK0QSepUnrestricted_clauses hf hk0 hr ht hb he) (qsepOpenProfile hf hk0 hr ht hb he)));
