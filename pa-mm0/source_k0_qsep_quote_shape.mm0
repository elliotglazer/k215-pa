import "source_k0_qsep_quotient_rebase.mm0";

import "source_k0_qsep_matrix_alignment.mm0";

import "source_named_renaming.mm0";

def sfK0QSepOpenSeparation (phi: nat): nat =
 $ sfEx (sfAll (sfIff (sfMem 0 1) (sfAnd (sfMem 0 2) (sfRename sfSepMap 0 phi)))) $;

theorem sfK0QSepQuote_renamed (E: set) (t a c z k phi: nat) (hf: $ sfWf phi $):
 $ sqQuote (sqEnvCons z (sqEnvCons c (sqEnvCons a E))) t k 0 (sfRename sfSepMap 0 phi) = sqQuote (sqEnvCons z E) t k 0 phi $;

theorem sfK0QSepQuote_open (E: set) (t a k phi: nat) (hf: $ sfWf phi $):
 $ sqQuote (sqEnvCons a E) t k 0 (sfK0QSepOpenSeparation phi) = kExists k (sfK0QSepQuotientBody E t a k (suc k) (suc (suc k)) (suc (suc k)) phi) $;
