import "source_nd_quantifiers.mm0";

def k218SQ_sqSupportedRowGoal (r S t k H: nat): wff =
 $ ifp (fst r = 0)
 (k218IHypProvable H (sqQuote (sqNumericEnvironment S) t k 0 (snd (snd r))))
 (k218IHypProvable (sqQuote (sqNumericEnvironment S) t k 0 (fst (snd (snd r))) : H)
   (sqQuote (sqNumericEnvironment S) t k 0 (snd (snd (snd (snd r))))) /\
  k218IHypProvable (sqQuote (sqNumericEnvironment S) t k 0 (fst (snd (snd (snd r)))) : H)
   (sqQuote (sqNumericEnvironment S) t k 0 (snd (snd (snd (snd r)))))) $;

def k218SQ_sqSupportedProperty (n r .S .t .k .H: nat): wff =
 $ A. S A. t A. k A. H (sqEnvironmentSafe S n t k -> k218SQ_sqDomainSupport H S t ->
 k218SQ_sqSourceSupport H S t k (fst (snd r)) -> k218SQ_sqSupportedRowGoal r S t k H) $;

def k218SQ_sqSupportedAt (n r: nat): wff =
 $ sfRowWf r /\ (r <= n /\ k218SQ_sqSupportedProperty n r) $;

def k218SQ_sqSupportedGood (r .n: nat): wff = $ E. n k218SQ_sqSupportedAt n r $;

def k218SQ_sqSupportedClass (.r: nat): set = $ {r | k218SQ_sqSupportedGood r} $;

theorem k218SQ_sqSupportedRowGoal_sequent (G a S t k H: nat):
 $ k218SQ_sqSupportedRowGoal (sfSequent G a) S t k H <->
 k218IHypProvable H (sqQuote (sqNumericEnvironment S) t k 0 a) $;

theorem k218SQ_sqSupportedRowGoal_branches (G a b c S t k H: nat):
 $ k218SQ_sqSupportedRowGoal (sfBranches G a b c) S t k H <->
 (k218IHypProvable (sqQuote (sqNumericEnvironment S) t k 0 a : H) (sqQuote (sqNumericEnvironment S) t k 0 c) /\
 k218IHypProvable (sqQuote (sqNumericEnvironment S) t k 0 b : H) (sqQuote (sqNumericEnvironment S) t k 0 c)) $;

theorem k218SQ_sqSupportedProperty_at (n r S t k H: nat):
 $ k218SQ_sqSupportedProperty n r -> sqEnvironmentSafe S n t k -> k218SQ_sqDomainSupport H S t ->
 k218SQ_sqSourceSupport H S t k (fst (snd r)) -> k218SQ_sqSupportedRowGoal r S t k H $;

theorem k218SQ_sqSupportedAt_wf (n r: nat): $ k218SQ_sqSupportedAt n r -> sfRowWf r $;

theorem k218SQ_sqSupportedAt_bound (n r: nat): $ k218SQ_sqSupportedAt n r -> r <= n $;

theorem k218SQ_sqSupportedAt_property (n r: nat):
 $ k218SQ_sqSupportedAt n r -> k218SQ_sqSupportedProperty n r $;

theorem k218SQ_sqSupportedAt_intro (n r: nat):
 $ sfRowWf r -> r <= n -> k218SQ_sqSupportedProperty n r -> k218SQ_sqSupportedAt n r $;

theorem k218SQ_sqSupportedGood_intro (n r: nat): $ k218SQ_sqSupportedAt n r -> k218SQ_sqSupportedGood r $;

theorem k218SQ_sqSupportedGood_wf (r: nat): $ k218SQ_sqSupportedGood r -> sfRowWf r $;

theorem k218SQ_sqSupportedClass_value (r: nat):
 $ r e. k218SQ_sqSupportedClass <-> k218SQ_sqSupportedGood r $;

theorem k218SQ_sqSupportedAt_use (n r S t k H: nat):
 $ k218SQ_sqSupportedAt n r -> sqEnvironmentSafe S n t k -> k218SQ_sqDomainSupport H S t ->
 k218SQ_sqSourceSupport H S t k (fst (snd r)) -> k218SQ_sqSupportedRowGoal r S t k H $;

theorem k218SQ_sqSupportedAt_sequent (n G a S t k H: nat):
 $ k218SQ_sqSupportedAt n (sfSequent G a) -> sqEnvironmentSafe S n t k -> k218SQ_sqDomainSupport H S t ->
 k218SQ_sqSourceSupport H S t k G -> k218IHypProvable H (sqQuote (sqNumericEnvironment S) t k 0 a) $;
