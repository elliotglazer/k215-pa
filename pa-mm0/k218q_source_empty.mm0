import "k218q_empty.mm0";
import "k218q_alpha.mm0";
import "quotation_binders.mm0";
import "zfc_fixed.mm0";

theorem k218QEmpty_inner_alpha (c: nat) (hc: $ 3 < c $):
 $ k218QProvable (kImp (kAll 3 (kNot (kMem 3 c)))
     (kAll (suc c) (kNot (kMem (suc c) c)))) $;

theorem k218QEmpty_source_syntax (E: set) (c: nat):
 $ sfNamedTemplate E c 0 zfcEmpty =
     kExists c (kAll (suc c) (kNot (kMem (suc c) c))) $;

theorem k218QSourceEmpty (E: set):
 $ k218QProvable (sfNamedTemplate E (k218QSeedCode kF) 0 zfcEmpty) $;
