import "source_l_replacement_witness.mm0";
import "source_l_common_level_members.mm0";

theorem sfLReplacementImageCoverage_mono(T:set)(G D psi A B:nat)
 (hd:$ sfBound 1 D $)
 (hp:$ nsLocal G (sfLReplacementImageCoverage T D psi A) $)
 (hs:$ nsLocal G (sfCLSubset A B) $):
 $ nsLocal G (sfLReplacementImageCoverage T D psi B) $;
