import "source_relativization_laws.mm1";
import "source_domain_discharge.mm1";

-- Exact finite Peano contexts; guards are ordered by increasing free index.
@_ def sfDomainAt (D i: nat): nat = $ sfSubst 0 i D $;
@_ def sfDomainStep (D .p: nat): set =
$ \ p, (suc (fst p), snd p |> sfDomainAt D (fst p)) $;
@_ def sfDomainState (D k: nat): nat = $ rec (0, 0) (sfDomainStep D) k $;
@_ def sfDomainGuards (D k: nat): nat = $ snd (sfDomainState D k) $;
@_ def sfRelativizeMap (D .a: nat): set = $ \ a, sfRelativize D a $;
@_ def sfContextRelativize (D G: nat): nat = $ map (sfRelativizeMap D) G $;
@_ def sfRelativeContext (D G k: nat): nat =
$ sfContextRelativize D G ++ sfDomainGuards D k $;
@_ def sfContextBound (k G .a: nat): wff = $ all {a | sfBound k a} G $;

pub theorem sfDomainAt_congr (H: wff) (D E i j: nat)
 (hd: $ H -> D = E $) (hi: $ H -> i = j $):
 $ H -> sfDomainAt D i = sfDomainAt E j $ =
'(sfSubst_congr eqidd hi hd);
do (apply (register-eqd 'sfDomainAt) '(sfDomainAt_congr));

pub theorem sfDomainAt_wf (D i: nat): $ sfWf (sfDomainAt D i) $ = 'sfSubst_wf;
pub theorem sfDomainAt_zero (D: nat):
 $ sfBound 1 D -> sfDomainAt D 0 = D $ = 'sfSubst_bound_top_identity;

pub theorem sfDomainStep_value (D p: nat):
 $ sfDomainStep D @ p = (suc (fst p), snd p |> sfDomainAt D (fst p)) $ =
(named '(!! applame q ,eqtac));
pub theorem sfDomainState_zero (D: nat): $ sfDomainState D 0 = (0, 0) $ = 'rec0;
pub theorem sfDomainState_suc (D k: nat):
 $ sfDomainState D (suc k) =
 (suc (fst (sfDomainState D k)),
  snd (sfDomainState D k) |> sfDomainAt D (fst (sfDomainState D k))) $ =
'(eqtr recS sfDomainStep_value);
pub theorem sfDomainState_index (D k: nat): $ fst (sfDomainState D k) = k $ =
(named @ induct '(ind) 'k
 '(eqtr (fsteq sfDomainState_zero) fstpr)
 '(syl5eq (eqtr (fsteq sfDomainState_suc) fstpr) suceq));
pub theorem sfDomainGuards_zero (D: nat): $ sfDomainGuards D 0 = 0 $ =
'(eqtr (sndeq sfDomainState_zero) sndpr);
pub theorem sfDomainGuards_suc (D k: nat):
 $ sfDomainGuards D (suc k) = sfDomainGuards D k |> sfDomainAt D k $ =
'(eqtr (sndeq sfDomainState_suc) @ eqtr sndpr @
 appendeq2 (conseq1 (trud (sfDomainAt_congr eqidd (a1i sfDomainState_index)))));
pub theorem sfDomainGuards_length (D k: nat): $ len (sfDomainGuards D k) = k $ =
(named @ induct '(ind) 'k
 '(eqtr (leneq sfDomainGuards_zero) len0)
 '(syl5eq (eqtr (leneq sfDomainGuards_suc) snoclen) suceq));
pub theorem sfDomainGuards_wf (D k: nat): $ sfContextWf (sfDomainGuards D k) $ =
(named @ induct '(ind) 'k
 '(mpbir (alleq2 sfDomainGuards_zero) sfContextWf_nil)
 '(sylibr (alleq2 sfDomainGuards_suc) @
  syl (bi2 allsnoc) (iand id (a1i (mpbir sfFormulaClass_value sfDomainAt_wf)))));

pub theorem sfRelativizeMap_value (D a: nat):
 $ sfRelativizeMap D @ a = sfRelativize D a $ =
(named '(!! applame q ,eqtac));
pub theorem sfContextRelativize_zero (D: nat): $ sfContextRelativize D 0 = 0 $ = 'map0;
pub theorem sfContextRelativize_cons (D a G: nat):
 $ sfContextRelativize D (a : G) = sfRelativize D a : sfContextRelativize D G $ =
'(eqtr mapS (conseq1 sfRelativizeMap_value));
pub theorem sfContextRelativize_length (D G: nat):
 $ len (sfContextRelativize D G) = len G $ = 'maplen;
pub theorem sfContextRelativize_wf (D G: nat):
 $ sfWf D -> sfContextWf (sfContextRelativize D G) $ =
(named @ induct '(listind) 'G
 '(a1i (mpbir (alleq2 sfContextRelativize_zero) sfContextWf_nil))
 '(exp @ mpbird (a1i (alleq2 sfContextRelativize_cons)) @
 syl (bi2 sfContextWf_cons) (iand (syl sfRelativize_wf anr) (mpd anr anl))));
pub theorem sfRelativeContext_length (D G k: nat):
 $ len (sfRelativeContext D G k) = len G + k $ =
'(eqtr appendlen (addeq sfContextRelativize_length sfDomainGuards_length));
pub theorem sfRelativeContext_wf (D G k: nat):
 $ sfWf D -> sfContextWf (sfRelativeContext D G k) $ =
'(syl (bi2 sfContextWf_append) (iand sfContextRelativize_wf (a1i sfDomainGuards_wf)));

-- Numeric guard membership, including the exact upper bound.
@_ def sfDomainMember (D k a .i: nat): wff =
 $ E. i (i < k /\ a = sfDomainAt D i) $;
theorem sfDC_range_suc (i k: nat): $ i < suc k <-> i < k \/ i = k $ =
'(bitr (bicom leltsuc) leloe);
theorem sfDC_range_zero (D a: nat): $ ~sfDomainMember D 0 a $ =
(named '(mpbi alnex @ ax_gen @ mt anl lt02));
theorem sfDC_range_suc_member (D k a: nat):
 $ sfDomainMember D (suc k) a <-> sfDomainMember D k a \/ a = sfDomainAt D k $ =
(named '(bitr (exeqi (bitr (aneq1i sfDC_range_suc) andir)) @
 bitr exor @ oreq2i @ exeqe @ eqeq2d (sfDomainAt_congr eqidd id)));
pub theorem sfDomainGuards_member (D k a: nat):
 $ a IN sfDomainGuards D k <-> sfDomainMember D k a $ =
(named @ induct '(ind) 'k
 '(ibii (syl (absurd lmem0) (bi1 (lmemeq2 sfDomainGuards_zero)))
    (absurd sfDC_range_zero))
 '(bitrd (a1i (bitr (lmemeq2 sfDomainGuards_suc) lmemsnoc)) @
 bitrd (oreq1d id) (a1i (bicom sfDC_range_suc_member))));
pub theorem sfDomainAt_shift (D i: nat):
 $ sfBound 1 D -> sfShift 0 (sfDomainAt D i) = sfDomainAt D (suc i) $ =
'(eqtrd (eqcomd (a1i (sfRename_successor sfSubst_wf))) @
 eqtrd (syl sfRename_subst sfBound_wf) @
 sfSubst_congr eqidd (a1i sfSuccessorMap_value) sfRename_bound_identity);

pub theorem sfDC_map_snoc (F: set) (G a: nat):
 $ map F (G |> a) = map F G |> F @ a $ =
(named @ induct '(listind) 'G
 '(eqtr (mapeq2 snoc0) @ eqtr mapS @ eqtr (conseq2 map0) @
 eqcom @ eqtr (snoceq1 map0) snoc0)
 '(eqtrd (a1i (eqtr (mapeq2 snocS) mapS)) @
 eqtrd (conseq2d id) (a1i (eqcom (eqtr (snoceq1 mapS) snocS)))));

-- Guard enlargement is arithmetic, so each inference may choose a fresh bound.
theorem sfDC_guard_mono_at (D k m a i: nat):
 $ k <= m -> (i < k /\ a = sfDomainAt D i) -> sfDomainMember D m a $ =
(named '(exp @ syl (iexe ,eqtac) (iand (ltletrd anrl anl) anrr)));
pub theorem sfDomainMember_mono (D k m a: nat):
 $ k <= m -> sfDomainMember D k a -> sfDomainMember D m a $ =
(named '(eexd sfDC_guard_mono_at));
pub theorem sfDomainGuards_mono (D k m: nat):
 $ k <= m -> sfContextSub (sfDomainGuards D k) (sfDomainGuards D m) $ =
(named '(iald @ syl5bi sfDomainGuards_member @
 sylibrd sfDomainMember_mono (a1i sfDomainGuards_member)));
pub theorem sfDomainGuards_contains (D k i: nat):
 $ i < k -> sfDomainAt D i IN sfDomainGuards D k $ =
(named '(syl (bi2 sfDomainGuards_member) @
 syl (iexe ,eqtac) (iand id (a1i eqid))));
pub theorem sfContextRelativize_member_iff {b: nat} (D G a: nat):
 $ a IN sfContextRelativize D G <-> E. b (b IN G /\ a = sfRelativize D b) $ =
(named '(bitr lmemmap @ exeqi (aneq2i (eqeq2 sfRelativizeMap_value))));
pub theorem sfContextRelativize_member (D G a: nat):
 $ a IN G -> sfRelativize D a IN sfContextRelativize D G $ =
'(mpbid (a1i (lmemeq1 sfRelativizeMap_value)) lmemmapi);
pub theorem sfRelativeContext_member (D G k a: nat):
 $ a IN sfRelativeContext D G k <->
   (a IN sfContextRelativize D G \/ sfDomainMember D k a) $ =
'(bitr lmemappend (oreq2i sfDomainGuards_member));
theorem sfDC_relative_mono_member (D G k m a: nat):
 $ k <= m -> a IN sfRelativeContext D G k -> a IN sfRelativeContext D G m $ =
'(syl5bi sfRelativeContext_member @ sylibrd
 (eord (a1i orl) (syl6 orr sfDomainMember_mono)) (a1i sfRelativeContext_member));
pub theorem sfRelativeContext_mono (D G k m: nat):
 $ k <= m -> sfContextSub (sfRelativeContext D G k) (sfRelativeContext D G m) $ =
(named '(iald sfDC_relative_mono_member));

pub theorem sfContextShift_snoc (G a: nat):
 $ sfContextShift (G |> a) = sfContextShift G |> sfShift 0 a $ =
'(eqtr sfDC_map_snoc (snoceq2 sfShiftMap_value));
theorem sfDC_guard_shift_step (D k: nat):
 $ (sfBound 1 D -> sfDomainGuards D (suc k) = D : sfContextShift (sfDomainGuards D k)) ->
 sfBound 1 D ->
 sfDomainGuards D (suc (suc k)) = D : sfContextShift (sfDomainGuards D (suc k)) $ =
'(exp @ eqtrd (a1i sfDomainGuards_suc) @
 eqtrd (snoceq1d (mpd anr anl)) @ eqtrd (a1i snocS) @
 eqtrd (conseq2d (snoceq2d (eqcomd (syl sfDomainAt_shift anr)))) @
 eqtrd (a1i (conseq2 (eqcom sfContextShift_snoc))) @
 conseq2d (sfContextShift_congr (a1i (eqcom sfDomainGuards_suc))));
pub theorem sfDomainGuards_shift_cons (D k: nat):
 $ sfBound 1 D -> sfDomainGuards D (suc k) = D : sfContextShift (sfDomainGuards D k) $ =
(named @ induct '(ind) 'k
 '(eqtrd (a1i sfDomainGuards_suc) @
 eqtrd (snoceqd (a1i sfDomainGuards_zero) sfDomainAt_zero) @
 eqtrd (a1i snoc0) @
 conseq2d (a1i (eqcom (eqtr (trud (sfContextShift_congr (a1i sfDomainGuards_zero))) sfContextShift_nil))))
 'sfDC_guard_shift_step);

pub theorem sfContextRelativize_congr (H: wff) (D G J: nat)
 (h: $ H -> G = J $):
 $ H -> sfContextRelativize D G = sfContextRelativize D J $ = '(mapeq2d h);
do (apply (register-eqd 'sfContextRelativize) '(sfContextRelativize_congr));
theorem sfDC_rel_shift_cons (H: wff) (D a G: nat)
 (hd: $ H -> sfBound 1 D $) (ha: $ H -> sfWf a $)
 (hg: $ H -> sfContextShift (sfContextRelativize D G) = sfContextRelativize D (sfContextShift G) $):
 $ H -> sfContextShift (sfContextRelativize D (a : G)) =
  sfContextRelativize D (sfContextShift (a : G)) $ =
'(eqtrd (sfContextShift_congr (a1i sfContextRelativize_cons)) @
 eqtrd (a1i sfContextShift_cons) @
 eqtrd (conseqd (sylc sfRelativize_shift hd ha) hg) @
 eqtrd (a1i (eqcom sfContextRelativize_cons)) @
 sfContextRelativize_congr (a1i (eqcom sfContextShift_cons)));
theorem sfDC_rel_shift_step (D a G: nat):
 $ (sfBound 1 D -> sfContextWf G ->
 sfContextShift (sfContextRelativize D G) = sfContextRelativize D (sfContextShift G)) ->
 sfBound 1 D -> sfContextWf (a : G) ->
 sfContextShift (sfContextRelativize D (a : G)) = sfContextRelativize D (sfContextShift (a : G)) $ =
'(exp @ exp @ sfDC_rel_shift_cons anlr
 (syl anl (syl (bi1 sfContextWf_cons) anr))
 (mpd (syl anr (syl (bi1 sfContextWf_cons) anr)) (mpd anlr anll)));
pub theorem sfContextRelativize_shift (D G: nat):
 $ sfBound 1 D -> sfContextWf G ->
 sfContextShift (sfContextRelativize D G) = sfContextRelativize D (sfContextShift G) $ =
(named @ induct '(listind) 'G
 '(a1i (a1i (eqtr (trud (sfContextShift_congr (a1i sfContextRelativize_zero))) @
 eqtr sfContextShift_nil @ eqcom @
 eqtr (trud (sfContextRelativize_congr (a1i sfContextShift_nil))) sfContextRelativize_zero)))
 'sfDC_rel_shift_step);

-- Bounds for guard formulas and their finite context.
pub theorem sfDC_bound_congr (H: wff) (n m a b: nat)
 (hn: $ H -> n = m $) (ha: $ H -> a = b $):
 $ H -> (sfBound n a <-> sfBound m b) $ =
'(srecpeq2d (preqd hn ha));
do (apply (register-eqd 'sfBound) '(sfDC_bound_congr));
theorem sfDC_successor_range (n: nat):
 $ A. i (i < n -> sfSuccessorMap @ i < suc n) $ =
(named '(ax_gen @ sylibr (lteq1 sfSuccessorMap_value) (bi1 ltsuc)));
theorem sfDC_rename_suc_bound (n c: nat):
 $ sfBound n c -> sfBound (suc n) (sfRename sfSuccessorMap 0 c) $ =
(named '(mpbid (a1i (srecpeq2 (preq1 add01)))
 { (syl (ax_mp sfRename_bound sfDC_successor_range) (bi2 (srecpeq2 (preq1 add01)))) :
   $ sfBound n c -> sfBound (0 + suc n) (sfRename sfSuccessorMap 0 c) $ }));
pub theorem sfShift_zero_bound (n c: nat):
 $ sfBound n c -> sfBound (suc n) (sfShift 0 c) $ =
'(mpbid (sfDC_bound_congr eqidd (syl sfRename_successor sfBound_wf)) sfDC_rename_suc_bound);
theorem sfDC_domain_bound_step (D i: nat):
 $ (sfBound 1 D -> sfBound (suc i) (sfDomainAt D i)) ->
 sfBound 1 D -> sfBound (suc (suc i)) (sfDomainAt D (suc i)) $ =
'(exp @ mpbid (sfDC_bound_congr eqidd (syl sfDomainAt_shift anr))
 (syl sfShift_zero_bound (mpd anr anl)));
pub theorem sfDomainAt_bound_self (D i: nat):
 $ sfBound 1 D -> sfBound (suc i) (sfDomainAt D i) $ =
(named @ induct '(ind) 'i
 '(mpbird (sfDC_bound_congr eqidd sfDomainAt_zero) id)
 'sfDC_domain_bound_step);
pub theorem sfDomainAt_bound (D k i: nat):
 $ sfBound 1 D -> i < k -> sfBound k (sfDomainAt D i) $ =
'(exp @ sylc sfBound_mono_le anr
 (syl sfDomainAt_bound_self anl));
pub theorem sfContextBound_nil (k: nat): $ sfContextBound k 0 $ = (named 'all0);
pub theorem sfContextBound_cons (k a G: nat):
 $ sfContextBound k (a : G) <-> sfBound k a /\ sfContextBound k G $ =
(named '(bitr allS @ aneq1i (elabe ,eqtac)));
pub theorem sfContextBound_append (k G J: nat):
 $ sfContextBound k (G ++ J) <-> sfContextBound k G /\ sfContextBound k J $ = (named 'allappend);
theorem sfDC_context_bound_at (k G a: nat):
 $ (A. b (b IN G -> sfBound k b)) -> a IN G -> sfBound k a $ =
(named '(!! eale b ,eqtac));
pub theorem sfContextBound_member (k G a: nat):
 $ sfContextBound k G -> a IN G -> sfBound k a $ =
(named '(syl sfDC_context_bound_at (bi1 allal)));
theorem sfDC_guard_bound_member (D k a: nat):
 $ sfBound 1 D -> a IN sfDomainGuards D k -> sfBound k a $ =
(named '(syl5bi sfDomainGuards_member @ eexd @ exp @
 mpbird (sfDC_bound_congr eqidd anrr)
 (mpd anrl (syl sfDomainAt_bound anl))));
pub theorem sfDomainGuards_bound (D k: nat):
 $ sfBound 1 D -> sfContextBound k (sfDomainGuards D k) $ =
(named '(syl (bi2 allal) @ iald sfDC_guard_bound_member));
theorem sfDC_rel_bound_member (D k G a b: nat):
 $ sfBound 1 D -> sfContextBound k G ->
  (b IN G /\ a = sfRelativize D b) -> sfBound k a $ =
'(exp @ exp @ mpbird (sfDC_bound_congr eqidd anrr)
 (mpd (mpd anrl (syl sfContextBound_member anlr)) (syl sfRelativize_bound anll)));
pub theorem sfContextRelativize_bound (D k G: nat):
 $ sfBound 1 D -> sfContextBound k G -> sfContextBound k (sfContextRelativize D G) $ =
(named '(exp @ syl (bi2 allal) @ iald @
 syl5bi sfContextRelativize_member_iff @
 eexd @ exp @ mpd anr (mpd anlr (syl sfDC_rel_bound_member anll))));
pub theorem sfRelativeContext_bound (D k G: nat):
 $ sfBound 1 D -> sfContextBound k G -> sfContextBound k (sfRelativeContext D G k) $ =
'(exp @ syl (bi2 sfContextBound_append) @
 iand (imp sfContextRelativize_bound) (syl sfDomainGuards_bound anl));

-- Mapping and insertion preserve membership even when list order differs.
pub theorem sfDC_map_append (F: set) (G H: nat):
 $ map F (G ++ H) = map F G ++ map F H $ =
(named @ induct '(listind) 'G
 '(eqtr (mapeq2 append0) @ eqcom @ eqtr (appendeq1 map0) append0)
 '(eqtrd (a1i (eqtr (mapeq2 appendS) mapS)) @
 eqtrd (conseq2d id) (a1i (eqcom (eqtr (appendeq1 mapS) appendS)))));
pub theorem sfContextShift_append (G H: nat):
 $ sfContextShift (G ++ H) = sfContextShift G ++ sfContextShift H $ = 'sfDC_map_append;
theorem sfDC_relative_sub_map (D G H a b: nat):
 $ sfContextSub G H -> (b IN G /\ a = sfRelativize D b) ->
  a IN sfContextRelativize D H $ =
'(exp @ mpbird (lmemeq1d anrr)
 (syl sfContextRelativize_member (mpd anrl (syl sfContextSub_member anl))));
theorem sfDC_rel_map_sub_member (D G H a: nat):
 $ sfContextSub G H -> a IN sfContextRelativize D G -> a IN sfContextRelativize D H $ =
(named '(syl5bi sfContextRelativize_member_iff @ eexd sfDC_relative_sub_map));
theorem sfDC_relative_sub_member (D G H k a: nat):
 $ sfContextSub G H -> a IN sfRelativeContext D G k -> a IN sfRelativeContext D H k $ =
(named '(syl5bi sfRelativeContext_member @ sylibrd
 (eord (syl6 orl sfDC_rel_map_sub_member) (a1i orr))
 (a1i sfRelativeContext_member)));
pub theorem sfRelativeContext_sub (D G H k: nat):
 $ sfContextSub G H -> sfContextSub (sfRelativeContext D G k) (sfRelativeContext D H k) $ =
(named '(iald sfDC_relative_sub_member));
theorem sfDC_insert_member (a b G H: nat):
 $ a IN (G ++ (b : H)) <-> a IN (b : (G ++ H)) $ =
'(bitr lmemappend @ bitr (oreq2i lmemS) @ bitr or12 @
 bitr (oreq2i (bicom lmemappend)) (bicom lmemS));
theorem sfDC_shift_combined (D G k: nat):
 $ sfBound 1 D -> sfContextWf G ->
 sfContextShift (sfRelativeContext D G k) =
  sfContextRelativize D (sfContextShift G) ++ sfContextShift (sfDomainGuards D k) $ =
'(exp @ eqtrd (a1i sfContextShift_append)
 (appendeq1d (imp sfContextRelativize_shift)));
pub theorem sfRelativeContext_shift_member (D G k a: nat):
 $ sfBound 1 D -> sfContextWf G ->
 (a IN sfRelativeContext D (sfContextShift G) (suc k) <->
  a IN (D : sfContextShift (sfRelativeContext D G k))) $ =
'(exp @ bitrd (lmemeq2d (appendeq2d (syl sfDomainGuards_shift_cons anl))) @
 bitrd (a1i sfDC_insert_member) @
 lmemeq2d (conseq2d (eqcomd (imp sfDC_shift_combined))));
pub theorem sfRelativeContext_shift_sub (D G k: nat):
 $ sfBound 1 D -> sfContextWf G ->
 sfContextSub (sfRelativeContext D (sfContextShift G) (suc k))
  (D : sfContextShift (sfRelativeContext D G k)) $ =
(named '(exp @ iald @ bi1d (imp sfRelativeContext_shift_member)));
pub theorem sfRelativeContext_shift_sub_back (D G k: nat):
 $ sfBound 1 D -> sfContextWf G ->
 sfContextSub (D : sfContextShift (sfRelativeContext D G k))
  (sfRelativeContext D (sfContextShift G) (suc k)) $ =
(named '(exp @ iald @ bi2d (imp sfRelativeContext_shift_member)));
