import "k215_calculus_source_ax_stack_loops.mm0";
import "k215_literal_runtime_reach.mm0";
import "k215_calculus_source_pairing.mm0";
import "k215_calculus_source_ax_stack_lookups.mm0";

def k215UnpairAt2801State (pc a b n c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) n (k215PR3 c) (k215PR4 c) (k215PR5 c) a b (k215PR8 c)) $;

theorem k215UnpairAt2801Advance (a b n c: nat): $ k215PReach (k215UnpairAt2801State k215PNum2801 a b (suc n) c) (k215UnpairAt2801State k215PNum2801 (fst (suc (a, b))) (snd (suc (a, b))) n c) $;

def k215UnpairAt2801Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt2801State k215PNum2801 a b n c) (k215UnpairAt2801State k215PNum2809 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;

def k215UnpairAt2801Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt2801Run n a b c $;

theorem k215UnpairMacro2801 (n a b c: nat): $ k215PReach (k215UnpairAt2801State k215PNum2801 a b n c) (k215UnpairAt2801State k215PNum2809 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;

theorem k215UnpairMacro2801_clean (n c: nat): $ k215PReach (k215UnpairAt2801State k215PNum2801 0 0 n c) (k215UnpairAt2801State k215PNum2809 (fst n) (snd n) 0 c) $;
