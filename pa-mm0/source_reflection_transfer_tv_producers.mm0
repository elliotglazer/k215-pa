import "source_reflection_transfer_tv_strict_piece.mm0";

import "source_reflection_transfer_tv_reflection.mm0";

import "source_piece_pcf_function_bound.mm0";

import "source_piece_pcf_level_maps.mm0";

import "source_piece_pcf_level_interfaces.mm0";

theorem sfTVPieceLevelExists_eq: $ sfPieceLevelEx = sfLUniversalHierarchyExists $;

theorem sfTVPieceLevelSubset_eq: $ sfPieceLevelSub = sfLPowerHierarchySubset $;

theorem sfTVCanonicalPiece_pcf(n c:nat): $ (sfTVCanonicalPiece n c) = (sfPieceFunctionBinary sfLDomain sfPieceCanonicalLevel (sfTVEnumRows sfLDomain) (sfTVEnumLength (n + c) c)) $;

theorem sfTVCanonicalPiece_has_ordinal_from_hierarchy(n c:nat)(hE:$ sfTheoryProvable zfrAxioms sfLUniversalHierarchyExists $)(hS:$ sfTheoryProvable zfrAxioms sfLPowerHierarchySubset $): $ sfTheoryProvable zfrAxioms (sfPieceHasOrdinal (sfTVCanonicalPiece n c)) $;

theorem sfTVCanonicalPiece_mono_from_hierarchy(n c:nat)(hE:$ sfTheoryProvable zfrAxioms sfLUniversalHierarchyExists $)(hS:$ sfTheoryProvable zfrAxioms sfLPowerHierarchySubset $): $ sfTheoryProvable zfrAxioms (sfPieceMonoCode (sfTVCanonicalPiece n c)) $;

theorem sfTVCanonicalPiece_strict_bound_from_hierarchy(n c:nat)(hE:$ sfTheoryProvable zfrAxioms sfLUniversalHierarchyExists $)(hS:$ sfTheoryProvable zfrAxioms sfLPowerHierarchySubset $): $ sfTheoryProvable zfrAxioms (sfTVStrictPieceBound (sfTVCanonicalPiece n c)) $;

theorem sfTVCanonicalPiece_cond_bound_from_hierarchy(n c:nat)(hE:$ sfTheoryProvable zfrAxioms sfLUniversalHierarchyExists $)(hS:$ sfTheoryProvable zfrAxioms sfLPowerHierarchySubset $): $ sfTheoryProvable zfrAxioms (sfReflectionCondPiecesBound sfLUniversalHierarchyRelation (sfTVCanonicalPiece n c)) $;

theorem sfTVCanonicalPiece_cond_producers_from_hierarchy(n c:nat)(hE:$ sfTheoryProvable zfrAxioms sfLUniversalHierarchyExists $)(hU:$ sfTheoryProvable zfrAxioms sfLUniversalHierarchyUnique $)(hS:$ sfTheoryProvable zfrAxioms sfLPowerHierarchySubset $): $ sfReflectionCondProducers sfLUniversalHierarchyRelation (sfTVCanonicalPiece n c) $;
