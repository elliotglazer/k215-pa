import "zfc_proof_arithmetic_history_bounds.mm0";

theorem zfcProofArithmeticHistoryNode_pair_le (t a b: nat): $ (a, b) <= sfNode t a b $;

theorem zfcProofArithmeticHistoryNode_left_le (t a b: nat): $ a <= sfNode t a b $;

theorem zfcProofArithmeticHistoryNode_right_le (t a b: nat): $ b <= sfNode t a b $;

theorem zfcProofArithmeticHistoryNodeUpper_depth_bound (d t a b K: nat): $ zfcProofArithmeticQuantifierHistoryCodeNodeUpper d t a b K -> d <= K $;

theorem zfcProofArithmeticHistoryNodeUpper_node_bound (d t a b K: nat): $ zfcProofArithmeticQuantifierHistoryCodeNodeUpper d t a b K -> sfNode t a b <= K $;

theorem zfcProofArithmeticHistoryNodeUpper_left_bound (d t a b K: nat): $ zfcProofArithmeticQuantifierHistoryCodeNodeUpper d t a b K -> a <= K $;

theorem zfcProofArithmeticHistoryNodeUpper_right_bound (d t a b K: nat): $ zfcProofArithmeticQuantifierHistoryCodeNodeUpper d t a b K -> b <= K $;

theorem zfcProofArithmeticHistoryNodeUpper_domain (d t a b K: nat): $ zfcProofArithmeticQuantifierHistoryCodeNodeUpper d t a b K -> d <= K /\ a <= K /\ b <= K $;

theorem zfcProofArithmeticHistoryPairGraph_value_outside (m c i y: nat): $ c <= y -> ~bb215ArithmeticFormulaHistoryPairGraph m c i y $;

theorem zfcProofArithmeticHistoryCell_value_outside (m c d f y: nat): $ c <= y -> ~zfcProofArithmeticQuantifierHistoryCodeCell m c d f y $;
