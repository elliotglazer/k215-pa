import "pa_source_interpretation_term_functional.mm0";

import "pa_source_interpretation_rebase.mm0";

import "source_renaming_agreement.mm0";

theorem paSourceGraphRoleLeft_shift (a: nat): $ sfWf a -> sfRename paSIFormulaLeftMap 0 a = sfShift 0 a $;

theorem paSourceGraphRoleResult_shift (a: nat): $ sfWf a -> sfRename paSITermSuccMap 0 a = sfShift 1 a $;

theorem paSourceTermFunctional_shift_exact (a: nat): $ sfWf a -> paSourceTermFunctional a = sfAll (sfAll (sfImp (sfShift 0 a) (sfImp (sfShift 1 a) (sfEq 1 0)))) $;

theorem paSourceTermSuccessor_shift_exact (a: nat): $ sfWf a -> paSourceTermSuccessor a = sfEx (sfAnd (sfShift 1 a) paSourceSuccessor) $;
