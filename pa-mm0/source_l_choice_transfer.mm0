import "source_l_choice_core.mm0";
import "source_relative_theory.mm0";

theorem sfLChoiceT1_eq: $ sfLChoiceT1 = sfLUniversalHierarchyExists $;

theorem sfLChoiceUnique_eq: $ sfLChoiceUnique = sfLUniversalHierarchyUnique $;

theorem sfLChoice_relative_transfer (a: nat)
 (hi: $ sfRelativeAxiomImages zfrAxioms zfrAxioms sfLDomain $)
 (hN: $ sfTheoryProvable zfrAxioms (sfEx sfLDomain) $)
 (hb: $ sfBound 0 a $) (h: $ sfTheoryProvable zfrAxioms a $):
 $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain a) $;

theorem sfLChoice_from_hierarchy
 (hi: $ sfRelativeAxiomImages zfrAxioms zfrAxioms sfLDomain $)
 (hN: $ sfTheoryProvable zfrAxioms (sfEx sfLDomain) $)
 (hE: $ sfTheoryProvable zfrAxioms sfLUniversalHierarchyExists $)
 (hU: $ sfTheoryProvable zfrAxioms sfLUniversalHierarchyUnique $)
 (h2: $ sfTheoryProvable zfrAxioms sfLChoiceT2 $)
 (hUp: $ sfTheoryProvable zfrAxioms sfLChoiceUp $)
 (hOL: $ sfTheoryProvable zfrAxioms sfLChoiceOrdL $)
 (hOD: $ sfTheoryProvable zfrAxioms sfLChoiceOrdDown $):
 $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcChoice) $;
