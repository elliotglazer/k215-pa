-- Named proof compiler over interpreted equality. No old core image is assumed.
import "k218q_fresh_context.mm1";
import "k218q_rebase.mm1";
import "k218q_named_eigen.mm1";
import "quotation_supported_eigenvariables.mm1";

@_ abstract def k218INamedSupport (H S k G .a: nat): wff =
 $ A. a (a IN G -> k218IHypProvable H (sfNamedTemplate (sqNumericEnvironment S) k 0 a)) $;
pub theorem k218INamedSupport_member (H S k G a: nat):
 $ k218INamedSupport H S k G -> a IN G ->
   k218IHypProvable H (sfNamedTemplate (sqNumericEnvironment S) k 0 a) $ =
(named '(!! eale b ,eqtac));
pub theorem k218INamedSupport_nil (H S k: nat): $ k218INamedSupport H S k 0 $ =
(named '(ax_gen (absurd lmem0)));
theorem k218INS_cons_member (H S k G a b: nat):
 $ k218INamedSupport H S k G -> k218IHypProvable H (sfNamedTemplate (sqNumericEnvironment S) k 0 a) ->
   b IN (a : G) -> k218IHypProvable H (sfNamedTemplate (sqNumericEnvironment S) k 0 b) $ =
'(exp @ syl5bi lmemS (eord
 (exp @ mpbird (k218IHypProvableeq2d (sfNamedTemplateeq4d anr)) anlr)
 (syl k218INamedSupport_member anl)));
pub theorem k218INamedSupport_cons (H S k G a: nat):
 $ k218INamedSupport H S k G -> k218IHypProvable H (sfNamedTemplate (sqNumericEnvironment S) k 0 a) ->
   k218INamedSupport H S k (a : G) $ =
(named '(exp @ !! iald b @ mpd anr (syl k218INS_cons_member anl)));
pub theorem k218INamedSupport_weaken (H S k G a: nat):
 $ k218INamedSupport H S k G -> k218INamedSupport (a : H) S k G $ =
(named '(!! iald b @ syl6 (k218IHypProvable_refine k218IContextSupports_weaken) k218INamedSupport_member));
pub theorem k218INamedSupport_under (H S k G a: nat):
 $ k218INamedSupport H S k G ->
   k218INamedSupport (sfNamedTemplate (sqNumericEnvironment S) k 0 a : H) S k (a : G) $ =
'(mpi (k218IHypProvable_assumption lmemconsid) (syl k218INamedSupport_cons k218INamedSupport_weaken));
pub theorem k218INamedSupport_subset (H S k G J: nat):
 $ sfContextSub G J -> k218INamedSupport H S k J -> k218INamedSupport H S k G $ =
(named '(exp @ !! iald b @ exp @
 mpd (mpd anr (syl sfContextSub_member anll)) (syl k218INamedSupport_member anlr)));

pub theorem k218INamed_numeric_cons (S z k a: nat):
 $ sfWf a -> sfNamedTemplate (sqNumericEnvironment (z : S)) k 0 a =
   sfNamedTemplate (sqEnvCons z (sqNumericEnvironment S)) k 0 a $ =
'(syl (sfNamedTemplate_environment sqNumericEnvironment_cons_agree) @
 syl (bi2 (srecpeq2 (preq1 add01))) sfWf_code_bound);
pub theorem k218INamed_numeric_shift (S z k a: nat):
 $ sfWf a -> sfNamedTemplate (sqNumericEnvironment (z : S)) k 0 (sfShift 0 a) =
   sfNamedTemplate (sqNumericEnvironment S) k 0 a $ =
'(eqtrd (syl k218INamed_numeric_cons (a1i sfShift_wf)) sfNamedTemplate_source_shift);
theorem k218INS_shift_member (H S z k G a b: nat):
 $ sfContextWf G -> k218INamedSupport H S k G ->
   (b IN G /\ a = sfShift 0 b) ->
   k218IHypProvable H (sfNamedTemplate (sqNumericEnvironment (z : S)) k 0 a) $ =
'(exp @ exp @ mpbird (k218IHypProvableeq2d (sfNamedTemplateeq4d anrr)) @
 mpbird (k218IHypProvableeq2d (syl k218INamed_numeric_shift
   (mpd anrl (syl sfContextWf_member anll)))) @
 mpd anrl (syl k218INamedSupport_member anlr));
theorem k218INS_shift_at (H S z k G a: nat):
 $ sfContextWf G -> k218INamedSupport H S k G -> a IN sfContextShift G ->
   k218IHypProvable H (sfNamedTemplate (sqNumericEnvironment (z : S)) k 0 a) $ =
(named '(exp @ syl5bi sqShift_member_iff @ eexd @ imp k218INS_shift_member));
pub theorem k218INamedSupport_shift (H S z k G: nat):
 $ sfContextWf G -> k218INamedSupport H S k G ->
   k218INamedSupport H (z : S) k (sfContextShift G) $ =
(named '(exp @ !! iald a @ mpd anr (syl k218INS_shift_at anl)));
theorem k218INS_base_member (F: wff) (H S n k l G a: nat)
 (hb: $ F -> sqSourceBound n G $)
 (hk: $ F -> sqEnvironmentSafe S n 0 k $) (hl: $ F -> sqEnvironmentSafe S n 0 l $)
 (hs: $ F -> k218INamedSupport H S k G $) (ha: $ F -> a IN G $):
 $ F -> k218IHypProvable H (sfNamedTemplate (sqNumericEnvironment S) l 0 a) $ =
'(sylc k218IHypProvable_mp (mpd ha (syl k218INamedSupport_member hs))
 (syl k218IHypProvable_seed @ syl anl @
 mpd (iand (syl sqSQ_alloc_below (syl sqEnvironmentSafe_positive hl))
   (syl sqSQ_range_below (syl sqEnvironmentSafe_live_below hl))) @
 mpd (iand (syl sqSQ_alloc_below (syl sqEnvironmentSafe_positive hk))
   (syl sqSQ_range_below (syl sqEnvironmentSafe_live_below hk))) @
 syl k218IsfNamedTemplate_fresh_base_equivalent (mpd ha (syl sqSourceBound_at hb))));
pub theorem k218INamedSupport_rebase (H S n k l G: nat):
 $ sqSourceBound n G -> sqEnvironmentSafe S n 0 k -> sqEnvironmentSafe S n 0 l ->
   k218INamedSupport H S k G -> k218INamedSupport H S l G $ =
(named '(exp @ exp @ exp @ !! iald a @ exp @
 k218INS_base_member (syl anl (syl anl (syl anl anl)))
 (syl anr (syl anl (syl anl anl))) (syl anr (syl anl anl)) (syl anr anl) anr));

@_ abstract def k218INamedAt (p G a .n .S .k .H: nat): wff =
 $ A. n A. S A. k A. H (p <= n -> sqEnvironmentSafe S n 0 k ->
   k218INamedSupport H S k G -> k218IHypProvable H (sfNamedTemplate (sqNumericEnvironment S) k 0 a)) $;
pub theorem k218INamedAt_use (p G a n S k H: nat):
 $ k218INamedAt p G a -> p <= n -> sqEnvironmentSafe S n 0 k ->
   k218INamedSupport H S k G -> k218IHypProvable H (sfNamedTemplate (sqNumericEnvironment S) k 0 a) $ =
(named '(!! ealie v @ !! ealde w @ !! ealde x @ !! ealde y @ bi1d ,eqtac));
