import "k215_calculus_source_ax_pair58.mm1";
import "k215_calculus_source_ax_loops.mm1";

theorem k215PairVectorInAt52 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt58State k215Num58 a6 a1 a7 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215Num58 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215PairVectorOutAt52 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt58State k215Num68 0 0 (a7 + (a6, a1)) (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215Num68 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

pub theorem k215PairMacro46_vectorAt52 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat):
 $ k215PReach (k215PState k215Num58 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215Num68 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ =
 '(mpbi (k215PReacheq k215PairVectorInAt52 k215PairVectorOutAt52) k215PairMacro58);

theorem k215PushAStage0At52 (u t w c a b v: nat): $ k215PReach (k215PState k215Num52 (k215PVector u t w c a b 0 0 v)) (k215PState k215Num55 (k215PVector u 0 w c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop52Vector (k215PStateeq2 (k215PVectoreq7 add0))));

theorem k215PushAStage1At52 (u t w c a b v: nat): $ k215PReach (k215PState k215Num55 (k215PVector u 0 w c a b t 0 v)) (k215PState k215Num58 (k215PVector u w 0 c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop55Vector (k215PStateeq2 (k215PVectoreq2 add0))));

theorem k215PushAStage2At52 (u t w c a b v: nat): $ k215PReach (k215PState k215Num58 (k215PVector u w 0 c a b t 0 v)) (k215PState k215Num68 (k215PVector u 0 0 c a b 0 (t, w) v)) $ = '(mpbi (k215PReacheq2 (k215PStateeq2 (k215PVectoreq8 add01))) k215PairMacro46_vectorAt52);

theorem k215PushAStage3At52 (u t w c a b v: nat): $ k215PReach (k215PState k215Num68 (k215PVector u 0 0 c a b 0 (t, w) v)) (k215PState k215Num71 (k215PVector u 0 (t, w) c a b 0 0 v)) $ = '(k215PReach_intro (eqtr k215Loop68Vector (k215PStateeq2 (k215PVectoreq3 add0))));

theorem k215PushAStage4At52 (u t w c a b v: nat): $ k215PReach (k215PState k215Num71 (k215PVector u 0 (t, w) c a b 0 0 v)) (k215PState k215Num75 (k215PVector u b (t, w) c a 0 b 0 v)) $ = '(k215PReach_intro (eqtr k215Loop71Vector (k215PStateeq2 (k215PVectoreq eqid add0 eqid eqid eqid eqid add0 eqid eqid))));

theorem k215PushAStage5At52 (u t w c a b v: nat): $ k215PReach (k215PState k215Num75 (k215PVector u b (t, w) c a 0 b 0 v)) (k215PState k215Num78 (k215PVector u b (t, w) c a b 0 0 v)) $ = '(k215PReach_intro (eqtr k215Loop75Vector (k215PStateeq2 (k215PVectoreq6 add0))));

pub theorem k215PushParam52 (u t w c a b v: nat):
 $ k215PReach (k215PState k215Num52 (k215PVector u t w c a b 0 0 v)) (k215PState k215Num78 (k215PVector u b (t, w) c a b 0 0 v)) $ = '(ax_mp (ax_mp k215PReach_trans k215PushAStage0At52) (ax_mp (ax_mp k215PReach_trans k215PushAStage1At52) (ax_mp (ax_mp k215PReach_trans k215PushAStage2At52) (ax_mp (ax_mp k215PReach_trans k215PushAStage3At52) (ax_mp (ax_mp k215PReach_trans k215PushAStage4At52) k215PushAStage5At52)))));

