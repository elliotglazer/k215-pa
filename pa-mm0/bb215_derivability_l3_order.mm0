import "bb215_derivability_l3_exintro.mm0";

-- L05, layer L3a (lanes/L05.md): order and cancellation inside PA. s <= t is E. z (s + z = t).
-- Generated by build_bb215_derivability_l2_add_basic.py.

-- s <= t is E. z (s + z = t), with s and t lifted under the binder.

def bb215L3Le (s t: nat): nat = $ (paFormulaEx (paFormulaEqual (paTermAddition (paTermLift 1 s) (paTermVariable 0)) (paTermLift 1 t))) $;

theorem bb215L3_le_intro (n s t r: nat) (hs: $ paTermBound n s $) (ht: $ paTermBound n t $) (hr: $ paTermBound n r $) (h: $ paProvable n (paFormulaEqual (paTermAddition s r) t) $):
  $ paProvable n (bb215L3Le s t) $;

theorem bb215L3_le_refl (n s: nat) (hs: $ paTermBound n s $):
  $ paProvable n (bb215L3Le s s) $;

theorem bb215L3_zero_le (n t: nat) (ht: $ paTermBound n t $):
  $ paProvable n (bb215L3Le paTermZero t) $;

theorem bb215L3_le_add (n s r: nat) (hs: $ paTermBound n s $) (hr: $ paTermBound n r $):
  $ paProvable n (bb215L3Le s (paTermAddition s r)) $;

theorem bb215L3_succ_inj_inst (n s t: nat) (hs: $ paTermBound n s $) (ht: $ paTermBound n t $):
  $ paProvable n (paFormulaImp (paFormulaEqual (paTermSuccessor s) (paTermSuccessor t)) (paFormulaEqual s t)) $;

-- PA |- A. z A. x A. y (x + z = y + z -> x = y)

theorem bb215L3_add_cancel:
  $ paProvable 0 (paFormulaAll (paFormulaAll (paFormulaAll (paFormulaImp (paFormulaEqual (paTermAddition (paTermVariable 1) (paTermVariable 2)) (paTermAddition (paTermVariable 0) (paTermVariable 2))) (paFormulaEqual (paTermVariable 1) (paTermVariable 0)))))) $;

theorem bb215L3_ex_mono (n a b: nat) (ha: $ paFormulaBound (suc n) a $) (hb: $ paFormulaBound (suc n) b $) (h: $ paProvable (suc n) (paFormulaImp a b) $):
  $ paProvable n (paFormulaImp (paFormulaEx a) (paFormulaEx b)) $;
