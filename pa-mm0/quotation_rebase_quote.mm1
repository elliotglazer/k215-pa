import "quotation_rebase.mm1";
import "quotation_quote_hygiene.mm1";
import "quotation_quantifiers.mm1";

@_ abstract def qqBaseClass (E: set) (.c .S .n .t .k .l: nat): set =
 $ {c | A. S A. n A. t A. k A. l (sfBound n c ->
 sqQuoteHygiene (sqStackEnv S E) n t k c ->
 sqQuoteHygiene (sqStackEnv S E) n t l c ->
 kEquivalent (sqQuote (sqStackEnv S E) t k 0 c)
             (sqQuote (sqStackEnv S E) t l 0 c))} $;
theorem qqB_value {S n t k l: nat} (E: set) (c: nat):
 $ c e. qqBaseClass E <-> A. S A. n A. t A. k A. l (sfBound n c ->
 sqQuoteHygiene (sqStackEnv S E) n t k c ->
 sqQuoteHygiene (sqStackEnv S E) n t l c ->
 kEquivalent (sqQuote (sqStackEnv S E) t k 0 c)
             (sqQuote (sqStackEnv S E) t l 0 c)) $ =
(named '(elabe ,eqtac));
theorem qqB_all_at (E: set) (c S n t k l: nat):
 $ (A. R A. p A. z A. q A. r (sfBound p c ->
 sqQuoteHygiene (sqStackEnv R E) p z q c ->
 sqQuoteHygiene (sqStackEnv R E) p z r c ->
 kEquivalent (sqQuote (sqStackEnv R E) z q 0 c)
             (sqQuote (sqStackEnv R E) z r 0 c))) ->
 sfBound n c -> sqQuoteHygiene (sqStackEnv S E) n t k c ->
 sqQuoteHygiene (sqStackEnv S E) n t l c ->
 kEquivalent (sqQuote (sqStackEnv S E) t k 0 c)
             (sqQuote (sqStackEnv S E) t l 0 c) $ =
(named '(!! ealie R @ !! ealde p @ !! ealde z @ !! ealde q @ !! ealde r @ bi1d ,eqtac));
theorem qqB_at (E: set) (c S n t k l: nat):
 $ c e. qqBaseClass E -> sfBound n c ->
 sqQuoteHygiene (sqStackEnv S E) n t k c ->
 sqQuoteHygiene (sqStackEnv S E) n t l c ->
 kEquivalent (sqQuote (sqStackEnv S E) t k 0 c)
             (sqQuote (sqStackEnv S E) t l 0 c) $ =
(named '(syl qqB_all_at (bi1 qqB_value)));
theorem qqB_use (G: wff) (E: set) (c S n t k l: nat)
 (hc: $ G -> c e. qqBaseClass E $) (hb: $ G -> sfBound n c $)
 (hk: $ G -> sqQuoteHygiene (sqStackEnv S E) n t k c $)
 (hl: $ G -> sqQuoteHygiene (sqStackEnv S E) n t l c $):
 $ G -> kEquivalent (sqQuote (sqStackEnv S E) t k 0 c)
                       (sqQuote (sqStackEnv S E) t l 0 c) $ =
'(mpd hl (mpd hk (mpd hb (syl qqB_at hc))));
theorem qqB_transport (G: wff) (a b c d: nat)
 (ha: $ G -> a = c $) (hb: $ G -> b = d $) (he: $ G -> kEquivalent c d $):
 $ G -> kEquivalent a b $ = '(mpbird (kEquivalenteqd ha hb) he);

theorem qqB_bot (E: set): $ sfBot e. qqBaseClass E $ =
(named '(mpbir qqB_value @ ax_gen @ ax_gen @ ax_gen @ ax_gen @ ax_gen @ a1i @ a1i @
 qqB_transport (a1i sqQuote_bot) (a1i sqQuote_bot) (a1i kEquivalent_refl)));
theorem qqB_and_core (G: wff) (E: set) (a b S n t k l: nat)
 (ha: $ G -> a e. qqBaseClass E $) (hb: $ G -> b e. qqBaseClass E $)
 (hs: $ G -> sfBound n (sfAnd a b) $)
 (hk: $ G -> sqQuoteHygiene (sqStackEnv S E) n t k (sfAnd a b) $)
 (hl: $ G -> sqQuoteHygiene (sqStackEnv S E) n t l (sfAnd a b) $):
 $ G -> kEquivalent (sqQuote (sqStackEnv S E) t k 0 (sfAnd a b))
                       (sqQuote (sqStackEnv S E) t l 0 (sfAnd a b)) $ =
'(qqB_transport (a1i sqQuote_sfAnd) (a1i sqQuote_sfAnd) @
 syl kEquivalent_and @ iand
 (qqB_use ha (syl anl (syl (bi1 sfBound_sfAnd) hs))
  (syl (sqQuoteHygiene_subformula (ltlei sfAnd_left_lt)) hk)
  (syl (sqQuoteHygiene_subformula (ltlei sfAnd_left_lt)) hl))
 (qqB_use hb (syl anr (syl (bi1 sfBound_sfAnd) hs))
  (syl (sqQuoteHygiene_subformula (ltlei sfAnd_right_lt)) hk)
  (syl (sqQuoteHygiene_subformula (ltlei sfAnd_right_lt)) hl)));
theorem qqB_and (E: set) (a b: nat):
 $ a e. qqBaseClass E /\ b e. qqBaseClass E -> sfAnd a b e. qqBaseClass E $ =
(named '(mpbird (a1i qqB_value) @ !! iald S @ !! iald n @ !! iald t @ !! iald k @ !! iald l @ exp @ exp @ exp @
 qqB_and_core (syl anl (syl anl (syl anl anl))) (syl anr (syl anl (syl anl anl)))
 (syl anr (syl anl anl)) (syl anr anl) anr));
theorem qqB_or_core (G: wff) (E: set) (a b S n t k l: nat)
 (ha: $ G -> a e. qqBaseClass E $) (hb: $ G -> b e. qqBaseClass E $)
 (hs: $ G -> sfBound n (sfOr a b) $)
 (hk: $ G -> sqQuoteHygiene (sqStackEnv S E) n t k (sfOr a b) $)
 (hl: $ G -> sqQuoteHygiene (sqStackEnv S E) n t l (sfOr a b) $):
 $ G -> kEquivalent (sqQuote (sqStackEnv S E) t k 0 (sfOr a b))
                       (sqQuote (sqStackEnv S E) t l 0 (sfOr a b)) $ =
'(qqB_transport (a1i sqQuote_sfOr) (a1i sqQuote_sfOr) @
 syl kEquivalent_or @ iand
 (qqB_use ha (syl anl (syl (bi1 sfBound_sfOr) hs))
  (syl (sqQuoteHygiene_subformula (ltlei sfOr_left_lt)) hk)
  (syl (sqQuoteHygiene_subformula (ltlei sfOr_left_lt)) hl))
 (qqB_use hb (syl anr (syl (bi1 sfBound_sfOr) hs))
  (syl (sqQuoteHygiene_subformula (ltlei sfOr_right_lt)) hk)
  (syl (sqQuoteHygiene_subformula (ltlei sfOr_right_lt)) hl)));
theorem qqB_or (E: set) (a b: nat):
 $ a e. qqBaseClass E /\ b e. qqBaseClass E -> sfOr a b e. qqBaseClass E $ =
(named '(mpbird (a1i qqB_value) @ !! iald S @ !! iald n @ !! iald t @ !! iald k @ !! iald l @ exp @ exp @ exp @
 qqB_or_core (syl anl (syl anl (syl anl anl))) (syl anr (syl anl (syl anl anl)))
 (syl anr (syl anl anl)) (syl anr anl) anr));
theorem qqB_imp_core (G: wff) (E: set) (a b S n t k l: nat)
 (ha: $ G -> a e. qqBaseClass E $) (hb: $ G -> b e. qqBaseClass E $)
 (hs: $ G -> sfBound n (sfImp a b) $)
 (hk: $ G -> sqQuoteHygiene (sqStackEnv S E) n t k (sfImp a b) $)
 (hl: $ G -> sqQuoteHygiene (sqStackEnv S E) n t l (sfImp a b) $):
 $ G -> kEquivalent (sqQuote (sqStackEnv S E) t k 0 (sfImp a b))
                       (sqQuote (sqStackEnv S E) t l 0 (sfImp a b)) $ =
'(qqB_transport (a1i sqQuote_sfImp) (a1i sqQuote_sfImp) @
 syl kEquivalent_imp @ iand
 (qqB_use ha (syl anl (syl (bi1 sfBound_sfImp) hs))
  (syl (sqQuoteHygiene_subformula (ltlei sfImp_left_lt)) hk)
  (syl (sqQuoteHygiene_subformula (ltlei sfImp_left_lt)) hl))
 (qqB_use hb (syl anr (syl (bi1 sfBound_sfImp) hs))
  (syl (sqQuoteHygiene_subformula (ltlei sfImp_right_lt)) hk)
  (syl (sqQuoteHygiene_subformula (ltlei sfImp_right_lt)) hl)));
theorem qqB_imp (E: set) (a b: nat):
 $ a e. qqBaseClass E /\ b e. qqBaseClass E -> sfImp a b e. qqBaseClass E $ =
(named '(mpbird (a1i qqB_value) @ !! iald S @ !! iald n @ !! iald t @ !! iald k @ !! iald l @ exp @ exp @ exp @
 qqB_imp_core (syl anl (syl anl (syl anl anl))) (syl anr (syl anl (syl anl anl)))
 (syl anr (syl anl anl)) (syl anr anl) anr));
theorem qqB_binary (E: set): $ sfBinaryClosed (qqBaseClass E) $ =
(named '(ax_gen @ ax_gen @ iand (iand qqB_and qqB_or) qqB_imp));
theorem qqB_stack_eval (E: set) (S y n t k c: nat):
 $ sfBound n c -> sqQuote (sqStackEnv (y : S) E) t k 0 c =
 sqQuote (sqEnvCons y (sqStackEnv S E)) t k 0 c $ =
'(syl (sqQuote_environment sqStackEnv_cons_agree) (bi2 (srecpeq2 (preq1 add01))));
theorem qqB_child_equiv (G: wff) (E: set) (S n t k l y c p: nat)
 (hay: $ c < p $)
 (hc: $ G -> c e. qqBaseClass E $) (hb: $ G -> sfBound (suc n) c $)
 (hk: $ G -> sqQuoteHygiene (sqStackEnv S E) n t k p $)
 (hl: $ G -> sqQuoteHygiene (sqStackEnv S E) n t l p $)
 (hky: $ G -> sqAllocAvoid (suc k) (suc (c + sqAllocationMargin)) y $)
 (hly: $ G -> sqAllocAvoid (suc l) (suc (c + sqAllocationMargin)) y $):
 $ G -> kEquivalent
 (sqQuote (sqEnvCons y (sqStackEnv S E)) t (suc k) 0 c)
 (sqQuote (sqEnvCons y (sqStackEnv S E)) t (suc l) 0 c) $ =
'(qqB_transport (eqcomd (syl qqB_stack_eval hb)) (eqcomd (syl qqB_stack_eval hb)) @
 qqB_use hc hb
 (mpd hky (syl (sqQuoteHygiene_stack_child hay) hk))
 (mpd hly (syl (sqQuoteHygiene_stack_child hay) hl)));

pub theorem sqQuote_bot_rebase (E: set) (t k l: nat):
 $ kEquivalent (sqQuote E t k 0 sfBot) (sqQuote E t l 0 sfBot) $ =
'(mpbir (trud (kEquivalenteqd (a1i sqQuote_bot) (a1i sqQuote_bot))) kEquivalent_refl);

@_ def qqBaseBody (E: set) (S t k c: nat): nat =
 $ sqQuote (sqEnvCons k (sqStackEnv S E)) t (suc k) 0 c $;
@_ def qqBaseGuardAll (E: set) (S t k c: nat): nat =
 $ kImp (kMem t k) (qqBaseBody E S t k c) $;
@_ def qqBaseGuardEx (E: set) (S t k c: nat): nat =
 $ kAnd (kMem t k) (qqBaseBody E S t k c) $;
@_ def qqBaseCommonAll (E: set) (S t k l c p: nat): nat =
 $ sqCommonName (qqBaseGuardAll E S t k c) (qqBaseGuardAll E S t l c) k l (suc (p + sqAllocationMargin)) $;
@_ def qqBaseCommonEx (E: set) (S t k l c p: nat): nat =
 $ sqCommonName (qqBaseGuardEx E S t k c) (qqBaseGuardEx E S t l c) k l (suc (p + sqAllocationMargin)) $;
theorem qqB_alpha_all (G: wff) (f g x y: nat)
 (hxy: $ G -> x != y $) (hb: $ G -> kBinderAbsent f x $)
 (hf: $ G -> kFresh f y $) (hs: $ G -> kSubst f x y = g $):
 $ G -> kEquivalent (kAll x f) (kAll y g) $ =
'(qqB_transport eqidd (kAlleq2d (eqcomd hs)) @
 mpd hf (mpd hb (syl kAlpha_all hxy)));
theorem qqB_alpha_exists (G: wff) (f g x y: nat)
 (hxy: $ G -> x != y $) (hb: $ G -> kBinderAbsent f x $)
 (hf: $ G -> kFresh f y $) (hs: $ G -> kSubst f x y = g $):
 $ G -> kEquivalent (kExists x f) (kExists y g) $ =
'(qqB_transport eqidd (kExistseq2d (eqcomd hs)) @
 mpd hf (mpd hb (syl kAlpha_exists hxy)));
theorem qqB_all_bridge (G: wff) (E: set) (S n t k l c: nat)
 (hc: $ G -> c e. qqBaseClass E $) (hs: $ G -> sfBound n (sfAll c) $)
 (hk: $ G -> sqQuoteHygiene (sqStackEnv S E) n t k (sfAll c) $)
 (hl: $ G -> sqQuoteHygiene (sqStackEnv S E) n t l (sfAll c) $)
 (hsk: $ G -> kSubst (qqBaseGuardAll E S t k c) k (qqBaseCommonAll E S t k l c (sfAll c)) =
 kImp (kMem t (qqBaseCommonAll E S t k l c (sfAll c)))
 (sqQuote (sqEnvCons (qqBaseCommonAll E S t k l c (sfAll c)) (sqStackEnv S E)) t (suc k) 0 c) $)
 (hsl: $ G -> kSubst (qqBaseGuardAll E S t l c) l (qqBaseCommonAll E S t k l c (sfAll c)) =
 kImp (kMem t (qqBaseCommonAll E S t k l c (sfAll c)))
 (sqQuote (sqEnvCons (qqBaseCommonAll E S t k l c (sfAll c)) (sqStackEnv S E)) t (suc l) 0 c) $):
 $ G -> kEquivalent (sqQuote (sqStackEnv S E) t k 0 (sfAll c))
                       (sqQuote (sqStackEnv S E) t l 0 (sfAll c)) $ =
'(qqB_transport (syl sqQuote_all_cons (syl sfBound_wf (syl (bi1 sfBound_sfAll) hs)))
 (syl sqQuote_all_cons (syl sfBound_wf (syl (bi1 sfBound_sfAll) hs))) @
 syl kEquivalent_trans @ iand
 (qqB_alpha_all (a1i (ltnei (lelttr leaddid1 sqCommonName_range_left)))
  (syl (sqScopeAll_absent ltsucid) (syl sfBound_wf (syl (bi1 sfBound_sfAll) hs)))
  (a1i (ax_mp kFresh_above (ltlei sqCommonName_left))) hsk)
 (syl kEquivalent_trans @ iand
  (syl kEquivalent_guarded_all (qqB_child_equiv sfAll_body_lt hc (syl (bi1 sfBound_sfAll) hs) hk hl
    (a1i (ax_mp (sqAllocAvoid_successor sfAll_body_lt) sqCommonName_avoid_left))
    (a1i (ax_mp (sqAllocAvoid_successor sfAll_body_lt) sqCommonName_avoid_right))))
  (syl kEquivalent_sym @ qqB_alpha_all (a1i (ltnei (lelttr leaddid1 sqCommonName_range_right)))
    (syl (sqScopeAll_absent ltsucid) (syl sfBound_wf (syl (bi1 sfBound_sfAll) hs)))
    (a1i (ax_mp kFresh_above (ltlei sqCommonName_right))) hsl)));
theorem qqB_ex_bridge (G: wff) (E: set) (S n t k l c: nat)
 (hc: $ G -> c e. qqBaseClass E $) (hs: $ G -> sfBound n (sfEx c) $)
 (hk: $ G -> sqQuoteHygiene (sqStackEnv S E) n t k (sfEx c) $)
 (hl: $ G -> sqQuoteHygiene (sqStackEnv S E) n t l (sfEx c) $)
 (hsk: $ G -> kSubst (qqBaseGuardEx E S t k c) k (qqBaseCommonEx E S t k l c (sfEx c)) =
 kAnd (kMem t (qqBaseCommonEx E S t k l c (sfEx c)))
 (sqQuote (sqEnvCons (qqBaseCommonEx E S t k l c (sfEx c)) (sqStackEnv S E)) t (suc k) 0 c) $)
 (hsl: $ G -> kSubst (qqBaseGuardEx E S t l c) l (qqBaseCommonEx E S t k l c (sfEx c)) =
 kAnd (kMem t (qqBaseCommonEx E S t k l c (sfEx c)))
 (sqQuote (sqEnvCons (qqBaseCommonEx E S t k l c (sfEx c)) (sqStackEnv S E)) t (suc l) 0 c) $):
 $ G -> kEquivalent (sqQuote (sqStackEnv S E) t k 0 (sfEx c))
                       (sqQuote (sqStackEnv S E) t l 0 (sfEx c)) $ =
'(qqB_transport (syl sqQuote_ex_cons (syl sfBound_wf (syl (bi1 sfBound_sfEx) hs)))
 (syl sqQuote_ex_cons (syl sfBound_wf (syl (bi1 sfBound_sfEx) hs))) @
 syl kEquivalent_trans @ iand
 (qqB_alpha_exists (a1i (ltnei (lelttr leaddid1 sqCommonName_range_left)))
  (syl (sqScopeEx_absent ltsucid) (syl sfBound_wf (syl (bi1 sfBound_sfEx) hs)))
  (a1i (ax_mp kFresh_above (ltlei sqCommonName_left))) hsk)
 (syl kEquivalent_trans @ iand
  (syl kEquivalent_guarded_exists (qqB_child_equiv sfEx_body_lt hc (syl (bi1 sfBound_sfEx) hs) hk hl
    (a1i (ax_mp (sqAllocAvoid_successor sfEx_body_lt) sqCommonName_avoid_left))
    (a1i (ax_mp (sqAllocAvoid_successor sfEx_body_lt) sqCommonName_avoid_right))))
  (syl kEquivalent_sym @ qqB_alpha_exists (a1i (ltnei (lelttr leaddid1 sqCommonName_range_right)))
    (syl (sqScopeEx_absent ltsucid) (syl sfBound_wf (syl (bi1 sfBound_sfEx) hs)))
    (a1i (ax_mp kFresh_above (ltlei sqCommonName_right))) hsl)));

theorem qqB_mem_core (G: wff) (E: set) (S n t k l a b: nat)
 (hs: $ G -> sfBound n (sfMem a b) $)
 (hk: $ G -> sqQuoteHygiene (sqStackEnv S E) n t k (sfMem a b) $)
 (hl: $ G -> sqQuoteHygiene (sqStackEnv S E) n t l (sfMem a b) $):
 $ G -> kEquivalent (sqQuote (sqStackEnv S E) t k 0 (sfMem a b))
                       (sqQuote (sqStackEnv S E) t l 0 (sfMem a b)) $ =
'(qqB_transport
 (a1i (eqtr sqQuote_sfMem (sqMembereq eqid sfNamedIndex_zero sfNamedIndex_zero add0)))
 (a1i (eqtr sqQuote_sfMem (sqMembereq eqid sfNamedIndex_zero sfNamedIndex_zero add0))) @
 mpd (sqQuoteHygiene_atom_template leaddid2 hl
    (syl anl (syl (bi1 sfBound_sfMem) hs)) (syl anr (syl (bi1 sfBound_sfMem) hs))) @
 mpd (sqQuoteHygiene_atom_template leaddid2 hk
    (syl anl (syl (bi1 sfBound_sfMem) hs)) (syl anr (syl (bi1 sfBound_sfMem) hs))) @
 a1i (ax_mp sfNamedTemplate_fresh_base_equivalent sqMemberSource_bound));
theorem qqB_mem (E: set) (a b: nat): $ sfMem a b e. qqBaseClass E $ =
(named '(mpbir qqB_value @ ax_gen @ ax_gen @ ax_gen @ ax_gen @ ax_gen @ exp @ exp @
 qqB_mem_core anll anlr anr));

theorem qqB_eq_core (G: wff) (E: set) (S n t k l a b: nat)
 (hs: $ G -> sfBound n (sfEq a b) $)
 (hk: $ G -> sqQuoteHygiene (sqStackEnv S E) n t k (sfEq a b) $)
 (hl: $ G -> sqQuoteHygiene (sqStackEnv S E) n t l (sfEq a b) $):
 $ G -> kEquivalent (sqQuote (sqStackEnv S E) t k 0 (sfEq a b))
                       (sqQuote (sqStackEnv S E) t l 0 (sfEq a b)) $ =
'(qqB_transport
 (a1i (eqtr sqQuote_sfEq (sqEqualeq eqid sfNamedIndex_zero sfNamedIndex_zero add0)))
 (a1i (eqtr sqQuote_sfEq (sqEqualeq eqid sfNamedIndex_zero sfNamedIndex_zero add0))) @
 mpd (sqQuoteHygiene_atom_template leaddid1 hl
    (syl anl (syl (bi1 sfBound_sfEq) hs)) (syl anr (syl (bi1 sfBound_sfEq) hs))) @
 mpd (sqQuoteHygiene_atom_template leaddid1 hk
    (syl anl (syl (bi1 sfBound_sfEq) hs)) (syl anr (syl (bi1 sfBound_sfEq) hs))) @
 a1i (ax_mp sfNamedTemplate_fresh_base_equivalent sqEqualSource_bound));
theorem qqB_eq (E: set) (a b: nat): $ sfEq a b e. qqBaseClass E $ =
(named '(mpbir qqB_value @ ax_gen @ ax_gen @ ax_gen @ ax_gen @ ax_gen @ exp @ exp @
 qqB_eq_core anll anlr anr));
theorem qqB_atomic (E: set): $ sfAtomicClosed (qqBaseClass E) $ =
(named '(ax_gen @ ax_gen @ ian qqB_mem qqB_eq));

theorem qqB_subst_domain (G: wff) (t k y: nat) (ht: $ G -> k != t $):
 $ G -> kSubst (kMem t k) k y = kMem t y $ =
'(eqtrd (a1i kSubst_kMem) (kMemeqd (syl kReplace_miss (syl necom ht)) (a1i kReplace_hit)));
theorem qqB_subst_body (G: wff) (E: set) (S n t k y c: nat)
 (hb: $ G -> sfBound (suc n) c $) (hz: $ G -> k != 0 $)
 (ht: $ G -> k != t $) (he: $ G -> sqEnvAvoid (sqStackEnv S E) n k $):
 $ G -> kSubst (qqBaseBody E S t k c) k y =
 sqQuote (sqEnvCons y (sqStackEnv S E)) t (suc k) 0 c $ =
'(mpd hb (mpd he (mpd ht (syl sqQuote_substitution_cons_when hz))));
theorem qqB_subst_all (G: wff) (E: set) (S n t k y c: nat)
 (hb: $ G -> sfBound (suc n) c $) (hz: $ G -> k != 0 $)
 (ht: $ G -> k != t $) (he: $ G -> sqEnvAvoid (sqStackEnv S E) n k $):
 $ G -> kSubst (qqBaseGuardAll E S t k c) k y =
 kImp (kMem t y) (sqQuote (sqEnvCons y (sqStackEnv S E)) t (suc k) 0 c) $ =
'(eqtrd (a1i kSubst_kImp) (kImpeqd (qqB_subst_domain ht) (qqB_subst_body hb hz ht he)));
theorem qqB_subst_ex (G: wff) (E: set) (S n t k y c: nat)
 (hb: $ G -> sfBound (suc n) c $) (hz: $ G -> k != 0 $)
 (ht: $ G -> k != t $) (he: $ G -> sqEnvAvoid (sqStackEnv S E) n k $):
 $ G -> kSubst (qqBaseGuardEx E S t k c) k y =
 kAnd (kMem t y) (sqQuote (sqEnvCons y (sqStackEnv S E)) t (suc k) 0 c) $ =
'(eqtrd (syl qsSubst_kAnd_when hz) (kAndeqd (qqB_subst_domain ht) (qqB_subst_body hb hz ht he)));
theorem qqB_all_core (G: wff) (E: set) (S n t k l c: nat)
 (hc: $ G -> c e. qqBaseClass E $) (hs: $ G -> sfBound n (sfAll c) $)
 (hk: $ G -> sqQuoteHygiene (sqStackEnv S E) n t k (sfAll c) $)
 (hl: $ G -> sqQuoteHygiene (sqStackEnv S E) n t l (sfAll c) $):
 $ G -> kEquivalent (sqQuote (sqStackEnv S E) t k 0 (sfAll c))
                       (sqQuote (sqStackEnv S E) t l 0 (sfAll c)) $ =
'(qqB_all_bridge hc hs hk hl
 (qqB_subst_all (syl (bi1 sfBound_sfAll) hs)
  (syl sqQuoteHygiene_nonzero hk) (syl sqQuoteHygiene_tag_neq hk) (syl sqQuoteHygiene_avoid hk))
 (qqB_subst_all (syl (bi1 sfBound_sfAll) hs)
  (syl sqQuoteHygiene_nonzero hl) (syl sqQuoteHygiene_tag_neq hl) (syl sqQuoteHygiene_avoid hl)));
theorem qqB_all (E: set) (c: nat):
 $ c e. qqBaseClass E -> sfAll c e. qqBaseClass E $ =
(named '(mpbird (a1i qqB_value) @ !! iald S @ !! iald n @ !! iald t @ !! iald k @ !! iald l @ exp @ exp @ exp @
 qqB_all_core (syl anl (syl anl anl)) (syl anr (syl anl anl)) (syl anr anl) anr));
theorem qqB_ex_core (G: wff) (E: set) (S n t k l c: nat)
 (hc: $ G -> c e. qqBaseClass E $) (hs: $ G -> sfBound n (sfEx c) $)
 (hk: $ G -> sqQuoteHygiene (sqStackEnv S E) n t k (sfEx c) $)
 (hl: $ G -> sqQuoteHygiene (sqStackEnv S E) n t l (sfEx c) $):
 $ G -> kEquivalent (sqQuote (sqStackEnv S E) t k 0 (sfEx c))
                       (sqQuote (sqStackEnv S E) t l 0 (sfEx c)) $ =
'(qqB_ex_bridge hc hs hk hl
 (qqB_subst_ex (syl (bi1 sfBound_sfEx) hs)
  (syl sqQuoteHygiene_nonzero hk) (syl sqQuoteHygiene_tag_neq hk) (syl sqQuoteHygiene_avoid hk))
 (qqB_subst_ex (syl (bi1 sfBound_sfEx) hs)
  (syl sqQuoteHygiene_nonzero hl) (syl sqQuoteHygiene_tag_neq hl) (syl sqQuoteHygiene_avoid hl)));
theorem qqB_ex (E: set) (c: nat):
 $ c e. qqBaseClass E -> sfEx c e. qqBaseClass E $ =
(named '(mpbird (a1i qqB_value) @ !! iald S @ !! iald n @ !! iald t @ !! iald k @ !! iald l @ exp @ exp @ exp @
 qqB_ex_core (syl anl (syl anl anl)) (syl anr (syl anl anl)) (syl anr anl) anr));
theorem qqB_quantifier (E: set): $ sfQuantifierClosed (qqBaseClass E) $ =
(named '(ax_gen @ iand qqB_all qqB_ex));
theorem qqB_closed (E: set): $ sfConstructionClosed (qqBaseClass E) $ =
'(ian (ian (ian qqB_bot qqB_atomic) qqB_binary) qqB_quantifier);
pub theorem sqQuote_rebase_stack (E: set) (S n t k l c: nat):
 $ sfBound n c -> sqQuoteHygiene (sqStackEnv S E) n t k c ->
 sqQuoteHygiene (sqStackEnv S E) n t l c ->
 kEquivalent (sqQuote (sqStackEnv S E) t k 0 c)
             (sqQuote (sqStackEnv S E) t l 0 c) $ =
'(mpd id (syl qqB_at (syl (ax_mp sfWf_induction qqB_closed) sfBound_wf)));
theorem qqB_nil_agree (E: set) (n: nat): $ sqEnvAgree E (sqStackEnv 0 E) n $ =
(named '(ax_gen @ a1i @ eqcom sqStackEnv_nil));
theorem qqB_nil_eval (E: set) (n t k c: nat):
 $ sfBound n c -> sqQuote (sqStackEnv 0 E) t k 0 c = sqQuote E t k 0 c $ =
'(syl (sqQuote_environment sqStackEnv_nil_agree) (bi2 (srecpeq2 (preq1 add01))));
theorem qqB_final (G: wff) (E: set) (n t k l c: nat)
 (hb: $ G -> sfBound n c $)
 (hk: $ G -> sqQuoteHygiene E n t k c $)
 (hl: $ G -> sqQuoteHygiene E n t l c $):
 $ G -> kEquivalent (sqQuote E t k 0 c) (sqQuote E t l 0 c) $ =
'(qqB_transport (eqcomd (syl qqB_nil_eval hb)) (eqcomd (syl qqB_nil_eval hb)) @
 mpd (syl (sqQuoteHygiene_agree qqB_nil_agree) hl) @
 mpd (syl (sqQuoteHygiene_agree qqB_nil_agree) hk) @ syl sqQuote_rebase_stack hb);
pub theorem sqQuote_fresh_base_equivalent (E: set) (n t k l c: nat):
 $ sfBound n c -> sqQuoteHygiene E n t k c -> sqQuoteHygiene E n t l c ->
 kEquivalent (sqQuote E t k 0 c) (sqQuote E t l 0 c) $ =
'(exp @ exp @ qqB_final anll anlr anr);
