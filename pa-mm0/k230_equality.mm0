import "k230_bootstrap.mm0";
import "k230_propositional_extra.mm0";

-- Actual K derivations of equality rules. These are not added axioms.

theorem kImp_apply_right (a b c: nat)
  (hb: $ kProvable b $) (h: $ kProvable (kImp a (kImp b c)) $):
  $ kProvable (kImp a c) $;

theorem kEquality_symmetric (a b: nat):
  $ kProvable (kImp (kEq a b) (kEq b a)) $;

theorem kEquality_transitive (a b c: nat):
  $ kProvable (kImp (kEq a b) (kImp (kEq b c) (kEq a c))) $;

theorem kEquality_member_left (a b c: nat):
  $ kProvable (kImp (kEq a b) (kImp (kMem a c) (kMem b c))) $;

theorem kEquality_member_right (a b c: nat):
  $ kProvable (kImp (kEq a b) (kImp (kMem c a) (kMem c b))) $;

theorem kEquality_equal_left (a b c: nat):
  $ kProvable (kImp (kEq a b) (kImp (kEq a c) (kEq b c))) $;

theorem kEquality_equal_right (a b c: nat):
  $ kProvable (kImp (kEq a b) (kImp (kEq c a) (kEq c b))) $;
