import "pa_numeral_term_witness_array.mm0";

def paNumeralTermArrayBody (d z m v c t k q u w: nat): wff = $ k < v /\ q < v /\ u <= q /\ w <= q /\ bb215ArithmeticFormulaPairGraph d c k /\ zfcProofArithmeticBoundedHistoryPair m v k q /\ bb215ArithmeticFormulaPairGraph u w q /\ paNumeralTermKnownCertificate d z u w c t $;

def paNumeralTermArrayAt (d z m v c t .k .q .u .w: nat): wff = $ E. k E. q E. u E. w paNumeralTermArrayBody d z m v c t k q u w $;

theorem paNumeralTermArrayAt_from_certificate (d z m v c t A: nat): $ bb215ArithmeticFormulaHistoryCell (m, v) (d, c) A -> paNumeralTermKnownCertificate d z (fst A) (snd A) c t -> paNumeralTermArrayAt d z m v c t $;

theorem paNumeralTermArrayAt_value (d n z m v L c: nat): $ paNumeralArithmeticBoundedGraph n z -> paNumeralTermWitnessArrayCharacterization n (m, v) L -> (d, c) <= L -> paNumeralTermArrayAt d z m v c (paTermSubst d (paTermNumeral n) c) $;

theorem paNumeralTermArrayAt_sound (d n z m v c t: nat): $ paNumeralArithmeticBoundedGraph n z -> paNumeralTermArrayAt d z m v c t -> paNumeralTermSubstScalarGraph d n c t $;
