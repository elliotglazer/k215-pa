import "pa_formula_numeral_swap_bound.mm0";

import "pa_proof_numeral_diagonal_elimination.mm0";

def paNumeralDiagonalBeta (a: nat): nat = $ paFormulaEx (paFormulaAnd (paFormulaRename paFormulaNumeralSwapMap 0 paNumeralDiagonalArrayCode) a) $;

theorem paNumeralDiagonalBeta_bound (a: nat): $ paFormulaBound 1 a -> paFormulaBound 1 (paNumeralDiagonalBeta a) $;

theorem paNumeralDiagonalBeta_instance (b a: nat): $ paFormulaBound 1 a -> paFormulaSubst 0 (paTermNumeral b) (paNumeralDiagonalBeta a) = paFormulaEx (paProofNumeralDiagonalEliminationBody b a) $;

def paNumeralDiagonalBetaSentence (a: nat): nat = $ paNumeralDiagonal (paNumeralDiagonalBeta a) $;

theorem paNumeralDiagonalBetaSentence_exact (a: nat): $ paFormulaBound 1 a -> paNumeralDiagonalBetaSentence a = paFormulaEx (paProofNumeralDiagonalEliminationBody (paNumeralDiagonalBeta a) a) $;

theorem paNumeralDiagonalBetaSentence_bound (a: nat): $ paFormulaBound 1 a -> paFormulaBound 0 (paNumeralDiagonalBetaSentence a) $;
