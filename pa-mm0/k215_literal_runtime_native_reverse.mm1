import "k215_literal_runtime_native_iteration.mm1";

@_ abstract def k215PNativeReverseClaim (n: nat) (.s .g .w .r: nat): wff =
 $ A. s A. g A. w A. r
   (k215PInRange s -> k215TMQ (k215TMRun n (k215PConfigFrame g s w r)) = k215Num215 -> k215PHaltsFrom s) $;
@_ abstract def k215PNativeReverseFuture (n s w: nat) (.h .q: nat): wff =
 $ A. h A. q (k215TMQ (k215TMRun n (k215PConfigFrame h (k215PStep s) w q)) = k215Num215 ->
     k215PHaltsFrom (k215PStep s)) $;
theorem k215PNativeReverse_at (n s g w r: nat):
 $ k215PNativeReverseClaim n -> k215PInRange s ->
   k215TMQ (k215TMRun n (k215PConfigFrame g s w r)) = k215Num215 -> k215PHaltsFrom s $ =
 (named '(!! ealie a @ !! ealde b @ !! ealde c @ !! ealde d @ bi1d ,eqtac));
theorem k215PNativeReverseFuture_at (n s w h q: nat):
 $ k215PNativeReverseFuture n s w ->
   k215TMQ (k215TMRun n (k215PConfigFrame h (k215PStep s) w q)) = k215Num215 -> k215PHaltsFrom (k215PStep s) $ =
 (named '(!! ealie a @ !! ealde b @ bi1d ,eqtac));
theorem k215PNativePreviousHalts (s: nat):
 $ k215PHaltsFrom (k215PStep s) -> k215PHaltsFrom s $ =
 '(ax_mp k215PReach_halts (k215PReach_step eqid));
theorem k215PNativeSourceStopped (s: nat): $ k215PStatus s = 4 -> k215PHaltsFrom s $ =
 '(syl k215PHaltsFrom_intro (eqtrd (a1i (k215PStatuseq k215PIter_zero)) id));
theorem k215PNativeReverseFuture_derive_at (n s w h q: nat):
 $ k215PNativeReverseClaim n -> k215PInRange s ->
   k215TMQ (k215TMRun n (k215PConfigFrame h (k215PStep s) w q)) = k215Num215 -> k215PHaltsFrom (k215PStep s) $ =
 '(syl5 k215PStep_bound k215PNativeReverse_at);
theorem k215PNativeReverseFuture_derive (n s w: nat):
 $ k215PNativeReverseClaim n -> k215PInRange s -> k215PNativeReverseFuture n s w $ =
 (named '(exp @ iald @ iald @ imp k215PNativeReverseFuture_derive_at));
theorem k215PNativeProgress_reverse_at (n g s w r h q: nat):
 $ k215TmControlProgress (k215PConfigFrame g s w r) (k215PConfigFrame h (k215PStep s) w q) ->
   k215PNativeReverseFuture n s w ->
   k215TMQ (k215TMRun (suc n) (k215PConfigFrame g s w r)) = k215Num215 -> k215PHaltsFrom s $ =
 '(exp @ exp @ syl k215PNativePreviousHalts
   (mpd (mpd anr (syl k215TmControlProgress_budget (syl anl anl)))
     (syl k215PNativeReverseFuture_at (syl anr anl))));
theorem k215PNativeProgress_reverse (n g s w r: nat):
 $ k215PNativeProgress g s w r -> k215PNativeReverseFuture n s w ->
   k215TMQ (k215TMRun (suc n) (k215PConfigFrame g s w r)) = k215Num215 -> k215PHaltsFrom s $ =
 (named '(eex @ eex k215PNativeProgress_reverse_at));
theorem k215PNativeOutcome_reverse (n g s w r: nat):
 $ k215PNativeOutcome g s w r -> k215PNativeReverseFuture n s w ->
   k215TMQ (k215TMRun (suc n) (k215PConfigFrame g s w r)) = k215Num215 -> k215PHaltsFrom s $ =
 '(exp @ exp @ casesda
   (syl k215PNativeSourceStopped anr)
   (mpd (syl anr anl)
     (mpd (syl anr (syl anl anl))
       (syl k215PNativeProgress_reverse
         (mpd anr (syl k215PNativeOutcome_running (syl anl (syl anl anl))))))));
theorem k215PNative83_ne_215: $ k215Num83 != k215Num215 $ =
 '(mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq peano2) (mpbir (noteq eqcomb) peano1))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))));
theorem k215PNativeFrameZero_not_halted (g s w r: nat):
 $ k215TMQ (k215TMRun 0 (k215PConfigFrame g s w r)) != k215Num215 $ =
 '(mpbir (noteq (eqeq1 (eqtr (k215TMQeq k215TMRun_zero) k215PFrame_Q))) k215PNative83_ne_215);
theorem k215PNativeReverse_zero_at (s g w r: nat):
 $ k215PInRange s -> k215TMQ (k215TMRun 0 (k215PConfigFrame g s w r)) = k215Num215 -> k215PHaltsFrom s $ =
 '(a1i (ax_mp absurd k215PNativeFrameZero_not_halted));
theorem k215PNativeReverse_zero: $ k215PNativeReverseClaim 0 $ =
 (named '(ax_gen @ ax_gen @ ax_gen @ ax_gen k215PNativeReverse_zero_at));
theorem k215PNativeReverse_step_at (n s g w r: nat):
 $ k215PNativeLaw /\ k215PNativeReverseClaim n -> k215PInRange s ->
   k215TMQ (k215TMRun (suc n) (k215PConfigFrame g s w r)) = k215Num215 -> k215PHaltsFrom s $ =
 '(exp @ exp @ mpd anr
   (mpd (mpd (syl anr anl) (syl k215PNativeReverseFuture_derive (syl anr (syl anl anl))))
     (syl k215PNativeOutcome_reverse
       (mpd (syl anr anl) (syl k215PNativeLaw_at (syl anl (syl anl anl)))))));
theorem k215PNativeReverse_step (n: nat):
 $ k215PNativeLaw /\ k215PNativeReverseClaim n -> k215PNativeReverseClaim (suc n) $ =
 (named '(iald @ iald @ iald @ iald k215PNativeReverse_step_at));
pub theorem k215PNativeReverse_all (n: nat): $ k215PNativeLaw -> k215PNativeReverseClaim n $ =
 (named @ induct '(indd) 'n '(a1i k215PNativeReverse_zero) 'k215PNativeReverse_step);
theorem k215PNativeReverse_halt_at (n s g w r: nat):
 $ k215PNativeLaw -> k215PInRange s ->
   k215TMQ (k215TMRun n (k215PConfigFrame g s w r)) = k215Num215 -> k215PHaltsFrom s $ =
 '(syl k215PNativeReverse_at k215PNativeReverse_all);
pub theorem k215PNative_literal_halts (s g w r: nat):
 $ k215PNativeLaw -> k215PInRange s -> k215TMHaltsFrom (k215PConfigFrame g s w r) -> k215PHaltsFrom s $ =
 (named '(exp @ eexd @ imp k215PNativeReverse_halt_at));
pub theorem k215PNative_halting_equivalence (s g w r: nat):
 $ k215PNativeLaw -> k215PInRange s ->
   (k215TMHaltsFrom (k215PConfigFrame g s w r) <-> k215PHaltsFrom s) $ =
 '(exp @ ibid (imp k215PNative_literal_halts) (imp k215PNative_source_halts));
