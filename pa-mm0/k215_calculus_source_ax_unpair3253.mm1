@_ def k215UnpairAt3253State (pc a b n c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) n (k215PR3 c) (k215PR4 c) (k215PR5 c) a b (k215PR8 c)) $;

do (apply (register-eqd 'k215UnpairAt3253State) '(k215UnpairAt3253Stateeqd));

theorem k215UnpairAt3253Transfer (b n c: nat): $ k215PIter (3 * b + 1) (k215UnpairAt3253State k215PNum3257 0 b n c) = (k215UnpairAt3253State k215PNum3260 b 0 n c) $ =
 '(eqtr k215Loop3257Vector (k215PStateeq2 (k215PVectoreq7 add0)));
theorem k215UnpairAt3253ReachTransfer (b n c: nat): $ k215PReach (k215UnpairAt3253State k215PNum3257 0 b n c) (k215UnpairAt3253State k215PNum3260 b 0 n c) $ =
 '(k215PReach_intro k215UnpairAt3253Transfer);


theorem k215UnpairAt3253Step9Z (a b c: nat): $ k215PStep (k215UnpairAt3253State k215PNum3253 a b 0 c) = (k215UnpairAt3253State k215PNum3261 a b 0 c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair3253_3253) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt3253Reach9Z (a b c: nat): $ k215PReach (k215UnpairAt3253State k215PNum3253 a b 0 c) (k215UnpairAt3253State k215PNum3261 a b 0 c) $ = '(k215PReach_step k215UnpairAt3253Step9Z);

theorem k215UnpairAt3253Step9S (a b n c: nat): $ k215PStep (k215UnpairAt3253State k215PNum3253 a b (suc n) c) = (k215UnpairAt3253State k215PNum3254 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair3253_3253) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet2_vector)) (eqtr k215PSet2_vector (k215PVectoreq3 (eqtr subSS sub02))))));

theorem k215UnpairAt3253Reach9S (a b n c: nat): $ k215PReach (k215UnpairAt3253State k215PNum3253 a b (suc n) c) (k215UnpairAt3253State k215PNum3254 a b n c) $ = '(k215PReach_step k215UnpairAt3253Step9S);

theorem k215UnpairAt3253Step10 (a b n c: nat): $ k215PStep (k215UnpairAt3253State k215PNum3254 a b n c) = (k215UnpairAt3253State k215PNum3255 a (suc b) n c) $ = '(eqtr (k215PAtCI k215PLookupUnpair3253_3254) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215UnpairAt3253Reach10 (a b n c: nat): $ k215PReach (k215UnpairAt3253State k215PNum3254 a b n c) (k215UnpairAt3253State k215PNum3255 a (suc b) n c) $ = '(k215PReach_step k215UnpairAt3253Step10);

theorem k215UnpairAt3253Step11Z (b n c: nat): $ k215PStep (k215UnpairAt3253State k215PNum3255 0 b n c) = (k215UnpairAt3253State k215PNum3257 0 b n c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair3253_3255) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt3253Reach11Z (b n c: nat): $ k215PReach (k215UnpairAt3253State k215PNum3255 0 b n c) (k215UnpairAt3253State k215PNum3257 0 b n c) $ = '(k215PReach_step k215UnpairAt3253Step11Z);

theorem k215UnpairAt3253Step11S (a b n c: nat): $ k215PStep (k215UnpairAt3253State k215PNum3255 (suc a) b n c) = (k215UnpairAt3253State k215PNum3256 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair3253_3255) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215UnpairAt3253Reach11S (a b n c: nat): $ k215PReach (k215UnpairAt3253State k215PNum3255 (suc a) b n c) (k215UnpairAt3253State k215PNum3256 a b n c) $ = '(k215PReach_step k215UnpairAt3253Step11S);

theorem k215UnpairAt3253Step12 (a b n c: nat): $ k215PStep (k215UnpairAt3253State k215PNum3256 a b n c) = (k215UnpairAt3253State k215PNum3260 a b n c) $ = '(k215PAtCB k215PLookupUnpair3253_3256);

theorem k215UnpairAt3253Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt3253State k215PNum3256 a b n c) (k215UnpairAt3253State k215PNum3260 a b n c) $ = '(k215PReach_step k215UnpairAt3253Step12);

theorem k215UnpairAt3253Step16 (a b n c: nat): $ k215PStep (k215UnpairAt3253State k215PNum3260 a b n c) = (k215UnpairAt3253State k215PNum3253 a b n c) $ = '(k215PAtCC k215PLookupUnpair3253_3260);

theorem k215UnpairAt3253Reach16 (a b n c: nat): $ k215PReach (k215UnpairAt3253State k215PNum3260 a b n c) (k215UnpairAt3253State k215PNum3253 a b n c) $ = '(k215PReach_step k215UnpairAt3253Step16);

theorem k215UnpairAt3253CycleZero (b n c: nat): $ k215PReach (k215UnpairAt3253State k215PNum3253 0 b (suc n) c) (k215UnpairAt3253State k215PNum3253 (suc b) 0 n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt3253Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt3253Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt3253Reach11Z) (ax_mp (ax_mp k215PReach_trans k215UnpairAt3253ReachTransfer) k215UnpairAt3253Reach16))));
theorem k215UnpairAt3253CycleSucc (a b n c: nat): $ k215PReach (k215UnpairAt3253State k215PNum3253 (suc a) b (suc n) c) (k215UnpairAt3253State k215PNum3253 a (suc b) n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt3253Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt3253Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt3253Reach11S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt3253Reach12) k215UnpairAt3253Reach16))));


theorem k215UnpairAt3253AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt3253State k215PNum3253 0 b (suc n) c) (k215UnpairAt3253State k215PNum3253 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt3253Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215PairDiagonal_rotate)) (eqtr (eqcom sndpr) (sndeq k215PairDiagonal_rotate)) eqid eqid)) k215UnpairAt3253CycleZero);

theorem k215UnpairAt3253AdvanceSucc (a b n c: nat): $ k215PReach (k215UnpairAt3253State k215PNum3253 (suc a) b (suc n) c) (k215UnpairAt3253State k215PNum3253 (fst (suc ((suc a), b))) (snd (suc ((suc a), b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt3253Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215Pair_next)) (eqtr (eqcom sndpr) (sndeq k215Pair_next)) eqid eqid)) k215UnpairAt3253CycleSucc);

pub theorem k215UnpairAt3253Advance (a b n c: nat): $ k215PReach (k215UnpairAt3253State k215PNum3253 a b (suc n) c) (k215UnpairAt3253State k215PNum3253 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
 (named @ induct '(ind) 'a 'k215UnpairAt3253AdvanceZero '(a1i k215UnpairAt3253AdvanceSucc));
@_ abstract def k215UnpairAt3253Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt3253State k215PNum3253 a b n c) (k215UnpairAt3253State k215PNum3261 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
theorem k215UnpairAt3253RunZero (a b c: nat): $ k215UnpairAt3253Run 0 a b c $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt3253Stateeq eqid
     (eqcom (eqtr (fsteq add0) fstpr))
     (eqcom (eqtr (sndeq add0) sndpr)) eqid eqid)) k215UnpairAt3253Reach9Z);
@_ abstract def k215UnpairAt3253Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt3253Run n a b c $;
theorem k215UnpairAt3253Claim_at (n a b c: nat): $ k215UnpairAt3253Claim n c -> k215UnpairAt3253Run n a b c $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215UnpairAt3253CodeStep (a b n: nat): $ (fst (suc (a, b)), snd (suc (a, b))) + n = (a, b) + suc n $ =
 '(eqtr (addeq1 fstsnd) addSass);
theorem k215UnpairAt3253RunInductive (n a b c: nat): $ k215UnpairAt3253Claim n c -> k215UnpairAt3253Run (suc n) a b c $ =
 '(syl (ax_mp k215PReach_trans k215UnpairAt3253Advance)
   (mpbid (a1i (k215PReacheq2 (k215UnpairAt3253Stateeq eqid
     (fsteq k215UnpairAt3253CodeStep) (sndeq k215UnpairAt3253CodeStep) eqid eqid))) k215UnpairAt3253Claim_at));
theorem k215UnpairAt3253Claim_all (n c: nat): $ k215UnpairAt3253Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt3253RunZero)) '(iald @ iald k215UnpairAt3253RunInductive));
pub theorem k215UnpairMacro3253 (n a b c: nat): $ k215PReach (k215UnpairAt3253State k215PNum3253 a b n c) (k215UnpairAt3253State k215PNum3261 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
 '(ax_mp k215UnpairAt3253Claim_at k215UnpairAt3253Claim_all);
pub theorem k215UnpairMacro3253_clean (n c: nat): $ k215PReach (k215UnpairAt3253State k215PNum3253 0 0 n c) (k215UnpairAt3253State k215PNum3261 (fst n) (snd n) 0 c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt3253Stateeq eqid
   (fsteq (eqtr (addeq1 pr0) add01))
   (sndeq (eqtr (addeq1 pr0) add01)) eqid eqid)) k215UnpairMacro3253);


