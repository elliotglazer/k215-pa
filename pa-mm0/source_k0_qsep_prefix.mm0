import "quotient_quotation.mm0";
import "zfc_schemas.mm0";
import "k218q_propositional.mm0";

-- Internal prefix length and formula code. The matrix remains an actual
-- sqQuote at depth d+n, so each added binder has its correct environment.
theorem sfK0QSep_quote_prefix (E: set) (t k d n phi: nat)
 (hf: $ sfWf phi $):
 $ k218QProvable (sqQuote E t k (d + n) phi) ->
   k218QProvable (sqQuote E t k d (sfAllPrefix n phi)) $;

theorem sfK0QSep_quote_prefix_closed (E: set) (t k n phi: nat)
 (hf: $ sfWf phi $):
 $ k218QProvable (sqQuote E t k n phi) ->
   k218QProvable (sqQuote E t k 0 (sfAllPrefix n phi)) $;
