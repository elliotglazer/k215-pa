import "source_piece_pcf_dn_mono_step.mm0";

def sfPieceMonoDnLaw(T:set)(body count:nat):wff =
 $ sfTheoryProvable T (sfPieceMonoCode body) ->
   sfTheoryProvable T (sfPieceMonoCode (sfPieceDn count body)) $;

theorem sfPieceDn_mono_rule(T:set)(body count:nat)
 (ht:$ sfTheoryClosed T $)(hf:$ sfWf body $):
 $ sfPieceMonoDnLaw T body count $;
