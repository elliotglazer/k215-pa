import "source_k0_qsep_member_transport.mm0";

theorem sfK0QSepQuotient_member_profile (E: set) (n t a c z x M R phi: nat) (hf: $ sfBound (suc n) phi $) (hM0: $ 0 < M $)
 (htM: $ t < M $) (haM: $ a < M $) (hcM: $ c < M $) (hzM: $ z < M $)
 (hxM: $ x < M $) (hMR: $ M < R $) (hx0: $ x != 0 $)
 (htx: $ t != x $) (hax: $ a != x $) (hcx: $ c != x $)
 (he: $ sqEnvBelow E n R $) (hex: $ sqEnvAvoid E n x $) (hem: $ sqEnvAvoid E n M $)
 (hz0: $ z != 0 $) (hzt: $ z != t $) (hza: $ z != a $) (hzc: $ z != c $)
 (hzx: $ z != x $) (hez: $ sqEnvAvoid E n z $):
 $ k218QProvable (kImp (kAll R (kImp (kMem R t) kF)) (kImp (kImp (kImp (kMem t c) (kImp (kAll x (kImp (kMem t x) (kImp (kImp (kImp (kMem x c) (kImp (kImp (kMem x a) (kImp (sqQuote (sqEnvCons x E) t R 0 phi) kF)) kF)) (kImp (kImp (kImp (kImp (kMem x a) (kImp (sqQuote (sqEnvCons x E) t R 0 phi) kF)) kF) (kMem x c)) kF)) kF))) kF)) kF) (kImp (kImp (kMem t c) (kImp (kAll z (kImp (kMem t z) (kImp (kImp (kImp (sqMember t z c M) (kImp (kImp (sqMember t z a M) (kImp (sqQuote (sqEnvCons z E) t R 0 phi) kF)) kF)) (kImp (kImp (kImp (kImp (sqMember t z a M) (kImp (sqQuote (sqEnvCons z E) t R 0 phi) kF)) kF) (sqMember t z c M)) kF)) kF))) kF)) kF))) $;

theorem sfK0QSepQuotient_member_witness (E: set) (n t a c z x M R phi: nat) (hf: $ sfBound (suc n) phi $) (hM0: $ 0 < M $)
 (htM: $ t < M $) (haM: $ a < M $) (hcM: $ c < M $) (hzM: $ z < M $)
 (hxM: $ x < M $) (hMR: $ M < R $) (hx0: $ x != 0 $)
 (htx: $ t != x $) (hax: $ a != x $) (hcx: $ c != x $)
 (he: $ sqEnvBelow E n R $) (hex: $ sqEnvAvoid E n x $) (hem: $ sqEnvAvoid E n M $)
 (hz0: $ z != 0 $) (hzt: $ z != t $) (hza: $ z != a $) (hzc: $ z != c $)
 (hzx: $ z != x $) (hez: $ sqEnvAvoid E n z $) (hc0: $ c != 0 $) (hct: $ c != t $) (hcR: $ c != R $):
 $ k218QProvable (kImp (kAll R (kImp (kMem R t) kF)) (kImp (kExists c (kImp (kImp (kMem t c) (kImp (kAll x (kImp (kMem t x) (kImp (kImp (kImp (kMem x c) (kImp (kImp (kMem x a) (kImp (sqQuote (sqEnvCons x E) t R 0 phi) kF)) kF)) (kImp (kImp (kImp (kImp (kMem x a) (kImp (sqQuote (sqEnvCons x E) t R 0 phi) kF)) kF) (kMem x c)) kF)) kF))) kF)) kF)) (kExists c (kImp (kImp (kMem t c) (kImp (kAll z (kImp (kMem t z) (kImp (kImp (kImp (sqMember t z c M) (kImp (kImp (sqMember t z a M) (kImp (sqQuote (sqEnvCons z E) t R 0 phi) kF)) kF)) (kImp (kImp (kImp (kImp (sqMember t z a M) (kImp (sqQuote (sqEnvCons z E) t R 0 phi) kF)) kF) (sqMember t z c M)) kF)) kF))) kF)) kF)))) $;
