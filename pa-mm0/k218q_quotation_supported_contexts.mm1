theorem k218SQ_sqSC_trans_at (H J K a: nat):
 $ k218IContextSupports H J -> k218IContextSupports J K -> a IN K -> a e. k218IContextProofClass H $ =
'(exp @ exp @ syl (bi2 k218IContextProofClass_value) @
  mpd (mpd anr (syl k218IContextSupports_member anlr)) (syl k218IHypProvable_refine_d anll));

pub theorem k218SQ_sqContextSupports_trans (H J K: nat):
 $ k218IContextSupports H J -> k218IContextSupports J K -> k218IContextSupports H K $ =
(named '(exp @ !! iald a @ imp k218SQ_sqSC_trans_at));

pub theorem k218SQ_sqContextSupports_weaken (H a: nat): $ k218IContextSupports (a : H) H $ =
(named '(k218IContextSupports_inclusion (ax_gen sfContext_member_tail)));

pub theorem k218SQ_sqDomainSupport_weaken (H S t a: nat):
 $ k218SQ_sqDomainSupport H S t -> k218SQ_sqDomainSupport (a : H) S t $ =
'(ax_mp k218SQ_sqDomainSupport_refine k218SQ_sqContextSupports_weaken);

pub theorem k218SQ_sqSourceSupport_weaken (H S t k G a: nat):
 $ k218SQ_sqSourceSupport H S t k G -> k218SQ_sqSourceSupport (a : H) S t k G $ =
'(ax_mp k218SQ_sqContextSupports_trans k218SQ_sqContextSupports_weaken);

pub theorem k218SQ_sqSourceSupport_cons (H S t k G a: nat):
 $ k218SQ_sqSourceSupport H S t k G ->
   k218IHypProvable H (sqQuote (sqNumericEnvironment S) t k 0 a) ->
   k218SQ_sqSourceSupport H S t k (a : G) $ =
'(syl6 (bi2 (k218IContextSupportseq2 sqContext_cons)) k218IContextSupports_cons);

pub theorem k218SQ_sqSourceSupport_under (H S t k G a: nat):
 $ k218SQ_sqSourceSupport H S t k G ->
   k218SQ_sqSourceSupport (sqQuote (sqNumericEnvironment S) t k 0 a : H) S t k (a : G) $ =
'(mpi (ax_mp k218IHypProvable_assumption sfContext_member_head)
  (syl k218SQ_sqSourceSupport_cons k218SQ_sqSourceSupport_weaken));

pub theorem k218SQ_sqSupportedAt_formula_bound (n G a: nat):
 $ k218SQ_sqSupportedAt n (sfSequent G a) -> sfBound n a $ =
