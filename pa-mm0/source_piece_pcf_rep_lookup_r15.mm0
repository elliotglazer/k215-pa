import "source_piece_pcf_rep_lookup_laws_r14.mm0";

def sfPieceRepLookupResult(e x w v:nat):nat = $ sfPieceRepIff (sfPieceRepApplication e x w) (sfEq w v) $;

theorem sfPieceRepLookupResult_wf(e x w v:nat):
 $ sfWf (sfPieceRepLookupResult e x w v) $;

def pcrvSomeGood(n .G:nat):wff = $ A. G ((nsLocal G sfPieceRepLookupLaws) -> (nsLocal G (sfPieceNumeralSome n))) $;

def sfPieceEnvLookupGood(T:set)(n .G .r .h .i .e .x .w:nat):wff = $ A. G A. r A. h A. i A. e A. x A. w (sfContextSub sfFormulaEqualityContext G -> (nsLocal G sfPieceRepLookupLaws) -> i < n -> (nsLocal G (sfPieceEnv (sfPieceRepOffset T r h) n e)) -> (nsLocal G (sfPieceNumeral (n - 1 - i) x)) -> (nsLocal G (sfPieceRepLookupResult e x w (h + (T @ (r + i)))))) $;

def pcrvGoodAt1(T:set)(n G .r .h .i .e .x .w:nat):wff = $ A. r A. h A. i A. e A. x A. w (sfContextSub sfFormulaEqualityContext G -> (nsLocal G sfPieceRepLookupLaws) -> i < n -> (nsLocal G (sfPieceEnv (sfPieceRepOffset T r h) n e)) -> (nsLocal G (sfPieceNumeral (n - 1 - i) x)) -> (nsLocal G (sfPieceRepLookupResult e x w (h + (T @ (r + i)))))) $;

