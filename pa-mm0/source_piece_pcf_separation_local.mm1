
import "source_piece_pcf_separation_point_maps.mm1";
import "source_piece_pcf_separation_point_logic.mm1";

pub theorem sfPieceSeparation_member(T:set)(G D phi Y X x z:nat)(hd:$ sfBound 1 D $)(hf:$ sfWf phi $)
 (hp:$ nsLocal G (sfPieceDefinableProfile (sqEnvCons x T) (sfPieceSeparationPredicate phi) Y X) $)
 (hs:$ nsLocal G (sfImp (sfMem z x) (sfMem z Y)) $)
 (hr:$ nsLocal G (sfImp (sfMem z Y)
   (sfIff (sfRelativize D (sfRename (sqEnvCons z T) 0 phi))
    (sfCLSetRel Y (sfRename (sqEnvCons z T) 0 phi)))) $):
 $ nsLocal G (sfIff (sfMem z X)
   (sfAnd (sfMem z x) (sfRelativize D (sfRename (sqEnvCons z T) 0 phi)))) $ =
 '(sfPieceSeparationPoint_local sfWf_mem sfWf_mem sfWf_mem sfCLSetRel_wf (ax_mp sfRelativize_wf (ax_mp sfBound_wf hd))
  (sfPieceDefinableSeparation_member hf hp) hs hr);
