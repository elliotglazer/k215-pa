import "bb215_derivability_l3_cases.mm0";

-- L05, layer L3a (lanes/L05.md): or-elimination, and S s <= S t <-> s <= t inside PA (same witness,
-- via ex_mono). Generated by build_bb215_derivability_l2_add_basic.py.

theorem bb215L3_or_elim (n a b d: nat) (h1: $ paProvable n (paFormulaImp a d) $) (h2: $ paProvable n (paFormulaImp b d) $):
  $ paProvable n (paFormulaImp (paFormulaOr a b) d) $;

theorem bb215L3_le_succ_mono (n s t: nat) (hs: $ paTermBound n s $) (ht: $ paTermBound n t $):
  $ paProvable n (paFormulaImp (bb215L3Le s t) (bb215L3Le (paTermSuccessor s) (paTermSuccessor t))) $;

theorem bb215L3_le_succ_cancel (n s t: nat) (hs: $ paTermBound n s $) (ht: $ paTermBound n t $):
  $ paProvable n (paFormulaImp (bb215L3Le (paTermSuccessor s) (paTermSuccessor t)) (bb215L3Le s t)) $;
