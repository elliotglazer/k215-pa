import "k218q_seed_source.mm0";
import "k218q_closure_kp0_roles.mm0";
import "k218q_kp0_local.mm0";

def k218Kp0ReadySeed (E: set) (n B f: nat): nat =
 $ kAll 1 (kExists (k218QSourceSeedCode E B f) (k218Kp0PointPremise E n 1 (k218QSourceSeedCode E B f) (k218SourceSeedBase E B f) (suc (k218SourceSeedBase E B f)) (suc (suc (k218SourceSeedBase E B f))) (suc (suc (suc (k218SourceSeedBase E B f)))) (suc (suc (suc (suc (k218SourceSeedBase E B f))))) (suc (suc (suc (suc (suc (k218SourceSeedBase E B f)))))) (suc (suc (suc (suc (suc (suc (k218SourceSeedBase E B f))))))) (suc (suc (suc (suc (suc (suc (suc (k218SourceSeedBase E B f)))))))) (k218SourceMatrixBase E B f) f)) $;

def k218Kp0Common (E: set) (n B f: nat): nat =
 $ kAll 1 (kExists (k218QSourceSeedCode E B f) ((kAnd (kAll (k218SourceSeedBase E B f) (kImp (kDisj (kEq (k218SourceSeedBase E B f) 1) (kExists (suc (suc (k218SourceSeedBase E B f))) (kAnd (kMem (suc (suc (k218SourceSeedBase E B f))) (k218QSourceSeedCode E B f)) (kAll (suc (suc (suc (suc (suc (k218SourceSeedBase E B f)))))) (kImp (kMem (suc (suc (suc (suc (suc (k218SourceSeedBase E B f)))))) (k218SourceSeedBase E B f)) (kMem (suc (suc (suc (suc (suc (k218SourceSeedBase E B f)))))) (suc (suc (k218SourceSeedBase E B f))))))))) (kImp (kExists (suc (suc (suc (suc (suc (suc (k218SourceSeedBase E B f))))))) (sfNamedTemplate (sqEnvCons (suc (suc (suc (suc (suc (suc (k218SourceSeedBase E B f))))))) (sqEnvCons (k218SourceSeedBase E B f) E)) (k218SourceMatrixBase E B f) 0 f)) (kExists (suc (suc (suc (suc (suc (suc (k218SourceSeedBase E B f))))))) (kAnd (kMem (suc (suc (suc (suc (suc (suc (k218SourceSeedBase E B f))))))) (k218QSourceSeedCode E B f)) (sfNamedTemplate (sqEnvCons (suc (suc (suc (suc (suc (suc (k218SourceSeedBase E B f))))))) (sqEnvCons (k218SourceSeedBase E B f) E)) (k218SourceMatrixBase E B f) 0 f)))))) (kAll (suc (k218SourceSeedBase E B f)) (kImp (kMem (suc (k218SourceSeedBase E B f)) (k218QSourceSeedCode E B f)) (kExists (suc (suc (suc (k218SourceSeedBase E B f)))) (sfNamedTemplate (sqEnvCons (suc (k218SourceSeedBase E B f)) (sqEnvCons (suc (suc (suc (k218SourceSeedBase E B f)))) E)) (k218SourceMatrixBase E B f) 0 f))))))) $;

theorem k218QSeed_Kp0_ready {i j: nat} (E: set) (n B f: nat)
 (hB: $ 3 < B $) (he1: $ sqEnvAvoid E n 1 $) (he3: $ sqEnvAvoid E n 3 $)
 (he: $ A. j (j < n -> E @ j < B) $)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218IEquivalent
   (kAll 1 (k218QRootSeed 1 3 (k218QSourceSeedCode E B f) (k218QSourceMatrix E B f)))
   (k218Kp0ReadySeed E n B f) $;

theorem k218QKp0_ready_provable {i j: nat} (E: set) (n B f: nat)
 (hB: $ 3 < B $) (he1: $ sqEnvAvoid E n 1 $) (he3: $ sqEnvAvoid E n 3 $)
 (he: $ A. j (j < n -> E @ j < B) $)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218QProvable (k218Kp0ReadySeed E n B f) $;

theorem k218QKp0_common_implication {j: nat} (E: set) (n B f: nat)
 (hB: $ 3 < B $) (he1: $ sqEnvAvoid E n 1 $) (he3: $ sqEnvAvoid E n 3 $)
 (he: $ A. j (j < n -> E @ j < B) $)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218QProvable (kImp (k218Kp0ReadySeed E n B f) (k218Kp0Common E n B f)) $;

theorem k218QKp0_common {i j: nat} (E: set) (n B f: nat)
 (hB: $ 3 < B $) (he1: $ sqEnvAvoid E n 1 $) (he3: $ sqEnvAvoid E n 3 $)
 (he: $ A. j (j < n -> E @ j < B) $)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218QProvable (k218Kp0Common E n B f) $;
