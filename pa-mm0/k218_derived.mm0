-- Replayed in the distinct exact SeedG calculus. No K230 proof predicate is assumed.
import "k218_propositional.mm0";

-- Finite Hilbert derivations of derived rules in the actual K calculus.
-- The generated certificate is independently checked against these statements.

theorem k218PropI (a: nat):
  $ k218Provable (kImp a a) $;

theorem k218PropF (a: nat):
  $ k218Provable (kImp kF a) $;

theorem k218PropDNE (a: nat):
  $ k218Provable (kImp (kImp (kImp a kF) kF) a) $;

theorem k218PropAndLeft (a b: nat):
  $ k218Provable (kImp (kImp (kImp a (kImp b kF)) kF) a) $;

theorem k218PropAndRight (a b: nat):
  $ k218Provable (kImp (kImp (kImp a (kImp b kF)) kF) b) $;

theorem k218PropAndIntro (a b: nat):
  $ k218Provable (kImp a (kImp b (kImp (kImp a (kImp b kF)) kF))) $;

theorem k218PropB3 (a b: nat):
  $ k218Provable (kImp a (kImp (kImp a kF) b)) $;

theorem k218And_left (a b: nat):
  $ k218Provable (kAnd a b) -> k218Provable a $;

theorem k218And_right (a b: nat):
  $ k218Provable (kAnd a b) -> k218Provable b $;

theorem k218And_intro (a b: nat):
  $ k218Provable a -> k218Provable b -> k218Provable (kAnd a b) $;

