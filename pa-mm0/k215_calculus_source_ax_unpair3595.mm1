theorem k215UnpairAt3595Reach9S (a b n c: nat): $ k215PReach (k215UnpairAt3595State k215PNum3595 a b (suc n) c) (k215UnpairAt3595State k215PNum3596 a b n c) $ = '(k215PReach_step k215UnpairAt3595Step9S);

theorem k215UnpairAt3595Step10 (a b n c: nat): $ k215PStep (k215UnpairAt3595State k215PNum3596 a b n c) = (k215UnpairAt3595State k215PNum3597 a (suc b) n c) $ = '(eqtr (k215PAtCI k215PLookupUnpair3595_3596) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215UnpairAt3595Reach10 (a b n c: nat): $ k215PReach (k215UnpairAt3595State k215PNum3596 a b n c) (k215UnpairAt3595State k215PNum3597 a (suc b) n c) $ = '(k215PReach_step k215UnpairAt3595Step10);

theorem k215UnpairAt3595Step11Z (b n c: nat): $ k215PStep (k215UnpairAt3595State k215PNum3597 0 b n c) = (k215UnpairAt3595State k215PNum3599 0 b n c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair3595_3597) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt3595Reach11Z (b n c: nat): $ k215PReach (k215UnpairAt3595State k215PNum3597 0 b n c) (k215UnpairAt3595State k215PNum3599 0 b n c) $ = '(k215PReach_step k215UnpairAt3595Step11Z);

theorem k215UnpairAt3595Step11S (a b n c: nat): $ k215PStep (k215UnpairAt3595State k215PNum3597 (suc a) b n c) = (k215UnpairAt3595State k215PNum3598 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair3595_3597) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215UnpairAt3595Reach11S (a b n c: nat): $ k215PReach (k215UnpairAt3595State k215PNum3597 (suc a) b n c) (k215UnpairAt3595State k215PNum3598 a b n c) $ = '(k215PReach_step k215UnpairAt3595Step11S);

theorem k215UnpairAt3595Step12 (a b n c: nat): $ k215PStep (k215UnpairAt3595State k215PNum3598 a b n c) = (k215UnpairAt3595State k215PNum3602 a b n c) $ = '(k215PAtCB k215PLookupUnpair3595_3598);

theorem k215UnpairAt3595Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt3595State k215PNum3598 a b n c) (k215UnpairAt3595State k215PNum3602 a b n c) $ = '(k215PReach_step k215UnpairAt3595Step12);

theorem k215UnpairAt3595Step16 (a b n c: nat): $ k215PStep (k215UnpairAt3595State k215PNum3602 a b n c) = (k215UnpairAt3595State k215PNum3595 a b n c) $ = '(k215PAtCC k215PLookupUnpair3595_3602);

theorem k215UnpairAt3595Reach16 (a b n c: nat): $ k215PReach (k215UnpairAt3595State k215PNum3602 a b n c) (k215UnpairAt3595State k215PNum3595 a b n c) $ = '(k215PReach_step k215UnpairAt3595Step16);

theorem k215UnpairAt3595CycleZero (b n c: nat): $ k215PReach (k215UnpairAt3595State k215PNum3595 0 b (suc n) c) (k215UnpairAt3595State k215PNum3595 (suc b) 0 n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt3595Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt3595Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt3595Reach11Z) (ax_mp (ax_mp k215PReach_trans k215UnpairAt3595ReachTransfer) k215UnpairAt3595Reach16))));
theorem k215UnpairAt3595CycleSucc (a b n c: nat): $ k215PReach (k215UnpairAt3595State k215PNum3595 (suc a) b (suc n) c) (k215UnpairAt3595State k215PNum3595 a (suc b) n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt3595Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt3595Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt3595Reach11S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt3595Reach12) k215UnpairAt3595Reach16))));


theorem k215UnpairAt3595AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt3595State k215PNum3595 0 b (suc n) c) (k215UnpairAt3595State k215PNum3595 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt3595Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215PairDiagonal_rotate)) (eqtr (eqcom sndpr) (sndeq k215PairDiagonal_rotate)) eqid eqid)) k215UnpairAt3595CycleZero);

theorem k215UnpairAt3595AdvanceSucc (a b n c: nat): $ k215PReach (k215UnpairAt3595State k215PNum3595 (suc a) b (suc n) c) (k215UnpairAt3595State k215PNum3595 (fst (suc ((suc a), b))) (snd (suc ((suc a), b))) n c) $ =
