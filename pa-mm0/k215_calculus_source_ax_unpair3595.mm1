pub theorem k215UnpairAt3595Advance (a b n c: nat): $ k215PReach (k215UnpairAt3595State k215PNum3595 a b (suc n) c) (k215UnpairAt3595State k215PNum3595 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
 (named @ induct '(ind) 'a 'k215UnpairAt3595AdvanceZero '(a1i k215UnpairAt3595AdvanceSucc));
@_ abstract def k215UnpairAt3595Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt3595State k215PNum3595 a b n c) (k215UnpairAt3595State k215PNum3603 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
theorem k215UnpairAt3595RunZero (a b c: nat): $ k215UnpairAt3595Run 0 a b c $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt3595Stateeq eqid
     (eqcom (eqtr (fsteq add0) fstpr))
     (eqcom (eqtr (sndeq add0) sndpr)) eqid eqid)) k215UnpairAt3595Reach9Z);
@_ abstract def k215UnpairAt3595Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt3595Run n a b c $;
theorem k215UnpairAt3595Claim_at (n a b c: nat): $ k215UnpairAt3595Claim n c -> k215UnpairAt3595Run n a b c $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215UnpairAt3595CodeStep (a b n: nat): $ (fst (suc (a, b)), snd (suc (a, b))) + n = (a, b) + suc n $ =
 '(eqtr (addeq1 fstsnd) addSass);
theorem k215UnpairAt3595RunInductive (n a b c: nat): $ k215UnpairAt3595Claim n c -> k215UnpairAt3595Run (suc n) a b c $ =
 '(syl (ax_mp k215PReach_trans k215UnpairAt3595Advance)
   (mpbid (a1i (k215PReacheq2 (k215UnpairAt3595Stateeq eqid
     (fsteq k215UnpairAt3595CodeStep) (sndeq k215UnpairAt3595CodeStep) eqid eqid))) k215UnpairAt3595Claim_at));
theorem k215UnpairAt3595Claim_all (n c: nat): $ k215UnpairAt3595Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt3595RunZero)) '(iald @ iald k215UnpairAt3595RunInductive));
pub theorem k215UnpairMacro3595 (n a b c: nat): $ k215PReach (k215UnpairAt3595State k215PNum3595 a b n c) (k215UnpairAt3595State k215PNum3603 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
 '(ax_mp k215UnpairAt3595Claim_at k215UnpairAt3595Claim_all);
pub theorem k215UnpairMacro3595_clean (n c: nat): $ k215PReach (k215UnpairAt3595State k215PNum3595 0 0 n c) (k215UnpairAt3595State k215PNum3603 (fst n) (snd n) 0 c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt3595Stateeq eqid
   (fsteq (eqtr (addeq1 pr0) add01))
   (sndeq (eqtr (addeq1 pr0) add01)) eqid eqid)) k215UnpairMacro3595);


