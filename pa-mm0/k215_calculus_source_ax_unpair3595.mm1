do (apply (register-eqd 'k215UnpairAt3595State) '(k215UnpairAt3595Stateeqd));

theorem k215UnpairAt3595Transfer (b n c: nat): $ k215PIter (3 * b + 1) (k215UnpairAt3595State k215PNum3599 0 b n c) = (k215UnpairAt3595State k215PNum3602 b 0 n c) $ =
