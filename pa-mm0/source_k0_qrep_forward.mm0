import "source_k0_qrep_forward_point.mm0";

import "source_k0_qrep_witness_syntax.mm0";

theorem sfK0QRep_image_forward (E: set) (n a c s x y M R phi: nat) (hf: $ sfBound (suc (suc n)) phi $) (hM: $ 2 < M $)
 (hMR: $ M < R $) (ha: $ a < M $) (hc: $ c < M $)
 (hs: $ s < M $) (hx: $ x < M $) (hy: $ y < M $)
 (hs0: $ s != 0 $) (hs1: $ s != 1 $) (hsa: $ s != a $)
 (hsc: $ s != c $) (hsx: $ s != x $)
 (hx0: $ x != 0 $) (hx1: $ x != 1 $) (hx2: $ x != 2 $) (hxy: $ x != y $)
 (he: $ sqEnvBelow E n R $) (hes: $ sqEnvAvoid E n s $)
 (hem: $ sqEnvAvoid E n M $):
 $ k218QProvable (kImp (kImp (kImp kEmptyMarker (kImp (kAll s (kImp (kImp (kImp (kMem 1 s) (kImp (kMem s c) kF)) kF) (kExists x (kImp (kImp (kImp (kImp (kMem 1 x) (kImp (kMem x a) kF)) kF) (kImp (sfK0QRepRelation E 1 R x s phi) kF)) kF)))) kF)) kF) (kImp (sqMember 1 y c M) (kExists x (kImp (kImp (kImp (kImp (kMem 1 x) (kImp (sqMember 1 x a (suc M)) kF)) kF) (kImp (sfK0QRepRelation E 1 R x y phi) kF)) kF)))) $;
