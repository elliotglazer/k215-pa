import "source_l_separation_image_producer_final.mm1";
import "source_l_separation_image_definable_law.mm1";

-- Same six stage proofs as sfLSeparationImage_schema_from_generic_candidate.
pub theorem sfLSeparationImage_schema_from_definable_law(n phi:nat)
 (hb:$ sfBound (suc n) phi $)
 (hD:$ sfTheoryProvable zfrAxioms
   (sfLReplacementDefinableLaw (suc n) (sfPieceSeparationPredicate phi)) $):
 $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain (zfcSeparationCode phi n)) $ =
 '(sfLSeparationImage_schema_from_law_and_source_proofs hb
   sfLReplacementExtension_zfr (sfLReplacementAbove_zfr hb)
   sfLReplacementLevelExists_zfr sfLReplacementSubset_zfr
   sfLSeparationStageTrans_zfr sfCLZero_zfr hD);
