import "bb215_source_numerals.mm0";

import "source_local_extra.mm0";

def paSIF0: nat = $ sfMem 0 1 $;

def paSIF1: nat = $ sfImp paSIF0 sfBot $;

def paSourceZero: nat = $ sfAll paSIF1 $;

theorem paSourceZero_bound: $ sfBound 1 paSourceZero $;

theorem paSourceZero_wf: $ sfWf paSourceZero $;

def paSIF2: nat = $ sfMem 0 2 $;

def paSIF3: nat = $ sfEq 0 1 $;

def paSIF4: nat = $ sfOr paSIF0 paSIF3 $;

def paSIF5: nat = $ sfImp paSIF2 paSIF4 $;

def paSIF6: nat = $ sfImp paSIF4 paSIF2 $;

def paSIF7: nat = $ sfAnd paSIF5 paSIF6 $;

def paSourceSuccessor: nat = $ sfAll paSIF7 $;

theorem paSourceSuccessor_bound: $ sfBound 2 paSourceSuccessor $;

theorem paSourceSuccessor_wf: $ sfWf paSourceSuccessor $;

def paSIF8: nat = $ sfAnd paSourceZero paSIF0 $;

def paSIF9: nat = $ sfEx paSIF8 $;

def paSIF10: nat = $ sfEq 0 2 $;

def paSIF11: nat = $ sfOr paSIF2 paSIF10 $;

def paSIF12: nat = $ sfImp paSIF0 paSIF11 $;

def paSIF13: nat = $ sfImp paSIF11 paSIF0 $;

def paSIF14: nat = $ sfAnd paSIF12 paSIF13 $;

def paSIF15: nat = $ sfAll paSIF14 $;

def paSIF16: nat = $ sfAnd paSIF15 paSIF2 $;

def paSIF17: nat = $ sfEx paSIF16 $;

def paSIF18: nat = $ sfImp paSIF0 paSIF17 $;

def paSIF19: nat = $ sfAll paSIF18 $;

def paSourceInductive: nat = $ sfAnd paSIF9 paSIF19 $;

theorem paSourceInductive_bound: $ sfBound 1 paSourceInductive $;

theorem paSourceInductive_wf: $ sfWf paSourceInductive $;

def paSIF20: nat = $ sfMem 1 0 $;

def paSIF21: nat = $ sfImp paSourceInductive paSIF20 $;

def paSourceNatural: nat = $ sfAll paSIF21 $;

theorem paSourceNatural_bound: $ sfBound 1 paSourceNatural $;

theorem paSourceNatural_wf: $ sfWf paSourceNatural $;

theorem paSourceZero_numeral_zero: $ paSourceZero = bb215SFNumeral 0 $;

theorem paSourceZero_exists: $ zfcProvable (sfEx paSourceZero) $;

def paSISuccessor10: nat = $ sfAll paSIF14 $;

def paSIF22: nat = $ sfImp paSISuccessor10 sfBot $;

def paSIZeroDisjointBody: nat = $ sfImp paSourceZero paSIF22 $;

def paSIF23: nat = $ sfAll paSIZeroDisjointBody $;

def paSourceSuccessorNotZero: nat = $ sfAll paSIF23 $;

theorem paSourceSuccessorNotZero_closed: $ sfBound 0 paSourceSuccessorNotZero $;

def paSIF24: nat = $ sfEq 0 0 $;

def paSIF25: nat = $ sfAll paSIF24 $;

def paSIreflPoint: nat = $ sfEq 1 1 $;

def paSIF26: nat = $ sfMem 1 1 $;

def paSIF27: nat = $ sfOr paSIF26 paSIreflPoint $;

def paSIF28: nat = $ sfImp paSIF20 paSIF27 $;

def paSIF29: nat = $ sfImp paSIF27 paSIF20 $;

def paSIsuccessorPoint: nat = $ sfAnd paSIF28 paSIF29 $;

def paSIzeroPoint: nat = $ sfImp paSIF20 sfBot $;

theorem paSourceSuccessorNotZero_provable: $ zfcProvable paSourceSuccessorNotZero $;
