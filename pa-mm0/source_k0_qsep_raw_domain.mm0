 $ sfNamedTemplate (sqEnvCons t (sqEnvCons a E)) k 0 edESFormula = (kExists k (kAll (suc k) (sfK0QSepEnvelopeBody t a k (suc k)))) $;

theorem sfK0QSepEnvelope_exists (t a k: nat) (hk: $ 0 < k $) (ht: $ t < k $) (ha: $ a < k $):
 $ k218QProvable (kExists k (kAll (suc k) (sfK0QSepEnvelopeBody t a k (suc k)))) $;

theorem sfK0QSepRaw_domain (E: set) (n t a k theta: nat) (hf: $ sfBound (suc n) theta $) (hk: $ 0 < k $)
 (ht: $ t < k $) (ha: $ a < k $) (he: $ sqEnvBelow E n k $):
 $ k218QProvable (kImp (kAnd (kAll (suc (suc (suc (suc (suc (suc (suc (suc k)))))))) (kNot (kMem (suc (suc (suc (suc (suc (suc (suc (suc k)))))))) t))) (kMem t a)) (kExists (suc (suc (suc (suc (suc (suc k)))))) (sfK0QSepGeneralWitnessBody E t a (suc (suc (suc (suc (suc (suc k)))))) (suc (suc (suc (suc k)))) (suc (suc (suc (suc (suc (suc (suc (suc (suc k))))))))) theta))) $;
