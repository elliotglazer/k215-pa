import "pa_proof_numeral_diagonal_introduction.mm0";

def paProofNumeralDiagonalCertificate (b h p k q: nat): wff = $ paProofDerives p (paProofRow 1 (paProofNumeralDiagonalEliminationFunctionality b) h) /\ paProofDerives q (paProofRow 0 (paProofNumeralDiagonalIntroductionInstance b) k) $;

def paProofNumeralDiagonalCertificateFormula (b a: nat): nat = $ (paFormulaAnd (paProofNumeralDiagonalEliminationFormula b a) (paProofNumeralDiagonalIntroductionFormula b a)) $;

def paProofNumeralDiagonalCertificateAnnotation (b a h p k q: nat): nat = $ paProofNumeralBoundedMPAnnotation 0 (paProofNumeralDiagonalIntroductionFormula b a) (paFormulaAnd (paProofNumeralDiagonalEliminationFormula b a) (paProofNumeralDiagonalIntroductionFormula b a)) (paProofNumeralDiagonalIntroductionAnnotation b a k q) (paProofNumeralBoundedMPAnnotation 0 (paProofNumeralDiagonalEliminationFormula b a) (paFormulaImp (paProofNumeralDiagonalIntroductionFormula b a) (paFormulaAnd (paProofNumeralDiagonalEliminationFormula b a) (paProofNumeralDiagonalIntroductionFormula b a))) (paProofNumeralDiagonalEliminationAnnotation b a h p) (paProofAxiomAnnotation (paProofNumeralBoundedQFAndIntroWitness 0 (paProofNumeralDiagonalEliminationFormula b a) (paProofNumeralDiagonalIntroductionFormula b a)))) $;

def paProofNumeralDiagonalCertificateProof (b a h p k q: nat): nat = $ paProofNumeralBoundedMPProof 0 (paProofNumeralDiagonalIntroductionFormula b a) (paFormulaAnd (paProofNumeralDiagonalEliminationFormula b a) (paProofNumeralDiagonalIntroductionFormula b a)) (paProofNumeralDiagonalIntroductionAnnotation b a k q) (paProofNumeralBoundedMPAnnotation 0 (paProofNumeralDiagonalEliminationFormula b a) (paFormulaImp (paProofNumeralDiagonalIntroductionFormula b a) (paFormulaAnd (paProofNumeralDiagonalEliminationFormula b a) (paProofNumeralDiagonalIntroductionFormula b a))) (paProofNumeralDiagonalEliminationAnnotation b a h p) (paProofAxiomAnnotation (paProofNumeralBoundedQFAndIntroWitness 0 (paProofNumeralDiagonalEliminationFormula b a) (paProofNumeralDiagonalIntroductionFormula b a)))) (paProofNumeralDiagonalIntroductionProof b a k q) (paProofNumeralBoundedMPProof 0 (paProofNumeralDiagonalEliminationFormula b a) (paFormulaImp (paProofNumeralDiagonalIntroductionFormula b a) (paFormulaAnd (paProofNumeralDiagonalEliminationFormula b a) (paProofNumeralDiagonalIntroductionFormula b a))) (paProofNumeralDiagonalEliminationAnnotation b a h p) (paProofAxiomAnnotation (paProofNumeralBoundedQFAndIntroWitness 0 (paProofNumeralDiagonalEliminationFormula b a) (paProofNumeralDiagonalIntroductionFormula b a))) (paProofNumeralDiagonalEliminationProof b a h p) (paProofNumeralBoundedQFAndIntroProof 0 (paProofNumeralDiagonalEliminationFormula b a) (paProofNumeralDiagonalIntroductionFormula b a))) $;

theorem paProofNumeralDiagonalCertificate_derives (b a h p k q: nat): $ paFormulaBound 1 a /\ paProofNumeralDiagonalCertificate b h p k q -> paProofDerives (paProofNumeralDiagonalCertificateProof b a h p k q) (paProofRow 0 (paProofNumeralDiagonalCertificateFormula b a) (paProofNumeralDiagonalCertificateAnnotation b a h p k q)) $;
