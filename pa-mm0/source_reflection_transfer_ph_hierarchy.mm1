import "source_reflection_transfer_ph_producers.mm1";

import "source_reflection_transfer_merge_hierarchy.mm1";

pub theorem sfReflectionPH_exists_from_hierarchy(hE:$ sfTheoryProvable zfrAxioms sfLUniversalHierarchyExists $): $ sfTheoryProvable zfrAxioms (sfReflectionCondLevelExists sfLUniversalHierarchyRelation) $ = (named '(mpbir (trud (sfTheoryProvable_congr (a1i sfLUniversalHierarchyExists_consumer_eq))) hE));

pub theorem sfReflectionPH_subset_from_hierarchy(hS:$ sfTheoryProvable zfrAxioms sfLPowerHierarchySubset $): $ sfTheoryProvable zfrAxioms (sfReflectionHierarchySubsetNormal sfLUniversalHierarchyRelation) $ = (named '(mpbir (trud (sfTheoryProvable_congr (a1i sfReflectionHierarchySubset_normal_eq))) (sfPieceHierarchySubset_normal hS)));

pub theorem sfReflectionPH_coverage_from_hierarchy(hE:$ sfTheoryProvable zfrAxioms sfLUniversalHierarchyExists $)(hL:$ sfTheoryProvable zfrAxioms (sfReflectionLimitLevelLimit sfLUniversalHierarchyRelation) $)(hM:$ sfTheoryProvable zfrAxioms (sfReflectionLimitLevelMono sfLUniversalHierarchyRelation) $): $ sfTheoryProvable zfrAxioms (sfReflectionLimitCoverageLaw sfLUniversalHierarchyRelation) $ = (named '(ax_mp (ax_mp sfTheoryProvable_mp (ax_mp (ax_mp sfTheoryProvable_mp (ax_mp (ax_mp sfTheoryProvable_mp (sfReflectionLimitCoverage_zfr_meta sfLUniversalHierarchyRelation_bound)) (sfReflectionPH_exists_from_hierarchy hE))) hL)) hM));

pub theorem sfReflectionPH3_from_hierarchy(T F:set)(start domain sb sc n i:nat)(hd:$ sfBound 1 domain $)(hv:$ sfPieceTableValid sb sc n $)(hi:$ i < n $)(hE:$ sfTheoryProvable zfrAxioms sfLUniversalHierarchyExists $)(hS:$ sfTheoryProvable zfrAxioms sfLPowerHierarchySubset $)(hL:$ sfTheoryProvable zfrAxioms (sfReflectionLimitLevelLimit sfLUniversalHierarchyRelation) $)(hM:$ sfTheoryProvable zfrAxioms (sfReflectionLimitLevelMono sfLUniversalHierarchyRelation) $): $ sfTheoryProvable zfrAxioms (sfReflectionPH3Law T start domain sfLUniversalHierarchyRelation sb sc n i) $ = (named '(! sfReflectionPH3_from_producers $ T $ $ F $ $ start $ $ domain $ $ sfLUniversalHierarchyRelation $ $ sb $ $ sc $ $ n $ $ i $ hd sfLUniversalHierarchyRelation_bound hv hi (sfReflectionPH_exists_from_hierarchy hE) (sfReflectionPH_subset_from_hierarchy hS) (sfReflectionPH_coverage_from_hierarchy hE hL hM)));
