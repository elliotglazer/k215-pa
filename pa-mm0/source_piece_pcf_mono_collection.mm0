def sfPieceMonoCollectionPrelude(phi:nat):nat = $ sfShift 0 (sfShift 0 (sfAll (sfPieceMonoCode phi))) $;

def sfPieceMonoCollectionLaw(phi:nat):nat = $ sfImp (sfPieceMonoCollectionPrelude phi) (sfOrdinalCollectionMono (sfRename sfPieceQMap 0 phi)) $;

def pcmcQMap(x y z:nat):set = $ sfComposeMap (sfLCBinaryMap x y z) sfPieceQMap $;

theorem sfPieceQ_binary(phi x y z:nat)(hf:$ sfWf phi $): $ sfLCBinary (sfRename sfPieceQMap 0 phi) x y z = sfPieceTriple phi x z y (suc z) $;

theorem sfPieceMonoCollection_literal(phi:nat)(hf:$ sfWf phi $): $ (pcmcF113 phi) = sfPieceMonoCollectionLaw phi $;

theorem sfPieceMonoCollection_nd(phi:nat)(hf:$ sfWf phi $): $ nsLocal 0 (sfPieceMonoCollectionLaw phi) $;

theorem sfPieceMonoCollection_pure(T:set)(phi:nat)(hf:$ sfWf phi $): $ sfTheoryProvable T (sfPieceMonoCollectionLaw phi) $;

theorem sfPieceMonoCollection_rule(T:set)(phi:nat)(ht:$ sfTheoryClosed T $)(hf:$ sfWf phi $): $ sfTheoryProvable T (sfPieceMonoCode phi) -> sfTheoryProvable T (sfOrdinalCollectionMono (sfRename sfPieceQMap 0 phi)) $;
