import "source_reflection_transfer_piece.mm1";

import "source_piece_pcf_function_opening.mm1";

pub theorem sfReflectionFunctionConjunction_member(domain level:nat)(E:set)(n d X G i:nat): $ nsLocal G (sfPieceFunctionConjunction domain level E n d X) -> i < n -> nsLocal G (sfPiecePC domain level (sfPieceFunctionCount E i) (sfPieceFunctionMatrix E i) d X) $ = (named '(syl6 (bi1 (nsLocal_formula_eq sfPieceFunctionRows_value)) (syl sfCLRowProofs_at sfPieceFold_project)));

pub theorem sfReflectionFunctionPH_conjunction_local(T F:set)(G domain level:nat)(E:set)(n i d X y z:nat)(hd:$ sfBound 1 domain $)(hl:$ sfBound 2 level $)(hv:$ sfPieceFunctionTableValid E n $)(hi:$ i < n $)(hm:$ sfReflectionDnMembers T G X (sfPieceFunctionCount E i) $)(hL:$ nsLocal G (sfORBinary level y d) $)(hP:$ nsLocal G (sfPieceFunctionConjunction domain level E n d X) $)(hS:$ nsLocal G (sfCLSubset y z) $): $ nsLocal G (sfReflectionEwAt domain (sfRename T 1 (sfPieceFunctionMatrix E i)) z) $ = (named '(! sfReflectionPH_PC_local $ T $ $ F $ $ G $ $ domain $ $ level $ $ sfPieceFunctionMatrix E i $ $ sfPieceFunctionCount E i $ $ d $ $ X $ $ y $ $ z $ hd hl (ax_mp (ax_mp sfPieceFunctionTableValid_at hv) hi) hm hL (ax_mp (ax_mp sfReflectionFunctionConjunction_member hP) hi) hS));
