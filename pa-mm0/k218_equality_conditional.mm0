import "k218_equality_laws.mm0";

-- The side conditions are inside the PA formula, rather than metatheorem
-- assumptions, so this form can be used under numerical induction.
theorem k218EqInd_vacuity_if (z x y: nat):
  $ z != x /\ z != y ->
    k218Provable (kImp (k218EqInd x y) (kAll z (k218EqInd x y))) $;
