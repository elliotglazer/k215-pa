theorem sfK0QRepCarrier_image (E: set) (n k phi: nat) (hf: $ sfBound (suc (suc n)) phi $) (hk: $ 2 < k $) (he: $ sqEnvBelow E n k $):
 $ k218QProvable (kImp kEmptyMarker (sqQuote E 1 k 0 (sfReplacement (sfRename sfRepAMap 0 phi) (sfRename sfRepBMap 0 phi) (sfRename sfRepCMap 0 phi)))) $;
