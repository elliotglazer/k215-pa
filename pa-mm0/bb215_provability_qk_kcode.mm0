import "bb215_provability_qk_graph.mm0";

theorem bb215ProvabilityQK_two_two: $ 2 * 2 = 4 $;

theorem bb215ProvabilityQK_le_four (x: nat): $ x <= 4 * x $;

theorem bb215ProvabilityQKImp_k (a b: nat): $ bb215ProvabilityQKImp a b = kImp a b $;

theorem bb215ProvabilityQKMem_k (a b: nat): $ bb215ProvabilityQKMem a b = kMem a b $;

theorem bb215ProvabilityQKAll_k (a b: nat): $ bb215ProvabilityQKAll a b = kAll a b $;

theorem bb215ProvabilityQKEq_k (a b: nat): $ bb215ProvabilityQKEq a b = kEq a b $;

theorem bb215ProvabilityQKImp_le1 (a b: nat): $ a <= bb215ProvabilityQKImp a b $;

theorem bb215ProvabilityQKMem_le1 (a b: nat): $ a <= bb215ProvabilityQKMem a b $;

theorem bb215ProvabilityQKAll_le1 (a b: nat): $ a <= bb215ProvabilityQKAll a b $;

theorem bb215ProvabilityQKEq_le1 (a b: nat): $ a <= bb215ProvabilityQKEq a b $;

theorem bb215ProvabilityQKImp_le2 (a b: nat): $ b <= bb215ProvabilityQKImp a b $;

theorem bb215ProvabilityQKMem_le2 (a b: nat): $ b <= bb215ProvabilityQKMem a b $;

theorem bb215ProvabilityQKAll_le2 (a b: nat): $ b <= bb215ProvabilityQKAll a b $;

theorem bb215ProvabilityQKEq_le2 (a b: nat): $ b <= bb215ProvabilityQKEq a b $;

theorem bb215ProvabilityQK_le_rewrite (x k r: nat): $ x <= k -> r = k -> x <= r $;

theorem bb215ProvabilityQK_ne_of_imp (a b: nat): $ (a = b -> 0 != 0) -> a != b $;

theorem bb215ProvabilityQK_imp_of_ne (a b: nat): $ a != b -> a = b -> 0 != 0 $;

theorem bb215ProvabilityQKAxRho1Graph_iff (r a b: nat): $ bb215ProvabilityQKAxRho1Graph r a b <-> r = kRho1 a b $;

theorem bb215ProvabilityQKAxRho2Graph_iff (r a b c: nat): $ bb215ProvabilityQKAxRho2Graph r a b c <-> r = kRho2 a b c $;

theorem bb215ProvabilityQKAxRho3Graph_iff (r a b c: nat): $ bb215ProvabilityQKAxRho3Graph r a b c <-> r = kRho3 a b c $;

theorem bb215ProvabilityQKAxRho4Graph_iff (r a b c: nat): $ bb215ProvabilityQKAxRho4Graph r a b c <-> r = kRho4 a b c $;

theorem bb215ProvabilityQKAxRho5Graph_iff (r a b c: nat): $ bb215ProvabilityQKAxRho5Graph r a b c <-> r = kRho5 a b c $;

theorem bb215ProvabilityQKAxRho6Graph_iff (r a b: nat): $ bb215ProvabilityQKAxRho6Graph r a b <-> r = kRho6 a b $;

theorem bb215ProvabilityQKAxGGraph_iff (r a b c: nat): $ bb215ProvabilityQKAxGGraph r a b c <-> r = k218RhoG a b c $;

theorem bb215ProvabilityQKAxRho8Graph_iff (r a b c u: nat): $ bb215ProvabilityQKAxRho8Graph r a b c u <-> r = kRho8 a b c u $;

theorem bb215ProvabilityQKAxBundleGraph_iff (r a b c: nat): $ bb215ProvabilityQKAxBundleGraph r a b c <-> r = k218Bundle a b c $;

theorem bb215ProvabilityQKImp_k_zero: $ bb215ProvabilityQKImp 0 0 = kImp 0 0 $;
