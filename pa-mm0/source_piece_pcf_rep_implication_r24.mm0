theorem sfPieceRepImplication_pure(a b d n r u v:nat)(ha:$ sfWf a $)(hb:$ sfWf b $)(hd:$ sfWf d $)(hn:$ sfWf n $)(hr:$ sfWf r $)(hu:$ sfWf u $)(hv:$ sfWf v $): $ nsLocal 0 (sfImp (sfIff n (sfAnd d (sfImp a sfBot))) (sfImp (sfIff r (sfOr n b)) (sfImp (sfIff a u) (sfImp (sfIff b v) (sfImp d (sfIff r (sfImp u v))))))) $;

theorem sfPieceRepImplication_local(G a b d n r u v:nat)(ha:$ sfWf a $)(hb:$ sfWf b $)(hd:$ sfWf d $)(hn:$ sfWf n $)(hr:$ sfWf r $)(hu:$ sfWf u $)(hv:$ sfWf v $)(hN:$ nsLocal G (sfIff n (sfAnd d (sfImp a sfBot))) $)(hR:$ nsLocal G (sfIff r (sfOr n b)) $)(hA:$ nsLocal G (sfIff a u) $)(hB:$ nsLocal G (sfIff b v) $)(hD:$ nsLocal G d $): $ nsLocal G (sfIff r (sfImp u v)) $;

theorem sfPieceRepImplication_all(G:nat)(a b d n r u v e:nat)(ha:$ sfWf a $)(hb:$ sfWf b $)(hd:$ sfWf d $)(hn:$ sfWf n $)(hr:$ sfWf r $)(hu:$ sfWf u $)(hv:$ sfWf v $)(he:$ sfWf e $)(hN:$ nsLocal G (sfAll (sfAnd (sfImp n (sfAnd d (sfImp a sfBot))) (sfImp (sfAnd d (sfImp a sfBot)) n))) $)(hR:$ nsLocal G (sfAll (sfAnd (sfImp r (sfOr n b)) (sfImp (sfOr n b) r))) $)(hA:$ nsLocal G (sfAll (sfImp e (sfAnd (sfImp a u) (sfImp u a)))) $)(hB:$ nsLocal G (sfAll (sfImp e (sfAnd (sfImp b v) (sfImp v b)))) $)(hD:$ nsLocal G (sfAll (sfImp e d)) $): $ nsLocal G (sfAll (sfImp e (sfAnd (sfImp r (sfImp u v)) (sfImp (sfImp u v) r)))) $;

theorem sfPieceRepImplication_profile_pure(a b d n r u v e:nat)(ha:$ sfWf a $)(hb:$ sfWf b $)(hd:$ sfWf d $)(hn:$ sfWf n $)(hr:$ sfWf r $)(hu:$ sfWf u $)(hv:$ sfWf v $)(he:$ sfWf e $): $ nsLocal 0 (sfImp (sfAll (sfAnd (sfImp n (sfAnd d (sfImp a sfBot))) (sfImp (sfAnd d (sfImp a sfBot)) n))) (sfImp (sfAll (sfAnd (sfImp r (sfOr n b)) (sfImp (sfOr n b) r))) (sfImp (sfAll (sfImp e (sfAnd (sfImp a u) (sfImp u a)))) (sfImp (sfAll (sfImp e (sfAnd (sfImp b v) (sfImp v b)))) (sfImp (sfAll (sfImp e d)) (sfAll (sfImp e (sfAnd (sfImp r (sfImp u v)) (sfImp (sfImp u v) r))))))))) $;

theorem sfPieceRepImplication_count(G count:nat)(a b d n r u v e:nat)(ha:$ sfWf a $)(hb:$ sfWf b $)(hd:$ sfWf d $)(hn:$ sfWf n $)(hr:$ sfWf r $)(hu:$ sfWf u $)(hv:$ sfWf v $)(he:$ sfWf e $)(hN:$ nsLocal G (sfPieceDn count (sfAll (sfAnd (sfImp n (sfAnd d (sfImp a sfBot))) (sfImp (sfAnd d (sfImp a sfBot)) n)))) $)(hR:$ nsLocal G (sfPieceDn count (sfAll (sfAnd (sfImp r (sfOr n b)) (sfImp (sfOr n b) r)))) $)(hA:$ nsLocal G (sfPieceDn count (sfAll (sfImp e (sfAnd (sfImp a u) (sfImp u a))))) $)(hB:$ nsLocal G (sfPieceDn count (sfAll (sfImp e (sfAnd (sfImp b v) (sfImp v b))))) $)(hD:$ nsLocal G (sfPieceDn count (sfAll (sfImp e d))) $): $ nsLocal G (sfPieceDn count (sfAll (sfImp e (sfAnd (sfImp r (sfImp u v)) (sfImp (sfImp u v) r))))) $;
