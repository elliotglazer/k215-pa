import "k215_calculus_source_cycle.mm1";
import "k215_calculus_reverse.mm1";


pub theorem k215PInitialHalts_iff_kInconsistent:
 $ k215PInitialHalts <-> k215Inconsistent $ =
 '(bitr k215PInitialHalts_iff_EnumHalts k215EnumHalts_iff_kInconsistent);

pub theorem k215PInitialHalts_iff_k218Inconsistent:
 $ k215PInitialHalts <-> k218Inconsistent $ =
 '(bitr k215PInitialHalts_iff_kInconsistent k215Cal_Inconsistent_iff);
