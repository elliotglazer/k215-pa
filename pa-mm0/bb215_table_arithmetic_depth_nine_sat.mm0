import "bb215_arithmetic_formula_depth_eight_sat.mm0";

import "pa_source_interpretation_nat_term_assignment.mm0";

def bb215TableArithmeticDepthNineSatBody (E: set) (c h .x: nat): wff = $ ifp (c = 0) (0 != 0) (ifp (sfTag c = 1) (bb215ArithmeticFormulaTermValue E (sfLeft c) = bb215ArithmeticFormulaTermValue E (sfRight c)) (ifp (sfTag c = 3) (sfLeft c e. h /\ sfRight c e. h) (ifp (sfTag c = 4) (sfLeft c e. h \/ sfRight c e. h) (ifp (sfTag c = 5) (sfLeft c e. h -> sfRight c e. h) (ifp (sfTag c = 6 /\ sfRight c = 0) (A. x bb215ArithmeticFormulaDepthEightSat (paNatTermConsEnvironment E x) (sfLeft c)) (ifp (sfTag c = 7 /\ sfRight c = 0) (E. x bb215ArithmeticFormulaDepthEightSat (paNatTermConsEnvironment E x) (sfLeft c)) (0 != 0))))))) $;

def bb215TableArithmeticDepthNineSatStep (E: set) (.c .h: nat): set = $ S\ c, {h | bb215TableArithmeticDepthNineSatBody E c h} $;

def bb215TableArithmeticDepthNineSat (E: set) (c: nat): wff = $ srecp (bb215TableArithmeticDepthNineSatStep E) c $;

def bb215TableArithmeticDepthNineSatPrevious (E: set) (c .i: nat): nat = $ sep (upto c) {i | srecp (bb215TableArithmeticDepthNineSatStep E) i} $;

theorem bb215TableArithmeticDepthNineSatStep_value (E: set) (c h: nat): $ (c, h) e. bb215TableArithmeticDepthNineSatStep E <-> bb215TableArithmeticDepthNineSatBody E c h $;

theorem bb215TableArithmeticDepthNineSatPrevious_value (E: set) (c a: nat): $ a e. bb215TableArithmeticDepthNineSatPrevious E c <-> a < c /\ bb215TableArithmeticDepthNineSat E a $;

theorem bb215TableArithmeticDepthNineSat_unfold (E: set) (c: nat): $ bb215TableArithmeticDepthNineSat E c <-> bb215TableArithmeticDepthNineSatBody E c (bb215TableArithmeticDepthNineSatPrevious E c) $;

theorem bb215TableArithmeticDepthNineSat_false (E: set): $ bb215TableArithmeticDepthNineSat E paFormulaFalse <-> 0 != 0 $;

theorem bb215TableArithmeticDepthNineSat_equal (E: set) (a b: nat): $ bb215TableArithmeticDepthNineSat E (paFormulaEqual a b) <-> bb215ArithmeticFormulaTermValue E a = bb215ArithmeticFormulaTermValue E b $;

theorem bb215TableArithmeticDepthNineSat_and (E: set) (a b: nat): $ bb215TableArithmeticDepthNineSat E (paFormulaAnd a b) <-> (bb215TableArithmeticDepthNineSat E a /\ bb215TableArithmeticDepthNineSat E b) $;

theorem bb215TableArithmeticDepthNineSat_or (E: set) (a b: nat): $ bb215TableArithmeticDepthNineSat E (paFormulaOr a b) <-> (bb215TableArithmeticDepthNineSat E a \/ bb215TableArithmeticDepthNineSat E b) $;

theorem bb215TableArithmeticDepthNineSat_imp (E: set) (a b: nat): $ bb215TableArithmeticDepthNineSat E (paFormulaImp a b) <-> (bb215TableArithmeticDepthNineSat E a -> bb215TableArithmeticDepthNineSat E b) $;

theorem bb215TableArithmeticDepthNineSat_all (E: set) (a: nat) {x: nat}: $ bb215TableArithmeticDepthNineSat E (paFormulaAll a) <-> A. x bb215ArithmeticFormulaDepthEightSat (paNatTermConsEnvironment E x) a $;

theorem bb215TableArithmeticDepthNineSat_ex (E: set) (a: nat) {x: nat}: $ bb215TableArithmeticDepthNineSat E (paFormulaEx a) <-> E. x bb215ArithmeticFormulaDepthEightSat (paNatTermConsEnvironment E x) a $;
