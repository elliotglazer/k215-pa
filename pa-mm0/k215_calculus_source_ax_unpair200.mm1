import "k215_calculus_source_ax_reads_loops.mm1";
import "k215_literal_runtime_reach.mm1";
import "k215_calculus_source_pairing.mm1";
import "k215_calculus_source_ax_reads_lookups.mm1";

@_ def k215UnpairAt200State (pc a b n c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) a b n) $;

do (apply (register-eqd 'k215UnpairAt200State) '(k215UnpairAt200Stateeqd));

theorem k215UnpairAt200Transfer (b n c: nat): $ k215PIter (3 * b + 1) (k215UnpairAt200State k215Num204 0 b n c) = (k215UnpairAt200State k215Num207 b 0 n c) $ =
 '(eqtr k215Loop204Vector (k215PStateeq2 (k215PVectoreq7 add0)));
theorem k215UnpairAt200ReachTransfer (b n c: nat): $ k215PReach (k215UnpairAt200State k215Num204 0 b n c) (k215UnpairAt200State k215Num207 b 0 n c) $ =
 '(k215PReach_intro k215UnpairAt200Transfer);


theorem k215UnpairAt200Step9Z (a b c: nat): $ k215PStep (k215UnpairAt200State k215Num200 a b 0 c) = (k215UnpairAt200State k215Num208 a b 0 c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair200_200) (ifeq (eqeq1 k215PGet8_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt200Reach9Z (a b c: nat): $ k215PReach (k215UnpairAt200State k215Num200 a b 0 c) (k215UnpairAt200State k215Num208 a b 0 c) $ = '(k215PReach_step k215UnpairAt200Step9Z);

theorem k215UnpairAt200Step9S (a b n c: nat): $ k215PStep (k215UnpairAt200State k215Num200 a b (suc n) c) = (k215UnpairAt200State k215Num201 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair200_200) (ifeq (eqeq1 k215PGet8_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet8_vector)) (eqtr k215PSet8_vector (k215PVectoreq9 (eqtr subSS sub02))))));

theorem k215UnpairAt200Reach9S (a b n c: nat): $ k215PReach (k215UnpairAt200State k215Num200 a b (suc n) c) (k215UnpairAt200State k215Num201 a b n c) $ = '(k215PReach_step k215UnpairAt200Step9S);

theorem k215UnpairAt200Step10 (a b n c: nat): $ k215PStep (k215UnpairAt200State k215Num201 a b n c) = (k215UnpairAt200State k215Num202 a (suc b) n c) $ = '(eqtr (k215PAtCI k215PLookupUnpair200_201) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215UnpairAt200Reach10 (a b n c: nat): $ k215PReach (k215UnpairAt200State k215Num201 a b n c) (k215UnpairAt200State k215Num202 a (suc b) n c) $ = '(k215PReach_step k215UnpairAt200Step10);

theorem k215UnpairAt200Step11Z (b n c: nat): $ k215PStep (k215UnpairAt200State k215Num202 0 b n c) = (k215UnpairAt200State k215Num204 0 b n c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair200_202) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt200Reach11Z (b n c: nat): $ k215PReach (k215UnpairAt200State k215Num202 0 b n c) (k215UnpairAt200State k215Num204 0 b n c) $ = '(k215PReach_step k215UnpairAt200Step11Z);

theorem k215UnpairAt200Step11S (a b n c: nat): $ k215PStep (k215UnpairAt200State k215Num202 (suc a) b n c) = (k215UnpairAt200State k215Num203 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair200_202) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215UnpairAt200Reach11S (a b n c: nat): $ k215PReach (k215UnpairAt200State k215Num202 (suc a) b n c) (k215UnpairAt200State k215Num203 a b n c) $ = '(k215PReach_step k215UnpairAt200Step11S);

theorem k215UnpairAt200Step12 (a b n c: nat): $ k215PStep (k215UnpairAt200State k215Num203 a b n c) = (k215UnpairAt200State k215Num207 a b n c) $ = '(k215PAtCB k215PLookupUnpair200_203);

theorem k215UnpairAt200Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt200State k215Num203 a b n c) (k215UnpairAt200State k215Num207 a b n c) $ = '(k215PReach_step k215UnpairAt200Step12);

theorem k215UnpairAt200Step16 (a b n c: nat): $ k215PStep (k215UnpairAt200State k215Num207 a b n c) = (k215UnpairAt200State k215Num200 a b n c) $ = '(k215PAtCC k215PLookupUnpair200_207);

theorem k215UnpairAt200Reach16 (a b n c: nat): $ k215PReach (k215UnpairAt200State k215Num207 a b n c) (k215UnpairAt200State k215Num200 a b n c) $ = '(k215PReach_step k215UnpairAt200Step16);

theorem k215UnpairAt200CycleZero (b n c: nat): $ k215PReach (k215UnpairAt200State k215Num200 0 b (suc n) c) (k215UnpairAt200State k215Num200 (suc b) 0 n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt200Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt200Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt200Reach11Z) (ax_mp (ax_mp k215PReach_trans k215UnpairAt200ReachTransfer) k215UnpairAt200Reach16))));
theorem k215UnpairAt200CycleSucc (a b n c: nat): $ k215PReach (k215UnpairAt200State k215Num200 (suc a) b (suc n) c) (k215UnpairAt200State k215Num200 a (suc b) n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt200Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt200Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt200Reach11S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt200Reach12) k215UnpairAt200Reach16))));


theorem k215UnpairAt200AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt200State k215Num200 0 b (suc n) c) (k215UnpairAt200State k215Num200 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt200Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215PairDiagonal_rotate)) (eqtr (eqcom sndpr) (sndeq k215PairDiagonal_rotate)) eqid eqid)) k215UnpairAt200CycleZero);

theorem k215UnpairAt200AdvanceSucc (a b n c: nat): $ k215PReach (k215UnpairAt200State k215Num200 (suc a) b (suc n) c) (k215UnpairAt200State k215Num200 (fst (suc ((suc a), b))) (snd (suc ((suc a), b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt200Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215Pair_next)) (eqtr (eqcom sndpr) (sndeq k215Pair_next)) eqid eqid)) k215UnpairAt200CycleSucc);

pub theorem k215UnpairAt200Advance (a b n c: nat): $ k215PReach (k215UnpairAt200State k215Num200 a b (suc n) c) (k215UnpairAt200State k215Num200 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
 (named @ induct '(ind) 'a 'k215UnpairAt200AdvanceZero '(a1i k215UnpairAt200AdvanceSucc));
@_ abstract def k215UnpairAt200Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt200State k215Num200 a b n c) (k215UnpairAt200State k215Num208 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
theorem k215UnpairAt200RunZero (a b c: nat): $ k215UnpairAt200Run 0 a b c $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt200Stateeq eqid
     (eqcom (eqtr (fsteq add0) fstpr))
     (eqcom (eqtr (sndeq add0) sndpr)) eqid eqid)) k215UnpairAt200Reach9Z);
@_ abstract def k215UnpairAt200Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt200Run n a b c $;
theorem k215UnpairAt200Claim_at (n a b c: nat): $ k215UnpairAt200Claim n c -> k215UnpairAt200Run n a b c $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215UnpairAt200CodeStep (a b n: nat): $ (fst (suc (a, b)), snd (suc (a, b))) + n = (a, b) + suc n $ =
 '(eqtr (addeq1 fstsnd) addSass);
theorem k215UnpairAt200RunInductive (n a b c: nat): $ k215UnpairAt200Claim n c -> k215UnpairAt200Run (suc n) a b c $ =
 '(syl (ax_mp k215PReach_trans k215UnpairAt200Advance)
   (mpbid (a1i (k215PReacheq2 (k215UnpairAt200Stateeq eqid
     (fsteq k215UnpairAt200CodeStep) (sndeq k215UnpairAt200CodeStep) eqid eqid))) k215UnpairAt200Claim_at));
theorem k215UnpairAt200Claim_all (n c: nat): $ k215UnpairAt200Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt200RunZero)) '(iald @ iald k215UnpairAt200RunInductive));
pub theorem k215UnpairMacro200 (n a b c: nat): $ k215PReach (k215UnpairAt200State k215Num200 a b n c) (k215UnpairAt200State k215Num208 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
 '(ax_mp k215UnpairAt200Claim_at k215UnpairAt200Claim_all);
pub theorem k215UnpairMacro200_clean (n c: nat): $ k215PReach (k215UnpairAt200State k215Num200 0 0 n c) (k215UnpairAt200State k215Num208 (fst n) (snd n) 0 c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt200Stateeq eqid
   (fsteq (eqtr (addeq1 pr0) add01))
   (sndeq (eqtr (addeq1 pr0) add01)) eqid eqid)) k215UnpairMacro200);


