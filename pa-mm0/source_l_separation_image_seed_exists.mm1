pub theorem sfLSeparationReflectionAbove_from_producers(n c:nat)
 (hb:$ sfBound n c $)
 (hP:$ sfReflectionCondProducers sfLUniversalHierarchyRelation (sfTVCanonicalPiece n c) $)
 (hS:$ sfTheoryProvable zfrAxioms (sfReflectionHierarchySubsetNormal sfLUniversalHierarchyRelation) $)
 (hC:$ sfTheoryProvable zfrAxioms (sfReflectionLimitCoverageLaw sfLUniversalHierarchyRelation) $):
 $ sfTheoryProvable zfrAxioms (sfImp sfLeastOrdinalPredicate (sfLSeparationReflectionAbove n c)) $ = '(sfTVTheory_syllogism zfrAxioms_closed (sfTVProfile_exists_from_producers sfLUniversalHierarchyRelation_bound sfTVCanonicalPiece_bound hP) (sfLSeparationReflectionAbove_from_output_zfr hb (anli hP) hS hC));
