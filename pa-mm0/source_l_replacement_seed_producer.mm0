import "source_l_replacement_seed_source.mm0";

def lrepSeedProducerF0(phi:nat):nat = $ sfEx (sfLReplacementAmbientBody phi) $;

def lrepSeedProducerF1(phi:nat):nat = $ sfAll (lrepSeedProducerF0 phi) $;

def lrepSeedProducerG2(phi:nat):nat = $ sfLPowerLevelBound : 0 $;

def lrepSeedProducerG3(phi:nat):nat = $ (lrepSeedProducerF1 phi) : (lrepSeedProducerG2 phi) $;

def lrepSeedProducerG4(phi:nat):nat = $ sfContextShift (lrepSeedProducerG3 phi) $;

def lrepSeedProducerF5(phi:nat):nat = $ sfShift 0 sfLPowerLevelBound $;

def lrepSeedProducerG6(phi:nat):nat = $ sfContextShift (lrepSeedProducerG4 phi) $;

def lrepSeedProducerG7(phi:nat):nat = $ (sfLReplacementAmbientBody phi) : (lrepSeedProducerG6 phi) $;

def lrepSeedProducerF8(phi:nat):nat = $ sfShift 1 (sfLReplacementSeedRange (sfLReplacementSeedMatrix phi) sfLReplacementSeedMetadata) $;

def lrepSeedProducerF9(phi:nat):nat = $ sfEx (lrepSeedProducerF8 phi) $;

def lrepSeedProducerF10(phi:nat):nat = $ sfEx (sfLReplacementSeedRange (sfLReplacementSeedMatrix phi) sfLReplacementSeedMetadata) $;

def lrepSeedProducerF11(phi:nat):nat = $ sfShift 0 (lrepSeedProducerF10 phi) $;

def lrepSeedProducerF12(phi:nat):nat = $ sfAll (lrepSeedProducerF10 phi) $;

def lrepSeedProducerF13(phi:nat):nat = $ sfImp (lrepSeedProducerF1 phi) (lrepSeedProducerF12 phi) $;

def lrepSeedProducerF14(phi:nat):nat = $ sfImp sfLPowerLevelBound (lrepSeedProducerF13 phi) $;

def lrepSeedProducerF15(phi:nat):nat = $ sfImp (sfLReplacementFunctional phi) (lrepSeedProducerF1 phi) $;

def lrepSeedProducerG16(phi:nat):nat = $ (lrepSeedProducerF15 phi) : 0 $;

def lrepSeedProducerG17(phi:nat):nat = $ (lrepSeedProducerF13 phi) : (lrepSeedProducerG16 phi) $;

def lrepSeedProducerG18(phi:nat):nat = $ (sfLReplacementFunctional phi) : (lrepSeedProducerG17 phi) $;

def lrepSeedProducerF19(phi:nat):nat = $ sfImp (sfLReplacementFunctional phi) (lrepSeedProducerF12 phi) $;

def lrepSeedProducerF20(phi:nat):nat = $ sfImp (lrepSeedProducerF13 phi) (lrepSeedProducerF19 phi) $;

def lrepSeedProducerF21(phi:nat):nat = $ sfImp (lrepSeedProducerF15 phi) (lrepSeedProducerF20 phi) $;

theorem sfLReplacement_seed_after_image(phi:nat)(hf:$ sfWf phi $):
 $ nsLocal 0 (sfImp sfLPowerLevelBound (sfImp (sfAll (sfEx (sfLReplacementAmbientBody phi)))
  (sfAll (sfEx (sfLReplacementSeedRange (sfLReplacementSeedMatrix phi) sfLReplacementSeedMetadata))))) $;

theorem sfLReplacement_seed_producer(phi n:nat)(hb:$ sfBound (suc (suc n)) phi $)
 (hL:$ sfTheoryProvable zfrAxioms sfLPowerLevelBound $):
 $ sfTheoryProvable zfrAxioms (sfImp (sfLReplacementFunctional phi)
  (sfAll (sfEx (sfLReplacementSeedRange (sfLReplacementSeedMatrix phi) sfLReplacementSeedMetadata)))) $;
