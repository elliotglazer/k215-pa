import "source_k0_qsep_prefix.mm0";
import "k218q_quantifier_macros.mm0";
import "k218q_equivalence.mm0";
import "k230_bootstrap.mm0";

def sfK0QSepPrefixVacuity (k h .d: nat): wff =
 $ A. d k218QProvable (kImp h (kAll (k + d) h)) $;

theorem sfK0QSep_quote_conditional_prefix (E: set) (t k h d n phi: nat)
 (hv: $ sfK0QSepPrefixVacuity k h $):
 $ k218QProvable (kImp h (sqQuote E t k (d + n) phi)) ->
 k218QProvable (kImp h (sqQuote E t k d (sfAllPrefix n phi))) $;

theorem sfK0QSepEmptyMarker_prefix_vacuity (k: nat) (hk: $ 2 < k $):
 $ sfK0QSepPrefixVacuity k kEmptyMarker $;

theorem sfK0QSep_quote_marker_prefix (E: set) (t k d n phi: nat) (hk: $ 2 < k $):
 $ k218QProvable (kImp kEmptyMarker (sqQuote E t k (d + n) phi)) ->
 k218QProvable (kImp kEmptyMarker (sqQuote E t k d (sfAllPrefix n phi))) $;
