theorem sfReflectionPHExistsOn_from_level(G level K:nat)(hl:$ sfBound 2 level $)(hO:$ nsLocal G (sfReflectionCofinalOrdinals K) $)(hE:$ nsLocal G (sfReflectionCondLevelExists level) $): $ nsLocal G (sfReflectionPHExistsOn level K) $;

theorem sfReflectionPH_from(T F:set)(G start domain level sb sc n i K a z:nat)(hd:$ sfBound 1 domain $)(hl:$ sfBound 2 level $)(hv:$ sfPieceTableValid sb sc n $)(hi:$ i < n $)(ha:$ nsLocal G (sfMem a K) $)(hO:$ nsLocal G (sfReflectionCofinalOrdinals K) $)(hLE:$ nsLocal G (sfReflectionCondLevelExists level) $)(hCover:$ nsLocal G (sfReflectionCofinalCover level K z) $)(hMerge:$ nsLocal G (sfReflectionCofinalMergeLaw level K) $)(hT:$ nsLocal G (sfReflectionTuple T start z (sfPieceCount sb sc i)) $)(hN:$ nsLocal G (sfReflectionPHNextOn level (sfPieceBinary domain (sfReflectionPCLevel level) sb sc n) K) $)(hS:$ nsLocal G (sfReflectionPHSubsetOn level K z) $): $ nsLocal G (sfReflectionTupleEw T start domain (sfPieceMatrix sb sc i) z) $;
