import "b4g2_env.mm0";
import "b4g2_eqd.mm0";
import "b4b_bc_join.mm0";

theorem bdZfcConPrf_intro (m v w s: nat):
  $ bcJust m v /\ s < v /\ bcConSrc m v s /\ bdZfcPrf w s -> bdZfcConPrf (m, (v, w)) $;
theorem bdZfcConPrf_iff_of {u s m v: nat}
  (hC: $ A. s (s = paFormulaSource zfcConPA <-> E. m E. v (bcJust m v /\ bcConSrc m v s)) $):
  $ zfcProvable (paFormulaSource zfcConPA) <-> E. u bdZfcConPrf u $;
theorem K215_G2_pi2_of_of {u w s m v: nat}
  (hC: $ A. s (s = paFormulaSource zfcConPA <-> E. m E. v (bcJust m v /\ bcConSrc m v s)) $)
  (hT: $ ~zfcInconsistent -> ~zfcProvable (paFormulaSource zfcConPA) $):
  $ A. u (bdZfcConPrf u -> E. w bdZfcBot w) $;
