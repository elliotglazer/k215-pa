import "source_l_separation_image_schema_kernel.mm1";

import "source_l_replacement_parameter_transport.mm1";

def sfLSeparationProducerContext(n phi:nat):nat =
 $ sfLReplacementLevelExtension :
  (sfLReplacementAboveLaw (suc n) phi :
   (sfLReplacementLevelExistsLaw :
    (sfReflectionHierarchySubsetNormal sfCLHierarchy :
     (sfLSeparationStageTransNormal : (sfCLRecipe 0 0 : 0))))) $;

def sfLSeparationProducerDefinableContext(n phi:nat):nat =
 $ sfLSeparationReflectedContext (sfLSeparationImageInputContext (sfLSeparationProducerContext n phi) n) n phi $;



pub theorem sfLSeparationImageInput_lift(G n f:nat)
 (hf:$ sfShift 0 f = f $)(hp:$ nsLocal G f $):
 $ nsLocal (sfLSeparationImageInputContext G n) f $ =
 '(sfRQ_rewrite hf (ax_mp (ax_mp (ax_mp nsLocal_weaken
   (mpbir sfContextWf_cons (ian sfLDomain_wf sfContextShift_wf))) sfContextSub_cons)
   (ax_mp sfSepLocal_shift (sfLReplacementParameter_lift sfLDomain_wf hf hp))));

theorem slSepProducerInitial_bound: $ sfBound 0 (sfCLRecipe 0 0) $ =
 (named '(ax_mp sfCLRecipe_bound (ax_gen (absurd lt02))));


theorem slSepProducer_context_wf(n phi:nat)
 (hE:$ sfTheoryProvable zfrAxioms sfLReplacementLevelExtension $)
 (hA:$ sfTheoryProvable zfrAxioms (sfLReplacementAboveLaw (suc n) phi) $)
 (hL:$ sfTheoryProvable zfrAxioms sfLReplacementLevelExistsLaw $)
 (hS:$ sfTheoryProvable zfrAxioms (sfReflectionHierarchySubsetNormal sfCLHierarchy) $)
 (hT:$ sfTheoryProvable zfrAxioms sfLSeparationStageTransNormal $)
 (hZ:$ sfTheoryProvable zfrAxioms (sfCLRecipe 0 0) $):
 $ sfContextWf (sfLSeparationProducerContext n phi) $ =
 '(mpbir sfContextWf_cons (ian (ax_mp sfTheoryProvable_wf hE) (mpbir sfContextWf_cons (ian (ax_mp sfTheoryProvable_wf hA) (mpbir sfContextWf_cons (ian (ax_mp sfTheoryProvable_wf hL) (mpbir sfContextWf_cons (ian (ax_mp sfTheoryProvable_wf hS) (mpbir sfContextWf_cons (ian (ax_mp sfTheoryProvable_wf hT) (mpbir sfContextWf_cons (ian (ax_mp sfTheoryProvable_wf hZ) sfContextWf_nil))))))))))));

theorem slSepProducer_context_proved(n phi:nat)
 (hE:$ sfTheoryProvable zfrAxioms sfLReplacementLevelExtension $)
 (hA:$ sfTheoryProvable zfrAxioms (sfLReplacementAboveLaw (suc n) phi) $)
 (hL:$ sfTheoryProvable zfrAxioms sfLReplacementLevelExistsLaw $)
 (hS:$ sfTheoryProvable zfrAxioms (sfReflectionHierarchySubsetNormal sfCLHierarchy) $)
 (hT:$ sfTheoryProvable zfrAxioms sfLSeparationStageTransNormal $)
 (hZ:$ sfTheoryProvable zfrAxioms (sfCLRecipe 0 0) $):
 $ all (sfTheoryProofClass zfrAxioms) (sfLSeparationProducerContext n phi) $ =
 '(mpbir sfTheoryContext_cons (ian (mpbir sfTheoryProofClass_value hE) (mpbir sfTheoryContext_cons (ian (mpbir sfTheoryProofClass_value hA) (mpbir sfTheoryContext_cons (ian (mpbir sfTheoryProofClass_value hL) (mpbir sfTheoryContext_cons (ian (mpbir sfTheoryProofClass_value hS) (mpbir sfTheoryContext_cons (ian (mpbir sfTheoryProofClass_value hT) (mpbir sfTheoryContext_cons (ian (mpbir sfTheoryProofClass_value hZ) sfTheoryContext_nil))))))))))));

theorem slSepProducer_hE(n phi:nat)(hg:$ sfContextWf (sfLSeparationProducerContext n phi) $):
 $ nsLocal (sfLSeparationProducerContext n phi) sfLReplacementLevelExtension $ =
 '(ax_mp (ax_mp nsLocal_hyp hg) sfContext_member_head);

theorem slSepProducer_hA(n phi:nat)(hg:$ sfContextWf (sfLSeparationProducerContext n phi) $):
 $ nsLocal (sfLSeparationProducerContext n phi) (sfLReplacementAboveLaw (suc n) phi) $ =
 '(ax_mp (ax_mp nsLocal_hyp hg) (ax_mp sfContext_member_tail sfContext_member_head));

theorem slSepProducer_hL(n phi:nat)(hg:$ sfContextWf (sfLSeparationProducerContext n phi) $):
 $ nsLocal (sfLSeparationProducerContext n phi) sfLReplacementLevelExistsLaw $ =
 '(ax_mp (ax_mp nsLocal_hyp hg) (ax_mp sfContext_member_tail (ax_mp sfContext_member_tail sfContext_member_head)));

theorem slSepProducer_hS(n phi:nat)(hg:$ sfContextWf (sfLSeparationProducerContext n phi) $):
 $ nsLocal (sfLSeparationProducerContext n phi) (sfReflectionHierarchySubsetNormal sfCLHierarchy) $ =
 '(ax_mp (ax_mp nsLocal_hyp hg) (ax_mp sfContext_member_tail (ax_mp sfContext_member_tail (ax_mp sfContext_member_tail sfContext_member_head))));

theorem slSepProducer_hT(n phi:nat)(hg:$ sfContextWf (sfLSeparationProducerContext n phi) $):
 $ nsLocal (sfLSeparationProducerContext n phi) sfLSeparationStageTransNormal $ =
 '(ax_mp (ax_mp nsLocal_hyp hg) (ax_mp sfContext_member_tail (ax_mp sfContext_member_tail (ax_mp sfContext_member_tail (ax_mp sfContext_member_tail sfContext_member_head)))));

theorem slSepProducer_hZ(n phi:nat)(hg:$ sfContextWf (sfLSeparationProducerContext n phi) $):
 $ nsLocal (sfLSeparationProducerContext n phi) (sfCLRecipe 0 0) $ =
 '(ax_mp (ax_mp nsLocal_hyp hg) (ax_mp sfContext_member_tail (ax_mp sfContext_member_tail (ax_mp sfContext_member_tail (ax_mp sfContext_member_tail (ax_mp sfContext_member_tail sfContext_member_head))))));

theorem slSepProducer_schema(n phi:nat)(hb:$ sfBound (suc n) phi $)
 (hg:$ sfContextWf (sfLSeparationProducerContext n phi) $)
 (hp:$ all (sfTheoryProofClass zfrAxioms) (sfLSeparationProducerContext n phi) $)
 (hD:$ nsLocal (sfLSeparationProducerDefinableContext n phi)
   (sfLSeparationImageCandidate (sfLSeparationImageParameterMap 2) sfLDomain phi 0 2) $):
 $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain (zfcSeparationCode phi n)) $ =
 '(ax_mp (ax_mp (sfTheory_lemma_context zfrAxioms_closed) hp) (sfLSeparationImage_schema_kernel hg hb (sfLSeparationImageInput_lift (ax_mp sfShift_closed_identity slSepProducerInitial_bound) (slSepProducer_hZ hg)) (sfLSeparationImageInput_lift (ax_mp sfShift_closed_identity sfLReplacementLevelExtension_bound) (slSepProducer_hE hg)) (sfLSeparationImageInput_lift (ax_mp sfShift_closed_identity (slSepAboveLaw_bound hb)) (slSepProducer_hA hg)) (sfLSeparationImageInput_lift (ax_mp sfShift_closed_identity sfLReplacementLevelExists_bound) (slSepProducer_hL hg)) (sfLSeparationImageInput_lift (rfmc_subnormal_shift sfCLHierarchy_bound) (slSepProducer_hS hg)) (sfLSeparationImageInput_lift (ax_mp sfShift_closed_identity sfLSeparationStageTransNormal_bound) (slSepProducer_hT hg)) hD));

pub theorem sfLSeparationImage_schema_from_source_proofs(n phi:nat)
 (hb:$ sfBound (suc n) phi $)
 (hE:$ sfTheoryProvable zfrAxioms sfLReplacementLevelExtension $)
 (hA:$ sfTheoryProvable zfrAxioms (sfLReplacementAboveLaw (suc n) phi) $)
 (hL:$ sfTheoryProvable zfrAxioms sfLReplacementLevelExistsLaw $)
 (hS:$ sfTheoryProvable zfrAxioms (sfReflectionHierarchySubsetNormal sfCLHierarchy) $)
 (hT:$ sfTheoryProvable zfrAxioms sfLSeparationStageTransNormal $)
 (hZ:$ sfTheoryProvable zfrAxioms (sfCLRecipe 0 0) $)
 (hD:$ nsLocal (sfLSeparationProducerDefinableContext n phi)
   (sfLSeparationImageCandidate (sfLSeparationImageParameterMap 2) sfLDomain phi 0 2) $):
 $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain (zfcSeparationCode phi n)) $ =
 '(slSepProducer_schema hb (slSepProducer_context_wf hE hA hL hS hT hZ) (slSepProducer_context_proved hE hA hL hS hT hZ) hD);

