import "k218_source_core.mm0";
import "extracted_named_rename.mm0";

theorem k218RoleRequest_at (E: set) (x c a i: nat): $ sfComposeMap (sqEnvCons x (sqEnvCons c (sqEnvCons a E))) sfK218RequestMap @ i = (sqEnvCons x (sqEnvCons a E)) @ i $;

theorem k218RoleRequest_environment (E: set) (x c a: nat): $ sfComposeMap (sqEnvCons x (sqEnvCons c (sqEnvCons a E))) sfK218RequestMap == (sqEnvCons x (sqEnvCons a E)) $;

theorem k218RoleRequest_matrix (E: set) (x c a k f: nat) (hf: $ sfWf f $):
 $ sfNamedTemplate (sqEnvCons x (sqEnvCons c (sqEnvCons a E))) k 0 (sfRename sfK218RequestMap 0 f) = sfNamedTemplate (sqEnvCons x (sqEnvCons a E)) k 0 f $;

theorem k218RoleSupport_at (E: set) (v u c a i: nat): $ sfComposeMap (sqEnvCons v (sqEnvCons u (sqEnvCons c (sqEnvCons a E)))) sfK218SupportMap @ i = (sqEnvCons u (sqEnvCons v E)) @ i $;

theorem k218RoleSupport_environment (E: set) (v u c a: nat): $ sfComposeMap (sqEnvCons v (sqEnvCons u (sqEnvCons c (sqEnvCons a E)))) sfK218SupportMap == (sqEnvCons u (sqEnvCons v E)) $;

theorem k218RoleSupport_matrix (E: set) (v u c a k f: nat) (hf: $ sfWf f $):
 $ sfNamedTemplate (sqEnvCons v (sqEnvCons u (sqEnvCons c (sqEnvCons a E)))) k 0 (sfRename sfK218SupportMap 0 f) = sfNamedTemplate (sqEnvCons u (sqEnvCons v E)) k 0 f $;

theorem k218RoleClosureInput_at (E: set) (x p v u c a i: nat): $ sfComposeMap (sqEnvCons x (sqEnvCons p (sqEnvCons v (sqEnvCons u (sqEnvCons c (sqEnvCons a E)))))) sfK218ClosureInputMap @ i = (sqEnvCons x (sqEnvCons p E)) @ i $;

theorem k218RoleClosureInput_environment (E: set) (x p v u c a: nat): $ sfComposeMap (sqEnvCons x (sqEnvCons p (sqEnvCons v (sqEnvCons u (sqEnvCons c (sqEnvCons a E)))))) sfK218ClosureInputMap == (sqEnvCons x (sqEnvCons p E)) $;

theorem k218RoleClosureInput_matrix (E: set) (x p v u c a k f: nat) (hf: $ sfWf f $):
 $ sfNamedTemplate (sqEnvCons x (sqEnvCons p (sqEnvCons v (sqEnvCons u (sqEnvCons c (sqEnvCons a E)))))) k 0 (sfRename sfK218ClosureInputMap 0 f) = sfNamedTemplate (sqEnvCons x (sqEnvCons p E)) k 0 f $;

theorem k218RoleClosureOutput_at (E: set) (y x p v u c a i: nat): $ sfComposeMap (sqEnvCons y (sqEnvCons x (sqEnvCons p (sqEnvCons v (sqEnvCons u (sqEnvCons c (sqEnvCons a E))))))) sfK218ClosureOutputMap @ i = (sqEnvCons y (sqEnvCons p E)) @ i $;

theorem k218RoleClosureOutput_environment (E: set) (y x p v u c a: nat): $ sfComposeMap (sqEnvCons y (sqEnvCons x (sqEnvCons p (sqEnvCons v (sqEnvCons u (sqEnvCons c (sqEnvCons a E))))))) sfK218ClosureOutputMap == (sqEnvCons y (sqEnvCons p E)) $;

theorem k218RoleClosureOutput_matrix (E: set) (y x p v u c a k f: nat) (hf: $ sfWf f $):
 $ sfNamedTemplate (sqEnvCons y (sqEnvCons x (sqEnvCons p (sqEnvCons v (sqEnvCons u (sqEnvCons c (sqEnvCons a E))))))) k 0 (sfRename sfK218ClosureOutputMap 0 f) = sfNamedTemplate (sqEnvCons y (sqEnvCons p E)) k 0 f $;

theorem k218RoleKpRequest_at (E: set) (x p c a i: nat): $ sfComposeMap (sqEnvCons x (sqEnvCons p (sqEnvCons c (sqEnvCons a E)))) sfK218KpRequestMap @ i = (sqEnvCons x (sqEnvCons p E)) @ i $;

theorem k218RoleKpRequest_environment (E: set) (x p c a: nat): $ sfComposeMap (sqEnvCons x (sqEnvCons p (sqEnvCons c (sqEnvCons a E)))) sfK218KpRequestMap == (sqEnvCons x (sqEnvCons p E)) $;

theorem k218RoleKpRequest_matrix (E: set) (x p c a k f: nat) (hf: $ sfWf f $):
 $ sfNamedTemplate (sqEnvCons x (sqEnvCons p (sqEnvCons c (sqEnvCons a E)))) k 0 (sfRename sfK218KpRequestMap 0 f) = sfNamedTemplate (sqEnvCons x (sqEnvCons p E)) k 0 f $;
