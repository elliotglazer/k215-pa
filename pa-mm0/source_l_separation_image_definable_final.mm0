import "source_l_separation_image_producer_final.mm0";
import "source_l_separation_image_definable_law.mm0";

-- Every relativized Separation instance follows in ZFR from the single remaining
-- premise: the generic definability law for its separation predicate.
theorem sfLSeparationImage_schema_from_definable_law(n phi:nat)
 (hb:$ sfBound (suc n) phi $)
 (hD:$ sfTheoryProvable zfrAxioms
   (sfLReplacementDefinableLaw (suc n) (sfPieceSeparationPredicate phi)) $):
 $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain (zfcSeparationCode phi n)) $;
