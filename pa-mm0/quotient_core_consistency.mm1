import "omega_schema_closure.mm1";

@_ abstract def quotientCoreSchemas: wff = $ omegaSeparationImages /\ omegaReplacementImages $;

theorem qciFixed0 (z: nat): $ z = zfcRefl -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 z) $ = '(mpbird (k218IHypProvableeq2d (sqQuoteeq5d id)) (a1i eofImage0));

theorem qciFixed1 (z: nat): $ z = zfcSym -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 z) $ = '(mpbird (k218IHypProvableeq2d (sqQuoteeq5d id)) (a1i eofImage1));

theorem qciFixed2 (z: nat): $ z = zfcTrans -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 z) $ = '(mpbird (k218IHypProvableeq2d (sqQuoteeq5d id)) (a1i eofImage2));

theorem qciFixed3 (z: nat): $ z = zfcEqElem -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 z) $ = '(mpbird (k218IHypProvableeq2d (sqQuoteeq5d id)) (a1i eofImage3));

theorem qciFixed4 (z: nat): $ z = zfcExt -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 z) $ = '(mpbird (k218IHypProvableeq2d (sqQuoteeq5d id)) (a1i eofImage4));

theorem qciFixed5 (z: nat): $ z = zfcEmpty -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 z) $ = '(mpbird (k218IHypProvableeq2d (sqQuoteeq5d id)) (a1i eofImage5));

theorem qciFixed6 (z: nat): $ z = zfcPair -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 z) $ = '(mpbird (k218IHypProvableeq2d (sqQuoteeq5d id)) (a1i eofImage6));

theorem qciFixed7 (z: nat): $ z = zfcUnion -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 z) $ = '(mpbird (k218IHypProvableeq2d (sqQuoteeq5d id)) (a1i eofImage7));

theorem qciFixed8 (z: nat): $ z = zfcPower -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 z) $ = '(mpbird (k218IHypProvableeq2d (sqQuoteeq5d id)) (a1i eofImage8));

theorem qciOmega (z: nat): $ quotientCoreSchemas -> z = zfcOmega -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 z) $ = '(exp (mpbird (k218IHypProvableeq2d (sqQuoteeq5d anr)) (mpd (syl anr anl) (syl omegaSchemas_prove_Infinity (syl anl anl)))));

pub theorem quotientCoreFixed_image (z: nat): $ quotientCoreSchemas -> zfcCoreFixed z -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 z) $ = '(com12 (eori (a1d qciFixed0) (eori (a1d qciFixed1) (eori (a1d qciFixed2) (eori (a1d qciFixed3) (eori (a1d qciFixed4) (eori (a1d qciFixed5) (eori (a1d qciFixed6) (eori (a1d qciFixed7) (eori (a1d qciFixed8) (com12 qciOmega)))))))))));

theorem qciSepCase (z phi n: nat): $ (sfBound (suc n) phi /\ z = zfcSeparationCode phi n) -> quotientCoreSchemas -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 z) $ = '(exp (mpbird (k218IHypProvableeq2d (sqQuoteeq5d anlr)) (mpd anll (syl oscSeparationAt (syl anl anr)))));

pub theorem quotientCoreSep_image {phi n: nat} (z: nat): $ quotientCoreSchemas -> zfcClosedSeparation z -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 z) $ = (named '(com12 (syl (eex (eex qciSepCase)) anr)));

theorem qciRepCase (z phi n: nat): $ (sfBound (suc (suc n)) phi /\ z = zfcReplacementCode phi n) -> quotientCoreSchemas -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 z) $ = '(exp (mpbird (k218IHypProvableeq2d (sqQuoteeq5d anlr)) (mpd anll (syl oscReplacementAt (syl anr anr)))));

pub theorem quotientCoreRep_image {phi n: nat} (z: nat): $ quotientCoreSchemas -> zfcClosedReplacement z -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 z) $ = (named '(com12 (syl (eex (eex qciRepCase)) anr)));

pub theorem quotientCoreAxiom_image (z: nat): $ quotientCoreSchemas -> z e. zfcCoreAxioms -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 z) $ = (named '(com12 (syl (eori (com12 quotientCoreFixed_image) (eori (com12 quotientCoreSep_image) (com12 quotientCoreRep_image))) (bi1 zfcCoreAxioms_value))));

theorem qciImage_member (z: nat): $ quotientCoreSchemas -> z e. zfcCoreAxioms -> z e. k218SQ_sqTheoryImageClass $ = '(exp (syl (bi2 k218SQ_sqTheoryImageClass_value) (mpd anr (syl quotientCoreAxiom_image anl))));

pub theorem quotientCore_images: $ quotientCoreSchemas -> k218SQ_sqTheoryImages zfcCoreAxioms $ = (named '(!! iald z qciImage_member));

pub theorem quotientCore_refutation: $ quotientCoreSchemas -> sfTheoryProvable zfcCoreAxioms sfBot -> k218QProvable kF $ = '(exp (mpd anr (mpd (a1i zfcCoreAxioms_closed) (syl k218SQ_sqTheoryImages_refutation (syl quotientCore_images anl)))));

pub theorem quotientCore_inconsistency: $ quotientCoreSchemas -> sfTheoryProvable zfcCoreAxioms sfBot -> k218Inconsistent $ = (named '(exp (syl (bi1 (k218Provableeq k218Translate_kF)) (mpd anr (syl quotientCore_refutation anl)))));
