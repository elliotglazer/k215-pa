import "k215_calculus_source_ax_stack_loops.mm1";
import "k215_literal_runtime_reach.mm1";
import "k215_calculus_source_pairing.mm1";
import "k215_calculus_source_ax_stack_lookups.mm1";

@_ def k215PairAt1203State (pc a b t c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) b (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) a t (k215PR8 c)) $;

do (apply (register-eqd 'k215PairAt1203State) '(k215PairAt1203Stateeqd));

theorem k215PairAt1203TransferIn (a b t c: nat): $ k215PIter (4 * b + 1) (k215PairAt1203State k215PNum1203 a b t c) = (k215PairAt1203State k215PNum1207 (a + b) 0 (t + b) c) $ =
 '(eqtr k215Loop1203Vector (k215PStateeq2 (k215PVectoreq eqid eqid eqid eqid eqid eqid addcom addcom eqid)));
theorem k215PairAt1203TransferBack (a t c: nat): $ k215PIter (3 * a + 1) (k215PairAt1203State k215PNum1209 a 0 t c) = (k215PairAt1203State k215PNum1212 0 a t c) $ =
 '(eqtr k215Loop1209Vector (k215PStateeq2 (k215PVectoreq2 add0)));
pub theorem k215PairAt1203ReachIn (a b t c: nat): $ k215PReach (k215PairAt1203State k215PNum1203 a b t c) (k215PairAt1203State k215PNum1207 (a + b) 0 (t + b) c) $ =
 '(k215PReach_intro k215PairAt1203TransferIn);
theorem k215PairAt1203ReachBack (a t c: nat): $ k215PReach (k215PairAt1203State k215PNum1209 a 0 t c) (k215PairAt1203State k215PNum1212 0 a t c) $ =
 '(k215PReach_intro k215PairAt1203TransferBack);


theorem k215PairAt1203Step50Z (b t c: nat): $ k215PStep (k215PairAt1203State k215PNum1207 0 b t c) = (k215PairAt1203State k215PNum1213 0 b t c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupPair1203_1207) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215PairAt1203Reach50Z (b t c: nat): $ k215PReach (k215PairAt1203State k215PNum1207 0 b t c) (k215PairAt1203State k215PNum1213 0 b t c) $ = '(k215PReach_step k215PairAt1203Step50Z);

theorem k215PairAt1203Step50S (a b t c: nat): $ k215PStep (k215PairAt1203State k215PNum1207 (suc a) b t c) = (k215PairAt1203State k215PNum1208 a b t c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupPair1203_1207) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215PairAt1203Reach50S (a b t c: nat): $ k215PReach (k215PairAt1203State k215PNum1207 (suc a) b t c) (k215PairAt1203State k215PNum1208 a b t c) $ = '(k215PReach_step k215PairAt1203Step50S);

theorem k215PairAt1203Step51 (a b t c: nat): $ k215PStep (k215PairAt1203State k215PNum1208 a b t c) = (k215PairAt1203State k215PNum1209 a b (suc t) c) $ = '(eqtr (k215PAtCI k215PLookupPair1203_1208) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215PairAt1203Reach51 (a b t c: nat): $ k215PReach (k215PairAt1203State k215PNum1208 a b t c) (k215PairAt1203State k215PNum1209 a b (suc t) c) $ = '(k215PReach_step k215PairAt1203Step51);

theorem k215PairAt1203Step55 (a b t c: nat): $ k215PStep (k215PairAt1203State k215PNum1212 a b t c) = (k215PairAt1203State k215PNum1203 a b t c) $ = '(k215PAtCC k215PLookupPair1203_1212);

theorem k215PairAt1203Reach55 (a b t c: nat): $ k215PReach (k215PairAt1203State k215PNum1212 a b t c) (k215PairAt1203State k215PNum1203 a b t c) $ = '(k215PReach_step k215PairAt1203Step55);

theorem k215PairAt1203Prefix (k t c: nat): $ k215PReach (k215PairAt1203State k215PNum1207 (suc k) 0 t c) (k215PairAt1203State k215PNum1203 0 k (suc t) c) $ = '(ax_mp (ax_mp k215PReach_trans k215PairAt1203Reach50S) (ax_mp (ax_mp k215PReach_trans k215PairAt1203Reach51) (ax_mp (ax_mp k215PReach_trans k215PairAt1203ReachBack) k215PairAt1203Reach55)));
theorem k215PairAt1203ReachSum (a b t k c: nat): $ a + b = suc k -> k215PReach (k215PairAt1203State k215PNum1203 a b t c) (k215PairAt1203State k215PNum1207 (suc k) 0 (t + b) c) $ =
 '(mpbid (k215PReacheq2d (k215PairAt1203Stateeq2d id)) (a1i k215PairAt1203ReachIn));
pub theorem k215PairAt1203Cycle (a b t k c: nat): $ a + b = suc k -> k215PReach (k215PairAt1203State k215PNum1203 a b t c) (k215PairAt1203State k215PNum1203 0 k (suc (t + b)) c) $ =
 '(mpd (a1i k215PairAt1203Prefix) (syl k215PReach_trans k215PairAt1203ReachSum));
theorem k215PairAt1203ReachZeroIn (t c: nat): $ k215PReach (k215PairAt1203State k215PNum1203 0 0 t c) (k215PairAt1203State k215PNum1207 0 0 t c) $ =
 '(mpbi (k215PReacheq2 (k215PairAt1203Stateeq eqid add0 eqid add0 eqid)) k215PairAt1203ReachIn);
pub theorem k215PairAt1203Base (t c: nat): $ k215PReach (k215PairAt1203State k215PNum1203 0 0 t c) (k215PairAt1203State k215PNum1213 0 0 t c) $ =
 '(ax_mp (ax_mp k215PReach_trans k215PairAt1203ReachZeroIn) k215PairAt1203Reach50Z);


@_ abstract def k215PairAt1203Run (a b t c: nat): wff =
 $ k215PReach (k215PairAt1203State k215PNum1203 a b t c) (k215PairAt1203State k215PNum1213 0 0 (t + (a, b)) c) $;
do (apply (register-eqd 'k215PairAt1203Run) '(k215PairAt1203Runeqd));
theorem k215PairAt1203RunZero (t c: nat): $ k215PairAt1203Run 0 0 t c $ =
 '(mpbi (k215PReacheq2 (k215PairAt1203Stateeq4 (eqcom (eqtr (addeq2 pr0) add0)))) k215PairAt1203Base);
theorem k215PairAt1203RunBase (a b t c: nat): $ a + b = 0 -> k215PairAt1203Run a b t c $ =
 '(mpbiri k215PairAt1203RunZero (k215PairAt1203Runeqd
   (syl anl (bi1 addeq0)) (syl anr (bi1 addeq0)) eqidd eqidd));
theorem k215PairAt1203SumStep (a b k: nat): $ a + b = suc k -> (a, b) = b + suc (0, k) $ =
 '(eqtrd (a1i preqadd) (eqtrd (addeq1d (preq1d id))
   (a1i (eqtr (addeq1 k215PairDiagonal_rotate) addcom))));
theorem k215PairAt1203Accumulator (a b t k: nat): $ a + b = suc k -> suc (t + b) + (0, k) = t + (a, b) $ =
 '(eqtrd
   (a1i (eqtr addS1 (eqtr (suceq addass)
     (eqtr (eqcom addS) (addeq2 (eqcom addS))))))
   (addeq2d (eqcomd k215PairAt1203SumStep)));
@_ abstract def k215PairAt1203Claim (k c: nat) (.a .b .t: nat): wff =
 $ A. a A. b A. t (a + b = k -> k215PairAt1203Run a b t c) $;
theorem k215PairAt1203Claim_at (a b t k c: nat): $ k215PairAt1203Claim k c -> a + b = k -> k215PairAt1203Run a b t c $ =
 (named '(!! ealie i @ !! ealde j @ !! ealde l @ bi1d ,eqtac));
theorem k215PairAt1203RunInductive (a b t k c: nat): $ k215PairAt1203Claim k c -> a + b = suc k -> k215PairAt1203Run a b t c $ =
 '(exp @ mpd
   (mpbid
     (k215PReacheq2d (k215PairAt1203Stateeq4d (syl k215PairAt1203Accumulator anr)))
     (mpd (a1i add01) (syl k215PairAt1203Claim_at anl)))
   (syl k215PReach_trans (syl k215PairAt1203Cycle anr)));
theorem k215PairAt1203Claim_all (k c: nat): $ k215PairAt1203Claim k c $ =
 (named @ induct '(ind) 'k
   '(ax_gen (ax_gen (ax_gen k215PairAt1203RunBase)))
   '(iald @ iald @ iald k215PairAt1203RunInductive));
pub theorem k215PairMacro1203 (a b t c: nat): $ k215PReach (k215PairAt1203State k215PNum1203 a b t c) (k215PairAt1203State k215PNum1213 0 0 (t + (a, b)) c) $ =
 '(ax_mp (ax_mp k215PairAt1203Claim_at k215PairAt1203Claim_all) eqid);


