import "pa_source_interpretation_term_safe_graph.mm0";

import "pa_source_interpretation_term_graph_equality.mm0";

theorem paSourceTermGraphEqualityRule_internal (a n: nat): $ sfBound (suc n) a -> zfcProvable (paSourceTermGraphEqualityRule a) $;

theorem paSourceTermGraphEqualityRule_wf (a: nat): $ sfWf a -> zfcProvable (paSourceTermGraphEqualityRule a) $;
