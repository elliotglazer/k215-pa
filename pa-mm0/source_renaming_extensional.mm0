import "source_structural_induction.mm0";

theorem sfRenameIndex_extensional {i: nat} (R S: set) (d j: nat) (h: $ A. i R @ i = S @ i $):
 $ sfRenameIndex R d j = sfRenameIndex S d j $;

def sfRenameExtensionalClass (R S: set) (.c .d: nat): set = $ {c | A. d sfRename R d c = sfRename S d c} $;

theorem sfRename_extensional {i: nat} (R S: set) (d c: nat) (h: $ A. i R @ i = S @ i $):
 $ sfWf c -> sfRename R d c = sfRename S d c $;
