import "source_l_replacement_common_reflected.mm1";
import "source_l_separation_image_seed_exists.mm1";

theorem lrpOrdinal_zero: $ sfCLOrdinalAt 0 = sfLeastOrdinalPredicate $ =
 '(eqtr sfLReplacementOrdinal_reflection sfReflectionOrdinalAt_zero);

pub theorem sfLReplacementAboveLaw_source(count psi:nat):
 $ sfLReplacementAboveLaw count psi =
 sfAll (sfImp sfLeastOrdinalPredicate (sfLSeparationReflectionAbove count psi)) $ =
 '(nsAll_eq (nsImp_eq lrpOrdinal_zero (nsEx_eq (nsAnd_eq lrpOrdinal_zero eqid))));

pub theorem sfLReplacementLevelExistsLaw_source:
 $ sfLReplacementLevelExistsLaw = sfReflectionCondLevelExists sfCLHierarchy $ =
 '(nsAll_eq (nsImp_eq lrpOrdinal_zero (nsEx_eq sfLReplacementHierarchy_binary)));

pub theorem sfLReplacementAboveLaw_from_producers(count psi:nat)
 (hb:$ sfBound count psi $)
 (hP:$ sfReflectionCondProducers sfLUniversalHierarchyRelation (sfTVCanonicalPiece count psi) $)
 (hS:$ sfTheoryProvable zfrAxioms (sfReflectionHierarchySubsetNormal sfLUniversalHierarchyRelation) $)
 (hC:$ sfTheoryProvable zfrAxioms (sfReflectionLimitCoverageLaw sfLUniversalHierarchyRelation) $):
 $ sfTheoryProvable zfrAxioms (sfLReplacementAboveLaw count psi) $ =
 '(mpbir (sfTheoryProvableeq2 sfLReplacementAboveLaw_source)
  (ax_mp (sfTheoryProvable_gen zfrAxioms_closed)
   (sfLSeparationReflectionAbove_from_producers hb hP hS hC)));

pub theorem sfLReplacementLevelExistsLaw_from_producers(count psi:nat)
 (hP:$ sfReflectionCondProducers sfLUniversalHierarchyRelation (sfTVCanonicalPiece count psi) $):
 $ sfTheoryProvable zfrAxioms sfLReplacementLevelExistsLaw $ =
 '(mpbir (sfTheoryProvableeq2 sfLReplacementLevelExistsLaw_source) (anli hP));
