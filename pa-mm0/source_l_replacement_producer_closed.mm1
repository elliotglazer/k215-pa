import "source_l_replacement_producer_hierarchy.mm1";
import "source_l_universal_hierarchy_exists.mm1";
import "source_l_universal_hierarchy_unique.mm1";
import "source_l_universal_hierarchy_limit.mm1";
import "source_l_compact_hierarchy_stage.mm1";
import "source_l_compact_hierarchy_subset.mm1";

pub theorem sfLReplacementExtension_zfr:
 $ sfTheoryProvable zfrAxioms sfLReplacementLevelExtension $ =
 '(sfLReplacementExtension_from_hierarchy sfLUniversalHierarchyExists_zfr sfLPowerHierarchySubset_zfr);

pub theorem sfLReplacementAbove_zfr(count phi:nat)(hb:$ sfBound count phi $):
 $ sfTheoryProvable zfrAxioms (sfLReplacementAboveLaw count phi) $ =
 '(sfLReplacementAbove_from_hierarchy hb sfLUniversalHierarchyExists_zfr sfLUniversalHierarchyUnique_zfr
  sfLPowerHierarchySubset_zfr sfLUniversalHierarchyLimit_reflection_zfr sfLCompactHierarchyStage_reflection_zfr);

pub theorem sfLReplacementLevelExists_zfr:
 $ sfTheoryProvable zfrAxioms sfLReplacementLevelExistsLaw $ =
 '(sfLReplacementLevelExists_from_hierarchy sfLUniversalHierarchyExists_zfr);

pub theorem sfLReplacementSubset_zfr:
 $ sfTheoryProvable zfrAxioms (sfReflectionHierarchySubsetNormal sfCLHierarchy) $ =
 '(sfLReplacementSubset_from_hierarchy sfLPowerHierarchySubset_zfr);

pub theorem sfLReplacementPowerBound_zfr:
 $ sfTheoryProvable zfrAxioms sfLPowerLevelBound $ =
 '(sfLReplacementPowerBound_from_hierarchy sfLUniversalHierarchyExists_zfr sfLPowerHierarchySubset_zfr);

pub theorem sfLReplacementSeed_zfr(n phi:nat)(hb:$ sfBound (suc (suc n)) phi $):
 $ sfTheoryProvable zfrAxioms (sfLReplacementSeedProducerFormula phi) $ =
 '(sfLReplacementSeed_from_hierarchy hb sfLUniversalHierarchyExists_zfr sfLPowerHierarchySubset_zfr);

pub theorem sfLReplacementCommonReflected_zfr(params count phi:nat)(hb:$ sfBound count phi $):
 $ sfTheoryProvable zfrAxioms (sfCLCommonReflectedLaw 0 params count phi) $ =
 '(sfLReplacementCommonReflected_from_hierarchy hb sfLUniversalHierarchyExists_zfr sfLUniversalHierarchyUnique_zfr
  sfLPowerHierarchySubset_zfr sfLUniversalHierarchyLimit_reflection_zfr sfLCompactHierarchyStage_reflection_zfr);

pub theorem sfLReplacement_schema_from_generic_definable(n phi:nat)
 (hb:$ sfBound (suc (suc n)) phi $)
 (hd:$ nsLocal (sfLReplacementProducerDefinableContext n phi)
  (sfLReplacementImageDefinable (sfLReplacementStartMap 7) sfLDomain (sfLReplacementPsi phi) 0) $):
 $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain (zfcReplacementCode phi n)) $ =
 '(sfLReplacement_schema_from_hierarchy hb sfLUniversalHierarchyExists_zfr sfLUniversalHierarchyUnique_zfr
  sfLPowerHierarchySubset_zfr sfLUniversalHierarchyLimit_reflection_zfr sfLCompactHierarchyStage_reflection_zfr hd);
