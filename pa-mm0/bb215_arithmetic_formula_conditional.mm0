import "bb215_arithmetic_formula_halving.mm0";

def bb215ArithmeticFormulaConditional (p a b: wff): wff = $ (p -> a) /\ (p \/ b) $;

theorem bb215ArithmeticFormulaConditional_ifp (p a b: wff): $ bb215ArithmeticFormulaConditional p a b <-> ifp p a b $;

theorem bb215ArithmeticFormulaConditional_numeric (p: wff) (a b v: nat): $ bb215ArithmeticFormulaConditional p (a = v) (b = v) <-> if p a b = v $;

def bb215ArithmeticFormulaDivisionTwoGraph (a q .r: nat): wff = $ E. r bb215ArithmeticFormulaHalvingGraph a q r $;

theorem bb215ArithmeticFormulaDivisionTwoGraph_correct (a q: nat) {r: nat}: $ bb215ArithmeticFormulaDivisionTwoGraph a q <-> a // 2 = q $;
