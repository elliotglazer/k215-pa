import "quotation_binders_absent.mm0";

def sqAllocAvoid (k n x .i: nat): wff =
 $ A. i (i < n -> x != k + i) $;

theorem sqAllocAvoid_at (k n x i: nat):
 $ sqAllocAvoid k n x -> i < n -> x != k + i $;

theorem sqAllocAvoid_zero (k x: nat): $ sqAllocAvoid k 0 x $;

theorem sqAllocAvoid_mono (k m n x: nat) (hm: $ m <= n $):
 $ sqAllocAvoid k n x -> sqAllocAvoid k m x $;

theorem sqAllocAvoid_below (k n x: nat) (hx: $ x < k $):
 $ sqAllocAvoid k n x $;

theorem sqAllocAvoid_above (k n x: nat) (hx: $ k + n <= x $):
 $ sqAllocAvoid k n x $;

theorem sqAllocAvoid_shift (k d n x: nat):
 $ sqAllocAvoid k (d + n) x -> sqAllocAvoid (k + d) n x $;

theorem sqAllocAvoid_subformula (k d a c m x: nat) (ha: $ a <= c $):
 $ sqAllocAvoid k (d + suc (c + m)) x -> sqAllocAvoid k (d + suc (a + m)) x $;

theorem sqAllocAvoid_child (k d a c m x: nat) (ha: $ a < c $):
 $ sqAllocAvoid k (d + suc (c + m)) x -> sqAllocAvoid k (suc d + suc (a + m)) x $;

theorem sqAllocAvoid_head (k d c m x: nat):
 $ sqAllocAvoid k (d + suc (c + m)) x -> x != k + d $;

def ntAllocClass (E: set) (k x: nat) (.c .d: nat): set =
 $ {c | A. d (sqAllocAvoid k (d + suc (c + 0)) x -> kBinderAbsent (sfNamedTemplate E k d c) x)} $;

theorem sfNamedTemplate_allocation_absent (E: set) (k d c x: nat):
 $ sfWf c -> sqAllocAvoid k (d + suc (c + 0)) x ->
 kBinderAbsent (sfNamedTemplate E k d c) x $;

theorem sfNamedTemplate_allocation_absent_zero (E: set) (k c x: nat):
 $ sfWf c -> sqAllocAvoid k (suc c) x -> kBinderAbsent (sfNamedTemplate E k 0 c) x $;

theorem sqEqual_allocation_absent (t a b k x: nat):
 $ sqAllocAvoid k (suc sqEqualSource) x -> kBinderAbsent (sqEqual t a b k) x $;

theorem sqMember_allocation_absent (t a b k x: nat):
 $ sqAllocAvoid k (suc sqMemberSource) x -> kBinderAbsent (sqMember t a b k) x $;

def sqAllocationMargin: nat = $ sqEqualSource + sqMemberSource $;

def qqAllocClass (E: set) (t k x: nat) (.c .d: nat): set =
 $ {c | A. d (sqAllocAvoid k (d + suc (c + sqAllocationMargin)) x -> kBinderAbsent (sqQuote E t k d c) x)} $;

theorem sqQuote_allocation_absent (E: set) (t k d c x: nat):
 $ sfWf c -> sqAllocAvoid k (d + suc (c + sqAllocationMargin)) x ->
 kBinderAbsent (sqQuote E t k d c) x $;

theorem sqQuote_allocation_absent_zero (E: set) (t k c x: nat):
 $ sfWf c -> sqAllocAvoid k (suc (c + sqAllocationMargin)) x ->
 kBinderAbsent (sqQuote E t k 0 c) x $;

theorem sqAllocAvoid_successor (k a c m x: nat) (ha: $ a < c $):
 $ sqAllocAvoid k (suc (c + m)) x -> sqAllocAvoid (suc k) (suc (a + m)) x $;

