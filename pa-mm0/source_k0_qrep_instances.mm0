import "zfc_schema_maps.mm0";

import "k218_source_core_bounds.mm0";

import "k218q_source_k0_open.mm0";

import "source_theory_prefix.mm0";

def sfK0QRepSwapIndex (i: nat): nat = $ if (i = 0) 1 (if (i = 1) 0 i) $;

def sfK0QRepSwapMap (.i: nat): set = $ \ i, sfK0QRepSwapIndex i $;

def sfK0QRepSwap (phi: nat): nat = $ sfRename sfK0QRepSwapMap 0 phi $;

def sfK0QRepCollectionIndex (i: nat): nat = $ if (i = 0) 1 (if (i = 1) 0 (i + 5)) $;

def sfK0QRepCollectionMap (.i: nat): set = $ \ i, sfK0QRepCollectionIndex i $;

def sfK0QRepCollectionMatrix (psi: nat): nat = $ (sfOr (sfAnd (sfEq 1 4) (sfEq 0 2)) (sfOr (sfAnd (sfEq 1 3) (sfEq 0 3)) (sfEx (sfAnd (sfAnd (sfMem 0 2) (sfAll (sfImp (sfMem 0 3) (sfEq 0 1)))) (sfAnd (sfAnd (sfMem 4 0) (sfMem 0 6)) (sfAnd (sfMem 4 1) (sfRename sfK0QRepCollectionMap 0 psi))))))) $;

def sfK0QRepCollectionAxiom (n psi: nat): nat = $ sfAllPrefix (suc (suc (suc (suc n)))) (sfK218Kp0 (sfK0QRepCollectionMatrix psi)) $;

theorem sfK0QRepSwapMap_value (i: nat):
 $ sfK0QRepSwapMap @ i = sfK0QRepSwapIndex i $;

theorem sfK0QRepSwapMap_zero:
 $ sfK0QRepSwapMap @ 0 = 1 $;

theorem sfK0QRepSwapMap_one:
 $ sfK0QRepSwapMap @ 1 = 0 $;

theorem sfK0QRepCollectionMap_value (i: nat):
 $ sfK0QRepCollectionMap @ i = sfK0QRepCollectionIndex i $;

theorem sfK0QRepCollectionMap_zero:
 $ sfK0QRepCollectionMap @ 0 = 1 $;

theorem sfK0QRepCollectionMap_one:
 $ sfK0QRepCollectionMap @ 1 = 0 $;

theorem sfK0QRepSwapMap_bound (n i: nat):
 $ i < (suc (suc n)) -> sfK0QRepSwapMap @ i < (suc (suc n)) $;

theorem sfK0QRepSwap_bound (n phi: nat) (hf: $ sfBound (suc (suc n)) phi $):
 $ sfBound (suc (suc n)) (sfK0QRepSwap phi) $;

theorem sfK0QRepCollectionMap_bound (n i: nat):
 $ i < (suc (suc n)) -> sfK0QRepCollectionMap @ i < (suc (suc (suc (suc (suc (suc (suc n))))))) $;

theorem sfK0QRepCollectionMatrix_bound (n psi: nat) (hf: $ sfBound (suc (suc n)) psi $):
 $ sfBound (suc (suc (suc (suc (suc (suc n)))))) (sfK0QRepCollectionMatrix psi) $;

theorem sfK0QRepCollectionAxiom_closed (n psi: nat) (hf: $ sfBound (suc (suc n)) psi $):
 $ sfBound 0 (sfK0QRepCollectionAxiom n psi) $;

theorem sfK0QRepCollectionAxiom_member (n psi: nat) (hf: $ sfBound (suc (suc n)) psi $):
 $ sfK0QRepCollectionAxiom n psi e. sfK218K0Axioms $;

theorem sfK0QRepCollectionAxiom_proved (n psi: nat) (hf: $ sfBound (suc (suc n)) psi $):
 $ sfTheoryProvable sfK218K0Axioms (sfK0QRepCollectionAxiom n psi) $;

theorem sfK0QRepCollection_open_proved (n psi: nat) (hf: $ sfBound (suc (suc n)) psi $):
 $ sfTheoryProvable sfK218K0Axioms (sfK218Kp0 (sfK0QRepCollectionMatrix psi)) $;

theorem sfK0QRepCollection_open_Q (E: set) (n k psi: nat) (hf: $ sfBound (suc (suc n)) psi $) (hk: $ 0 < k $) (he: $ sqEnvBelow E (suc (suc (suc (suc n)))) k $):
 $ k218QProvable (sfNamedTemplate E k 0 (sfK218Kp0 (sfK0QRepCollectionMatrix psi))) $;
