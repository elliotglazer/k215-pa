@_ def lrepFunctionalF0 (a b c: nat): nat = $ sfImp b (sfEq 1 0) $;

@_ def lrepFunctionalF1 (a b c: nat): nat = $ sfImp a (lrepFunctionalF0 a b c) $;

@_ def lrepFunctionalF2 (a b c: nat): nat = $ sfImp (sfDomainAt sfLDomain 0) (lrepFunctionalF1 a b c) $;

@_ def lrepFunctionalF3 (a b c: nat): nat = $ sfAll (lrepFunctionalF2 a b c) $;

@_ def lrepFunctionalF4 (a b c: nat): nat = $ sfImp (sfDomainAt sfLDomain 0) (lrepFunctionalF3 a b c) $;

@_ def lrepFunctionalF5 (a b c: nat): nat = $ sfAll (lrepFunctionalF4 a b c) $;

@_ def lrepFunctionalF6 (a b c: nat): nat = $ sfImp (sfDomainAt sfLDomain 0) (lrepFunctionalF5 a b c) $;

@_ def lrepFunctionalF7 (a b c: nat): nat = $ sfAll (lrepFunctionalF6 a b c) $;

@_ def lrepFunctionalG8 (a b c: nat): nat = $ (lrepFunctionalF7 a b c) : 0 $;

@_ def lrepFunctionalG9 (a b c: nat): nat = $ sfContextShift (lrepFunctionalG8 a b c) $;

@_ def lrepFunctionalG10 (a b c: nat): nat = $ (sfDomainAt sfLDomain 0) : (lrepFunctionalG9 a b c) $;

@_ def lrepFunctionalG11 (a b c: nat): nat = $ sfContextShift (lrepFunctionalG10 a b c) $;

@_ def lrepFunctionalG12 (a b c: nat): nat = $ sfContextShift (lrepFunctionalG9 a b c) $;

@_ def lrepFunctionalG13 (a b c: nat): nat = $ (sfDomainAt sfLDomain 1) : (lrepFunctionalG12 a b c) $;

@_ def lrepFunctionalG14 (a b c: nat): nat = $ (sfDomainAt sfLDomain 0) : (lrepFunctionalG13 a b c) $;

@_ def lrepFunctionalG15 (a b c: nat): nat = $ sfContextShift (lrepFunctionalG14 a b c) $;

@_ def lrepFunctionalG16 (a b c: nat): nat = $ sfContextShift (lrepFunctionalG12 a b c) $;

@_ def lrepFunctionalG17 (a b c: nat): nat = $ (sfDomainAt sfLDomain 2) : (lrepFunctionalG16 a b c) $;

@_ def lrepFunctionalG18 (a b c: nat): nat = $ (sfDomainAt sfLDomain 1) : (lrepFunctionalG17 a b c) $;

@_ def lrepFunctionalG19 (a b c: nat): nat = $ (sfDomainAt sfLDomain 0) : (lrepFunctionalG18 a b c) $;

@_ def lrepFunctionalF20 (a b c: nat): nat = $ sfAnd (sfDomainAt sfLDomain 2) (sfDomainAt sfLDomain 0) $;

@_ def lrepFunctionalF21 (a b c: nat): nat = $ sfAnd (lrepFunctionalF20 a b c) b $;

@_ def lrepFunctionalF22 (a b c: nat): nat = $ sfAnd (sfDomainAt sfLDomain 2) (sfDomainAt sfLDomain 1) $;

@_ def lrepFunctionalF23 (a b c: nat): nat = $ sfAnd (lrepFunctionalF22 a b c) a $;

@_ def lrepFunctionalG24 (a b c: nat): nat = $ (lrepFunctionalF23 a b c) : (lrepFunctionalG16 a b c) $;

@_ def lrepFunctionalG25 (a b c: nat): nat = $ (lrepFunctionalF21 a b c) : (lrepFunctionalG24 a b c) $;

@_ def lrepFunctionalF26 (a b c: nat): nat = $ sfImp (lrepFunctionalF21 a b c) (sfEq 1 0) $;

@_ def lrepFunctionalF27 (a b c: nat): nat = $ sfImp (lrepFunctionalF23 a b c) (lrepFunctionalF26 a b c) $;

@_ def lrepFunctionalF28 (a b c: nat): nat = $ sfAll (lrepFunctionalF27 a b c) $;

@_ def lrepFunctionalF29 (a b c: nat): nat = $ sfAll (lrepFunctionalF28 a b c) $;

@_ def lrepFunctionalF30 (a b c: nat): nat = $ sfAll (lrepFunctionalF29 a b c) $;

@_ def lrepFunctionalF31 (a b c: nat): nat = $ sfImp (lrepFunctionalF7 a b c) (lrepFunctionalF30 a b c) $;

@_ def sfLReplacementGuardedFunctional (a b c: nat): nat = $ (lrepFunctionalF7 a b c) $;

@_ def sfLReplacementRawFunctional (a b c: nat): nat = $ (lrepFunctionalF30 a b c) $;

theorem lrepFunctionalWf1 (a b c: nat) (ha: $ sfWf a $) (hb: $ sfWf b $) (hc: $ sfWf c $):
 $ sfWf (lrepFunctionalF0 a b c) $ =
'(ax_mp (ax_mp sfWf_imp hb) sfWf_eq);

