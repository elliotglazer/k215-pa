pub theorem sfLReplacement_functionality_local (a b c: nat)
 (ha: $ sfWf a $) (hb: $ sfWf b $) (hc: $ sfWf c $):
 $ nsLocal 0 (sfImp (sfLReplacementGuardedFunctional a b c) (sfLReplacementRawFunctional a b c)) $ = '(lrepFunctionalP46 ha hb hc);
