import "source_k0_collection_singleton.mm0";

import "source_k0_collection_profile.mm0";

import "source_named_equality.mm0";

import "quotation_freshness.mm0";

import "k218q_quantifier_macros.mm0";

theorem sfK0Collection_selected_point (E: set) (n b t r a c p u y x R psi: nat) (hf: $ sfBound (suc (suc n)) psi $)
 (hxR: $ x < R $) (huR: $ u < R $) (hpR: $ p < R $)
 (hx0: $ x != 0 $) (hxu: $ x != u $) (hxp: $ x != p $)
 (hxt: $ x != t $) (hxy: $ x != y $) (hex: $ sqEnvAvoid E n x $)
 (hy0: $ y != 0 $) (hyu: $ y != u $) (hyp: $ y != p $)
 (hyR: $ y != R $) (hyr: $ y != r $) (hyt: $ y != t $):
 $ k218QProvable (kImp (sfK0QSepNamedSingleton u p R) (kImp (kImp (kImp (sfK0QSepNamedSingleton x p R) (kImp (kImp (kImp (kImp (kImp (kMem t x) (kImp (kMem x a) kF)) kF) (kImp (kImp (kImp (kMem t y) (kImp (sfK0CollectionRel E R y x psi) kF)) kF) kF)) kF) kF)) kF) (kImp (kImp (kMem t y) (kImp (sfK0CollectionRel E R y u psi) kF)) kF))) $;

theorem sfK0Collection_selected_witness (E: set) (n b t r a c p u y x R psi: nat) (hf: $ sfBound (suc (suc n)) psi $)
 (hxR: $ x < R $) (huR: $ u < R $) (hpR: $ p < R $)
 (hx0: $ x != 0 $) (hxu: $ x != u $) (hxp: $ x != p $)
 (hxt: $ x != t $) (hxy: $ x != y $) (hex: $ sqEnvAvoid E n x $)
 (hy0: $ y != 0 $) (hyu: $ y != u $) (hyp: $ y != p $)
 (hyR: $ y != R $) (hyr: $ y != r $) (hyt: $ y != t $):
 $ k218QProvable (kImp (sfK0QSepNamedSingleton u p R) (kImp (kImp (kAll x (kImp (kImp (kImp (sfK0QSepNamedSingleton x p R) (kImp (kImp (kImp (kImp (kImp (kMem t x) (kImp (kMem x a) kF)) kF) (kImp (kImp (kImp (kMem t y) (kImp (sfK0CollectionRel E R y x psi) kF)) kF) kF)) kF) kF)) kF) kF)) kF) (kImp (kImp (kMem t y) (kImp (sfK0CollectionRel E R y u psi) kF)) kF))) $;

theorem sfK0Collection_chosen_forward (E: set) (n b t r a c p u y x R psi: nat) (hf: $ sfBound (suc (suc n)) psi $)
 (hxR: $ x < R $) (huR: $ u < R $) (hpR: $ p < R $)
 (hx0: $ x != 0 $) (hxu: $ x != u $) (hxp: $ x != p $)
 (hxt: $ x != t $) (hxy: $ x != y $) (hex: $ sqEnvAvoid E n x $)
 (hy0: $ y != 0 $) (hyu: $ y != u $) (hyp: $ y != p $)
 (hyR: $ y != R $) (hyr: $ y != r $) (hyt: $ y != t $):
 $ k218QProvable (kImp (kImp (kEq p r) kF) (kImp (kImp (kEq p t) kF) (kImp (sfK0QSepNamedSingleton u p R) (kImp (kImp (kAll y (kImp (kImp (kImp (kMem y c) (kImp (kImp (kImp (kImp (kImp (kEq p r) (kImp (kEq y b) kF)) kF) kF) (kImp (kImp (kImp (kImp (kEq p t) (kImp (kEq y t) kF)) kF) kF) (kImp (kAll x (kImp (kImp (kImp (sfK0QSepNamedSingleton x p R) (kImp (kImp (kImp (kImp (kImp (kMem t x) (kImp (kMem x a) kF)) kF) (kImp (kImp (kImp (kMem t y) (kImp (sfK0CollectionRel E R y x psi) kF)) kF) kF)) kF) kF)) kF) kF)) kF))) kF)) kF) kF)) kF) (kImp (kAll y (kImp (kImp (kImp (kMem t y) (kImp (kImp (kImp (kMem y c) (kImp (sfK0CollectionRel E R y u psi) kF)) kF) kF)) kF) kF)) kF))))) $;
