import "source_quotient_syntax.mm0";

import "source_syntax_laws.mm0";

def sfQuotientBoundClass (.c .n .z: nat): set = $ {c | A. n A. z (sfBound n c -> z < n -> sfBound n (sfQuotient z c))} $;

theorem sfQB_value {n z: nat} (c: nat): $ c e. sfQuotientBoundClass <-> A. n A. z (sfBound n c -> z < n -> sfBound n (sfQuotient z c)) $;

theorem sfQB_closed: $ sfConstructionClosed sfQuotientBoundClass $;

theorem sfQuotient_bound (n z c: nat): $ sfBound n c -> z < n -> sfBound n (sfQuotient z c) $;
