theorem k215BinaryTagAllAt398 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum425 (k215PVector u (4 * (fst w, t)) (snd w) c a b 0 0 v)) (k215PState k215PNum425 (k215PVector u (kImp (fst w) t) (snd w) c a b 0 0 v)) $ = 'k215PReach_refl;

pub theorem k215BinaryConstructor398 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum398 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum425 (k215PVector u (kImp (fst w) t) (snd w) c a b 0 0 v)) $ = '(ax_mp (ax_mp k215PReach_trans k215BinaryUnpairAt398) (ax_mp (ax_mp k215PReach_trans k215BinaryRestoreStackAt398) (ax_mp (ax_mp k215PReach_trans k215BinaryPairCleanAt398) (ax_mp (ax_mp k215PReach_trans k215BinaryFourAt398) k215BinaryTagAllAt398))));

