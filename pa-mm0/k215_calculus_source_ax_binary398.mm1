theorem k215BinaryUnpairInAt398 (u t w c a b v: nat): $ (k215UnpairAt398State k215PNum398 0 0 w (k215PVector u t w c a b 0 0 v)) = (k215PState k215PNum398 (k215PVector u t w c a b 0 0 v)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector eqid k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryUnpairOutAt398 (u t w c a b v: nat): $ (k215UnpairAt398State k215PNum406 (fst w) (snd w) 0 (k215PVector u t w c a b 0 0 v)) = (k215PState k215PNum406 (k215PVector u t 0 c a b (fst w) (snd w) v)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector eqid k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryUnpairAt398 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum398 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum406 (k215PVector u t 0 c a b (fst w) (snd w) v)) $ =
 '(mpbi (k215PReacheq k215BinaryUnpairInAt398 k215BinaryUnpairOutAt398) k215UnpairMacro398_clean);

theorem k215BinaryRestoreStackAt398 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum406 (k215PVector u t 0 c a b (fst w) (snd w) v)) (k215PState k215PNum409 (k215PVector u t (snd w) c a b (fst w) 0 v)) $ =
 '(k215PReach_intro (eqtr k215Loop406Vector (k215PStateeq2 (k215PVectoreq3 add0))));

theorem k215BinaryPairInAt398 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt409State k215PNum409 a6 a1 a7 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum409 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryPairOutAt398 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt409State k215PNum419 0 0 (a7 + (a6, a1)) (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum419 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryPairAt398 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat):
 $ k215PReach (k215PState k215PNum409 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215PNum419 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ =
 '(mpbi (k215PReacheq k215BinaryPairInAt398 k215BinaryPairOutAt398) k215PairMacro409);

theorem k215BinaryPairCleanAt398 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum409 (k215PVector u t (snd w) c a b (fst w) 0 v)) (k215PState k215PNum419 (k215PVector u 0 (snd w) c a b 0 (fst w, t) v)) $ =
 '(mpbi (k215PReacheq2 (k215PStateeq2 (k215PVectoreq8 add01))) k215BinaryPairAt398);
theorem k215BinaryFourAt398 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum419 (k215PVector u 0 (snd w) c a b 0 (fst w, t) v)) (k215PState k215PNum425 (k215PVector u (4 * (fst w, t)) (snd w) c a b 0 0 v)) $ =
