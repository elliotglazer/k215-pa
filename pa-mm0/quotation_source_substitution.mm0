import "quotation_binders.mm0";
import "source_substitution.mm0";

-- Literal equalities for source de Bruijn operations at a fixed fresh base.
theorem sfNamedIndex_source_shift (E: set) (z k d j: nat):
 $ sfNamedIndex (sqEnvCons z E) k d (sfShiftIndex d j) = sfNamedIndex E k d j $;
theorem sfNamedIndex_source_subst (E: set) (i k d j: nat):
 $ sfNamedIndex E k d (sfSubstIndex d i j) =
   sfNamedIndex (sqEnvCons (E @ i) E) k d j $;

-- BEGIN GENERATED SOURCE OPERATIONS

def ntSourceShiftClass (E: set) (k z .c .d: nat): set =
$ {c | A. d (sfNamedTemplate (sqEnvCons z E) k d (sfShift d c) = sfNamedTemplate E k d (c))} $;

theorem ntSourceShift_value {d: nat} (E: set) (k z: nat) (c: nat):
 $ c e. ntSourceShiftClass E k z <-> A. d (sfNamedTemplate (sqEnvCons z E) k d (sfShift d c) = sfNamedTemplate E k d (c)) $;

theorem sfNamedTemplate_source_shift (E: set) (k z d c: nat):
 $ sfWf c -> sfNamedTemplate (sqEnvCons z E) k d (sfShift d c) = sfNamedTemplate E k d (c) $;

def ntSourceSubstClass (E: set) (k i .c .d: nat): set =
$ {c | A. d (sfNamedTemplate E k d (sfSubst d i c) = sfNamedTemplate (sqEnvCons (E @ i) E) k d (c))} $;

theorem ntSourceSubst_value {d: nat} (E: set) (k i: nat) (c: nat):
 $ c e. ntSourceSubstClass E k i <-> A. d (sfNamedTemplate E k d (sfSubst d i c) = sfNamedTemplate (sqEnvCons (E @ i) E) k d (c)) $;

theorem sfNamedTemplate_source_substitution (E: set) (k i d c: nat):
 $ sfWf c -> sfNamedTemplate E k d (sfSubst d i c) = sfNamedTemplate (sqEnvCons (E @ i) E) k d (c) $;

def qqSourceShiftClass (E: set) (t k z .c .d: nat): set =
$ {c | A. d (sqQuote (sqEnvCons z E) t k d (sfShift d c) = sqQuote E t k d (c))} $;

theorem qqSourceShift_value {d: nat} (E: set) (t k z: nat) (c: nat):
 $ c e. qqSourceShiftClass E t k z <-> A. d (sqQuote (sqEnvCons z E) t k d (sfShift d c) = sqQuote E t k d (c)) $;

theorem sqQuote_source_shift (E: set) (t k z d c: nat):
 $ sfWf c -> sqQuote (sqEnvCons z E) t k d (sfShift d c) = sqQuote E t k d (c) $;

def qqSourceSubstClass (E: set) (t k i .c .d: nat): set =
$ {c | A. d (sqQuote E t k d (sfSubst d i c) = sqQuote (sqEnvCons (E @ i) E) t k d (c))} $;

theorem qqSourceSubst_value {d: nat} (E: set) (t k i: nat) (c: nat):
 $ c e. qqSourceSubstClass E t k i <-> A. d (sqQuote E t k d (sfSubst d i c) = sqQuote (sqEnvCons (E @ i) E) t k d (c)) $;

theorem sqQuote_source_substitution (E: set) (t k i d c: nat):
 $ sfWf c -> sqQuote E t k d (sfSubst d i c) = sqQuote (sqEnvCons (E @ i) E) t k d (c) $;
