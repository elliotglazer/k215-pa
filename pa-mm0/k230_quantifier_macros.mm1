pub theorem kExists_elimination (x p q: nat)
  (hv: $ kProvable (kImp q (kAll x q)) $):
  $ kProvable (kImp (kAll x (kImp p q)) (kImp (kExists x p) q)) $ =
'(kProvable_syl kAll_exists
  (kProvable_mp (kExists_collapse hv)
    (kProvable_mp kPropB kCd103)));
