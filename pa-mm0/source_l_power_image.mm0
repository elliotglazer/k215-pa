import "source_l_power_def_literal.mm0";

import "source_l_power_shell.mm0";

import "source_l_replacement_producer_closed.mm0";

import "source_l_pair_next.mm0";

-- The natively extracted Power definability premise is the literal power instance.
theorem sfLDefPower_literal: $ sfLDefPower = sfLDefPowerLiteral $;

theorem sfLDefPower_from_definability
 (hU:$ sfTheoryProvable zfrAxioms (sfLDefinabilityLaw 1 sfLPowerSubsetFormula) $):
 $ sfTheoryProvable zfrAxioms sfLDefPower $;

-- Power Set holds in L, given Common2 and the power instance of the Definability Lemma.
theorem sfLPower_image_from_definability
 (hC:$ sfTheoryProvable zfrAxioms sfLPairCommon2 $)
 (hU:$ sfTheoryProvable zfrAxioms (sfLDefinabilityLaw 1 sfLPowerSubsetFormula) $):
 $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcPower) $;
