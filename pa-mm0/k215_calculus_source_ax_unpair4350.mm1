theorem k215UnpairAt4350AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt4350State k215PNum4350 0 b (suc n) c) (k215UnpairAt4350State k215PNum4350 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
