@_ abstract def k215UnpairAt4350Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt4350State k215PNum4350 a b n c) (k215UnpairAt4350State k215PNum4358 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
