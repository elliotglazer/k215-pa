def sfK0CollectionRequest (E: set) (root b t r a c u y x R psi: nat): nat = $ (kImp (kDisj (kEq u root) (kExists y (kAnd (kMem y c) (kAll x (kImp (kMem x u) (kMem x y)))))) (kImp (kExists y (kDisj (kAnd (kEq u r) (kEq y b)) (kDisj (kAnd (kEq u t) (kEq y t)) (kExists x (kAnd (kAnd (kMem x u) (kAll R (kImp (kMem R u) (kEq R x)))) (kAnd (kAnd (kMem t x) (kMem x a)) (kAnd (kMem t y) (sfK0CollectionRel E R y x psi)))))))) (kExists y (kAnd (kMem y c) (kDisj (kAnd (kEq u r) (kEq y b)) (kDisj (kAnd (kEq u t) (kEq y t)) (kExists x (kAnd (kAnd (kMem x u) (kAll R (kImp (kMem R u) (kEq R x)))) (kAnd (kAnd (kMem t x) (kMem x a)) (kAnd (kMem t y) (sfK0CollectionRel E R y x psi))))))))))) $;

def sfK0CollectionSupport (E: set) (b t r a c u y x R psi: nat): nat = $ (kAll y (kImp (kMem y c) (kExists u (kDisj (kAnd (kEq u r) (kEq y b)) (kDisj (kAnd (kEq u t) (kEq y t)) (kExists x (kAnd (kAnd (kMem x u) (kAll R (kImp (kMem R u) (kEq R x)))) (kAnd (kAnd (kMem t x) (kMem x a)) (kAnd (kMem t y) (sfK0CollectionRel E R y x psi)))))))))) $;

def sfK0CollectionEligibleBody (c u y x: nat): nat = $ (kAnd (kMem y c) (kAll x (kImp (kMem x u) (kMem x y)))) $;

theorem sfK0Collection_tag_input_substitution (E: set) (n root b t r a c u y x R z psi: nat)
 (hf: $ sfBound (suc (suc n)) psi $) (h0: $ u != 0 $)
 (hR: $ u < R $) (hzR: $ z < R $)
 (hx: $ u < x $) (hzx: $ z < x $)
 (hroot: $ root != u $) (hb: $ b != u $)
 (ht: $ t != u $) (hr: $ r != u $)
 (ha: $ a != u $) (hc: $ c != u $)
 (hother: $ y != u $) (he: $ sqEnvAvoid E n u $):
 $ kSubst (sfK0CollectionTagged E b t r a u y x R psi) u z = sfK0CollectionTagged E b t r a z y x R psi $;

theorem sfK0Collection_tag_input_specialization (E: set) (n root b t r a c u y x R z psi: nat)
 (hf: $ sfBound (suc (suc n)) psi $) (h0: $ u != 0 $)
 (hR: $ u < R $) (hzR: $ z < R $)
 (hx: $ u < x $) (hzx: $ z < x $)
 (hroot: $ root != u $) (hb: $ b != u $)
 (ht: $ t != u $) (hr: $ r != u $)
 (ha: $ a != u $) (hc: $ c != u $)
 (hother: $ y != u $) (he: $ sqEnvAvoid E n u $) (hz: $ u != z $):
 $ k218QProvable (kImp (kAll u (sfK0CollectionTagged E b t r a u y x R psi)) (sfK0CollectionTagged E b t r a z y x R psi)) $;

