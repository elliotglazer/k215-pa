 (hf: $ sfBound (suc (suc n)) psi $) (h0: $ u != 0 $)
 (hR: $ u < R $) (hzR: $ z < R $)
 (hx: $ u < x $) (hzx: $ z < x $)
 (hroot: $ root != u $) (hb: $ b != u $)
 (ht: $ t != u $) (hr: $ r != u $)
 (ha: $ a != u $) (hc: $ c != u $)
 (hother: $ y != u $) (he: $ sqEnvAvoid E n u $) (hz: $ u != z $):
 $ k218QProvable (kImp (sfK0CollectionTagged E b t r a z y x R psi) (kExists u (sfK0CollectionTagged E b t r a u y x R psi))) $;

