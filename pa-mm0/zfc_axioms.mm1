theorem zfcFoundation_closed_local: $ sfBound 0 zfcFoundation $ =
'(mpbir sfBound_sfAll (mpbir sfBound_sfImp (ian (mpbir sfBound_sfEx (mpbir sfBound_sfMem (ian lt01S (mpbi ltsuc lt01S)))) (mpbir sfBound_sfEx (mpbir sfBound_sfAnd (ian (mpbir sfBound_sfMem (ian lt01S (mpbi ltsuc lt01S))) (mpbir sfBound_sfAll (mpbir sfBound_sfImp (ian (mpbir sfBound_sfMem (ian lt01S (mpbi ltsuc lt01S))) (mpbir sfBound_sfImp (ian (mpbir sfBound_sfMem (ian lt01S (mpbi ltsuc (mpbi ltsuc lt01S)))) sfBound_bot)))))))))));

