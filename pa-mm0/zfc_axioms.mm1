pub theorem zfcFixed_closed (z: nat): $ zfcFixed z -> sfBound 0 z $ =
'(eori (mpbiri zfcRefl_closed_local (zfcBound_congr (a1i eqid) id)) (eori (mpbiri zfcSym_closed_local (zfcBound_congr (a1i eqid) id)) (eori (mpbiri zfcTrans_closed_local (zfcBound_congr (a1i eqid) id)) (eori (mpbiri zfcEqElem_closed_local (zfcBound_congr (a1i eqid) id)) (eori (mpbiri zfcExt_closed_local (zfcBound_congr (a1i eqid) id)) (eori (mpbiri zfcEmpty_closed_local (zfcBound_congr (a1i eqid) id)) (eori (mpbiri zfcPair_closed_local (zfcBound_congr (a1i eqid) id)) (eori (mpbiri zfcUnion_closed_local (zfcBound_congr (a1i eqid) id)) (eori (mpbiri zfcPower_closed_local (zfcBound_congr (a1i eqid) id)) (eori (mpbiri zfcOmega_closed_local (zfcBound_congr (a1i eqid) id)) (eori (mpbiri zfcFoundation_closed_local (zfcBound_congr (a1i eqid) id)) (mpbiri zfcChoice_closed_local (zfcBound_congr (a1i eqid) id)))))))))))));

pub theorem zfcAxioms_closed (z: nat): $ z e. zfcAxioms -> sfBound 0 z $ =
'(syl (eori zfcFixed_closed
    (eori zfcClosedSeparation_closed zfcClosedReplacement_closed))
  (bi1 zfcAxioms_value));
