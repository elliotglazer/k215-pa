pub theorem bb215ArithmeticFormulaTailGraph_correct (l t: nat): $ bb215ArithmeticFormulaTailGraph l t <-> bb215ArithmeticFormulaListTail l = t $ = (named '(bitr (!! exeqi p (aneq bb215ArithmeticFormulaPredecessorGraph_correct bb215ArithmeticFormulaSndGraph_correct)) (bitr (!! exeqi p (aneq1i eqcomb)) (!! exeqe p (eqeq1d (sndeqd id))))));

