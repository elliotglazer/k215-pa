import "source_k0_qsep_normalize_general.mm0";

theorem sfK0QSepExists_factor_forward (z A P: nat) (hp: $ k218QProvable (kImp P (kAll z P)) $):
 $ k218QProvable (kImp (kExists z (kImp (kImp A (kImp P kF)) kF)) (kImp (kImp (kExists z A) (kImp P kF)) kF)) $;

theorem sfK0QSepExists_factor_backward (z A P: nat) (hp: $ k218QProvable (kImp P (kAll z P)) $):
 $ k218QProvable (kImp (kImp (kImp (kExists z A) (kImp P kF)) kF) (kExists z (kImp (kImp A (kImp P kF)) kF))) $;
