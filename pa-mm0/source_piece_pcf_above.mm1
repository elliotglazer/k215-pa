import "source_piece_pcf_d0_instance.mm1";
import "source_piece_pcf_above_kernel.mm1";

pub theorem sfPieceLevelAbove_from_exists_subset
 (he:$ sfTheoryProvable zfrAxioms sfPieceLevelEx $)
 (hs:$ sfTheoryProvable zfrAxioms sfPieceLevelSub $):
 $ sfTheoryProvable zfrAxioms sfPieceLevelAbove $ =
'(sfPieceAbove_from_exists_subset he hs);

pub theorem sfPieceDnD0_from_exists_subset(count phi:nat)(hf:$ sfWf phi $)
 (he:$ sfTheoryProvable zfrAxioms sfPieceLevelEx $)
 (hs:$ sfTheoryProvable zfrAxioms sfPieceLevelSub $):
 $ sfTheoryProvable zfrAxioms (sfPieceDnExistenceCode count (sfPieceD0Canonical phi)) $ =
'(sfPieceDnD0_from_fixed_source hf he hs (sfPieceLevelAbove_from_exists_subset he hs));
