import "k218q_base.mm0";

theorem k218Translate_kSubset (a b k: nat):
  $ k218Translate (kSubset a b k) = kSubset a b k $;

theorem k218Translate_k218Vrel (a b c: nat):
  $ k218Translate (k218Vrel a b c) = k218Vrel a b c $;

theorem k218Translate_k218SeedRequest (b k q: nat):
  $ k218Translate (k218SeedRequest b k q) = k218SeedRequest b k (k218Translate q) $;

theorem k218Translate_k218SeedClosure (a b k q: nat):
  $ k218Translate (k218SeedClosure a b k q) = k218SeedClosure a b k (k218Translate q) $;

theorem k218Translate_k218SeedN (a b c q: nat):
  $ k218Translate (k218SeedN a b c q) = k218SeedN a b c (k218Translate q) $;

theorem k218Translate_kRequest (b k q: nat):
  $ k218Translate (kRequest b k q) = kRequest b k (k218Translate q) $;

theorem k218Translate_k218Closure (a b k q: nat):
  $ k218Translate (k218Closure a b k q) = k218Closure a b k (k218Translate q) $;

theorem k218Translate_k218SeedY (a b c q: nat):
  $ k218Translate (k218SeedY a b c q) = k218SeedY a b c (k218Translate q) $;

theorem k218Translate_kCore (a b k q: nat):
  $ k218Translate (kCore a b k q) = kCore a b k (k218Translate q) $;
