import "k215_calculus_source_ax.mm0";
import "k215_calculus_source_mp.mm0";
import "k215_calculus_source_cycle_iteration.mm0";

theorem k215PCommandAll (s ac fields next: nat):
 $ k215PCommandResult (k215PCommandInput s ac fields next)
     (k215EnumCommand s ac fields next) $;

theorem k215PEnumCycle (s: nat):
 $ k215PProgressResult (k215PEnumConfig s) (k215EnumStep s) $;

theorem k215PEnumCycle_halt (s: nat):
 $ k215EnumStep s = 0 -> k215PHaltsFrom (k215PEnumConfig s) $;

theorem k215PEnumCycle_some (s t: nat):
 $ k215EnumStep s = suc t -> k215PProgress (k215PEnumConfig s) (k215PEnumConfig t) $;

theorem k215PEnumCycle_option_halts (s: nat):
 $ k215POptionHalts (k215EnumStep s) -> k215PHaltsFrom (k215PEnumConfig s) $;

theorem k215PActualCycleLaw: $ k215PCycleLaw $;

theorem k215PSource_enum_halting (s: nat):
 $ k215PHaltsFrom (k215PEnumConfig s) <-> k215EnumHaltsFrom s $;

theorem k215PInitialHalts_iff_EnumHalts:
 $ k215PInitialHalts <-> k215EnumHalts $;
