import "pa_proof_numeral_addition_successor.mm0";

theorem paProofNumeralAxiom_length (n c w: nat): $ len (paProofNumeralAxiomProof n c w) = 1 $;

theorem paProofNumeralAllElim_length (n phi t h p: nat): $ len (paProofNumeralAllElimProof n phi t h p) = suc (suc (len p)) $;

theorem paProofNumeralReflexivity_length (n: nat): $ len (paProofNumeralReflexivityProof n) = 1 $;

theorem paProofNumeralAdditionZero_length (n: nat): $ len (paProofNumeralAdditionZeroProof n) = 3 $;

theorem paProofNumeralAdditionSuccessorFirst_length (n: nat): $ len (paProofNumeralAdditionSuccessorFirstProof n) = 3 $;

theorem paProofNumeralAdditionSuccessor_length (n m: nat): $ len (paProofNumeralAdditionSuccessorProof n m) = 5 $;
