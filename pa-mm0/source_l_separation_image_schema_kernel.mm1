import "source_l_separation_image_reflected_witness.mm1";

pub theorem sfLSeparationImage_schema_kernel(G n phi:nat)
 (hg:$ sfContextWf G $)(hb:$ sfBound (suc n) phi $)
 (h0:$ nsLocal (sfLSeparationImageInputContext G n) (sfCLRecipe 0 0) $)
 (he:$ nsLocal (sfLSeparationImageInputContext G n) sfLReplacementLevelExtension $)
 (ha:$ nsLocal (sfLSeparationImageInputContext G n) (sfLReplacementAboveLaw (suc n) phi) $)
 (hl:$ nsLocal (sfLSeparationImageInputContext G n) sfLReplacementLevelExistsLaw $)
 (hs:$ nsLocal (sfLSeparationImageInputContext G n) (sfReflectionHierarchySubsetNormal sfCLHierarchy) $)
 (ht:$ nsLocal (sfLSeparationImageInputContext G n) sfLSeparationStageTransNormal $)
 (hd:$ nsLocal (sfLSeparationReflectedContext (sfLSeparationImageInputContext G n) n phi)
    (sfLSeparationImageCandidate (sfLSeparationImageParameterMap 2) sfLDomain phi 0 2) $):
 $ nsLocal G (sfRelativize sfLDomain (zfcSeparationCode phi n)) $ =
 '(sfLSeparationImage_schema_from_witness sfLDomain_bound hb hg
  (sfLSeparationImage_witness_from_recipe hb ht
   (sfLSeparationReflectedRecipe_from_collected hb ha hl hs
    (sfLSeparationImage_collect_from_initial he h0
     (sfLSeparationImageAllInputPredicates sfLDomain_bound hg))) hd));
