theorem k215Const3521Stage4 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum3540 (k215PVector u 0 (t, w) c a b 0 0 v)) (k215PState k215PNum3541 (k215PVector u 1 (t, w) c a b 0 0 v)) $ = '(k215PReach_step (eqtr (k215PAtCI k215PLookupConst3521_3540) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet1_vector)) k215PSet1_vector))));

pub theorem k215PushConstant3521 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum3521 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum3541 (k215PVector u 1 (t, w) c a b 0 0 v)) $ = '(ax_mp (ax_mp k215PReach_trans k215Const3521Stage0) (ax_mp (ax_mp k215PReach_trans k215Const3521Stage1) (ax_mp (ax_mp k215PReach_trans k215Const3521Stage2) (ax_mp (ax_mp k215PReach_trans k215Const3521Stage3) k215Const3521Stage4))));

