import "k218_translation_range.mm0";

theorem k218Translate_kNot (a: nat):
  $ k218Translate (kNot a) = kNot (k218Translate a) $;
theorem k218Translate_kAnd (a b: nat):
  $ k218Translate (kAnd a b) = kAnd (k218Translate a) (k218Translate b) $;
theorem k218Translate_kExists (x a: nat):
  $ k218Translate (kExists x a) = kExists x (k218Translate a) $;

theorem k218Translate_rho1 (a b: nat):
  $ k218Translate (kRho1 a b) = kExists a (k218EqInd a b) $;
theorem k218Translate_rho2 (a b c: nat):
  $ k218Translate (kRho2 a b c) = kRho2 a (k218Translate b) (k218Translate c) $;
theorem k218Translate_rho3 (a b c: nat):
  $ k218Translate (kRho3 a b c) = kImp (k218EqInd a b) (kImp (kMem c a) (kMem c b)) $;
theorem k218Translate_rho4 (a b c: nat):
  $ k218Translate (kRho4 a b c) = kRho4 a b (k218Translate c) $;
theorem k218Translate_rho5 (a b c: nat):
  $ k218Translate (kRho5 a b c) = kImp (k218EqInd c a) (kImp (kMem c b) (kMem a b)) $;
theorem k218Translate_rho6 (a b: nat):
  $ k218Translate (kRho6 a b) = kRho6 a (k218Translate b) $;
theorem k218Translate_rho7 (a b c: nat):
  $ k218Translate (kRho7 a b c) = kImp (k218EqInd c a) (kImp (k218EqInd c b) (k218EqInd a b)) $;
theorem k218Translate_rho8 (a b c u: nat):
  $ k218Translate (kRho8 a b c u) =
    kRho8 (k218Translate a) (k218Translate b) (k218Translate c) (k218Translate u) $;

theorem k218Translated_rho1 (a b: nat): $ k218Provable (k218Translate (kRho1 a b)) $;
theorem k218Translated_rho2 (a b c: nat): $ k218Provable (k218Translate (kRho2 a b c)) $;
theorem k218Translated_rho3 (a b c: nat): $ k218Provable (k218Translate (kRho3 a b c)) $;
theorem k218Translated_rho4 (a b c: nat): $ k218Provable (k218Translate (kRho4 a b c)) $;
theorem k218Translated_rho5 (a b c: nat): $ k218Provable (k218Translate (kRho5 a b c)) $;
theorem k218Translated_rho6 (a b: nat): $ k218Provable (k218Translate (kRho6 a b)) $;
theorem k218Translated_rho7 (a b c: nat): $ k218Provable (k218Translate (kRho7 a b c)) $;
theorem k218Translated_rho8 (a b c u: nat): $ k218Provable (k218Translate (kRho8 a b c u)) $;

theorem k218Translated_mp (a b: nat):
  $ k218Provable (k218Translate a) -> k218Provable (k218Translate (kImp a b)) ->
    k218Provable (k218Translate b) $;
theorem k218Translated_gen (x a: nat):
  $ k218Provable (k218Translate a) -> k218Provable (k218Translate (kAll x a)) $;
