theorem sfK0QRepFunctional_rebase_d (G: wff) (E: set) (n t a u v w M N R S phi: nat) (hf: $ G -> sfBound (suc (suc n)) phi $) (hM: $ G -> 0 < M $) (hN: $ G -> 0 < N $) (hR: $ G -> 0 < R $) (hS: $ G -> 0 < S $) (htM: $ G -> t < M $) (htN: $ G -> t < N $) (htR: $ G -> t < R $) (htS: $ G -> t < S $) (huM: $ G -> u < M $) (huN: $ G -> u < N $) (huR: $ G -> u < R $) (huS: $ G -> u < S $) (hvM: $ G -> v < M $) (hvN: $ G -> v < N $) (hvR: $ G -> v < R $) (hvS: $ G -> v < S $) (hwM: $ G -> w < M $) (hwN: $ G -> w < N $) (hwR: $ G -> w < R $) (hwS: $ G -> w < S $) (haM: $ G -> a < M $) (haN: $ G -> a < N $) (heR: $ G -> sqEnvBelow E n R $) (heS: $ G -> sqEnvBelow E n S $):
 $ G -> k218IEquivalent (sfK0QRepFunctional E t a u v w M R phi) (sfK0QRepFunctional E t a u v w N S phi) $;

theorem sfK0QRepFunctional_rebase (E: set) (n t a u v w M N R S phi: nat) (hf: $ sfBound (suc (suc n)) phi $) (hM: $ 0 < M $) (hN: $ 0 < N $) (hR: $ 0 < R $) (hS: $ 0 < S $) (htM: $ t < M $) (htN: $ t < N $) (htR: $ t < R $) (htS: $ t < S $) (huM: $ u < M $) (huN: $ u < N $) (huR: $ u < R $) (huS: $ u < S $) (hvM: $ v < M $) (hvN: $ v < N $) (hvR: $ v < R $) (hvS: $ v < S $) (hwM: $ w < M $) (hwN: $ w < N $) (hwR: $ w < R $) (hwS: $ w < S $) (haM: $ a < M $) (haN: $ a < N $) (heR: $ sqEnvBelow E n R $) (heS: $ sqEnvBelow E n S $):
 $ k218IEquivalent (sfK0QRepFunctional E t a u v w M R phi) (sfK0QRepFunctional E t a u v w N S phi) $;
