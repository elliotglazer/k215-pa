import "zfc_proof_arithmetic_quantifier_history_witness.mm0";

def zfcProofArithmeticQuantifierShiftGood (A K: nat) (.c .d: nat): set = $ {c | A. d ((d, c) <= K -> bb215ArithmeticFormulaHistoryCell A ((d, c)) (sfShift (d) (c)))} $;

theorem zfcProofArithmeticQuantifierShiftGood_value (A K: nat) (c: nat) {d: nat}: $ c e. zfcProofArithmeticQuantifierShiftGood A K <-> A. d ((d, c) <= K -> bb215ArithmeticFormulaHistoryCell A ((d, c)) (sfShift (d) (c))) $;

theorem zfcProofArithmeticQuantifierShiftGood_at (A K: nat) (d c: nat): $ c e. zfcProofArithmeticQuantifierShiftGood A K -> (d, c) <= K -> bb215ArithmeticFormulaHistoryCell A ((d, c)) (sfShift (d) (c)) $;

theorem zfcProofArithmeticQuantifierShiftLocal_closed (A K: nat): $ zfcProofArithmeticQuantifierShiftLocal A K -> zfcProofArithmeticQuantifierTotalClosed (zfcProofArithmeticQuantifierShiftGood A K) $;

theorem zfcProofArithmeticQuantifierShiftLocal_runs (A K: nat) (d c: nat): $ zfcProofArithmeticQuantifierShiftLocal A K -> (d, c) <= K -> bb215ArithmeticFormulaHistoryCell A ((d, c)) (sfShift (d) (c)) $;

theorem zfcProofArithmeticQuantifierShiftCertificate_sound (A d c v: nat): $ zfcProofArithmeticQuantifierShiftCertificate A d c v -> sfShift (d) (c) = v $;

theorem zfcProofArithmeticQuantifierShiftGraph_sound (d c v: nat): $ zfcProofArithmeticQuantifierShiftGraph d c v -> sfShift (d) (c) = v $;

theorem zfcProofArithmeticQuantifierShiftGraph_correct (d c v: nat): $ zfcProofArithmeticQuantifierShiftGraph d c v <-> sfShift (d) (c) = v $;

def zfcProofArithmeticQuantifierSubstGood (t A K: nat) (.c .d: nat): set = $ {c | A. d ((d, c) <= K -> bb215ArithmeticFormulaHistoryCell A ((d, c)) (sfSubst (d) t (c)))} $;

theorem zfcProofArithmeticQuantifierSubstGood_value (t A K: nat) (c: nat) {d: nat}: $ c e. zfcProofArithmeticQuantifierSubstGood t A K <-> A. d ((d, c) <= K -> bb215ArithmeticFormulaHistoryCell A ((d, c)) (sfSubst (d) t (c))) $;

theorem zfcProofArithmeticQuantifierSubstGood_at (t A K: nat) (d c: nat): $ c e. zfcProofArithmeticQuantifierSubstGood t A K -> (d, c) <= K -> bb215ArithmeticFormulaHistoryCell A ((d, c)) (sfSubst (d) t (c)) $;

theorem zfcProofArithmeticQuantifierSubstLocal_closed (t A K: nat): $ zfcProofArithmeticQuantifierSubstLocal t A K -> zfcProofArithmeticQuantifierTotalClosed (zfcProofArithmeticQuantifierSubstGood t A K) $;

theorem zfcProofArithmeticQuantifierSubstLocal_runs (t A K: nat) (d c: nat): $ zfcProofArithmeticQuantifierSubstLocal t A K -> (d, c) <= K -> bb215ArithmeticFormulaHistoryCell A ((d, c)) (sfSubst (d) t (c)) $;

theorem zfcProofArithmeticQuantifierSubstCertificate_sound (t A d c v: nat): $ zfcProofArithmeticQuantifierSubstCertificate t A d c v -> sfSubst (d) t (c) = v $;

theorem zfcProofArithmeticQuantifierSubstGraph_sound (t d c v: nat): $ zfcProofArithmeticQuantifierSubstGraph t d c v -> sfSubst (d) t (c) = v $;

theorem zfcProofArithmeticQuantifierSubstGraph_correct (t d c v: nat): $ zfcProofArithmeticQuantifierSubstGraph t d c v <-> sfSubst (d) t (c) = v $;
