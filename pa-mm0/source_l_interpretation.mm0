import "source_zfc_interpretation.mm0";

import "source_l_nonempty.mm0";

import "source_wf_consistency.mm0";

theorem sfLZFC_transfer_from_images (a: nat):
 $ sfZFCImageFamilies zfrAxioms sfLDomain -> sfBound 0 a -> zfcProvable a -> sfTheoryProvable zfrAxioms (sfRelativize sfLDomain a) $;

theorem sfLZFC_refutation_from_images:
 $ sfZFCImageFamilies zfrAxioms sfLDomain -> zfcInconsistent -> sfTheoryProvable zfrAxioms sfBot $;

theorem sfLZFR_refutation_into_ZFC:
 $ sfTheoryProvable zfrAxioms sfBot -> zfcInconsistent $;

theorem sfLZFC_ZFR_equiconsistency_from_images:
 $ sfZFCImageFamilies zfrAxioms sfLDomain -> (zfcInconsistent <-> sfTheoryProvable zfrAxioms sfBot) $;

theorem sfLZFC_core_refutation_from_images:
 $ sfZFCImageFamilies zfrAxioms sfLDomain -> zfcInconsistent -> sfTheoryProvable zfcCoreAxioms sfBot $;

theorem sfLCore_refutation_into_ZFC:
 $ sfTheoryProvable zfcCoreAxioms sfBot -> zfcInconsistent $;

theorem sfLZFC_core_equiconsistency_from_images:
 $ sfZFCImageFamilies zfrAxioms sfLDomain -> (zfcInconsistent <-> sfTheoryProvable zfcCoreAxioms sfBot) $;

theorem sfLZFC_core_consistency_from_images:
 $ sfZFCImageFamilies zfrAxioms sfLDomain -> (~zfcInconsistent <-> ~sfTheoryProvable zfcCoreAxioms sfBot) $;
