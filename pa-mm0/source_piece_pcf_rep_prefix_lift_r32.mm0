import "source_piece_pcf_rep_prefix_maps_r30.mm0";

theorem sfPieceRepDn3_bound_shift(a:nat)(hb:$ sfBound 3 a $): $ sfRename sfPieceRepRotate3 0 a = sfShift 0 a $;

theorem sfPieceRepDn3_assumption_intro(a b n:nat)(hb:$ sfBound 3 a $): $ nsLocal (a : 0) b -> nsLocal (a : 0) (sfPieceRepDn3Core n b) $;

theorem sfPieceRepDn3_bound_pure(a n:nat)(hb:$ sfBound 3 a $): $ nsLocal 0 (sfImp a (sfPieceRepDn3Core n a)) $;

theorem sfPieceRepDn3_bound_lift(G a n:nat)(hb:$ sfBound 3 a $)(hp:$ nsLocal G a $): $ nsLocal G (sfPieceRepDn3Core n a) $;
