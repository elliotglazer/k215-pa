def sftvspF0(level P:nat):nat = $ sfMem 0 1 $;

def sftvspF1(level P:nat):nat = $ sfMem 0 2 $;

def sftvspF2(level P:nat):nat = $ sfImp (sftvspF0 level P) (sftvspF1 level P) $;

def sftvspF3(level P:nat):nat = $ sfAll (sftvspF2 level P) $;

def sftvspF4(level P:nat):nat = $ sfImp (sftvspF0 level P) (sftvspF3 level P) $;

def sftvspF5(level P:nat):nat = $ sfAll (sftvspF4 level P) $;

def sftvspF6(level P:nat):nat = $ sfImp (sftvspF0 level P) (sftvspF5 level P) $;

def sftvspF7(level P:nat):nat = $ sfAll (sftvspF6 level P) $;

def sftvspF8(level P:nat):nat = $ sfAnd (sftvspF5 level P) (sftvspF7 level P) $;

def sftvspF9(level P:nat):nat = $ sfORBinary P 0 1 $;

def sftvspF10(level P:nat):nat = $ sfMem 2 0 $;

def sftvspF11(level P:nat):nat = $ sfAnd (sftvspF9 level P) (sftvspF10 level P) $;

def sftvspF12(level P:nat):nat = $ sfAnd (sftvspF8 level P) (sftvspF11 level P) $;

def sftvspF13(level P:nat):nat = $ sfEx (sftvspF12 level P) $;

def sftvspF14(level P:nat):nat = $ sfAnd (sftvspF8 level P) (sftvspF10 level P) $;

def sftvspF15(level P:nat):nat = $ sfAnd (sftvspF14 level P) (sftvspF9 level P) $;

def sftvspF16(level P:nat):nat = $ sfEx (sftvspF15 level P) $;

def sftvspF17(level P:nat):nat = $ sfImp (sftvspF13 level P) (sftvspF16 level P) $;

def sftvspG18(level P:nat):nat = $ (sftvspF13 level P) : 0 $;

def sftvspF19(level P:nat):nat = $ sfORBinary P 0 2 $;

def sftvspF20(level P:nat):nat = $ sfMem 3 0 $;

def sftvspF21(level P:nat):nat = $ sfAnd (sftvspF19 level P) (sftvspF20 level P) $;

def sftvspF22(level P:nat):nat = $ sfAnd (sftvspF8 level P) (sftvspF21 level P) $;

def sftvspF23(level P:nat):nat = $ sfEx (sftvspF22 level P) $;

def sftvspG24(level P:nat):nat = $ (sftvspF23 level P) : 0 $;

def sftvspF25(level P:nat):nat = $ sfAnd (sftvspF8 level P) (sftvspF20 level P) $;

def sftvspF26(level P:nat):nat = $ sfAnd (sftvspF25 level P) (sftvspF19 level P) $;

def sftvspF27(level P:nat):nat = $ sfEx (sftvspF26 level P) $;

def sftvspG28(level P:nat):nat = $ (sftvspF12 level P) : (sftvspG24 level P) $;

def sftvspF29(level P:nat):nat = $ sfMem 0 3 $;

def sftvspF30(level P:nat):nat = $ sfImp (sftvspF0 level P) (sftvspF29 level P) $;

def sftvspF31(level P:nat):nat = $ sfAll (sftvspF30 level P) $;

def sftvspF32(level P:nat):nat = $ sfImp (sftvspF1 level P) (sftvspF31 level P) $;

def sftvspF33(level P:nat):nat = $ sfAll (sftvspF32 level P) $;

def sftvspF34(level P:nat):nat = $ sfImp (sftvspF1 level P) (sftvspF5 level P) $;

def sftvspF35(level P:nat):nat = $ sfAll (sftvspF34 level P) $;

def sftvspF36(level P:nat):nat = $ sfAnd (sftvspF33 level P) (sftvspF35 level P) $;

def sftvspF37(level P:nat):nat = $ sfImp (sftvspF36 level P) (sftvspF16 level P) $;

def sftvspF38(level P:nat):nat = $ sfAll (sftvspF37 level P) $;

def sftvspF39(level P:nat):nat = $ sfAll (sftvspF38 level P) $;

def sftvspF40(level P:nat):nat = $ sfORBinary level 1 0 $;

def sftvspF41(level P:nat):nat = $ sfImp (sftvspF40 level P) (sftvspF16 level P) $;

def sftvspF42(level P:nat):nat = $ sfImp (sftvspF36 level P) (sftvspF41 level P) $;

def sftvspF43(level P:nat):nat = $ sfAll (sftvspF42 level P) $;

def sftvspF44(level P:nat):nat = $ sfAll (sftvspF43 level P) $;

def sftvspF45(level P:nat):nat = $ sfImp (sftvspF39 level P) (sftvspF44 level P) $;

def sftvspG46(level P:nat):nat = $ (sftvspF39 level P) : 0 $;

def sftvspG47(level P:nat):nat = $ (sftvspF36 level P) : (sftvspG46 level P) $;

def sftvspG48(level P:nat):nat = $ (sftvspF40 level P) : (sftvspG47 level P) $;

def sftvspF49(level P:nat):nat = $ sfMem 0 4 $;

def sftvspF50(level P:nat):nat = $ sfImp (sftvspF0 level P) (sftvspF49 level P) $;

def sftvspF51(level P:nat):nat = $ sfAll (sftvspF50 level P) $;

def sftvspF52(level P:nat):nat = $ sfImp (sftvspF29 level P) (sftvspF51 level P) $;

def sftvspF53(level P:nat):nat = $ sfAll (sftvspF52 level P) $;

def sftvspF54(level P:nat):nat = $ sfImp (sftvspF29 level P) (sftvspF5 level P) $;

def sftvspF55(level P:nat):nat = $ sfAll (sftvspF54 level P) $;

def sftvspF56(level P:nat):nat = $ sfAnd (sftvspF53 level P) (sftvspF55 level P) $;

def sftvspF57(level P:nat):nat = $ sfAnd (sftvspF25 level P) (sftvspF9 level P) $;

def sftvspF58(level P:nat):nat = $ sfEx (sftvspF57 level P) $;

def sftvspF59(level P:nat):nat = $ sfImp (sftvspF56 level P) (sftvspF58 level P) $;

def sftvspF60(level P:nat):nat = $ sfAll (sftvspF59 level P) $;

def sfTVStrictPieceAt(P:nat):nat = $ sfEx (sfAnd (sfAnd sfLeastOrdinalPredicate (sfMem 2 0)) (sfORBinary P 0 1)) $;

def sfTVStrictPieceBound(P:nat):nat = $ sfAll (sfAll (sfImp (sfSubst 0 1 sfLeastOrdinalPredicate) (sfTVStrictPieceAt P))) $;

theorem sfTVBinary_identity(P:nat)(hp:$ sfBound 2 P $): $ sfORBinary P 0 1 = P $;

theorem sfTVStrictPiece_reorder(level P:nat)(hl:$ sfBound 2 level $)(hp:$ sfBound 2 P $): $ nsLocal 0 (sfImp (sfPieceHasOrdinal (sfAnd P sfTVStrictMember)) (sfTVStrictPieceAt P)) $;

theorem sfTVStrictPiece_reorder_zfr(level P:nat)(hl:$ sfBound 2 level $)(hp:$ sfBound 2 P $): $ sfTheoryProvable zfrAxioms (sfImp (sfPieceHasOrdinal (sfAnd P sfTVStrictMember)) (sfTVStrictPieceAt P)) $;

theorem sfTVStrictPiece_conditional(level P:nat)(hl:$ sfBound 2 level $)(hp:$ sfBound 2 P $): $ nsLocal 0 (sfImp (sfTVStrictPieceBound P) (sfReflectionCondPiecesBound level P)) $;

theorem sfTVStrictPiece_conditional_zfr(level P:nat)(hl:$ sfBound 2 level $)(hp:$ sfBound 2 P $): $ sfTheoryProvable zfrAxioms (sfImp (sfTVStrictPieceBound P) (sfReflectionCondPiecesBound level P)) $;

theorem sfTVStrictPieceBound_from_witnesses(level P:nat)(hl:$ sfBound 2 level $)(hp:$ sfBound 2 P $)(hm:$ sfTheoryProvable zfrAxioms (sfPieceMonoCode P) $)(he:$ sfTheoryProvable zfrAxioms (sfPieceHasOrdinal P) $): $ sfTheoryProvable zfrAxioms (sfTVStrictPieceBound P) $;

theorem sfTVCondPiecesBound_from_witnesses(level P:nat)(hl:$ sfBound 2 level $)(hp:$ sfBound 2 P $)(hm:$ sfTheoryProvable zfrAxioms (sfPieceMonoCode P) $)(he:$ sfTheoryProvable zfrAxioms (sfPieceHasOrdinal P) $): $ sfTheoryProvable zfrAxioms (sfReflectionCondPiecesBound level P) $;
