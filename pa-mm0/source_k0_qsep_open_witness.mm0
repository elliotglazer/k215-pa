import "source_k0_qsep_kp0_witness.mm0";

import "k218q_source_k0_open.mm0";

theorem sfK0QSepKp0_open_use (E: set) (n k y f: nat)
 (hf: $ sfBound (suc (suc n)) f $) (hk: $ 0 < k $)
 (he: $ sqEnvBelow E n k $) (hy: $ y < k $):
 $ k218QProvable (sfNamedTemplate (sqEnvCons y E) (suc k) 0 (sfK0QSepKp0UseBody f)) $;

theorem sfK0QSepTaggedWitness_open (E: set) (n a r t b k theta: nat)
 (hf: $ sfBound (suc n) theta $) (hk: $ 0 < k $)
 (he: $ sqEnvBelow (sqEnvCons b (sqEnvCons t (sqEnvCons r E))) (suc (suc (suc n))) k $)
 (ha: $ a < k $):
 $ k218QProvable (sfK0QSepTaggedWitness E a r t b k theta) $;
