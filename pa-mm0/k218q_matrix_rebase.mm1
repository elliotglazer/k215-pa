import "k218q_rebase.mm1";

pub theorem k218MatrixHygiene_pair (E: set) (n B f q r: nat)
 (he: $ sqRebaseHygiene E n B f 0 $)
 (hq: $ sqAllocAvoid B (suc f) q $) (hr: $ sqAllocAvoid B (suc f) r $):
 $ sqRebaseHygiene (sqEnvCons q (sqEnvCons r E)) (suc (suc n)) B f 0 $ =
'(ian (ax_mp sqRebaseHygiene_zero he)
  (ax_mp (ax_mp sqRangeEnvironment_cons
      (mpbir (sqAllocAvoideq2 (suceq add0)) hq))
    (ax_mp (ax_mp sqRangeEnvironment_cons
        (mpbir (sqAllocAvoideq2 (suceq add0)) hr))
      (ax_mp sqRebaseHygiene_environment he))));

pub theorem k218QMatrix_pair_rebase (E: set) (n B L f q r: nat)
 (hf: $ sfBound (suc (suc n)) f $)
 (hB: $ sqRebaseHygiene E n B f 0 $) (hL: $ sqRebaseHygiene E n L f 0 $)
 (hqB: $ sqAllocAvoid B (suc f) q $) (hrB: $ sqAllocAvoid B (suc f) r $)
 (hqL: $ sqAllocAvoid L (suc f) q $) (hrL: $ sqAllocAvoid L (suc f) r $):
 $ k218IEquivalent
     (sfNamedTemplate (sqEnvCons q (sqEnvCons r E)) B 0 f)
     (sfNamedTemplate (sqEnvCons q (sqEnvCons r E)) L 0 f) $ =
'(ax_mp (ax_mp (ax_mp k218IsfNamedTemplate_fresh_base_equivalent hf)
    (k218MatrixHygiene_pair hB hqB hrB))
  (k218MatrixHygiene_pair hL hqL hrL));
