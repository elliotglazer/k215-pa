import "quotation_supported_eigenvariables.mm1";

-- Witness-dependent cutoffs are retained in the arithmetic Good predicate.
theorem sqQC_premise (F: wff) (H S n m t k G a: nat)
 (hp: $ F -> sqSupportedAt m (sfSequent G a) $) (hm: $ F -> m <= n $)
 (hs: $ F -> sqEnvironmentSafe S n t k $) (hd: $ F -> sqDomainSupport H S t $)
 (hg: $ F -> sqSourceSupport H S t k G $):
 $ F -> kHypProvable H (sqQuote (sqNumericEnvironment S) t k 0 a) $ =
'(mpd hg (mpd hd (mpd (mpd hs (syl sqEnvironmentSafe_cutoff hm)) (syl sqSupportedAt_sequent hp))));
theorem sqQC_AllE_core (F: wff) (H S n m t k G a i: nat)
 (hp: $ F -> sqSupportedAt m (sfSequent G (sfAll a)) $) (hm: $ F -> m <= n $)
 (hi: $ F -> i < n $) (hs: $ F -> sqEnvironmentSafe S n t k $)
 (hd: $ F -> sqDomainSupport H S t $) (hg: $ F -> sqSourceSupport H S t k G $):
 $ F -> kHypProvable H (sqQuote (sqNumericEnvironment S) t k 0 (sfSubst 0 i a)) $ =
'(mpd (sqQC_premise hp hm hs hd hg) @
 mpd (syl (bi1 sfBound_sfAll) (mpd hm (syl sfBound_mono (syl sqSupportedAt_formula_bound hp)))) @
 mpd hi @ mpd hd @ syl sqSupported_AllE hs);
theorem sqQC_ExI_core (F: wff) (H S n m t k G a i: nat)
 (hp: $ F -> sqSupportedAt m (sfSequent G (sfSubst 0 i a)) $) (hm: $ F -> m <= n $)
 (hi: $ F -> i < n $) (hb: $ F -> sfBound n (sfEx a) $)
 (hs: $ F -> sqEnvironmentSafe S n t k $)
 (hd: $ F -> sqDomainSupport H S t $) (hg: $ F -> sqSourceSupport H S t k G $):
 $ F -> kHypProvable H (sqQuote (sqNumericEnvironment S) t k 0 (sfEx a)) $ =
'(mpd (sqQC_premise hp hm hs hd hg) @ mpd (syl (bi1 sfBound_sfEx) hb) @
 mpd hi @ mpd hd @ syl sqSupported_ExI hs);
theorem sqQC_AllE_property (F: wff) (m G a i: nat)
 (hw: $ F -> sfRowWf (sfSequent G (sfSubst 0 i a)) $)
 (hp: $ F -> sqSupportedAt m (sfSequent G (sfAll a)) $):
 $ F -> sqSupportedProperty (sfSequent G (sfSubst 0 i a) + m + suc i) (sfSequent G (sfSubst 0 i a)) $ =
(named '(!! iald S @ !! iald t @ !! iald k @ !! iald H @ exp @ exp @ exp @
 syl (bi2 sqSupportedRowGoal_sequent) @ sqQC_AllE_core
 (syl hp (syl anl (syl anl anl)))
 (a1i (letr leaddid2 leaddid1)) (a1i leaddid2)
 (syl anr (syl anl anl)) (syl anr anl)
 (syl (bi1 (sqSourceSupporteq5 sfSequent_context)) anr)));
pub theorem sqSupported_AllE_at (m G a i: nat):
 $ sfRowWf (sfSequent G (sfSubst 0 i a)) -> sqSupportedAt m (sfSequent G (sfAll a)) ->
 sqSupportedAt (sfSequent G (sfSubst 0 i a) + m + suc i) (sfSequent G (sfSubst 0 i a)) $ =
'(exp @ mpd (sqQC_AllE_property anl anr)
 (mpd (a1i (letr leaddid1 leaddid1)) (syl sqSupportedAt_intro anl)));
pub theorem sqSupported_AllE_good (G a i: nat):
 $ sfRowWf (sfSequent G (sfSubst 0 i a)) -> sqSupportedGood (sfSequent G (sfAll a)) ->
 sqSupportedGood (sfSequent G (sfSubst 0 i a)) $ =
(named '(eexd (syl6 sqSupportedGood_intro sqSupported_AllE_at)));
theorem sqQC_ExI_property (F: wff) (m G a i: nat)
 (hw: $ F -> sfRowWf (sfSequent G (sfEx a)) $)
 (hp: $ F -> sqSupportedAt m (sfSequent G (sfSubst 0 i a)) $):
 $ F -> sqSupportedProperty (sfSequent G (sfEx a) + m + suc i) (sfSequent G (sfEx a)) $ =
(named '(!! iald S @ !! iald t @ !! iald k @ !! iald H @ exp @ exp @ exp @
 syl (bi2 sqSupportedRowGoal_sequent) @ sqQC_ExI_core
 (syl hp (syl anl (syl anl anl)))
 (a1i (letr leaddid2 leaddid1)) (a1i leaddid2)
 (mpd (a1i (letr leaddid1 leaddid1)) (syl sqRowWf_sequent_formula_bound (syl hw (syl anl (syl anl anl)))))
 (syl anr (syl anl anl)) (syl anr anl)
 (syl (bi1 (sqSourceSupporteq5 sfSequent_context)) anr)));
pub theorem sqSupported_ExI_at (m G a i: nat):
 $ sfRowWf (sfSequent G (sfEx a)) -> sqSupportedAt m (sfSequent G (sfSubst 0 i a)) ->
 sqSupportedAt (sfSequent G (sfEx a) + m + suc i) (sfSequent G (sfEx a)) $ =
'(exp @ mpd (sqQC_ExI_property anl anr)
 (mpd (a1i (letr leaddid1 leaddid1)) (syl sqSupportedAt_intro anl)));
pub theorem sqSupported_ExI_good (G a i: nat):
 $ sfRowWf (sfSequent G (sfEx a)) -> sqSupportedGood (sfSequent G (sfSubst 0 i a)) ->
 sqSupportedGood (sfSequent G (sfEx a)) $ =
(named '(eexd (syl6 sqSupportedGood_intro sqSupported_ExI_at)));

theorem sqQC_ExE_property (F: wff) (m j G a c: nat)
 (hw: $ F -> sfRowWf (sfSequent G c) $)
 (hp: $ F -> sqSupportedAt m (sfSequent G (sfEx a)) $)
 (hq: $ F -> sqSupportedAt j (sfSequent (a : sfContextShift G) (sfShift 0 c)) $):
 $ F -> sqSupportedProperty (sfSequent G c + m + j) (sfSequent G c) $ =
(named '(!! iald S @ !! iald t @ !! iald k @ !! iald H @ exp @ exp @ exp @
 syl (bi2 sqSupportedRowGoal_sequent) @ sqSupported_ExE_core
 (syl hp (syl anl (syl anl anl))) (syl hq (syl anl (syl anl anl)))
 (a1i (letr leaddid2 leaddid1)) (a1i (letr leaddid2 lesucid))
 (syl anl (syl (bi1 sfRowWf_sequent) (syl hw (syl anl (syl anl anl)))))
 (mpd (a1i (letr leaddid1 leaddid1)) (syl sqRowWf_sequent_source_bound (syl hw (syl anl (syl anl anl)))))
 (mpd (a1i (letr leaddid1 leaddid1)) (syl sqRowWf_sequent_formula_bound (syl hw (syl anl (syl anl anl)))))
 (syl anr (syl anl anl)) (syl anr anl)
 (syl (bi1 (sqSourceSupporteq5 sfSequent_context)) anr)));
pub theorem sqSupported_ExE_at (m j G a c: nat):
 $ sfRowWf (sfSequent G c) -> sqSupportedAt m (sfSequent G (sfEx a)) ->
 sqSupportedAt j (sfSequent (a : sfContextShift G) (sfShift 0 c)) ->
 sqSupportedAt (sfSequent G c + m + j) (sfSequent G c) $ =
'(exp @ exp @ mpd (sqQC_ExE_property anll anlr anr)
 (mpd (a1i (letr leaddid1 leaddid1)) (syl sqSupportedAt_intro anll)));
theorem sqQC_ExE_good_at (m j G a c: nat):
 $ sfRowWf (sfSequent G c) -> sqSupportedAt m (sfSequent G (sfEx a)) ->
 sqSupportedAt j (sfSequent (a : sfContextShift G) (sfShift 0 c)) ->
 sqSupportedGood (sfSequent G c) $ =
'(exp @ exp @ syl sqSupportedGood_intro @
 mpd anr (mpd anlr (syl sqSupported_ExE_at anll)));
pub theorem sqSupported_ExE (G a c: nat):
 $ sfRowWf (sfSequent G c) -> sqSupportedGood (sfSequent G (sfEx a)) ->
 sqSupportedGood (sfSequent (a : sfContextShift G) (sfShift 0 c)) ->
 sqSupportedGood (sfSequent G c) $ =
(named '(eexd @ exp @ eexd @ imp sqQC_ExE_good_at));

theorem sqQC_unary_transport (r p R P: nat)
 (h: $ sfRowWf R -> sqSupportedGood P -> sqSupportedGood R $):
 $ sfRowWf r -> (r = R /\ p = P) -> sqSupportedGood p -> sqSupportedGood r $ =
'(exp @ exp @ mpbird (sqSupportedGoodeqd (syl anl anlr)) @
 mpd (mpbid (sqSupportedGoodeqd (syl anr anlr)) anr)
 (syl h (mpbid (sfRowWf_congr (syl anl anlr)) anll)));
theorem sqQC_binary_transport (r p q R P Q: nat)
 (h: $ sfRowWf R -> sqSupportedGood P -> sqSupportedGood Q -> sqSupportedGood R $):
 $ sfRowWf r -> (r = R /\ (p = P /\ q = Q)) ->
 sqSupportedGood p -> sqSupportedGood q -> sqSupportedGood r $ =
'(exp @ exp @ exp @ mpbird (sqSupportedGoodeqd (syl anl anllr)) @
 mpd (mpbid (sqSupportedGoodeqd (syl anr (syl anr anllr))) anr) @
 mpd (mpbid (sqSupportedGoodeqd (syl anl (syl anr anllr))) anlr) @
 syl h (mpbid (sfRowWf_congr (syl anl anllr)) (syl anl anll)));

pub theorem sqSupportedCase_AllI (r p: nat):
 $ sfRowWf r -> sfNDCaseAllI r p -> sqSupportedGood p -> sqSupportedGood r $ =
(named '(eexd @ eexd @ sqQC_unary_transport sqSupported_AllI));
pub theorem sqSupportedCase_AllE (r p: nat):
 $ sfRowWf r -> sfNDCaseAllE r p -> sqSupportedGood p -> sqSupportedGood r $ =
(named '(eexd @ eexd @ eexd @ sqQC_unary_transport sqSupported_AllE_good));
pub theorem sqSupportedCase_ExI (r p: nat):
 $ sfRowWf r -> sfNDCaseExI r p -> sqSupportedGood p -> sqSupportedGood r $ =
(named '(eexd @ eexd @ eexd @ sqQC_unary_transport sqSupported_ExI_good));
pub theorem sqSupportedCase_ExE (r p q: nat):
 $ sfRowWf r -> sfNDCaseExE r p q -> sqSupportedGood p -> sqSupportedGood q -> sqSupportedGood r $ =
(named '(eexd @ eexd @ eexd @ sqQC_binary_transport sqSupported_ExE));

pub theorem sqSupported_quant_unary (r p: nat):
 $ sfNDQuantUnary r p -> sqSupportedGood p -> sqSupportedGood r $ =
'(imp (eord sqSupportedCase_AllI (eord sqSupportedCase_AllE sqSupportedCase_ExI)));
pub theorem sqSupported_quant_binary (r p q: nat):
 $ sfNDQuantBinary r p q -> sqSupportedGood p -> sqSupportedGood q -> sqSupportedGood r $ =
'(imp sqSupportedCase_ExE);
