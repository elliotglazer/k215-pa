   (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet1_vector)) k215PSet1_vector))));

theorem k215BinaryTagAllAt78 (u t w c a b v: nat):
 $ k215PReach (k215PState k215Num105 (k215PVector u (4 * (fst w, t)) (snd w) c a b 0 0 v)) (k215PState k215Num107 (k215PVector u (kAll (fst w) t) (snd w) c a b 0 0 v)) $ = '(mpbi (k215PReacheq2 (k215PStateeq2 (k215PVectoreq2 (eqcom (eqtr addS (suceq (eqtr addS (suceq add0)))))))) (ax_mp (ax_mp k215PReach_trans k215BinaryTag0At78) k215BinaryTag1At78));

pub theorem k215BinaryConstructor78 (u t w c a b v: nat):
 $ k215PReach (k215PState k215Num78 (k215PVector u t w c a b 0 0 v)) (k215PState k215Num107 (k215PVector u (kAll (fst w) t) (snd w) c a b 0 0 v)) $ = '(ax_mp (ax_mp k215PReach_trans k215BinaryUnpairAt78) (ax_mp (ax_mp k215PReach_trans k215BinaryRestoreStackAt78) (ax_mp (ax_mp k215PReach_trans k215BinaryPairCleanAt78) (ax_mp (ax_mp k215PReach_trans k215BinaryFourAt78) k215BinaryTagAllAt78))));

