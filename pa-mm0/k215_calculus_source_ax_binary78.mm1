theorem k215BinaryUnpairInAt78 (u t w c a b v: nat): $ (k215UnpairAt78State k215Num78 0 0 w (k215PVector u t w c a b 0 0 v)) = (k215PState k215Num78 (k215PVector u t w c a b 0 0 v)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector eqid k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryUnpairOutAt78 (u t w c a b v: nat): $ (k215UnpairAt78State k215Num86 (fst w) (snd w) 0 (k215PVector u t w c a b 0 0 v)) = (k215PState k215Num86 (k215PVector u t 0 c a b (fst w) (snd w) v)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector eqid k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryUnpairAt78 (u t w c a b v: nat):
 $ k215PReach (k215PState k215Num78 (k215PVector u t w c a b 0 0 v)) (k215PState k215Num86 (k215PVector u t 0 c a b (fst w) (snd w) v)) $ =
 '(mpbi (k215PReacheq k215BinaryUnpairInAt78 k215BinaryUnpairOutAt78) k215UnpairMacro78_clean);

theorem k215BinaryRestoreStackAt78 (u t w c a b v: nat):
 $ k215PReach (k215PState k215Num86 (k215PVector u t 0 c a b (fst w) (snd w) v)) (k215PState k215Num89 (k215PVector u t (snd w) c a b (fst w) 0 v)) $ =
 '(k215PReach_intro (eqtr k215Loop86Vector (k215PStateeq2 (k215PVectoreq3 add0))));

theorem k215BinaryPairInAt78 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt89State k215Num89 a6 a1 a7 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215Num89 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryPairOutAt78 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt89State k215Num99 0 0 (a7 + (a6, a1)) (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215Num99 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryPairAt78 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat):
 $ k215PReach (k215PState k215Num89 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215Num99 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ =
 '(mpbi (k215PReacheq k215BinaryPairInAt78 k215BinaryPairOutAt78) k215PairMacro89);

theorem k215BinaryPairCleanAt78 (u t w c a b v: nat):
 $ k215PReach (k215PState k215Num89 (k215PVector u t (snd w) c a b (fst w) 0 v)) (k215PState k215Num99 (k215PVector u 0 (snd w) c a b 0 (fst w, t) v)) $ =
 '(mpbi (k215PReacheq2 (k215PStateeq2 (k215PVectoreq8 add01))) k215BinaryPairAt78);
theorem k215BinaryFourAt78 (u t w c a b v: nat):
 $ k215PReach (k215PState k215Num99 (k215PVector u 0 (snd w) c a b 0 (fst w, t) v)) (k215PState k215Num105 (k215PVector u (4 * (fst w, t)) (snd w) c a b 0 0 v)) $ =
 '(k215PReach_intro (eqtr k215Loop99Vector (k215PStateeq2 (k215PVectoreq2 add0))));

theorem k215BinaryTag0At78 (u t w c a b v: nat):
 $ k215PReach (k215PState k215Num105 (k215PVector u (4 * (fst w, t)) (snd w) c a b 0 0 v)) (k215PState k215Num106 (k215PVector u (suc (4 * (fst w, t))) (snd w) c a b 0 0 v)) $ =
 '(k215PReach_step (eqtr (k215PAtCI k215PLookupTags78_105)
   (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet1_vector)) k215PSet1_vector))));

theorem k215BinaryTag1At78 (u t w c a b v: nat):
 $ k215PReach (k215PState k215Num106 (k215PVector u (suc (4 * (fst w, t))) (snd w) c a b 0 0 v)) (k215PState k215Num107 (k215PVector u (suc (suc (4 * (fst w, t)))) (snd w) c a b 0 0 v)) $ =
