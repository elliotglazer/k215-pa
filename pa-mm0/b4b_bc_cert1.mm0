import "b4b_bc_join.mm0";

theorem bcRuleI_Num (m v i g a b c d: nat): $ g = bctNum -> bcRNum m v i a b -> bcRule m v i g a b c d $;
theorem bcRuleI_TLift (m v i g a b c d: nat): $ g = bctTLift -> bcRTLift m v i a b c -> bcRule m v i g a b c d $;
theorem bcRuleI_TRen (m v i g a b c d: nat): $ g = bctTRen -> bcRTRen m v i a b c d -> bcRule m v i g a b c d $;
theorem bcRuleI_TSub (m v i g a b c d: nat): $ g = bctTSub -> bcRTSub m v i a b c d -> bcRule m v i g a b c d $;
theorem bcRuleI_FSub (m v i g a b c d: nat): $ g = bctFSub -> bcRFSub m v i a b c d -> bcRule m v i g a b c d $;
theorem bcRuleI_FRen (m v i g a b c d: nat): $ g = bctFRen -> bcRFRen m v i a b c d -> bcRule m v i g a b c d $;
theorem bcRuleI_SRen (m v i g a b c d: nat): $ g = bctSRen -> bcRSRen m v i a b c d -> bcRule m v i g a b c d $;
theorem bcRuleI_TSrc (m v i g a b c d: nat): $ g = bctTSrc -> bcRTSrc m v i a b -> bcRule m v i g a b c d $;
theorem bcRuleI_FSrc (m v i g a b c d: nat): $ g = bctFSrc -> bcRFSrc m v i a b -> bcRule m v i g a b c d $;
theorem RI_Num_0 (m v i: nat): $ bcRNum m v i 0 0 $;
theorem RI_Num_S (m v i n w1: nat): $ bdHas m v i bctNum n w1 0 0 -> bcRNum m v i (suc n) (sfNode 2 w1 0) $;
theorem CI_Num_0: $ bcCertF bctNum 0 0 0 0 $;
theorem CI_Num_S (n w1: nat): $ bcCertF bctNum n w1 0 0 -> bcCertF bctNum (suc n) (sfNode 2 w1 0) 0 0 $;
theorem bcNum_cert (n: nat) {x y m v: nat}: $ E. m E. v (bcJust m v /\ bdHas m v v bctNum n (paTermNumeral n) 0 0) $;
theorem RI_TLift_0 (m v i k: nat): $ bcRTLift m v i k 0 0 $;
theorem RI_TLift_var (m v i k p q: nat): $ bcRTLift m v i k (sfNode 1 p q) (sfNode 1 (k + p) 0) $;
theorem RI_TLift_succ (m v i k p q r: nat): $ bdHas m v i bctTLift k p r 0 -> bcRTLift m v i k (sfNode 2 p q) (sfNode 2 r 0) $;
theorem RI_TLift_3 (m v i k p q r u: nat): $ bdHas m v i bctTLift k p r 0 /\ bdHas m v i bctTLift k q u 0 -> bcRTLift m v i k (sfNode 3 p q) (sfNode 3 r u) $;
theorem RI_TLift_4 (m v i k p q r u: nat): $ bdHas m v i bctTLift k p r 0 /\ bdHas m v i bctTLift k q u 0 -> bcRTLift m v i k (sfNode 4 p q) (sfNode 4 r u) $;
theorem RI_TLift_j0 (m v i k p q: nat): $ bcRTLift m v i k (sfNode 0 p q) 0 $;
theorem RI_TLift_j5 (m v i k p q: nat): $ bcRTLift m v i k (sfNode 5 p q) 0 $;
theorem RI_TLift_j6 (m v i k p q: nat): $ bcRTLift m v i k (sfNode 6 p q) 0 $;
theorem RI_TLift_j7 (m v i k p q: nat): $ bcRTLift m v i k (sfNode 7 p q) 0 $;
theorem CI_TLift_0 (k: nat): $ bcCertF bctTLift k 0 0 0 $;
theorem CI_TLift_var (k p q: nat): $ bcCertF bctTLift k (sfNode 1 p q) (sfNode 1 (k + p) 0) 0 $;
theorem CI_TLift_succ (k p q r: nat): $ bcCertF bctTLift k p r 0 -> bcCertF bctTLift k (sfNode 2 p q) (sfNode 2 r 0) 0 $;
theorem CI_TLift_3 (k p q r u: nat): $ bcCertF bctTLift k p r 0 -> bcCertF bctTLift k q u 0 -> bcCertF bctTLift k (sfNode 3 p q) (sfNode 3 r u) 0 $;
theorem CI_TLift_4 (k p q r u: nat): $ bcCertF bctTLift k p r 0 -> bcCertF bctTLift k q u 0 -> bcCertF bctTLift k (sfNode 4 p q) (sfNode 4 r u) 0 $;
theorem CI_TLift_j0 (k p q: nat): $ bcCertF bctTLift k (sfNode 0 p q) 0 0 $;
theorem CI_TLift_j5 (k p q: nat): $ bcCertF bctTLift k (sfNode 5 p q) 0 0 $;
theorem CI_TLift_j6 (k p q: nat): $ bcCertF bctTLift k (sfNode 6 p q) 0 0 $;
theorem CI_TLift_j7 (k p q: nat): $ bcCertF bctTLift k (sfNode 7 p q) 0 0 $;
theorem RI_TRen_0 (m v i e d: nat): $ bcRTRen m v i e d 0 0 $;
theorem RI_TRen_var {ii jj: nat} (R: set) (m v i e d p q: nat) (hR: $ A. ii A. jj (bcCeMap e ii jj <-> jj = R @ ii) $): $ bcRTRen m v i e d (sfNode 1 p q) (sfNode 1 (sfRenameIndex R d p) 0) $;
theorem RI_TRen_succ (m v i e d p q r: nat): $ bdHas m v i bctTRen e d p r -> bcRTRen m v i e d (sfNode 2 p q) (sfNode 2 r 0) $;
theorem RI_TRen_3 (m v i e d p q r u: nat): $ bdHas m v i bctTRen e d p r /\ bdHas m v i bctTRen e d q u -> bcRTRen m v i e d (sfNode 3 p q) (sfNode 3 r u) $;
theorem RI_TRen_4 (m v i e d p q r u: nat): $ bdHas m v i bctTRen e d p r /\ bdHas m v i bctTRen e d q u -> bcRTRen m v i e d (sfNode 4 p q) (sfNode 4 r u) $;
theorem RI_TRen_j0 (m v i e d p q: nat): $ bcRTRen m v i e d (sfNode 0 p q) 0 $;
theorem RI_TRen_j5 (m v i e d p q: nat): $ bcRTRen m v i e d (sfNode 5 p q) 0 $;
theorem RI_TRen_j6 (m v i e d p q: nat): $ bcRTRen m v i e d (sfNode 6 p q) 0 $;
theorem RI_TRen_j7 (m v i e d p q: nat): $ bcRTRen m v i e d (sfNode 7 p q) 0 $;
theorem CI_TRen_0 (e d: nat): $ bcCertF bctTRen e d 0 0 $;
theorem CI_TRen_var {ii jj: nat} (R: set) (e d p q: nat) (hR: $ A. ii A. jj (bcCeMap e ii jj <-> jj = R @ ii) $): $ bcCertF bctTRen e d (sfNode 1 p q) (sfNode 1 (sfRenameIndex R d p) 0) $;
theorem CI_TRen_succ (e d p q r: nat): $ bcCertF bctTRen e d p r -> bcCertF bctTRen e d (sfNode 2 p q) (sfNode 2 r 0) $;
theorem CI_TRen_3 (e d p q r u: nat): $ bcCertF bctTRen e d p r -> bcCertF bctTRen e d q u -> bcCertF bctTRen e d (sfNode 3 p q) (sfNode 3 r u) $;
theorem CI_TRen_4 (e d p q r u: nat): $ bcCertF bctTRen e d p r -> bcCertF bctTRen e d q u -> bcCertF bctTRen e d (sfNode 4 p q) (sfNode 4 r u) $;
theorem CI_TRen_j0 (e d p q: nat): $ bcCertF bctTRen e d (sfNode 0 p q) 0 $;
theorem CI_TRen_j5 (e d p q: nat): $ bcCertF bctTRen e d (sfNode 5 p q) 0 $;
theorem CI_TRen_j6 (e d p q: nat): $ bcCertF bctTRen e d (sfNode 6 p q) 0 $;
theorem CI_TRen_j7 (e d p q: nat): $ bcCertF bctTRen e d (sfNode 7 p q) 0 $;
theorem RI_TSub_0 (m v i d s: nat): $ bcRTSub m v i d s 0 0 $;
theorem RI_TSub_lt (m v i d s p1 q1: nat): $ p1 < d -> bcRTSub m v i d s (sfNode 1 p1 q1) (sfNode 1 p1 0) $;
theorem RI_TSub_eq (m v i d s q1 y: nat): $ bdHas m v i bctTLift d s y 0 -> bcRTSub m v i d s (sfNode 1 d q1) y $;
theorem RI_TSub_gt (m v i d s j1 q1: nat): $ d < suc j1 -> bcRTSub m v i d s (sfNode 1 (suc j1) q1) (sfNode 1 j1 0) $;
theorem RI_TSub_succ (m v i d s p1 q1 r: nat): $ bdHas m v i bctTSub d s p1 r -> bcRTSub m v i d s (sfNode 2 p1 q1) (sfNode 2 r 0) $;
theorem RI_TSub_3 (m v i d s p1 q1 r u: nat): $ bdHas m v i bctTSub d s p1 r /\ bdHas m v i bctTSub d s q1 u -> bcRTSub m v i d s (sfNode 3 p1 q1) (sfNode 3 r u) $;
theorem RI_TSub_4 (m v i d s p1 q1 r u: nat): $ bdHas m v i bctTSub d s p1 r /\ bdHas m v i bctTSub d s q1 u -> bcRTSub m v i d s (sfNode 4 p1 q1) (sfNode 4 r u) $;
theorem RI_TSub_j0 (m v i d s p1 q1: nat): $ bcRTSub m v i d s (sfNode 0 p1 q1) 0 $;
theorem RI_TSub_j5 (m v i d s p1 q1: nat): $ bcRTSub m v i d s (sfNode 5 p1 q1) 0 $;
theorem RI_TSub_j6 (m v i d s p1 q1: nat): $ bcRTSub m v i d s (sfNode 6 p1 q1) 0 $;
theorem RI_TSub_j7 (m v i d s p1 q1: nat): $ bcRTSub m v i d s (sfNode 7 p1 q1) 0 $;
theorem CI_TSub_0 (d s: nat): $ bcCertF bctTSub d s 0 0 $;
theorem CI_TSub_lt (d s p1 q1: nat): $ p1 < d -> bcCertF bctTSub d s (sfNode 1 p1 q1) (sfNode 1 p1 0) $;
theorem CI_TSub_eq (d s q1 y: nat): $ bcCertF bctTLift d s y 0 -> bcCertF bctTSub d s (sfNode 1 d q1) y $;
theorem CI_TSub_gt (d s j1 q1: nat): $ d < suc j1 -> bcCertF bctTSub d s (sfNode 1 (suc j1) q1) (sfNode 1 j1 0) $;
theorem CI_TSub_succ (d s p1 q1 r: nat): $ bcCertF bctTSub d s p1 r -> bcCertF bctTSub d s (sfNode 2 p1 q1) (sfNode 2 r 0) $;
theorem CI_TSub_3 (d s p1 q1 r u: nat): $ bcCertF bctTSub d s p1 r -> bcCertF bctTSub d s q1 u -> bcCertF bctTSub d s (sfNode 3 p1 q1) (sfNode 3 r u) $;
theorem CI_TSub_4 (d s p1 q1 r u: nat): $ bcCertF bctTSub d s p1 r -> bcCertF bctTSub d s q1 u -> bcCertF bctTSub d s (sfNode 4 p1 q1) (sfNode 4 r u) $;
theorem CI_TSub_j0 (d s p1 q1: nat): $ bcCertF bctTSub d s (sfNode 0 p1 q1) 0 $;
theorem CI_TSub_j5 (d s p1 q1: nat): $ bcCertF bctTSub d s (sfNode 5 p1 q1) 0 $;
theorem CI_TSub_j6 (d s p1 q1: nat): $ bcCertF bctTSub d s (sfNode 6 p1 q1) 0 $;
theorem CI_TSub_j7 (d s p1 q1: nat): $ bcCertF bctTSub d s (sfNode 7 p1 q1) 0 $;
theorem bcTLift_ih  (k c: nat) (y z: nat) {x: nat}: $ A. x (x < y -> bcCertF bctTLift k x (paTermRename (paTermLiftMap k) x) 0) -> z < y -> bcCertF bctTLift k z (paTermRename (paTermLiftMap k) z) 0 $;
theorem bcTLift_certF (k c: nat) {x y: nat}: $ bcCertF bctTLift k c (paTermRename (paTermLiftMap k) c) 0 $;
theorem bcTRen_ih  {ii jj: nat} (R: set) (e d c: nat) (y z: nat) {x: nat}: $ A. x (x < y -> bcCertF bctTRen e d x (paTermRename (sfRenameDepthMap R d) x)) -> z < y -> bcCertF bctTRen e d z (paTermRename (sfRenameDepthMap R d) z) $;
theorem bcTRen_certF {ii jj: nat} (R: set) (e d c: nat) {x y: nat} (hR: $ A. ii A. jj (bcCeMap e ii jj <-> jj = R @ ii) $): $ bcCertF bctTRen e d c (paTermRename (sfRenameDepthMap R d) c) $;
theorem bcTSub_ih  (d s c: nat) (y z: nat) {x: nat}: $ A. x (x < y -> bcCertF bctTSub d s x (paTermSubst d s x)) -> z < y -> bcCertF bctTSub d s z (paTermSubst d s z) $;
theorem bcTSub_certF (d s c: nat) {x y: nat}: $ bcCertF bctTSub d s c (paTermSubst d s c) $;
theorem bcTLift_cert (k t: nat) {m v: nat}: $ E. m E. v (bcJust m v /\ bdHas m v v bctTLift k t (paTermLift k t) 0) $;
theorem bcTSub_cert (d a t: nat) {m v: nat}: $ E. m E. v (bcJust m v /\ bdHas m v v bctTSub d a t (paTermSubst d a t)) $;
theorem bcTRen_cert {ii jj: nat} (R: set) (e d t: nat) {m v: nat} (hR: $ A. ii A. jj (bcCeMap e ii jj <-> jj = R @ ii) $): $ E. m E. v (bcJust m v /\ bdHas m v v bctTRen e d t (paTermRename (sfRenameDepthMap R d) t)) $;
