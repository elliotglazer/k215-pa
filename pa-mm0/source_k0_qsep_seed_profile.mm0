import "source_k0_qsep_tagged_profile.mm0";

import "source_k0_qsep_support_alpha.mm0";

import "source_k0_qsep_witness_normalize.mm0";

def sfK0QSepSeedFacts (r t b y: nat): nat = $ (kImp (kImp (kAll y (kImp (kMem y t) kF)) (kImp (kImp (kImp (kMem b r) (kImp (kImp (kImp (kMem t r) (kImp (kImp (kEq b t) kF) kF)) kF) kF)) kF) kF)) kF) $;

def sfK0QSepSeedClauses (E: set) (r t b c u y K theta: nat): nat = $ (kImp (kImp (kAll u (kImp (kDisj (kEq u r) (kExists y (kAnd (kMem y c) (kAll K (kImp (kMem K u) (kMem K y)))))) (kImp (kExists y (kDisj (kAnd (kEq u r) (kEq y b)) (kDisj (kAnd (kEq u t) (kEq y t)) (kAnd (kAnd (kMem y u) (kAll K (kImp (kMem K u) (kEq K y)))) (kAnd (kMem y b) (sfNamedTemplate (sqEnvCons y E) K 0 theta)))))) (kExists y (kAnd (kMem y c) (kDisj (kAnd (kEq u r) (kEq y b)) (kDisj (kAnd (kEq u t) (kEq y t)) (kAnd (kAnd (kMem y u) (kAll K (kImp (kMem K u) (kEq K y)))) (kAnd (kMem y b) (sfNamedTemplate (sqEnvCons y E) K 0 theta)))))))))) (kImp (sfK0QSepTaggedSupport E r t b c u y K theta) kF)) kF) $;

def sfK0QSepSeedProfile (E: set) (t b c x K theta: nat): nat = $ (kAll x (kImp (kImp (kImp (kMem x c) (kImp (kImp (kEq x b) kF) (kImp (kImp (kEq x t) kF) (kImp (kImp (kMem x b) (kImp (sfNamedTemplate (sqEnvCons x E) K 0 theta) kF)) kF)))) (kImp (kImp (kImp (kImp (kEq x b) kF) (kImp (kImp (kEq x t) kF) (kImp (kImp (kMem x b) (kImp (sfNamedTemplate (sqEnvCons x E) K 0 theta) kF)) kF))) (kMem x c)) kF)) kF)) $;

theorem sfK0QSepSeed_profile_curried (E: set) (n a r t b c p x u y K theta: nat)
 (hf: $ sfBound (suc n) theta $) (hu0: $ u != 0 $) (hy0: $ y != 0 $)
 (huK: $ u < K $) (hyK: $ y < K $) (hpK: $ p < K $) (hxK: $ x < K $)
 (hbK: $ b < K $) (htK: $ t < K $) (hrK: $ r < K $)
 (hru: $ r != u $) (htu: $ t != u $) (hbu: $ b != u $) (hcu: $ c != u $)
 (hyu: $ y != u $) (huy: $ u < y $) (hpy: $ p < y $)
 (hyr: $ y != r $) (hyt: $ y != t $) (hyb: $ y != b $) (hyc: $ y != c $)
 (hyp: $ y != p $) (hyx: $ y != x $)
 (heu: $ sqEnvAvoid E n u $) (hey: $ sqEnvAvoid E n y $) (hpu: $ p != u $)
 (ha0: $ 0 < a $) (hxa: $ x < a $) (hp0: $ p != 0 $)
 (hpr: $ p != r $) (hpt: $ p != t $) (hpb: $ p != b $) (hpc: $ p != c $) (hpx: $ p != x $)
 (hep: $ sqEnvAvoid E n p $)
 (hpA1: $ p != suc a $) (hpA2: $ p != suc (suc a) $) (hKA2: $ K != suc (suc a) $)
 (hx0: $ x != 0 $) (hxr: $ x != r $) (hxt: $ x != t $) (hxb: $ x != b $) (hxc: $ x != c $)
 (hxu: $ x != u $) (hex: $ sqEnvAvoid E n x $)
 (hry: $ r < y $) (hby: $ b < y $) (ht_y: $ t < y $) (hK0: $ K != 0 $)
 (hc0: $ c != 0 $) (hcr: $ c != r $) (hct: $ c != t $) (hcb: $ c != b $):
 $ k218QProvable (kImp (kAll y (kImp (kMem y t) kF)) (kImp (kMem b r) (kImp (kMem t r) (kImp (kImp (kEq b t) kF) (kImp (kAll u (kImp (kDisj (kEq u r) (kExists y (kAnd (kMem y c) (kAll K (kImp (kMem K u) (kMem K y)))))) (kImp (kExists y (kDisj (kAnd (kEq u r) (kEq y b)) (kDisj (kAnd (kEq u t) (kEq y t)) (kAnd (kAnd (kMem y u) (kAll K (kImp (kMem K u) (kEq K y)))) (kAnd (kMem y b) (sfNamedTemplate (sqEnvCons y E) K 0 theta)))))) (kExists y (kAnd (kMem y c) (kDisj (kAnd (kEq u r) (kEq y b)) (kDisj (kAnd (kEq u t) (kEq y t)) (kAnd (kAnd (kMem y u) (kAll K (kImp (kMem K u) (kEq K y)))) (kAnd (kMem y b) (sfNamedTemplate (sqEnvCons y E) K 0 theta)))))))))) (kImp (sfK0QSepTaggedSupport E r t b c u y K theta) (kAll x (kImp (kImp (kImp (kMem x c) (kImp (kImp (kEq x b) kF) (kImp (kImp (kEq x t) kF) (kImp (kImp (kMem x b) (kImp (sfNamedTemplate (sqEnvCons x E) K 0 theta) kF)) kF)))) (kImp (kImp (kImp (kImp (kEq x b) kF) (kImp (kImp (kEq x t) kF) (kImp (kImp (kMem x b) (kImp (sfNamedTemplate (sqEnvCons x E) K 0 theta) kF)) kF))) (kMem x c)) kF)) kF)))))))) $;

theorem sfK0QSepSeed_profile (E: set) (n a r t b c p x u y K theta: nat)
 (hf: $ sfBound (suc n) theta $) (hu0: $ u != 0 $) (hy0: $ y != 0 $)
 (huK: $ u < K $) (hyK: $ y < K $) (hpK: $ p < K $) (hxK: $ x < K $)
 (hbK: $ b < K $) (htK: $ t < K $) (hrK: $ r < K $)
 (hru: $ r != u $) (htu: $ t != u $) (hbu: $ b != u $) (hcu: $ c != u $)
 (hyu: $ y != u $) (huy: $ u < y $) (hpy: $ p < y $)
 (hyr: $ y != r $) (hyt: $ y != t $) (hyb: $ y != b $) (hyc: $ y != c $)
 (hyp: $ y != p $) (hyx: $ y != x $)
 (heu: $ sqEnvAvoid E n u $) (hey: $ sqEnvAvoid E n y $) (hpu: $ p != u $)
 (ha0: $ 0 < a $) (hxa: $ x < a $) (hp0: $ p != 0 $)
 (hpr: $ p != r $) (hpt: $ p != t $) (hpb: $ p != b $) (hpc: $ p != c $) (hpx: $ p != x $)
 (hep: $ sqEnvAvoid E n p $)
 (hpA1: $ p != suc a $) (hpA2: $ p != suc (suc a) $) (hKA2: $ K != suc (suc a) $)
 (hx0: $ x != 0 $) (hxr: $ x != r $) (hxt: $ x != t $) (hxb: $ x != b $) (hxc: $ x != c $)
 (hxu: $ x != u $) (hex: $ sqEnvAvoid E n x $)
 (hry: $ r < y $) (hby: $ b < y $) (ht_y: $ t < y $) (hK0: $ K != 0 $)
 (hc0: $ c != 0 $) (hcr: $ c != r $) (hct: $ c != t $) (hcb: $ c != b $):
 $ k218QProvable (kImp (kImp (kImp (kAll y (kImp (kMem y t) kF)) (kImp (kImp (kImp (kMem b r) (kImp (kImp (kImp (kMem t r) (kImp (kImp (kEq b t) kF) kF)) kF) kF)) kF) kF)) kF) (kImp (kImp (kImp (kAll u (kImp (kDisj (kEq u r) (kExists y (kAnd (kMem y c) (kAll K (kImp (kMem K u) (kMem K y)))))) (kImp (kExists y (kDisj (kAnd (kEq u r) (kEq y b)) (kDisj (kAnd (kEq u t) (kEq y t)) (kAnd (kAnd (kMem y u) (kAll K (kImp (kMem K u) (kEq K y)))) (kAnd (kMem y b) (sfNamedTemplate (sqEnvCons y E) K 0 theta)))))) (kExists y (kAnd (kMem y c) (kDisj (kAnd (kEq u r) (kEq y b)) (kDisj (kAnd (kEq u t) (kEq y t)) (kAnd (kAnd (kMem y u) (kAll K (kImp (kMem K u) (kEq K y)))) (kAnd (kMem y b) (sfNamedTemplate (sqEnvCons y E) K 0 theta)))))))))) (kImp (sfK0QSepTaggedSupport E r t b c u y K theta) kF)) kF) (kAll x (kImp (kImp (kImp (kMem x c) (kImp (kImp (kEq x b) kF) (kImp (kImp (kEq x t) kF) (kImp (kImp (kMem x b) (kImp (sfNamedTemplate (sqEnvCons x E) K 0 theta) kF)) kF)))) (kImp (kImp (kImp (kImp (kEq x b) kF) (kImp (kImp (kEq x t) kF) (kImp (kImp (kMem x b) (kImp (sfNamedTemplate (sqEnvCons x E) K 0 theta) kF)) kF))) (kMem x c)) kF)) kF)))) $;

theorem sfK0QSepSeed_profile_exists (E: set) (n a r t b c p x u y K theta: nat)
 (hf: $ sfBound (suc n) theta $) (hu0: $ u != 0 $) (hy0: $ y != 0 $)
 (huK: $ u < K $) (hyK: $ y < K $) (hpK: $ p < K $) (hxK: $ x < K $)
 (hbK: $ b < K $) (htK: $ t < K $) (hrK: $ r < K $)
 (hru: $ r != u $) (htu: $ t != u $) (hbu: $ b != u $) (hcu: $ c != u $)
 (hyu: $ y != u $) (huy: $ u < y $) (hpy: $ p < y $)
 (hyr: $ y != r $) (hyt: $ y != t $) (hyb: $ y != b $) (hyc: $ y != c $)
 (hyp: $ y != p $) (hyx: $ y != x $)
 (heu: $ sqEnvAvoid E n u $) (hey: $ sqEnvAvoid E n y $) (hpu: $ p != u $)
 (ha0: $ 0 < a $) (hxa: $ x < a $) (hp0: $ p != 0 $)
 (hpr: $ p != r $) (hpt: $ p != t $) (hpb: $ p != b $) (hpc: $ p != c $) (hpx: $ p != x $)
 (hep: $ sqEnvAvoid E n p $)
 (hpA1: $ p != suc a $) (hpA2: $ p != suc (suc a) $) (hKA2: $ K != suc (suc a) $)
 (hx0: $ x != 0 $) (hxr: $ x != r $) (hxt: $ x != t $) (hxb: $ x != b $) (hxc: $ x != c $)
 (hxu: $ x != u $) (hex: $ sqEnvAvoid E n x $)
 (hry: $ r < y $) (hby: $ b < y $) (ht_y: $ t < y $) (hK0: $ K != 0 $)
 (hc0: $ c != 0 $) (hcr: $ c != r $) (hct: $ c != t $) (hcb: $ c != b $):
 $ k218QProvable (kImp (sfK0QSepSeedFacts r t b y) (kImp (kExists c (sfK0QSepSeedClauses E r t b c u y K theta)) (kExists c (sfK0QSepSeedProfile E t b c x K theta)))) $;
