import "source_k0_collection_profile.mm0";

import "quotation_substitution.mm0";

import "quotation_binders_absent.mm0";

import "k218_role_substitution.mm0";

import "k218q_alpha.mm0";

theorem sfK0Collection_backward_substitution (E: set) (n t a c x y z R psi: nat) (hf: $ sfBound (suc (suc n)) psi $)
 (hy0: $ y != 0 $) (hz0: $ z != 0 $) (hyR: $ y < R $) (hzR: $ z < R $)
 (hyt: $ y != t $) (hya: $ y != a $) (hyc: $ y != c $) (hyx: $ y != x $)
 (hzt: $ z != t $) (hza: $ z != a $) (hzc: $ z != c $) (hzx: $ z != x $)
 (hyz: $ y != z $) (hey: $ sqEnvAvoid E n y $) (hez: $ sqEnvAvoid E n z $):
 $ kSubst (kImp (kImp (kImp (kMem t y) (kImp (kMem y c) kF)) kF) (kImp (kAll x (kImp (kImp (kImp (kImp (kImp (kMem t x) (kImp (kMem x a) kF)) kF) (kImp (sfK0CollectionRel E R y x psi) kF)) kF) kF)) kF)) y z = (kImp (kImp (kImp (kMem t z) (kImp (kMem z c) kF)) kF) (kImp (kAll x (kImp (kImp (kImp (kImp (kImp (kMem t x) (kImp (kMem x a) kF)) kF) (kImp (sfK0CollectionRel E R z x psi) kF)) kF) kF)) kF)) $;

theorem sfK0Collection_backward_alpha (E: set) (n t a c x y z R psi: nat) (hf: $ sfBound (suc (suc n)) psi $)
 (hy0: $ y != 0 $) (hz0: $ z != 0 $) (hyR: $ y < R $) (hzR: $ z < R $)
 (hyt: $ y != t $) (hya: $ y != a $) (hyc: $ y != c $) (hyx: $ y != x $)
 (hzt: $ z != t $) (hza: $ z != a $) (hzc: $ z != c $) (hzx: $ z != x $)
 (hyz: $ y != z $) (hey: $ sqEnvAvoid E n y $) (hez: $ sqEnvAvoid E n z $):
 $ k218QProvable (kImp (kAll y (kImp (kImp (kImp (kMem t y) (kImp (kMem y c) kF)) kF) (kImp (kAll x (kImp (kImp (kImp (kImp (kImp (kMem t x) (kImp (kMem x a) kF)) kF) (kImp (sfK0CollectionRel E R y x psi) kF)) kF) kF)) kF))) (kAll z (kImp (kImp (kImp (kMem t z) (kImp (kMem z c) kF)) kF) (kImp (kAll x (kImp (kImp (kImp (kImp (kImp (kMem t x) (kImp (kMem x a) kF)) kF) (kImp (sfK0CollectionRel E R z x psi) kF)) kF) kF)) kF)))) $;
