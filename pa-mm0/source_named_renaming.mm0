import "quotient_quotation.mm0";
import "source_renaming_laws.mm0";

theorem sfNamedIndex_source_renaming (E R: set) (k d i: nat):
 $ sfNamedIndex E k d (sfRenameIndex R d i) = sfNamedIndex (sfComposeMap E R) k d i $;

def snrSourceRenameClass (E R: set) (k .c .d: nat): set =
$ {c | A. d (sfNamedTemplate E k d (sfRename R d c) = sfNamedTemplate (sfComposeMap E R) k d (c))} $;

theorem snrSourceRename_value {d: nat} (E R: set) (k: nat) (c: nat):
 $ c e. snrSourceRenameClass E R k <-> A. d (sfNamedTemplate E k d (sfRename R d c) = sfNamedTemplate (sfComposeMap E R) k d (c)) $;

theorem sfNamedTemplate_source_renaming (E R: set) (k d c: nat):
 $ sfWf c -> sfNamedTemplate E k d (sfRename R d c) = sfNamedTemplate (sfComposeMap E R) k d (c) $;

def sqrSourceRenameClass (E R: set) (t k .c .d: nat): set =
$ {c | A. d (sqQuote E t k d (sfRename R d c) = sqQuote (sfComposeMap E R) t k d (c))} $;

theorem sqrSourceRename_value {d: nat} (E R: set) (t k: nat) (c: nat):
 $ c e. sqrSourceRenameClass E R t k <-> A. d (sqQuote E t k d (sfRename R d c) = sqQuote (sfComposeMap E R) t k d (c)) $;

theorem sqQuote_source_renaming (E R: set) (t k d c: nat):
 $ sfWf c -> sqQuote E t k d (sfRename R d c) = sqQuote (sfComposeMap E R) t k d (c) $;
