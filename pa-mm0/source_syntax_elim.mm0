import "source_syntax.mm0";

theorem sfWf_imp_iff (a b: nat):
  $ sfWf (sfImp a b) <-> sfWf a /\ sfWf b $;
theorem sfWf_and_iff (a b: nat):
  $ sfWf (sfAnd a b) <-> sfWf a /\ sfWf b $;
theorem sfWf_or_iff (a b: nat):
  $ sfWf (sfOr a b) <-> sfWf a /\ sfWf b $;
theorem sfWf_all_iff (a: nat): $ sfWf (sfAll a) <-> sfWf a $;
theorem sfWf_ex_iff (a: nat): $ sfWf (sfEx a) <-> sfWf a $;

theorem sfWf_tag0 (n: nat): $ sfTag n = 0 -> sfWf n -> n = 0 $;
theorem sfMalformed_tag0 (n: nat): $ n != 0 -> sfTag n = 0 -> ~sfWf n $;

theorem sfMalformed_all_payload (a b: nat): $ b != 0 -> ~sfWf (sfNode 6 a b) $;
theorem sfMalformed_ex_payload (a b: nat): $ b != 0 -> ~sfWf (sfNode 7 a b) $;
