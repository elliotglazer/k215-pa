import "source_l_union_shell_replay.mm0";

import "extracted_ltrans_weak.mm0";

def slUEF0: nat = $ sfMem 0 1 $;

def slUEF1: nat = $ sfMem 0 3 $;

def slUEF2: nat = $ sfMem 1 0 $;

def slUEF3: nat = $ sfAnd slUEF1 slUEF2 $;

def slUEF4: nat = $ sfEx slUEF3 $;

def slUEF5: nat = $ sfAnd sfLDomain slUEF3 $;

def slUEF6: nat = $ sfEx slUEF5 $;

def slUEF7: nat = $ sfImp slUEF0 slUEF4 $;

def slUEF8: nat = $ sfImp slUEF0 slUEF6 $;

def slUEF9: nat = $ sfImp slUEF4 slUEF0 $;

def slUEF10: nat = $ sfImp slUEF6 slUEF0 $;

def slUEF11: nat = $ sfAnd slUEF7 slUEF9 $;

def slUEF12: nat = $ sfAnd slUEF8 slUEF10 $;

def slUEF13: nat = $ sfAll slUEF11 $;

def slUEF14: nat = $ sfImp sfLDomain slUEF12 $;

def slUEF15: nat = $ sfAll slUEF14 $;

def slUEF16: nat = $ sfEx slUEF13 $;

def slUEF17: nat = $ sfAnd sfLDomain slUEF15 $;

def slUEF18: nat = $ sfEx slUEF17 $;

def sfLUnionNextLevel: nat = $ slUFF807 $;

theorem sfLUnionShell_context: $ slUFContext = sfLBackground $;

theorem sfLUnionShell_formula: $ slUFFormula = sfImp sfLStageTrans (sfImp sfLDefUnion (sfImp sfLUnionNextLevel (sfRelativize sfLDomain zfcUnion))) $;

theorem sfLUnionShell_local: $ nsLocal sfLBackground (sfImp sfLStageTrans (sfImp sfLDefUnion (sfImp sfLUnionNextLevel (sfRelativize sfLDomain zfcUnion)))) $;

theorem sfLUnionShell_zfr: $ sfTheoryProvable zfrAxioms (sfImp sfLStageTrans (sfImp sfLDefUnion (sfImp sfLUnionNextLevel (sfRelativize sfLDomain zfcUnion)))) $;

theorem sfLUnion_from_next: $ sfTheoryProvable zfrAxioms sfLUnionNextLevel -> sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcUnion) $;
