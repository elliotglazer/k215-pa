'(! k218QProvable_mp $ (kImp (kImp (kImp a kF) kF) (kImp (kImp a kF) b)) $ $ (kImp a (kImp (kImp (kImp a kF) kF) (kImp (kImp a kF) b))) $ (! k218IDerived110 $ a $ $ b $) (! k218IPropK $ (kImp (kImp (kImp a kF) kF) (kImp (kImp a kF) b)) $ $ a $));

theorem k218IDerived112 (a b: nat): $ k218QProvable (kImp (kImp a (kImp (kImp a kF) kF)) (kImp a (kImp (kImp a kF) b))) $ =
'(! k218QProvable_mp $ (kImp a (kImp (kImp (kImp a kF) kF) (kImp (kImp a kF) b))) $ $ (kImp (kImp a (kImp (kImp a kF) kF)) (kImp a (kImp (kImp a kF) b))) $ (! k218IDerived111 $ a $ $ b $) (! k218IPropS $ a $ $ (kImp (kImp a kF) kF) $ $ (kImp (kImp a kF) b) $));

theorem k218IDerived113 (a b: nat): $ k218QProvable (kImp a (kImp (kImp a kF) b)) $ =
'(! k218QProvable_mp $ (kImp a (kImp (kImp a kF) kF)) $ $ (kImp a (kImp (kImp a kF) b)) $ (! k218IDerived108 $ a $) (! k218IDerived112 $ a $ $ b $));

pub theorem k218IPropB3 (a b: nat):
  $ k218QProvable (kImp a (kImp (kImp a kF) b)) $ =
'(! k218IDerived113 $ a $ $ b $);

pub theorem k218IAnd_left (a b: nat):
  $ k218QProvable (kAnd a b) -> k218QProvable a $ =
'(mpi k218IPropAndLeft k218QProvable_mp);

pub theorem k218IAnd_right (a b: nat):
  $ k218QProvable (kAnd a b) -> k218QProvable b $ =
'(mpi k218IPropAndRight k218QProvable_mp);

pub theorem k218IAnd_intro (a b: nat):
  $ k218QProvable a -> k218QProvable b -> k218QProvable (kAnd a b) $ =
'(syl (com12 k218QProvable_mp) (mpi k218IPropAndIntro k218QProvable_mp));

