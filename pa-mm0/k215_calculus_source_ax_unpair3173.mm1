pub theorem k215UnpairMacro3173 (n a b c: nat): $ k215PReach (k215UnpairAt3173State k215PNum3173 a b n c) (k215UnpairAt3173State k215PNum3181 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
