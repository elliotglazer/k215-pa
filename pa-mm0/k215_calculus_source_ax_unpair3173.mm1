@_ abstract def k215UnpairAt3173Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt3173State k215PNum3173 a b n c) (k215UnpairAt3173State k215PNum3181 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
