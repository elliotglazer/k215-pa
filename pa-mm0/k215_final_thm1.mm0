-- Separation images in L (formerly the open premise hSep).
theorem k215FinalFull_separation: $ sfZFCSeparationImages zfrAxioms sfLDomain $;

-- Every level L_a is in L (formerly the open premise hlv).
theorem k215FinalFull_levels: $ zfcProvable k215BLvl $;

-- T2 of Choice^L (sfLWOChoiceT2_cond, source_l_wellorder_outcond, L03), from the discharged
-- sfLUniversalHierarchy{Exists,Unique}_zfr, sfLNextLevelLaw_zfr (L02 next_bridge) and
-- sfLWellorder{RankLaw,LevelTrans}_zfr (L03 wellorder_final). Input to hChoice inside hF.
theorem k215FinalFull_choiceT2: $ sfTheoryProvable zfrAxioms sfLChoiceT2 $;

theorem k215FinalFull_G1
 (hF: $ sfZFCFixedImages zfrAxioms sfLDomain $):
 $ sfZFCImageFamilies zfrAxioms sfLDomain $;

theorem k215FinalFull_coreL
 (hF: $ sfZFCFixedImages zfrAxioms sfLDomain $):
 $ k215CoreImagesL $;

theorem K215_halts_iff_ZFC_inconsistent_full
 (hF: $ sfZFCFixedImages zfrAxioms sfLDomain $):
 $ k215LiteralHalts <-> zfcInconsistent $;

theorem K215_full_consistency_BB215_nonprovability_full_bridge {b: nat}
 (hF: $ sfZFCFixedImages zfrAxioms sfLDomain $):
 $ (~zfcInconsistent -> A. b ~zfcProvable (bb215ArithmeticSentenceSource b)) ->
   ((~zfcInconsistent <-> ~k215LiteralHalts) /\
    (~k215LiteralHalts <-> A. b ~zfcProvable (bb215ArithmeticSentenceSource b))) $;

-- hF reduced to its four still-open parts: Transitivity^L (sfLTransitivity_weak_zfr) and
-- Power^L (sfLPower_image_zfr, L02-050 PASSED) are discharged here.
theorem k215FinalFull_fixed
 (hPair: $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcPair) $)
 (hUnion: $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcUnion) $)
 (hOmega: $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcOmega) $)
 (hChoice: $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcChoice) $):
 $ sfZFCFixedImages zfrAxioms sfLDomain $;

theorem K215_halts_iff_ZFC_inconsistent_parts
 (hPair: $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcPair) $)
 (hUnion: $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcUnion) $)
 (hOmega: $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcOmega) $)
 (hChoice: $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcChoice) $):
 $ k215LiteralHalts <-> zfcInconsistent $;

theorem K215_full_consistency_BB215_nonprovability_parts_bridge {b: nat}
 (hPair: $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcPair) $)
 (hUnion: $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcUnion) $)
 (hOmega: $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcOmega) $)
 (hChoice: $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcChoice) $):
 $ (~zfcInconsistent -> A. b ~zfcProvable (bb215ArithmeticSentenceSource b)) ->
   ((~zfcInconsistent <-> ~k215LiteralHalts) /\
    (~k215LiteralHalts <-> A. b ~zfcProvable (bb215ArithmeticSentenceSource b))) $;

-- Replacement images in L (uniform definable law, L02's sfLReplacementDefinableLaws_closed).
theorem k215FinalFull_replacement: $ sfZFCReplacementImages zfrAxioms sfLDomain $;

-- hF with every part discharged except hOL = sfLChoiceOrdL (every ordinal is in L, in L03's
-- choice vocabulary; L08's sfLOrdinalsInL_zfr states it in another vocabulary, bridge pending).
