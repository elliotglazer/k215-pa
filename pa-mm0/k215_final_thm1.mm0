-- sfLUnion_zfr, sfLPower_image_zfr, sfLOmega_from_ordinals sfLOrdinalsInL_zfr,
-- k215FinalFull_separation, k215FinalFull_replacement, sfLNonempty_zfr, hierarchy, choiceT2.
theorem k215FinalFull_fixed_ordl
 (hOL: $ sfTheoryProvable zfrAxioms sfLChoiceOrdL $):
 $ sfZFCFixedImages zfrAxioms sfLDomain $;

theorem K215_halts_iff_ZFC_inconsistent_ordl
 (hOL: $ sfTheoryProvable zfrAxioms sfLChoiceOrdL $):
 $ k215LiteralHalts <-> zfcInconsistent $;

theorem K215_full_consistency_BB215_nonprovability_ordl_bridge {b: nat}
 (hOL: $ sfTheoryProvable zfrAxioms sfLChoiceOrdL $):
 $ (~zfcInconsistent -> A. b ~zfcProvable (bb215ArithmeticSentenceSource b)) ->
   ((~zfcInconsistent <-> ~k215LiteralHalts) /\
    (~k215LiteralHalts <-> A. b ~zfcProvable (bb215ArithmeticSentenceSource b))) $;

-- hOL from L08's sfLOrdinalsInL_zfr through L03's vocabulary bridge (source_l_ac_ordl): every
-- fixed image is now discharged, so theorem 1 of final.mm0 holds with no hypotheses.
theorem k215FinalFull_fixed_closed: $ sfZFCFixedImages zfrAxioms sfLDomain $;

theorem K215_halts_iff_ZFC_inconsistent_final:
 $ k215LiteralHalts <-> zfcInconsistent $;

theorem K215_full_consistency_BB215_nonprovability_final_bridge {b: nat}:
 $ (~zfcInconsistent -> A. b ~zfcProvable (bb215ArithmeticSentenceSource b)) ->
   ((~zfcInconsistent <-> ~k215LiteralHalts) /\
    (~k215LiteralHalts <-> A. b ~zfcProvable (bb215ArithmeticSentenceSource b))) $;

-- Hypothesis-free last theorem (keeps check.py's false-final control well formed).
theorem k215FinalFull_native_law:
 $ k215PNativeLaw $;
