theorem k215BinaryUnpairInAt805 (u t w c a b v: nat): $ (k215UnpairAt805State k215PNum805 0 0 w (k215PVector u t w c a b 0 0 v)) = (k215PState k215PNum805 (k215PVector u t w c a b 0 0 v)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector eqid k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryUnpairOutAt805 (u t w c a b v: nat): $ (k215UnpairAt805State k215PNum813 (fst w) (snd w) 0 (k215PVector u t w c a b 0 0 v)) = (k215PState k215PNum813 (k215PVector u t 0 c a b (fst w) (snd w) v)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector eqid k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryUnpairAt805 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum805 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum813 (k215PVector u t 0 c a b (fst w) (snd w) v)) $ =
 '(mpbi (k215PReacheq k215BinaryUnpairInAt805 k215BinaryUnpairOutAt805) k215UnpairMacro805_clean);

theorem k215BinaryRestoreStackAt805 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum813 (k215PVector u t 0 c a b (fst w) (snd w) v)) (k215PState k215PNum816 (k215PVector u t (snd w) c a b (fst w) 0 v)) $ =
 '(k215PReach_intro (eqtr k215Loop813Vector (k215PStateeq2 (k215PVectoreq3 add0))));

theorem k215BinaryPairInAt805 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt816State k215PNum816 a6 a1 a7 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum816 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryPairOutAt805 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt816State k215PNum826 0 0 (a7 + (a6, a1)) (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum826 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryPairAt805 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat):
 $ k215PReach (k215PState k215PNum816 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215PNum826 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ =
 '(mpbi (k215PReacheq k215BinaryPairInAt805 k215BinaryPairOutAt805) k215PairMacro816);

theorem k215BinaryPairCleanAt805 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum816 (k215PVector u t (snd w) c a b (fst w) 0 v)) (k215PState k215PNum826 (k215PVector u 0 (snd w) c a b 0 (fst w, t) v)) $ =
 '(mpbi (k215PReacheq2 (k215PStateeq2 (k215PVectoreq8 add01))) k215BinaryPairAt805);
theorem k215BinaryFourAt805 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum826 (k215PVector u 0 (snd w) c a b 0 (fst w, t) v)) (k215PState k215PNum832 (k215PVector u (4 * (fst w, t)) (snd w) c a b 0 0 v)) $ =
 '(k215PReach_intro (eqtr k215Loop826Vector (k215PStateeq2 (k215PVectoreq2 add0))));

theorem k215BinaryTag0At805 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum832 (k215PVector u (4 * (fst w, t)) (snd w) c a b 0 0 v)) (k215PState k215PNum833 (k215PVector u (suc (4 * (fst w, t))) (snd w) c a b 0 0 v)) $ =
