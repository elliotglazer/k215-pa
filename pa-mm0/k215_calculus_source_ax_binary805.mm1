theorem k215BinaryTagAllAt805 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum832 (k215PVector u (4 * (fst w, t)) (snd w) c a b 0 0 v)) (k215PState k215PNum834 (k215PVector u (kAll (fst w) t) (snd w) c a b 0 0 v)) $ = '(mpbi (k215PReacheq2 (k215PStateeq2 (k215PVectoreq2 (eqcom (eqtr addS (suceq (eqtr addS (suceq add0)))))))) (ax_mp (ax_mp k215PReach_trans k215BinaryTag0At805) k215BinaryTag1At805));

pub theorem k215BinaryConstructor805 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum805 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum834 (k215PVector u (kAll (fst w) t) (snd w) c a b 0 0 v)) $ = '(ax_mp (ax_mp k215PReach_trans k215BinaryUnpairAt805) (ax_mp (ax_mp k215PReach_trans k215BinaryRestoreStackAt805) (ax_mp (ax_mp k215PReach_trans k215BinaryPairCleanAt805) (ax_mp (ax_mp k215PReach_trans k215BinaryFourAt805) k215BinaryTagAllAt805))));

