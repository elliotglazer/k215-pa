import "source_reflection_least_cond_parameters_bounds.mm1";

import "source_formula_equality_transport.mm1";

import "source_theory_local.mm1";

def sfReflectionCondPieceTransport(P:nat):nat = $ sfAll (sfAll (sfAll (sfImp (sfEq 1 0) (sfImp (sfORBinary P 2 1) (sfORBinary P 2 0))))) $;

pub theorem sfReflectionCondEqualityContext_zfr: $ sfTheoryContext zfrAxioms sfFormulaEqualityContext $ = (named '(mpbir sfTheoryContext_cons (ian (ax_mp zfcCoreAxioms_zfr_member zfcCoreRefl_member) (mpbir sfTheoryContext_cons (ian (ax_mp zfcCoreAxioms_zfr_member zfcCoreSym_member) (mpbir sfTheoryContext_cons (ian (ax_mp zfcCoreAxioms_zfr_member zfcCoreTrans_member) (mpbir sfTheoryContext_cons (ian (ax_mp zfcCoreAxioms_zfr_member zfcCoreEqElem_member) sfTheoryContext_nil)))))))));

theorem rctORInst(P d x:nat)(hp:$ sfWf P $): $ sfSubst 0 x (sfORBinary P (suc d) 0) = sfORBinary P d x $ = (named '(eqtr (sfORBinary_subst hp) (sfORBinary_congr hp sfSubstIndex_successor sfSubstIndex_zero)));

pub theorem sfReflectionCondPieceTransport_at_local(P d x y:nat)(hp:$ sfWf P $): $ nsLocal sfFormulaEqualityContext (sfImp (sfEq x y) (sfImp (sfORBinary P d x) (sfORBinary P d y))) $ = (named '(sfRQ_rewrite (nsImp_eq eqid (nsImp_eq (rctORInst hp) (rctORInst hp))) (ax_mp sfFormulaEquality_subst0_local sfORBinary_wf)));

pub theorem sfReflectionCondPieceTransport_at_zfr(P d x y:nat)(hp:$ sfWf P $): $ sfTheoryProvable zfrAxioms (sfImp (sfEq x y) (sfImp (sfORBinary P d x) (sfORBinary P d y))) $ = (named '(ax_mp (sfTheory_local sfReflectionCondEqualityContext_zfr) (sfReflectionCondPieceTransport_at_local hp)));

pub theorem sfReflectionCondPieceTransport_local(P:nat)(hp:$ sfWf P $): $ nsLocal sfFormulaEqualityContext (sfReflectionCondPieceTransport P) $ = (named '(ax_mp (sfLocal_allI sfFormulaEqualityContext_wf) (mpbir (nsLocal_context_eq sfFormulaEqualityContext_shift) (ax_mp (sfLocal_allI sfFormulaEqualityContext_wf) (mpbir (nsLocal_context_eq sfFormulaEqualityContext_shift) (ax_mp (sfLocal_allI sfFormulaEqualityContext_wf) (mpbir (nsLocal_context_eq sfFormulaEqualityContext_shift) (sfReflectionCondPieceTransport_at_local hp))))))));

pub theorem sfReflectionCondPieceTransport_zfr_meta(P:nat)(hp:$ sfWf P $): $ sfTheoryProvable zfrAxioms (sfReflectionCondPieceTransport P) $ = (named '(ax_mp (sfTheory_local sfReflectionCondEqualityContext_zfr) (sfReflectionCondPieceTransport_local hp)));

do { (add-eqd-thm 'sfORBinaryMap 'rctORMapCong) (add-eqd-thm 'sfORBinary 'rctORCong) (add-eqd-thm 'sfReflectionCondPieceTransport 'rctTransportCong) };

theorem rctSafe(P:nat): $ sfTheoryProvable zfrAxioms (sfReflectionCondPieceTransport (if (sfBound 2 P) P sfBot)) $ = (named '(sfReflectionCondPieceTransport_zfr_meta (ax_mp sfBound_wf (lopSafe_bound id))));

pub theorem sfReflectionCondPieceTransport_zfr(P:nat): $ sfBound 2 P -> sfTheoryProvable zfrAxioms (sfReflectionCondPieceTransport P) $ = (named '(mpbid (sfTheoryProvable_congr (rctTransportCongeqd ifpos)) (a1i rctSafe)));
