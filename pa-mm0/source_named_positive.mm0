import "source_named_template.mm0";
def sfNamedPositive (E: set) (k c .d: nat): wff =
$ A. d 0 < sfNamedTemplate E k d c $;
def sfNamedPositiveClass (E: set) (k .c: nat): set =
$ {c | sfNamedPositive E k c} $;
theorem sfNamedTemplate_positive (E: set) (k d c: nat):
  $ sfWf c -> 0 < sfNamedTemplate E k d c $;
theorem sfNamedTemplate_nonzero (E: set) (k d c: nat):
  $ sfWf c -> sfNamedTemplate E k d c != 0 $;
