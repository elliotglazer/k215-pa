import "source_k0_qsep_member_point.mm0";

import "source_k0_qsep_exists_factor.mm0";

theorem sfK0QSepMember_forward (E: set) (n t a c z x M R phi: nat) (hf: $ sfBound (suc n) phi $) (hM0: $ 0 < M $)
 (htM: $ t < M $) (haM: $ a < M $) (hcM: $ c < M $) (hzM: $ z < M $)
 (hxM: $ x < M $) (hMR: $ M < R $) (hx0: $ x != 0 $)
 (htx: $ t != x $) (hax: $ a != x $) (hcx: $ c != x $)
 (he: $ sqEnvBelow E n R $) (hex: $ sqEnvAvoid E n x $) (hem: $ sqEnvAvoid E n M $):
 $ k218QProvable (kImp (kImp (kImp (kAll R (kImp (kMem R t) kF)) (kImp (kAll x (kImp (kMem t x) (kImp (kImp (kImp (kMem x c) (kImp (kImp (kMem x a) (kImp (sqQuote (sqEnvCons x E) t R 0 phi) kF)) kF)) (kImp (kImp (kImp (kImp (kMem x a) (kImp (sqQuote (sqEnvCons x E) t R 0 phi) kF)) kF) (kMem x c)) kF)) kF))) kF)) kF) (kImp (sqMember t z c M) (kAnd (sqMember t z a M) (sqQuote (sqEnvCons z E) t R 0 phi)))) $;

theorem sfK0QSepMember_backward (E: set) (n t a c z x M R phi: nat) (hf: $ sfBound (suc n) phi $) (hM0: $ 0 < M $)
 (htM: $ t < M $) (haM: $ a < M $) (hcM: $ c < M $) (hzM: $ z < M $)
 (hxM: $ x < M $) (hMR: $ M < R $) (hx0: $ x != 0 $)
 (htx: $ t != x $) (hax: $ a != x $) (hcx: $ c != x $)
 (he: $ sqEnvBelow E n R $) (hex: $ sqEnvAvoid E n x $) (hem: $ sqEnvAvoid E n M $):
 $ k218QProvable (kImp (kImp (kImp (kAll R (kImp (kMem R t) kF)) (kImp (kAll x (kImp (kMem t x) (kImp (kImp (kImp (kMem x c) (kImp (kImp (kMem x a) (kImp (sqQuote (sqEnvCons x E) t R 0 phi) kF)) kF)) (kImp (kImp (kImp (kImp (kMem x a) (kImp (sqQuote (sqEnvCons x E) t R 0 phi) kF)) kF) (kMem x c)) kF)) kF))) kF)) kF) (kImp (kAnd (sqMember t z a M) (sqQuote (sqEnvCons z E) t R 0 phi)) (sqMember t z c M))) $;
