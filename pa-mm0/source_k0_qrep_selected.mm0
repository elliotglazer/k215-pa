import "source_k0_qrep_request.mm0";

theorem sfK0QRepSwap_quote (E: set) (n x y t k phi: nat): $ sfBound (suc (suc n)) phi -> sqQuote (sqEnvCons x (sqEnvCons y E)) t k 0 (sfK0QRepSwap phi) = sqQuote (sqEnvCons y (sqEnvCons x E)) t k 0 phi $;

theorem sfK0QRepSelected_named (E: set) (n x y t k phi: nat): $ sfBound (suc (suc n)) phi -> sfNamedTemplate (sqEnvCons x (sqEnvCons y (sqEnvCons t E))) k 0 (sfK0QRepSelectedPredicate phi) = sqQuote (sqEnvCons y (sqEnvCons x E)) t k 0 phi $;
