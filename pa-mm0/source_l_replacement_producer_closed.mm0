import "source_l_replacement_producer_hierarchy.mm0";

import "source_l_universal_hierarchy_exists.mm0";

import "source_l_universal_hierarchy_unique.mm0";

import "source_l_universal_hierarchy_limit.mm0";

import "source_l_compact_hierarchy_stage.mm0";

import "source_l_compact_hierarchy_subset.mm0";

theorem sfLReplacementExtension_zfr:
 $ sfTheoryProvable zfrAxioms sfLReplacementLevelExtension $;

theorem sfLReplacementAbove_zfr(count phi:nat)(hb:$ sfBound count phi $):
 $ sfTheoryProvable zfrAxioms (sfLReplacementAboveLaw count phi) $;

theorem sfLReplacementLevelExists_zfr:
 $ sfTheoryProvable zfrAxioms sfLReplacementLevelExistsLaw $;

theorem sfLReplacementSubset_zfr:
 $ sfTheoryProvable zfrAxioms (sfReflectionHierarchySubsetNormal sfCLHierarchy) $;

theorem sfLReplacementPowerBound_zfr:
 $ sfTheoryProvable zfrAxioms sfLPowerLevelBound $;

theorem sfLReplacementSeed_zfr(n phi:nat)(hb:$ sfBound (suc (suc n)) phi $):
 $ sfTheoryProvable zfrAxioms (sfLReplacementSeedProducerFormula phi) $;

theorem sfLReplacementCommonReflected_zfr(params count phi:nat)(hb:$ sfBound count phi $):
 $ sfTheoryProvable zfrAxioms (sfCLCommonReflectedLaw 0 params count phi) $;

theorem sfLReplacement_schema_from_generic_definable(n phi:nat)
 (hb:$ sfBound (suc (suc n)) phi $)
 (hd:$ nsLocal (sfLReplacementProducerDefinableContext n phi)
  (sfLReplacementImageDefinable (sfLReplacementStartMap 7) sfLDomain (sfLReplacementPsi phi) 0) $):
 $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain (zfcReplacementCode phi n)) $;
