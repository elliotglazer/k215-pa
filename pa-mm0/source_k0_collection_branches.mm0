theorem sfK0Collection_root_selected_denial (E: set) (b t r a c y x R psi: nat) (hy0: $ y != 0 $) (hyr: $ y != r $) (hyt: $ y != t $)
 (hyb: $ y != b $) (hyc: $ y != c $) (hyx: $ y != x $) (hyR: $ y != R $):
 $ k218QProvable (kImp (kAll x (kImp (sfK0QSepNamedSingleton x r R) kF)) (kImp (kImp (kAll x (kImp (kImp (kImp (sfK0QSepNamedSingleton x r R) (kImp (kImp (kImp (kImp (kImp (kMem t x) (kImp (kMem x a) kF)) kF) (kImp (kImp (kImp (kMem t y) (kImp (sfK0CollectionRel E R y x psi) kF)) kF) kF)) kF) kF)) kF) kF)) kF) kF)) $;

theorem sfK0Collection_root_member (E: set) (b t r a c y x R psi: nat) (hy0: $ y != 0 $) (hyr: $ y != r $) (hyt: $ y != t $)
 (hyb: $ y != b $) (hyc: $ y != c $) (hyx: $ y != x $) (hyR: $ y != R $):
 $ k218QProvable (kImp (kImp (kEq r t) kF) (kImp (kAll x (kImp (sfK0QSepNamedSingleton x r R) kF)) (kImp (kImp (kAll y (kImp (kImp (kImp (kMem y c) (kImp (kImp (kImp (kImp (kImp (kEq r r) (kImp (kEq y b) kF)) kF) kF) (kImp (kImp (kImp (kImp (kEq r t) (kImp (kEq y t) kF)) kF) kF) (kImp (kAll x (kImp (kImp (kImp (sfK0QSepNamedSingleton x r R) (kImp (kImp (kImp (kImp (kImp (kMem t x) (kImp (kMem x a) kF)) kF) (kImp (kImp (kImp (kMem t y) (kImp (sfK0CollectionRel E R y x psi) kF)) kF) kF)) kF) kF)) kF) kF)) kF))) kF)) kF) kF)) kF) (kMem b c)))) $;

theorem sfK0Collection_marker_selected_denial (E: set) (b t r a c y x R psi: nat) (hy0: $ y != 0 $) (hyr: $ y != r $) (hyt: $ y != t $)
 (hyb: $ y != b $) (hyc: $ y != c $) (hyx: $ y != x $) (hyR: $ y != R $):
 $ k218QProvable (kImp (kAll x (kImp (kMem x t) kF)) (kImp (kImp (kAll x (kImp (kImp (kImp (sfK0QSepNamedSingleton x t R) (kImp (kImp (kImp (kImp (kImp (kMem t x) (kImp (kMem x a) kF)) kF) (kImp (kImp (kImp (kMem t y) (kImp (sfK0CollectionRel E R y x psi) kF)) kF) kF)) kF) kF)) kF) kF)) kF) kF)) $;

theorem sfK0Collection_marker_member (E: set) (b t r a c y x R psi: nat) (hy0: $ y != 0 $) (hyr: $ y != r $) (hyt: $ y != t $)
 (hyb: $ y != b $) (hyc: $ y != c $) (hyx: $ y != x $) (hyR: $ y != R $):
 $ k218QProvable (kImp (kImp (kEq t r) kF) (kImp (kAll x (kImp (kMem x t) kF)) (kImp (kImp (kAll y (kImp (kImp (kImp (kMem y c) (kImp (kImp (kImp (kImp (kImp (kEq t r) (kImp (kEq y b) kF)) kF) kF) (kImp (kImp (kImp (kImp (kEq t t) (kImp (kEq y t) kF)) kF) kF) (kImp (kAll x (kImp (kImp (kImp (sfK0QSepNamedSingleton x t R) (kImp (kImp (kImp (kImp (kImp (kMem t x) (kImp (kMem x a) kF)) kF) (kImp (kImp (kImp (kMem t y) (kImp (sfK0CollectionRel E R y x psi) kF)) kF) kF)) kF) kF)) kF) kF)) kF))) kF)) kF) kF)) kF) (kMem t c)))) $;
