import "k218q_quotation_supported_theory.mm0";

def omegaSeparationImages (.phi .n: nat): wff = $ A. phi A. n (sfBound (suc n) phi -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 (zfcSeparationCode phi n))) $;

theorem oscSeparationFormula {m: nat} (phi: nat): $ omegaSeparationImages -> A. m (sfBound (suc m) phi -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 (zfcSeparationCode phi m))) $;

theorem oscSeparationPrefix {m: nat} (phi n: nat): $ (A. m (sfBound (suc m) phi -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 (zfcSeparationCode phi m)))) -> sfBound (suc n) phi -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 (zfcSeparationCode phi n)) $;

theorem oscSeparationAt (phi n: nat): $ omegaSeparationImages -> sfBound (suc n) phi -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 (zfcSeparationCode phi n)) $;

def omegaReplacementImages (.phi .n: nat): wff = $ A. phi A. n (sfBound (suc (suc n)) phi -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 (zfcReplacementCode phi n))) $;

theorem oscReplacementFormula {m: nat} (phi: nat): $ omegaReplacementImages -> A. m (sfBound (suc (suc m)) phi -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 (zfcReplacementCode phi m))) $;

theorem oscReplacementPrefix {m: nat} (phi n: nat): $ (A. m (sfBound (suc (suc m)) phi -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 (zfcReplacementCode phi m)))) -> sfBound (suc (suc n)) phi -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 (zfcReplacementCode phi n)) $;

theorem oscReplacementAt (phi n: nat): $ omegaReplacementImages -> sfBound (suc (suc n)) phi -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 (zfcReplacementCode phi n)) $;
