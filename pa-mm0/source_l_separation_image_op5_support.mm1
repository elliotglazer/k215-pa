import "source_l_separation_image_op5_profile.mm1";

pub theorem sfLSeparationOp5Extensions_wf(s:nat):
 $ sfWf (sfLSeparationOp5Extensions s) $ =
 '(ax_mp sfWf_all (ax_mp sfWf_ex sfPieceRepExtension_wf));
pub theorem sfLSeparationOp5Extensions_rename(T:set)(s:nat):
 $ sfRename T 0 (sfLSeparationOp5Extensions s) = sfLSeparationOp5Extensions (T @ s) $ =
 '(eqtr sfRename_sfAll (nsAll_eq (eqtr sfRename_sfEx (nsEx_eq
   (eqtr sfPieceRepExtension_rename (sfPieceRepExtension_eq
     (eqtr sfRenameIndex_lift (suceq (eqtr sfRenameIndex_lift (suceq sfRenameIndex_zero))))
     (ax_mp sfRenameIndex_bound (mpbi ltsuc lt01S))
     (ax_mp sfRenameIndex_bound lt01S)))))));
pub theorem sfLSeparationOp5Extensions_eq(s t:nat)(he:$ s = t $):
 $ sfLSeparationOp5Extensions s = sfLSeparationOp5Extensions t $ =
 '(nsAll_eq (nsEx_eq (sfPieceRepExtension_eq (suceq (suceq he)) eqid eqid)));
pub theorem sfLSeparationOp5Extensions_subst(d t s:nat):
 $ sfSubst d t (sfLSeparationOp5Extensions s) = sfLSeparationOp5Extensions (sfSubstIndex d t s) $ =
 '(eqtr (ax_mp sfSubst_as_map sfLSeparationOp5Extensions_wf)
   (eqtr sfLSeparationOp5Extensions_rename (sfLSeparationOp5Extensions_eq sfSubstDepthMap_value)));
pub theorem sfLSeparationOp5Extensions_instance(G s:nat)
 (he:$ nsLocal G (sfAll (sfLSeparationOp5Extensions 0)) $):
 $ nsLocal G (sfLSeparationOp5Extensions s) $ =
 '(sfRQ_rewrite (eqtr sfLSeparationOp5Extensions_subst (sfLSeparationOp5Extensions_eq sfSubstIndex_zero))
   (ax_mp nsLocal_AllE he));
pub theorem sfLSeparationOp5_profile_from_total(T:set)(G n phi R A s Y:nat)
 (hb:$ sfBound (suc n) phi $)
 (hr:$ nsLocal G (sfPieceDefinableNamed (suc n) phi R A) $)
 (hm:$ sfReflectionDnMembers T G A n $)
 (hs:$ nsLocal G (sfPieceEnv T n s) $)
 (ho:$ nsLocal G (sfLSeparationOp5 R s A Y) $)
 (he:$ nsLocal G (sfAll (sfLSeparationOp5Extensions 0)) $):
 $ nsLocal G (sfPieceDefinableProfile T phi A Y) $ =
 '(sfLSeparationOp5_to_definable_profile hb hr hm hs ho (sfLSeparationOp5Extensions_instance he));
