theorem k215UnpairAt4529AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt4529State k215PNum4529 0 b (suc n) c) (k215UnpairAt4529State k215PNum4529 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
