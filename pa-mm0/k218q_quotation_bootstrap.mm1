 $ A. S A. k (sqEnvironmentSafe S n 1 k ->
   k218SQ_sqDomainSupport kQuotientContext S 1 ->
   k218IHypProvable kQuotientContext (sqQuote (sqNumericEnvironment S) 1 k 0 a)) $;

pub theorem k218SQ_sqBootstrapConsequence_at (n a S k: nat):
 $ k218SQ_sqBootstrapConsequence n a -> sqEnvironmentSafe S n 1 k ->
   k218SQ_sqDomainSupport kQuotientContext S 1 ->
   k218IHypProvable kQuotientContext (sqQuote (sqNumericEnvironment S) 1 k 0 a) $ =
(named '(!! ealie R @ !! ealde l @ bi1d ,eqtac));

pub theorem k218SQ_sqBootstrapConsequence_default (n a: nat):
 $ k218SQ_sqBootstrapConsequence n a ->
   k218IHypProvable kQuotientContext (sqQuote (sqNumericEnvironment (repeat 3 n)) 1 4 0 a) $ =
'(mpi k218SQ_sqBootstrap_default_domain (mpi sqBootstrap_default_safe k218SQ_sqBootstrapConsequence_at));

pub theorem k218SQ_sqBootstrapConsequence_closed (n a: nat):
 $ sfBound 0 a -> k218SQ_sqBootstrapConsequence n a ->
   k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 a) $ =
'(exp @ mpbid
  (k218IHypProvableeq2d (syl sqQuote_environment_closed anl))
  (syl k218SQ_sqBootstrapConsequence_default anr));

pub theorem k218SQ_sqBootstrapConsequence_exists_closed {n: nat} (a: nat):
 $ sfBound 0 a -> (E. n k218SQ_sqBootstrapConsequence n a) ->
   k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 a) $ =
(named '(eexd k218SQ_sqBootstrapConsequence_closed));

pub theorem k218SQ_sqBootstrapConsequence_false (n: nat):
 $ k218SQ_sqBootstrapConsequence n sfBot -> k218IHypProvable kQuotientContext kF $ =
