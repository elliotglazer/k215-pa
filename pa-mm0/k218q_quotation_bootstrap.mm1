theorem k218SQ_sqBS_repeat_domain_step (H t a n: nat):
 $ (k218IHypProvable H (kMem t a) -> k218SQ_sqDomainSupport H (repeat a n) t) ->
   k218IHypProvable H (kMem t a) -> k218SQ_sqDomainSupport H (repeat a (suc n)) t $ =
'(exp @ mpbird (a1i (k218SQ_sqDomainSupporteq2 repeatS)) @
  mpd (mpd anr anl) (syl k218SQ_sqDomainSupport_cons anr));

pub theorem k218SQ_sqBootstrap_repeat_domain (H t a n: nat):
 $ k218IHypProvable H (kMem t a) -> k218SQ_sqDomainSupport H (repeat a n) t $ =
(named @ induct '(ind) 'n
 '(a1i (mpbir (k218SQ_sqDomainSupporteq2 repeat0) k218SQ_sqDomainSupport_nil))
 'k218SQ_sqBS_repeat_domain_step);

theorem k218SQ_sqBS_default_member: $ k218IHypProvable kQuotientContext (kMem 1 3) $ =
'(ax_mp k218IHypProvable_assumption sfContext_member_head);

pub theorem k218SQ_sqBootstrap_default_domain (n: nat):
 $ k218SQ_sqDomainSupport kQuotientContext (repeat 3 n) 1 $ =
'(ax_mp k218SQ_sqBootstrap_repeat_domain k218SQ_sqBS_default_member);

pub theorem k218SQ_sqBootstrap_default_source (n: nat):
 $ k218SQ_sqSourceSupport kQuotientContext (repeat 3 n) 1 4 0 $ = 'k218SQ_sqSourceSupport_nil;

