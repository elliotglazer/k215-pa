import "source_l_replacement_range_kernel.mm0";
import "source_hypothesis_replacement.mm0";

def lrepSeedF0(c q:nat):nat = $ sfImp (sfDomainAt sfLDomain 0) (sfMem 0 1) $;

def lrepSeedF1(c q:nat):nat = $ sfImp (sfMem 0 3) (lrepSeedF0 c q) $;

def lrepSeedF2(c q:nat):nat = $ sfAll (lrepSeedF1 c q) $;

def lrepSeedF3(c q:nat):nat = $ sfAnd q (lrepSeedF2 c q) $;

def lrepSeedF4(c q:nat):nat = $ sfEx (lrepSeedF3 c q) $;

def lrepSeedF5(c q:nat):nat = $ sfEx (lrepSeedF4 c q) $;

def lrepSeedF6(c q:nat):nat = $ sfAnd (sfDomainAt sfLDomain 0) (sfDomainAt sfLDomain 1) $;

def lrepSeedF7(c q:nat):nat = $ sfAnd (lrepSeedF6 c q) c $;

def lrepSeedF8(c q:nat):nat = $ sfAnd (sfMem 0 3) (lrepSeedF7 c q) $;

def lrepSeedF9(c q:nat):nat = $ sfEx (lrepSeedF8 c q) $;

def lrepSeedF10(c q:nat):nat = $ sfImp (sfMem 0 1) (lrepSeedF9 c q) $;

def lrepSeedF11(c q:nat):nat = $ sfImp (lrepSeedF9 c q) (sfMem 0 1) $;

def lrepSeedF12(c q:nat):nat = $ sfAnd (lrepSeedF10 c q) (lrepSeedF11 c q) $;

def lrepSeedF13(c q:nat):nat = $ sfAll (lrepSeedF12 c q) $;

def lrepSeedG14(c q:nat):nat = $ (lrepSeedF13 c q) : 0 $;

def lrepSeedG15(c q:nat):nat = $ (lrepSeedF5 c q) : (lrepSeedG14 c q) $;

def lrepSeedG16(c q:nat):nat = $ sfContextShift (lrepSeedG15 c q) $;

def lrepSeedG17(c q:nat):nat = $ (lrepSeedF4 c q) : (lrepSeedG16 c q) $;

def lrepSeedG18(c q:nat):nat = $ sfContextShift (lrepSeedG17 c q) $;

def lrepSeedG19(c q:nat):nat = $ (lrepSeedF3 c q) : (lrepSeedG18 c q) $;

def lrepSeedF20(c q:nat):nat = $ sfShift 0 (lrepSeedF13 c q) $;

def lrepSeedF21(c q:nat):nat = $ sfShift 2 c $;

def lrepSeedF22(c q:nat):nat = $ sfAnd (lrepSeedF6 c q) (lrepSeedF21 c q) $;

def lrepSeedF23(c q:nat):nat = $ sfAnd (sfMem 0 4) (lrepSeedF22 c q) $;

def lrepSeedF24(c q:nat):nat = $ sfEx (lrepSeedF23 c q) $;

def lrepSeedF25(c q:nat):nat = $ sfImp (sfMem 0 2) (lrepSeedF24 c q) $;

def lrepSeedF26(c q:nat):nat = $ sfImp (lrepSeedF24 c q) (sfMem 0 2) $;

def lrepSeedF27(c q:nat):nat = $ sfAnd (lrepSeedF25 c q) (lrepSeedF26 c q) $;

def lrepSeedF28(c q:nat):nat = $ sfAll (lrepSeedF27 c q) $;

def lrepSeedF29(c q:nat):nat = $ sfShift 0 (lrepSeedF28 c q) $;

def lrepSeedF30(c q:nat):nat = $ sfShift 2 (lrepSeedF21 c q) $;

def lrepSeedF31(c q:nat):nat = $ sfAnd (lrepSeedF6 c q) (lrepSeedF30 c q) $;

def lrepSeedF32(c q:nat):nat = $ sfAnd (sfMem 0 5) (lrepSeedF31 c q) $;

def lrepSeedF33(c q:nat):nat = $ sfEx (lrepSeedF32 c q) $;

def lrepSeedF34(c q:nat):nat = $ sfImp (sfMem 0 3) (lrepSeedF33 c q) $;

def lrepSeedF35(c q:nat):nat = $ sfImp (lrepSeedF33 c q) (sfMem 0 3) $;

def lrepSeedF36(c q:nat):nat = $ sfAnd (lrepSeedF34 c q) (lrepSeedF35 c q) $;

def lrepSeedF37(c q:nat):nat = $ sfAll (lrepSeedF36 c q) $;

def lrepSeedG38(c q:nat):nat = $ sfContextShift (lrepSeedG19 c q) $;

def lrepSeedG39(c q:nat):nat = $ (sfDomainAt sfLDomain 0) : (lrepSeedG38 c q) $;

def lrepSeedF40(c q:nat):nat = $ sfAnd (sfMem 0 5) (lrepSeedF30 c q) $;

def lrepSeedF41(c q:nat):nat = $ sfAnd (sfDomainAt sfLDomain 0) (lrepSeedF40 c q) $;

def lrepSeedF42(c q:nat):nat = $ sfEx (lrepSeedF41 c q) $;

def lrepSeedG43(c q:nat):nat = $ (lrepSeedF42 c q) : (lrepSeedG39 c q) $;

def lrepSeedG44(c q:nat):nat = $ sfContextShift (lrepSeedG43 c q) $;

def lrepSeedG45(c q:nat):nat = $ (lrepSeedF41 c q) : (lrepSeedG44 c q) $;

def lrepSeedF46(c q:nat):nat = $ sfShift 0 (sfDomainAt sfLDomain 0) $;

def lrepSeedF47(c q:nat):nat = $ sfShift 1 (lrepSeedF32 c q) $;

def lrepSeedF48(c q:nat):nat = $ sfEx (lrepSeedF47 c q) $;

def lrepSeedF49(c q:nat):nat = $ sfShift 0 (lrepSeedF33 c q) $;

def lrepSeedF50(c q:nat):nat = $ sfShift 0 (lrepSeedF36 c q) $;

def lrepSeedF51(c q:nat):nat = $ sfShift 0 (sfMem 0 3) $;

def lrepSeedF52(c q:nat):nat = $ sfImp (lrepSeedF51 c q) (lrepSeedF49 c q) $;

def lrepSeedF53(c q:nat):nat = $ sfImp (lrepSeedF49 c q) (lrepSeedF51 c q) $;

def lrepSeedF54(c q:nat):nat = $ sfAnd (lrepSeedF52 c q) (lrepSeedF53 c q) $;

def lrepSeedF55(c q:nat):nat = $ sfImp (lrepSeedF42 c q) (sfMem 0 1) $;

def lrepSeedF56(c q:nat):nat = $ sfImp (sfDomainAt sfLDomain 0) (lrepSeedF55 c q) $;

def lrepSeedF57(c q:nat):nat = $ sfAll (lrepSeedF56 c q) $;

def lrepSeedF58(c q:nat):nat = $ sfAnd q (lrepSeedF57 c q) $;

def lrepSeedF59(c q:nat):nat = $ sfShift 1 (lrepSeedF58 c q) $;

def lrepSeedF60(c q:nat):nat = $ sfEx (lrepSeedF59 c q) $;

def lrepSeedF61(c q:nat):nat = $ sfEx (lrepSeedF58 c q) $;

def lrepSeedF62(c q:nat):nat = $ sfShift 0 (lrepSeedF61 c q) $;

def lrepSeedF63(c q:nat):nat = $ sfShift 1 (lrepSeedF61 c q) $;

def lrepSeedF64(c q:nat):nat = $ sfEx (lrepSeedF63 c q) $;

def lrepSeedF65(c q:nat):nat = $ sfEx (lrepSeedF61 c q) $;

def lrepSeedF66(c q:nat):nat = $ sfShift 0 (lrepSeedF65 c q) $;

def lrepSeedF67(c q:nat):nat = $ sfImp (lrepSeedF5 c q) (lrepSeedF65 c q) $;

def lrepSeedF68(c q:nat):nat = $ sfImp (lrepSeedF13 c q) (lrepSeedF67 c q) $;

def sfLReplacementAmbientBase(c q:nat):nat = $ (lrepSeedF13 c q) $;

def sfLReplacementSeedBound(c q:nat):nat = $ (lrepSeedF5 c q) $;

def sfLReplacementSeedRange(c q:nat):nat = $ (lrepSeedF65 c q) $;

theorem sfLReplacement_seed_range_pure(c q:nat)(hc:$ sfWf c $)(hq:$ sfWf q $):
 $ nsLocal 0 (sfImp (sfLReplacementAmbientBase c q)
   (sfImp (sfLReplacementSeedBound c q) (sfLReplacementSeedRange c q))) $;
