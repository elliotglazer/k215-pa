import "source_reflection_transfer_tv_reflection.mm1";

def sfTVReflectionContext(level:nat):nat = $ zfcRefl : (sfReflectionPHProducerContext level) $;

pub theorem sfTVReflectionContext_closed(level:nat)(hl:$ sfBound 2 level $): $ sfTheoryContext sfClosedFormulaClass (sfTVReflectionContext level) $ = (named '(mpbir sfTheoryContext_cons (ian (mpbir sfClosedFormulaClass_value (mpbir sfBound_sfAll (mpbir sfBound_sfEq (ian d0lt1 d0lt1)))) (sfTVPHProducerContext_closed hl))));

pub theorem sfTVReflection_from_profile_local(n c:nat)(hb:$ sfBound n c $): $ nsLocal (sfTVReflectionContext sfLUniversalHierarchyRelation) (sfImp (sfReflectionLimitProfile sfLUniversalHierarchyRelation (sfTVCanonicalPiece n c)) (sfCLReflection sfLDomain n c 0)) $ = (named '(sfTV_reflection_from_profile (sfTVReflectionContext_closed sfLUniversalHierarchyRelation_bound) hb (ax_mp (ax_mp nsLocal_hyp (ax_mp (ax_mp sfTheoryContext_wf ssid) (sfTVReflectionContext_closed sfLUniversalHierarchyRelation_bound))) sfContext_member_head) sfContextSub_cons));

pub theorem sfTVReflectionContext_zfr(level:nat)(hl:$ sfBound 2 level $)(hE:$ sfTheoryProvable zfrAxioms (sfReflectionCondLevelExists level) $)(hS:$ sfTheoryProvable zfrAxioms (sfReflectionHierarchySubsetNormal level) $)(hC:$ sfTheoryProvable zfrAxioms (sfReflectionLimitCoverageLaw level) $): $ sfTheoryContext (sfTheoryProofClass zfrAxioms) (sfTVReflectionContext level) $ = (named '(mpbir sfTheoryContext_cons (ian (mpbir sfTheoryProofClass_value (ax_mp (ax_mp sfTheoryAxiom_provable_closed zfrAxioms_closed) zfrRefl_member)) (mpbir sfTheoryContext_cons (ian (mpbir sfTheoryProofClass_value hS) (mpbir sfTheoryContext_cons (ian (mpbir sfTheoryProofClass_value sfReflectionOrdinalSubsetCompare_zfr) (mpbir sfTheoryContext_cons (ian (mpbir sfTheoryProofClass_value hE) (mpbir sfTheoryContext_cons (ian (mpbir sfTheoryProofClass_value hC) sfTheoryContext_nil)))))))))));

pub theorem sfTVReflection_from_profile_zfr(n c:nat)(hb:$ sfBound n c $)(hE:$ sfTheoryProvable zfrAxioms (sfReflectionCondLevelExists sfLUniversalHierarchyRelation) $)(hS:$ sfTheoryProvable zfrAxioms (sfReflectionHierarchySubsetNormal sfLUniversalHierarchyRelation) $)(hC:$ sfTheoryProvable zfrAxioms (sfReflectionLimitCoverageLaw sfLUniversalHierarchyRelation) $): $ sfTheoryProvable zfrAxioms (sfImp (sfReflectionLimitProfile sfLUniversalHierarchyRelation (sfTVCanonicalPiece n c)) (sfCLReflection sfLDomain n c 0)) $ = (named '(ax_mp (ax_mp (sfTheory_lemma_context zfrAxioms_closed) (sfTVReflectionContext_zfr sfLUniversalHierarchyRelation_bound hE hS hC)) (sfTVReflection_from_profile_local hb)));
