import "pa_source_interpretation_term_evaluation_base.mm0";

def paTermSourceEvaluationCorrect (.n .m .d .a .t: nat): wff = $ A. n A. m A. d A. a A. t (paTermBound n a -> paTermBound m t -> zfcProvable (paTermSourceEvaluationBody d a t)) $;

theorem paTermSourceEvaluationCorrect_at (n m d a t: nat): $ paTermSourceEvaluationCorrect -> paTermBound n a -> paTermBound m t -> zfcProvable (paTermSourceEvaluationBody d a t) $;
