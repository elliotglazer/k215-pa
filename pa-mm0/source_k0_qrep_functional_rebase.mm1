import "source_k0_qrep_profile.mm1";

import "source_k0_qrep_member_rebase.mm1";

theorem qrepFunctional_relation_d (G: wff) (E: set) (n t u v R S phi: nat) (hf: $ G -> sfBound (suc (suc n)) phi $) (hR: $ G -> 0 < R $) (hS: $ G -> 0 < S $) (htR: $ G -> t < R $) (htS: $ G -> t < S $) (huR: $ G -> u < R $) (huS: $ G -> u < S $) (hvR: $ G -> v < R $) (hvS: $ G -> v < S $) (heR: $ G -> sqEnvBelow E n R $) (heS: $ G -> sqEnvBelow E n S $):
 $ G -> k218IEquivalent (sfK0QRepRelation E t R u v phi) (sfK0QRepRelation E t S u v phi) $ =
(named '(! k218QM_quote_rebase $ G $ $ (sqEnvCons u (sqEnvCons v E)) $ $ (suc (suc n)) $ $ t $ $ R $ $ S $ $ phi $ hf hR hS htR htS (mpd (mpd heR (syl sqEnvBelow_cons hvR)) (syl sqEnvBelow_cons huR)) (mpd (mpd heS (syl sqEnvBelow_cons hvS)) (syl sqEnvBelow_cons huS))));

pub theorem sfK0QRepFunctional_rebase_d (G: wff) (E: set) (n t a u v w M N R S phi: nat) (hf: $ G -> sfBound (suc (suc n)) phi $) (hM: $ G -> 0 < M $) (hN: $ G -> 0 < N $) (hR: $ G -> 0 < R $) (hS: $ G -> 0 < S $) (htM: $ G -> t < M $) (htN: $ G -> t < N $) (htR: $ G -> t < R $) (htS: $ G -> t < S $) (huM: $ G -> u < M $) (huN: $ G -> u < N $) (huR: $ G -> u < R $) (huS: $ G -> u < S $) (hvM: $ G -> v < M $) (hvN: $ G -> v < N $) (hvR: $ G -> v < R $) (hvS: $ G -> v < S $) (hwM: $ G -> w < M $) (hwN: $ G -> w < N $) (hwR: $ G -> w < R $) (hwS: $ G -> w < S $) (haM: $ G -> a < M $) (haN: $ G -> a < N $) (heR: $ G -> sqEnvBelow E n R $) (heS: $ G -> sqEnvBelow E n S $):
 $ G -> k218IEquivalent (sfK0QRepFunctional E t a u v w M R phi) (sfK0QRepFunctional E t a u v w N S phi) $ =
(named '(syl k218IEquivalent_all (syl k218IEquivalent_imp (iand (syl k218IEquivalent_and (iand (a1i k218IEquivalent_refl) (sfK0QRep_member_rebase hM hN htM htN huM huN haM haN))) (syl k218IEquivalent_all (syl k218IEquivalent_imp (iand (a1i k218IEquivalent_refl) (syl k218IEquivalent_all (syl k218IEquivalent_imp (iand (a1i k218IEquivalent_refl) (syl k218IEquivalent_imp (iand (! qrepFunctional_relation_d $ G $ $ E $ $ n $ $ t $ $ u $ $ v $ $ R $ $ S $ $ phi $ hf hR hS htR htS huR huS hvR hvS heR heS) (syl k218IEquivalent_imp (iand (! qrepFunctional_relation_d $ G $ $ E $ $ n $ $ t $ $ u $ $ w $ $ R $ $ S $ $ phi $ hf hR hS htR htS huR huS hwR hwS heR heS) (k218QM_equal_rebase hM hN htM htN hvM hvN hwM hwN)))))))))))))));

pub theorem sfK0QRepFunctional_rebase (E: set) (n t a u v w M N R S phi: nat) (hf: $ sfBound (suc (suc n)) phi $) (hM: $ 0 < M $) (hN: $ 0 < N $) (hR: $ 0 < R $) (hS: $ 0 < S $) (htM: $ t < M $) (htN: $ t < N $) (htR: $ t < R $) (htS: $ t < S $) (huM: $ u < M $) (huN: $ u < N $) (huR: $ u < R $) (huS: $ u < S $) (hvM: $ v < M $) (hvN: $ v < N $) (hvR: $ v < R $) (hvS: $ v < S $) (hwM: $ w < M $) (hwN: $ w < N $) (hwR: $ w < R $) (hwS: $ w < S $) (haM: $ a < M $) (haN: $ a < N $) (heR: $ sqEnvBelow E n R $) (heS: $ sqEnvBelow E n S $):
 $ k218IEquivalent (sfK0QRepFunctional E t a u v w M R phi) (sfK0QRepFunctional E t a u v w N S phi) $ =
(named '(trud (sfK0QRepFunctional_rebase_d (a1i hf) (a1i hM) (a1i hN) (a1i hR) (a1i hS) (a1i htM) (a1i htN) (a1i htR) (a1i htS) (a1i huM) (a1i huN) (a1i huR) (a1i huS) (a1i hvM) (a1i hvN) (a1i hvR) (a1i hvS) (a1i hwM) (a1i hwN) (a1i hwR) (a1i hwS) (a1i haM) (a1i haN) (a1i heR) (a1i heS))));
