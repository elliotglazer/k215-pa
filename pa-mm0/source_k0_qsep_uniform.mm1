import "source_k0_qsep_carrier_conditional.mm1";

import "source_k0_qsep_safe_prefix.mm1";

import "zfc_axioms.mm1";

import "k218q_bootstrap.mm1";

theorem qsepUniform_base_at (n S k phi: nat):
 $ sfBound (suc n) phi -> sfBound n (sfSeparation (sfRename sfSepMap 0 phi)) -> 2 < k -> sqEnvBelow (sqNumericEnvironment S) n k -> k218QProvable (kImp kEmptyMarker (sqQuote (sqNumericEnvironment S) 1 k 0 (sfSeparation (sfRename sfSepMap 0 phi)))) $ =
'(a1d (! sfK0QSepCarrier_image_curried $ (sqNumericEnvironment S) $ $ n $ $ k $ $ phi $));

theorem qsepUniform_base (n phi: nat):
 $ sfBound (suc n) phi -> sfK0QSepSafe n (sfSeparation (sfRename sfSepMap 0 phi)) $ =
(named '(!! iald S @ !! iald k @ qsepUniform_base_at));

theorem qsepUniform_closed (n phi: nat):
 $ sfBound (suc n) phi -> sfK0QSepSafe 0 (zfcSeparationCode phi n) $ =
'(syl sfK0QSepSafe_closed qsepUniform_base);

theorem qsepUniform_marker_numeric (n phi: nat):
 $ sfBound (suc n) phi -> k218QProvable (kImp kEmptyMarker (sqQuote (sqNumericEnvironment 0) 1 4 0 (zfcSeparationCode phi n))) $ =
'(mpd (a1i k218QM_below_zero) (mpd (a1i (mpbi ltsuc (mpbi ltsuc lt01S))) (mpd zfcSeparationCode_closed (syl sfK0QSepSafe_use qsepUniform_closed))));

pub theorem sfK0QSep_uniform_marker (n phi: nat):
 $ sfBound (suc n) phi -> k218QProvable (kImp kEmptyMarker (sqQuote sqZeroEnvironment 1 4 0 (zfcSeparationCode phi n))) $ =
'(mpbid (k218QProvableeqd (kImpeq2d (syl sqQuote_environment_closed zfcSeparationCode_closed))) qsepUniform_marker_numeric);

theorem qsepUniform_marker_member:
 $ kEmptyMarker IN kQuotientContext $ =
'(mpbir lmemS (orr lmemconsid));

pub theorem sfK0QSep_uniform_context (n phi: nat):
 $ sfBound (suc n) phi -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 (zfcSeparationCode phi n)) $ =
'(syl (ax_mp k218IHypProvable_mp (ax_mp k218IHypProvable_assumption qsepUniform_marker_member)) (syl k218IHypProvable_seed sfK0QSep_uniform_marker));

pub theorem sfK0QSep_all_context {phi n: nat}:
 $ A. phi A. n (sfBound (suc n) phi -> k218IHypProvable kQuotientContext (sqQuote sqZeroEnvironment 1 4 0 (zfcSeparationCode phi n))) $ =
(named '(ax_gen (ax_gen sfK0QSep_uniform_context)));
