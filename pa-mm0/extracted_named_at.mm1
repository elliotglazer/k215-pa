import "extracted_named_conditional.mm1";


theorem exNA_use (F: wff) (p G a n S k H: nat)
 (hp: $ F -> exNamedAt p G a $) (hn: $ F -> p <= n $)
 (hs: $ F -> sqEnvironmentSafe S n 0 k $) (hg: $ F -> exNamedSupport H S k G $):
 $ F -> kHypProvable H (sfNamedTemplate (sqNumericEnvironment S) k 0 a) $ =
'(mpd hg (mpd hs (mpd hn (syl exNamedAt_use hp))));

pub theorem exNamedAt_mono (p q G a: nat)
 (hle: $ p <= q $)
 (hp: $ exNamedAt p G a $)
: $ exNamedAt q G a $ =
(named '(!! ax_gen n @ !! ax_gen S @ !! ax_gen k @ !! ax_gen H @ exp @ exp @ exNA_use (a1i hp) (syl (letr hle) anll) anlr anr));

pub theorem exNamedAt_Ctx (p G a: nat)
 (hm: $ a IN G $)
: $ exNamedAt p G a $ =
(named '(!! ax_gen n @ !! ax_gen S @ !! ax_gen k @ !! ax_gen H @ exp @ exp @ mpd (a1i hm) (syl exNamedSupport_member anr)));

pub theorem exNamedAt_Pc (p G a b: nat)
: $ exNamedAt p G (sfImp (sfImp (sfImp a b) a) a) $ =
(named '(!! ax_gen n @ !! ax_gen S @ !! ax_gen k @ !! ax_gen H @ exp @ exp @ a1i exNamedLocal_peirce));

pub theorem exNamedAt_Wk (p G J a: nat)
 (hsub: $ sfContextSub J G $)
 (hp: $ exNamedAt p J a $)
: $ exNamedAt p G a $ =
(named '(!! ax_gen n @ !! ax_gen S @ !! ax_gen k @ !! ax_gen H @ exp @ exp @ exNA_use (a1i hp) anll anlr (syl (ax_mp exNamedSupport_subset hsub) anr)));

pub theorem exNamedAt_II (p G a b: nat)
 (hp: $ exNamedAt p (a : G) b $)
: $ exNamedAt p G (sfImp a b) $ =
(named '(!! ax_gen n @ !! ax_gen S @ !! ax_gen k @ !! ax_gen H @ exp @ exp @ syl exNamedLocal_impI (exNA_use (a1i hp) anll anlr (syl exNamedSupport_under anr))));

pub theorem exNamedAt_Exp (p G a: nat)
 (hp: $ exNamedAt p G sfBot $)
: $ exNamedAt p G a $ =
(named '(!! ax_gen n @ !! ax_gen S @ !! ax_gen k @ !! ax_gen H @ exp @ exp @ syl exNamedLocal_botE (exNA_use (a1i hp) anll anlr anr)));

pub theorem exNamedAt_CE1 (p G a b: nat)
 (hp: $ exNamedAt p G (sfAnd a b) $)
: $ exNamedAt p G a $ =
(named '(!! ax_gen n @ !! ax_gen S @ !! ax_gen k @ !! ax_gen H @ exp @ exp @ syl exNamedLocal_andE1 (exNA_use (a1i hp) anll anlr anr)));

pub theorem exNamedAt_CE2 (p G a b: nat)
 (hp: $ exNamedAt p G (sfAnd a b) $)
: $ exNamedAt p G b $ =
(named '(!! ax_gen n @ !! ax_gen S @ !! ax_gen k @ !! ax_gen H @ exp @ exp @ syl exNamedLocal_andE2 (exNA_use (a1i hp) anll anlr anr)));

pub theorem exNamedAt_DI1 (p G a b: nat)
 (hp: $ exNamedAt p G a $)
: $ exNamedAt p G (sfOr a b) $ =
(named '(!! ax_gen n @ !! ax_gen S @ !! ax_gen k @ !! ax_gen H @ exp @ exp @ syl exNamedLocal_orI1 (exNA_use (a1i hp) anll anlr anr)));

pub theorem exNamedAt_DI2 (p G a b: nat)
 (hp: $ exNamedAt p G b $)
: $ exNamedAt p G (sfOr a b) $ =
(named '(!! ax_gen n @ !! ax_gen S @ !! ax_gen k @ !! ax_gen H @ exp @ exp @ syl exNamedLocal_orI2 (exNA_use (a1i hp) anll anlr anr)));

pub theorem exNamedAt_IE (p G a b: nat)
 (hp: $ exNamedAt p G a $)
 (hq: $ exNamedAt p G (sfImp a b) $)
: $ exNamedAt p G b $ =
(named '(!! ax_gen n @ !! ax_gen S @ !! ax_gen k @ !! ax_gen H @ exp @ exp @ sylc exNamedLocal_impE (exNA_use (a1i hp) anll anlr anr) (exNA_use (a1i hq) anll anlr anr)));

pub theorem exNamedAt_CI (p G a b: nat)
 (hp: $ exNamedAt p G a $)
 (hq: $ exNamedAt p G b $)
: $ exNamedAt p G (sfAnd a b) $ =
(named '(!! ax_gen n @ !! ax_gen S @ !! ax_gen k @ !! ax_gen H @ exp @ exp @ sylc exNamedLocal_andI (exNA_use (a1i hp) anll anlr anr) (exNA_use (a1i hq) anll anlr anr)));

pub theorem exNamedAt_DE (p G a b c: nat)
 (hp: $ exNamedAt p G (sfOr a b) $)
 (hq: $ exNamedAt p (a : G) c $)
 (hr: $ exNamedAt p (b : G) c $)
: $ exNamedAt p G c $ =
(named '(!! ax_gen n @ !! ax_gen S @ !! ax_gen k @ !! ax_gen H @ exp @ exp @ mpd (exNA_use (a1i hr) anll anlr (syl exNamedSupport_under anr)) (mpd (exNA_use (a1i hq) anll anlr (syl exNamedSupport_under anr)) (syl exNamedLocal_orE (exNA_use (a1i hp) anll anlr anr)))));

pub theorem exNamedAt_AllE (p G i a: nat)
 (ha: $ sfBound (suc p) a $)
 (hi: $ i < p $)
 (hp: $ exNamedAt p G (sfAll a) $)
: $ exNamedAt p G (sfSubst 0 i a) $ =
(named '(!! ax_gen n @ !! ax_gen S @ !! ax_gen k @ !! ax_gen H @ exp @ exp @ exND_allE (syl sqEnvironmentSafe_positive anlr) (syl sqEnvironmentSafe_live_below anlr) (ltletrd (a1i hi) anll) (mpd (syl (bi1 lesuc) anll) (a1i (ax_mp sfBound_mono ha))) (exNA_use (a1i hp) anll anlr anr)));

pub theorem exNamedAt_ExI (p G i a: nat)
 (ha: $ sfBound (suc p) a $)
 (hi: $ i < p $)
 (hp: $ exNamedAt p G (sfSubst 0 i a) $)
: $ exNamedAt p G (sfEx a) $ =
(named '(!! ax_gen n @ !! ax_gen S @ !! ax_gen k @ !! ax_gen H @ exp @ exp @ exND_exI (syl sqEnvironmentSafe_positive anlr) (syl sqEnvironmentSafe_live_below anlr) (ltletrd (a1i hi) anll) (mpd (syl (bi1 lesuc) anll) (a1i (ax_mp sfBound_mono ha))) (exNA_use (a1i hp) anll anlr anr)));
