import "source_k0_qsep_singleton.mm1";

import "k218q_equivalence.mm1";

pub theorem sfK0Collection_singleton_unique (u v p R: nat)
 (hu: $ u < R $) (hv: $ v < R $) (hp: $ p < R $):
 $ k218QProvable (kImp (sfK0QSepNamedSingleton u p R)
     (kImp (sfK0QSepNamedSingleton v p R) (kEq u v))) $ =
'(k218QProvable_mp
  (k218QProvable_mp (sfK0QSepSingleton_select hv hp hu) k218IPropC)
  (k218QProvable_mp k218IPropAndLeft k218IPropB));
