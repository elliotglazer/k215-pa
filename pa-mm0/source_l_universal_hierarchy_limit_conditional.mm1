import "source_l_universal_hierarchy_limit_slim1_replay.mm1";
import "source_l_universal_hierarchy_limit_syntax.mm1";
import "source_l_background.mm1";
import "source_theory_local.mm1";

pub theorem sfLUniversalHierarchyLimit_replay_context: $ srcLUniversalLimitContext = sfLBackground $ = 'eqid;
pub theorem sfLUniversalHierarchyLimit_replay_formula: $ srcLUniversalLimitFormula = sfLUniversalHierarchyLimitConditional $ = 'eqid;
pub theorem sfLUniversalHierarchyLimit_conditional_local: $ nsLocal sfLBackground sfLUniversalHierarchyLimitConditional $ = '(mpbi (nsLocal_context_eq sfLUniversalHierarchyLimit_replay_context) (mpbi (nsLocal_formula_eq sfLUniversalHierarchyLimit_replay_formula) srcLUniversalLimitCertificate));
pub theorem sfLUniversalHierarchyLimit_conditional_zfr: $ sfTheoryProvable zfrAxioms sfLUniversalHierarchyLimitConditional $ = '(ax_mp (sfTheory_local sfLBackground_zfr) sfLUniversalHierarchyLimit_conditional_local);
