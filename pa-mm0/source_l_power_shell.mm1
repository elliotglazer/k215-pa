import "source_l_power_shell_replay.mm1";

import "source_l_power_shell_syntax.mm1";

import "source_l_power_collection_syntax.mm1";

import "source_l_level_member_extension.mm1";

import "source_l_pair_shell.mm1";

import "extracted_ltrans_weak.mm1";

@_ def slPSEqF0: nat = $ sfMem 0 1 $;

@_ def slPSEqF1: nat = $ sfMem 0 3 $;

@_ def slPSEqF2: nat = $ sfImp slPSEqF0 slPSEqF1 $;

@_ def slPSEqF3: nat = $ sfAll slPSEqF2 $;

@_ def slPSEqF4: nat = $ sfImp sfLDomain slPSEqF2 $;

@_ def slPSEqF5: nat = $ sfAll slPSEqF4 $;

@_ def slPSEqF6: nat = $ sfImp slPSEqF0 slPSEqF3 $;

@_ def slPSEqF7: nat = $ sfImp slPSEqF0 slPSEqF5 $;

@_ def slPSEqF8: nat = $ sfImp slPSEqF3 slPSEqF0 $;

@_ def slPSEqF9: nat = $ sfImp slPSEqF5 slPSEqF0 $;

@_ def slPSEqF10: nat = $ sfAnd slPSEqF6 slPSEqF8 $;

@_ def slPSEqF11: nat = $ sfAnd slPSEqF7 slPSEqF9 $;

@_ def slPSEqF12: nat = $ sfAll slPSEqF10 $;

@_ def slPSEqF13: nat = $ sfImp sfLDomain slPSEqF11 $;

@_ def slPSEqF14: nat = $ sfAll slPSEqF13 $;

@_ def slPSEqF15: nat = $ sfEx slPSEqF12 $;

@_ def slPSEqF16: nat = $ sfAnd sfLDomain slPSEqF14 $;

@_ def slPSEqF17: nat = $ sfEx slPSEqF16 $;

theorem slPSEqRel0: $ sfRelativize sfLDomain slPSEqF0 = slPSEqF0 $ = 'sfRelativize_sfMem;

theorem slPSEqRel1: $ sfRelativize sfLDomain slPSEqF0 = slPSEqF0 $ = 'sfRelativize_sfMem;

theorem slPSEqRel2: $ sfRelativize sfLDomain slPSEqF1 = slPSEqF1 $ = 'sfRelativize_sfMem;

theorem slPSEqRel3: $ sfRelativize sfLDomain slPSEqF2 = slPSEqF2 $ = '(eqtr sfRelativize_sfImp (nsImp_eq slPSEqRel1 slPSEqRel2));

theorem slPSEqRel4: $ sfRelativize sfLDomain slPSEqF3 = slPSEqF5 $ = '(eqtr sfRelativize_sfAll (nsAll_eq (nsImp_eq eqid slPSEqRel3)));

theorem slPSEqRel5: $ sfRelativize sfLDomain slPSEqF6 = slPSEqF7 $ = '(eqtr sfRelativize_sfImp (nsImp_eq slPSEqRel0 slPSEqRel4));

theorem slPSEqRel6: $ sfRelativize sfLDomain slPSEqF0 = slPSEqF0 $ = 'sfRelativize_sfMem;

theorem slPSEqRel7: $ sfRelativize sfLDomain slPSEqF1 = slPSEqF1 $ = 'sfRelativize_sfMem;

theorem slPSEqRel8: $ sfRelativize sfLDomain slPSEqF2 = slPSEqF2 $ = '(eqtr sfRelativize_sfImp (nsImp_eq slPSEqRel6 slPSEqRel7));

theorem slPSEqRel9: $ sfRelativize sfLDomain slPSEqF3 = slPSEqF5 $ = '(eqtr sfRelativize_sfAll (nsAll_eq (nsImp_eq eqid slPSEqRel8)));

theorem slPSEqRel10: $ sfRelativize sfLDomain slPSEqF0 = slPSEqF0 $ = 'sfRelativize_sfMem;

theorem slPSEqRel11: $ sfRelativize sfLDomain slPSEqF8 = slPSEqF9 $ = '(eqtr sfRelativize_sfImp (nsImp_eq slPSEqRel9 slPSEqRel10));

theorem slPSEqRel12: $ sfRelativize sfLDomain slPSEqF10 = slPSEqF11 $ = '(eqtr sfRelativize_sfAnd (nsAnd_eq slPSEqRel5 slPSEqRel11));

theorem slPSEqRel13: $ sfRelativize sfLDomain slPSEqF12 = slPSEqF14 $ = '(eqtr sfRelativize_sfAll (nsAll_eq (nsImp_eq eqid slPSEqRel12)));

theorem slPSEqRel14: $ sfRelativize sfLDomain slPSEqF15 = slPSEqF17 $ = '(eqtr sfRelativize_sfEx (nsEx_eq (nsAnd_eq eqid slPSEqRel13)));

theorem slPSEqRel15: $ sfRelativize sfLDomain zfcPower = slPSF3035 $ = '(eqtr sfRelativize_sfAll (nsAll_eq (nsImp_eq eqid slPSEqRel14)));

pub theorem sfLPowerShell_context: $ slPSContext = sfLBackground $ = 'eqid;

pub theorem sfLPowerShell_formula: $ slPSFormula = sfImp sfLTransitivity (sfImp sfLStageTrans (sfImp sfLPowerLevelBound (sfImp sfLLevelExtension (sfImp sfLPairNextLevel (sfImp sfLDefPower (sfRelativize sfLDomain zfcPower)))))) $ = '(nsImp_eq eqid (nsImp_eq eqid (nsImp_eq eqid (nsImp_eq eqid (nsImp_eq eqid (nsImp_eq eqid (eqcom slPSEqRel15)))))));

pub theorem sfLPowerShell_local: $ nsLocal sfLBackground (sfImp sfLTransitivity (sfImp sfLStageTrans (sfImp sfLPowerLevelBound (sfImp sfLLevelExtension (sfImp sfLPairNextLevel (sfImp sfLDefPower (sfRelativize sfLDomain zfcPower))))))) $ = '(mpbi (nsLocal_context_eq sfLPowerShell_context) (mpbi (nsLocal_formula_eq sfLPowerShell_formula) slPSCertificate));

pub theorem sfLPowerShell_zfr: $ sfTheoryProvable zfrAxioms (sfImp sfLTransitivity (sfImp sfLStageTrans (sfImp sfLPowerLevelBound (sfImp sfLLevelExtension (sfImp sfLPairNextLevel (sfImp sfLDefPower (sfRelativize sfLDomain zfcPower))))))) $ = '(ax_mp (sfTheory_local sfLBackground_zfr) sfLPowerShell_local);

pub theorem sfLPower_reduced_zfr: $ sfTheoryProvable zfrAxioms (sfImp sfLPowerLevelBound (sfImp sfLLevelExtension (sfImp sfLPairNextLevel (sfImp sfLDefPower (sfRelativize sfLDomain zfcPower))))) $ = '(ax_mp (ax_mp sfTheoryProvable_mp (ax_mp (ax_mp sfTheoryProvable_mp sfLPowerShell_zfr) sfLTransitivity_weak_zfr)) sfLWeakStageTrans_zfr);
