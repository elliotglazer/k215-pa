import "source_piece_conjunction_proofs.mm0";
import "source_l_common_level_point_rules.mm0";
import "source_l_common_level_ball_use.mm0";

def sfLSeparationImageParameterMap(start .i:nat):set = $ \ i, suc i + start $;

theorem sfLSeparationImageParameterMap_at(start i:nat):
 $ sfLSeparationImageParameterMap start @ i = suc i + start $;

theorem sfLSeparationImageParameterMap_zero:
 $ sfLSeparationImageParameterMap 0 == sfSuccessorMap $;

theorem sfLSeparationImageMembership_target(G start Y n:nat)
 (hp:$ nsLocal G (sfCLMembership start Y (suc n)) $):
 $ nsLocal G (sfMem start Y) $;

theorem sfLSeparationImageMembership_rows(G start Y n:nat)
 (hp:$ nsLocal G (sfCLMembership start Y (suc n)) $):
 $ sfCLRowProofs (sfCLBallMemberRows (sfLSeparationImageParameterMap start) Y) G n $;

theorem sfLSeparationImageReflected_target(G start Y beta n count phi:nat)
 (hp:$ nsLocal G (sfCLReflectedPoint start (suc n) count phi beta Y) $):
 $ nsLocal G (sfMem start Y) $;

theorem sfLSeparationImageReflected_rows(G start Y beta n count phi:nat)
 (hp:$ nsLocal G (sfCLReflectedPoint start (suc n) count phi beta Y) $):
 $ sfCLRowProofs (sfCLBallMemberRows (sfLSeparationImageParameterMap start) Y) G n $;
