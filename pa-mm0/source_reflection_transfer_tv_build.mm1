import "source_reflection_transfer_tv_members.mm1";

@_ def sfTVBuildClass(D N C:nat)(.c .g .y .k:nat):set = $ {c | A. g A. y A. k (sfContextWf g -> k + c <= N -> c <= C -> sfBound k c -> sfReflectionDnMembers sfIdentityMap g y k -> nsLocal g zfcRefl -> sfTVRowInputs D g y N C -> nsLocal g (sfTVRequirements D y c))} $;

theorem sftvbuild_value(D N C c:nat): $ c e. sfTVBuildClass D N C <-> A. g A. y A. k (sfContextWf g -> k + c <= N -> c <= C -> sfBound k c -> sfReflectionDnMembers sfIdentityMap g y k -> nsLocal g zfcRefl -> sfTVRowInputs D g y N C -> nsLocal g (sfTVRequirements D y c)) $ = (named '(elabe ,eqtac));

theorem sftvbuild_each(D N C c G z j:nat): $ (A. g A. y A. k (sfContextWf g -> k + c <= N -> c <= C -> sfBound k c -> sfReflectionDnMembers sfIdentityMap g y k -> nsLocal g zfcRefl -> sfTVRowInputs D g y N C -> nsLocal g (sfTVRequirements D y c))) -> sfContextWf G -> j + c <= N -> c <= C -> sfBound j c -> sfReflectionDnMembers sfIdentityMap G z j -> nsLocal G zfcRefl -> sfTVRowInputs D G z N C -> nsLocal G (sfTVRequirements D z c) $ = (named '(!! ealie g @ !! ealde y @ !! ealde k @ bi1d ,eqtac));

theorem sftvbuild_use(D N C c G z j:nat): $ c e. sfTVBuildClass D N C -> sfContextWf G -> j + c <= N -> c <= C -> sfBound j c -> sfReflectionDnMembers sfIdentityMap G z j -> nsLocal G zfcRefl -> sfTVRowInputs D G z N C -> nsLocal G (sfTVRequirements D z c) $ = (named '(syl sftvbuild_each (bi1 sftvbuild_value)));

theorem sftvbuild_apply(H:wff)(D N C c G y k:nat)(hi:$ H -> c e. sfTVBuildClass D N C $)(hg:$ H -> sfContextWf G $)(hn:$ H -> k + c <= N $)(hc:$ H -> c <= C $)(hb:$ H -> sfBound k c $)(hm:$ H -> sfReflectionDnMembers sfIdentityMap G y k $)(he:$ H -> nsLocal G zfcRefl $)(hr:$ H -> sfTVRowInputs D G y N C $): $ H -> nsLocal G (sfTVRequirements D y c) $ = (named '(mpd hr (mpd he (mpd hm (mpd hb (mpd hc (mpd hn (mpd hg (syl sftvbuild_use hi)))))))));

theorem sftvbuild_refl_closed: $ sfBound 0 zfcRefl $ = (named '(mpbir sfBound_sfAll (mpbir sfBound_sfEq (ian d0lt1 d0lt1))));

theorem sftvbuild_refl_shift: $ sfShift 0 zfcRefl = zfcRefl $ = (named '(ax_mp sfShift_closed_identity sftvbuild_refl_closed));

theorem sftvbuild_refl_open(H:wff)(G:nat)(he:$ H -> nsLocal G zfcRefl $): $ H -> nsLocal G (sfEq 0 0) $ = (named '(syl (bi1 (nsLocal_formula_eq (eqtr sfSubst_sfEq (nsEq_eq sfSubstIndex_zero sfSubstIndex_zero)))) (syl nsLocal_AllE he)));

theorem sftvbuild_atom_bot(H:wff)(D G y:nat)(he:$ H -> nsLocal G zfcRefl $): $ H -> nsLocal G (sfTVRequirements D y sfBot) $ = (named '(syl (bi1 (nsLocal_formula_eq (eqcom sfTVRequirements_bot))) (sftvbuild_refl_open he)));

theorem sftvbuild_atom_Mem(H:wff)(D G y a b:nat)(he:$ H -> nsLocal G zfcRefl $): $ H -> nsLocal G (sfTVRequirements D y (sfMem a b)) $ = (named '(syl (bi1 (nsLocal_formula_eq (eqcom sfTVRequirements_sfMem))) (sftvbuild_refl_open he)));

theorem sftvbuild_atom_Eq(H:wff)(D G y a b:nat)(he:$ H -> nsLocal G zfcRefl $): $ H -> nsLocal G (sfTVRequirements D y (sfEq a b)) $ = (named '(syl (bi1 (nsLocal_formula_eq (eqcom sfTVRequirements_sfEq))) (sftvbuild_refl_open he)));

theorem sftvbuild_binary_And(H:wff)(D N C a b G y k:nat)(hi:$ H -> a e. sfTVBuildClass D N C $)(hj:$ H -> b e. sfTVBuildClass D N C $)(hg:$ H -> sfContextWf G $)(hn:$ H -> k + sfAnd a b <= N $)(hc:$ H -> sfAnd a b <= C $)(hb:$ H -> sfBound k (sfAnd a b) $)(hm:$ H -> sfReflectionDnMembers sfIdentityMap G y k $)(he:$ H -> nsLocal G zfcRefl $)(hr:$ H -> sfTVRowInputs D G y N C $): $ H -> nsLocal G (sfTVRequirements D y (sfAnd a b)) $ = (named '(syl (bi1 (nsLocal_formula_eq (eqcom sfTVRequirements_sfAnd))) (mpd (sftvbuild_apply hj hg (syl (ax_mp letr (mpbi leadd2 (ltlei sfAnd_right_lt))) hn) (syl (ax_mp letr (ltlei sfAnd_right_lt)) hc) (syl anr (mpbid (a1i sfBound_sfAnd) hb)) hm he hr) (syl sfLocal_and (sftvbuild_apply hi hg (syl (ax_mp letr (mpbi leadd2 (ltlei sfAnd_left_lt))) hn) (syl (ax_mp letr (ltlei sfAnd_left_lt)) hc) (syl anl (mpbid (a1i sfBound_sfAnd) hb)) hm he hr)))));

theorem sftvbuild_binary_Or(H:wff)(D N C a b G y k:nat)(hi:$ H -> a e. sfTVBuildClass D N C $)(hj:$ H -> b e. sfTVBuildClass D N C $)(hg:$ H -> sfContextWf G $)(hn:$ H -> k + sfOr a b <= N $)(hc:$ H -> sfOr a b <= C $)(hb:$ H -> sfBound k (sfOr a b) $)(hm:$ H -> sfReflectionDnMembers sfIdentityMap G y k $)(he:$ H -> nsLocal G zfcRefl $)(hr:$ H -> sfTVRowInputs D G y N C $): $ H -> nsLocal G (sfTVRequirements D y (sfOr a b)) $ = (named '(syl (bi1 (nsLocal_formula_eq (eqcom sfTVRequirements_sfOr))) (mpd (sftvbuild_apply hj hg (syl (ax_mp letr (mpbi leadd2 (ltlei sfOr_right_lt))) hn) (syl (ax_mp letr (ltlei sfOr_right_lt)) hc) (syl anr (mpbid (a1i sfBound_sfOr) hb)) hm he hr) (syl sfLocal_and (sftvbuild_apply hi hg (syl (ax_mp letr (mpbi leadd2 (ltlei sfOr_left_lt))) hn) (syl (ax_mp letr (ltlei sfOr_left_lt)) hc) (syl anl (mpbid (a1i sfBound_sfOr) hb)) hm he hr)))));

theorem sftvbuild_binary_Imp(H:wff)(D N C a b G y k:nat)(hi:$ H -> a e. sfTVBuildClass D N C $)(hj:$ H -> b e. sfTVBuildClass D N C $)(hg:$ H -> sfContextWf G $)(hn:$ H -> k + sfImp a b <= N $)(hc:$ H -> sfImp a b <= C $)(hb:$ H -> sfBound k (sfImp a b) $)(hm:$ H -> sfReflectionDnMembers sfIdentityMap G y k $)(he:$ H -> nsLocal G zfcRefl $)(hr:$ H -> sfTVRowInputs D G y N C $): $ H -> nsLocal G (sfTVRequirements D y (sfImp a b)) $ = (named '(syl (bi1 (nsLocal_formula_eq (eqcom sfTVRequirements_sfImp))) (mpd (sftvbuild_apply hj hg (syl (ax_mp letr (mpbi leadd2 (ltlei sfImp_right_lt))) hn) (syl (ax_mp letr (ltlei sfImp_right_lt)) hc) (syl anr (mpbid (a1i sfBound_sfImp) hb)) hm he hr) (syl sfLocal_and (sftvbuild_apply hi hg (syl (ax_mp letr (mpbi leadd2 (ltlei sfImp_left_lt))) hn) (syl (ax_mp letr (ltlei sfImp_left_lt)) hc) (syl anl (mpbid (a1i sfBound_sfImp) hb)) hm he hr)))));

theorem sftvbuild_quantifier_All(H:wff)(D N C a G y k:nat)(hd:$ sfBound 1 D $)(hi:$ H -> a e. sfTVBuildClass D N C $)(hg:$ H -> sfContextWf G $)(hn:$ H -> k + sfAll a <= N $)(hc:$ H -> sfAll a <= C $)(hb:$ H -> sfBound k (sfAll a) $)(hm:$ H -> sfReflectionDnMembers sfIdentityMap G y k $)(he:$ H -> nsLocal G zfcRefl $)(hr:$ H -> sfTVRowInputs D G y N C $): $ H -> nsLocal G (sfTVRequirements D y (sfAll a)) $ = (named '(syl (bi1 (nsLocal_formula_eq (eqcom sfTVRequirements_sfAll))) (mpd (mpd (syl nsLocal_II (sftvbuild_apply hi (a1i (mpbir sfContextWf_cons (ian sfWf_mem sfContextShift_wf))) (syl (ax_mp letr (mpbir (leeq1 addSass) (mpbi leadd2 sfAll_body_lt))) hn) (syl (ax_mp letr (ltlei sfAll_body_lt)) hc) (mpbid (a1i sfBound_sfAll) hb) (sfTVMembers_shift_if hm) (mpd (syl (bi1 (nsLocal_formula_eq sftvbuild_refl_shift)) (syl sfSepLocal_shift he)) (a1i (ax_mp (ax_mp nsLocal_weaken (mpbir sfContextWf_cons (ian sfWf_mem sfContextShift_wf))) sfContextSub_cons))) (sfTVRowInputs_weaken_if (a1i (mpbir sfContextWf_cons (ian sfWf_mem sfContextShift_wf))) (a1i sfContextSub_cons) (sfTVRowInputs_shift_if hd hr)))) (syl sfSepLocal_allI hg)) (syl sfLocal_and (sfTVRowBall_eliminate_if hd (mpbird (a1i sfBound_sfImp) (iand (mpd (mpbid (a1i sfBound_sfAll) hb) (a1i (ax_mp sfRelativize_bound hd))) (a1i sfBound_bot))) hm (syl anr (mpd (iand (iand (syl (ax_mp letr leaddid1) hn) (syl (ax_mp letr (ltlei sfAll_body_lt)) hc)) (mpbid (a1i sfBound_sfAll) hb)) (syl sfTVRowInputs_at hr))))))));

theorem sftvbuild_quantifier_Ex(H:wff)(D N C a G y k:nat)(hd:$ sfBound 1 D $)(hi:$ H -> a e. sfTVBuildClass D N C $)(hg:$ H -> sfContextWf G $)(hn:$ H -> k + sfEx a <= N $)(hc:$ H -> sfEx a <= C $)(hb:$ H -> sfBound k (sfEx a) $)(hm:$ H -> sfReflectionDnMembers sfIdentityMap G y k $)(he:$ H -> nsLocal G zfcRefl $)(hr:$ H -> sfTVRowInputs D G y N C $): $ H -> nsLocal G (sfTVRequirements D y (sfEx a)) $ = (named '(syl (bi1 (nsLocal_formula_eq (eqcom sfTVRequirements_sfEx))) (mpd (mpd (syl nsLocal_II (sftvbuild_apply hi (a1i (mpbir sfContextWf_cons (ian sfWf_mem sfContextShift_wf))) (syl (ax_mp letr (mpbir (leeq1 addSass) (mpbi leadd2 sfEx_body_lt))) hn) (syl (ax_mp letr (ltlei sfEx_body_lt)) hc) (mpbid (a1i sfBound_sfEx) hb) (sfTVMembers_shift_if hm) (mpd (syl (bi1 (nsLocal_formula_eq sftvbuild_refl_shift)) (syl sfSepLocal_shift he)) (a1i (ax_mp (ax_mp nsLocal_weaken (mpbir sfContextWf_cons (ian sfWf_mem sfContextShift_wf))) sfContextSub_cons))) (sfTVRowInputs_weaken_if (a1i (mpbir sfContextWf_cons (ian sfWf_mem sfContextShift_wf))) (a1i sfContextSub_cons) (sfTVRowInputs_shift_if hd hr)))) (syl sfSepLocal_allI hg)) (syl sfLocal_and (sfTVRowBall_eliminate_if hd (mpd (mpbid (a1i sfBound_sfEx) hb) (a1i (ax_mp sfRelativize_bound hd))) hm (syl anl (mpd (iand (iand (syl (ax_mp letr leaddid1) hn) (syl (ax_mp letr (ltlei sfEx_body_lt)) hc)) (mpbid (a1i sfBound_sfEx) hb)) (syl sfTVRowInputs_at hr))))))));

theorem sftvbuild_closed_bot(D N C:nat): $ sfBot e. sfTVBuildClass D N C $ = (named '(mpbir sftvbuild_value @ ax_gen @ ax_gen @ ax_gen @ exp @ exp @ exp @ exp @ exp @ exp @ sftvbuild_atom_bot (syl anr anl)));

theorem sftvbuild_closed_Mem(D N C a b:nat): $ (sfMem a b) e. sfTVBuildClass D N C $ = (named '(mpbir sftvbuild_value @ ax_gen @ ax_gen @ ax_gen @ exp @ exp @ exp @ exp @ exp @ exp @ sftvbuild_atom_Mem (syl anr anl)));

theorem sftvbuild_closed_Eq(D N C a b:nat): $ (sfEq a b) e. sfTVBuildClass D N C $ = (named '(mpbir sftvbuild_value @ ax_gen @ ax_gen @ ax_gen @ exp @ exp @ exp @ exp @ exp @ exp @ sftvbuild_atom_Eq (syl anr anl)));

theorem sftvbuild_closed_atomic(D N C:nat): $ sfAtomicClosed (sfTVBuildClass D N C) $ = (named '(ax_gen @ ax_gen @ ian sftvbuild_closed_Mem sftvbuild_closed_Eq));

theorem sftvbuild_closed_And(D N C a b:nat): $ a e. sfTVBuildClass D N C /\ b e. sfTVBuildClass D N C -> sfAnd a b e. sfTVBuildClass D N C $ = (named '(mpbird (a1i sftvbuild_value) @ !! iald g @ !! iald y @ !! iald k @ exp @ exp @ exp @ exp @ exp @ exp @ exp @ sftvbuild_binary_And (syl anl (syl (syl (syl (syl (syl (syl (syl id anl) anl) anl) anl) anl) anl) anl)) (syl anr (syl (syl (syl (syl (syl (syl (syl id anl) anl) anl) anl) anl) anl) anl)) (syl (syl (syl (syl (syl (syl anr anl) anl) anl) anl) anl) anl) (syl (syl (syl (syl (syl anr anl) anl) anl) anl) anl) (syl (syl (syl (syl anr anl) anl) anl) anl) (syl (syl (syl anr anl) anl) anl) (syl (syl anr anl) anl) (syl anr anl) anr));

theorem sftvbuild_closed_Or(D N C a b:nat): $ a e. sfTVBuildClass D N C /\ b e. sfTVBuildClass D N C -> sfOr a b e. sfTVBuildClass D N C $ = (named '(mpbird (a1i sftvbuild_value) @ !! iald g @ !! iald y @ !! iald k @ exp @ exp @ exp @ exp @ exp @ exp @ exp @ sftvbuild_binary_Or (syl anl (syl (syl (syl (syl (syl (syl (syl id anl) anl) anl) anl) anl) anl) anl)) (syl anr (syl (syl (syl (syl (syl (syl (syl id anl) anl) anl) anl) anl) anl) anl)) (syl (syl (syl (syl (syl (syl anr anl) anl) anl) anl) anl) anl) (syl (syl (syl (syl (syl anr anl) anl) anl) anl) anl) (syl (syl (syl (syl anr anl) anl) anl) anl) (syl (syl (syl anr anl) anl) anl) (syl (syl anr anl) anl) (syl anr anl) anr));

theorem sftvbuild_closed_Imp(D N C a b:nat): $ a e. sfTVBuildClass D N C /\ b e. sfTVBuildClass D N C -> sfImp a b e. sfTVBuildClass D N C $ = (named '(mpbird (a1i sftvbuild_value) @ !! iald g @ !! iald y @ !! iald k @ exp @ exp @ exp @ exp @ exp @ exp @ exp @ sftvbuild_binary_Imp (syl anl (syl (syl (syl (syl (syl (syl (syl id anl) anl) anl) anl) anl) anl) anl)) (syl anr (syl (syl (syl (syl (syl (syl (syl id anl) anl) anl) anl) anl) anl) anl)) (syl (syl (syl (syl (syl (syl anr anl) anl) anl) anl) anl) anl) (syl (syl (syl (syl (syl anr anl) anl) anl) anl) anl) (syl (syl (syl (syl anr anl) anl) anl) anl) (syl (syl (syl anr anl) anl) anl) (syl (syl anr anl) anl) (syl anr anl) anr));

theorem sftvbuild_closed_binary(D N C:nat): $ sfBinaryClosed (sfTVBuildClass D N C) $ = (named '(ax_gen @ ax_gen @ iand (iand sftvbuild_closed_And sftvbuild_closed_Or) sftvbuild_closed_Imp));

theorem sftvbuild_closed_All(D N C a:nat)(hd:$ sfBound 1 D $): $ a e. sfTVBuildClass D N C -> sfAll a e. sfTVBuildClass D N C $ = (named '(mpbird (a1i sftvbuild_value) @ !! iald g @ !! iald y @ !! iald k @ exp @ exp @ exp @ exp @ exp @ exp @ exp @ sftvbuild_quantifier_All hd (syl (syl (syl (syl (syl (syl (syl id anl) anl) anl) anl) anl) anl) anl) (syl (syl (syl (syl (syl (syl anr anl) anl) anl) anl) anl) anl) (syl (syl (syl (syl (syl anr anl) anl) anl) anl) anl) (syl (syl (syl (syl anr anl) anl) anl) anl) (syl (syl (syl anr anl) anl) anl) (syl (syl anr anl) anl) (syl anr anl) anr));

theorem sftvbuild_closed_Ex(D N C a:nat)(hd:$ sfBound 1 D $): $ a e. sfTVBuildClass D N C -> sfEx a e. sfTVBuildClass D N C $ = (named '(mpbird (a1i sftvbuild_value) @ !! iald g @ !! iald y @ !! iald k @ exp @ exp @ exp @ exp @ exp @ exp @ exp @ sftvbuild_quantifier_Ex hd (syl (syl (syl (syl (syl (syl (syl id anl) anl) anl) anl) anl) anl) anl) (syl (syl (syl (syl (syl (syl anr anl) anl) anl) anl) anl) anl) (syl (syl (syl (syl (syl anr anl) anl) anl) anl) anl) (syl (syl (syl (syl anr anl) anl) anl) anl) (syl (syl (syl anr anl) anl) anl) (syl (syl anr anl) anl) (syl anr anl) anr));

theorem sftvbuild_closed_quantifier(D N C:nat)(hd:$ sfBound 1 D $): $ sfQuantifierClosed (sfTVBuildClass D N C) $ = (named '(ax_gen @ iand (sftvbuild_closed_All hd) (sftvbuild_closed_Ex hd)));

theorem sftvbuild_closed(D N C:nat)(hd:$ sfBound 1 D $): $ sfConstructionClosed (sfTVBuildClass D N C) $ = (named '(ian (ian (ian sftvbuild_closed_bot sftvbuild_closed_atomic) sftvbuild_closed_binary) (sftvbuild_closed_quantifier hd)));

pub theorem sfTVRequirements_from_rows(D N C c G y k:nat)(hd:$ sfBound 1 D $)(hg:$ sfContextWf G $)(hn:$ k + c <= N $)(hc:$ c <= C $)(hb:$ sfBound k c $)(hm:$ sfReflectionDnMembers sfIdentityMap G y k $)(he:$ nsLocal G zfcRefl $)(hr:$ sfTVRowInputs D G y N C $): $ nsLocal G (sfTVRequirements D y c) $ = (named '(ax_mp (ax_mp (ax_mp (ax_mp (ax_mp (ax_mp (ax_mp (ax_mp sftvbuild_use (ax_mp (ax_mp sfWf_induction (sftvbuild_closed hd)) (ax_mp sfBound_wf hb))) hg) hn) hc) hb) hm) he) hr));
