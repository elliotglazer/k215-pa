(named '(mpbir kBinderAbsent_kImp (ian (mpbir kBinderAbsent_kImp (ian (mpbir kBinderAbsent_kImp (ian kBinderAbsent_kMem (mpbir kBinderAbsent_kImp (ian (mpbir kBinderAbsent_kImp (ian kBinderAbsent_kEq kBinderAbsent_kF)) (mpbir kBinderAbsent_kImp (ian (mpbir kBinderAbsent_kImp (ian kBinderAbsent_kEq kBinderAbsent_kF)) (mpbir kBinderAbsent_kImp (ian (mpbir kBinderAbsent_kImp (ian kBinderAbsent_kMem (mpbir kBinderAbsent_kImp (ian (mpbir kBinderAbsent_kImp (ian (mpbir kBinderAbsent_kImp (ian kBinderAbsent_kMem (mpbir kBinderAbsent_kImp (ian (mpbir kBinderAbsent_kImp (ian (mpbir kBinderAbsent_kImp (ian kBinderAbsent_kMem (mpbir kBinderAbsent_kImp (ian (ax_mp (sfNamedTemplate_binder_absent htK) (ax_mp sfBound_wf hf)) kBinderAbsent_kF)))) kBinderAbsent_kF)) kBinderAbsent_kF)))) kBinderAbsent_kF)) kBinderAbsent_kF)))) kBinderAbsent_kF)))))))) (mpbir kBinderAbsent_kImp (ian (mpbir kBinderAbsent_kImp (ian (mpbir kBinderAbsent_kImp (ian (mpbir kBinderAbsent_kImp (ian kBinderAbsent_kEq kBinderAbsent_kF)) (mpbir kBinderAbsent_kImp (ian (mpbir kBinderAbsent_kImp (ian kBinderAbsent_kEq kBinderAbsent_kF)) (mpbir kBinderAbsent_kImp (ian (mpbir kBinderAbsent_kImp (ian kBinderAbsent_kMem (mpbir kBinderAbsent_kImp (ian (mpbir kBinderAbsent_kImp (ian (mpbir kBinderAbsent_kImp (ian kBinderAbsent_kMem (mpbir kBinderAbsent_kImp (ian (mpbir kBinderAbsent_kImp (ian (mpbir kBinderAbsent_kImp (ian kBinderAbsent_kMem (mpbir kBinderAbsent_kImp (ian (ax_mp (sfNamedTemplate_binder_absent htK) (ax_mp sfBound_wf hf)) kBinderAbsent_kF)))) kBinderAbsent_kF)) kBinderAbsent_kF)))) kBinderAbsent_kF)) kBinderAbsent_kF)))) kBinderAbsent_kF)))))) kBinderAbsent_kMem)) kBinderAbsent_kF)))) kBinderAbsent_kF)));

pub theorem sfK0QSep_general_profile_specialization (E: set) (n t a b c x K theta: nat)
 (hf: $ sfBound (suc n) theta $) (hz: $ x != 0 $)
 (ht: $ t != x $) (ha: $ a != x $) (hb: $ b != x $) (hc: $ c != x $)
 (he: $ sqEnvAvoid E n x $) (hxK: $ x < K $) (htK: $ t < K $) (htx: $ t < x $):
 $ k218QProvable (kImp (kAll x (sfK0QSepRawProfile t a b c x (sfNamedTemplate (sqEnvCons x E) K 0 theta))) (sfK0QSepRawProfile t a b c t (sfNamedTemplate (sqEnvCons t E) K 0 theta))) $ =
(named '(mpbi (k218QProvableeq (kImpeq2 (sfK0QSep_general_profile_substitution hf hz ht ha hb hc he hxK htK)))
 (ax_mp (ax_mp (ax_mp k218INamed_specialization (ax_mp necom ht))
   (qsepGeneralProfileAbsentX hf htx hxK htK)) (qsepGeneralProfileAbsentT hf htx hxK htK))));

pub theorem sfK0QSep_general_marker_from_profile (E: set) (n t a b c x K theta: nat)
 (hf: $ sfBound (suc n) theta $) (hz: $ x != 0 $)
 (ht: $ t != x $) (ha: $ a != x $) (hb: $ b != x $) (hc: $ c != x $)
 (he: $ sqEnvAvoid E n x $) (hxK: $ x < K $) (htK: $ t < K $) (htx: $ t < x $):
 $ k218QProvable (kImp (kAll x (sfK0QSepRawProfile t a b c x (sfNamedTemplate (sqEnvCons x E) K 0 theta))) (kMem t c)) $ =
'(k218IProvable_syl (sfK0QSep_general_profile_specialization hf hz ht ha hb hc he hxK htK htx) (sfK0QSep_marker_point (ax_mp sfBound_wf hf)));
