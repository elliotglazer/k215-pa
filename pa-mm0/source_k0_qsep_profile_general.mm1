 $ kSubst (sfK0QSepRawProfile t a b c x (sfNamedTemplate (sqEnvCons x E) K 0 theta)) x t = (sfK0QSepRawProfile t a b c t (sfNamedTemplate (sqEnvCons t E) K 0 theta)) $ =
(named '(eqtr kSubst_kImp (kImpeq (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kMem (kMemeq kReplace_hit (ax_mp kReplace_miss hc))) (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kEq (kEqeq kReplace_hit (ax_mp kReplace_miss hb))) (qsSubst_kF hz))) (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kEq (kEqeq kReplace_hit (ax_mp kReplace_miss ht))) (qsSubst_kF hz))) (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kMem (kMemeq kReplace_hit (ax_mp kReplace_miss hb))) (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kMem (kMemeq kReplace_hit (ax_mp kReplace_miss ha))) (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kMem (kMemeq (ax_mp kReplace_miss ht) kReplace_hit)) (eqtr kSubst_kImp (kImpeq (k218RoleHead_substitution hxK hz he hf) (qsSubst_kF hz))))) (qsSubst_kF hz))) (qsSubst_kF hz))))) (qsSubst_kF hz))) (qsSubst_kF hz))))) (qsSubst_kF hz))))))))) (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kEq (kEqeq kReplace_hit (ax_mp kReplace_miss hb))) (qsSubst_kF hz))) (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kEq (kEqeq kReplace_hit (ax_mp kReplace_miss ht))) (qsSubst_kF hz))) (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kMem (kMemeq kReplace_hit (ax_mp kReplace_miss hb))) (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kMem (kMemeq kReplace_hit (ax_mp kReplace_miss ha))) (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kMem (kMemeq (ax_mp kReplace_miss ht) kReplace_hit)) (eqtr kSubst_kImp (kImpeq (k218RoleHead_substitution hxK hz he hf) (qsSubst_kF hz))))) (qsSubst_kF hz))) (qsSubst_kF hz))))) (qsSubst_kF hz))) (qsSubst_kF hz))))) (qsSubst_kF hz))))))) (eqtr kSubst_kMem (kMemeq kReplace_hit (ax_mp kReplace_miss hc))))) (qsSubst_kF hz))))) (qsSubst_kF hz))));

