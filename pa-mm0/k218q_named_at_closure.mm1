pub theorem k218INamedAt_ExE_imp (p G a c: nat):
 $ (sfContextWf G) -> (sqSourceBound p G) -> (sfBound p (sfEx a)) -> (sfBound p c) -> (k218INamedAt p G (sfEx a)) -> (k218INamedAt (suc p) (a : sfContextShift G) (sfShift 0 c)) -> k218INamedAt p G c $ =
(named '(exp @ exp @ exp @ exp @ exp @ !! iald n @ !! iald S @ !! iald k @ !! iald H @ exp @ exp @ exp @ k218INE_ExE_point (syl (syl (syl (syl anr anl) anl) anl) anl) (syl (syl (syl anr anl) anl) anl) (syl (syl anr anl) anl) (syl (bi1 lesuc) (syl (syl anr anl) anl)) (syl (syl (syl (syl (syl (syl (syl anl anl) anl) anl) anl) anl) anl) anl) (mpd (syl (syl (syl (syl (syl (syl (syl anr anl) anl) anl) anl) anl) anl) anl) (syl k218INE_source_bound_mono (syl (syl anr anl) anl))) (mpd (syl (syl anr anl) anl) (syl sfBound_mono (syl (syl (syl (syl (syl (syl anr anl) anl) anl) anl) anl) anl))) (mpd (syl (syl anr anl) anl) (syl sfBound_mono (syl (syl (syl (syl (syl anr anl) anl) anl) anl) anl))) (syl anr anl) anr));
