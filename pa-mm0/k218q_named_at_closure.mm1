pub theorem k218INamedAt_mono_imp (p q G a: nat):
 $ (p <= q) -> (k218INamedAt p G a) -> k218INamedAt q G a $ =
(named '(exp @ !! iald n @ !! iald S @ !! iald k @ !! iald H @ exp @ exp @ exp @ k218INA_use (syl (syl (syl anr anl) anl) anl) (letrd (syl (syl (syl anl anl) anl) anl) (syl (syl anr anl) anl)) (syl anr anl) anr));

