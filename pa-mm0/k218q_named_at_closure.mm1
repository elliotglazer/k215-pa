pub theorem k218INamedAt_AllE_imp (p G i a: nat):
 $ (sfBound (suc p) a) -> (i < p) -> (k218INamedAt p G (sfAll a)) -> k218INamedAt p G (sfSubst 0 i a) $ =
(named '(exp @ exp @ !! iald n @ !! iald S @ !! iald k @ !! iald H @ exp @ exp @ exp @ k218IND_allE (syl sqEnvironmentSafe_positive (syl anr anl)) (syl sqEnvironmentSafe_live_below (syl anr anl)) (ltletrd (syl (syl (syl (syl anr anl) anl) anl) anl) (syl (syl anr anl) anl)) (mpd (syl (bi1 lesuc) (syl (syl anr anl) anl)) (syl sfBound_mono (syl (syl (syl (syl anl anl) anl) anl) anl))) (k218INA_use (syl (syl (syl anr anl) anl) anl) (syl (syl anr anl) anl) (syl anr anl) anr)));

