import "source_piece_pcf_rep_induction_r6.mm1";

@_ def sfPieceRepEmptyUniqueLaw:nat = $ (sfAll (sfAll (sfImp (sfPieceRepEmpty 1) (sfImp (sfPieceRepEmpty 0) (sfEq 1 0))))) $;

theorem pcru_empty_wf:
 $ sfWf sfPieceRepEmptyUniqueLaw $ =
 '(ax_mp sfWf_all (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfPieceRepEmpty_wf) (ax_mp (ax_mp sfWf_imp sfPieceRepEmpty_wf) sfWf_eq))));

theorem pcru_empty_shift:
 $ sfShift 0 sfPieceRepEmptyUniqueLaw = sfPieceRepEmptyUniqueLaw $ =
 '(eqtr (eqcom (ax_mp sfRename_successor pcru_empty_wf)) (eqtr sfRename_sfAll (nsAll_eq (eqtr sfRename_sfAll (nsAll_eq (eqtr sfRename_sfImp (nsImp_eq (eqtr sfPieceRepEmpty_rename (sfPieceRepEmpty_eq (ax_mp sfRenameIndex_bound (mpbi ltsuc lt01S)))) (eqtr sfRename_sfImp (nsImp_eq (eqtr sfPieceRepEmpty_rename (sfPieceRepEmpty_eq (ax_mp sfRenameIndex_bound lt01S))) (eqtr sfRename_sfEq (nsEq_eq (ax_mp sfRenameIndex_bound (mpbi ltsuc lt01S)) (ax_mp sfRenameIndex_bound lt01S))))))))))));

theorem pcru_empty_open0(x:nat):
 $ sfSubst 0 x (sfAll (sfImp (sfPieceRepEmpty 1) (sfImp (sfPieceRepEmpty 0) (sfEq 1 0)))) = (sfAll (sfImp (sfPieceRepEmpty (suc x)) (sfImp (sfPieceRepEmpty 0) (sfEq (suc x) 0)))) $ =
 '(eqtr sfSubst_sfAll (nsAll_eq (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepEmpty_subst (sfPieceRepEmpty_eq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_zero)))) (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepEmpty_subst (sfPieceRepEmpty_eq (ax_mp sfSubstIndex_bound lt01S))) (eqtr sfSubst_sfEq (nsEq_eq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_zero)) (ax_mp sfSubstIndex_bound lt01S)))))))));

theorem pcru_empty_inst0(G x:nat):
 $ (nsLocal G sfPieceRepEmptyUniqueLaw) -> (nsLocal G (sfAll (sfImp (sfPieceRepEmpty (suc x)) (sfImp (sfPieceRepEmpty 0) (sfEq (suc x) 0))))) $ =
 '(syl (bi1 (nsLocal_formula_eq pcru_empty_open0)) nsLocal_AllE);

theorem pcru_empty_open1(x y:nat):
 $ sfSubst 0 y (sfImp (sfPieceRepEmpty (suc x)) (sfImp (sfPieceRepEmpty 0) (sfEq (suc x) 0))) = (sfImp (sfPieceRepEmpty x) (sfImp (sfPieceRepEmpty y) (sfEq x y))) $ =
 '(eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepEmpty_subst (sfPieceRepEmpty_eq sfSubstIndex_successor)) (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepEmpty_subst (sfPieceRepEmpty_eq sfSubstIndex_zero)) (eqtr sfSubst_sfEq (nsEq_eq sfSubstIndex_successor sfSubstIndex_zero))))));

theorem pcru_empty_inst1(G x y:nat):
 $ (nsLocal G sfPieceRepEmptyUniqueLaw) -> (nsLocal G (sfImp (sfPieceRepEmpty x) (sfImp (sfPieceRepEmpty y) (sfEq x y)))) $ =
 '(syl (syl (bi1 (nsLocal_formula_eq pcru_empty_open1)) nsLocal_AllE) pcru_empty_inst0);

pub theorem pcru_empty_use(G x y:nat):
 $ (nsLocal G sfPieceRepEmptyUniqueLaw) -> (nsLocal G (sfPieceRepEmpty x)) -> (nsLocal G (sfPieceRepEmpty y)) -> (nsLocal G (sfEq x y)) $ =
 '(syl (syl6 nsLocal_mp nsLocal_mp) pcru_empty_inst1);

@_ def sfPieceRepSuccessorUniqueLaw:nat = $ (sfAll (sfAll (sfAll (sfAll (sfImp (sfEq 3 2) (sfImp (sfPieceRepSuccessor 3 1) (sfImp (sfPieceRepSuccessor 2 0) (sfEq 1 0)))))))) $;

theorem pcru_successor_wf:
 $ sfWf sfPieceRepSuccessorUniqueLaw $ =
 '(ax_mp sfWf_all (ax_mp sfWf_all (ax_mp sfWf_all (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfWf_eq) (ax_mp (ax_mp sfWf_imp sfPieceRepSuccessor_wf) (ax_mp (ax_mp sfWf_imp sfPieceRepSuccessor_wf) sfWf_eq)))))));

theorem pcru_successor_shift:
 $ sfShift 0 sfPieceRepSuccessorUniqueLaw = sfPieceRepSuccessorUniqueLaw $ =
 '(eqtr (eqcom (ax_mp sfRename_successor pcru_successor_wf)) (eqtr sfRename_sfAll (nsAll_eq (eqtr sfRename_sfAll (nsAll_eq (eqtr sfRename_sfAll (nsAll_eq (eqtr sfRename_sfAll (nsAll_eq (eqtr sfRename_sfImp (nsImp_eq (eqtr sfRename_sfEq (nsEq_eq (ax_mp sfRenameIndex_bound (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S)))) (ax_mp sfRenameIndex_bound (mpbi ltsuc (mpbi ltsuc lt01S))))) (eqtr sfRename_sfImp (nsImp_eq (eqtr sfPieceRepSuccessor_rename (sfPieceRepSuccessor_eq (ax_mp sfRenameIndex_bound (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S)))) (ax_mp sfRenameIndex_bound (mpbi ltsuc lt01S)))) (eqtr sfRename_sfImp (nsImp_eq (eqtr sfPieceRepSuccessor_rename (sfPieceRepSuccessor_eq (ax_mp sfRenameIndex_bound (mpbi ltsuc (mpbi ltsuc lt01S))) (ax_mp sfRenameIndex_bound lt01S))) (eqtr sfRename_sfEq (nsEq_eq (ax_mp sfRenameIndex_bound (mpbi ltsuc lt01S)) (ax_mp sfRenameIndex_bound lt01S))))))))))))))))));

theorem pcru_successor_open0(x:nat):
 $ sfSubst 0 x (sfAll (sfAll (sfAll (sfImp (sfEq 3 2) (sfImp (sfPieceRepSuccessor 3 1) (sfImp (sfPieceRepSuccessor 2 0) (sfEq 1 0))))))) = (sfAll (sfAll (sfAll (sfImp (sfEq (suc (suc (suc x))) 2) (sfImp (sfPieceRepSuccessor (suc (suc (suc x))) 1) (sfImp (sfPieceRepSuccessor 2 0) (sfEq 1 0))))))) $ =
 '(eqtr sfSubst_sfAll (nsAll_eq (eqtr sfSubst_sfAll (nsAll_eq (eqtr sfSubst_sfAll (nsAll_eq (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfSubst_sfEq (nsEq_eq (eqtr sfSubstIndex_lift (suceq (eqtr sfSubstIndex_lift (suceq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_zero)))))) (ax_mp sfSubstIndex_bound (mpbi ltsuc (mpbi ltsuc lt01S))))) (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepSuccessor_subst (sfPieceRepSuccessor_eq (eqtr sfSubstIndex_lift (suceq (eqtr sfSubstIndex_lift (suceq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_zero)))))) (ax_mp sfSubstIndex_bound (mpbi ltsuc lt01S)))) (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepSuccessor_subst (sfPieceRepSuccessor_eq (ax_mp sfSubstIndex_bound (mpbi ltsuc (mpbi ltsuc lt01S))) (ax_mp sfSubstIndex_bound lt01S))) (eqtr sfSubst_sfEq (nsEq_eq (ax_mp sfSubstIndex_bound (mpbi ltsuc lt01S)) (ax_mp sfSubstIndex_bound lt01S)))))))))))))));

theorem pcru_successor_inst0(G x:nat):
 $ (nsLocal G sfPieceRepSuccessorUniqueLaw) -> (nsLocal G (sfAll (sfAll (sfAll (sfImp (sfEq (suc (suc (suc x))) 2) (sfImp (sfPieceRepSuccessor (suc (suc (suc x))) 1) (sfImp (sfPieceRepSuccessor 2 0) (sfEq 1 0)))))))) $ =
 '(syl (bi1 (nsLocal_formula_eq pcru_successor_open0)) nsLocal_AllE);

theorem pcru_successor_open1(x y:nat):
 $ sfSubst 0 y (sfAll (sfAll (sfImp (sfEq (suc (suc (suc x))) 2) (sfImp (sfPieceRepSuccessor (suc (suc (suc x))) 1) (sfImp (sfPieceRepSuccessor 2 0) (sfEq 1 0)))))) = (sfAll (sfAll (sfImp (sfEq (suc (suc x)) (suc (suc y))) (sfImp (sfPieceRepSuccessor (suc (suc x)) 1) (sfImp (sfPieceRepSuccessor (suc (suc y)) 0) (sfEq 1 0)))))) $ =
 '(eqtr sfSubst_sfAll (nsAll_eq (eqtr sfSubst_sfAll (nsAll_eq (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfSubst_sfEq (nsEq_eq (eqtr sfSubstIndex_lift (suceq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor)))) (eqtr sfSubstIndex_lift (suceq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_zero)))))) (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepSuccessor_subst (sfPieceRepSuccessor_eq (eqtr sfSubstIndex_lift (suceq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor)))) (ax_mp sfSubstIndex_bound (mpbi ltsuc lt01S)))) (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepSuccessor_subst (sfPieceRepSuccessor_eq (eqtr sfSubstIndex_lift (suceq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_zero)))) (ax_mp sfSubstIndex_bound lt01S))) (eqtr sfSubst_sfEq (nsEq_eq (ax_mp sfSubstIndex_bound (mpbi ltsuc lt01S)) (ax_mp sfSubstIndex_bound lt01S)))))))))))));

theorem pcru_successor_inst1(G x y:nat):
 $ (nsLocal G sfPieceRepSuccessorUniqueLaw) -> (nsLocal G (sfAll (sfAll (sfImp (sfEq (suc (suc x)) (suc (suc y))) (sfImp (sfPieceRepSuccessor (suc (suc x)) 1) (sfImp (sfPieceRepSuccessor (suc (suc y)) 0) (sfEq 1 0))))))) $ =
 '(syl (syl (bi1 (nsLocal_formula_eq pcru_successor_open1)) nsLocal_AllE) pcru_successor_inst0);

theorem pcru_successor_open2(x y s:nat):
 $ sfSubst 0 s (sfAll (sfImp (sfEq (suc (suc x)) (suc (suc y))) (sfImp (sfPieceRepSuccessor (suc (suc x)) 1) (sfImp (sfPieceRepSuccessor (suc (suc y)) 0) (sfEq 1 0))))) = (sfAll (sfImp (sfEq (suc x) (suc y)) (sfImp (sfPieceRepSuccessor (suc x) (suc s)) (sfImp (sfPieceRepSuccessor (suc y) 0) (sfEq (suc s) 0))))) $ =
 '(eqtr sfSubst_sfAll (nsAll_eq (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfSubst_sfEq (nsEq_eq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor)) (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor)))) (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepSuccessor_subst (sfPieceRepSuccessor_eq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor)) (eqtr sfSubstIndex_lift (suceq sfSubstIndex_zero)))) (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepSuccessor_subst (sfPieceRepSuccessor_eq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor)) (ax_mp sfSubstIndex_bound lt01S))) (eqtr sfSubst_sfEq (nsEq_eq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_zero)) (ax_mp sfSubstIndex_bound lt01S)))))))))));

theorem pcru_successor_inst2(G x y s:nat):
 $ (nsLocal G sfPieceRepSuccessorUniqueLaw) -> (nsLocal G (sfAll (sfImp (sfEq (suc x) (suc y)) (sfImp (sfPieceRepSuccessor (suc x) (suc s)) (sfImp (sfPieceRepSuccessor (suc y) 0) (sfEq (suc s) 0)))))) $ =
 '(syl (syl (bi1 (nsLocal_formula_eq pcru_successor_open2)) nsLocal_AllE) pcru_successor_inst1);

theorem pcru_successor_open3(x y s t:nat):
 $ sfSubst 0 t (sfImp (sfEq (suc x) (suc y)) (sfImp (sfPieceRepSuccessor (suc x) (suc s)) (sfImp (sfPieceRepSuccessor (suc y) 0) (sfEq (suc s) 0)))) = (sfImp (sfEq x y) (sfImp (sfPieceRepSuccessor x s) (sfImp (sfPieceRepSuccessor y t) (sfEq s t)))) $ =
 '(eqtr sfSubst_sfImp (nsImp_eq (eqtr sfSubst_sfEq (nsEq_eq sfSubstIndex_successor sfSubstIndex_successor)) (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepSuccessor_subst (sfPieceRepSuccessor_eq sfSubstIndex_successor sfSubstIndex_successor)) (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepSuccessor_subst (sfPieceRepSuccessor_eq sfSubstIndex_successor sfSubstIndex_zero)) (eqtr sfSubst_sfEq (nsEq_eq sfSubstIndex_successor sfSubstIndex_zero))))))));

theorem pcru_successor_inst3(G x y s t:nat):
 $ (nsLocal G sfPieceRepSuccessorUniqueLaw) -> (nsLocal G (sfImp (sfEq x y) (sfImp (sfPieceRepSuccessor x s) (sfImp (sfPieceRepSuccessor y t) (sfEq s t))))) $ =
 '(syl (syl (bi1 (nsLocal_formula_eq pcru_successor_open3)) nsLocal_AllE) pcru_successor_inst2);

pub theorem pcru_successor_use(G x y s t:nat):
 $ (nsLocal G sfPieceRepSuccessorUniqueLaw) -> (nsLocal G (sfEq x y)) -> (nsLocal G (sfPieceRepSuccessor x s)) -> (nsLocal G (sfPieceRepSuccessor y t)) -> (nsLocal G (sfEq s t)) $ =
 '(syl (syl6 (syl6 nsLocal_mp nsLocal_mp) nsLocal_mp) pcru_successor_inst3);

theorem pcru_num_eq(k x y:nat)(h:$ x = y $):
 $ sfPieceNumeral k x = sfPieceNumeral k y $ =
 '(trud (sfSubst_congr (a1i eqid) (a1i h) (a1i eqid)));

theorem pcru_num_shift(k x:nat):
 $ sfShift 0 (sfPieceNumeral k x) = sfPieceNumeral k (suc x) $ =
 '(eqtr (eqcom (ax_mp sfRename_successor sfPieceNumeral_wf)) (eqtr sfPieceNumeral_rename (pcru_num_eq sfSuccessorMap_value)));

theorem pcru_succ_shift(x y:nat):
 $ sfShift 0 (sfPieceRepSuccessor x y) = sfPieceRepSuccessor (suc x) (suc y) $ =
 '(eqtr (eqcom (ax_mp sfRename_successor sfPieceRepSuccessor_wf)) (eqtr sfPieceRepSuccessor_rename (sfPieceRepSuccessor_eq (eqtr sfRenameIndex_zero sfSuccessorMap_value) (eqtr sfRenameIndex_zero sfSuccessorMap_value))));

theorem pcru_eq_shift(x y:nat):
 $ sfShift 0 (sfEq x y) = sfEq (suc x) (suc y) $ =
 '(eqtr sfShift_sfEq (nsEq_eq sfShiftIndex_zero sfShiftIndex_zero));

theorem pcru_eq_shift2(x y:nat):
 $ sfShift 0 (sfShift 0 (sfEq x y)) = sfEq (suc (suc x)) (suc (suc y)) $ =
 '(eqtr (trud (sfShift_formula_congr (a1i eqid) (a1i pcru_eq_shift))) pcru_eq_shift);

@_ def sfPieceNumeralUniqueGood(k .G .x .y:nat):wff = $ A. G A. x A. y (nsLocal G sfPieceRepEmptyUniqueLaw -> nsLocal G sfPieceRepSuccessorUniqueLaw -> nsLocal G (sfPieceNumeral k x) -> nsLocal G (sfPieceNumeral k y) -> nsLocal G (sfEq x y)) $;

@_ def pcruGoodAt1(k G .x .y:nat):wff = $ A. x A. y ((nsLocal G sfPieceRepEmptyUniqueLaw) -> (nsLocal G sfPieceRepSuccessorUniqueLaw) -> (nsLocal G (sfPieceNumeral k x)) -> (nsLocal G (sfPieceNumeral k y)) -> (nsLocal G (sfEq x y))) $;

theorem pcru_good_part1(k G:nat):
 $ sfPieceNumeralUniqueGood k -> pcruGoodAt1 k G $ =
 (named '(!! eale j0 ,eqtac));

@_ def pcruGoodAt2(k G x .y:nat):wff = $ A. y ((nsLocal G sfPieceRepEmptyUniqueLaw) -> (nsLocal G sfPieceRepSuccessorUniqueLaw) -> (nsLocal G (sfPieceNumeral k x)) -> (nsLocal G (sfPieceNumeral k y)) -> (nsLocal G (sfEq x y))) $;

theorem pcru_good_part2(k G x:nat):
 $ pcruGoodAt1 k G -> pcruGoodAt2 k G x $ =
 (named '(!! eale j0 ,eqtac));

@_ def pcruGoodAt3(k G x y:nat):wff = $ ((nsLocal G sfPieceRepEmptyUniqueLaw) -> (nsLocal G sfPieceRepSuccessorUniqueLaw) -> (nsLocal G (sfPieceNumeral k x)) -> (nsLocal G (sfPieceNumeral k y)) -> (nsLocal G (sfEq x y))) $;

theorem pcru_good_part3(k G x y:nat):
 $ pcruGoodAt2 k G x -> pcruGoodAt3 k G x y $ =
 (named '(!! eale j0 ,eqtac));

theorem pcru_good_at(G k x y:nat):
 $ sfPieceNumeralUniqueGood k -> (nsLocal G sfPieceRepEmptyUniqueLaw) -> (nsLocal G sfPieceRepSuccessorUniqueLaw) -> (nsLocal G (sfPieceNumeral k x)) -> (nsLocal G (sfPieceNumeral k y)) -> (nsLocal G (sfEq x y)) $ =
 '(syl pcru_good_part3 (syl pcru_good_part2 pcru_good_part1));

theorem pcru_zero_at(G x y:nat):
 $ (nsLocal G sfPieceRepEmptyUniqueLaw) -> (nsLocal G sfPieceRepSuccessorUniqueLaw) -> (nsLocal G (sfPieceNumeral 0 x)) -> (nsLocal G (sfPieceNumeral 0 y)) -> (nsLocal G (sfEq x y)) $ =
 '(exp (exp (exp (mpd (mpd anr (a1i (bi1 (nsLocal_formula_eq sfPieceNumeral_zero)))) (mpd (mpd (anwl anr) (a1i (bi1 (nsLocal_formula_eq sfPieceNumeral_zero)))) (mpd (anwl (anwl (anwl id))) (a1i pcru_empty_use)))))));

theorem pcru_zero:
 $ sfPieceNumeralUniqueGood 0 $ =
 (named '(ax_gen (ax_gen (ax_gen pcru_zero_at))));

@_ def pcruFirstBody(k x:nat):nat = $ sfAnd (sfPieceNumeral k 0) (sfPieceRepSuccessor 0 (suc x)) $;

@_ def pcruSecondBody(k y:nat):nat = $ sfAnd (sfPieceNumeral k 0) (sfPieceRepSuccessor 0 (suc (suc y))) $;

@_ def pcruFirstContext(G k x:nat):nat = $ pcruFirstBody k x : sfContextShift G $;

@_ def pcruSecondContext(G k x y:nat):nat = $ pcruSecondBody k y : sfContextShift (pcruFirstContext G k x) $;

theorem pcru_first_wf(G k x:nat):
 $ sfContextWf (pcruFirstContext G k x) $ =
 '(mpbir sfContextWf_cons (ian (ax_mp (ax_mp sfWf_and sfPieceNumeral_wf) sfPieceRepSuccessor_wf) sfContextShift_wf));

theorem pcru_first_hyp(G k x:nat):
 $ (nsLocal (pcruFirstContext G k x) (pcruFirstBody k x)) $ =
 '(ax_mp (ax_mp nsLocal_hyp pcru_first_wf) sfContext_member_head);

theorem pcru_first_num(G k x:nat):
 $ (nsLocal (pcruFirstContext G k x) (sfPieceNumeral k 0)) $ =
 '(ax_mp nsLocal_CE1 pcru_first_hyp);

theorem pcru_first_succ(G k x:nat):
 $ (nsLocal (pcruFirstContext G k x) (sfPieceRepSuccessor 0 (suc x))) $ =
 '(ax_mp nsLocal_CE2 pcru_first_hyp);

theorem pcru_second_wf(G k x y:nat):
 $ sfContextWf (pcruSecondContext G k x y) $ =
 '(mpbir sfContextWf_cons (ian (ax_mp (ax_mp sfWf_and sfPieceNumeral_wf) sfPieceRepSuccessor_wf) sfContextShift_wf));

theorem pcru_second_hyp(G k x y:nat):
 $ (nsLocal (pcruSecondContext G k x y) (pcruSecondBody k y)) $ =
 '(ax_mp (ax_mp nsLocal_hyp pcru_second_wf) sfContext_member_head);

theorem pcru_second_num(G k x y:nat):
 $ (nsLocal (pcruSecondContext G k x y) (sfPieceNumeral k 0)) $ =
 '(ax_mp nsLocal_CE1 pcru_second_hyp);

theorem pcru_second_succ(G k x y:nat):
 $ (nsLocal (pcruSecondContext G k x y) (sfPieceRepSuccessor 0 (suc (suc y)))) $ =
 '(ax_mp nsLocal_CE2 pcru_second_hyp);

theorem pcru_second_old_num(G k x y:nat):
 $ (nsLocal (pcruSecondContext G k x y) (sfPieceNumeral k 1)) $ =
 '(ax_mp (ax_mp (ax_mp nsLocal_weaken pcru_second_wf) sfContextSub_cons) (mpbi (nsLocal_formula_eq pcru_num_shift) (ax_mp sfSepLocal_shift pcru_first_num)));

theorem pcru_second_old_succ(G k x y:nat):
 $ (nsLocal (pcruSecondContext G k x y) (sfPieceRepSuccessor 1 (suc (suc x)))) $ =
 '(ax_mp (ax_mp (ax_mp nsLocal_weaken pcru_second_wf) sfContextSub_cons) (mpbi (nsLocal_formula_eq pcru_succ_shift) (ax_mp sfSepLocal_shift pcru_first_succ)));

theorem pcru_lift_first(G k x a:nat)(hz:$ sfShift 0 a = a $):
 $ (nsLocal G a) -> (nsLocal (pcruFirstContext G k x) a) $ =
 '(syl (ax_mp (ax_mp nsLocal_weaken pcru_first_wf) sfContextSub_cons) (syl (bi1 (nsLocal_formula_eq hz)) sfSepLocal_shift));

theorem pcru_lift_second(G k x y a:nat)(hz:$ sfShift 0 a = a $):
 $ (nsLocal (pcruFirstContext G k x) a) -> (nsLocal (pcruSecondContext G k x y) a) $ =
 '(syl (ax_mp (ax_mp nsLocal_weaken pcru_second_wf) sfContextSub_cons) (syl (bi1 (nsLocal_formula_eq hz)) sfSepLocal_shift));

theorem pcru_empty_to_second(G k x y:nat):
 $ (nsLocal G sfPieceRepEmptyUniqueLaw) -> (nsLocal (pcruSecondContext G k x y) sfPieceRepEmptyUniqueLaw) $ =
 '(syl (pcru_lift_second pcru_empty_shift) (pcru_lift_first pcru_empty_shift));

theorem pcru_successor_to_second(G k x y:nat):
 $ (nsLocal G sfPieceRepSuccessorUniqueLaw) -> (nsLocal (pcruSecondContext G k x y) sfPieceRepSuccessorUniqueLaw) $ =
 '(syl (pcru_lift_second pcru_successor_shift) (pcru_lift_first pcru_successor_shift));

theorem pcru_inner(G k x y:nat):
 $ sfPieceNumeralUniqueGood k -> (nsLocal G sfPieceRepEmptyUniqueLaw) -> (nsLocal G sfPieceRepSuccessorUniqueLaw) -> (nsLocal (pcruSecondContext G k x y) (sfShift 0 (sfShift 0 (sfEq x y)))) $ =
 '(exp (exp (mpd (mpd (a1i pcru_second_succ) (mpd (a1i pcru_second_old_succ) (mpd (mpd (a1i pcru_second_num) (mpd (a1i pcru_second_old_num) (mpd (mpd anr (a1i pcru_successor_to_second)) (mpd (mpd (anwl anr) (a1i pcru_empty_to_second)) (mpd (anwl (anwl id)) (a1i pcru_good_at)))))) (mpd (mpd anr (a1i pcru_successor_to_second)) (a1i pcru_successor_use))))) (a1i (bi2 (nsLocal_formula_eq pcru_eq_shift2))))));

theorem pcru_first_y(G k x y:nat):
 $ (nsLocal G (sfPieceNumeral (suc k) y)) -> (nsLocal (pcruFirstContext G k x) (sfEx (pcruSecondBody k y))) $ =
 '(syl (bi1 (nsLocal_formula_eq sfPieceNumeral_suc_normal)) (syl (ax_mp (ax_mp nsLocal_weaken pcru_first_wf) sfContextSub_cons) (syl (bi1 (nsLocal_formula_eq pcru_num_shift)) sfSepLocal_shift)));

theorem pcru_step_at(G k x y:nat):
 $ sfPieceNumeralUniqueGood k -> (nsLocal G sfPieceRepEmptyUniqueLaw) -> (nsLocal G sfPieceRepSuccessorUniqueLaw) -> (nsLocal G (sfPieceNumeral (suc k) x)) -> (nsLocal G (sfPieceNumeral (suc k) y)) -> (nsLocal G (sfEq x y)) $ =
 '(exp (exp (exp (exp (mpd (mpd (mpd (anwl (anwl anr)) (mpd (anwl (anwl (anwl anr))) (mpd (anwl (anwl (anwl (anwl id)))) (a1i pcru_inner)))) (mpd (mpd anr (a1i pcru_first_y)) (a1i (sfLocal_exE sfShift_wf)))) (mpd (mpd (anwl anr) (a1i (bi1 (nsLocal_formula_eq sfPieceNumeral_suc_normal)))) (a1i (sfLocal_exE sfWf_eq))))))));

theorem pcru_step(k:nat):
 $ sfPieceNumeralUniqueGood k -> sfPieceNumeralUniqueGood (suc k) $ =
 (named '(iald (iald (iald pcru_step_at))));

pub theorem sfPieceNumeral_unique_induction(k:nat):
 $ sfPieceNumeralUniqueGood k $ =
 (named @ induct '(ind) 'k 'pcru_zero 'pcru_step);

pub theorem sfPieceNumeral_unique_from_laws(G k x y:nat)(he:$ nsLocal G sfPieceRepEmptyUniqueLaw $)(hs:$ nsLocal G sfPieceRepSuccessorUniqueLaw $)(hx:$ nsLocal G (sfPieceNumeral k x) $)(hy:$ nsLocal G (sfPieceNumeral k y) $):
 $ (nsLocal G (sfEq x y)) $ =
 '(ax_mp (ax_mp (ax_mp (ax_mp (ax_mp pcru_good_at sfPieceNumeral_unique_induction) he) hs) hx) hy);
