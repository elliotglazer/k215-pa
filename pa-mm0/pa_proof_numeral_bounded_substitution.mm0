import "pa_formula_induction.mm0";

import "pa_source_interpretation_term_subst_cancel.mm0";

import "pa_formula_substitution.mm0";

def paProofNumeralBoundedSubstitutionTermClass (d: nat) (.c: nat): set = $ {c | paTermSubst d (paTermVariable 0) c = c} $;

theorem paProofNumeralBoundedSubstitutionTerm_identity (d c: nat): $ paTermBound (suc d) c -> paTermSubst d (paTermVariable 0) c = c $;

def paProofNumeralBoundedSubstitutionFormulaClass (.n .c .d: nat): set = $ S\ n, {c | A. d (paFormulaBound (suc d) c -> paFormulaSubst d (paTermVariable 0) c = c)} $;

theorem paProofNumeralBoundedSubstitutionFormula_identity (d c: nat): $ paFormulaBound (suc d) c -> paFormulaSubst d (paTermVariable 0) c = c $;

theorem paProofNumeralBoundedSubstitutionFormula_zero_identity (c: nat): $ paFormulaBound 1 c -> paFormulaSubst 0 (paTermVariable 0) c = c $;
