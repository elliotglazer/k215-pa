import "source_k0_qsep_quotient_rebase.mm0";

theorem sfK0QSepMember_rebase (t x y k l: nat)
 (hk: $ 0 < k $) (hl: $ 0 < l $) (htk: $ t < k $) (htl: $ t < l $)
 (hxk: $ x < k $) (hxl: $ x < l $) (hyk: $ y < k $) (hyl: $ y < l $):
 $ k218IEquivalent (sqMember t x y k) (sqMember t x y l) $;

theorem sfK0QSepQuotient_bases (E: set) (n t a c z M K L phi: nat) (hf: $ sfBound (suc n) phi $) (hM: $ 0 < M $) (hL: $ 0 < L $) (hKL: $ L < K $)
 (htM: $ t < M $) (haM: $ a < M $) (hcM: $ c < M $) (hzM: $ z < M $)
 (htL: $ t < L $) (haL: $ a < L $) (hcL: $ c < L $) (hzL: $ z < L $)
 (heK: $ sqEnvBelow E n K $) (heL: $ sqEnvBelow E n L $):
 $ k218IEquivalent (sfK0QSepQuotientBody E t a c z M K phi) (sfK0QSepQuotientBody E t a c z L L phi) $;

theorem sfK0QSepQuotient_exists_bases (E: set) (n t a c z M K L phi: nat) (hf: $ sfBound (suc n) phi $) (hM: $ 0 < M $) (hL: $ 0 < L $) (hKL: $ L < K $)
 (htM: $ t < M $) (haM: $ a < M $) (hcM: $ c < M $) (hzM: $ z < M $)
 (htL: $ t < L $) (haL: $ a < L $) (hcL: $ c < L $) (hzL: $ z < L $)
 (heK: $ sqEnvBelow E n K $) (heL: $ sqEnvBelow E n L $):
 $ k218IEquivalent (kExists c (sfK0QSepQuotientBody E t a c z M K phi)) (kExists c (sfK0QSepQuotientBody E t a c z L L phi)) $;
