import "bb215_arithmetic_formula_term_value.mm0";

import "pa_source_interpretation_term_numerals.mm0";

import "pa_source_interpretation_term_induction.mm0";

import "pa_source_interpretation_term_renaming.mm0";

def paNatTermRenameClass (E R: set) (.c: nat): set = $ {c | bb215ArithmeticFormulaTermValue E (paTermRename R c) = bb215ArithmeticFormulaTermValue (sfComposeMap E R) c} $;

theorem paNatTermValue_rename (E R: set) (n c: nat): $ paTermBound n c -> bb215ArithmeticFormulaTermValue E (paTermRename R c) = bb215ArithmeticFormulaTermValue (sfComposeMap E R) c $;

theorem paNatTermValue_lift (E: set) (d n c: nat): $ paTermBound n c -> bb215ArithmeticFormulaTermValue E (paTermLift d c) = bb215ArithmeticFormulaTermValue (sfComposeMap E (paTermLiftMap d)) c $;

theorem paNatTermValue_numeral (E: set) (n: nat): $ bb215ArithmeticFormulaTermValue E (paTermNumeral n) = n $;
