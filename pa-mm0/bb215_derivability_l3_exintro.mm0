import "bb215_derivability_l2_mul_distrib.mm0";

-- L05, layer L3a (lanes/L05.md): existential introduction at level n, the first rule needed
-- for the order relation x <= y := E. z (x + z = y) inside PA.

theorem bb215L3_ex_intro (n a t: nat) (ha: $ paFormulaBound (suc n) a $) (ht: $ paTermBound n t $)
  (h: $ paProvable n (paFormulaSubst 0 t a) $): $ paProvable n (paFormulaEx a) $;
