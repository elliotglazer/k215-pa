import "k215_calculus_source_ax_stack_loops.mm1";
import "k215_literal_runtime_reach.mm1";
import "k215_calculus_source_pairing.mm1";
import "k215_calculus_source_ax_stack_lookups.mm1";

@_ def k215PairAt436State (pc a b t c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) b (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) a t (k215PR8 c)) $;

do (apply (register-eqd 'k215PairAt436State) '(k215PairAt436Stateeqd));

theorem k215PairAt436TransferIn (a b t c: nat): $ k215PIter (4 * b + 1) (k215PairAt436State k215PNum436 a b t c) = (k215PairAt436State k215PNum440 (a + b) 0 (t + b) c) $ =
 '(eqtr k215Loop436Vector (k215PStateeq2 (k215PVectoreq eqid eqid eqid eqid eqid eqid addcom addcom eqid)));
theorem k215PairAt436TransferBack (a t c: nat): $ k215PIter (3 * a + 1) (k215PairAt436State k215PNum442 a 0 t c) = (k215PairAt436State k215PNum445 0 a t c) $ =
 '(eqtr k215Loop442Vector (k215PStateeq2 (k215PVectoreq2 add0)));
pub theorem k215PairAt436ReachIn (a b t c: nat): $ k215PReach (k215PairAt436State k215PNum436 a b t c) (k215PairAt436State k215PNum440 (a + b) 0 (t + b) c) $ =
 '(k215PReach_intro k215PairAt436TransferIn);
theorem k215PairAt436ReachBack (a t c: nat): $ k215PReach (k215PairAt436State k215PNum442 a 0 t c) (k215PairAt436State k215PNum445 0 a t c) $ =
 '(k215PReach_intro k215PairAt436TransferBack);


theorem k215PairAt436Step50Z (b t c: nat): $ k215PStep (k215PairAt436State k215PNum440 0 b t c) = (k215PairAt436State k215PNum446 0 b t c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupPair436_440) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215PairAt436Reach50Z (b t c: nat): $ k215PReach (k215PairAt436State k215PNum440 0 b t c) (k215PairAt436State k215PNum446 0 b t c) $ = '(k215PReach_step k215PairAt436Step50Z);

theorem k215PairAt436Step50S (a b t c: nat): $ k215PStep (k215PairAt436State k215PNum440 (suc a) b t c) = (k215PairAt436State k215PNum441 a b t c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupPair436_440) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215PairAt436Reach50S (a b t c: nat): $ k215PReach (k215PairAt436State k215PNum440 (suc a) b t c) (k215PairAt436State k215PNum441 a b t c) $ = '(k215PReach_step k215PairAt436Step50S);

theorem k215PairAt436Step51 (a b t c: nat): $ k215PStep (k215PairAt436State k215PNum441 a b t c) = (k215PairAt436State k215PNum442 a b (suc t) c) $ = '(eqtr (k215PAtCI k215PLookupPair436_441) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215PairAt436Reach51 (a b t c: nat): $ k215PReach (k215PairAt436State k215PNum441 a b t c) (k215PairAt436State k215PNum442 a b (suc t) c) $ = '(k215PReach_step k215PairAt436Step51);

theorem k215PairAt436Step55 (a b t c: nat): $ k215PStep (k215PairAt436State k215PNum445 a b t c) = (k215PairAt436State k215PNum436 a b t c) $ = '(k215PAtCC k215PLookupPair436_445);

theorem k215PairAt436Reach55 (a b t c: nat): $ k215PReach (k215PairAt436State k215PNum445 a b t c) (k215PairAt436State k215PNum436 a b t c) $ = '(k215PReach_step k215PairAt436Step55);

theorem k215PairAt436Prefix (k t c: nat): $ k215PReach (k215PairAt436State k215PNum440 (suc k) 0 t c) (k215PairAt436State k215PNum436 0 k (suc t) c) $ = '(ax_mp (ax_mp k215PReach_trans k215PairAt436Reach50S) (ax_mp (ax_mp k215PReach_trans k215PairAt436Reach51) (ax_mp (ax_mp k215PReach_trans k215PairAt436ReachBack) k215PairAt436Reach55)));
theorem k215PairAt436ReachSum (a b t k c: nat): $ a + b = suc k -> k215PReach (k215PairAt436State k215PNum436 a b t c) (k215PairAt436State k215PNum440 (suc k) 0 (t + b) c) $ =
 '(mpbid (k215PReacheq2d (k215PairAt436Stateeq2d id)) (a1i k215PairAt436ReachIn));
pub theorem k215PairAt436Cycle (a b t k c: nat): $ a + b = suc k -> k215PReach (k215PairAt436State k215PNum436 a b t c) (k215PairAt436State k215PNum436 0 k (suc (t + b)) c) $ =
 '(mpd (a1i k215PairAt436Prefix) (syl k215PReach_trans k215PairAt436ReachSum));
theorem k215PairAt436ReachZeroIn (t c: nat): $ k215PReach (k215PairAt436State k215PNum436 0 0 t c) (k215PairAt436State k215PNum440 0 0 t c) $ =
 '(mpbi (k215PReacheq2 (k215PairAt436Stateeq eqid add0 eqid add0 eqid)) k215PairAt436ReachIn);
pub theorem k215PairAt436Base (t c: nat): $ k215PReach (k215PairAt436State k215PNum436 0 0 t c) (k215PairAt436State k215PNum446 0 0 t c) $ =
 '(ax_mp (ax_mp k215PReach_trans k215PairAt436ReachZeroIn) k215PairAt436Reach50Z);


@_ abstract def k215PairAt436Run (a b t c: nat): wff =
 $ k215PReach (k215PairAt436State k215PNum436 a b t c) (k215PairAt436State k215PNum446 0 0 (t + (a, b)) c) $;
do (apply (register-eqd 'k215PairAt436Run) '(k215PairAt436Runeqd));
theorem k215PairAt436RunZero (t c: nat): $ k215PairAt436Run 0 0 t c $ =
 '(mpbi (k215PReacheq2 (k215PairAt436Stateeq4 (eqcom (eqtr (addeq2 pr0) add0)))) k215PairAt436Base);
theorem k215PairAt436RunBase (a b t c: nat): $ a + b = 0 -> k215PairAt436Run a b t c $ =
 '(mpbiri k215PairAt436RunZero (k215PairAt436Runeqd
   (syl anl (bi1 addeq0)) (syl anr (bi1 addeq0)) eqidd eqidd));
theorem k215PairAt436SumStep (a b k: nat): $ a + b = suc k -> (a, b) = b + suc (0, k) $ =
 '(eqtrd (a1i preqadd) (eqtrd (addeq1d (preq1d id))
   (a1i (eqtr (addeq1 k215PairDiagonal_rotate) addcom))));
theorem k215PairAt436Accumulator (a b t k: nat): $ a + b = suc k -> suc (t + b) + (0, k) = t + (a, b) $ =
 '(eqtrd
   (a1i (eqtr addS1 (eqtr (suceq addass)
     (eqtr (eqcom addS) (addeq2 (eqcom addS))))))
   (addeq2d (eqcomd k215PairAt436SumStep)));
@_ abstract def k215PairAt436Claim (k c: nat) (.a .b .t: nat): wff =
 $ A. a A. b A. t (a + b = k -> k215PairAt436Run a b t c) $;
theorem k215PairAt436Claim_at (a b t k c: nat): $ k215PairAt436Claim k c -> a + b = k -> k215PairAt436Run a b t c $ =
 (named '(!! ealie i @ !! ealde j @ !! ealde l @ bi1d ,eqtac));
theorem k215PairAt436RunInductive (a b t k c: nat): $ k215PairAt436Claim k c -> a + b = suc k -> k215PairAt436Run a b t c $ =
 '(exp @ mpd
   (mpbid
     (k215PReacheq2d (k215PairAt436Stateeq4d (syl k215PairAt436Accumulator anr)))
     (mpd (a1i add01) (syl k215PairAt436Claim_at anl)))
   (syl k215PReach_trans (syl k215PairAt436Cycle anr)));
theorem k215PairAt436Claim_all (k c: nat): $ k215PairAt436Claim k c $ =
 (named @ induct '(ind) 'k
   '(ax_gen (ax_gen (ax_gen k215PairAt436RunBase)))
   '(iald @ iald @ iald k215PairAt436RunInductive));
pub theorem k215PairMacro436 (a b t c: nat): $ k215PReach (k215PairAt436State k215PNum436 a b t c) (k215PairAt436State k215PNum446 0 0 (t + (a, b)) c) $ =
 '(ax_mp (ax_mp k215PairAt436Claim_at k215PairAt436Claim_all) eqid);


