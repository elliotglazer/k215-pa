import "g2pa_spec.mm0";
import "../g2_generic_s1_tarski.mm0";
theorem g2pi_rec: $ thIsSigma1Rec paFormulaFalse $;
theorem g2pi_axset (a: nat): $ ~ a e. paThAxSet paFormulaFalse $;
theorem g2pi_prov (c: nat): $ paThProvable (paThAxSet paFormulaFalse) c <-> paProvable 0 c $;
theorem g2pi_inc: $ paThInconsistent paFormulaFalse <-> paProvable 0 paFormulaFalse $;
theorem g2pi_hT1 (m M: nat) (h: $ tmHalts m M <-> paProvable 0 paFormulaFalse $):
  $ tmHalts m M <-> paThInconsistent paFormulaFalse $;
theorem G2_pa: $ ~paProvable 0 paFormulaFalse -> ~paProvable 0 (paThCon paFormulaFalse) $;
theorem BB_pa_thm2 (m n M: nat) {b: nat}
  (hM: $ tmValid m M $) (hmn: $ m <= n $)
  (hT1: $ tmHalts m M <-> paProvable 0 paFormulaFalse $)
  (hB: $ bb215ProvabilityInternalBridge (paThPr paFormulaFalse) (tmHaltsPA m M) $):
  $ ~paProvable 0 paFormulaFalse <-> A. b ~paProvable 0 (bbSentencePA n b) $;
theorem BB_pa_thm3 (m n M: nat) {b: nat}
  (hM: $ tmValid m M $) (hmn: $ m <= n $)
  (hT1: $ tmHalts m M <-> paProvable 0 paFormulaFalse $)
  (hB: $ bb215ProvabilityInternalBridge (paThPr paFormulaFalse) (tmHaltsPA m M) $):
  $ (~paProvable 0 paFormulaFalse <-> ~tmHalts m M) /\
    (~tmHalts m M <-> A. b ~paProvable 0 (bbSentencePA n b)) $;
theorem g2paInst_final: $ paFormulaBound 0 paFormulaFalse $;
