import "../g2_generic_sf_pr.mm0";
import "d3_sfd2.mm0";
import "d3_sfd3.mm0";
import "g2sf_bb.mm0";
import "g7_runcut.mm0";
theorem G2_generic_setL (R: nat) {z: nat} (hR: $ paFormulaBound 1 R /\ paS1Class 1 R $) (hZ: $ A. z (z e. zfcAxioms -> z e. g2sfAxSet R) /\ paProvable 0 (paFormulaAll (paFormulaImp g2szRz R)) $):
  $ ~sfTheoryProvable (g2sfAxSet R) sfBot -> ~sfTheoryProvable (g2sfAxSet R) (paFormulaSource (g2sfThConL R)) $;
theorem BB_generic_set_thm2L (R m n M: nat) {b z: nat} (hR: $ paFormulaBound 1 R /\ paS1Class 1 R $) (hZ: $ A. z (z e. zfcAxioms -> z e. g2sfAxSet R) /\ paProvable 0 (paFormulaAll (paFormulaImp g2szRz R)) $)
  (hM: $ tmValid m M $) (hmn: $ m <= n $)
  (hT1: $ tmHalts m M <-> sfTheoryProvable (g2sfAxSet R) sfBot $)
  (hB: $ bb215ProvabilityInternalBridge (g2sfThPrL R) (tmHaltsPA m M) $):
  $ ~sfTheoryProvable (g2sfAxSet R) sfBot <-> A. b ~sfTheoryProvable (g2sfAxSet R) (bbSentenceSource n b) $;
theorem BB_generic_set_thm3L (R m n M: nat) {b z: nat} (hR: $ paFormulaBound 1 R /\ paS1Class 1 R $) (hZ: $ A. z (z e. zfcAxioms -> z e. g2sfAxSet R) /\ paProvable 0 (paFormulaAll (paFormulaImp g2szRz R)) $)
  (hM: $ tmValid m M $) (hmn: $ m <= n $)
  (hT1: $ tmHalts m M <-> sfTheoryProvable (g2sfAxSet R) sfBot $)
  (hB: $ bb215ProvabilityInternalBridge (g2sfThPrL R) (tmHaltsPA m M) $):
  $ (~sfTheoryProvable (g2sfAxSet R) sfBot <-> ~tmHalts m M) /\
    (~tmHalts m M <-> A. b ~sfTheoryProvable (g2sfAxSet R) (bbSentenceSource n b)) $;
theorem g2sfHead_final: $ paFormulaBound 0 paFormulaFalse $;
