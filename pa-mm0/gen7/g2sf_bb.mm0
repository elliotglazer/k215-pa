import "../bb215_provability_hbl_g2_abstract.mm0";
import "../g2_generic_bb.mm0";
import "../bb215_derivability_d2_quant.mm0";
import "../bb215_provability_halting_refutation.mm0";
theorem g2sb_G2 (A: set) (P G: nat) {c a b: nat}
  (hP: $ paFormulaBound 1 P $)
  (hT: $ A. c (paProvable 0 c -> sfTheoryProvable A (paFormulaSource c)) $)
  (h1: $ A. c bb215ProvabilityD1T A bb215G2ASrc P c $)
  (h2: $ A. a A. b bb215ProvabilityD2 P a b $)
  (h3: $ A. a bb215ProvabilityD3 P a $)
  (hG: $ bb215ProvabilityFixedPoint P G $):
  $ ~sfTheoryProvable A sfBot -> ~sfTheoryProvable A (paFormulaSource (bb215ProvabilityConsistencyPA P)) $;
theorem g2sb_thm2_P (A: set) (P G m n M: nat) {a b c: nat}
  (hP: $ paFormulaBound 1 P $)
  (hT: $ A. c (paProvable 0 c -> sfTheoryProvable A (paFormulaSource c)) $)
  (h1: $ A. c bb215ProvabilityD1T A bb215G2ASrc P c $)
  (h2: $ A. a A. b bb215ProvabilityD2 P a b $)
  (h3: $ A. a bb215ProvabilityD3 P a $)
  (hG: $ bb215ProvabilityFixedPoint P G $)
  (hT1: $ tmHalts m M <-> sfTheoryProvable A sfBot $)
  (hB: $ bb215ProvabilityInternalBridge P (tmHaltsPA m M) $)
  (hR: $ ~tmHalts m M -> A. b tmRunCut n (tmHaltsPA m M) b $):
  $ ~sfTheoryProvable A sfBot <-> A. b ~sfTheoryProvable A (bbSentenceSource n b) $;
theorem g2sb_thm3_P (A: set) (P G m n M: nat) {a b c: nat}
  (hP: $ paFormulaBound 1 P $)
  (hT: $ A. c (paProvable 0 c -> sfTheoryProvable A (paFormulaSource c)) $)
  (h1: $ A. c bb215ProvabilityD1T A bb215G2ASrc P c $)
  (h2: $ A. a A. b bb215ProvabilityD2 P a b $)
  (h3: $ A. a bb215ProvabilityD3 P a $)
  (hG: $ bb215ProvabilityFixedPoint P G $)
  (hT1: $ tmHalts m M <-> sfTheoryProvable A sfBot $)
  (hB: $ bb215ProvabilityInternalBridge P (tmHaltsPA m M) $)
  (hR: $ ~tmHalts m M -> A. b tmRunCut n (tmHaltsPA m M) b $):
  $ (~sfTheoryProvable A sfBot <-> ~tmHalts m M) /\
    (~tmHalts m M <-> A. b ~sfTheoryProvable A (bbSentenceSource n b)) $;
theorem g2sfBB_final: $ paFormulaBound 0 paFormulaFalse $;
