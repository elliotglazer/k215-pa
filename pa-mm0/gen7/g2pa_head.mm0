import "../g2_generic_pa_thd2.mm0";
import "d3_pad3.mm0";
import "g2pa_bb.mm0";
import "g7_runcut.mm0";
theorem G2_generic_paL (R: nat) (hR: $ paFormulaBound 1 R /\ paS1Class 1 R $):
  $ ~paThProvable (g2paAxSet R) paFormulaFalse -> ~paThProvable (g2paAxSet R) (bb215ProvabilityConsistencyPA (g2paThCode R)) $;
theorem BB_generic_pa_thm2L (R m n M: nat) {b: nat} (hR: $ paFormulaBound 1 R /\ paS1Class 1 R $)
  (hM: $ tmValid m M $) (hmn: $ m <= n $)
  (hT1: $ tmHalts m M <-> paThProvable (g2paAxSet R) paFormulaFalse $)
  (hB: $ bb215ProvabilityInternalBridge (g2paThCode R) (tmHaltsPA m M) $):
  $ ~paThProvable (g2paAxSet R) paFormulaFalse <-> A. b ~paThProvable (g2paAxSet R) (bbSentencePA n b) $;
theorem BB_generic_pa_thm3L (R m n M: nat) {b: nat} (hR: $ paFormulaBound 1 R /\ paS1Class 1 R $)
  (hM: $ tmValid m M $) (hmn: $ m <= n $)
  (hT1: $ tmHalts m M <-> paThProvable (g2paAxSet R) paFormulaFalse $)
  (hB: $ bb215ProvabilityInternalBridge (g2paThCode R) (tmHaltsPA m M) $):
  $ (~paThProvable (g2paAxSet R) paFormulaFalse <-> ~tmHalts m M) /\
    (~tmHalts m M <-> A. b ~paThProvable (g2paAxSet R) (bbSentencePA n b)) $;
theorem g2paHead_final: $ paFormulaBound 0 paFormulaFalse $;
