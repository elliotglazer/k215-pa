import "../g2_generic_pa_rules.mm0";
import "../g2_generic_bb.mm0";
import "../bb215_provability_halting_refutation.mm0";
theorem g2pb_thm2_P (A: set) (P G m n M: nat) {a b c: nat}
  (hA: $ A. c (c e. A -> paFormulaBound 0 c) $)
  (hP: $ paFormulaBound 1 P $)
  (h1: $ A. c (paFormulaBound 0 c -> paThProvable A c -> paProvable 0 (bb215PrAt P c)) $)
  (h2: $ A. a A. b bb215ProvabilityD2 P a b $)
  (h3: $ A. a bb215ProvabilityD3 P a $)
  (hG: $ bb215ProvabilityFixedPoint P G $)
  (hT1: $ tmHalts m M <-> paThProvable A paFormulaFalse $)
  (hB: $ bb215ProvabilityInternalBridge P (tmHaltsPA m M) $)
  (hR: $ ~tmHalts m M -> A. b tmRunCut n (tmHaltsPA m M) b $):
  $ ~paThProvable A paFormulaFalse <-> A. b ~paThProvable A (bbSentencePA n b) $;
theorem g2pb_thm3_P (A: set) (P G m n M: nat) {a b c: nat}
  (hA: $ A. c (c e. A -> paFormulaBound 0 c) $)
  (hP: $ paFormulaBound 1 P $)
  (h1: $ A. c (paFormulaBound 0 c -> paThProvable A c -> paProvable 0 (bb215PrAt P c)) $)
  (h2: $ A. a A. b bb215ProvabilityD2 P a b $)
  (h3: $ A. a bb215ProvabilityD3 P a $)
  (hG: $ bb215ProvabilityFixedPoint P G $)
  (hT1: $ tmHalts m M <-> paThProvable A paFormulaFalse $)
  (hB: $ bb215ProvabilityInternalBridge P (tmHaltsPA m M) $)
  (hR: $ ~tmHalts m M -> A. b tmRunCut n (tmHaltsPA m M) b $):
  $ (~paThProvable A paFormulaFalse <-> ~tmHalts m M) /\
    (~tmHalts m M <-> A. b ~paThProvable A (bbSentencePA n b)) $;
theorem g2paBB_final: $ paFormulaBound 0 paFormulaFalse $;
