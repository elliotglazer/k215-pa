axiom g7_bridge_of_refl_paL (R m M: nat) (hR: $ paFormulaBound 1 R /\ paS1Class 1 R $) (hRefl: $ paProvable 0 (paFormulaImp (trJ (trPA (cpaThProvable (cg2paAxSet (cNum R)) cpaFormulaFalse))) (trJ (trPA (ctmHalts (cNum m) (cNum M))))) $):
  $ bb215ProvabilityInternalBridge (g2paThCode R) (tmHaltsPA m M) $;

theorem g7toy_hB: $ bb215ProvabilityInternalBridge (g2paThCode paFormulaFalse) (tmHaltsPA g7toy_m g7toy_M) $;
