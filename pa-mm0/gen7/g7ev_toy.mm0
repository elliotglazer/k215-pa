import "g7ev_src.mm0";
import "../g2_generic_pa_rules.mm0";
import "../g2_generic_tm_defs.mm0";
import "../g2_generic_s1_defs.mm0";
def g2paAxSet (R .a: nat): set = $ {a | paFormulaBound 0 a /\ paS1Holds R (a : 0)} $;
def g7toy_m: nat = $ 0 $;
def g7toy_a: nat = $ (1, 1, b1 (b0 1)) + 1 $;
def g7toy_M: nat = $ ((0, 1, 2) + 1) : g7toy_a : ((1, 0, 10 * 3 + suc 7) + 1) : g7toy_a : 0 $;
theorem g7toy_fwd (R m M: nat): $ R = paFormulaFalse -> m = g7toy_m -> M = g7toy_M ->
  paThProvable (g2paAxSet R) paFormulaFalse -> tmHalts m M $;
