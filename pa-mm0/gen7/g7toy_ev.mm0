import "g7ev_lib.mm0";

import "g7ev_toy.mm0";

axiom g7toy_fwd_R (v0: nat) (v1: nat) (v2: nat): $ cPr (cIm (cEq v0 cpaFormulaFalse) (cIm (cEq v1 cg7toy_m) (cIm (cEq v2 cg7toy_M) (cIm (cpaThProvable (cg2paAxSet v0) cpaFormulaFalse) (ctmHalts v1 v2))))) $;

theorem g7toy_hRefl: $ paProvable 0 (paFormulaImp (trJ (trPA (cpaThProvable (cg2paAxSet (cNum paFormulaFalse)) cpaFormulaFalse))) (trJ (trPA (ctmHalts (cNum g7toy_m) (cNum g7toy_M))))) $;
