import "k230_deduction.mm0";
import "k230_quantifier_macros.mm0";

-- Every assumption has its own explicit global vacuity proof.
def kContextVacuous (G x .a: nat): wff =
$ A. a (a IN G -> kProvable (kImp a (kAll x a))) $;
def kContextUniversalClass (G x .a: nat): set =
$ {a | kHypProvable G (kAll x a)} $;

theorem kContextVacuous_member (G x a: nat):
  $ kContextVacuous G x -> a IN G -> kProvable (kImp a (kAll x a)) $;
theorem kContextVacuous_nil (x: nat): $ kContextVacuous 0 x $;
theorem kContextVacuous_cons (G x a: nat):
  $ kContextVacuous (a : G) x <-> kProvable (kImp a (kAll x a)) /\ kContextVacuous G x $;
theorem kContextUniversalClass_value (G x a: nat):
  $ a e. kContextUniversalClass G x <-> kHypProvable G (kAll x a) $;
theorem kHypRules_generalization_sound (G x: nat) (hv: $ kContextVacuous G x $):
  $ traceRuleSound (kHypRules G) (kContextUniversalClass G x) $;
theorem kHypDerives_gen (G x p a: nat) (hv: $ kContextVacuous G x $):
  $ kHypDerives G p a -> kHypProvable G (kAll x a) $;
theorem kHypProvable_gen (G x a: nat) (hv: $ kContextVacuous G x $):
  $ kHypProvable G a -> kHypProvable G (kAll x a) $;
theorem kHypProvable_exists_elim (G x p q: nat)
  (hv: $ kContextVacuous G x $)
  (hq: $ kProvable (kImp q (kAll x q)) $):
  $ kHypProvable G (kExists x p) -> kHypProvable G (kImp p q) -> kHypProvable G q $;
