import "k215_literal_scans.mm1";

@_ def k215TmRegister (v r: nat): nat = $ k215TmPush 0 (k215TmPush 1 (k215TmRepeat 1 v r)) $;
do (apply (register-eqd 'k215TmRegister) '(k215TmRegistereqd));
@_ abstract def k215TmFileStep (.z: nat): set =
 $ \ z, k215TmRegister (fst z) (pi22 z) $;
@_ abstract def k215TmFile (vs r: nat): nat = $ lrec r k215TmFileStep vs $;
theorem k215TmFileStep_apply (v vs r: nat):
 $ k215TmFileStep @ (v, vs, r) = k215TmRegister v r $ =
 (named '(!! applame j @ k215TmRegistereqd
   (syl6eq fstpr @ fsteqd id) (syl6eq pi22pr @ pi22eqd id)));
pub theorem k215TmFile_nil (r: nat): $ k215TmFile 0 r = r $ = 'lrec0;
pub theorem k215TmFile_cons (v vs r: nat): $ k215TmFile (v : vs) r = k215TmRegister v (k215TmFile vs r) $ =
 '(eqtr lrecS k215TmFileStep_apply);
pub theorem k215TmFile_append (vs ws r: nat): $ k215TmFile (vs ++ ws) r = k215TmFile vs (k215TmFile ws r) $ =
 (named @ induct '(listind) 'vs
  '(eqtr (k215TmFileeq1 append0) (eqcom k215TmFile_nil))
  '(eqtrd (a1i (k215TmFileeq1 appendS))
    (eqtrd (a1i k215TmFile_cons)
      (eqtrd (k215TmRegistereq2d id) (a1i (eqcom k215TmFile_cons))))));
