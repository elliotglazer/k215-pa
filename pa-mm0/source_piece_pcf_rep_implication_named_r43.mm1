theorem sfPieceRepImplicationNamed_mem_rename(R:set)(a:nat): $ sfRename R 1 (sfMem 0 (suc a)) = sfMem 0 (suc (R @ a)) $ = (named '(eqtr sfRename_sfMem (nsMem_eq (ax_mp sfRenameIndex_bound lt01S) (eqtr sfRenameIndex_lift (suceq sfRenameIndex_zero)))));

pub theorem sfPieceRepImplicationNamedUnion_rename(R:set)(a b r:nat): $ sfRename R 0 (sfPieceRepImplicationNamedUnion a b r) = sfPieceRepImplicationNamedUnion (R @ a) (R @ b) (R @ r) $ = (named '(eqtr sfRename_sfAll (nsAll_eq (eqtr sfRename_sfAnd (nsAnd_eq (eqtr sfRename_sfImp (nsImp_eq (! sfPieceRepImplicationNamed_mem_rename $ R $ $ r $) (eqtr sfRename_sfOr (nsOr_eq (! sfPieceRepImplicationNamed_mem_rename $ R $ $ a $) (! sfPieceRepImplicationNamed_mem_rename $ R $ $ b $))))) (eqtr sfRename_sfImp (nsImp_eq (eqtr sfRename_sfOr (nsOr_eq (! sfPieceRepImplicationNamed_mem_rename $ R $ $ a $) (! sfPieceRepImplicationNamed_mem_rename $ R $ $ b $))) (! sfPieceRepImplicationNamed_mem_rename $ R $ $ r $))))))));

