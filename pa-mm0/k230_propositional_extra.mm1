import "k230_quantifier_derived.mm1";

theorem kExtraStep0 (b: nat): $ kProvable (kImp (kImp b (kImp b b)) (kImp b b)) $ =
'(! kProvable_mp $ (kImp b (kImp (kImp b b) b)) $ $ (kImp (kImp b (kImp b b)) (kImp b b)) $ (! kPropK $ b $ $ (kImp b b) $) (! kPropS $ b $ $ (kImp b b) $ $ b $));

theorem kExtraStep1 (b: nat): $ kProvable (kImp b b) $ =
'(! kProvable_mp $ (kImp b (kImp b b)) $ $ (kImp b b) $ (! kPropK $ b $ $ b $) (! kExtraStep0 $ b $));

