import "source_reflection_transfer_tv_ph_context.mm0";

def sfTVPHBase(G L P:nat):nat = $ (sfORBinary L 0 3) : ((sfReflectionLimitProfile L P) : G) $;

def sfTVRowBallLaw(D L P k matrix:nat):nat = $ sfImp (sfReflectionLimitProfile L P) (sfImp (sfORBinary L 0 3) (sfTVRowBall D k matrix 3)) $;

theorem sfTVRowBall_from_PH_local(A:set)(G D L P k matrix:nat)(ht:$ sfTheoryClosed A $)(hG:$ sfTheoryContext A G $)(hd:$ sfBound 1 D $)(hl:$ sfBound 2 L $)(hp:$ sfBound 2 P $)(hm:$ sfWf matrix $)(hPH:$ nsLocal G (sfTVPHPoint D L P k matrix) $): $ nsLocal G (sfTVRowBallLaw D L P k matrix) $;
