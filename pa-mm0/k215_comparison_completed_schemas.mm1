import "k215_comparison_from_images.mm1";

import "k215_core_complete.mm1";

def k215RemainingInterpretationImages: wff = $ sfZFCImageFamilies zfrAxioms sfLDomain /\ k215SourceBundleImages $;

pub theorem k215CompletedSchemas_supply:
 $ k215RemainingInterpretationImages -> k215ComparisonImageObligations $ =
'(iand anl (iand (a1i k215ReplacementImages) anr));

pub theorem k215ZFC_refutation_from_Limages:
 $ sfZFCImageFamilies zfrAxioms sfLDomain -> zfcInconsistent -> k215Inconsistent $ =
'(mpd (a1i k215ReplacementImages) k215ZFC_refutation_from_images);

pub theorem k215Inconsistency_iff_ZFC_from_interpretations:
 $ k215RemainingInterpretationImages -> (k215Inconsistent <-> zfcInconsistent) $ =
'(syl k215Inconsistency_iff_ZFC_from_images k215CompletedSchemas_supply);

pub theorem k215Consistency_iff_ZFC_from_interpretations:
 $ k215RemainingInterpretationImages -> (~k215Inconsistent <-> ~zfcInconsistent) $ =
'(noteqd k215Inconsistency_iff_ZFC_from_interpretations);
