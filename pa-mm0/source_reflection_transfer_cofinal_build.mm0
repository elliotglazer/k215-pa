import "source_reflection_transfer_cofinal_cover.mm0";

theorem sfReflectionCofinal_point_hit(T:set)(G start n level K k X:nat)(hl:$ sfBound 2 level $)(hPoint:$ nsLocal G (sfReflectionCofinalPoint T start n level K k X) $)(hHit:$ nsLocal G (sfReflectionCofinalHit level K ((T @ n) + start)) $)(hM:$ nsLocal G (sfReflectionCofinalMergeLaw level K) $): $ nsLocal G (sfReflectionCofinalCommon T start (suc n) level K) $;

theorem sfReflectionCofinal_extend(T:set)(G start n level K:nat)(hl:$ sfBound 2 level $)(hCommon:$ nsLocal G (sfReflectionCofinalCommon T start n level K) $)(hHit:$ nsLocal G (sfReflectionCofinalHit level K ((T @ n) + start)) $)(hM:$ nsLocal G (sfReflectionCofinalMergeLaw level K) $): $ nsLocal G (sfReflectionCofinalCommon T start (suc n) level K) $;
