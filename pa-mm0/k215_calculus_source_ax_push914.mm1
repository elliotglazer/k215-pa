import "k215_calculus_source_ax_pair920.mm1";
import "k215_calculus_source_ax_stack_loops.mm1";

theorem k215PairVectorInAt914 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt920State k215PNum920 a6 a1 a7 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum920 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215PairVectorOutAt914 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt920State k215PNum930 0 0 (a7 + (a6, a1)) (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum930 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

pub theorem k215PairMacro46_vectorAt914 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat):
 $ k215PReach (k215PState k215PNum920 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215PNum930 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ =
 '(mpbi (k215PReacheq k215PairVectorInAt914 k215PairVectorOutAt914) k215PairMacro920);

theorem k215PushAStage0At914 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum914 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum917 (k215PVector u 0 w c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop914Vector (k215PStateeq2 (k215PVectoreq7 add0))));

theorem k215PushAStage1At914 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum917 (k215PVector u 0 w c a b t 0 v)) (k215PState k215PNum920 (k215PVector u w 0 c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop917Vector (k215PStateeq2 (k215PVectoreq2 add0))));

theorem k215PushAStage2At914 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum920 (k215PVector u w 0 c a b t 0 v)) (k215PState k215PNum930 (k215PVector u 0 0 c a b 0 (t, w) v)) $ = '(mpbi (k215PReacheq2 (k215PStateeq2 (k215PVectoreq8 add01))) k215PairMacro46_vectorAt914);

theorem k215PushAStage3At914 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum930 (k215PVector u 0 0 c a b 0 (t, w) v)) (k215PState k215PNum933 (k215PVector u 0 (t, w) c a b 0 0 v)) $ = '(k215PReach_intro (eqtr k215Loop930Vector (k215PStateeq2 (k215PVectoreq3 add0))));

theorem k215PushAStage4At914 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum933 (k215PVector u 0 (t, w) c a b 0 0 v)) (k215PState k215PNum937 (k215PVector u a (t, w) c 0 b a 0 v)) $ = '(k215PReach_intro (eqtr k215Loop933Vector (k215PStateeq2 (k215PVectoreq eqid add0 eqid eqid eqid eqid add0 eqid eqid))));

theorem k215PushAStage5At914 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum937 (k215PVector u a (t, w) c 0 b a 0 v)) (k215PState k215PNum940 (k215PVector u a (t, w) c a b 0 0 v)) $ = '(k215PReach_intro (eqtr k215Loop937Vector (k215PStateeq2 (k215PVectoreq5 add0))));

pub theorem k215PushParam914 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum914 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum940 (k215PVector u a (t, w) c a b 0 0 v)) $ = '(ax_mp (ax_mp k215PReach_trans k215PushAStage0At914) (ax_mp (ax_mp k215PReach_trans k215PushAStage1At914) (ax_mp (ax_mp k215PReach_trans k215PushAStage2At914) (ax_mp (ax_mp k215PReach_trans k215PushAStage3At914) (ax_mp (ax_mp k215PReach_trans k215PushAStage4At914) k215PushAStage5At914)))));

