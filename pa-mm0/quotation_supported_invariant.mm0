import "quotation_supported_quantifiers.mm0";
import "source_nd_quantifiers.mm0";

def sqSupportedRowGoal (r S t k H: nat): wff =
 $ ifp (fst r = 0)
 (kHypProvable H (sqQuote (sqNumericEnvironment S) t k 0 (snd (snd r))))
 (kHypProvable (sqQuote (sqNumericEnvironment S) t k 0 (fst (snd (snd r))) : H)
   (sqQuote (sqNumericEnvironment S) t k 0 (snd (snd (snd (snd r))))) /\
  kHypProvable (sqQuote (sqNumericEnvironment S) t k 0 (fst (snd (snd (snd r)))) : H)
   (sqQuote (sqNumericEnvironment S) t k 0 (snd (snd (snd (snd r)))))) $;

def sqSupportedProperty (n r .S .t .k .H: nat): wff =
 $ A. S A. t A. k A. H (sqEnvironmentSafe S n t k -> sqDomainSupport H S t ->
 sqSourceSupport H S t k (fst (snd r)) -> sqSupportedRowGoal r S t k H) $;

def sqSupportedAt (n r: nat): wff =
 $ sfRowWf r /\ (r <= n /\ sqSupportedProperty n r) $;

def sqSupportedGood (r .n: nat): wff = $ E. n sqSupportedAt n r $;

def sqSupportedClass (.r: nat): set = $ {r | sqSupportedGood r} $;

theorem sqSupportedRowGoal_sequent (G a S t k H: nat):
 $ sqSupportedRowGoal (sfSequent G a) S t k H <->
 kHypProvable H (sqQuote (sqNumericEnvironment S) t k 0 a) $;

theorem sqSupportedRowGoal_branches (G a b c S t k H: nat):
 $ sqSupportedRowGoal (sfBranches G a b c) S t k H <->
 (kHypProvable (sqQuote (sqNumericEnvironment S) t k 0 a : H) (sqQuote (sqNumericEnvironment S) t k 0 c) /\
 kHypProvable (sqQuote (sqNumericEnvironment S) t k 0 b : H) (sqQuote (sqNumericEnvironment S) t k 0 c)) $;

theorem sqSupportedProperty_at (n r S t k H: nat):
 $ sqSupportedProperty n r -> sqEnvironmentSafe S n t k -> sqDomainSupport H S t ->
 sqSourceSupport H S t k (fst (snd r)) -> sqSupportedRowGoal r S t k H $;

theorem sqSupportedAt_wf (n r: nat): $ sqSupportedAt n r -> sfRowWf r $;

theorem sqSupportedAt_bound (n r: nat): $ sqSupportedAt n r -> r <= n $;

theorem sqSupportedAt_property (n r: nat):
 $ sqSupportedAt n r -> sqSupportedProperty n r $;

theorem sqSupportedAt_intro (n r: nat):
 $ sfRowWf r -> r <= n -> sqSupportedProperty n r -> sqSupportedAt n r $;

theorem sqSupportedGood_intro (n r: nat): $ sqSupportedAt n r -> sqSupportedGood r $;

theorem sqSupportedGood_wf (r: nat): $ sqSupportedGood r -> sfRowWf r $;

theorem sqSupportedClass_value (r: nat):
 $ r e. sqSupportedClass <-> sqSupportedGood r $;

theorem sqSupportedAt_use (n r S t k H: nat):
 $ sqSupportedAt n r -> sqEnvironmentSafe S n t k -> sqDomainSupport H S t ->
 sqSourceSupport H S t k (fst (snd r)) -> sqSupportedRowGoal r S t k H $;

theorem sqSupportedAt_sequent (n G a S t k H: nat):
 $ sqSupportedAt n (sfSequent G a) -> sqEnvironmentSafe S n t k -> sqDomainSupport H S t ->
 sqSourceSupport H S t k G -> kHypProvable H (sqQuote (sqNumericEnvironment S) t k 0 a) $;

