        (syl anl (syl anl anr)) (syl anr (syl anl anr)) (syl anr anr))
      (exp @ rqBS_quantifier (syl hi anl)
        (syl anl (syl anl anr)) (syl anr (syl anl anr)) (syl anr anr)))));

theorem rqBS_depth_rename (x: nat) (c: nat):
  $ A. q (sfWf c -> sfRename (rawBinderMap x) (suc q) (sfRename (rawBinderMap x) q c) = sfShift (suc q) (sfRename (rawBinderMap x) q c)) <->
