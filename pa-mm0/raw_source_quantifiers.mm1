theorem rqBS_ind_use {j m: nat} (x: nat) (G: wff j m) (d c a: nat)
  (hi: $ G -> A. j (j < c -> A. m (sfWf j -> sfRename (rawBinderMap x) (suc m) (sfRename (rawBinderMap x) m j) = sfShift (suc m) (sfRename (rawBinderMap x) m j))) $)
  (ha: $ G -> a e. sfPrevious c $):
  $ G -> sfRename (rawBinderMap x) (suc d) (sfRename (rawBinderMap x) d a) = sfShift (suc d) (sfRename (rawBinderMap x) d a) $ =
'(mpd (syl anr (syl (bi1 sfPrevious_value) ha)) @
  syl rqBS_ind_depth @
  mpd (syl anl (syl (bi1 sfPrevious_value) ha)) (syl rqBS_ind_at hi));

theorem rqBS_tag1 (x: nat) (G: wff) (d c: nat) (ht: $ G -> sfTag c = 1 $):
  $ G -> sfRename (rawBinderMap x) (suc d) (sfRename (rawBinderMap x) d c) = sfShift (suc d) (sfRename (rawBinderMap x) d c) $ =
'(rqBS_transport (rqBC_rebuild ht) (a1i rqBS_mem));

theorem rqBS_tag2 (x: nat) (G: wff) (d c: nat) (ht: $ G -> sfTag c = 2 $):
  $ G -> sfRename (rawBinderMap x) (suc d) (sfRename (rawBinderMap x) d c) = sfShift (suc d) (sfRename (rawBinderMap x) d c) $ =
