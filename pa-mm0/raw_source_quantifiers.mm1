theorem rqBS_transport (x: nat) (G: wff) (d a b: nat)
  (h: $ G -> a = b $) (hc: $ G -> sfRename (rawBinderMap x) (suc d) (sfRename (rawBinderMap x) d b) = sfShift (suc d) (sfRename (rawBinderMap x) d b) $):
  $ G -> sfRename (rawBinderMap x) (suc d) (sfRename (rawBinderMap x) d a) = sfShift (suc d) (sfRename (rawBinderMap x) d a) $ =
'(eqtrd (sfRename_congr_formula (sfRename_congr_formula h)) (eqtrd hc (eqcomd (rqShift_formula (sfRename_congr_formula h)))));
theorem rqBS_ind_at (x: nat) (c a: nat):
  $ A. j (j < c -> A. m (sfWf j -> sfRename (rawBinderMap x) (suc m) (sfRename (rawBinderMap x) m j) = sfShift (suc m) (sfRename (rawBinderMap x) m j))) ->
      a < c -> A. m (sfWf a -> sfRename (rawBinderMap x) (suc m) (sfRename (rawBinderMap x) m a) = sfShift (suc m) (sfRename (rawBinderMap x) m a)) $ =
(named '(!! eale j ,eqtac));
theorem rqBS_ind_depth (x: nat) (d a: nat):
  $ A. m (sfWf a -> sfRename (rawBinderMap x) (suc m) (sfRename (rawBinderMap x) m a) = sfShift (suc m) (sfRename (rawBinderMap x) m a)) ->
      (sfWf a -> sfRename (rawBinderMap x) (suc d) (sfRename (rawBinderMap x) d a) = sfShift (suc d) (sfRename (rawBinderMap x) d a)) $ =
