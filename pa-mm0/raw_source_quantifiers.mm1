theorem rqBS_ex (G: wff) (x: nat) (d a: nat)
  (ha: $ G -> sfRename (rawBinderMap x) (suc (suc d)) (sfRename (rawBinderMap x) (suc d) a) = sfShift (suc (suc d)) (sfRename (rawBinderMap x) (suc d) a) $):
