theorem rqBS_tag4 (x: nat) (G: wff) (d c: nat)
  (ht: $ G -> sfTag c = 4 $)
  (hl: $ G -> sfRename (rawBinderMap x) (suc d) (sfRename (rawBinderMap x) d (sfLeft c)) = sfShift (suc d) (sfRename (rawBinderMap x) d (sfLeft c)) $)
  (hr: $ G -> sfRename (rawBinderMap x) (suc d) (sfRename (rawBinderMap x) d (sfRight c)) = sfShift (suc d) (sfRename (rawBinderMap x) d (sfRight c)) $):
