theorem rqBS_alpha (x: nat) (c: nat):
  $ A. q (sfWf c -> sfRename (rawBinderMap x) (suc q) (sfRename (rawBinderMap x) q c) = sfShift (suc q) (sfRename (rawBinderMap x) q c)) <->
    A. m (sfWf c -> sfRename (rawBinderMap x) (suc m) (sfRename (rawBinderMap x) m c) = sfShift (suc m) (sfRename (rawBinderMap x) m c)) $ =
'rqBS_depth_rename;
theorem rqBS_wf_step {j m: nat} (x: nat) (G: wff j m) (c: nat)
  (hi: $ G -> A. j (j < c -> A. m (sfWf j -> sfRename (rawBinderMap x) (suc m) (sfRename (rawBinderMap x) m j) = sfShift (suc m) (sfRename (rawBinderMap x) m j))) $):
  $ G -> A. m (sfWf c -> sfRename (rawBinderMap x) (suc m) (sfRename (rawBinderMap x) m c) = sfShift (suc m) (sfRename (rawBinderMap x) m c)) $ =
