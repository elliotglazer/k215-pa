theorem rqBS_tag6 (x: nat) (G: wff) (d c: nat)
  (ht: $ G -> sfTag c = 6 $) (hz: $ G -> sfRight c = 0 $)
  (hl: $ G -> sfRename (rawBinderMap x) (suc (suc d)) (sfRename (rawBinderMap x) (suc d) (sfLeft c)) = sfShift (suc (suc d)) (sfRename (rawBinderMap x) (suc d) (sfLeft c)) $):
  $ G -> sfRename (rawBinderMap x) (suc d) (sfRename (rawBinderMap x) d c) = sfShift (suc d) (sfRename (rawBinderMap x) d c) $ =
'(rqBS_transport (rqBC_rebuild_quantifier ht hz) (rqBS_all hl));

theorem rqBS_tag7 (x: nat) (G: wff) (d c: nat)
  (ht: $ G -> sfTag c = 7 $) (hz: $ G -> sfRight c = 0 $)
  (hl: $ G -> sfRename (rawBinderMap x) (suc (suc d)) (sfRename (rawBinderMap x) (suc d) (sfLeft c)) = sfShift (suc (suc d)) (sfRename (rawBinderMap x) (suc d) (sfLeft c)) $):
  $ G -> sfRename (rawBinderMap x) (suc d) (sfRename (rawBinderMap x) d c) = sfShift (suc d) (sfRename (rawBinderMap x) d c) $ =
'(rqBS_transport (rqBC_rebuild_quantifier ht hz) (rqBS_ex hl));

theorem rqBS_binary {j m: nat} (x: nat) (G: wff j m) (d c: nat)
  (hi: $ G -> A. j (j < c -> A. m (sfWf j -> sfRename (rawBinderMap x) (suc m) (sfRename (rawBinderMap x) m j) = sfShift (suc m) (sfRename (rawBinderMap x) m j))) $)
  (ht: $ G -> (sfTag c = 3 \/ sfTag c = 4 \/ sfTag c = 5) $)
  (hl: $ G -> sfLeft c e. sfPrevious c $)
  (hr: $ G -> sfRight c e. sfPrevious c $):
  $ G -> sfRename (rawBinderMap x) (suc d) (sfRename (rawBinderMap x) d c) = sfShift (suc d) (sfRename (rawBinderMap x) d c) $ =
'(mpd ht (eord (eord (exp @ rqBS_tag3 anr (rqBS_ind_use (syl hi anl) (syl hl anl)) (rqBS_ind_use (syl hi anl) (syl hr anl))) (exp @ rqBS_tag4 anr (rqBS_ind_use (syl hi anl) (syl hl anl)) (rqBS_ind_use (syl hi anl) (syl hr anl)))) (exp @ rqBS_tag5 anr (rqBS_ind_use (syl hi anl) (syl hl anl)) (rqBS_ind_use (syl hi anl) (syl hr anl)))));

theorem rqBS_quantifier {j m: nat} (x: nat) (G: wff j m) (d c: nat)
  (hi: $ G -> A. j (j < c -> A. m (sfWf j -> sfRename (rawBinderMap x) (suc m) (sfRename (rawBinderMap x) m j) = sfShift (suc m) (sfRename (rawBinderMap x) m j))) $)
  (ht: $ G -> (sfTag c = 6 \/ sfTag c = 7) $)
  (hz: $ G -> sfRight c = 0 $) (hl: $ G -> sfLeft c e. sfPrevious c $):
  $ G -> sfRename (rawBinderMap x) (suc d) (sfRename (rawBinderMap x) d c) = sfShift (suc d) (sfRename (rawBinderMap x) d c) $ =
'(mpd ht (eord (exp @ rqBS_tag6 anr (syl hz anl) (rqBS_ind_use (syl hi anl) (syl hl anl))) (exp @ rqBS_tag7 anr (syl hz anl) (rqBS_ind_use (syl hi anl) (syl hl anl)))));

theorem rqBS_allowed {j m: nat} (x: nat) (G: wff j m) (d c: nat)
  (hi: $ G -> A. j (j < c -> A. m (sfWf j -> sfRename (rawBinderMap x) (suc m) (sfRename (rawBinderMap x) m j) = sfShift (suc m) (sfRename (rawBinderMap x) m j))) $):
  $ G -> sfAllowed c (sfPrevious c) -> sfRename (rawBinderMap x) (suc d) (sfRename (rawBinderMap x) d c) = sfShift (suc d) (sfRename (rawBinderMap x) d c) $ =
