  syl5bi sfWf_unfold (rqBS_allowed hi));
theorem rqBS_uniform (x: nat) (c: nat):
  $ A. m (sfWf c -> sfRename (rawBinderMap x) (suc m) (sfRename (rawBinderMap x) m c) = sfShift (suc m) (sfRename (rawBinderMap x) m c)) $ =
(named '(trud @ !! indstr j y
  {,eqtac : $ j = c -> (A. m (sfWf j -> sfRename (rawBinderMap x) (suc m) (sfRename (rawBinderMap x) m j) = sfShift (suc m) (sfRename (rawBinderMap x) m j)) <-> A. m (sfWf c -> sfRename (rawBinderMap x) (suc m) (sfRename (rawBinderMap x) m c) = sfShift (suc m) (sfRename (rawBinderMap x) m c))) $}
  ,eqtac (rqBS_wf_step anr)));
pub theorem rqBinder_shadow (x: nat) (d c: nat):
  $ sfWf c -> sfRename (rawBinderMap x) (suc d) (sfRename (rawBinderMap x) d c) = sfShift (suc d) (sfRename (rawBinderMap x) d c) $ =
(named '(ax_mp rqBS_ind_depth
  {rqBS_uniform : $ A. m (sfWf c -> sfRename (rawBinderMap x) (suc m) (sfRename (rawBinderMap x) m c) = sfShift (suc m) (sfRename (rawBinderMap x) m c)) $}));



theorem rqLocal_congr (H: wff) (G D a b: nat) (hg: $ H -> G = D $) (ha: $ H -> a = b $):
  $ H -> (nsLocal G a <-> nsLocal D b) $ =
(named '(exeqd @ aneq2d @ lmemeqd (sfSequent_congr hg ha) eqidd));

theorem rqLocal_AllI (G a: nat) (hg: $ sfContextWf G $) (ha: $ sfWf a $):
  $ nsLocal (sfContextShift G) a -> nsLocal G (sfAll a) $ =
(named '(eex @ syl nsLocal_intro @ ax_mp sfNDFullDerives_AllI (ax_mp (ax_mp sfRowWf_sequent_intro hg) (ax_mp sfWf_all ha))));

@_ abstract def rqVacContext (q: nat): nat = $ sfImp q sfBot : 0 $;

@_ abstract def rqVacShiftContext (q: nat): nat = $ sfImp (sfShift 0 q) sfBot : 0 $;

@_ abstract def rqVacDeepContext (q: nat): nat = $ sfShift 0 q : rqVacShiftContext q $;

theorem rqVac_shift (q: nat):
  $ sfContextShift (rqVacContext q) = rqVacShiftContext q $ =
'(eqtr sfContextShift_cons (conseq (eqtr sfShift_sfImp (rqImp_congr eqid sfShift_bot)) sfContextShift_nil));

theorem rqVac_deep_wf (q: nat):
  $ sfContextWf (rqVacDeepContext q) $ =
'(ax_mp (bi2 sfContextWf_cons) (iani sfShift_wf (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp sfShift_wf) sfWf_bot) sfContextWf_nil))));

theorem rqVac_bot (q: nat):
  $ nsLocal (rqVacDeepContext q) sfBot $ =
'(ax_mp (ax_mp nsLocal_mp (ax_mp (ax_mp nsLocal_hyp rqVac_deep_wf) (ax_mp sfContext_member_tail sfContext_member_head))) (ax_mp (ax_mp nsLocal_hyp rqVac_deep_wf) sfContext_member_head));

pub theorem rqVacuous_provable (q a: nat) (hq: $ sfWf q $) (ha: $ sfWf a $):
  $ zfcProvable (sfImp (sfImp q sfBot) (sfAll (sfImp (sfShift 0 q) a))) $ =
'(ax_mp (ax_mp nsLocal_to_ZFC zfcContext_nil) (ax_mp nsLocal_II (ax_mp (rqLocal_AllI (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp hq) sfWf_bot) sfContextWf_nil)) (ax_mp (ax_mp sfWf_imp sfShift_wf) ha)) (mpbir (trud (rqLocal_congr (a1i rqVac_shift) eqidd)) (ax_mp nsLocal_II (ax_mp (ax_mp rqLocal_explosion ha) rqVac_bot))))));

@_ abstract def rqCLBase (q u b c: nat): nat = $ ((sfImp u b) : ((sfImp q c) : ((sfImp b sfBot) : ((sfImp (sfImp q sfBot) u) : 0)))) $;

@_ abstract def rqCLDeep (q u b c: nat): nat = $ ((sfImp c sfBot) : ((sfImp u b) : ((sfImp q c) : ((sfImp b sfBot) : ((sfImp (sfImp q sfBot) u) : 0))))) $;

@_ abstract def rqCLSuper (q u b c: nat): nat = $ (q : ((sfImp c sfBot) : ((sfImp u b) : ((sfImp q c) : ((sfImp b sfBot) : ((sfImp (sfImp q sfBot) u) : 0)))))) $;

pub theorem rqClassical_provable (q u b c: nat) (hq: $ sfWf q $) (hu: $ sfWf u $) (hb: $ sfWf b $) (hc: $ sfWf c $):
  $ zfcProvable (sfImp (sfImp (sfImp q sfBot) u) (sfImp (sfImp b sfBot) (sfImp (sfImp q c) (sfImp (sfImp u b) c)))) $ =
'(ax_mp (ax_mp nsLocal_to_ZFC zfcContext_nil) (ax_mp nsLocal_II (ax_mp nsLocal_II (ax_mp nsLocal_II (ax_mp nsLocal_II (ax_mp (ax_mp nsLocal_mp (ax_mp nsLocal_intro (ax_mp (ax_mp (ax_mp zfcNDPeirce_derives (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp hu) hb) (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp hq) hc) (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp hb) sfWf_bot) (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp (ax_mp (ax_mp sfWf_imp hq) sfWf_bot)) hu) sfContextWf_nil))))))))) hc) sfWf_bot))) (ax_mp nsLocal_II (ax_mp (ax_mp rqLocal_explosion hc) (ax_mp (ax_mp nsLocal_mp (ax_mp (ax_mp nsLocal_hyp (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp hc) sfWf_bot) (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp hu) hb) (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp hq) hc) (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp hb) sfWf_bot) (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp (ax_mp (ax_mp sfWf_imp hq) sfWf_bot)) hu) sfContextWf_nil))))))))))) (ax_mp sfContext_member_tail (ax_mp sfContext_member_tail (ax_mp sfContext_member_tail sfContext_member_head))))) (ax_mp (ax_mp nsLocal_mp (ax_mp (ax_mp nsLocal_hyp (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp hc) sfWf_bot) (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp hu) hb) (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp hq) hc) (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp hb) sfWf_bot) (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp (ax_mp (ax_mp sfWf_imp hq) sfWf_bot)) hu) sfContextWf_nil))))))))))) (ax_mp sfContext_member_tail sfContext_member_head))) (ax_mp (ax_mp nsLocal_mp (ax_mp (ax_mp nsLocal_hyp (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp hc) sfWf_bot) (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp hu) hb) (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp hq) hc) (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp hb) sfWf_bot) (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp (ax_mp (ax_mp sfWf_imp hq) sfWf_bot)) hu) sfContextWf_nil))))))))))) (ax_mp sfContext_member_tail (ax_mp sfContext_member_tail (ax_mp sfContext_member_tail (ax_mp sfContext_member_tail sfContext_member_head)))))) (ax_mp nsLocal_II (ax_mp (ax_mp nsLocal_mp (ax_mp (ax_mp nsLocal_hyp (ax_mp (bi2 sfContextWf_cons) (iani hq (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp hc) sfWf_bot) (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp hu) hb) (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp hq) hc) (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp hb) sfWf_bot) (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp (ax_mp (ax_mp sfWf_imp hq) sfWf_bot)) hu) sfContextWf_nil))))))))))))) (ax_mp sfContext_member_tail sfContext_member_head))) (ax_mp (ax_mp nsLocal_mp (ax_mp (ax_mp nsLocal_hyp (ax_mp (bi2 sfContextWf_cons) (iani hq (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp hc) sfWf_bot) (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp hu) hb) (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp hq) hc) (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp hb) sfWf_bot) (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp (ax_mp (ax_mp sfWf_imp hq) sfWf_bot)) hu) sfContextWf_nil))))))))))))) (ax_mp sfContext_member_tail (ax_mp sfContext_member_tail (ax_mp sfContext_member_tail sfContext_member_head))))) (ax_mp (ax_mp nsLocal_hyp (ax_mp (bi2 sfContextWf_cons) (iani hq (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp hc) sfWf_bot) (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp hu) hb) (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp hq) hc) (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp hb) sfWf_bot) (ax_mp (bi2 sfContextWf_cons) (iani (ax_mp (ax_mp sfWf_imp (ax_mp (ax_mp sfWf_imp hq) sfWf_bot)) hu) sfContextWf_nil))))))))))))) sfContext_member_head)))))))))))))));

@_ abstract def rqQuantified (a b: nat): nat = $ sfAll (sfRename (rawBinderMap a) 0 (rawDecode b)) $;

@_ abstract def rqBad (a: nat): nat = $ sfRename (rawBinderMap a) 0 (sfMem 0 0) $;

@_ abstract def rqUniversalNegation (a b: nat): nat = $ sfAll (sfImp (sfShift 0 (rqQuantified a b)) (rqBad a)) $;

theorem rqQuantified_shadow (a b: nat):
  $ sfRename (rawBinderMap a) 0 (rqQuantified a b) = sfShift 0 (rqQuantified a b) $ =
'(eqtr sfRename_sfAll (eqtr (rqAll_congr (ax_mp rqBinder_shadow rawDecode_wf)) (eqcom sfShift_sfAll)));

theorem rqExistsAll_decode (a b: nat):
  $ rawDecode (kExists a (kAll a b)) = sfImp (rqUniversalNegation a b) (sfMem 0 0) $ =
'(eqtr rqExists_decode (rqImp_congr (rqAll_congr (eqtr (rqRename_eq (rqImp_congr rawDecode_kAll eqid)) (eqtr sfRename_sfImp (rqImp_congr rqQuantified_shadow eqid)))) eqid));

theorem rqQuantified_instance (a b: nat):
  $ zfcProvable (sfImp (rqQuantified a b) (rawDecode b)) $ =
'(mpbi (trud (rqProvable_congr (sfImp_congr_right (a1i (ax_mp rqBinder_cancel rawDecode_wf))))) (rqAllE_provable sfRename_wf));

theorem rqUniversalNegation_provable (a b: nat):
  $ zfcProvable (sfImp (sfImp (rqQuantified a b) sfBot) (rqUniversalNegation a b)) $ =
'(rqVacuous_provable (ax_mp sfWf_all sfRename_wf) sfRename_wf);

theorem rqRow6_source (a b: nat):
  $ zfcProvable (sfImp (sfImp (rqUniversalNegation a b) (sfMem 0 0)) (rawDecode b)) $ =
'(ax_mp (ax_mp zfcProvable_mp (ax_mp (ax_mp zfcProvable_mp (ax_mp (ax_mp zfcProvable_mp (rqClassical_provable (ax_mp sfWf_all sfRename_wf) (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfShift_wf) sfRename_wf)) sfWf_mem rawDecode_wf)) rqUniversalNegation_provable)) zfcProvable_no_self)) rqQuantified_instance);

theorem rqImp_left_nonzero (a b: nat):
  $ a != 0 -> kImp a b != 0 $ =
'(con3 (syl anl (bi1 raw_kImp_zero_iff)));

theorem rqRow6_decode (a b: nat):
  $ rawDecode (kRho6 a b) = sfImp (sfImp (rqUniversalNegation a b) (sfMem 0 0)) (rawDecode b) $ =
'(eqtr (ax_mp rawDecode_kImp (ax_mp rqImp_left_nonzero (ax_mp rqImp_right_nonzero peano1))) (rqImp_congr rqExistsAll_decode eqid));

pub theorem rawSource_rho6 (a b: nat):
  $ zfcProvable (rawDecode (kRho6 a b)) $ =
'(mpbir (trud (rqProvable_congr (a1i rqRow6_decode))) rqRow6_source);
