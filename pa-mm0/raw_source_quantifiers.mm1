  (ha: $ G -> sfRename (rawBinderMap x) (suc d) (sfRename (rawBinderMap x) d a) = sfShift (suc d) (sfRename (rawBinderMap x) d a) $) (hb: $ G -> sfRename (rawBinderMap x) (suc d) (sfRename (rawBinderMap x) d b) = sfShift (suc d) (sfRename (rawBinderMap x) d b) $):
  $ G -> sfRename (rawBinderMap x) (suc d) (sfRename (rawBinderMap x) d (sfImp a b)) = sfShift (suc d) (sfRename (rawBinderMap x) d (sfImp a b)) $ =
'(eqtrd (a1i (eqtr (rqRename_eq sfRename_sfImp) sfRename_sfImp)) (eqtrd (sfImp_congr ha hb) (a1i (eqcom (eqtr (rqShift_eq sfRename_sfImp) sfShift_sfImp)))));

theorem rqBS_all (G: wff) (x: nat) (d a: nat)
  (ha: $ G -> sfRename (rawBinderMap x) (suc (suc d)) (sfRename (rawBinderMap x) (suc d) a) = sfShift (suc (suc d)) (sfRename (rawBinderMap x) (suc d) a) $):
  $ G -> sfRename (rawBinderMap x) (suc d) (sfRename (rawBinderMap x) d (sfAll a)) = sfShift (suc d) (sfRename (rawBinderMap x) d (sfAll a)) $ =
