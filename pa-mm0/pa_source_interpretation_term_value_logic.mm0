import "pa_source_interpretation_formula_eqd_support.mm0";

import "pa_axiom_syntax_propositional_images.mm0";

theorem paSourceValue_imp_weaken (g a: nat): $ sfWf g -> sfWf a -> zfcProvable a -> zfcProvable (sfImp g a) $;

theorem paSourceValue_imp_trans (a b c: nat): $ sfWf a -> sfWf b -> sfWf c -> zfcProvable (sfImp a b) -> zfcProvable (sfImp b c) -> zfcProvable (sfImp a c) $;

theorem paSourceValue_guarded_mp (g a b: nat): $ sfWf g -> sfWf a -> sfWf b -> zfcProvable (sfImp g (sfImp a b)) -> zfcProvable (sfImp g a) -> zfcProvable (sfImp g b) $;
