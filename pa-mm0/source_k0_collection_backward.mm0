import "source_k0_collection_support.mm0";

import "quotation_freshness.mm0";

import "k218_role_substitution.mm0";

theorem sfK0Collection_support_witness (E: set) (n b t r a c u y x R psi: nat) (hf: $ sfBound (suc (suc n)) psi $)
 (huR: $ u < R $) (hu0: $ u != 0 $)
 (hut: $ u != t $) (hub: $ u != b $) (huy: $ u != y $)
 (hux: $ u != x $) (hua: $ u != a $) (heu: $ sqEnvAvoid E n u $)
 (hyt: $ y != t $) (hyb: $ y != b $):
 $ k218QProvable (kImp (kImp (kMem t b) kF) (kImp (kImp (kMem t t) kF) (kImp (kMem t y) (kImp (kImp (kAll u (kImp (kImp (kImp (kImp (kImp (kEq u r) (kImp (kEq y b) kF)) kF) kF) (kImp (kImp (kImp (kImp (kEq u t) (kImp (kEq y t) kF)) kF) kF) (kImp (kAll x (kImp (kImp (kImp (sfK0QSepNamedSingleton x u R) (kImp (kImp (kImp (kImp (kImp (kMem t x) (kImp (kMem x a) kF)) kF) (kImp (kImp (kImp (kMem t y) (kImp (sfK0CollectionRel E R y x psi) kF)) kF) kF)) kF) kF)) kF) kF)) kF))) kF)) kF) (kImp (kAll x (kImp (kImp (kImp (kImp (kImp (kMem t x) (kImp (kMem x a) kF)) kF) (kImp (sfK0CollectionRel E R y x psi) kF)) kF) kF)) kF))))) $;

theorem sfK0Collection_support_backward (E: set) (n b t r a c u y x R psi: nat) (hf: $ sfBound (suc (suc n)) psi $)
 (huR: $ u < R $) (hu0: $ u != 0 $)
 (hut: $ u != t $) (hub: $ u != b $) (huy: $ u != y $)
 (hux: $ u != x $) (hua: $ u != a $) (heu: $ sqEnvAvoid E n u $)
 (hyt: $ y != t $) (hyb: $ y != b $):
 $ k218QProvable (kImp (kImp (kMem t b) kF) (kImp (kImp (kMem t t) kF) (kImp (kAll y (kImp (kMem y c) (kImp (kAll u (kImp (kImp (kImp (kImp (kImp (kEq u r) (kImp (kEq y b) kF)) kF) kF) (kImp (kImp (kImp (kImp (kEq u t) (kImp (kEq y t) kF)) kF) kF) (kImp (kAll x (kImp (kImp (kImp (sfK0QSepNamedSingleton x u R) (kImp (kImp (kImp (kImp (kImp (kMem t x) (kImp (kMem x a) kF)) kF) (kImp (kImp (kImp (kMem t y) (kImp (sfK0CollectionRel E R y x psi) kF)) kF) kF)) kF) kF)) kF) kF)) kF))) kF)) kF))) (kAll y (kImp (kImp (kImp (kMem t y) (kImp (kMem y c) kF)) kF) (kImp (kAll x (kImp (kImp (kImp (kImp (kImp (kMem t x) (kImp (kMem x a) kF)) kF) (kImp (sfK0CollectionRel E R y x psi) kF)) kF) kF)) kF)))))) $;
