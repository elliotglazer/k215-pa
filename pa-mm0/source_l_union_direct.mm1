import "source_l_union_direct_replay.mm1";

@_ def sfLDefUnion: nat = $ slUDFormula $;
pub theorem sfLDefUnion_context: $ slUDContext = sfLBackground $ = 'eqid;
pub theorem sfLDefUnion_local: $ nsLocal sfLBackground sfLDefUnion $ = '(mpbi (nsLocal_context_eq sfLDefUnion_context) slUDCertificate);
pub theorem sfLDefUnion_zfr: $ sfTheoryProvable zfrAxioms sfLDefUnion $ = '(ax_mp (sfTheory_local sfLBackground_zfr) sfLDefUnion_local);
