import "k215_calculus_source_ax_unpair452.mm1";
import "k215_calculus_source_ax_pair463.mm1";
import "k218_codes.mm1";

theorem k215BinaryUnpairInAt452 (u t w c a b v: nat): $ (k215UnpairAt452State k215PNum452 0 0 w (k215PVector u t w c a b 0 0 v)) = (k215PState k215PNum452 (k215PVector u t w c a b 0 0 v)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector eqid k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryUnpairOutAt452 (u t w c a b v: nat): $ (k215UnpairAt452State k215PNum460 (fst w) (snd w) 0 (k215PVector u t w c a b 0 0 v)) = (k215PState k215PNum460 (k215PVector u t 0 c a b (fst w) (snd w) v)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector eqid k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryUnpairAt452 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum452 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum460 (k215PVector u t 0 c a b (fst w) (snd w) v)) $ =
 '(mpbi (k215PReacheq k215BinaryUnpairInAt452 k215BinaryUnpairOutAt452) k215UnpairMacro452_clean);

theorem k215BinaryRestoreStackAt452 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum460 (k215PVector u t 0 c a b (fst w) (snd w) v)) (k215PState k215PNum463 (k215PVector u t (snd w) c a b (fst w) 0 v)) $ =
 '(k215PReach_intro (eqtr k215Loop460Vector (k215PStateeq2 (k215PVectoreq3 add0))));

theorem k215BinaryPairInAt452 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt463State k215PNum463 a6 a1 a7 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum463 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryPairOutAt452 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt463State k215PNum473 0 0 (a7 + (a6, a1)) (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum473 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryPairAt452 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat):
 $ k215PReach (k215PState k215PNum463 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215PNum473 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ =
 '(mpbi (k215PReacheq k215BinaryPairInAt452 k215BinaryPairOutAt452) k215PairMacro463);

theorem k215BinaryPairCleanAt452 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum463 (k215PVector u t (snd w) c a b (fst w) 0 v)) (k215PState k215PNum473 (k215PVector u 0 (snd w) c a b 0 (fst w, t) v)) $ =
 '(mpbi (k215PReacheq2 (k215PStateeq2 (k215PVectoreq8 add01))) k215BinaryPairAt452);
theorem k215BinaryFourAt452 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum473 (k215PVector u 0 (snd w) c a b 0 (fst w, t) v)) (k215PState k215PNum479 (k215PVector u (4 * (fst w, t)) (snd w) c a b 0 0 v)) $ =
 '(k215PReach_intro (eqtr k215Loop473Vector (k215PStateeq2 (k215PVectoreq2 add0))));

theorem k215BinaryTagAllAt452 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum479 (k215PVector u (4 * (fst w, t)) (snd w) c a b 0 0 v)) (k215PState k215PNum479 (k215PVector u (kImp (fst w) t) (snd w) c a b 0 0 v)) $ = 'k215PReach_refl;

pub theorem k215BinaryConstructor452 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum452 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum479 (k215PVector u (kImp (fst w) t) (snd w) c a b 0 0 v)) $ = '(ax_mp (ax_mp k215PReach_trans k215BinaryUnpairAt452) (ax_mp (ax_mp k215PReach_trans k215BinaryRestoreStackAt452) (ax_mp (ax_mp k215PReach_trans k215BinaryPairCleanAt452) (ax_mp (ax_mp k215PReach_trans k215BinaryFourAt452) k215BinaryTagAllAt452))));

