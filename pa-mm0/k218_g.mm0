import "k218_quantifier_derived.mm0";
import "k230_bootstrap.mm0";
import "raw_source_image.mm0";

-- Actual finite proofs recovering the old equality row from SeedG.
-- The seed bundle and the two theorem predicates remain distinct.
theorem k218Imp_mono_right (a b c: nat)
  (h: $ k218Provable (kImp a b) $):
  $ k218Provable (kImp (kImp c a) (kImp c b)) $;

theorem k218All_exists (r a b: nat):
  $ k218Provable (kImp (kAll r (kImp a b))
    (kImp (kExists r a) (kExists r b))) $;

theorem k218Equality_reflexive (x: nat): $ k218Provable (kEq x x) $;

theorem k218Equality_helper (a b: nat):
  $ k218Provable (kImp (kEq a b) (kAll (kMem a b) (kEq a b))) $;

theorem k218Equality_specialize (a b: nat):
  $ k218Provable (kImp (kAll (kMem a b) (kEq a b)) (kEq a b)) $;

theorem k218Rho7_recovered (a b c: nat): $ k218Provable (kRho7 a b c) $;

theorem k218G_old_helper (a b: nat):
  $ kProvable (kImp (kEq a b) (kAll (kMem a b) (kEq a b))) $;

theorem k218G_in_oldK (a b c: nat): $ kProvable (k218RhoG a b c) $;
