import "extracted_named_conditional.mm0";

theorem exNamedAt_mono (p q G a: nat)
 (hle: $ p <= q $)
 (hp: $ exNamedAt p G a $)
: $ exNamedAt q G a $;

theorem exNamedAt_Ctx (p G a: nat)
 (hm: $ a IN G $)
: $ exNamedAt p G a $;

theorem exNamedAt_Pc (p G a b: nat)
: $ exNamedAt p G (sfImp (sfImp (sfImp a b) a) a) $;

theorem exNamedAt_Wk (p G J a: nat)
 (hsub: $ sfContextSub J G $)
 (hp: $ exNamedAt p J a $)
: $ exNamedAt p G a $;

theorem exNamedAt_II (p G a b: nat)
 (hp: $ exNamedAt p (a : G) b $)
: $ exNamedAt p G (sfImp a b) $;

theorem exNamedAt_Exp (p G a: nat)
 (hp: $ exNamedAt p G sfBot $)
: $ exNamedAt p G a $;

theorem exNamedAt_CE1 (p G a b: nat)
 (hp: $ exNamedAt p G (sfAnd a b) $)
: $ exNamedAt p G a $;

theorem exNamedAt_CE2 (p G a b: nat)
 (hp: $ exNamedAt p G (sfAnd a b) $)
: $ exNamedAt p G b $;

theorem exNamedAt_DI1 (p G a b: nat)
 (hp: $ exNamedAt p G a $)
: $ exNamedAt p G (sfOr a b) $;

theorem exNamedAt_DI2 (p G a b: nat)
 (hp: $ exNamedAt p G b $)
: $ exNamedAt p G (sfOr a b) $;

theorem exNamedAt_IE (p G a b: nat)
 (hp: $ exNamedAt p G a $)
 (hq: $ exNamedAt p G (sfImp a b) $)
: $ exNamedAt p G b $;

theorem exNamedAt_CI (p G a b: nat)
 (hp: $ exNamedAt p G a $)
 (hq: $ exNamedAt p G b $)
: $ exNamedAt p G (sfAnd a b) $;

theorem exNamedAt_DE (p G a b c: nat)
 (hp: $ exNamedAt p G (sfOr a b) $)
 (hq: $ exNamedAt p (a : G) c $)
 (hr: $ exNamedAt p (b : G) c $)
: $ exNamedAt p G c $;

theorem exNamedAt_AllE (p G i a: nat)
 (ha: $ sfBound (suc p) a $)
 (hi: $ i < p $)
 (hp: $ exNamedAt p G (sfAll a) $)
: $ exNamedAt p G (sfSubst 0 i a) $;

theorem exNamedAt_ExI (p G i a: nat)
 (ha: $ sfBound (suc p) a $)
 (hi: $ i < p $)
 (hp: $ exNamedAt p G (sfSubst 0 i a) $)
: $ exNamedAt p G (sfEx a) $;
