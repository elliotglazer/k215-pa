import "k215_calculus_source_ax_pair729.mm1";
import "k215_calculus_source_ax_stack_loops.mm1";

theorem k215PairVectorInAt723 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt729State k215PNum729 a6 a1 a7 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum729 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215PairVectorOutAt723 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt729State k215PNum739 0 0 (a7 + (a6, a1)) (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum739 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

pub theorem k215PairMacro46_vectorAt723 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat):
 $ k215PReach (k215PState k215PNum729 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215PNum739 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ =
 '(mpbi (k215PReacheq k215PairVectorInAt723 k215PairVectorOutAt723) k215PairMacro729);

theorem k215PushAStage0At723 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum723 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum726 (k215PVector u 0 w c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop723Vector (k215PStateeq2 (k215PVectoreq7 add0))));

theorem k215PushAStage1At723 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum726 (k215PVector u 0 w c a b t 0 v)) (k215PState k215PNum729 (k215PVector u w 0 c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop726Vector (k215PStateeq2 (k215PVectoreq2 add0))));

theorem k215PushAStage2At723 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum729 (k215PVector u w 0 c a b t 0 v)) (k215PState k215PNum739 (k215PVector u 0 0 c a b 0 (t, w) v)) $ = '(mpbi (k215PReacheq2 (k215PStateeq2 (k215PVectoreq8 add01))) k215PairMacro46_vectorAt723);

theorem k215PushAStage3At723 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum739 (k215PVector u 0 0 c a b 0 (t, w) v)) (k215PState k215PNum742 (k215PVector u 0 (t, w) c a b 0 0 v)) $ = '(k215PReach_intro (eqtr k215Loop739Vector (k215PStateeq2 (k215PVectoreq3 add0))));

theorem k215PushAStage4At723 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum742 (k215PVector u 0 (t, w) c a b 0 0 v)) (k215PState k215PNum746 (k215PVector u a (t, w) c 0 b a 0 v)) $ = '(k215PReach_intro (eqtr k215Loop742Vector (k215PStateeq2 (k215PVectoreq eqid add0 eqid eqid eqid eqid add0 eqid eqid))));

theorem k215PushAStage5At723 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum746 (k215PVector u a (t, w) c 0 b a 0 v)) (k215PState k215PNum749 (k215PVector u a (t, w) c a b 0 0 v)) $ = '(k215PReach_intro (eqtr k215Loop746Vector (k215PStateeq2 (k215PVectoreq5 add0))));

pub theorem k215PushParam723 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum723 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum749 (k215PVector u a (t, w) c a b 0 0 v)) $ = '(ax_mp (ax_mp k215PReach_trans k215PushAStage0At723) (ax_mp (ax_mp k215PReach_trans k215PushAStage1At723) (ax_mp (ax_mp k215PReach_trans k215PushAStage2At723) (ax_mp (ax_mp k215PReach_trans k215PushAStage3At723) (ax_mp (ax_mp k215PReach_trans k215PushAStage4At723) k215PushAStage5At723)))));

