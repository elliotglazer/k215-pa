import "pa_proof_numeral_mp.mm0";

import "pa_source_interpretation_term_subst_cancel.mm0";

theorem paProofNumeralClosed_rename (R: set) (c: nat): $ paTermBound 0 c -> paTermRename R c = c $;

theorem paProofNumeralClosed_lift (d c: nat): $ paTermBound 0 c -> paTermLift d c = c $;

theorem paProofNumeralClosed_shift (d c: nat): $ paTermBound 0 c -> paTermShift d c = c $;

theorem paProofNumeralClosed_bound (n c: nat): $ paTermBound 0 c -> paTermBound n c $;

theorem paProofNumeralClosed_substitution (d a c: nat): $ paTermBound 0 c -> paTermSubst d a c = c $;
