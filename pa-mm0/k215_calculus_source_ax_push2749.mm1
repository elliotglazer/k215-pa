theorem k215PairVectorInAt2749 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt2755State k215PNum2755 a6 a1 a7 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum2755 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215PairVectorOutAt2749 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt2755State k215PNum2765 0 0 (a7 + (a6, a1)) (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum2765 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

pub theorem k215PairMacro46_vectorAt2749 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat):
 $ k215PReach (k215PState k215PNum2755 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215PNum2765 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ =
 '(mpbi (k215PReacheq k215PairVectorInAt2749 k215PairVectorOutAt2749) k215PairMacro2755);

theorem k215PushAStage0At2749 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum2749 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum2752 (k215PVector u 0 w c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop2749Vector (k215PStateeq2 (k215PVectoreq7 add0))));

theorem k215PushAStage1At2749 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum2752 (k215PVector u 0 w c a b t 0 v)) (k215PState k215PNum2755 (k215PVector u w 0 c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop2752Vector (k215PStateeq2 (k215PVectoreq2 add0))));

theorem k215PushAStage2At2749 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum2755 (k215PVector u w 0 c a b t 0 v)) (k215PState k215PNum2765 (k215PVector u 0 0 c a b 0 (t, w) v)) $ = '(mpbi (k215PReacheq2 (k215PStateeq2 (k215PVectoreq8 add01))) k215PairMacro46_vectorAt2749);

theorem k215PushAStage3At2749 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum2765 (k215PVector u 0 0 c a b 0 (t, w) v)) (k215PState k215PNum2768 (k215PVector u 0 (t, w) c a b 0 0 v)) $ = '(k215PReach_intro (eqtr k215Loop2765Vector (k215PStateeq2 (k215PVectoreq3 add0))));

theorem k215PushAStage4At2749 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum2768 (k215PVector u 0 (t, w) c a b 0 0 v)) (k215PState k215PNum2772 (k215PVector u a (t, w) c 0 b a 0 v)) $ = '(k215PReach_intro (eqtr k215Loop2768Vector (k215PStateeq2 (k215PVectoreq eqid add0 eqid eqid eqid eqid add0 eqid eqid))));

theorem k215PushAStage5At2749 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum2772 (k215PVector u a (t, w) c 0 b a 0 v)) (k215PState k215PNum2775 (k215PVector u a (t, w) c a b 0 0 v)) $ = '(k215PReach_intro (eqtr k215Loop2772Vector (k215PStateeq2 (k215PVectoreq5 add0))));

pub theorem k215PushParam2749 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum2749 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum2775 (k215PVector u a (t, w) c a b 0 0 v)) $ = '(ax_mp (ax_mp k215PReach_trans k215PushAStage0At2749) (ax_mp (ax_mp k215PReach_trans k215PushAStage1At2749) (ax_mp (ax_mp k215PReach_trans k215PushAStage2At2749) (ax_mp (ax_mp k215PReach_trans k215PushAStage3At2749) (ax_mp (ax_mp k215PReach_trans k215PushAStage4At2749) k215PushAStage5At2749)))));

