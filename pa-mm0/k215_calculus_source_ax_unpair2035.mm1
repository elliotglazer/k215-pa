import "k215_calculus_source_ax_stack_loops.mm1";
import "k215_literal_runtime_reach.mm1";
import "k215_calculus_source_pairing.mm1";
import "k215_calculus_source_ax_stack_lookups.mm1";

@_ def k215UnpairAt2035State (pc a b n c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) n (k215PR3 c) (k215PR4 c) (k215PR5 c) a b (k215PR8 c)) $;

do (apply (register-eqd 'k215UnpairAt2035State) '(k215UnpairAt2035Stateeqd));

theorem k215UnpairAt2035Transfer (b n c: nat): $ k215PIter (3 * b + 1) (k215UnpairAt2035State k215PNum2039 0 b n c) = (k215UnpairAt2035State k215PNum2042 b 0 n c) $ =
 '(eqtr k215Loop2039Vector (k215PStateeq2 (k215PVectoreq7 add0)));
theorem k215UnpairAt2035ReachTransfer (b n c: nat): $ k215PReach (k215UnpairAt2035State k215PNum2039 0 b n c) (k215UnpairAt2035State k215PNum2042 b 0 n c) $ =
 '(k215PReach_intro k215UnpairAt2035Transfer);


theorem k215UnpairAt2035Step9Z (a b c: nat): $ k215PStep (k215UnpairAt2035State k215PNum2035 a b 0 c) = (k215UnpairAt2035State k215PNum2043 a b 0 c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair2035_2035) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt2035Reach9Z (a b c: nat): $ k215PReach (k215UnpairAt2035State k215PNum2035 a b 0 c) (k215UnpairAt2035State k215PNum2043 a b 0 c) $ = '(k215PReach_step k215UnpairAt2035Step9Z);

theorem k215UnpairAt2035Step9S (a b n c: nat): $ k215PStep (k215UnpairAt2035State k215PNum2035 a b (suc n) c) = (k215UnpairAt2035State k215PNum2036 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair2035_2035) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet2_vector)) (eqtr k215PSet2_vector (k215PVectoreq3 (eqtr subSS sub02))))));

theorem k215UnpairAt2035Reach9S (a b n c: nat): $ k215PReach (k215UnpairAt2035State k215PNum2035 a b (suc n) c) (k215UnpairAt2035State k215PNum2036 a b n c) $ = '(k215PReach_step k215UnpairAt2035Step9S);

theorem k215UnpairAt2035Step10 (a b n c: nat): $ k215PStep (k215UnpairAt2035State k215PNum2036 a b n c) = (k215UnpairAt2035State k215PNum2037 a (suc b) n c) $ = '(eqtr (k215PAtCI k215PLookupUnpair2035_2036) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215UnpairAt2035Reach10 (a b n c: nat): $ k215PReach (k215UnpairAt2035State k215PNum2036 a b n c) (k215UnpairAt2035State k215PNum2037 a (suc b) n c) $ = '(k215PReach_step k215UnpairAt2035Step10);

theorem k215UnpairAt2035Step11Z (b n c: nat): $ k215PStep (k215UnpairAt2035State k215PNum2037 0 b n c) = (k215UnpairAt2035State k215PNum2039 0 b n c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair2035_2037) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt2035Reach11Z (b n c: nat): $ k215PReach (k215UnpairAt2035State k215PNum2037 0 b n c) (k215UnpairAt2035State k215PNum2039 0 b n c) $ = '(k215PReach_step k215UnpairAt2035Step11Z);

theorem k215UnpairAt2035Step11S (a b n c: nat): $ k215PStep (k215UnpairAt2035State k215PNum2037 (suc a) b n c) = (k215UnpairAt2035State k215PNum2038 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair2035_2037) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215UnpairAt2035Reach11S (a b n c: nat): $ k215PReach (k215UnpairAt2035State k215PNum2037 (suc a) b n c) (k215UnpairAt2035State k215PNum2038 a b n c) $ = '(k215PReach_step k215UnpairAt2035Step11S);

theorem k215UnpairAt2035Step12 (a b n c: nat): $ k215PStep (k215UnpairAt2035State k215PNum2038 a b n c) = (k215UnpairAt2035State k215PNum2042 a b n c) $ = '(k215PAtCB k215PLookupUnpair2035_2038);

theorem k215UnpairAt2035Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt2035State k215PNum2038 a b n c) (k215UnpairAt2035State k215PNum2042 a b n c) $ = '(k215PReach_step k215UnpairAt2035Step12);

theorem k215UnpairAt2035Step16 (a b n c: nat): $ k215PStep (k215UnpairAt2035State k215PNum2042 a b n c) = (k215UnpairAt2035State k215PNum2035 a b n c) $ = '(k215PAtCC k215PLookupUnpair2035_2042);

theorem k215UnpairAt2035Reach16 (a b n c: nat): $ k215PReach (k215UnpairAt2035State k215PNum2042 a b n c) (k215UnpairAt2035State k215PNum2035 a b n c) $ = '(k215PReach_step k215UnpairAt2035Step16);

theorem k215UnpairAt2035CycleZero (b n c: nat): $ k215PReach (k215UnpairAt2035State k215PNum2035 0 b (suc n) c) (k215UnpairAt2035State k215PNum2035 (suc b) 0 n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt2035Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2035Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2035Reach11Z) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2035ReachTransfer) k215UnpairAt2035Reach16))));
theorem k215UnpairAt2035CycleSucc (a b n c: nat): $ k215PReach (k215UnpairAt2035State k215PNum2035 (suc a) b (suc n) c) (k215UnpairAt2035State k215PNum2035 a (suc b) n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt2035Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2035Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2035Reach11S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2035Reach12) k215UnpairAt2035Reach16))));


theorem k215UnpairAt2035AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt2035State k215PNum2035 0 b (suc n) c) (k215UnpairAt2035State k215PNum2035 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt2035Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215PairDiagonal_rotate)) (eqtr (eqcom sndpr) (sndeq k215PairDiagonal_rotate)) eqid eqid)) k215UnpairAt2035CycleZero);

theorem k215UnpairAt2035AdvanceSucc (a b n c: nat): $ k215PReach (k215UnpairAt2035State k215PNum2035 (suc a) b (suc n) c) (k215UnpairAt2035State k215PNum2035 (fst (suc ((suc a), b))) (snd (suc ((suc a), b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt2035Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215Pair_next)) (eqtr (eqcom sndpr) (sndeq k215Pair_next)) eqid eqid)) k215UnpairAt2035CycleSucc);

pub theorem k215UnpairAt2035Advance (a b n c: nat): $ k215PReach (k215UnpairAt2035State k215PNum2035 a b (suc n) c) (k215UnpairAt2035State k215PNum2035 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
 (named @ induct '(ind) 'a 'k215UnpairAt2035AdvanceZero '(a1i k215UnpairAt2035AdvanceSucc));
@_ abstract def k215UnpairAt2035Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt2035State k215PNum2035 a b n c) (k215UnpairAt2035State k215PNum2043 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
theorem k215UnpairAt2035RunZero (a b c: nat): $ k215UnpairAt2035Run 0 a b c $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt2035Stateeq eqid
     (eqcom (eqtr (fsteq add0) fstpr))
     (eqcom (eqtr (sndeq add0) sndpr)) eqid eqid)) k215UnpairAt2035Reach9Z);
@_ abstract def k215UnpairAt2035Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt2035Run n a b c $;
theorem k215UnpairAt2035Claim_at (n a b c: nat): $ k215UnpairAt2035Claim n c -> k215UnpairAt2035Run n a b c $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215UnpairAt2035CodeStep (a b n: nat): $ (fst (suc (a, b)), snd (suc (a, b))) + n = (a, b) + suc n $ =
 '(eqtr (addeq1 fstsnd) addSass);
theorem k215UnpairAt2035RunInductive (n a b c: nat): $ k215UnpairAt2035Claim n c -> k215UnpairAt2035Run (suc n) a b c $ =
 '(syl (ax_mp k215PReach_trans k215UnpairAt2035Advance)
   (mpbid (a1i (k215PReacheq2 (k215UnpairAt2035Stateeq eqid
     (fsteq k215UnpairAt2035CodeStep) (sndeq k215UnpairAt2035CodeStep) eqid eqid))) k215UnpairAt2035Claim_at));
theorem k215UnpairAt2035Claim_all (n c: nat): $ k215UnpairAt2035Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt2035RunZero)) '(iald @ iald k215UnpairAt2035RunInductive));
pub theorem k215UnpairMacro2035 (n a b c: nat): $ k215PReach (k215UnpairAt2035State k215PNum2035 a b n c) (k215UnpairAt2035State k215PNum2043 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
 '(ax_mp k215UnpairAt2035Claim_at k215UnpairAt2035Claim_all);
pub theorem k215UnpairMacro2035_clean (n c: nat): $ k215PReach (k215UnpairAt2035State k215PNum2035 0 0 n c) (k215UnpairAt2035State k215PNum2043 (fst n) (snd n) 0 c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt2035Stateeq eqid
   (fsteq (eqtr (addeq1 pr0) add01))
   (sndeq (eqtr (addeq1 pr0) add01)) eqid eqid)) k215UnpairMacro2035);


