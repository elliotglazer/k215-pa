import "b4b_bc_sound2.mm0";

theorem bcRTSrc_sound (m v i t y: nat): $ bcHasOK m v i -> bcRTSrc m v i t y -> y = paTermSource t $;
theorem bcRFSrc_sound (m v i c y: nat): $ bcHasOK m v i -> bcRFSrc m v i c y -> y = paFormulaSource c $;
theorem bcRFSub_sound (m v i d a c y: nat): $ bcHasOK m v i -> bcRFSub m v i d a c y -> y = paFormulaSubst d a c $;
theorem bcRFRen_sound (R: set) (e m v i d c y: nat): $ bcHasOKR R e m v i -> bcRFRen m v i e d c y -> y = paFormulaRename R d c $;
theorem bcRTRen_sound {ii jj: nat} (R: set) (e m v i d t y: nat) (hR: $ A. ii A. jj (bcCeMap e ii jj <-> jj = R @ ii) $): $ bcHasOKR R e m v i -> bcRTRen m v i e d t y -> y = paTermRename (sfRenameDepthMap R d) t $;
theorem bcRSRen_sound (m v i e d c y: nat): $ bcHasOK m v i -> bcRSRen m v i e d c y -> bcSRenG e d c y $;
