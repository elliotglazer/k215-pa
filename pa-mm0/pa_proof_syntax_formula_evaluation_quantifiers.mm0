import "pa_proof_syntax_formula_evaluation_logic.mm0";

def paFEQSafeFormula (b: nat): nat = $ if (sfWf b) b sfBot $;

theorem paFormulaEvaluation_all_implication (g a b: nat): $ sfWf g /\ sfWf a /\ sfWf b -> zfcProvable (sfImp (sfAll (paFormulaGuardedEquivalence (sfShift 0 g) a b)) (paFormulaGuardedEquivalence g (sfAll a) (sfAll b))) $;

theorem paFormulaEvaluation_all (g a b: nat): $ sfWf g /\ sfWf a /\ sfWf b -> zfcProvable (paFormulaGuardedEquivalence (sfShift 0 g) a b) -> zfcProvable (paFormulaGuardedEquivalence g (sfAll a) (sfAll b)) $;

theorem paFormulaEvaluation_ex_implication (g a b: nat): $ sfWf g /\ sfWf a /\ sfWf b -> zfcProvable (sfImp (sfAll (paFormulaGuardedEquivalence (sfShift 0 g) a b)) (paFormulaGuardedEquivalence g (sfEx a) (sfEx b))) $;

theorem paFormulaEvaluation_ex (g a b: nat): $ sfWf g /\ sfWf a /\ sfWf b -> zfcProvable (paFormulaGuardedEquivalence (sfShift 0 g) a b) -> zfcProvable (paFormulaGuardedEquivalence g (sfEx a) (sfEx b)) $;
