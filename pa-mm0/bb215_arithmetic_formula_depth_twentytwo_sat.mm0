import "bb215_arithmetic_formula_depth_twentyone_sat.mm0";

import "pa_source_interpretation_nat_term_assignment.mm0";

def bb215ArithmeticFormulaDepthTwentytwoSatBody (E: set) (c h .x: nat): wff = $ ifp (c = 0) (0 != 0) (ifp (sfTag c = 1) (bb215ArithmeticFormulaTermValue E (sfLeft c) = bb215ArithmeticFormulaTermValue E (sfRight c)) (ifp (sfTag c = 3) (sfLeft c e. h /\ sfRight c e. h) (ifp (sfTag c = 4) (sfLeft c e. h \/ sfRight c e. h) (ifp (sfTag c = 5) (sfLeft c e. h -> sfRight c e. h) (ifp (sfTag c = 6 /\ sfRight c = 0) (A. x bb215ArithmeticFormulaDepthTwentyoneSat (paNatTermConsEnvironment E x) (sfLeft c)) (ifp (sfTag c = 7 /\ sfRight c = 0) (E. x bb215ArithmeticFormulaDepthTwentyoneSat (paNatTermConsEnvironment E x) (sfLeft c)) (0 != 0))))))) $;

def bb215ArithmeticFormulaDepthTwentytwoSatStep (E: set) (.c .h: nat): set = $ S\ c, {h | bb215ArithmeticFormulaDepthTwentytwoSatBody E c h} $;

def bb215ArithmeticFormulaDepthTwentytwoSat (E: set) (c: nat): wff = $ srecp (bb215ArithmeticFormulaDepthTwentytwoSatStep E) c $;

def bb215ArithmeticFormulaDepthTwentytwoSatPrevious (E: set) (c .i: nat): nat = $ sep (upto c) {i | srecp (bb215ArithmeticFormulaDepthTwentytwoSatStep E) i} $;

theorem bb215ArithmeticFormulaDepthTwentytwoSatStep_value (E: set) (c h: nat): $ (c, h) e. bb215ArithmeticFormulaDepthTwentytwoSatStep E <-> bb215ArithmeticFormulaDepthTwentytwoSatBody E c h $;

theorem bb215ArithmeticFormulaDepthTwentytwoSatPrevious_value (E: set) (c a: nat): $ a e. bb215ArithmeticFormulaDepthTwentytwoSatPrevious E c <-> a < c /\ bb215ArithmeticFormulaDepthTwentytwoSat E a $;

theorem bb215ArithmeticFormulaDepthTwentytwoSat_unfold (E: set) (c: nat): $ bb215ArithmeticFormulaDepthTwentytwoSat E c <-> bb215ArithmeticFormulaDepthTwentytwoSatBody E c (bb215ArithmeticFormulaDepthTwentytwoSatPrevious E c) $;

theorem bb215ArithmeticFormulaDepthTwentytwoSat_false (E: set): $ bb215ArithmeticFormulaDepthTwentytwoSat E paFormulaFalse <-> 0 != 0 $;

theorem bb215ArithmeticFormulaDepthTwentytwoSat_equal (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthTwentytwoSat E (paFormulaEqual a b) <-> bb215ArithmeticFormulaTermValue E a = bb215ArithmeticFormulaTermValue E b $;

theorem bb215ArithmeticFormulaDepthTwentytwoSat_and (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthTwentytwoSat E (paFormulaAnd a b) <-> (bb215ArithmeticFormulaDepthTwentytwoSat E a /\ bb215ArithmeticFormulaDepthTwentytwoSat E b) $;

theorem bb215ArithmeticFormulaDepthTwentytwoSat_or (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthTwentytwoSat E (paFormulaOr a b) <-> (bb215ArithmeticFormulaDepthTwentytwoSat E a \/ bb215ArithmeticFormulaDepthTwentytwoSat E b) $;

theorem bb215ArithmeticFormulaDepthTwentytwoSat_imp (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthTwentytwoSat E (paFormulaImp a b) <-> (bb215ArithmeticFormulaDepthTwentytwoSat E a -> bb215ArithmeticFormulaDepthTwentytwoSat E b) $;

theorem bb215ArithmeticFormulaDepthTwentytwoSat_all (E: set) (a: nat) {x: nat}: $ bb215ArithmeticFormulaDepthTwentytwoSat E (paFormulaAll a) <-> A. x bb215ArithmeticFormulaDepthTwentyoneSat (paNatTermConsEnvironment E x) a $;

theorem bb215ArithmeticFormulaDepthTwentytwoSat_ex (E: set) (a: nat) {x: nat}: $ bb215ArithmeticFormulaDepthTwentytwoSat E (paFormulaEx a) <-> E. x bb215ArithmeticFormulaDepthTwentyoneSat (paNatTermConsEnvironment E x) a $;
