import "source_k0_qsep_member_unfold.mm0";

import "source_k0_qsep_quotient_head.mm0";

import "source_k0_qsep_quotient_profile.mm0";

theorem sfK0QSepMember_forward_point (E: set) (n t a c z M R phi: nat) (hf: $ sfBound (suc n) phi $) (hM0: $ 0 < M $)
 (htM: $ t < M $) (hzM: $ z < M $) (hMR: $ M < R $)
 (he: $ sqEnvBelow E n R $):
 $ k218QProvable (kImp (k218QAEmpty t R) (kImp (kImp (kMem t M) (kImp (kImp (kImp (kMem M c) (kImp (kImp (kMem M a) (kImp (sqQuote (sqEnvCons M E) t R 0 phi) kF)) kF)) (kImp (kImp (kImp (kImp (kMem M a) (kImp (sqQuote (sqEnvCons M E) t R 0 phi) kF)) kF) (kMem M c)) kF)) kF)) (kImp (kImp (kImp (kImp (kImp (kMem t M) (kImp (kMem M c) kF)) kF) (kImp (sqEqual t z M (suc M)) kF)) kF) (kImp (kImp (kImp (kImp (kImp (kImp (kMem t M) (kImp (kMem M a) kF)) kF) (kImp (sqEqual t z M (suc M)) kF)) kF) (kImp (sqQuote (sqEnvCons z E) t R 0 phi) kF)) kF)))) $;

theorem sfK0QSepMember_backward_point (E: set) (n t a c z M R phi: nat) (hf: $ sfBound (suc n) phi $) (hM0: $ 0 < M $)
 (htM: $ t < M $) (hzM: $ z < M $) (hMR: $ M < R $)
 (he: $ sqEnvBelow E n R $):
 $ k218QProvable (kImp (k218QAEmpty t R) (kImp (kImp (kMem t M) (kImp (kImp (kImp (kMem M c) (kImp (kImp (kMem M a) (kImp (sqQuote (sqEnvCons M E) t R 0 phi) kF)) kF)) (kImp (kImp (kImp (kImp (kMem M a) (kImp (sqQuote (sqEnvCons M E) t R 0 phi) kF)) kF) (kMem M c)) kF)) kF)) (kImp (sqQuote (sqEnvCons z E) t R 0 phi) (kImp (kImp (kImp (kImp (kImp (kMem t M) (kImp (kMem M a) kF)) kF) (kImp (sqEqual t z M (suc M)) kF)) kF) (kImp (kImp (kImp (kImp (kMem t M) (kImp (kMem M c) kF)) kF) (kImp (sqEqual t z M (suc M)) kF)) kF))))) $;
