import "source_piece_pcf_rep_case_common.mm0";

import "source_piece_pcf_definable_projection_use.mm0";

import "source_piece_pcf_rep_cover_bridge_r46.mm0";

import "source_l_separation_image_op5_extension.mm0";

-- Ex case of the uniform representation theorem (Rocq Z_cl.rep_ex, Ex branch: the
-- projection of the (n+1)-representation R' along the carrier, op 4 PJ), in hypothesis
-- form. Closure over the stock mm0-c capacity (B1).

-- The carrier is in its closure (Rocq Z_cl.clA_in).
theorem sfPieceRepCase_carrier (G A B C: nat)
  (hg: $ sfContextWf G $) (hbg: $ sfContextSub sfLBackground G $)
  (hs: $ nsLocal G (sfPieceRepSuccessor A B) $)
  (hc: $ nsLocal G (sfPieceRepClosure B C) $):
  $ nsLocal G (sfMem A C) $;

theorem sfPieceRepCaseEx_rule (G n a Y A R X: nat)
  (hg: $ sfContextWf G $) (hb: $ sfBound (suc n) a $)
  (hR: $ nsLocal G (sfPieceDefinableNamed (suc n) a R A) $)
  (hC: $ nsLocal G (sfPieceRepEnvironmentCoverAt A X n) $)
  (hP: $ nsLocal G (sfPieceDefinableExistentialProjection R X A Y) $)
  (hT: $ nsLocal G sfPieceDefinableExistentialTotal $):
  $ nsLocal G (sfPieceDefinableNamed n (sfEx a) Y A) $;

theorem sfPieceRepCaseEx (G A B C n a: nat)
  (hg: $ sfContextWf G $) (hbg: $ sfContextSub sfLBackground G $)
  (hs: $ nsLocal G (sfPieceRepSuccessor A B) $)
  (hc: $ nsLocal G (sfPieceRepClosure B C) $)
  (hb: $ sfBound (suc n) a $)
  (hw: $ nsLocal G (sfPieceDefinableWitness A C (suc n) a) $):
  $ nsLocal G (sfPieceDefinableWitness A C n (sfEx a)) $;
