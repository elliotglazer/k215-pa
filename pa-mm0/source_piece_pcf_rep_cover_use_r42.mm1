import "source_piece_pcf_rep_cover_consumer_r40.mm1";

pub theorem sfPieceRepEnvironmentCover_eq(A C n B D:nat)(ha:$ A = B $)(hc:$ C = D $): $ sfPieceRepEnvironmentCover A C n = sfPieceRepEnvironmentCover B D n $ = (named '(nsEx_eq (nsAnd_eq (nsMem_eq eqid (suceq hc)) (sfPieceRepEnvironmentCoverAt_congr (suceq ha) eqid))));

pub theorem sfPieceRepEnvironmentCover_subst(k t A C n:nat): $ sfSubst k t (sfPieceRepEnvironmentCover A C n) = sfPieceRepEnvironmentCover (sfSubstIndex k t A) (sfSubstIndex k t C) n $ = (named '(eqtr sfSubst_sfEx (nsEx_eq (eqtr sfSubst_sfAnd (nsAnd_eq (eqtr sfSubst_sfMem (nsMem_eq (ax_mp sfSubstIndex_bound lt01S) (eqtr sfSubstIndex_lift (suceq eqid)))) (eqtr sfPieceRepEnvironmentCoverAt_subst (sfPieceRepEnvironmentCoverAt_congr (eqtr sfSubstIndex_lift (suceq eqid)) (ax_mp sfSubstIndex_bound lt01S))))))));

theorem pcr42_open0(n A:nat): $ sfSubst 0 A (sfAll (sfAll (sfImp (sfPieceRepSuccessor 2 1) (sfImp (sfPieceRepClosure 1 0) (sfPieceRepEnvironmentCover 2 0 n))))) = (sfAll (sfAll (sfImp (sfPieceRepSuccessor (suc (suc A)) 1) (sfImp (sfPieceRepClosure 1 0) (sfPieceRepEnvironmentCover (suc (suc A)) 0 n))))) $ = (named '(eqtr sfSubst_sfAll (nsAll_eq (eqtr sfSubst_sfAll (nsAll_eq (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepSuccessor_subst (sfPieceRepSuccessor_eq (eqtr sfSubstIndex_lift (suceq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_zero)))) (ax_mp sfSubstIndex_bound (mpbi ltsuc lt01S)))) (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepClosure_subst (sfPieceRepClosure_eq (ax_mp sfSubstIndex_bound (mpbi ltsuc lt01S)) (ax_mp sfSubstIndex_bound lt01S))) (eqtr sfPieceRepEnvironmentCover_subst (sfPieceRepEnvironmentCover_eq (eqtr sfSubstIndex_lift (suceq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_zero)))) (ax_mp sfSubstIndex_bound lt01S))))))))))));

theorem pcr42_inst0(G n A:nat): $ nsLocal G (sfPieceRepCoverFormula n) -> nsLocal G (sfAll (sfAll (sfImp (sfPieceRepSuccessor (suc (suc A)) 1) (sfImp (sfPieceRepClosure 1 0) (sfPieceRepEnvironmentCover (suc (suc A)) 0 n))))) $ = (named '(syl (bi1 (nsLocal_formula_eq pcr42_open0)) nsLocal_AllE));

theorem pcr42_open1(n A B:nat): $ sfSubst 0 B (sfAll (sfImp (sfPieceRepSuccessor (suc (suc A)) 1) (sfImp (sfPieceRepClosure 1 0) (sfPieceRepEnvironmentCover (suc (suc A)) 0 n)))) = (sfAll (sfImp (sfPieceRepSuccessor (suc A) (suc B)) (sfImp (sfPieceRepClosure (suc B) 0) (sfPieceRepEnvironmentCover (suc A) 0 n)))) $ = (named '(eqtr sfSubst_sfAll (nsAll_eq (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepSuccessor_subst (sfPieceRepSuccessor_eq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor)) (eqtr sfSubstIndex_lift (suceq sfSubstIndex_zero)))) (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepClosure_subst (sfPieceRepClosure_eq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_zero)) (ax_mp sfSubstIndex_bound lt01S))) (eqtr sfPieceRepEnvironmentCover_subst (sfPieceRepEnvironmentCover_eq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor)) (ax_mp sfSubstIndex_bound lt01S))))))))));

theorem pcr42_inst1(G n A B:nat): $ nsLocal G (sfPieceRepCoverFormula n) -> nsLocal G (sfAll (sfImp (sfPieceRepSuccessor (suc A) (suc B)) (sfImp (sfPieceRepClosure (suc B) 0) (sfPieceRepEnvironmentCover (suc A) 0 n)))) $ = (named '(syl (syl (bi1 (nsLocal_formula_eq pcr42_open1)) nsLocal_AllE) pcr42_inst0));

theorem pcr42_open2(n A B C:nat): $ sfSubst 0 C (sfImp (sfPieceRepSuccessor (suc A) (suc B)) (sfImp (sfPieceRepClosure (suc B) 0) (sfPieceRepEnvironmentCover (suc A) 0 n))) = (sfImp (sfPieceRepSuccessor A B) (sfImp (sfPieceRepClosure B C) (sfPieceRepEnvironmentCover A C n))) $ = (named '(eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepSuccessor_subst (sfPieceRepSuccessor_eq sfSubstIndex_successor sfSubstIndex_successor)) (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepClosure_subst (sfPieceRepClosure_eq sfSubstIndex_successor sfSubstIndex_zero)) (eqtr sfPieceRepEnvironmentCover_subst (sfPieceRepEnvironmentCover_eq sfSubstIndex_successor sfSubstIndex_zero)))))));

theorem pcr42_inst2(G n A B C:nat): $ nsLocal G (sfPieceRepCoverFormula n) -> nsLocal G (sfImp (sfPieceRepSuccessor A B) (sfImp (sfPieceRepClosure B C) (sfPieceRepEnvironmentCover A C n))) $ = (named '(syl (syl (bi1 (nsLocal_formula_eq pcr42_open2)) nsLocal_AllE) pcr42_inst1));

pub theorem sfPieceRepCoverFormula_use(G n A B C:nat): $ nsLocal G (sfPieceRepCoverFormula n) -> nsLocal G (sfPieceRepSuccessor A B) -> nsLocal G (sfPieceRepClosure B C) -> nsLocal G (sfPieceRepEnvironmentCover A C n) $ = (named '(syl (syl6 nsLocal_mp nsLocal_mp) pcr42_inst2));
