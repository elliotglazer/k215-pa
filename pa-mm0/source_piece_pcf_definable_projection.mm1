import "source_piece_pcf_definable_projection_replay.mm1";
import "source_l_background.mm1";
import "source_theory_local.mm1";

def sfPieceDefinableProjectionFormula:nat = $ pcdfPFormula $;
pub theorem sfPieceDefinableProjection_context: $ pcdfPContext = sfLBackground $ = 'eqid;
pub theorem sfPieceDefinableProjection_local: $ nsLocal sfLBackground sfPieceDefinableProjectionFormula $ = '(mpbi (nsLocal_context_eq sfPieceDefinableProjection_context) pcdfPCertificate);
pub theorem sfPieceDefinableProjection_zfr: $ sfTheoryProvable zfrAxioms sfPieceDefinableProjectionFormula $ = '(ax_mp (sfTheory_local sfLBackground_zfr) sfPieceDefinableProjection_local);
