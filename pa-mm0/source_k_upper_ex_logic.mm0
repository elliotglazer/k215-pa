import "source_k_upper_trace_logic.mm0";

theorem sfUpperLocal_ex_map (G a b: nat) (hg: $ sfContextWf G $) (ha: $ sfWf a $) (hb: $ sfWf b $) (h: $ nsLocal (a : sfContextShift G) b $):
 $ nsLocal G (sfEx a) -> nsLocal G (sfEx b) $;

theorem sfUpperLocal_ex_from_pure_imp (G a b: nat) (hg: $ sfContextWf G $) (ha: $ sfWf a $) (hb: $ sfWf b $) (h: $ nsLocal 0 (sfImp a b) $):
 $ nsLocal G (sfEx a) -> nsLocal G (sfEx b) $;
