import "b4g2_mv2.mm0";

theorem bcConSrc_sound (m v s: nat): $ bcJust m v -> bcConSrc m v s -> s = paFormulaSource zfcConPA $;
theorem bcConSrc_cert {m v: nat}: $ E. m E. v (bcJust m v /\ bcConSrc m v (paFormulaSource zfcConPA)) $;
theorem bcConSrc_iff (s: nat) {m v: nat}:
  $ s = paFormulaSource zfcConPA <-> E. m E. v (bcJust m v /\ bcConSrc m v s) $;
