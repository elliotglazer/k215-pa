theorem sfcForwardStep193 (E: set) (n b t r a c p u y x R psi: nat) (hf: $ sfBound (suc (suc n)) psi $)
 (hxR: $ x < R $) (huR: $ u < R $) (hpR: $ p < R $)
 (hx0: $ x != 0 $) (hxu: $ x != u $) (hxp: $ x != p $)
 (hxt: $ x != t $) (hxy: $ x != y $) (hex: $ sqEnvAvoid E n x $)
