import "pa_source_interpretation_nat_qf_induction.mm0";

import "pa_formula_substitution.mm0";

import "pa_source_interpretation_term_numerals.mm0";

def paNatQFSubstBoundClass (d m a .n .c: nat): set = $ S\ n, {c | n = d + suc m /\ paTermBound m a -> paNatQFBound (d + m) (paFormulaSubst d a c)} $;

theorem paNatQFBound_substitution (d n a c: nat): $ paTermBound n a -> paNatQFBound (d + suc n) c -> paNatQFBound (d + n) (paFormulaSubst d a c) $;

theorem paNatTermNumeral_bound (n b: nat): $ paTermBound n (paTermNumeral b) $;

theorem paNatQFBound_numeral_substitution (b n c: nat): $ paNatQFBound (suc n) c -> paNatQFBound n (paFormulaSubst 0 (paTermNumeral b) c) $;
