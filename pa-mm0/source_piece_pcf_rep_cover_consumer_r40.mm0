import "source_piece_pcf_rep_cover_laws_r39.mm0";

def pcr40Fresh(G C:nat):nat = $ sfMem 0 (suc C) : sfContextShift G $;

theorem sfPieceRepCoverSuccessorClosed_from_law(G B C A:nat)(hs:$ nsLocal G sfPieceRepCoverStepLaw $)(hc:$ nsLocal G (sfPieceRepClosure B C) $)(ha:$ nsLocal G (sfMem A C) $): $ nsLocal G (sfPieceRepCoverSuccessorClosed A C) $;

def pcr40G3(G:nat):nat = $ sfContextShift (sfContextShift (sfContextShift G)) $;

def pcr40Guard(G:nat):nat = $ sfPieceRepClosure 1 0 : sfPieceRepSuccessor 2 1 : pcr40G3 G $;

def sfPieceRepCoverFormula(n:nat):nat = $ sfAll (sfAll (sfAll (sfImp (sfPieceRepSuccessor 2 1) (sfImp (sfPieceRepClosure 1 0) (sfPieceRepEnvironmentCover 2 0 n))))) $;

theorem sfPieceRepCover_from_finite_laws(G n:nat)(hb:$ nsLocal G sfPieceRepCoverBaseLaw $)(ha:$ nsLocal G sfPieceRepCoverCarrierLaw $)(ht:$ nsLocal G sfPieceRepCoverStepLaw $): $ nsLocal G (sfPieceRepCoverFormula n) $;
