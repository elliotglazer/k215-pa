import "source_k0_qsep_support.mm0";

import "source_k0_qsep_tagged_substitution.mm0";

import "k218q_alpha.mm0";

def sfK0QSepSupportBody (E: set) (r t b c u y K theta: nat): nat = $ (kImp (kMem u c) (kExists y (kDisj (kAnd (kEq y r) (kEq u b)) (kDisj (kAnd (kEq y t) (kEq u t)) (kAnd (kAnd (kMem u y) (kAll K (kImp (kMem K y) (kEq K u)))) (kAnd (kMem u b) (sfNamedTemplate (sqEnvCons u E) K 0 theta))))))) $;

theorem sfK0QSepSupportBody_substitution (E: set) (n r t b c u x y K theta: nat) (hf: $ sfBound (suc n) theta $) (hu0: $ u != 0 $) (hx0: $ x != 0 $)
 (huK: $ u < K $) (hxK: $ x < K $)
 (hru: $ r != u $) (htu: $ t != u $) (hbu: $ b != u $) (hcu: $ c != u $) (hyu: $ y != u $)
 (hxu: $ x != u $) (hxr: $ x != r $) (hxt: $ x != t $) (hxb: $ x != b $) (hxc: $ x != c $) (hyx: $ y != x $)
 (heu: $ sqEnvAvoid E n u $) (hex: $ sqEnvAvoid E n x $):
 $ kSubst (sfK0QSepSupportBody E r t b c u y K theta) u x = sfK0QSepSupportBody E r t b c x y K theta $;

theorem sfK0QSepTaggedSupport_alpha (E: set) (n r t b c u x y K theta: nat) (hf: $ sfBound (suc n) theta $) (hu0: $ u != 0 $) (hx0: $ x != 0 $)
 (huK: $ u < K $) (hxK: $ x < K $)
 (hru: $ r != u $) (htu: $ t != u $) (hbu: $ b != u $) (hcu: $ c != u $) (hyu: $ y != u $)
 (hxu: $ x != u $) (hxr: $ x != r $) (hxt: $ x != t $) (hxb: $ x != b $) (hxc: $ x != c $) (hyx: $ y != x $)
 (heu: $ sqEnvAvoid E n u $) (hex: $ sqEnvAvoid E n x $):
 $ k218QProvable (kImp (sfK0QSepTaggedSupport E r t b c u y K theta) (sfK0QSepTaggedSupport E r t b c x y K theta)) $;
