@_ def k215UnpairAt4145State (pc a b n c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) n (k215PR3 c) (k215PR4 c) (k215PR5 c) a b (k215PR8 c)) $;

do (apply (register-eqd 'k215UnpairAt4145State) '(k215UnpairAt4145Stateeqd));

theorem k215UnpairAt4145Transfer (b n c: nat): $ k215PIter (3 * b + 1) (k215UnpairAt4145State k215PNum4149 0 b n c) = (k215UnpairAt4145State k215PNum4152 b 0 n c) $ =
 '(eqtr k215Loop4149Vector (k215PStateeq2 (k215PVectoreq7 add0)));
theorem k215UnpairAt4145ReachTransfer (b n c: nat): $ k215PReach (k215UnpairAt4145State k215PNum4149 0 b n c) (k215UnpairAt4145State k215PNum4152 b 0 n c) $ =
 '(k215PReach_intro k215UnpairAt4145Transfer);


theorem k215UnpairAt4145Step9Z (a b c: nat): $ k215PStep (k215UnpairAt4145State k215PNum4145 a b 0 c) = (k215UnpairAt4145State k215PNum4153 a b 0 c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair4145_4145) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt4145Reach9Z (a b c: nat): $ k215PReach (k215UnpairAt4145State k215PNum4145 a b 0 c) (k215UnpairAt4145State k215PNum4153 a b 0 c) $ = '(k215PReach_step k215UnpairAt4145Step9Z);

theorem k215UnpairAt4145Step9S (a b n c: nat): $ k215PStep (k215UnpairAt4145State k215PNum4145 a b (suc n) c) = (k215UnpairAt4145State k215PNum4146 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair4145_4145) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet2_vector)) (eqtr k215PSet2_vector (k215PVectoreq3 (eqtr subSS sub02))))));

theorem k215UnpairAt4145Reach9S (a b n c: nat): $ k215PReach (k215UnpairAt4145State k215PNum4145 a b (suc n) c) (k215UnpairAt4145State k215PNum4146 a b n c) $ = '(k215PReach_step k215UnpairAt4145Step9S);

theorem k215UnpairAt4145Step10 (a b n c: nat): $ k215PStep (k215UnpairAt4145State k215PNum4146 a b n c) = (k215UnpairAt4145State k215PNum4147 a (suc b) n c) $ = '(eqtr (k215PAtCI k215PLookupUnpair4145_4146) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215UnpairAt4145Reach10 (a b n c: nat): $ k215PReach (k215UnpairAt4145State k215PNum4146 a b n c) (k215UnpairAt4145State k215PNum4147 a (suc b) n c) $ = '(k215PReach_step k215UnpairAt4145Step10);

theorem k215UnpairAt4145Step11Z (b n c: nat): $ k215PStep (k215UnpairAt4145State k215PNum4147 0 b n c) = (k215UnpairAt4145State k215PNum4149 0 b n c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair4145_4147) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt4145Reach11Z (b n c: nat): $ k215PReach (k215UnpairAt4145State k215PNum4147 0 b n c) (k215UnpairAt4145State k215PNum4149 0 b n c) $ = '(k215PReach_step k215UnpairAt4145Step11Z);

theorem k215UnpairAt4145Step11S (a b n c: nat): $ k215PStep (k215UnpairAt4145State k215PNum4147 (suc a) b n c) = (k215UnpairAt4145State k215PNum4148 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair4145_4147) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215UnpairAt4145Reach11S (a b n c: nat): $ k215PReach (k215UnpairAt4145State k215PNum4147 (suc a) b n c) (k215UnpairAt4145State k215PNum4148 a b n c) $ = '(k215PReach_step k215UnpairAt4145Step11S);

theorem k215UnpairAt4145Step12 (a b n c: nat): $ k215PStep (k215UnpairAt4145State k215PNum4148 a b n c) = (k215UnpairAt4145State k215PNum4152 a b n c) $ = '(k215PAtCB k215PLookupUnpair4145_4148);

theorem k215UnpairAt4145Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt4145State k215PNum4148 a b n c) (k215UnpairAt4145State k215PNum4152 a b n c) $ = '(k215PReach_step k215UnpairAt4145Step12);

theorem k215UnpairAt4145Step16 (a b n c: nat): $ k215PStep (k215UnpairAt4145State k215PNum4152 a b n c) = (k215UnpairAt4145State k215PNum4145 a b n c) $ = '(k215PAtCC k215PLookupUnpair4145_4152);

theorem k215UnpairAt4145Reach16 (a b n c: nat): $ k215PReach (k215UnpairAt4145State k215PNum4152 a b n c) (k215UnpairAt4145State k215PNum4145 a b n c) $ = '(k215PReach_step k215UnpairAt4145Step16);

theorem k215UnpairAt4145CycleZero (b n c: nat): $ k215PReach (k215UnpairAt4145State k215PNum4145 0 b (suc n) c) (k215UnpairAt4145State k215PNum4145 (suc b) 0 n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt4145Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt4145Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt4145Reach11Z) (ax_mp (ax_mp k215PReach_trans k215UnpairAt4145ReachTransfer) k215UnpairAt4145Reach16))));
theorem k215UnpairAt4145CycleSucc (a b n c: nat): $ k215PReach (k215UnpairAt4145State k215PNum4145 (suc a) b (suc n) c) (k215UnpairAt4145State k215PNum4145 a (suc b) n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt4145Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt4145Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt4145Reach11S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt4145Reach12) k215UnpairAt4145Reach16))));


theorem k215UnpairAt4145AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt4145State k215PNum4145 0 b (suc n) c) (k215UnpairAt4145State k215PNum4145 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt4145Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215PairDiagonal_rotate)) (eqtr (eqcom sndpr) (sndeq k215PairDiagonal_rotate)) eqid eqid)) k215UnpairAt4145CycleZero);

theorem k215UnpairAt4145AdvanceSucc (a b n c: nat): $ k215PReach (k215UnpairAt4145State k215PNum4145 (suc a) b (suc n) c) (k215UnpairAt4145State k215PNum4145 (fst (suc ((suc a), b))) (snd (suc ((suc a), b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt4145Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215Pair_next)) (eqtr (eqcom sndpr) (sndeq k215Pair_next)) eqid eqid)) k215UnpairAt4145CycleSucc);

pub theorem k215UnpairAt4145Advance (a b n c: nat): $ k215PReach (k215UnpairAt4145State k215PNum4145 a b (suc n) c) (k215UnpairAt4145State k215PNum4145 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
 (named @ induct '(ind) 'a 'k215UnpairAt4145AdvanceZero '(a1i k215UnpairAt4145AdvanceSucc));
@_ abstract def k215UnpairAt4145Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt4145State k215PNum4145 a b n c) (k215UnpairAt4145State k215PNum4153 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
theorem k215UnpairAt4145RunZero (a b c: nat): $ k215UnpairAt4145Run 0 a b c $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt4145Stateeq eqid
     (eqcom (eqtr (fsteq add0) fstpr))
     (eqcom (eqtr (sndeq add0) sndpr)) eqid eqid)) k215UnpairAt4145Reach9Z);
@_ abstract def k215UnpairAt4145Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt4145Run n a b c $;
theorem k215UnpairAt4145Claim_at (n a b c: nat): $ k215UnpairAt4145Claim n c -> k215UnpairAt4145Run n a b c $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215UnpairAt4145CodeStep (a b n: nat): $ (fst (suc (a, b)), snd (suc (a, b))) + n = (a, b) + suc n $ =
 '(eqtr (addeq1 fstsnd) addSass);
theorem k215UnpairAt4145RunInductive (n a b c: nat): $ k215UnpairAt4145Claim n c -> k215UnpairAt4145Run (suc n) a b c $ =
 '(syl (ax_mp k215PReach_trans k215UnpairAt4145Advance)
   (mpbid (a1i (k215PReacheq2 (k215UnpairAt4145Stateeq eqid
     (fsteq k215UnpairAt4145CodeStep) (sndeq k215UnpairAt4145CodeStep) eqid eqid))) k215UnpairAt4145Claim_at));
theorem k215UnpairAt4145Claim_all (n c: nat): $ k215UnpairAt4145Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt4145RunZero)) '(iald @ iald k215UnpairAt4145RunInductive));
pub theorem k215UnpairMacro4145 (n a b c: nat): $ k215PReach (k215UnpairAt4145State k215PNum4145 a b n c) (k215UnpairAt4145State k215PNum4153 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
 '(ax_mp k215UnpairAt4145Claim_at k215UnpairAt4145Claim_all);
pub theorem k215UnpairMacro4145_clean (n c: nat): $ k215PReach (k215UnpairAt4145State k215PNum4145 0 0 n c) (k215UnpairAt4145State k215PNum4153 (fst n) (snd n) 0 c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt4145Stateeq eqid
   (fsteq (eqtr (addeq1 pr0) add01))
   (sndeq (eqtr (addeq1 pr0) add01)) eqid eqid)) k215UnpairMacro4145);


