import "k215_calculus_source_ax_stack_loops.mm1";
import "k215_literal_runtime_reach.mm1";
import "k215_calculus_source_pairing.mm1";
import "k215_calculus_source_ax_stack_lookups.mm1";

@_ def k215UnpairAt805State (pc a b n c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) n (k215PR3 c) (k215PR4 c) (k215PR5 c) a b (k215PR8 c)) $;

do (apply (register-eqd 'k215UnpairAt805State) '(k215UnpairAt805Stateeqd));

theorem k215UnpairAt805Transfer (b n c: nat): $ k215PIter (3 * b + 1) (k215UnpairAt805State k215PNum809 0 b n c) = (k215UnpairAt805State k215PNum812 b 0 n c) $ =
 '(eqtr k215Loop809Vector (k215PStateeq2 (k215PVectoreq7 add0)));
theorem k215UnpairAt805ReachTransfer (b n c: nat): $ k215PReach (k215UnpairAt805State k215PNum809 0 b n c) (k215UnpairAt805State k215PNum812 b 0 n c) $ =
 '(k215PReach_intro k215UnpairAt805Transfer);


theorem k215UnpairAt805Step9Z (a b c: nat): $ k215PStep (k215UnpairAt805State k215PNum805 a b 0 c) = (k215UnpairAt805State k215PNum813 a b 0 c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair805_805) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt805Reach9Z (a b c: nat): $ k215PReach (k215UnpairAt805State k215PNum805 a b 0 c) (k215UnpairAt805State k215PNum813 a b 0 c) $ = '(k215PReach_step k215UnpairAt805Step9Z);

theorem k215UnpairAt805Step9S (a b n c: nat): $ k215PStep (k215UnpairAt805State k215PNum805 a b (suc n) c) = (k215UnpairAt805State k215PNum806 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair805_805) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet2_vector)) (eqtr k215PSet2_vector (k215PVectoreq3 (eqtr subSS sub02))))));

theorem k215UnpairAt805Reach9S (a b n c: nat): $ k215PReach (k215UnpairAt805State k215PNum805 a b (suc n) c) (k215UnpairAt805State k215PNum806 a b n c) $ = '(k215PReach_step k215UnpairAt805Step9S);

theorem k215UnpairAt805Step10 (a b n c: nat): $ k215PStep (k215UnpairAt805State k215PNum806 a b n c) = (k215UnpairAt805State k215PNum807 a (suc b) n c) $ = '(eqtr (k215PAtCI k215PLookupUnpair805_806) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215UnpairAt805Reach10 (a b n c: nat): $ k215PReach (k215UnpairAt805State k215PNum806 a b n c) (k215UnpairAt805State k215PNum807 a (suc b) n c) $ = '(k215PReach_step k215UnpairAt805Step10);

theorem k215UnpairAt805Step11Z (b n c: nat): $ k215PStep (k215UnpairAt805State k215PNum807 0 b n c) = (k215UnpairAt805State k215PNum809 0 b n c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair805_807) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt805Reach11Z (b n c: nat): $ k215PReach (k215UnpairAt805State k215PNum807 0 b n c) (k215UnpairAt805State k215PNum809 0 b n c) $ = '(k215PReach_step k215UnpairAt805Step11Z);

theorem k215UnpairAt805Step11S (a b n c: nat): $ k215PStep (k215UnpairAt805State k215PNum807 (suc a) b n c) = (k215UnpairAt805State k215PNum808 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair805_807) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215UnpairAt805Reach11S (a b n c: nat): $ k215PReach (k215UnpairAt805State k215PNum807 (suc a) b n c) (k215UnpairAt805State k215PNum808 a b n c) $ = '(k215PReach_step k215UnpairAt805Step11S);

theorem k215UnpairAt805Step12 (a b n c: nat): $ k215PStep (k215UnpairAt805State k215PNum808 a b n c) = (k215UnpairAt805State k215PNum812 a b n c) $ = '(k215PAtCB k215PLookupUnpair805_808);

theorem k215UnpairAt805Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt805State k215PNum808 a b n c) (k215UnpairAt805State k215PNum812 a b n c) $ = '(k215PReach_step k215UnpairAt805Step12);

theorem k215UnpairAt805Step16 (a b n c: nat): $ k215PStep (k215UnpairAt805State k215PNum812 a b n c) = (k215UnpairAt805State k215PNum805 a b n c) $ = '(k215PAtCC k215PLookupUnpair805_812);

theorem k215UnpairAt805Reach16 (a b n c: nat): $ k215PReach (k215UnpairAt805State k215PNum812 a b n c) (k215UnpairAt805State k215PNum805 a b n c) $ = '(k215PReach_step k215UnpairAt805Step16);

theorem k215UnpairAt805CycleZero (b n c: nat): $ k215PReach (k215UnpairAt805State k215PNum805 0 b (suc n) c) (k215UnpairAt805State k215PNum805 (suc b) 0 n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt805Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt805Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt805Reach11Z) (ax_mp (ax_mp k215PReach_trans k215UnpairAt805ReachTransfer) k215UnpairAt805Reach16))));
theorem k215UnpairAt805CycleSucc (a b n c: nat): $ k215PReach (k215UnpairAt805State k215PNum805 (suc a) b (suc n) c) (k215UnpairAt805State k215PNum805 a (suc b) n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt805Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt805Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt805Reach11S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt805Reach12) k215UnpairAt805Reach16))));


theorem k215UnpairAt805AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt805State k215PNum805 0 b (suc n) c) (k215UnpairAt805State k215PNum805 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt805Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215PairDiagonal_rotate)) (eqtr (eqcom sndpr) (sndeq k215PairDiagonal_rotate)) eqid eqid)) k215UnpairAt805CycleZero);

theorem k215UnpairAt805AdvanceSucc (a b n c: nat): $ k215PReach (k215UnpairAt805State k215PNum805 (suc a) b (suc n) c) (k215UnpairAt805State k215PNum805 (fst (suc ((suc a), b))) (snd (suc ((suc a), b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt805Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215Pair_next)) (eqtr (eqcom sndpr) (sndeq k215Pair_next)) eqid eqid)) k215UnpairAt805CycleSucc);

pub theorem k215UnpairAt805Advance (a b n c: nat): $ k215PReach (k215UnpairAt805State k215PNum805 a b (suc n) c) (k215UnpairAt805State k215PNum805 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
 (named @ induct '(ind) 'a 'k215UnpairAt805AdvanceZero '(a1i k215UnpairAt805AdvanceSucc));
@_ abstract def k215UnpairAt805Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt805State k215PNum805 a b n c) (k215UnpairAt805State k215PNum813 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
theorem k215UnpairAt805RunZero (a b c: nat): $ k215UnpairAt805Run 0 a b c $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt805Stateeq eqid
     (eqcom (eqtr (fsteq add0) fstpr))
     (eqcom (eqtr (sndeq add0) sndpr)) eqid eqid)) k215UnpairAt805Reach9Z);
@_ abstract def k215UnpairAt805Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt805Run n a b c $;
theorem k215UnpairAt805Claim_at (n a b c: nat): $ k215UnpairAt805Claim n c -> k215UnpairAt805Run n a b c $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215UnpairAt805CodeStep (a b n: nat): $ (fst (suc (a, b)), snd (suc (a, b))) + n = (a, b) + suc n $ =
 '(eqtr (addeq1 fstsnd) addSass);
theorem k215UnpairAt805RunInductive (n a b c: nat): $ k215UnpairAt805Claim n c -> k215UnpairAt805Run (suc n) a b c $ =
 '(syl (ax_mp k215PReach_trans k215UnpairAt805Advance)
   (mpbid (a1i (k215PReacheq2 (k215UnpairAt805Stateeq eqid
     (fsteq k215UnpairAt805CodeStep) (sndeq k215UnpairAt805CodeStep) eqid eqid))) k215UnpairAt805Claim_at));
theorem k215UnpairAt805Claim_all (n c: nat): $ k215UnpairAt805Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt805RunZero)) '(iald @ iald k215UnpairAt805RunInductive));
pub theorem k215UnpairMacro805 (n a b c: nat): $ k215PReach (k215UnpairAt805State k215PNum805 a b n c) (k215UnpairAt805State k215PNum813 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
 '(ax_mp k215UnpairAt805Claim_at k215UnpairAt805Claim_all);
pub theorem k215UnpairMacro805_clean (n c: nat): $ k215PReach (k215UnpairAt805State k215PNum805 0 0 n c) (k215UnpairAt805State k215PNum813 (fst n) (snd n) 0 c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt805Stateeq eqid
   (fsteq (eqtr (addeq1 pr0) add01))
   (sndeq (eqtr (addeq1 pr0) add01)) eqid eqid)) k215UnpairMacro805);


