import "source_reflection_transfer_tv_requirements.mm1";

import "source_reflection_transfer_tv_logic.mm1";

@_ def sfTVInductionClass(D:nat)(.c .g .y:nat):set = $ {c | A. g A. y (sfContextWf g -> nsLocal g (sfTVRequirements D y c) -> nsLocal g (sfAll (sfImp (sfMem 0 (suc y)) D)) -> nsLocal g (sfIff (sfRelativize D c) (sfCLSetRel y c)))} $;

theorem sftvi_value(D c:nat): $ c e. sfTVInductionClass D <-> A. g A. y (sfContextWf g -> nsLocal g (sfTVRequirements D y c) -> nsLocal g (sfAll (sfImp (sfMem 0 (suc y)) D)) -> nsLocal g (sfIff (sfRelativize D c) (sfCLSetRel y c))) $ = (named '(elabe ,eqtac));

theorem sftvi_each(D c G z:nat): $ (A. g A. y (sfContextWf g -> nsLocal g (sfTVRequirements D y c) -> nsLocal g (sfAll (sfImp (sfMem 0 (suc y)) D)) -> nsLocal g (sfIff (sfRelativize D c) (sfCLSetRel y c)))) -> sfContextWf G -> nsLocal G (sfTVRequirements D z c) -> nsLocal G (sfAll (sfImp (sfMem 0 (suc z)) D)) -> nsLocal G (sfIff (sfRelativize D c) (sfCLSetRel z c)) $ = (named '(!! ealie g @ !! ealde y @ bi1d ,eqtac));

theorem sftvi_use(D c G z:nat): $ c e. sfTVInductionClass D -> sfContextWf G -> nsLocal G (sfTVRequirements D z c) -> nsLocal G (sfAll (sfImp (sfMem 0 (suc z)) D)) -> nsLocal G (sfIff (sfRelativize D c) (sfCLSetRel z c)) $ = (named '(syl sftvi_each (bi1 sftvi_value)));

theorem sftvi_apply(H:wff)(D c G z:nat)(hi:$ H -> c e. sfTVInductionClass D $)(hg:$ H -> sfContextWf G $)(hw:$ H -> nsLocal G (sfTVRequirements D z c) $)(hc:$ H -> nsLocal G (sfAll (sfImp (sfMem 0 (suc z)) D)) $): $ H -> nsLocal G (sfIff (sfRelativize D c) (sfCLSetRel z c)) $ = (named '(mpd hc (mpd hw (mpd hg (syl sftvi_use hi)))));

theorem sftvi_pure3(H:wff)(G A B C Q:nat)(hp:$ nsLocal 0 (sfImp A (sfImp B (sfImp C Q))) $)(ha:$ H -> nsLocal G A $)(hb:$ H -> nsLocal G B $)(hc:$ H -> nsLocal G C $): $ H -> nsLocal G Q $ = (named '(mpd hc (syl nsLocal_mp (mpd hb (syl nsLocal_mp (mpd ha (syl nsLocal_mp (mpd (a1i hp) (mpd (a1i all0) (syl nsLocal_weaken (syl nsLocal_context_wf ha)))))))))));

theorem sftvi_pure1(H:wff)(G A Q:nat)(hg:$ H -> sfContextWf G $)(hp:$ nsLocal 0 (sfImp A Q) $)(ha:$ H -> nsLocal G A $): $ H -> nsLocal G Q $ = (named '(mpd ha (syl nsLocal_mp (mpd (a1i hp) (mpd (a1i all0) (syl nsLocal_weaken hg))))));

pub theorem sfTVContainment_shift(D y:nat)(hd:$ sfBound 1 D $): $ sfShift 0 (sfAll (sfImp (sfMem 0 (suc y)) D)) = sfAll (sfImp (sfMem 0 (suc (suc y))) D) $ = (named '(eqtr sfShift_sfAll (nsAll_eq (eqtr sfShift_sfImp (nsImp_eq (eqtr sfShift_sfMem (nsMem_eq (ax_mp sfShiftIndex_bound d0lt1) (ax_mp sfShiftIndex_free (mpbi lenlt (mpbi lesuc le01))))) (ax_mp sfShift_bound_identity hd))))));

theorem sftvi_atom_bot(H:wff)(D G y:nat)(hg:$ H -> sfContextWf G $): $ H -> nsLocal G (sfIff (sfRelativize D sfBot) (sfCLSetRel y sfBot)) $ = (named '(syl (bi1 (nsLocal_formula_eq (nsAnd_eq (nsImp_eq (eqcom sfRelativize_bot) (eqcom sfCLSetRel_bot)) (nsImp_eq (eqcom sfCLSetRel_bot) (eqcom sfRelativize_bot))))) (mpd (a1i (sfTVRefl_local sfContextWf_nil sfWf_bot)) (mpd (a1i all0) (syl nsLocal_weaken hg)))));

theorem sftvi_atom_Mem(H:wff)(D G y a b:nat)(hg:$ H -> sfContextWf G $): $ H -> nsLocal G (sfIff (sfRelativize D (sfMem a b)) (sfCLSetRel y (sfMem a b))) $ = (named '(syl (bi1 (nsLocal_formula_eq (nsAnd_eq (nsImp_eq (eqcom sfRelativize_sfMem) (eqcom sfCLSetRel_sfMem)) (nsImp_eq (eqcom sfCLSetRel_sfMem) (eqcom sfRelativize_sfMem))))) (mpd (a1i (sfTVRefl_local sfContextWf_nil sfWf_mem)) (mpd (a1i all0) (syl nsLocal_weaken hg)))));

theorem sftvi_atom_Eq(H:wff)(D G y a b:nat)(hg:$ H -> sfContextWf G $): $ H -> nsLocal G (sfIff (sfRelativize D (sfEq a b)) (sfCLSetRel y (sfEq a b))) $ = (named '(syl (bi1 (nsLocal_formula_eq (nsAnd_eq (nsImp_eq (eqcom sfRelativize_sfEq) (eqcom sfCLSetRel_sfEq)) (nsImp_eq (eqcom sfCLSetRel_sfEq) (eqcom sfRelativize_sfEq))))) (mpd (a1i (sfTVRefl_local sfContextWf_nil sfWf_eq)) (mpd (a1i all0) (syl nsLocal_weaken hg)))));

theorem sftvi_binary_And(H:wff)(D a b G y:nat)(hd:$ sfBound 1 D $)(hi:$ H -> a e. sfTVInductionClass D $)(hj:$ H -> b e. sfTVInductionClass D $)(hg:$ H -> sfContextWf G $)(hw:$ H -> nsLocal G (sfTVRequirements D y (sfAnd a b)) $)(hc:$ H -> nsLocal G (sfAll (sfImp (sfMem 0 (suc y)) D)) $): $ H -> nsLocal G (sfIff (sfRelativize D (sfAnd a b)) (sfCLSetRel y (sfAnd a b))) $ = (named '(syl (bi1 (nsLocal_formula_eq (nsAnd_eq (nsImp_eq (eqcom sfRelativize_sfAnd) (eqcom sfCLSetRel_sfAnd)) (nsImp_eq (eqcom sfCLSetRel_sfAnd) (eqcom sfRelativize_sfAnd))))) (mpd (sftvi_apply hj hg (syl nsLocal_CE2 (syl (bi1 (nsLocal_formula_eq sfTVRequirements_sfAnd)) hw)) hc) (syl nsLocal_mp (mpd (sftvi_apply hi hg (syl nsLocal_CE1 (syl (bi1 (nsLocal_formula_eq sfTVRequirements_sfAnd)) hw)) hc) (syl nsLocal_mp (mpd (a1i (sfTVAnd_pure (ax_mp sfRelativize_wf (ax_mp sfBound_wf hd)) sfCLSetRel_wf (ax_mp sfRelativize_wf (ax_mp sfBound_wf hd)) sfCLSetRel_wf)) (mpd (a1i all0) (syl nsLocal_weaken hg)))))))));

theorem sftvi_binary_Or(H:wff)(D a b G y:nat)(hd:$ sfBound 1 D $)(hi:$ H -> a e. sfTVInductionClass D $)(hj:$ H -> b e. sfTVInductionClass D $)(hg:$ H -> sfContextWf G $)(hw:$ H -> nsLocal G (sfTVRequirements D y (sfOr a b)) $)(hc:$ H -> nsLocal G (sfAll (sfImp (sfMem 0 (suc y)) D)) $): $ H -> nsLocal G (sfIff (sfRelativize D (sfOr a b)) (sfCLSetRel y (sfOr a b))) $ = (named '(syl (bi1 (nsLocal_formula_eq (nsAnd_eq (nsImp_eq (eqcom sfRelativize_sfOr) (eqcom sfCLSetRel_sfOr)) (nsImp_eq (eqcom sfCLSetRel_sfOr) (eqcom sfRelativize_sfOr))))) (mpd (sftvi_apply hj hg (syl nsLocal_CE2 (syl (bi1 (nsLocal_formula_eq sfTVRequirements_sfOr)) hw)) hc) (syl nsLocal_mp (mpd (sftvi_apply hi hg (syl nsLocal_CE1 (syl (bi1 (nsLocal_formula_eq sfTVRequirements_sfOr)) hw)) hc) (syl nsLocal_mp (mpd (a1i (sfTVOr_pure (ax_mp sfRelativize_wf (ax_mp sfBound_wf hd)) sfCLSetRel_wf (ax_mp sfRelativize_wf (ax_mp sfBound_wf hd)) sfCLSetRel_wf)) (mpd (a1i all0) (syl nsLocal_weaken hg)))))))));

theorem sftvi_binary_Imp(H:wff)(D a b G y:nat)(hd:$ sfBound 1 D $)(hi:$ H -> a e. sfTVInductionClass D $)(hj:$ H -> b e. sfTVInductionClass D $)(hg:$ H -> sfContextWf G $)(hw:$ H -> nsLocal G (sfTVRequirements D y (sfImp a b)) $)(hc:$ H -> nsLocal G (sfAll (sfImp (sfMem 0 (suc y)) D)) $): $ H -> nsLocal G (sfIff (sfRelativize D (sfImp a b)) (sfCLSetRel y (sfImp a b))) $ = (named '(syl (bi1 (nsLocal_formula_eq (nsAnd_eq (nsImp_eq (eqcom sfRelativize_sfImp) (eqcom sfCLSetRel_sfImp)) (nsImp_eq (eqcom sfCLSetRel_sfImp) (eqcom sfRelativize_sfImp))))) (mpd (sftvi_apply hj hg (syl nsLocal_CE2 (syl (bi1 (nsLocal_formula_eq sfTVRequirements_sfImp)) hw)) hc) (syl nsLocal_mp (mpd (sftvi_apply hi hg (syl nsLocal_CE1 (syl (bi1 (nsLocal_formula_eq sfTVRequirements_sfImp)) hw)) hc) (syl nsLocal_mp (mpd (a1i (sfTVImp_pure (ax_mp sfRelativize_wf (ax_mp sfBound_wf hd)) sfCLSetRel_wf (ax_mp sfRelativize_wf (ax_mp sfBound_wf hd)) sfCLSetRel_wf)) (mpd (a1i all0) (syl nsLocal_weaken hg)))))))));

theorem sftvi_quantifier_All(H:wff)(D a G y:nat)(hd:$ sfBound 1 D $)(hi:$ H -> a e. sfTVInductionClass D $)(hg:$ H -> sfContextWf G $)(hw:$ H -> nsLocal G (sfTVRequirements D y (sfAll a)) $)(hc:$ H -> nsLocal G (sfAll (sfImp (sfMem 0 (suc y)) D)) $): $ H -> nsLocal G (sfIff (sfRelativize D (sfAll a)) (sfCLSetRel y (sfAll a))) $ = (named '(syl (bi1 (nsLocal_formula_eq (nsAnd_eq (nsImp_eq (eqcom sfRelativize_sfAll) (eqcom sfCLSetRel_sfAll)) (nsImp_eq (eqcom sfCLSetRel_sfAll) (eqcom sfRelativize_sfAll))))) (sftvi_pure3 (sfTVAll_pure (ax_mp sfBound_wf hd) sfWf_mem (ax_mp sfRelativize_wf (ax_mp sfBound_wf hd)) sfCLSetRel_wf) (mpd (syl nsLocal_II (sftvi_apply hi (mpbird (a1i sfContextWf_cons) (iand (a1i sfWf_mem) (a1i sfContextShift_wf))) (mpd (mpd (a1i sfContext_member_head) (syl nsLocal_hyp (mpbird (a1i sfContextWf_cons) (iand (a1i sfWf_mem) (a1i sfContextShift_wf))))) (syl nsLocal_mp (mpd (syl sfSepLocal_open (syl nsLocal_CE2 (syl (bi1 (nsLocal_formula_eq sfTVRequirements_sfAll)) hw))) (mpd (a1i sfContextSub_cons) (syl nsLocal_weaken (mpbird (a1i sfContextWf_cons) (iand (a1i sfWf_mem) (a1i sfContextShift_wf)))))))) (mpd (syl (bi1 (nsLocal_formula_eq (sfTVContainment_shift hd))) (syl sfSepLocal_shift hc)) (mpd (a1i sfContextSub_cons) (syl nsLocal_weaken (mpbird (a1i sfContextWf_cons) (iand (a1i sfWf_mem) (a1i sfContextShift_wf)))))))) (syl sfSepLocal_allI hg)) hc (syl nsLocal_CE1 (syl (bi1 (nsLocal_formula_eq sfTVRequirements_sfAll)) hw)))));

theorem sftvi_quantifier_Ex(H:wff)(D a G y:nat)(hd:$ sfBound 1 D $)(hi:$ H -> a e. sfTVInductionClass D $)(hg:$ H -> sfContextWf G $)(hw:$ H -> nsLocal G (sfTVRequirements D y (sfEx a)) $)(hc:$ H -> nsLocal G (sfAll (sfImp (sfMem 0 (suc y)) D)) $): $ H -> nsLocal G (sfIff (sfRelativize D (sfEx a)) (sfCLSetRel y (sfEx a))) $ = (named '(syl (bi1 (nsLocal_formula_eq (nsAnd_eq (nsImp_eq (eqcom sfRelativize_sfEx) (eqcom sfCLSetRel_sfEx)) (nsImp_eq (eqcom sfCLSetRel_sfEx) (eqcom sfRelativize_sfEx))))) (sftvi_pure3 (sfTVExists_pure (ax_mp sfBound_wf hd) sfWf_mem (ax_mp sfRelativize_wf (ax_mp sfBound_wf hd)) sfCLSetRel_wf) (mpd (syl nsLocal_II (sftvi_apply hi (mpbird (a1i sfContextWf_cons) (iand (a1i sfWf_mem) (a1i sfContextShift_wf))) (mpd (mpd (a1i sfContext_member_head) (syl nsLocal_hyp (mpbird (a1i sfContextWf_cons) (iand (a1i sfWf_mem) (a1i sfContextShift_wf))))) (syl nsLocal_mp (mpd (syl sfSepLocal_open (syl nsLocal_CE2 (syl (bi1 (nsLocal_formula_eq sfTVRequirements_sfEx)) hw))) (mpd (a1i sfContextSub_cons) (syl nsLocal_weaken (mpbird (a1i sfContextWf_cons) (iand (a1i sfWf_mem) (a1i sfContextShift_wf)))))))) (mpd (syl (bi1 (nsLocal_formula_eq (sfTVContainment_shift hd))) (syl sfSepLocal_shift hc)) (mpd (a1i sfContextSub_cons) (syl nsLocal_weaken (mpbird (a1i sfContextWf_cons) (iand (a1i sfWf_mem) (a1i sfContextShift_wf)))))))) (syl sfSepLocal_allI hg)) hc (syl nsLocal_CE1 (syl (bi1 (nsLocal_formula_eq sfTVRequirements_sfEx)) hw)))));

theorem sftvi_closed_bot(D:nat): $ sfBot e. sfTVInductionClass D $ = (named '(mpbir sftvi_value @ ax_gen @ ax_gen @ a1d @ a1d @ sftvi_atom_bot id));

theorem sftvi_closed_Mem(D a b:nat): $ (sfMem a b) e. sfTVInductionClass D $ = (named '(mpbir sftvi_value @ ax_gen @ ax_gen @ a1d @ a1d @ sftvi_atom_Mem id));

theorem sftvi_closed_Eq(D a b:nat): $ (sfEq a b) e. sfTVInductionClass D $ = (named '(mpbir sftvi_value @ ax_gen @ ax_gen @ a1d @ a1d @ sftvi_atom_Eq id));

theorem sftvi_closed_atomic(D:nat): $ sfAtomicClosed (sfTVInductionClass D) $ = (named '(ax_gen @ ax_gen @ ian sftvi_closed_Mem sftvi_closed_Eq));

theorem sftvi_closed_And(D a b:nat)(hd:$ sfBound 1 D $): $ a e. sfTVInductionClass D /\ b e. sfTVInductionClass D -> sfAnd a b e. sfTVInductionClass D $ = (named '(mpbird (a1i sftvi_value) @ !! iald g @ !! iald y @ exp @ exp @ exp @ sftvi_binary_And hd (syl anl (syl anl anll)) (syl anr (syl anl anll)) (syl anr anll) anlr anr));

theorem sftvi_closed_Or(D a b:nat)(hd:$ sfBound 1 D $): $ a e. sfTVInductionClass D /\ b e. sfTVInductionClass D -> sfOr a b e. sfTVInductionClass D $ = (named '(mpbird (a1i sftvi_value) @ !! iald g @ !! iald y @ exp @ exp @ exp @ sftvi_binary_Or hd (syl anl (syl anl anll)) (syl anr (syl anl anll)) (syl anr anll) anlr anr));

theorem sftvi_closed_Imp(D a b:nat)(hd:$ sfBound 1 D $): $ a e. sfTVInductionClass D /\ b e. sfTVInductionClass D -> sfImp a b e. sfTVInductionClass D $ = (named '(mpbird (a1i sftvi_value) @ !! iald g @ !! iald y @ exp @ exp @ exp @ sftvi_binary_Imp hd (syl anl (syl anl anll)) (syl anr (syl anl anll)) (syl anr anll) anlr anr));

theorem sftvi_closed_binary(D:nat)(hd:$ sfBound 1 D $): $ sfBinaryClosed (sfTVInductionClass D) $ = (named '(ax_gen @ ax_gen @ iand (iand (sftvi_closed_And hd) (sftvi_closed_Or hd)) (sftvi_closed_Imp hd)));

theorem sftvi_closed_All(D a:nat)(hd:$ sfBound 1 D $): $ a e. sfTVInductionClass D -> sfAll a e. sfTVInductionClass D $ = (named '(mpbird (a1i sftvi_value) @ !! iald g @ !! iald y @ exp @ exp @ exp @ sftvi_quantifier_All hd (syl anl anll) (syl anr anll) anlr anr));

theorem sftvi_closed_Ex(D a:nat)(hd:$ sfBound 1 D $): $ a e. sfTVInductionClass D -> sfEx a e. sfTVInductionClass D $ = (named '(mpbird (a1i sftvi_value) @ !! iald g @ !! iald y @ exp @ exp @ exp @ sftvi_quantifier_Ex hd (syl anl anll) (syl anr anll) anlr anr));

theorem sftvi_closed_quantifier(D:nat)(hd:$ sfBound 1 D $): $ sfQuantifierClosed (sfTVInductionClass D) $ = (named '(ax_gen @ iand (sftvi_closed_All hd) (sftvi_closed_Ex hd)));

theorem sftvi_closed(D:nat)(hd:$ sfBound 1 D $): $ sfConstructionClosed (sfTVInductionClass D) $ = (named '(ian (ian (ian sftvi_closed_bot sftvi_closed_atomic) (sftvi_closed_binary hd)) (sftvi_closed_quantifier hd)));

pub theorem sfTV_uniform(D c G y:nat)(hd:$ sfBound 1 D $)(hf:$ sfWf c $)(hg:$ sfContextWf G $)(hw:$ nsLocal G (sfTVRequirements D y c) $)(hc:$ nsLocal G (sfAll (sfImp (sfMem 0 (suc y)) D)) $): $ nsLocal G (sfIff (sfRelativize D c) (sfCLSetRel y c)) $ = (named '(ax_mp (ax_mp (ax_mp (ax_mp sftvi_use (ax_mp (ax_mp sfWf_induction (sftvi_closed hd)) hf)) hg) hw) hc));
