import "source_l_clstage_final_power.mm1";
import "source_l_replacement_next_bridge.mm1";

-- Lane L02: the replacement definability law with rep_ex and NextLevel discharged.
pub theorem sfLReplacementDefinableLaw_zfr(m psi:nat)(hb:$ sfBound (suc m) psi $):
 $ sfTheoryProvable zfrAxioms (sfLReplacementDefinableLaw m psi) $ =
 '(sfLReplacementDefinableLaw_from_rep hb (sfLRepLaw_zfr hb) sfLNextLevelLaw_zfr);
