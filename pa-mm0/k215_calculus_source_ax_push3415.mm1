theorem k215PairVectorInAt3415 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt3421State k215PNum3421 a6 a1 a7 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum3421 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215PairVectorOutAt3415 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt3421State k215PNum3431 0 0 (a7 + (a6, a1)) (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum3431 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

pub theorem k215PairMacro46_vectorAt3415 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat):
 $ k215PReach (k215PState k215PNum3421 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215PNum3431 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ =
 '(mpbi (k215PReacheq k215PairVectorInAt3415 k215PairVectorOutAt3415) k215PairMacro3421);

theorem k215PushAStage0At3415 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum3415 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum3418 (k215PVector u 0 w c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop3415Vector (k215PStateeq2 (k215PVectoreq7 add0))));

theorem k215PushAStage1At3415 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum3418 (k215PVector u 0 w c a b t 0 v)) (k215PState k215PNum3421 (k215PVector u w 0 c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop3418Vector (k215PStateeq2 (k215PVectoreq2 add0))));

theorem k215PushAStage2At3415 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum3421 (k215PVector u w 0 c a b t 0 v)) (k215PState k215PNum3431 (k215PVector u 0 0 c a b 0 (t, w) v)) $ = '(mpbi (k215PReacheq2 (k215PStateeq2 (k215PVectoreq8 add01))) k215PairMacro46_vectorAt3415);

theorem k215PushAStage3At3415 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum3431 (k215PVector u 0 0 c a b 0 (t, w) v)) (k215PState k215PNum3434 (k215PVector u 0 (t, w) c a b 0 0 v)) $ = '(k215PReach_intro (eqtr k215Loop3431Vector (k215PStateeq2 (k215PVectoreq3 add0))));

theorem k215PushAStage4At3415 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum3434 (k215PVector u 0 (t, w) c a b 0 0 v)) (k215PState k215PNum3438 (k215PVector u c (t, w) 0 a b c 0 v)) $ = '(k215PReach_intro (eqtr k215Loop3434Vector (k215PStateeq2 (k215PVectoreq eqid add0 eqid eqid eqid eqid add0 eqid eqid))));

theorem k215PushAStage5At3415 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum3438 (k215PVector u c (t, w) 0 a b c 0 v)) (k215PState k215PNum3441 (k215PVector u c (t, w) c a b 0 0 v)) $ = '(k215PReach_intro (eqtr k215Loop3438Vector (k215PStateeq2 (k215PVectoreq4 add0))));

pub theorem k215PushParam3415 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum3415 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum3441 (k215PVector u c (t, w) c a b 0 0 v)) $ = '(ax_mp (ax_mp k215PReach_trans k215PushAStage0At3415) (ax_mp (ax_mp k215PReach_trans k215PushAStage1At3415) (ax_mp (ax_mp k215PReach_trans k215PushAStage2At3415) (ax_mp (ax_mp k215PReach_trans k215PushAStage3At3415) (ax_mp (ax_mp k215PReach_trans k215PushAStage4At3415) k215PushAStage5At3415)))));

