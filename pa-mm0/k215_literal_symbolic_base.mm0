import "k215_literal_actions.mm0";
import "k215_literal_dispatch.mm0";

theorem k215Sym_bit (b r: nat):
 $ k215TmRepeat b 1 r = k215TmPush b r $;

theorem k215Sym_blank (n: nat): $ k215TmRepeat 0 n 0 = 0 $;

theorem k215Sym_repeat_merge (b m n r: nat):
 $ k215TmRepeat b m (k215TmRepeat b n r) = k215TmRepeat b (m + n) r $;
