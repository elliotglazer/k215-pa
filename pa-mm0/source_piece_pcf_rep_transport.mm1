pub theorem sfPieceNumeralCore_wf(k:nat): $ sfWf (sfPieceNumeralCore k) $ =
 '(ax_mp sfBound_wf sfPieceNumeralCore_bound);

pub theorem sfPieceNumeral_rename(R:set)(k x:nat):
 $ sfRename R 0 (sfPieceNumeral k x) = sfPieceNumeral k (R @ x) $ =
 '(eqtr (ax_mp sfRename_subst sfPieceNumeralCore_wf)
   (trud (sfSubst_congr (a1i eqid) (a1i eqid)
     (a1i (ax_mp sfRename_bound_identity sfPieceNumeralCore_bound)))));

pub theorem sfPieceNumeral_rename_depth(R:set)(d k x:nat):
 $ sfRename R d (sfPieceNumeral k x) = sfPieceNumeral k (sfRenameIndex R d x) $ =
 '(eqtr (ax_mp sfRename_as_map sfPieceNumeral_wf)
   (eqtr sfPieceNumeral_rename
    (trud (sfSubst_congr (a1i eqid) (a1i sfRenameDepthMap_value) (a1i eqid)))));

pub theorem sfPieceNumeral_subst(d t k x:nat):
 $ sfSubst d t (sfPieceNumeral k x) = sfPieceNumeral k (sfSubstIndex d t x) $ =
 '(eqtr (ax_mp sfSubst_as_map sfPieceNumeral_wf)
   (eqtr sfPieceNumeral_rename
    (trud (sfSubst_congr (a1i eqid) (a1i sfSubstDepthMap_value) (a1i eqid)))));

pub theorem sfPieceNumeral_suc_instance(k x y:nat):
 $ sfSubst 0 x (sfAnd (sfPieceNumeralCore k) (sfPieceRepSuccessor 0 (suc y))) =
   sfAnd (sfPieceNumeral k x) (sfPieceRepSuccessor x y) $ =
 '(eqtr sfSubst_sfAnd (nsAnd_eq eqid
   (eqtr sfPieceRepSuccessor_subst
    (sfPieceRepSuccessor_eq sfSubstIndex_zero sfSubstIndex_successor))));

pub theorem sfPieceNumeral_suc_intro(G k x y:nat)
 (hn:$ nsLocal G (sfPieceNumeral k x) $)
 (hs:$ nsLocal G (sfPieceRepSuccessor x y) $):
 $ nsLocal G (sfPieceNumeral (suc k) y) $ =
 '(mpbir (nsLocal_formula_eq sfPieceNumeral_suc)
   (ax_mp (ax_mp nsLocal_ExI
     (ax_mp (ax_mp sfWf_and sfPieceNumeralCore_wf) sfPieceRepSuccessor_wf))
    (mpbir (nsLocal_formula_eq sfPieceNumeral_suc_instance) (sfLocal_and hn hs))));

theorem pcrt_zero_base:
 $ sfPieceNumeral 0 0 = sfPieceNumeralCore 0 $ =
 '(eqtr sfPieceNumeral_zero (eqcom sfPieceNumeralCore_zero));
theorem pcrt_zero_suc(k:nat):
 $ sfPieceNumeral (suc k) 0 = sfPieceNumeralCore (suc k) $ =
 '(eqtr sfPieceNumeral_suc (eqcom sfPieceNumeralCore_suc));
pub theorem sfPieceNumeral_at_zero(k:nat):
 $ sfPieceNumeral k 0 = sfPieceNumeralCore k $ =
 (named @ induct '(ind) 'k 'pcrt_zero_base '(a1i pcrt_zero_suc));
pub theorem sfPieceNumeral_suc_normal(k y:nat):
 $ sfPieceNumeral (suc k) y =
   sfEx (sfAnd (sfPieceNumeral k 0) (sfPieceRepSuccessor 0 (suc y))) $ =
 '(eqtr sfPieceNumeral_suc
   (nsEx_eq (nsAnd_eq (eqcom sfPieceNumeral_at_zero) eqid)));
pub theorem sfPieceNumeral_suc_eliminate(G k y out:nat)
 (ho:$ sfWf out $)(hn:$ nsLocal G (sfPieceNumeral (suc k) y) $)
 (hc:$ nsLocal (sfAnd (sfPieceNumeral k 0) (sfPieceRepSuccessor 0 (suc y)) : sfContextShift G) (sfShift 0 out) $):
 $ nsLocal G out $ =
 '(ax_mp (ax_mp (sfLocal_exE ho)
   (mpbi (nsLocal_formula_eq sfPieceNumeral_suc_normal) hn)) hc);
