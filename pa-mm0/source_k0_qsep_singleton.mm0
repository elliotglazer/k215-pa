import "source_k0_qsep_matrix_alignment.mm0";

import "source_k0_qsep_tagged_branches.mm0";

import "k218q_equality.mm0";

import "k218q_specialization.mm0";

theorem sfK0QSepSingleton_select (y r k z: nat) (hy: $ y < k $) (hr: $ r < k $) (hz: $ z < k $):
 $ k218QProvable (kImp (sfK0QSepNamedSingleton y r k) (kImp (kMem z r) (kEq z y))) $;

theorem sfK0QSepPair_not_singleton_at (b t r y k: nat) (hb: $ b < k $) (ht: $ t < k $) (hr: $ r < k $) (hy: $ y < k $):
 $ k218QProvable (kImp (kMem b r) (kImp (kMem t r) (kImp (kImp (kEq b t) kF) (kImp (sfK0QSepNamedSingleton y r k) kF)))) $;

theorem sfK0QSepPair_not_singleton (b t r y k: nat) (hb: $ b < k $) (ht: $ t < k $) (hr: $ r < k $) (hy: $ y < k $) (hyb: $ y != b $) (hyt: $ y != t $) (hyr: $ y != r $):
 $ k218QProvable (kImp (kMem b r) (kImp (kMem t r) (kImp (kImp (kEq b t) kF) (kAll y (kImp (sfK0QSepNamedSingleton y r k) kF))))) $;
