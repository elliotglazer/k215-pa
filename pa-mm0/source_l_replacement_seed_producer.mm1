import "source_l_replacement_seed_source.mm1";
@_ def lrepSeedProducerF0(phi:nat):nat = $ sfEx (sfLReplacementAmbientBody phi) $;

@_ def lrepSeedProducerF1(phi:nat):nat = $ sfAll (lrepSeedProducerF0 phi) $;

@_ def lrepSeedProducerG2(phi:nat):nat = $ sfLPowerLevelBound : 0 $;

@_ def lrepSeedProducerG3(phi:nat):nat = $ (lrepSeedProducerF1 phi) : (lrepSeedProducerG2 phi) $;

@_ def lrepSeedProducerG4(phi:nat):nat = $ sfContextShift (lrepSeedProducerG3 phi) $;

@_ def lrepSeedProducerF5(phi:nat):nat = $ sfShift 0 sfLPowerLevelBound $;

@_ def lrepSeedProducerG6(phi:nat):nat = $ sfContextShift (lrepSeedProducerG4 phi) $;

@_ def lrepSeedProducerG7(phi:nat):nat = $ (sfLReplacementAmbientBody phi) : (lrepSeedProducerG6 phi) $;

@_ def lrepSeedProducerF8(phi:nat):nat = $ sfShift 1 (sfLReplacementSeedRange (sfLReplacementSeedMatrix phi) sfLReplacementSeedMetadata) $;

@_ def lrepSeedProducerF9(phi:nat):nat = $ sfEx (lrepSeedProducerF8 phi) $;

@_ def lrepSeedProducerF10(phi:nat):nat = $ sfEx (sfLReplacementSeedRange (sfLReplacementSeedMatrix phi) sfLReplacementSeedMetadata) $;

@_ def lrepSeedProducerF11(phi:nat):nat = $ sfShift 0 (lrepSeedProducerF10 phi) $;

@_ def lrepSeedProducerF12(phi:nat):nat = $ sfAll (lrepSeedProducerF10 phi) $;

@_ def lrepSeedProducerF13(phi:nat):nat = $ sfImp (lrepSeedProducerF1 phi) (lrepSeedProducerF12 phi) $;

@_ def lrepSeedProducerF14(phi:nat):nat = $ sfImp sfLPowerLevelBound (lrepSeedProducerF13 phi) $;

@_ def lrepSeedProducerF15(phi:nat):nat = $ sfImp (sfLReplacementFunctional phi) (lrepSeedProducerF1 phi) $;

@_ def lrepSeedProducerG16(phi:nat):nat = $ (lrepSeedProducerF15 phi) : 0 $;

@_ def lrepSeedProducerG17(phi:nat):nat = $ (lrepSeedProducerF13 phi) : (lrepSeedProducerG16 phi) $;

@_ def lrepSeedProducerG18(phi:nat):nat = $ (sfLReplacementFunctional phi) : (lrepSeedProducerG17 phi) $;

@_ def lrepSeedProducerF19(phi:nat):nat = $ sfImp (sfLReplacementFunctional phi) (lrepSeedProducerF12 phi) $;

@_ def lrepSeedProducerF20(phi:nat):nat = $ sfImp (lrepSeedProducerF13 phi) (lrepSeedProducerF19 phi) $;

@_ def lrepSeedProducerF21(phi:nat):nat = $ sfImp (lrepSeedProducerF15 phi) (lrepSeedProducerF20 phi) $;

theorem lrepSeedProducerP1(phi:nat)(hf:$ sfWf phi $):
 $ sfWf (lrepSeedProducerF0 phi) $ =
 '(ax_mp sfWf_ex (ax_mp sfWf_all (mpbir sfWf_iff (ian sfWf_mem (ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and sfWf_mem) sfRename_wf))))));

theorem lrepSeedProducerP2(phi:nat)(hf:$ sfWf phi $):
 $ sfWf (lrepSeedProducerF1 phi) $ =
 '(ax_mp sfWf_all (lrepSeedProducerP1 hf));

theorem lrepSeedProducerP3(phi:nat)(hf:$ sfWf phi $):
 $ nsLocal (lrepSeedProducerG3 phi) (lrepSeedProducerF1 phi) $ =
 '(ax_mp (ax_mp nsLocal_hyp (mpbir sfContextWf_cons (ian (lrepSeedProducerP2 hf) (mpbir sfContextWf_cons (ian (ax_mp sfBound_wf sfLPowerLevelBound_bound) sfContextWf_nil))))) sfContext_member_head);

theorem lrepSeedProducerP4(phi:nat)(hf:$ sfWf phi $):
 $ nsLocal (lrepSeedProducerG4 phi) (lrepSeedProducerF0 phi) $ =
 '(ax_mp sfSepLocal_open (lrepSeedProducerP3 hf));

theorem lrepSeedProducerP5(phi:nat)(hf:$ sfWf phi $):
 $ nsLocal (lrepSeedProducerG3 phi) sfLPowerLevelBound $ =
 '(ax_mp (ax_mp nsLocal_hyp (mpbir sfContextWf_cons (ian (lrepSeedProducerP2 hf) (mpbir sfContextWf_cons (ian (ax_mp sfBound_wf sfLPowerLevelBound_bound) sfContextWf_nil))))) (ax_mp sfContext_member_tail sfContext_member_head));

theorem lrepSeedProducerP6(phi:nat)(hf:$ sfWf phi $):
 $ nsLocal (lrepSeedProducerG4 phi) (lrepSeedProducerF5 phi) $ =
 '(ax_mp sfSepLocal_shift (lrepSeedProducerP5 hf));

theorem lrepSeedProducerP7(phi:nat)(hf:$ sfWf phi $):
 $ nsLocal (lrepSeedProducerG4 phi) sfLPowerLevelBound $ =
 '(mpbi (nsLocal_formula_eq (ax_mp sfShift_closed_identity sfLPowerLevelBound_bound)) (lrepSeedProducerP6 hf));

theorem lrepSeedProducerP8(phi:nat)(hf:$ sfWf phi $):
 $ nsLocal (lrepSeedProducerG6 phi) (lrepSeedProducerF5 phi) $ =
 '(ax_mp sfSepLocal_shift (lrepSeedProducerP7 hf));

theorem lrepSeedProducerP9(phi:nat)(hf:$ sfWf phi $):
 $ nsLocal (lrepSeedProducerG6 phi) sfLPowerLevelBound $ =
 '(mpbi (nsLocal_formula_eq (ax_mp sfShift_closed_identity sfLPowerLevelBound_bound)) (lrepSeedProducerP8 hf));

theorem lrepSeedProducerP10(phi:nat)(hf:$ sfWf phi $):
 $ nsLocal (lrepSeedProducerG7 phi) sfLPowerLevelBound $ =
 '(ax_mp (ax_mp (ax_mp nsLocal_weaken (mpbir sfContextWf_cons (ian (ax_mp sfWf_all (mpbir sfWf_iff (ian sfWf_mem (ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and sfWf_mem) sfRename_wf))))) sfContextShift_wf))) sfContextSub_cons) (lrepSeedProducerP9 hf));

theorem lrepSeedProducerP11(phi:nat)(hf:$ sfWf phi $):
 $ nsLocal (lrepSeedProducerG7 phi) (sfLReplacementAmbientBody phi) $ =
 '(ax_mp (ax_mp nsLocal_hyp (mpbir sfContextWf_cons (ian (ax_mp sfWf_all (mpbir sfWf_iff (ian sfWf_mem (ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and sfWf_mem) sfRename_wf))))) sfContextShift_wf))) sfContext_member_head);

theorem lrepSeedProducerP12(phi:nat)(hf:$ sfWf phi $):
 $ nsLocal (lrepSeedProducerG7 phi) (sfLReplacementSeedRange (sfLReplacementSeedMatrix phi) sfLReplacementSeedMetadata) $ =
 '(sfLReplacement_seed_from_L_bound hf (lrepSeedProducerP11 hf) (lrepSeedProducerP10 hf));

theorem lrepSeedProducerP13(phi:nat)(hf:$ sfWf phi $):
 $ nsLocal (lrepSeedProducerG7 phi) (sfSubst 0 0 (lrepSeedProducerF8 phi)) $ =
 '(mpbir (nsLocal_formula_eq (ax_mp sfSubst_shift_up_identity (ax_mp sfWf_ex (ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and sfLReplacement_seed_metadata_wf) (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfDomainAt_wf) (ax_mp (ax_mp sfWf_imp (ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and sfDomainAt_wf) (ax_mp (ax_mp sfWf_and sfWf_mem) sfShift_wf)))) sfWf_mem)))))))) (lrepSeedProducerP12 hf));

theorem lrepSeedProducerP14(phi:nat)(hf:$ sfWf phi $):
 $ nsLocal (lrepSeedProducerG7 phi) (lrepSeedProducerF9 phi) $ =
 '(ax_mp (ax_mp nsLocal_ExI sfShift_wf) (lrepSeedProducerP13 hf));

theorem lrepSeedProducerP15(phi:nat)(hf:$ sfWf phi $):
 $ nsLocal (lrepSeedProducerG7 phi) (lrepSeedProducerF11 phi) $ =
 '(mpbir (nsLocal_formula_eq sfShift_sfEx) (lrepSeedProducerP14 hf));

theorem lrepSeedProducerP16(phi:nat)(hf:$ sfWf phi $):
 $ sfWf (lrepSeedProducerF10 phi) $ =
 '(ax_mp sfWf_ex (ax_mp sfWf_ex (ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and sfLReplacement_seed_metadata_wf) (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfDomainAt_wf) (ax_mp (ax_mp sfWf_imp (ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and sfDomainAt_wf) (ax_mp (ax_mp sfWf_and sfWf_mem) sfShift_wf)))) sfWf_mem)))))));

theorem lrepSeedProducerP17(phi:nat)(hf:$ sfWf phi $):
 $ nsLocal (lrepSeedProducerG4 phi) (lrepSeedProducerF10 phi) $ =
 '(ax_mp (ax_mp (sfLocal_exE (lrepSeedProducerP16 hf)) (lrepSeedProducerP4 hf)) (lrepSeedProducerP15 hf));

theorem lrepSeedProducerP18(phi:nat)(hf:$ sfWf phi $):
 $ nsLocal (lrepSeedProducerG3 phi) (lrepSeedProducerF12 phi) $ =
 '(ax_mp (ax_mp sfSepLocal_allI (mpbir sfContextWf_cons (ian (lrepSeedProducerP2 hf) (mpbir sfContextWf_cons (ian (ax_mp sfBound_wf sfLPowerLevelBound_bound) sfContextWf_nil))))) (lrepSeedProducerP17 hf));

theorem lrepSeedProducerP19(phi:nat)(hf:$ sfWf phi $):
 $ nsLocal (lrepSeedProducerG2 phi) (lrepSeedProducerF13 phi) $ =
 '(ax_mp nsLocal_II (lrepSeedProducerP18 hf));

theorem lrepSeedProducerP20(phi:nat)(hf:$ sfWf phi $):
 $ nsLocal 0 (lrepSeedProducerF14 phi) $ =
 '(ax_mp nsLocal_II (lrepSeedProducerP19 hf));

theorem lrepSeedProducerP21(phi:nat)(hf:$ sfWf phi $):
 $ sfWf (lrepSeedProducerF12 phi) $ =
 '(ax_mp sfWf_all (lrepSeedProducerP16 hf));

theorem lrepSeedProducerP22(phi:nat)(hf:$ sfWf phi $):
 $ sfWf (lrepSeedProducerF13 phi) $ =
 '(ax_mp (ax_mp sfWf_imp (lrepSeedProducerP2 hf)) (lrepSeedProducerP21 hf));

theorem lrepSeedProducerP23(phi:nat)(hf:$ sfWf phi $):
 $ sfWf (lrepSeedProducerF15 phi) $ =
 '(ax_mp (ax_mp sfWf_imp (ax_mp sfRelativize_wf sfLDomain_wf)) (lrepSeedProducerP2 hf));

theorem lrepSeedProducerP24(phi:nat)(hf:$ sfWf phi $):
 $ nsLocal (lrepSeedProducerG18 phi) (lrepSeedProducerF13 phi) $ =
 '(ax_mp (ax_mp nsLocal_hyp (mpbir sfContextWf_cons (ian (ax_mp sfRelativize_wf sfLDomain_wf) (mpbir sfContextWf_cons (ian (lrepSeedProducerP22 hf) (mpbir sfContextWf_cons (ian (lrepSeedProducerP23 hf) sfContextWf_nil))))))) (ax_mp sfContext_member_tail sfContext_member_head));

theorem lrepSeedProducerP25(phi:nat)(hf:$ sfWf phi $):
 $ nsLocal (lrepSeedProducerG18 phi) (lrepSeedProducerF15 phi) $ =
 '(ax_mp (ax_mp nsLocal_hyp (mpbir sfContextWf_cons (ian (ax_mp sfRelativize_wf sfLDomain_wf) (mpbir sfContextWf_cons (ian (lrepSeedProducerP22 hf) (mpbir sfContextWf_cons (ian (lrepSeedProducerP23 hf) sfContextWf_nil))))))) (ax_mp sfContext_member_tail (ax_mp sfContext_member_tail sfContext_member_head)));

theorem lrepSeedProducerP26(phi:nat)(hf:$ sfWf phi $):
 $ nsLocal (lrepSeedProducerG18 phi) (sfLReplacementFunctional phi) $ =
 '(ax_mp (ax_mp nsLocal_hyp (mpbir sfContextWf_cons (ian (ax_mp sfRelativize_wf sfLDomain_wf) (mpbir sfContextWf_cons (ian (lrepSeedProducerP22 hf) (mpbir sfContextWf_cons (ian (lrepSeedProducerP23 hf) sfContextWf_nil))))))) sfContext_member_head);

theorem lrepSeedProducerP27(phi:nat)(hf:$ sfWf phi $):
 $ nsLocal (lrepSeedProducerG18 phi) (lrepSeedProducerF1 phi) $ =
 '(ax_mp (ax_mp nsLocal_mp (lrepSeedProducerP25 hf)) (lrepSeedProducerP26 hf));

theorem lrepSeedProducerP28(phi:nat)(hf:$ sfWf phi $):
 $ nsLocal (lrepSeedProducerG18 phi) (lrepSeedProducerF12 phi) $ =
 '(ax_mp (ax_mp nsLocal_mp (lrepSeedProducerP24 hf)) (lrepSeedProducerP27 hf));

theorem lrepSeedProducerP29(phi:nat)(hf:$ sfWf phi $):
 $ nsLocal (lrepSeedProducerG17 phi) (lrepSeedProducerF19 phi) $ =
 '(ax_mp nsLocal_II (lrepSeedProducerP28 hf));

theorem lrepSeedProducerP30(phi:nat)(hf:$ sfWf phi $):
 $ nsLocal (lrepSeedProducerG16 phi) (lrepSeedProducerF20 phi) $ =
 '(ax_mp nsLocal_II (lrepSeedProducerP29 hf));

theorem lrepSeedProducerP31(phi:nat)(hf:$ sfWf phi $):
 $ nsLocal 0 (lrepSeedProducerF21 phi) $ =
 '(ax_mp nsLocal_II (lrepSeedProducerP30 hf));
pub theorem sfLReplacement_seed_after_image(phi:nat)(hf:$ sfWf phi $):
 $ nsLocal 0 (sfImp sfLPowerLevelBound (sfImp (sfAll (sfEx (sfLReplacementAmbientBody phi)))
  (sfAll (sfEx (sfLReplacementSeedRange (sfLReplacementSeedMatrix phi) sfLReplacementSeedMetadata))))) $ =
 '(lrepSeedProducerP20 hf);

pub theorem sfLReplacement_seed_producer(phi n:nat)(hb:$ sfBound (suc (suc n)) phi $)
 (hL:$ sfTheoryProvable zfrAxioms sfLPowerLevelBound $):
 $ sfTheoryProvable zfrAxioms (sfImp (sfLReplacementFunctional phi)
  (sfAll (sfEx (sfLReplacementSeedRange (sfLReplacementSeedMatrix phi) sfLReplacementSeedMetadata)))) $ =
 '(ax_mp (ax_mp sfTheoryProvable_mp
  (ax_mp (ax_mp sfTheoryProvable_mp (ax_mp sfTheory_pure (lrepSeedProducerP31 (ax_mp sfBound_wf hb))))
   (sfLReplacement_ambient_image hb)))
  (ax_mp (ax_mp sfTheoryProvable_mp
   (ax_mp sfTheory_pure (sfLReplacement_seed_after_image (ax_mp sfBound_wf hb)))) hL));
