import "pa_numeral_formula_subst_scalar.mm0";

import "zfc_proof_arithmetic_bounded_history_nodes.mm0";

import "pa_numeral_term_subst_bounded.mm0";

theorem paNumeralFormulaSubstBoundedKey_scalar (d c K: nat): $ zfcProofArithmeticBoundedKeyUpper d c K <-> paNumeralFormulaSubstScalarKeyBound d c K $;

theorem paNumeralFormulaSubstBoundedCell_scalar (m v d c t: nat): $ zfcProofArithmeticBoundedCell m v d c t <-> paNumeralFormulaSubstScalarKeyCell m v d c t $;

theorem paNumeralFormulaSubstBoundedNode_scalar (d j a b K: nat): $ zfcProofArithmeticBoundedNodeUpper d j a b K <-> paNumeralFormulaSubstScalarNodeBound d j a b K $;

theorem paNumeralFormulaSubstBoundedNodeCell_scalar (m v d j a b k u w: nat): $ zfcProofArithmeticBoundedNodeNodeCell m v d j a b k u w <-> paNumeralFormulaSubstScalarNodeCell m v d j a b k u w $;

def paNumeralFormulaSubstBoundedEqualCell (n m v d a b .u .w: nat): wff = $ E. u E. w ((u < v /\ w < v) /\ (paNumeralTermSubstBoundedGraph d n a u /\ paNumeralTermSubstBoundedGraph d n b w /\ zfcProofArithmeticBoundedNodeNodeCell m v d 1 a b 1 u w)) $;

theorem paNumeralFormulaSubstBoundedEqualCell_scalar (n m v d a b: nat) {u w: nat}: $ paNumeralFormulaSubstBoundedEqualCell n m v d a b <-> paNumeralFormulaSubstScalarEqualCell n m v d a b $;

def paNumeralFormulaSubstBoundedLocalZero (m v K .d: nat): wff = $ A. d ((d <= K) -> (zfcProofArithmeticBoundedKeyUpper d 0 K) -> zfcProofArithmeticBoundedCell m v d 0 0) $;

theorem paNumeralFormulaSubstBoundedLocalZero_scalar (m v K: nat): $ paNumeralFormulaSubstBoundedLocalZero m v K <-> paNumeralFormulaSubstScalarLocalZero m v K $;

def paNumeralFormulaSubstBoundedLocalEqual (n m v K .d .a .b: nat): wff = $ A. d A. a A. b ((d <= K /\ a <= K /\ b <= K) -> (zfcProofArithmeticBoundedNodeUpper d 1 a b K) -> paNumeralFormulaSubstBoundedEqualCell n m v d a b) $;

theorem paNumeralFormulaSubstBoundedLocalEqual_scalar (n m v K: nat): $ paNumeralFormulaSubstBoundedLocalEqual n m v K <-> paNumeralFormulaSubstScalarLocalEqual n m v K $;

def paNumeralFormulaSubstBoundedLocalAnd (m v K .d .a .b .u .w: nat): wff = $ A. d A. a A. b A. u A. w ((d <= K /\ a <= K /\ b <= K /\ u < v /\ w < v) -> (zfcProofArithmeticBoundedNodeUpper d 3 a b K /\ zfcProofArithmeticBoundedCell m v d a u /\ zfcProofArithmeticBoundedCell m v d b w) -> zfcProofArithmeticBoundedNodeNodeCell m v d 3 a b 3 u w) $;

theorem paNumeralFormulaSubstBoundedLocalAnd_scalar (m v K: nat): $ paNumeralFormulaSubstBoundedLocalAnd m v K <-> paNumeralFormulaSubstScalarLocalAnd m v K $;

def paNumeralFormulaSubstBoundedLocalOr (m v K .d .a .b .u .w: nat): wff = $ A. d A. a A. b A. u A. w ((d <= K /\ a <= K /\ b <= K /\ u < v /\ w < v) -> (zfcProofArithmeticBoundedNodeUpper d 4 a b K /\ zfcProofArithmeticBoundedCell m v d a u /\ zfcProofArithmeticBoundedCell m v d b w) -> zfcProofArithmeticBoundedNodeNodeCell m v d 4 a b 4 u w) $;

theorem paNumeralFormulaSubstBoundedLocalOr_scalar (m v K: nat): $ paNumeralFormulaSubstBoundedLocalOr m v K <-> paNumeralFormulaSubstScalarLocalOr m v K $;

def paNumeralFormulaSubstBoundedLocalImp (m v K .d .a .b .u .w: nat): wff = $ A. d A. a A. b A. u A. w ((d <= K /\ a <= K /\ b <= K /\ u < v /\ w < v) -> (zfcProofArithmeticBoundedNodeUpper d 5 a b K /\ zfcProofArithmeticBoundedCell m v d a u /\ zfcProofArithmeticBoundedCell m v d b w) -> zfcProofArithmeticBoundedNodeNodeCell m v d 5 a b 5 u w) $;

theorem paNumeralFormulaSubstBoundedLocalImp_scalar (m v K: nat): $ paNumeralFormulaSubstBoundedLocalImp m v K <-> paNumeralFormulaSubstScalarLocalImp m v K $;

def paNumeralFormulaSubstBoundedLocalAll (m v K .d .a .u: nat): wff = $ A. d A. a A. u ((d <= K /\ a <= K /\ u < v) -> (zfcProofArithmeticBoundedNodeUpper d 6 a 0 K /\ zfcProofArithmeticBoundedCell m v (suc d) a u) -> zfcProofArithmeticBoundedNodeNodeCell m v d 6 a 0 6 u 0) $;

theorem paNumeralFormulaSubstBoundedLocalAll_scalar (m v K: nat): $ paNumeralFormulaSubstBoundedLocalAll m v K <-> paNumeralFormulaSubstScalarLocalAll m v K $;

def paNumeralFormulaSubstBoundedLocalEx (m v K .d .a .u: nat): wff = $ A. d A. a A. u ((d <= K /\ a <= K /\ u < v) -> (zfcProofArithmeticBoundedNodeUpper d 7 a 0 K /\ zfcProofArithmeticBoundedCell m v (suc d) a u) -> zfcProofArithmeticBoundedNodeNodeCell m v d 7 a 0 7 u 0) $;

theorem paNumeralFormulaSubstBoundedLocalEx_scalar (m v K: nat): $ paNumeralFormulaSubstBoundedLocalEx m v K <-> paNumeralFormulaSubstScalarLocalEx m v K $;

def paNumeralFormulaSubstBoundedLocal (n m v K: nat): wff = $ paNumeralFormulaSubstBoundedLocalZero m v K /\ paNumeralFormulaSubstBoundedLocalEqual n m v K /\ paNumeralFormulaSubstBoundedLocalAnd m v K /\ paNumeralFormulaSubstBoundedLocalOr m v K /\ paNumeralFormulaSubstBoundedLocalImp m v K /\ paNumeralFormulaSubstBoundedLocalAll m v K /\ paNumeralFormulaSubstBoundedLocalEx m v K $;

theorem paNumeralFormulaSubstBoundedLocal_scalar (n m v K: nat): $ paNumeralFormulaSubstBoundedLocal n m v K <-> paNumeralFormulaSubstScalarLocal n m v K $;

def paNumeralFormulaSubstBoundedFinal (m v d c t .y: nat): wff = $ A. y (y < v -> zfcProofArithmeticBoundedCell m v d c y -> y = t) $;

theorem paNumeralFormulaSubstBoundedFinal_scalar (m v d c t: nat) {y: nat}: $ paNumeralFormulaSubstBoundedFinal m v d c t <-> A. y (paNumeralFormulaSubstScalarKeyCell m v d c y -> y = t) $;

def paNumeralFormulaSubstBoundedCertificate (n m v K d c t: nat): wff = $ paNumeralFormulaSubstBoundedLocal n m v K /\ paNumeralFormulaSubstBoundedFinal m v d c t $;

theorem paNumeralFormulaSubstBoundedCertificate_scalar (n m v K d c t: nat): $ paNumeralFormulaSubstBoundedCertificate n m v K d c t <-> paNumeralFormulaSubstScalarCertificate n m v K d c t $;

def paNumeralFormulaSubstBoundedPairCertificate (n m v d c t .K: nat): wff = $ E. K (bb215ArithmeticFormulaPairGraph d c K /\ paNumeralFormulaSubstBoundedCertificate n m v K d c t) $;

theorem paNumeralFormulaSubstBoundedPairCertificate_scalar (n m v d c t: nat) {K: nat}: $ paNumeralFormulaSubstBoundedPairCertificate n m v d c t <-> paNumeralFormulaSubstScalarPairCertificate n m v d c t $;

def paNumeralFormulaSubstBoundedGraph (d n c t .m .v: nat): wff = $ E. m E. v paNumeralFormulaSubstBoundedPairCertificate n m v d c t $;

theorem paNumeralFormulaSubstBoundedGraph_scalar (d n c t: nat) {m v: nat}: $ paNumeralFormulaSubstBoundedGraph d n c t <-> paNumeralFormulaSubstScalarGraph d n c t $;

theorem paNumeralFormulaSubstBoundedGraph_correct (d n c t m: nat): $ paFormulaBound m c -> (paNumeralFormulaSubstBoundedGraph d n c t <-> t = paFormulaSubst d (paTermNumeral n) c) $;

theorem paNumeralFormulaSubstBoundedGraph_total (d n c: nat): $ paNumeralFormulaSubstBoundedGraph d n c (paFormulaSubst d (paTermNumeral n) c) $;
