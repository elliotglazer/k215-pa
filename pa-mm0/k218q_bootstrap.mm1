import "k218q_source_theory.mm1";
import "k218q_source_empty.mm1";
import "k218q_seed_request.mm1";
import "k230_bootstrap_discharge.mm1";
import "source_core_theory.mm1";

@_ def k218QDomainSeedCode: nat = $ k218QSeedCode (kEq 3 1) $;

theorem k218QB_code_gt3: $ 3 < k218QDomainSeedCode $ =
'k218QSeedCode_gt3;

theorem k218QB_code_ne3: $ k218QDomainSeedCode != 3 $ =
'(ltneri k218QB_code_gt3);

theorem k218QB_code_ne1: $ k218QDomainSeedCode != 1 $ =
'(ltneri (lttr (mpbi ltsuc lt01S) k218QB_code_gt3));

theorem k218QB_code_ne0: $ k218QDomainSeedCode != 0 $ =
'(ltneri (lttr lt01S k218QB_code_gt3));

theorem k218QB_three_ne_code: $ 3 != k218QDomainSeedCode $ =
'(ltne k218QB_code_gt3);

theorem k218QB_three_ne1: $ 3 != 1 $ =
'(ltneri (mpbi ltsuc lt01S));

theorem k218QB_pair_hyp: $ k218IHypProvable ((kAnd (kEq 3 1) (kMem 3 k218QDomainSeedCode)) : 0) (kAnd (kEq 3 1) (kMem 3 k218QDomainSeedCode)) $ =
'(k218IHypProvable_assumption lmemconsid);

theorem k218QB_pair_left_rule: $ k218IHypProvable ((kAnd (kEq 3 1) (kMem 3 k218QDomainSeedCode)) : 0) (kImp (kAnd (kEq 3 1) (kMem 3 k218QDomainSeedCode)) (kEq 3 1)) $ =
'(ax_mp k218IHypProvable_seed k218IPropAndLeft);

theorem k218QB_pair_relation: $ k218IHypProvable ((kAnd (kEq 3 1) (kMem 3 k218QDomainSeedCode)) : 0) (kEq 3 1) $ =
'(ax_mp (ax_mp k218IHypProvable_mp k218QB_pair_hyp) k218QB_pair_left_rule);

theorem k218QB_pair_right_rule: $ k218IHypProvable ((kAnd (kEq 3 1) (kMem 3 k218QDomainSeedCode)) : 0) (kImp (kAnd (kEq 3 1) (kMem 3 k218QDomainSeedCode)) (kMem 3 k218QDomainSeedCode)) $ =
'(ax_mp k218IHypProvable_seed k218IPropAndRight);

theorem k218QB_pair_membership: $ k218IHypProvable ((kAnd (kEq 3 1) (kMem 3 k218QDomainSeedCode)) : 0) (kMem 3 k218QDomainSeedCode) $ =
'(ax_mp (ax_mp k218IHypProvable_mp k218QB_pair_hyp) k218QB_pair_right_rule);

theorem k218QB_member_transport: $ k218IHypProvable ((kAnd (kEq 3 1) (kMem 3 k218QDomainSeedCode)) : 0) (kImp (kEq 3 1) (kImp (kMem 3 k218QDomainSeedCode) (kMem 1 k218QDomainSeedCode))) $ =
'(ax_mp k218IHypProvable_seed k218IEquality_member_left);

theorem k218QB_member_rule: $ k218IHypProvable ((kAnd (kEq 3 1) (kMem 3 k218QDomainSeedCode)) : 0) (kImp (kMem 3 k218QDomainSeedCode) (kMem 1 k218QDomainSeedCode)) $ =
'(ax_mp (ax_mp k218IHypProvable_mp k218QB_pair_relation) k218QB_member_transport);

theorem k218QB_member_result: $ k218IHypProvable ((kAnd (kEq 3 1) (kMem 3 k218QDomainSeedCode)) : 0) (kMem 1 k218QDomainSeedCode) $ =
'(ax_mp (ax_mp k218IHypProvable_mp k218QB_pair_membership) k218QB_member_rule);

theorem k218QB_pair_member: $ k218QProvable (kImp (kAnd (kEq 3 1) (kMem 3 k218QDomainSeedCode)) (kMem 1 k218QDomainSeedCode)) $ =
'(ax_mp k218IHypProvable_empty (ax_mp k218IHypProvable_deduction k218QB_member_result));

theorem k218QB_seed_hyp: $ k218IHypProvable ((kAnd (k218Closure 1 3 k218QDomainSeedCode (kEq 3 1)) (k218QRootRequest 3 k218QDomainSeedCode (kEq 3 1))) : 0) (kAnd (k218Closure 1 3 k218QDomainSeedCode (kEq 3 1)) (k218QRootRequest 3 k218QDomainSeedCode (kEq 3 1))) $ =
'(k218IHypProvable_assumption lmemconsid);

theorem k218QB_seed_right_rule: $ k218IHypProvable ((kAnd (k218Closure 1 3 k218QDomainSeedCode (kEq 3 1)) (k218QRootRequest 3 k218QDomainSeedCode (kEq 3 1))) : 0) (kImp (kAnd (k218Closure 1 3 k218QDomainSeedCode (kEq 3 1)) (k218QRootRequest 3 k218QDomainSeedCode (kEq 3 1))) (k218QRootRequest 3 k218QDomainSeedCode (kEq 3 1))) $ =
'(ax_mp k218IHypProvable_seed k218IPropAndRight);

theorem k218QB_request: $ k218IHypProvable ((kAnd (k218Closure 1 3 k218QDomainSeedCode (kEq 3 1)) (k218QRootRequest 3 k218QDomainSeedCode (kEq 3 1))) : 0) (k218QRootRequest 3 k218QDomainSeedCode (kEq 3 1)) $ =
'(ax_mp (ax_mp k218IHypProvable_mp k218QB_seed_hyp) k218QB_seed_right_rule);

theorem k218QB_relation_exists: $ k218QProvable (kExists 3 (kEq 3 1)) $ =
'(k218QProvable_axiom k218QAxioms_rho1);

theorem k218QB_relation_in_context: $ k218IHypProvable ((kAnd (k218Closure 1 3 k218QDomainSeedCode (kEq 3 1)) (k218QRootRequest 3 k218QDomainSeedCode (kEq 3 1))) : 0) (kExists 3 (kEq 3 1)) $ =
'(ax_mp k218IHypProvable_seed k218QB_relation_exists);

theorem k218QB_selected_witness: $ k218IHypProvable ((kAnd (k218Closure 1 3 k218QDomainSeedCode (kEq 3 1)) (k218QRootRequest 3 k218QDomainSeedCode (kEq 3 1))) : 0) (kExists 3 (kAnd (kEq 3 1) (kMem 3 k218QDomainSeedCode))) $ =
'(ax_mp (ax_mp k218IHypProvable_mp k218QB_relation_in_context) k218QB_request);

theorem k218QB_exists_member_map: $ k218QProvable (kImp (kExists 3 (kAnd (kEq 3 1) (kMem 3 k218QDomainSeedCode))) (kExists 3 (kMem 1 k218QDomainSeedCode))) $ =
'(k218IExists_mono k218QB_pair_member);

theorem k218QB_map_in_context: $ k218IHypProvable ((kAnd (k218Closure 1 3 k218QDomainSeedCode (kEq 3 1)) (k218QRootRequest 3 k218QDomainSeedCode (kEq 3 1))) : 0) (kImp (kExists 3 (kAnd (kEq 3 1) (kMem 3 k218QDomainSeedCode))) (kExists 3 (kMem 1 k218QDomainSeedCode))) $ =
'(ax_mp k218IHypProvable_seed k218QB_exists_member_map);

theorem k218QB_exists_member: $ k218IHypProvable ((kAnd (k218Closure 1 3 k218QDomainSeedCode (kEq 3 1)) (k218QRootRequest 3 k218QDomainSeedCode (kEq 3 1))) : 0) (kExists 3 (kMem 1 k218QDomainSeedCode)) $ =
'(ax_mp (ax_mp k218IHypProvable_mp k218QB_selected_witness) k218QB_map_in_context);

theorem k218QB_member_fresh_three: $ kFresh (kMem 1 k218QDomainSeedCode) 3 $ =
'(kFresh_mem_intro k218QB_three_ne1 k218QB_three_ne_code);

theorem k218QB_collapse_member: $ k218QProvable (kImp (kExists 3 (kMem 1 k218QDomainSeedCode)) (kMem 1 k218QDomainSeedCode)) $ =
'(k218IExists_collapse (ax_mp k218QFresh_vacuity k218QB_member_fresh_three));

theorem k218QB_collapse_in_context: $ k218IHypProvable ((kAnd (k218Closure 1 3 k218QDomainSeedCode (kEq 3 1)) (k218QRootRequest 3 k218QDomainSeedCode (kEq 3 1))) : 0) (kImp (kExists 3 (kMem 1 k218QDomainSeedCode)) (kMem 1 k218QDomainSeedCode)) $ =
'(ax_mp k218IHypProvable_seed k218QB_collapse_member);

theorem k218QB_member: $ k218IHypProvable ((kAnd (k218Closure 1 3 k218QDomainSeedCode (kEq 3 1)) (k218QRootRequest 3 k218QDomainSeedCode (kEq 3 1))) : 0) (kMem 1 k218QDomainSeedCode) $ =
'(ax_mp (ax_mp k218IHypProvable_mp k218QB_exists_member) k218QB_collapse_in_context);

theorem k218QB_member_substitution: $ kSubst (kMem 1 3) 3 k218QDomainSeedCode = (kMem 1 k218QDomainSeedCode) $ =
'(eqtr kSubst_kMem (kMemeq (ax_mp kReplace_miss (ltne (mpbi ltsuc lt01S))) kReplace_hit));

theorem k218QB_domain_intro: $ k218QProvable (kImp (kMem 1 k218QDomainSeedCode) (kExists 3 (kMem 1 3))) $ =
'(mpbi (k218QProvableeq (kImpeq1 k218QB_member_substitution)) (ax_mp (ax_mp (ax_mp k218INamed_exists_intro k218QB_three_ne_code) kBinderAbsent_kMem) kBinderAbsent_kMem));

theorem k218QB_intro_in_context: $ k218IHypProvable ((kAnd (k218Closure 1 3 k218QDomainSeedCode (kEq 3 1)) (k218QRootRequest 3 k218QDomainSeedCode (kEq 3 1))) : 0) (kImp (kMem 1 k218QDomainSeedCode) (kExists 3 (kMem 1 3))) $ =
'(ax_mp k218IHypProvable_seed k218QB_domain_intro);

theorem k218QB_domain_in_context: $ k218IHypProvable ((kAnd (k218Closure 1 3 k218QDomainSeedCode (kEq 3 1)) (k218QRootRequest 3 k218QDomainSeedCode (kEq 3 1))) : 0) (kExists 3 (kMem 1 3)) $ =
'(ax_mp (ax_mp k218IHypProvable_mp k218QB_member) k218QB_intro_in_context);

theorem k218QB_seed_body_domain: $ k218QProvable (kImp (kAnd (k218Closure 1 3 k218QDomainSeedCode (kEq 3 1)) (k218QRootRequest 3 k218QDomainSeedCode (kEq 3 1))) (kExists 3 (kMem 1 3))) $ =
'(ax_mp k218IHypProvable_empty (ax_mp k218IHypProvable_deduction k218QB_domain_in_context));

theorem k218QB_actual_seed: $ k218QProvable (kExists k218QDomainSeedCode (kAnd (k218Closure 1 3 k218QDomainSeedCode (kEq 3 1)) (k218QRootRequest 3 k218QDomainSeedCode (kEq 3 1)))) $ =
'(k218QRootSeed_instance kBinderAbsent_kEq);

theorem k218QB_target_fresh_code: $ kFresh (kExists 3 (kMem 1 3)) k218QDomainSeedCode $ =
'(ax_mp (ax_mp (ax_mp kFresh_exists_intro k218QB_code_ne0) k218QB_code_ne3) (kFresh_mem_intro k218QB_code_ne1 k218QB_code_ne3));

pub theorem k218QBootstrap_domain_member: $ k218QProvable (kExists 3 (kMem 1 3)) $ =
'(ax_mp k218IHypProvable_empty (ax_mp (ax_mp (k218IHypProvable_exists_elim k218IContextVacuous_nil (ax_mp k218QFresh_vacuity k218QB_target_fresh_code)) (ax_mp k218IHypProvable_seed k218QB_actual_seed)) (ax_mp k218IHypProvable_seed k218QB_seed_body_domain)));

theorem k218QB_empty_at_one: $ k218QProvable (sfNamedTemplate (sqNumericEnvironment 0) 1 0 zfcEmpty) $ =
'(ax_mp (ax_mp (ax_mp (ax_mp k218QClosedQuotation_transport (ax_mp zfcCoreAxioms_formula_closed zfcCoreEmpty_member)) (lttr lt01S k218QSeedCode_gt3)) lt01S) {k218QSourceEmpty : $ k218QProvable (sfNamedTemplate (sqNumericEnvironment 0) (k218QSeedCode kF) 0 zfcEmpty) $});

pub theorem k218QBootstrap_empty: $ k218QProvable kEmptyObject $ =
'(mpbi (k218QProvableeq {k218QEmpty_source_syntax : $ sfNamedTemplate (sqNumericEnvironment 0) 1 0 zfcEmpty = kEmptyObject $}) k218QB_empty_at_one);

theorem k218QB_false_fresh_three: $ kFresh kF 3 $ =
'(mpbir kFresh_kF (ltneri lt01S));

theorem k218QB_false_fresh_one: $ kFresh kF 1 $ =
'(mpbir kFresh_kF peano1);

pub theorem k218QBootstrap_domain_discharge: $ k218IHypProvable kQuotientContext kF -> k218IHypProvable (kEmptyMarker : 0) kF $ =
'(syl (ax_mp (k218IHypProvable_exists_elim (ax_mp k218IContextFresh_vacuous kEmptyMarker_context_fresh_three) (ax_mp k218QFresh_vacuity k218QB_false_fresh_three)) (ax_mp k218IHypProvable_seed k218QBootstrap_domain_member)) k218IHypProvable_deduction);

pub theorem k218QBootstrap_marker_discharge: $ k218IHypProvable (kEmptyMarker : 0) kF -> k218QProvable kF $ =
'(syl k218IHypProvable_empty @ syl (ax_mp (k218IHypProvable_exists_elim k218IContextVacuous_nil (ax_mp k218QFresh_vacuity k218QB_false_fresh_one)) (ax_mp k218IHypProvable_seed k218QBootstrap_empty)) k218IHypProvable_deduction);

pub theorem k218QBootstrap_refutation: $ k218IHypProvable kQuotientContext kF -> k218QProvable kF $ =
'(syl k218QBootstrap_marker_discharge k218QBootstrap_domain_discharge);
