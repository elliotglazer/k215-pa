import "source_l_clstage_atom_case.mm1";
import "source_l_clstage_definability.mm1";

-- Lane L02: the core Definability Lemma and the DefPower literal with rep_ex discharged.
pub theorem sfLCoreDefinabilityLaw_zfr(m psi:nat)(hb:$ sfBound (suc m) psi $):
 $ sfTheoryProvable zfrAxioms (sfLCoreDefinabilityLaw m psi) $ =
 '(sfLCoreDefinabilityLaw_from_rep hb (sfLRepLaw_zfr hb));

pub theorem sfLDefPowerLiteral_zfr: $ sfTheoryProvable zfrAxioms sfLDefPowerLiteral $ =
 '(sfLDefPowerLiteral_from_rep (sfLRepLaw_zfr sfLPowerSubsetFormula_bound));
