import "source_reflection_least_cond_relation.mm1";

@_ def rlcOrdF0: nat = $ sfMem 0 1 $;

@_ def rlcOrdF1: nat = $ sfMem 0 2 $;

@_ def rlcOrdF2: nat = $ sfMem 0 3 $;

@_ def rlcOrdF3: nat = $ sfImp rlcOrdF0 rlcOrdF1 $;

@_ def rlcOrdF4: nat = $ sfImp rlcOrdF0 rlcOrdF2 $;

@_ def rlcOrdF5: nat = $ sfAll rlcOrdF3 $;

@_ def rlcOrdF6: nat = $ sfAll rlcOrdF4 $;

@_ def rlcOrdF7: nat = $ sfImp rlcOrdF0 rlcOrdF5 $;

@_ def rlcOrdF8: nat = $ sfImp rlcOrdF1 rlcOrdF6 $;

@_ def rlcOrdF9: nat = $ sfAll rlcOrdF7 $;

@_ def rlcOrdF10: nat = $ sfAll rlcOrdF8 $;

@_ def rlcOrdF11: nat = $ sfImp rlcOrdF0 rlcOrdF9 $;

@_ def rlcOrdF12: nat = $ sfImp rlcOrdF1 rlcOrdF9 $;

@_ def rlcOrdF13: nat = $ sfAll rlcOrdF11 $;

@_ def rlcOrdF14: nat = $ sfAll rlcOrdF12 $;

@_ def rlcOrdF15: nat = $ sfAnd rlcOrdF9 rlcOrdF13 $;

@_ def rlcOrdF16: nat = $ sfAnd rlcOrdF10 rlcOrdF14 $;

theorem rlcOrdInst0: $ sfSubst 1 1 rlcOrdF0 = rlcOrdF1 $ = '(eqtr sfSubst_sfMem (nsMem_eq (ax_mp sfSubstIndex_bound lt01S) (eqtr sfSubstIndex_lift (suceq sfSubstIndex_zero))));

theorem rlcOrdInst1: $ sfSubst 2 1 rlcOrdF0 = rlcOrdF0 $ = '(eqtr sfSubst_sfMem (nsMem_eq (ax_mp sfSubstIndex_bound lt01S) (eqtr sfSubstIndex_lift (suceq (ax_mp sfSubstIndex_bound lt01S)))));

theorem rlcOrdInst2: $ sfSubst 2 1 rlcOrdF1 = rlcOrdF2 $ = '(eqtr sfSubst_sfMem (nsMem_eq (ax_mp sfSubstIndex_bound lt01S) (eqtr sfSubstIndex_lift (suceq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_zero))))));

theorem rlcOrdInst3: $ sfSubst 2 1 rlcOrdF3 = rlcOrdF4 $ = '(eqtr sfSubst_sfImp (nsImp_eq rlcOrdInst1 rlcOrdInst2));

theorem rlcOrdInst4: $ sfSubst 1 1 rlcOrdF5 = rlcOrdF6 $ = '(eqtr sfSubst_sfAll (nsAll_eq rlcOrdInst3));

theorem rlcOrdInst5: $ sfSubst 1 1 rlcOrdF7 = rlcOrdF8 $ = '(eqtr sfSubst_sfImp (nsImp_eq rlcOrdInst0 rlcOrdInst4));

theorem rlcOrdInst6: $ sfSubst 0 1 rlcOrdF9 = rlcOrdF10 $ = '(eqtr sfSubst_sfAll (nsAll_eq rlcOrdInst5));

theorem rlcOrdInst7: $ sfSubst 3 1 rlcOrdF0 = rlcOrdF0 $ = '(eqtr sfSubst_sfMem (nsMem_eq (ax_mp sfSubstIndex_bound lt01S) (eqtr sfSubstIndex_lift (suceq (ax_mp sfSubstIndex_bound lt01S)))));

theorem rlcOrdInst8: $ sfSubst 3 1 rlcOrdF1 = rlcOrdF1 $ = '(eqtr sfSubst_sfMem (nsMem_eq (ax_mp sfSubstIndex_bound lt01S) (eqtr sfSubstIndex_lift (suceq (eqtr sfSubstIndex_lift (suceq (ax_mp sfSubstIndex_bound lt01S)))))));

theorem rlcOrdInst9: $ sfSubst 3 1 rlcOrdF3 = rlcOrdF3 $ = '(eqtr sfSubst_sfImp (nsImp_eq rlcOrdInst7 rlcOrdInst8));

theorem rlcOrdInst10: $ sfSubst 2 1 rlcOrdF5 = rlcOrdF5 $ = '(eqtr sfSubst_sfAll (nsAll_eq rlcOrdInst9));

theorem rlcOrdInst11: $ sfSubst 2 1 rlcOrdF7 = rlcOrdF7 $ = '(eqtr sfSubst_sfImp (nsImp_eq rlcOrdInst1 rlcOrdInst10));

theorem rlcOrdInst12: $ sfSubst 1 1 rlcOrdF9 = rlcOrdF9 $ = '(eqtr sfSubst_sfAll (nsAll_eq rlcOrdInst11));

theorem rlcOrdInst13: $ sfSubst 1 1 rlcOrdF11 = rlcOrdF12 $ = '(eqtr sfSubst_sfImp (nsImp_eq rlcOrdInst0 rlcOrdInst12));

theorem rlcOrdInst14: $ sfSubst 0 1 rlcOrdF13 = rlcOrdF14 $ = '(eqtr sfSubst_sfAll (nsAll_eq rlcOrdInst13));

theorem rlcOrdInst15: $ sfSubst 0 1 rlcOrdF15 = rlcOrdF16 $ = '(eqtr sfSubst_sfAnd (nsAnd_eq rlcOrdInst6 rlcOrdInst14));

theorem rlcOrdBound16: $ sfBound 3 rlcOrdF1 $ = '(mpbir sfBound_sfMem (ian lt01S (mpbi ltsuc (mpbi ltsuc lt01S))));

theorem rlcOrdBound17: $ sfBound 4 rlcOrdF0 $ = '(mpbir sfBound_sfMem (ian lt01S (mpbi ltsuc lt01S)));

theorem rlcOrdBound18: $ sfBound 4 rlcOrdF2 $ = '(mpbir sfBound_sfMem (ian lt01S (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S)))));

theorem rlcOrdBound19: $ sfBound 4 rlcOrdF4 $ = '(mpbir sfBound_sfImp (ian rlcOrdBound17 rlcOrdBound18));

theorem rlcOrdBound20: $ sfBound 3 rlcOrdF6 $ = '(mpbir sfBound_sfAll rlcOrdBound19);

theorem rlcOrdBound21: $ sfBound 3 rlcOrdF8 $ = '(mpbir sfBound_sfImp (ian rlcOrdBound16 rlcOrdBound20));

theorem rlcOrdBound22: $ sfBound 2 rlcOrdF10 $ = '(mpbir sfBound_sfAll rlcOrdBound21);

theorem rlcOrdBound23: $ sfBound 5 rlcOrdF0 $ = '(mpbir sfBound_sfMem (ian lt01S (mpbi ltsuc lt01S)));

theorem rlcOrdBound24: $ sfBound 5 rlcOrdF1 $ = '(mpbir sfBound_sfMem (ian lt01S (mpbi ltsuc (mpbi ltsuc lt01S))));

theorem rlcOrdBound25: $ sfBound 5 rlcOrdF3 $ = '(mpbir sfBound_sfImp (ian rlcOrdBound23 rlcOrdBound24));

theorem rlcOrdBound26: $ sfBound 4 rlcOrdF5 $ = '(mpbir sfBound_sfAll rlcOrdBound25);

theorem rlcOrdBound27: $ sfBound 4 rlcOrdF7 $ = '(mpbir sfBound_sfImp (ian rlcOrdBound17 rlcOrdBound26));

theorem rlcOrdBound28: $ sfBound 3 rlcOrdF9 $ = '(mpbir sfBound_sfAll rlcOrdBound27);

theorem rlcOrdBound29: $ sfBound 3 rlcOrdF12 $ = '(mpbir sfBound_sfImp (ian rlcOrdBound16 rlcOrdBound28));

theorem rlcOrdBound30: $ sfBound 2 rlcOrdF14 $ = '(mpbir sfBound_sfAll rlcOrdBound29);

theorem rlcOrdBound31: $ sfBound 2 rlcOrdF16 $ = '(mpbir sfBound_sfAnd (ian rlcOrdBound22 rlcOrdBound30));

def sfReflectionCond(level P x d:nat):nat = $ sfImp (sfSubst 0 x sfLeastOrdinalPredicate) (sfAnd (sfMem x d) (sfAll (sfImp (sfORBinary level (suc x) 0) (sfORBinary P (suc d) 0)))) $;

def sfReflectionCondCandidate(level P:nat):nat = $ sfReflectionCond level P 1 0 $;

def sfReflectionCondStep(level P:nat):nat = $ sfReflectionLeastMatrix (sfReflectionCondCandidate level P) $;

def sfReflectionCondGuard(level P:nat):wff = $ sfBound 2 level /\ sfBound 2 P $;

pub theorem sfReflectionOrdinalAtOne_bound: $ sfBound 2 (sfSubst 0 1 sfLeastOrdinalPredicate) $ = '(mpbir (sfBoundeq eqid rlcOrdInst15) rlcOrdBound31);

pub theorem sfReflectionCond_wf(level P x d:nat): $ sfWf (sfReflectionCond level P x d) $ = '(ax_mp (ax_mp sfWf_imp sfSubst_wf) (ax_mp (ax_mp sfWf_and sfWf_mem) (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfORBinary_wf) sfORBinary_wf))));

pub theorem sfReflectionCondCandidate_bound_meta(level P:nat)(hl:$ sfBound 2 level $)(hp:$ sfBound 2 P $): $ sfBound 2 (sfReflectionCondCandidate level P) $ = '(mpbir sfBound_sfImp (ian sfReflectionOrdinalAtOne_bound (mpbir sfBound_sfAnd (ian (mpbir sfBound_sfMem (ian d1lt2 d0lt2)) (mpbir sfBound_sfAll (mpbir sfBound_sfImp (ian (sfORBinary_bound hl (mpbi ltsuc d1lt2) lt01S) (sfORBinary_bound hp (mpbi ltsuc d0lt2) lt01S))))))));

do { (add-eqd-thm 'sfReflectionCond 'rlcCondCong) (add-eqd-thm 'sfReflectionCondCandidate 'rlcCondCandidateCong) };

theorem rlcCondSafe_bound(G:wff)(n phi:nat)(hp:$ G -> sfBound n phi $): $ sfBound n (if G phi sfBot) $ = '(cases (mpbird (srecpeq2d (preq2d ifpos)) hp) (mpbird (srecpeq2d (preq2d ifneg)) (a1i sfBound_bot)));

theorem rlcCondCandidateSafe_bound(level P:nat): $ sfBound 2 (sfReflectionCondCandidate (if (sfReflectionCondGuard level P) level sfBot) (if (sfReflectionCondGuard level P) P sfBot)) $ = '(sfReflectionCondCandidate_bound_meta (rlcCondSafe_bound anl) (rlcCondSafe_bound anr));

pub theorem sfReflectionCondCandidate_bound(level P:nat): $ sfReflectionCondGuard level P -> sfBound 2 (sfReflectionCondCandidate level P) $ = '(mpbid (sfBoundeqd eqidd (rlcCondCandidateCongeqd ifpos ifpos)) (a1i rlcCondCandidateSafe_bound));

pub theorem sfReflectionCond_least(level P:nat): $ sfReflectionCondGuard level P -> sfTheoryProvable zfrAxioms (sfLeastOrdinalLaw (sfReflectionCondCandidate level P)) $ = '(syl sfLeastOrdinal_zfr sfReflectionCondCandidate_bound);

pub theorem sfReflectionCond_functional(level P:nat): $ sfReflectionCondGuard level P -> sfTheoryProvable zfrAxioms (sfReflectionLeastGFun (sfReflectionCondCandidate level P)) $ = '(syl sfReflectionLeast_functional sfReflectionCondCandidate_bound);

pub theorem sfReflectionCond_total_if(level P:nat): $ sfReflectionCondGuard level P -> sfTheoryProvable zfrAxioms (sfReflectionLeastTotalLaw (sfReflectionCondCandidate level P)) $ = '(syl sfReflectionLeast_total_if sfReflectionCondCandidate_bound);

pub theorem sfReflectionCondStep_bound(level P:nat): $ sfReflectionCondGuard level P -> sfBound 2 (sfReflectionCondStep level P) $ = '(syl sfReflectionLeastMatrix_bound_internal sfReflectionCondCandidate_bound);
