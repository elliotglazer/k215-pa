import "source_l_common_level_reflection_transport.mm0";

theorem sfCLMembership_shift_cutoff (k start y n: nat)
 (hk: $ k <= start $) (hy: $ y < k $):
 $ sfShift k (sfCLMembership start y n) = sfCLMembership (suc start) y n $;

theorem sfCLPoint_shift_cutoff (k start params beta y: nat)
 (hk: $ k <= start $) (hy: $ y < k $):
 $ sfShift k (sfCLPoint start params beta y) =
   sfCLPoint (suc start) params (sfShiftIndex k beta) y $;

theorem sfCLPoint_shift_cutoff_fixed (k start params beta y: nat)
 (hk: $ k <= start $) (hb: $ beta < k $) (hy: $ y < k $):
 $ sfShift k (sfCLPoint start params beta y) = sfCLPoint (suc start) params beta y $;

theorem sfCLRecipe_shift (start params: nat):
 $ sfShift 0 (sfCLRecipe start params) = sfCLRecipe (suc start) params $;

theorem sfCLReflectedPoint_shift_cutoff_fixed (k start params count phi beta y: nat)
 (hp: $ sfBound count phi $) (hk: $ k <= start $) (hb: $ beta < k $) (hy: $ y < k $):
 $ sfShift k (sfCLReflectedPoint start params count phi beta y) =
   sfCLReflectedPoint (suc start) params count phi beta y $;

theorem sfCLReflectedRecipe_shift (start params count phi: nat)
 (hp: $ sfBound count phi $):
 $ sfShift 0 (sfCLReflectedRecipe start params count phi) =
   sfCLReflectedRecipe (suc start) params count phi $;
