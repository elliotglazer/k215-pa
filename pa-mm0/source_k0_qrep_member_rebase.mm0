theorem sfK0QRep_member_rebase (G: wff) (t k l x y: nat) (hk: $ G -> 0 < k $) (hl: $ G -> 0 < l $) (htk: $ G -> t < k $) (htl: $ G -> t < l $) (hxk: $ G -> x < k $) (hxl: $ G -> x < l $) (hyk: $ G -> y < k $) (hyl: $ G -> y < l $):
 $ G -> k218IEquivalent (sqMember t x y k) (sqMember t x y l) $;
