@_ def sfCLOrdinal: nat = $ srcCLSyntaxF8 $;

@_ def sfCLHierarchy: nat = $ srcCLSyntaxF769 $;

@_ def sfCLPairMap (d y: nat) (.i: nat): set = $ \ i, if (i = 0) d y $;

@_ def sfCLOrdinalAt (d: nat): nat = $ sfRename (sfCLPairMap d d) 0 sfCLOrdinal $;

@_ def sfCLHierarchyAt (d y: nat): nat = $ sfRename (sfCLPairMap d y) 0 sfCLHierarchy $;

@_ def sfCLPoint (start count d y: nat): nat =
 $ sfAnd (sfAnd (sfCLOrdinalAt d) (sfCLHierarchyAt d y)) (sfCLMembership start y count) $;

@_ def sfCLRecipe (start count: nat): nat =
 $ sfEx (sfEx (sfCLPoint (suc (suc start)) count 1 0)) $;


pub theorem sfCLOrdinal_bound: $ sfBound 1 sfCLOrdinal $ = 'srcCLSyntaxBound15;
pub theorem sfCLHierarchy_bound: $ sfBound 2 sfCLHierarchy $ = 'srcCLSyntaxBound1291;
pub theorem sfCLOrdinal_wf: $ sfWf sfCLOrdinal $ = '(ax_mp sfBound_wf sfCLOrdinal_bound);
pub theorem sfCLHierarchy_wf: $ sfWf sfCLHierarchy $ = '(ax_mp sfBound_wf sfCLHierarchy_bound);
theorem sfCLPairMap_value (d y i: nat): $ sfCLPairMap d y @ i = if (i = 0) d y $ =
 (named '(applame ,eqtac));
theorem sfCLPairMap_range (d y k i: nat) (hd: $ d < k $) (hy: $ y < k $):
 $ sfCLPairMap d y @ i < k $ =
 '(mpbir (lteq1 sfCLPairMap_value)
   (cases (mpbiri hd (lteq1d ifpos)) (mpbiri hy (lteq1d ifneg))));
theorem sfCLPairMap_below (d y k n: nat) (hd: $ d < k $) (hy: $ y < k $):
 $ A. i (i < n -> sfCLPairMap d y @ i < k) $ =
 (named '(ax_gen (a1i (sfCLPairMap_range hd hy))));
theorem sfCLRename_bound_zero {i: nat} (F: set) (n k c: nat):
 $ (A. i (i < n -> F @ i < k)) -> sfBound n c -> sfBound k (sfRename F 0 c) $ =
 '(syl6 (bi1 (sfSchema_bound_index_eq add01))
   (syl5 (bi2 (sfSchema_bound_index_eq add01)) sfRename_bound));
pub theorem sfCLOrdinalAt_bound (d k: nat) (hd: $ d < k $):
 $ sfBound k (sfCLOrdinalAt d) $ =
 (named '(ax_mp (ax_mp (com12 sfCLRename_bound_zero) sfCLOrdinal_bound) (sfCLPairMap_below hd hd)));
pub theorem sfCLHierarchyAt_bound (d y k: nat) (hd: $ d < k $) (hy: $ y < k $):
 $ sfBound k (sfCLHierarchyAt d y) $ =
 (named '(ax_mp (ax_mp (com12 sfCLRename_bound_zero) sfCLHierarchy_bound) (sfCLPairMap_below hd hy)));
pub theorem sfCLOrdinalAt_wf (d: nat): $ sfWf (sfCLOrdinalAt d) $ = 'sfRename_wf;
pub theorem sfCLHierarchyAt_wf (d y: nat): $ sfWf (sfCLHierarchyAt d y) $ = 'sfRename_wf;
pub theorem sfCLPoint_wf (start count d y: nat): $ sfWf (sfCLPoint start count d y) $ =
 '(ax_mp (ax_mp sfWf_and (ax_mp (ax_mp sfWf_and sfCLOrdinalAt_wf) sfCLHierarchyAt_wf)) sfCLMembership_wf);
pub theorem sfCLRecipe_wf (start count: nat): $ sfWf (sfCLRecipe start count) $ =
 '(ax_mp sfWf_ex (ax_mp sfWf_ex sfCLPoint_wf));
pub theorem sfCLPoint_bound (start count d y k: nat) (hd: $ d < k $) (hy: $ y < k $):
 $ sfCLNamesBound start count k -> sfBound k (sfCLPoint start count d y) $ =
 '(mpbird (a1i sfBound_sfAnd)
   (iand (a1i (mpbir sfBound_sfAnd (ian (sfCLOrdinalAt_bound hd) (sfCLHierarchyAt_bound hd hy))))
     (sfCLMembership_bound hy)));
pub theorem sfCLNamesBound_shift (start count k: nat):
 $ sfCLNamesBound start count k -> sfCLNamesBound (suc start) count (suc k) $ =
 (named '(alimi (imim2i (syl (bi2 (lteq1 addS2)) (bi1 ltsuc)))));
pub theorem sfCLRecipe_bound (start count k: nat):
 $ sfCLNamesBound start count k -> sfBound k (sfCLRecipe start count) $ =
 '(syl (bi2 sfBound_sfEx) (syl (bi2 sfBound_sfEx)
   (syl (sfCLPoint_bound (mpbi ltsuc lt01S) lt01S)
     (syl sfCLNamesBound_shift sfCLNamesBound_shift))));

