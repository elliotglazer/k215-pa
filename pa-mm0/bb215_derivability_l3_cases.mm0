import "bb215_derivability_l3_lift.mm0";

-- L05, layer L3a (lanes/L05.md): or-introduction rules and the case split z = 0 or z = S w
-- inside PA. Generated by build_bb215_derivability_l2_add_basic.py.

theorem bb215L3_or_left (n a b: nat) (hb: $ paFormulaBound n b $) (h: $ paProvable n a $):
  $ paProvable n (paFormulaOr a b) $;

theorem bb215L3_or_right (n a b: nat) (ha: $ paFormulaBound n a $) (h: $ paProvable n b $):
  $ paProvable n (paFormulaOr a b) $;

-- PA |- A. z (z = 0 \/ E. w (z = S w))

theorem bb215L3_zero_or_succ:
  $ paProvable 0 (paFormulaAll (paFormulaOr (paFormulaEqual (paTermVariable 0) paTermZero) (paFormulaEx (paFormulaEqual (paTermVariable 1) (paTermSuccessor (paTermVariable 0)))))) $;
