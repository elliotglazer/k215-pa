-- L05, layer L3b (lanes/L05.md): the export rule for the natural-deduction front end, and
-- transitivity of <= inside PA. Generated by build_bb215_derivability_l3b_le.py.

-- Deduction step for the natural-deduction front end: (a /\ b) -> c gives a -> (b -> c).
theorem bb215L3_export (n a b c: nat) (h: $ paProvable n (paFormulaImp (paFormulaAnd a b) c) $):
  $ paProvable n (paFormulaImp a (paFormulaImp b c)) $;

-- PA |- A. z A. y A. x (x <= y -> y <= z -> x <= z)

theorem bb215L3_le_trans: $ paProvable 0 (paFormulaAll (paFormulaAll (paFormulaAll (paFormulaImp (paFormulaEx (paFormulaEqual (paTermAddition (paTermVariable 1) (paTermVariable 0)) (paTermVariable 2))) (paFormulaImp (paFormulaEx (paFormulaEqual (paTermAddition (paTermVariable 2) (paTermVariable 0)) (paTermVariable 3))) (paFormulaEx (paFormulaEqual (paTermAddition (paTermVariable 1) (paTermVariable 0)) (paTermVariable 3)))))))) $;
