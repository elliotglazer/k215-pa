import "source_k0_qsep_quotient_rebase.mm1";

import "source_k0_qsep_matrix_alignment.mm1";

import "source_named_renaming.mm1";

@_ def sfK0QSepOpenSeparation (phi: nat): nat =
 $ sfEx (sfAll (sfIff (sfMem 0 1) (sfAnd (sfMem 0 2) (sfRename sfSepMap 0 phi)))) $;

pub theorem sfK0QSepQuote_renamed (E: set) (t a c z k phi: nat) (hf: $ sfWf phi $):
 $ sqQuote (sqEnvCons z (sqEnvCons c (sqEnvCons a E))) t k 0 (sfRename sfSepMap 0 phi) = sqQuote (sqEnvCons z E) t k 0 phi $ =
'(eqtr (ax_mp sqQuote_source_renaming hf) (sqQuoteeq1 sfK0QSepCut_environment));

pub theorem sfK0QSepQuote_open (E: set) (t a k phi: nat) (hf: $ sfWf phi $):
 $ sqQuote (sqEnvCons a E) t k 0 (sfK0QSepOpenSeparation phi) = kExists k (sfK0QSepQuotientBody E t a k (suc k) (suc (suc k)) (suc (suc k)) phi) $ =
(named '(eqtr (ax_mp sqQuote_ex_cons (ax_mp sfWf_all (ax_mp (ax_mp sfWf_and (ax_mp (ax_mp sfWf_imp sfWf_mem) (ax_mp (ax_mp sfWf_and sfWf_mem) sfRename_wf))) (ax_mp (ax_mp sfWf_imp (ax_mp (ax_mp sfWf_and sfWf_mem) sfRename_wf)) sfWf_mem)))) (kExistseq2 (kAndeq2 (eqtr (ax_mp sqQuote_all_cons (ax_mp (ax_mp sfWf_and (ax_mp (ax_mp sfWf_imp sfWf_mem) (ax_mp (ax_mp sfWf_and sfWf_mem) sfRename_wf))) (ax_mp (ax_mp sfWf_imp (ax_mp (ax_mp sfWf_and sfWf_mem) sfRename_wf)) sfWf_mem))) (kAlleq2 (kImpeq2 (eqtr sqQuote_sfAnd (kAndeq (eqtr sqQuote_sfImp (kImpeq (eqtr sqQuote_sfMem (sqMembereq eqid (eqtr sfNamedIndex_zero sqEnvCons_zero) (eqtr sfNamedIndex_zero (eqtr sqEnvCons_suc sqEnvCons_zero)) add0)) (eqtr sqQuote_sfAnd (kAndeq (eqtr sqQuote_sfMem (sqMembereq eqid (eqtr sfNamedIndex_zero sqEnvCons_zero) (eqtr sfNamedIndex_zero (eqtr sqEnvCons_suc (eqtr sqEnvCons_suc sqEnvCons_zero))) add0)) (sfK0QSepQuote_renamed hf))))) (eqtr sqQuote_sfImp (kImpeq (eqtr sqQuote_sfAnd (kAndeq (eqtr sqQuote_sfMem (sqMembereq eqid (eqtr sfNamedIndex_zero sqEnvCons_zero) (eqtr sfNamedIndex_zero (eqtr sqEnvCons_suc (eqtr sqEnvCons_suc sqEnvCons_zero))) add0)) (sfK0QSepQuote_renamed hf))) (eqtr sqQuote_sfMem (sqMembereq eqid (eqtr sfNamedIndex_zero sqEnvCons_zero) (eqtr sfNamedIndex_zero (eqtr sqEnvCons_suc sqEnvCons_zero)) add0)))))))))))));
