import "k215_core_transfer.mm1";

import "source_k0_qrep_uniform.mm1";

pub theorem k215ReplacementImages:
 $ omegaReplacementImages $ =
(named 'sfK0QRep_all_context);

pub theorem k215CoreSchemas:
 $ quotientCoreSchemas $ =
'(ax_mp k215CoreSchemas_from_replacement k215ReplacementImages);

pub theorem k215CoreInconsistency:
 $ sfTheoryProvable zfcCoreAxioms sfBot -> k215Inconsistent $ =
'(ax_mp k215CoreInconsistency_from_replacement k215ReplacementImages);

pub theorem k215ZFRInconsistency:
 $ sfTheoryProvable zfrAxioms sfBot -> k215Inconsistent $ =
'(ax_mp k215ZFRInconsistency_from_replacement k215ReplacementImages);
