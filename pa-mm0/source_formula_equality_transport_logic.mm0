import "source_formula_equality_transport_atomic.mm0";

theorem sfFormulaEquality_and_rule (h a ap b bp: nat) (h0: $ sfWf h $) (h1: $ sfWf a $) (h2: $ sfWf ap $) (h3: $ sfWf b $) (h4: $ sfWf bp $):
 $ nsLocal sfFormulaEqualityContext (sfImp h (sfImp a ap)) -> nsLocal sfFormulaEqualityContext (sfImp h (sfImp b bp)) -> nsLocal sfFormulaEqualityContext (sfImp h (sfImp (sfAnd a b) (sfAnd ap bp))) $;

theorem sfFormulaEquality_or_rule (h a ap b bp: nat) (h0: $ sfWf h $) (h1: $ sfWf a $) (h2: $ sfWf ap $) (h3: $ sfWf b $) (h4: $ sfWf bp $):
 $ nsLocal sfFormulaEqualityContext (sfImp h (sfImp a ap)) -> nsLocal sfFormulaEqualityContext (sfImp h (sfImp b bp)) -> nsLocal sfFormulaEqualityContext (sfImp h (sfImp (sfOr a b) (sfOr ap bp))) $;

theorem sfFormulaEquality_imp_rule (h a ap b bp: nat) (h0: $ sfWf h $) (h1: $ sfWf a $) (h2: $ sfWf ap $) (h3: $ sfWf b $) (h4: $ sfWf bp $):
 $ nsLocal sfFormulaEqualityContext (sfImp h (sfImp ap a)) -> nsLocal sfFormulaEqualityContext (sfImp h (sfImp b bp)) -> nsLocal sfFormulaEqualityContext (sfImp h (sfImp (sfImp a b) (sfImp ap bp))) $;

theorem sfFormulaEquality_guard_rule (h r a ap: nat) (h0: $ sfWf h $) (h1: $ sfWf r $) (h2: $ sfWf a $) (h3: $ sfWf ap $):
 $ nsLocal sfFormulaEqualityContext (sfImp h r) -> nsLocal sfFormulaEqualityContext (sfImp r (sfImp a ap)) -> nsLocal sfFormulaEqualityContext (sfImp h (sfImp a ap)) $;

theorem sfFormulaEquality_equal_local (a ap b bp: nat):
 $ nsLocal sfFormulaEqualityContext (sfImp (sfEq a ap) (sfImp (sfEq b bp) (sfImp (sfEq a b) (sfEq ap bp)))) $;

theorem sfFormulaEquality_mem_rule (h a ap b bp: nat) (hh: $ sfWf h $):
 $ nsLocal sfFormulaEqualityContext (sfImp h (sfEq a ap)) -> nsLocal sfFormulaEqualityContext (sfImp h (sfEq b bp)) -> nsLocal sfFormulaEqualityContext (sfImp h (sfImp (sfMem a b) (sfMem ap bp))) $;

theorem sfFormulaEquality_eq_rule (h a ap b bp: nat) (hh: $ sfWf h $):
 $ nsLocal sfFormulaEqualityContext (sfImp h (sfEq a ap)) -> nsLocal sfFormulaEqualityContext (sfImp h (sfEq b bp)) -> nsLocal sfFormulaEqualityContext (sfImp h (sfImp (sfEq a b) (sfEq ap bp))) $;
