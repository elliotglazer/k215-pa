import "k215_literal_runtime_native_interface.mm0";

theorem k215PNativeAtEq (pc target g regs w rest: nat):
 $ pc = target -> k215PNativeOutcome g (k215PState target regs) w rest ->
   k215PNativeOutcome g (k215PState pc regs) w rest $;

theorem k215PInterval_eq (lo pc: nat):
 $ lo <= pc /\ pc < suc lo -> pc = lo $;

theorem k215PNativeIntervalLeaf (lo pc g regs w rest: nat)
 (h: $ k215PNativeOutcome g (k215PState lo regs) w rest $):
 $ lo <= pc /\ pc < suc lo -> k215PNativeOutcome g (k215PState pc regs) w rest $;

theorem k215PNativeIntervalJoin (G: wff) (lo mid hi pc: nat)
 (left: $ lo <= pc /\ pc < mid -> G $)
 (right: $ mid <= pc /\ pc < hi -> G $):
 $ lo <= pc /\ pc < hi -> G $;
