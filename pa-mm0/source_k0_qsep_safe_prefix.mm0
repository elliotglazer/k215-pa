import "source_k0_qsep_conditional_prefix.mm0";
import "k218q_safe_prefix.mm0";

def sfK0QSepSafe (n a .S .k: nat): wff =
 $ A. S A. k (sfBound n a -> 2 < k -> sqEnvBelow (sqNumericEnvironment S) n k ->
   k218QProvable (kImp kEmptyMarker (sqQuote (sqNumericEnvironment S) 1 k 0 a))) $;

theorem sfK0QSepSafe_use (n a S k: nat):
 $ sfK0QSepSafe n a -> sfBound n a -> 2 < k -> sqEnvBelow (sqNumericEnvironment S) n k ->
   k218QProvable (kImp kEmptyMarker (sqQuote (sqNumericEnvironment S) 1 k 0 a)) $;

theorem sfK0QSepSafe_all (n a: nat):
 $ sfK0QSepSafe (suc n) a -> sfK0QSepSafe n (sfAll a) $;

theorem sfK0QSepSafe_prefix (n m a: nat):
 $ sfK0QSepSafe (m + n) a -> sfK0QSepSafe m (sfAllPrefix n a) $;

theorem sfK0QSepSafe_closed (n a: nat):
 $ sfK0QSepSafe n a -> sfK0QSepSafe 0 (sfAllPrefix n a) $;
