import "k218q_seed_source_prepared.mm0";

def k218SourceOuterSeed (E: set) (n B f: nat): nat =
 $ (kAll (k218SourceSeedBase E B f) (kExists (suc (k218SourceSeedBase E B f)) (kAnd (kAll (suc (suc (k218SourceSeedBase E B f))) (kImp (kMem (suc (suc (k218SourceSeedBase E B f))) (suc (k218SourceSeedBase E B f))) (kExists (suc (suc (suc (k218SourceSeedBase E B f)))) (kAnd (sfNamedTemplate (sqEnvCons (suc (suc (k218SourceSeedBase E B f))) (sqEnvCons (suc (suc (suc (k218SourceSeedBase E B f)))) E)) (suc (suc (suc (suc (k218SourceSeedBase E B f))))) 0 f) (kAll (suc (suc (suc (suc (k218SourceSeedBase E B f))))) (kImp (kAll (suc (suc (suc (suc (suc (k218SourceSeedBase E B f)))))) (kImp (kMem (suc (suc (suc (suc (suc (k218SourceSeedBase E B f)))))) (suc (suc (suc (suc (k218SourceSeedBase E B f)))))) (kMem (suc (suc (suc (suc (suc (k218SourceSeedBase E B f)))))) (suc (suc (k218SourceSeedBase E B f)))))) (kAll (suc (suc (suc (suc (suc (k218SourceSeedBase E B f)))))) (kImp (sfNamedTemplate (sqEnvCons (suc (suc (suc (suc (suc (k218SourceSeedBase E B f)))))) (sqEnvCons (suc (suc (suc (suc (k218SourceSeedBase E B f))))) E)) (suc (suc (suc (suc (suc (suc (k218SourceSeedBase E B f))))))) 0 f) (kExists (suc (suc (suc (suc (suc (suc (k218SourceSeedBase E B f))))))) (kAnd (sfNamedTemplate (sqEnvCons (suc (suc (suc (suc (suc (suc (k218SourceSeedBase E B f))))))) (sqEnvCons (suc (suc (suc (suc (k218SourceSeedBase E B f))))) E)) (suc (suc (suc (suc (suc (suc (suc (k218SourceSeedBase E B f)))))))) 0 f) (kMem (suc (suc (suc (suc (suc (suc (k218SourceSeedBase E B f))))))) (suc (k218SourceSeedBase E B f))))))))))))) (kImp (kExists (suc (suc (k218SourceSeedBase E B f))) (sfNamedTemplate (sqEnvCons (suc (suc (k218SourceSeedBase E B f))) (sqEnvCons (k218SourceSeedBase E B f) E)) (k218SourceMatrixBase E B f) 0 f)) (kExists (suc (suc (k218SourceSeedBase E B f))) (kAnd (sfNamedTemplate (sqEnvCons (suc (suc (k218SourceSeedBase E B f))) (sqEnvCons (k218SourceSeedBase E B f) E)) (k218SourceMatrixBase E B f) 0 f) (kMem (suc (suc (k218SourceSeedBase E B f))) (suc (k218SourceSeedBase E B f))))))))) $;

theorem k218QSourceSeed_outer {j: nat} (E: set) (n B f: nat)
 (hB: $ 3 < B $) (he1: $ sqEnvAvoid E n 1 $) (he3: $ sqEnvAvoid E n 3 $)
 (he: $ A. j (j < n -> E @ j < B) $)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218IEquivalent (k218SourcePreparedSeed E B f) (k218SourceOuterSeed E n B f) $;
