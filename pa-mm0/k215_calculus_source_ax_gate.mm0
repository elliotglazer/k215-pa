import "k218_codes.mm0";
import "k215_calculus_source_ax_gate_comparisons.mm0";
import "k215_calculus_source_ax_clear4570.mm0";
import "k215_calculus_source_ax_clear4588.mm0";
import "k215_calculus_source_ax_gate_loops.mm0";

theorem k215GateSourceValue (u t w c a b v: nat): $ k215PReach (k215PState k215PNum4556 (k215PVector u t w c a b 0 0 v)) (k215PState 0 (k215PVector u (if (c = a \/ c = b) 0 t) w 0 0 0 0 0 v)) $;

theorem k215GateSourceInterval (u w c a b v: nat): $ k215PReach (k215PState k215PNum4556 (k215PVector u (k218Bundle a b c) w c a b 0 0 v)) (k215PState 0 (k215PVector u (k218Gate a b c) w 0 0 0 0 0 v)) $;
