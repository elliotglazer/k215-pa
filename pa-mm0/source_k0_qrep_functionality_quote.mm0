import "source_k0_qrep_quote_maps.mm0";

import "source_k0_qrep_profile.mm0";

def sfK0QRepCanonicalFunctional (E: set) (t k phi: nat): nat = $ (kAll k (kImp (kMem t k) (kAll (suc k) (kImp (kMem t (suc k)) (kAll (suc (suc k)) (kImp (kMem t (suc (suc k))) (kImp (sfK0QRepRelation E t (suc (suc (suc k))) k (suc k) phi) (kImp (sfK0QRepRelation E t (suc (suc (suc k))) k (suc (suc k)) phi) (sqEqual t (suc k) (suc (suc k)) (suc (suc (suc k)))))))))))) $;

theorem sfK0QRep_functionality_quote (E: set) (n t k phi: nat):
 $ sfBound (suc (suc n)) phi -> sqQuote E t k 0 (sfFunctionality (sfRename sfRepAMap 0 phi) (sfRename sfRepBMap 0 phi)) = sfK0QRepCanonicalFunctional E t k phi $;
