import "bb215_derivability_l3_disc.mm0";

-- L05, layer L3a (lanes/L05.md): lifting an equation, and the case split x <= S B -> x <= B or x = S B
-- inside PA (existential elimination twice, with the case split z = 0 or z = S w).
-- Generated by build_bb215_derivability_l2_add_basic.py.

-- Lifting an equation past one more free variable lifts both terms.

theorem bb215L3_lift_eq (n s t: nat) (hs: $ paTermBound n s $) (ht: $ paTermBound n t $):
  $ paAxiomLift (paFormulaEqual s t) = (paFormulaEqual (paTermLift 1 s) (paTermLift 1 t)) $;

-- x <= S B -> (x <= B \/ x = S B)

theorem bb215L3_le_succ_cases (n x B: nat) (hx: $ paTermBound n x $) (hB: $ paTermBound n B $):
  $ paProvable n (paFormulaImp (bb215L3Le x (paTermSuccessor B)) (paFormulaOr (bb215L3Le x B) (paFormulaEqual x (paTermSuccessor B)))) $;
