pub theorem sfTVImp_local(G a ap b bp:nat)(ha:$ sfWf a $)(hap:$ sfWf ap $)(hb:$ sfWf b $)(hbp:$ sfWf bp $)(hA:$ nsLocal G (sfIff a ap) $)(hB:$ nsLocal G (sfIff b bp) $): $ nsLocal G (sfIff (sfImp a b) (sfImp ap bp)) $ = (named '(ax_mp (ax_mp nsLocal_mp (ax_mp (ax_mp nsLocal_mp (ax_mp (ax_mp (ax_mp nsLocal_weaken (ax_mp nsLocal_context_wf hA)) all0) (sfTVImp_pure ha hap hb hbp))) hA)) hB));

pub theorem sfTVRefl_local(G a:nat)(hg:$ sfContextWf G $)(ha:$ sfWf a $): $ nsLocal G (sfIff a a) $ = (named '(ax_mp (ax_mp sfLocal_and (ax_mp nsLocal_II (ax_mp (ax_mp nsLocal_hyp (mpbir sfContextWf_cons (ian ha hg))) sfContext_member_head))) (ax_mp nsLocal_II (ax_mp (ax_mp nsLocal_hyp (mpbir sfContextWf_cons (ian ha hg))) sfContext_member_head))));
