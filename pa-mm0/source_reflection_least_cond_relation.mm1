theorem rlcSafe_bound(P:wff)(n phi:nat)(hp:$ P -> sfBound n phi $): $ sfBound n (if P phi sfBot) $ = '(cases (mpbird (srecpeq2d (preq2d ifpos)) hp) (mpbird (srecpeq2d (preq2d ifneg)) (a1i sfBound_bot)));
theorem sfReflectionLeast_functional_safe(phi:nat): $ sfTheoryProvable zfrAxioms (sfReflectionLeastGFun (if (sfBound 2 phi) phi sfBot)) $ = '(sfReflectionLeast_functional_meta (rlcSafe_bound id));
pub theorem sfReflectionLeast_functional(phi:nat): $ sfBound 2 phi -> sfTheoryProvable zfrAxioms (sfReflectionLeastGFun phi) $ = '(mpbid (sfTheoryProvable_congr (rlcGuard25eqd ifpos)) (a1i sfReflectionLeast_functional_safe));
theorem sfReflectionLeast_total_if_safe(phi:nat): $ sfTheoryProvable zfrAxioms (sfReflectionLeastTotalLaw (if (sfBound 2 phi) phi sfBot)) $ = '(sfReflectionLeast_total_if_meta (rlcSafe_bound id));
pub theorem sfReflectionLeast_total_if(phi:nat): $ sfBound 2 phi -> sfTheoryProvable zfrAxioms (sfReflectionLeastTotalLaw phi) $ = '(mpbid (sfTheoryProvable_congr (rlcGuard41eqd ifpos)) (a1i sfReflectionLeast_total_if_safe));
theorem rlcSafeMatrix_bound(phi:nat): $ sfBound 2 (sfReflectionLeastMatrix (if (sfBound 2 phi) phi sfBot)) $ = '(sfReflectionLeastMatrix_bound (rlcSafe_bound id));
pub theorem sfReflectionLeastMatrix_bound_internal(phi:nat): $ sfBound 2 phi -> sfBound 2 (sfReflectionLeastMatrix phi) $ = '(mpbid (sfBoundeqd eqidd (rlcGuard24eqd ifpos)) (a1i rlcSafeMatrix_bound));
