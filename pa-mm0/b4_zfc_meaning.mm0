theorem bdMeaning_In (a b c d: nat): $ bdMeaning bdtIn a b c d <-> a IN b $;
theorem bdMeaning_Sub (a b c d: nat): $ bdMeaning bdtSub a b c d <-> sfContextSub a b $;
theorem bdMeaning_Wf (a b c d: nat): $ bdMeaning bdtWf a b c d <-> sfWf a $;
theorem bdMeaning_Cwf (a b c d: nat): $ bdMeaning bdtCwf a b c d <-> sfContextWf a $;
theorem bdMeaning_Row (a b c d: nat): $ bdMeaning bdtRow a b c d <-> sfRowWf a $;
theorem bdMeaning_Bnd (a b c d: nat): $ bdMeaning bdtBnd a b c d <-> sfBound a b $;
theorem bdMeaning_Shift (a b c d: nat): $ bdMeaning bdtShift a b c d <-> sfShift a b = c $;
theorem bdMeaning_Subst (a b c d: nat): $ bdMeaning bdtSubst a b c d <-> sfSubst a b c = d $;
theorem bdMeaning_Ren (a b c d: nat): $ bdMeaning bdtRen a b c d <-> bdRenG a b c d $;
theorem bdMeaning_AllPre (a b c d: nat): $ bdMeaning bdtAllPre a b c d <-> sfAllPrefix a b = c $;
theorem bdMeaning_CShift (a b c d: nat): $ bdMeaning bdtCShift a b c d <-> sfContextShift a = b $;
theorem bdMeaning_Ax (a b c d: nat): $ bdMeaning bdtAx a b c d <-> a e. zfcAxioms $;
theorem bdMeaning_Cax (a b c d: nat): $ bdMeaning bdtCax a b c d <-> zfcContext a $;
theorem bdMeaning_Valid (a b c d: nat): $ bdMeaning bdtValid a b c d <-> traceValid sfNDFullRules a $;
theorem bdMeaningI_In (g a b c d: nat): $ g = bdtIn -> a IN b -> bdMeaning g a b c d $;
theorem bdMeaningI_Sub (g a b c d: nat): $ g = bdtSub -> sfContextSub a b -> bdMeaning g a b c d $;
theorem bdMeaningI_Wf (g a b c d: nat): $ g = bdtWf -> sfWf a -> bdMeaning g a b c d $;
theorem bdMeaningI_Cwf (g a b c d: nat): $ g = bdtCwf -> sfContextWf a -> bdMeaning g a b c d $;
theorem bdMeaningI_Row (g a b c d: nat): $ g = bdtRow -> sfRowWf a -> bdMeaning g a b c d $;
theorem bdMeaningI_Bnd (g a b c d: nat): $ g = bdtBnd -> sfBound a b -> bdMeaning g a b c d $;
theorem bdMeaningI_Shift (g a b c d: nat): $ g = bdtShift -> sfShift a b = c -> bdMeaning g a b c d $;
theorem bdMeaningI_Subst (g a b c d: nat): $ g = bdtSubst -> sfSubst a b c = d -> bdMeaning g a b c d $;
theorem bdMeaningI_Ren (g a b c d: nat): $ g = bdtRen -> bdRenG a b c d -> bdMeaning g a b c d $;
theorem bdMeaningI_AllPre (g a b c d: nat): $ g = bdtAllPre -> sfAllPrefix a b = c -> bdMeaning g a b c d $;
theorem bdMeaningI_CShift (g a b c d: nat): $ g = bdtCShift -> sfContextShift a = b -> bdMeaning g a b c d $;
theorem bdMeaningI_Ax (g a b c d: nat): $ g = bdtAx -> a e. zfcAxioms -> bdMeaning g a b c d $;
theorem bdMeaningI_Cax (g a b c d: nat): $ g = bdtCax -> zfcContext a -> bdMeaning g a b c d $;
theorem bdMeaningI_Valid (g a b c d: nat): $ g = bdtValid -> traceValid sfNDFullRules a -> bdMeaning g a b c d $;
theorem bdHasOK_inst (m v i g a b c d: nat): $ bdHasOK m v i -> bdHas m v i g a b c d -> bdMeaning g a b c d $;
theorem bdHasOK_In (m v i a b c d: nat): $ bdHasOK m v i -> bdHas m v i bdtIn a b c d -> a IN b $;
theorem bdHasOK_Sub (m v i a b c d: nat): $ bdHasOK m v i -> bdHas m v i bdtSub a b c d -> sfContextSub a b $;
theorem bdHasOK_Wf (m v i a b c d: nat): $ bdHasOK m v i -> bdHas m v i bdtWf a b c d -> sfWf a $;
theorem bdHasOK_Cwf (m v i a b c d: nat): $ bdHasOK m v i -> bdHas m v i bdtCwf a b c d -> sfContextWf a $;
theorem bdHasOK_Row (m v i a b c d: nat): $ bdHasOK m v i -> bdHas m v i bdtRow a b c d -> sfRowWf a $;
theorem bdHasOK_Bnd (m v i a b c d: nat): $ bdHasOK m v i -> bdHas m v i bdtBnd a b c d -> sfBound a b $;
theorem bdHasOK_Shift (m v i a b c d: nat): $ bdHasOK m v i -> bdHas m v i bdtShift a b c d -> sfShift a b = c $;
theorem bdHasOK_Subst (m v i a b c d: nat): $ bdHasOK m v i -> bdHas m v i bdtSubst a b c d -> sfSubst a b c = d $;
theorem bdHasOK_Ren (m v i a b c d: nat): $ bdHasOK m v i -> bdHas m v i bdtRen a b c d -> bdRenG a b c d $;
theorem bdHasOK_AllPre (m v i a b c d: nat): $ bdHasOK m v i -> bdHas m v i bdtAllPre a b c d -> sfAllPrefix a b = c $;
theorem bdHasOK_CShift (m v i a b c d: nat): $ bdHasOK m v i -> bdHas m v i bdtCShift a b c d -> sfContextShift a = b $;
theorem bdHasOK_Ax (m v i a b c d: nat): $ bdHasOK m v i -> bdHas m v i bdtAx a b c d -> a e. zfcAxioms $;
theorem bdHasOK_Cax (m v i a b c d: nat): $ bdHasOK m v i -> bdHas m v i bdtCax a b c d -> zfcContext a $;
theorem bdHasOK_Valid (m v i a b c d: nat): $ bdHasOK m v i -> bdHas m v i bdtValid a b c d -> traceValid sfNDFullRules a $;
