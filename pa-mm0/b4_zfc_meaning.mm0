import "b4_zfc_fixed.mm0";

--| the renaming judgment for rename map number e (zfc_schema_maps.mm0).
def bdRenG (e d c y: nat): wff =
$ (e = 0 /\ sfRename sfSepMap d c = y) \/ (e = 1 /\ sfRename sfRepAMap d c = y) \/
  (e = 2 /\ sfRename sfRepBMap d c = y) \/ (e = 3 /\ sfRename sfRepCMap d c = y) $;
--| the K215 judgment that a fact (tag g, arguments a b c d) asserts.
def bdMeaning (g a b c d: nat): wff =
$ (g = bdtIn /\ a IN b) \/
  (g = bdtSub /\ sfContextSub a b) \/
  (g = bdtWf /\ sfWf a) \/
  (g = bdtCwf /\ sfContextWf a) \/
  (g = bdtRow /\ sfRowWf a) \/
  (g = bdtBnd /\ sfBound a b) \/
  (g = bdtShift /\ sfShift a b = c) \/
  (g = bdtSubst /\ sfSubst a b c = d) \/
  (g = bdtRen /\ bdRenG a b c d) \/
  (g = bdtAllPre /\ sfAllPrefix a b = c) \/
  (g = bdtCShift /\ sfContextShift a = b) \/
  (g = bdtAx /\ a e. zfcAxioms) \/
  (g = bdtCax /\ zfcContext a) \/
  (g = bdtValid /\ traceValid sfNDFullRules a) $;
--| every fact of (m, v) with index below i means what it says.
def bdHasOK (m v i .g .a .b .c .d: nat): wff =
$ A. g A. a A. b A. c A. d (bdHas m v i g a b c d -> bdMeaning g a b c d) $;
theorem bdRenGeqd (G: wff) (e d c y e2 d2 c2 y2: nat) (h1: $ G -> e = e2 $) (h2: $ G -> d = d2 $) (h3: $ G -> c = c2 $) (h4: $ G -> y = y2 $): $ G -> (bdRenG e d c y <-> bdRenG e2 d2 c2 y2) $;
theorem bdMeaningeqd (G: wff) (g a b c d g2 a2 b2 c2 d2: nat) (h1: $ G -> g = g2 $) (h2: $ G -> a = a2 $) (h3: $ G -> b = b2 $) (h4: $ G -> c = c2 $) (h5: $ G -> d = d2 $): $ G -> (bdMeaning g a b c d <-> bdMeaning g2 a2 b2 c2 d2) $;
theorem bdtvIn: $ bdtIn = 1 $;
theorem bdtvSub: $ bdtSub = 2 $;
theorem bdtvWf: $ bdtWf = 3 $;
theorem bdtvCwf: $ bdtCwf = 4 $;
theorem bdtvRow: $ bdtRow = 5 $;
theorem bdtvBnd: $ bdtBnd = 6 $;
theorem bdtvShift: $ bdtShift = 7 $;
theorem bdtvSubst: $ bdtSubst = 8 $;
theorem bdtvRen: $ bdtRen = 9 $;
theorem bdtvAllPre: $ bdtAllPre = 10 $;
theorem bdtvCShift: $ bdtCShift = suc 10 $;
theorem bdtvAx: $ bdtAx = suc (suc 10) $;
theorem bdtvCax: $ bdtCax = suc (suc (suc 10)) $;
theorem bdtvValid: $ bdtValid = suc (suc (suc (suc 10))) $;
