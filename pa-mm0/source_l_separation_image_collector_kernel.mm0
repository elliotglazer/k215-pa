import "source_l_separation_image_collection.mm0";
import "source_l_replacement_common_coverage.mm0";

theorem sfLSeparationSeededRecipe_forget(G start count seed:nat)
 (hc:$ nsLocal G (sfLReplacementSeededRecipe start count seed) $):
 $ nsLocal G (sfCLRecipe start count) $;
theorem slSepWitnessLift(G point a:nat)(hp:$ sfWf point $)(ha:$ nsLocal G a $):
 $ nsLocal (sfCLWitnessContext G point) (sfShift 0 (sfShift 0 a)) $;

def slSepInitialContext(G:nat):nat = $ sfCLWitnessContext G (sfCLPoint 2 0 1 0) $;

theorem slSepInitial_hyp(G:nat): $ nsLocal (slSepInitialContext G) (sfCLPoint 2 0 1 0) $;
theorem slSepInitial_extension(G:nat)(he:$ nsLocal G sfLReplacementLevelExtension $):
 $ nsLocal (slSepInitialContext G) sfLReplacementLevelExtension $;
theorem slSepInitial_inputs(G n:nat)(hi:$ nsLocal G (sfCLPredicates sfLDomain 0 n) $):
 $ nsLocal (slSepInitialContext G) (sfCLPredicates sfLDomain 2 n) $;
theorem slSepInitial_collected(G n:nat)(he:$ nsLocal G sfLReplacementLevelExtension $)
 (hi:$ nsLocal G (sfCLPredicates sfLDomain 0 n) $):
 $ nsLocal (slSepInitialContext G) (sfCLRecipe 2 n) $;
theorem sfLSeparationImage_collect_from_initial(G n:nat)
 (he:$ nsLocal G sfLReplacementLevelExtension $)
 (h0:$ nsLocal G (sfCLRecipe 0 0) $)
 (hi:$ nsLocal G (sfCLPredicates sfLDomain 0 n) $):
 $ nsLocal G (sfCLRecipe 0 n) $;
