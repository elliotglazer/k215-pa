import "extracted_ltrans_weak_stage_slim1_source.mm1";
import "extracted_ltrans_weak_background.mm1";
import "extracted_ltrans_implication.mm1";

pub theorem sfLWeakStageTrans_context: $ eltWContext = sfLWeakBackground $ = 'eqid;
pub theorem sfLWeakStageTrans_formula: $ eltWFormula = sfLStageTrans $ = 'eqid;
pub theorem sfLWeakStageTrans_local: $ nsLocal sfLWeakBackground sfLStageTrans $ =
'(mpbi (nsLocal_context_eq sfLWeakStageTrans_context)
 (mpbi (nsLocal_formula_eq sfLWeakStageTrans_formula) eltWCertificate));
pub theorem sfLWeakStageTrans_zfr: $ sfTheoryProvable zfrAxioms sfLStageTrans $ =
'(ax_mp (sfTheory_local sfLWeakBackground_zfr) sfLWeakStageTrans_local);
pub theorem sfLTransitivity_weak_zfr: $ sfTheoryProvable zfrAxioms sfLTransitivity $ =
'(ax_mp sfLTrans_stage_eliminate sfLWeakStageTrans_zfr);
