theorem k218SQ_sqST_history (l p: nat):
 $ traceClassAll k218SQ_sqSupportedClass l -> p IN l -> k218SQ_sqSupportedGood p $ =
'(syl6 (bi1 k218SQ_sqSupportedClass_value) traceClassAll_get);

theorem k218SQ_sqST_prop_unary (r p l: nat):
 $ traceClassAll k218SQ_sqSupportedClass l -> p IN l /\ sfNDPropUnary r p -> k218SQ_sqSupportedGood r $ =
'(exp @ mpd (mpd anrl (syl k218SQ_sqST_history anl)) (syl k218SQ_sqSupported_prop_unary anrr));

theorem k218SQ_sqST_prop_binary (r p q l: nat):
 $ traceClassAll k218SQ_sqSupportedClass l ->
   p IN l /\ (q IN l /\ sfNDPropBinary r p q) -> k218SQ_sqSupportedGood r $ =
'(exp @ mpd (mpd (syl anl anrr) (syl k218SQ_sqST_history anl)) @
 mpd (mpd anrl (syl k218SQ_sqST_history anl)) @ syl k218SQ_sqSupported_prop_binary (syl anr anrr));

theorem k218SQ_sqST_prop_rule (r l: nat):
 $ traceClassAll k218SQ_sqSupportedClass l -> (r, l) e. sfNDPropRules -> k218SQ_sqSupportedGood r $ =
(named '(syl5bi sfNDPropRules_value @ eord (a1i k218SQ_sqSupported_prop_base)
 (eord (eexd k218SQ_sqST_prop_unary) (eexd (eexd k218SQ_sqST_prop_binary)))));

theorem k218SQ_sqST_quant_unary (r p l: nat):
 $ traceClassAll k218SQ_sqSupportedClass l -> p IN l /\ sfNDQuantUnary r p -> k218SQ_sqSupportedGood r $ =
'(exp @ mpd (mpd anrl (syl k218SQ_sqST_history anl)) (syl k218SQ_sqSupported_quant_unary anrr));

theorem k218SQ_sqST_quant_binary (r p q l: nat):
 $ traceClassAll k218SQ_sqSupportedClass l ->
   p IN l /\ (q IN l /\ sfNDQuantBinary r p q) -> k218SQ_sqSupportedGood r $ =
'(exp @ mpd (mpd (syl anl anrr) (syl k218SQ_sqST_history anl)) @
 mpd (mpd anrl (syl k218SQ_sqST_history anl)) @ syl k218SQ_sqSupported_quant_binary (syl anr anrr));

theorem k218SQ_sqST_quant_rule (r l: nat):
 $ traceClassAll k218SQ_sqSupportedClass l -> (r, l) e. sfNDQuantRules -> k218SQ_sqSupportedGood r $ =
(named '(syl5bi sfNDQuantRules_value @
 eord (eexd k218SQ_sqST_quant_unary) (eexd (eexd k218SQ_sqST_quant_binary))));

theorem k218SQ_sqST_full_rule (r l: nat):
 $ traceClassAll k218SQ_sqSupportedClass l -> (r, l) e. sfNDFullRules -> k218SQ_sqSupportedGood r $ =
'(syl5bi elun (eord k218SQ_sqST_prop_rule k218SQ_sqST_quant_rule));

pub theorem k218SQ_sqSupported_rules_sound: $ traceRuleSound sfNDFullRules k218SQ_sqSupportedClass $ =
(named '(ax_gen @ ax_gen @ syl6 (bi2 k218SQ_sqSupportedClass_value) k218SQ_sqST_full_rule));

pub theorem k218SQ_sqSupported_trace (p: nat):
 $ traceValid sfNDFullRules p -> traceClassAll k218SQ_sqSupportedClass p $ =
'(ax_mp traceValid_classAll k218SQ_sqSupported_rules_sound);

pub theorem k218SQ_sqSupported_derives (p r: nat):
 $ sfNDFullDerives p r -> k218SQ_sqSupportedGood r $ =
'(syl (bi1 k218SQ_sqSupportedClass_value) (ax_mp traceDerives_class k218SQ_sqSupported_rules_sound));

pub theorem k218SQ_sqSupported_sequent (p G a: nat):
 $ sfNDFullDerives p (sfSequent G a) -> k218SQ_sqSupportedGood (sfSequent G a) $ =
'k218SQ_sqSupported_derives;

pub theorem k218SQ_sqSupported_sequent_cutoff {n: nat} (p G a: nat):
 $ sfNDFullDerives p (sfSequent G a) -> E. n k218SQ_sqSupportedAt n (sfSequent G a) $ =
'k218SQ_sqSupported_derives;
