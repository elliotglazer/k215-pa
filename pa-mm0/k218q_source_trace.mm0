import "k218q_source_trace_quantifiers.mm0";

theorem k218QRow_rules_sound: $ traceRuleSound sfNDFullRules k218QRowClass $;

theorem k218QRow_trace (p: nat):
 $ traceValid sfNDFullRules p -> traceClassAll k218QRowClass p $;

theorem k218QRow_derives (p r: nat):
 $ sfNDFullDerives p r -> k218QRowGood r $;

theorem k218QRow_sequent (p G a: nat):
 $ sfNDFullDerives p (sfSequent G a) -> k218QRowGood (sfSequent G a) $;

theorem k218QRow_sequent_cutoff {n: nat} (p G a: nat):
 $ sfNDFullDerives p (sfSequent G a) -> E. n k218QRowAt n (sfSequent G a) $;

theorem k218QSourceND_named {n: nat} (p G a: nat):
 $ sfNDFullDerives p (sfSequent G a) -> E. n k218INamedAt n G a $;
