import "source_k0_qsep_singleton.mm0";

import "k218q_specialization.mm0";

import "k218q_quantifier_macros.mm0";

theorem sfK0QSepEmpty_at (t y z: nat) (hy0: $ y != 0 $) (hty: $ t != y $) (hyz: $ y != z $):
 $ k218QProvable (kImp (kAll y (kNot (kMem y t))) (kNot (kMem z t))) $;

theorem sfK0QSepEmpty_subset (t b y K: nat) (hy0: $ y != 0 $) (hty: $ t != y $) (hyK: $ y != K $)
 (hK0: $ K != 0 $) (hKt: $ K != t $):
 $ k218QProvable (kImp (kAll y (kImp (kMem y t) kF)) (kAll K (kImp (kMem K t) (kMem K b)))) $;
