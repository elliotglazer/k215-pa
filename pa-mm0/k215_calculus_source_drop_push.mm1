theorem k215PairVectorInAt4698 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt4704State k215PNum4704 a6 a1 a7 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum4704 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215PairVectorOutAt4698 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt4704State k215PNum4714 0 0 (a7 + (a6, a1)) (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum4714 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

pub theorem k215PairMacro46_vectorAt4698 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat):
 $ k215PReach (k215PState k215PNum4704 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215PNum4714 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ =
 '(mpbi (k215PReacheq k215PairVectorInAt4698 k215PairVectorOutAt4698) k215PairMacro4704);

theorem k215PushAStage0At4698 (u t w c a b v: nat): $ k215PReach (k215PState k215PNum4698 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum4701 (k215PVector u 0 w c a b t 0 v)) $ = '(k215PReach_intro (eqtr k215Loop4698Vector (k215PStateeq2 (k215PVectoreq7 add0))));

