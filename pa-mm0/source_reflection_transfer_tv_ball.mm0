import "source_reflection_transfer_tv_induction.mm0";

import "source_l_common_level_ball_use.mm0";

import "source_l_common_level_ball_transport.mm0";

def sfTVRowBall(D k matrix y:nat):nat = $ sfCLBall k y (sfReflectionEwAt D matrix (k + y)) $;

theorem sfTVRowBall_wf(D k matrix y:nat)(hd:$ sfBound 1 D $)(hm:$ sfWf matrix $): $ sfWf (sfTVRowBall D k matrix y) $;

theorem sfTVBallEnv_matrix(k matrix:nat)(hb:$ sfBound (suc k) matrix $): $ sfRename (sfCLBallEnv sfIdentityMap k) 1 matrix = matrix $;

theorem sfTVBallEnv_carrier(k y:nat): $ sfCLBallEnv sfIdentityMap k @ (k + y) = y $;

theorem sfTVRowBall_open_formula(D k matrix y:nat)(hd:$ sfBound 1 D $)(hb:$ sfBound (suc k) matrix $): $ sfRename (sfCLBallEnv sfIdentityMap k) 0 (sfReflectionEwAt D matrix (k + y)) = sfReflectionEwAt D matrix y $;

theorem sfTVRowBall_eliminate(D G k matrix y:nat)(hd:$ sfBound 1 D $)(hb:$ sfBound (suc k) matrix $)(hm:$ sfReflectionDnMembers sfIdentityMap G y k $)(hr:$ nsLocal G (sfTVRowBall D k matrix y) $): $ nsLocal G (sfReflectionEwAt D matrix y) $;

theorem sfTVRowBall_shift(D k matrix y:nat)(hd:$ sfBound 1 D $)(hb:$ sfBound (suc k) matrix $): $ sfShift 0 (sfTVRowBall D k matrix y) = sfTVRowBall D k matrix (suc y) $;

theorem sfTVRowBall_shift_if(D k matrix y:nat)(hd:$ sfBound 1 D $): $ sfBound (suc k) matrix -> sfShift 0 (sfTVRowBall D k matrix y) = sfTVRowBall D k matrix (suc y) $;

theorem sfTVBallEnv_matrix_if(k matrix:nat): $ sfBound (suc k) matrix -> sfRename (sfCLBallEnv sfIdentityMap k) 1 matrix = matrix $;

theorem sfTVRowBall_open_if(D k matrix y:nat)(hd:$ sfBound 1 D $): $ sfBound (suc k) matrix -> sfRename (sfCLBallEnv sfIdentityMap k) 0 (sfReflectionEwAt D matrix (k + y)) = sfReflectionEwAt D matrix y $;

theorem sfTVRowBall_eliminate_if(H:wff)(D G k matrix y:nat)(hd:$ sfBound 1 D $)(hb:$ H -> sfBound (suc k) matrix $)(hm:$ H -> sfReflectionDnMembers sfIdentityMap G y k $)(hr:$ H -> nsLocal G (sfTVRowBall D k matrix y) $): $ H -> nsLocal G (sfReflectionEwAt D matrix y) $;
