pub theorem sfTVLContainment_rename(a y:nat): $ sfRename (sfCLPairMap y a) 0 (sfImp (sfCLOrdinalAt 1) (sfImp (sfCLHierarchyAt 1 0) (sfAll (sfImp (sfMem 0 (suc 0)) sfLDomain)))) = (sfImp (sfCLOrdinalAt a) (sfImp (sfCLHierarchyAt a y) (sfAll (sfImp (sfMem 0 (suc y)) sfLDomain)))) $ = (named '(eqtr sfRename_sfImp (nsImp_eq (eqtr sfCLOrdinalAt_rename (sfCLOrdinalAteq sftvl_pair_one)) (eqtr sfRename_sfImp (nsImp_eq (eqtr sfCLHierarchyAt_rename (sfCLHierarchyAteq sftvl_pair_one sftvl_pair_zero)) (eqtr sfRename_sfAll (nsAll_eq (eqtr sfRename_sfImp (nsImp_eq (eqtr sfRename_sfMem (nsMem_eq sftvl_pair_bound sftvl_pair_lift)) (ax_mp sfRename_bound_identity sfLDomain_bound))))))))));

