pub theorem bb215ArithmeticFormulaPairCode_represents (E: set): $ bb215ArithmeticFormulaQFSat E bb215ArithmeticFormulaPairCode <-> E @ 2 = (E @ 0, E @ 1) $ = (named '(bitr bb215ArithmeticFormulaPairCode_satisfies bb215ArithmeticFormulaPairGraph_correct));

