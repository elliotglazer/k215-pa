pub theorem bb215ArithmeticFormulaPairGraph_double (a b: nat): $ 2 * (a, b) = (a + b) * suc (a + b) + 2 * b $ = (named '(eqtr muladd (addeq1 (muldiv3 prlem1))));

pub theorem bb215ArithmeticFormulaPairGraph_correct (a b p: nat): $ bb215ArithmeticFormulaPairGraph a b p <-> p = (a, b) $ = (named '(bitr (eqeq2 (eqcom bb215ArithmeticFormulaPairGraph_double)) (mulcan2 d2ne0)));

