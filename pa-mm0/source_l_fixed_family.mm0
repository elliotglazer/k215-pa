import "source_zfc_interpretation.mm0";

import "source_l_basic_images.mm0";

import "source_l_foundation.mm0";

import "source_l_extensionality.mm0";

def sfLRemainingFixedImages: wff = $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcEmpty) /\ (sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcPair) /\ (sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcUnion) /\ (sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcPower) /\ (sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcOmega) /\ (sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcChoice)))))) $;

theorem sfLFixedImages_from_remaining:
 $ sfTheoryProvable zfrAxioms sfLTransitivity -> sfLRemainingFixedImages -> sfZFCFixedImages zfrAxioms sfLDomain $;
