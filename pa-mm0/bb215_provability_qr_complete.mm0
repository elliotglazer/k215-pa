import "bb215_provability_qr_aux.mm0";

-- Q' completeness (lane L07): a valid trace p containing y gives the ranked set
-- {(k, entry at position len p - suc k) | k < len p}; premises of a row sit at larger positions.

theorem bb215ProvabilityQR_complete_body (a p y: nat) {k x y2 z: nat}: $ k215Derives p y /\ (A. x A. y2 (bb215ArithmeticFormulaFiniteCell (fst a) (snd a) (x, y2) <-> x < len p /\ y2 = (\ z, fst (bb215ArithmeticFormulaListDrop (len p - suc z) p - 1)) @ x)) -> bb215ProvabilityQROk (fst a) (snd a) /\ E. k (k <= snd a /\ bb215ProvabilityQKD (fst a) (snd a) k y) $;

theorem bb215ProvabilityQR_complete (p y: nat): $ k215Derives p y -> bb215ProvabilityQRGraph y $;

theorem bb215ProvabilityQR_complete_zero: $ k215Derives 0 0 -> bb215ProvabilityQRGraph 0 $;
