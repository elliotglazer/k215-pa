 (hxz: $ x != z $) (hux: $ u != x $) (heu: $ sqEnvAvoid E n u $):
 $ kSubst (kImp (kImp (kImp (kMem 1 u) (kImp (kMem u a) kF)) kF) (kImp (kExists w (kImp (kImp (kMem 1 w) (kImp (sfK0QRepRelation E 1 R u w phi) kF)) kF)) (kExists z (kImp (kImp (kMem 1 z) (kImp (kImp (kImp (kMem z c) (kImp (sfK0QRepRelation E 1 R u z phi) kF)) kF) kF)) kF)))) u x = (kImp (kImp (kImp (kMem 1 x) (kImp (kMem x a) kF)) kF) (kImp (kExists w (kImp (kImp (kMem 1 w) (kImp (sfK0QRepRelation E 1 R x w phi) kF)) kF)) (kExists z (kImp (kImp (kMem 1 z) (kImp (kImp (kImp (kMem z c) (kImp (sfK0QRepRelation E 1 R x z phi) kF)) kF) kF)) kF)))) $ =
'(eqtr kSubst_kImp (kImpeq (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kMem (kMemeq (ax_mp kReplace_miss (necom hu1)) kReplace_hit)) (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kMem (kMemeq kReplace_hit (ax_mp kReplace_miss (necom hua)))) (qsSubst_kF hu0))))) (qsSubst_kF hu0))) (eqtr kSubst_kImp (kImpeq (eqtr (ax_mp (qsSubst_kExists hu0) (necom huw)) (kExistseq2 (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kMem (kMemeq (ax_mp kReplace_miss (necom hu1)) (ax_mp kReplace_miss (necom huw)))) (eqtr kSubst_kImp (kImpeq (! sfK0QRepRelation_input_substitution $ E $ $ n $ $ 1 $ $ R $ $ u $ $ w $ $ x $ $ phi $ hf huR hu0 hu1 huw heu) (qsSubst_kF hu0))))) (qsSubst_kF hu0))))) (eqtr (ax_mp (qsSubst_kExists hu0) (necom huz)) (kExistseq2 (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kMem (kMemeq (ax_mp kReplace_miss (necom hu1)) (ax_mp kReplace_miss (necom huz)))) (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kImp (kImpeq (eqtr kSubst_kMem (kMemeq (ax_mp kReplace_miss (necom huz)) (ax_mp kReplace_miss (necom huc)))) (eqtr kSubst_kImp (kImpeq (! sfK0QRepRelation_input_substitution $ E $ $ n $ $ 1 $ $ R $ $ u $ $ z $ $ x $ $ phi $ hf huR hu0 hu1 huz heu) (qsSubst_kF hu0))))) (qsSubst_kF hu0))) (qsSubst_kF hu0))))) (qsSubst_kF hu0)))))))));

