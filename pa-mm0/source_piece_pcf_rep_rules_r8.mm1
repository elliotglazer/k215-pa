pub theorem sfPieceNumeral_suc_rule(G k x y:nat):
 $ nsLocal G (sfPieceNumeral k x) -> nsLocal G (sfPieceRepSuccessor x y) ->
   nsLocal G (sfPieceNumeral (suc k) y) $ =
 '(syl6
   (syl (bi2 (nsLocal_formula_eq sfPieceNumeral_suc))
    (syl (ax_mp nsLocal_ExI (ax_mp (ax_mp sfWf_and sfPieceNumeralCore_wf) sfPieceRepSuccessor_wf))
      (bi2 (nsLocal_formula_eq sfPieceNumeral_suc_instance))))
   sfLocal_and);
