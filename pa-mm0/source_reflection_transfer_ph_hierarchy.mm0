import "source_reflection_transfer_ph_producers.mm0";

import "source_reflection_transfer_merge_hierarchy.mm0";

theorem sfReflectionPH_exists_from_hierarchy(hE:$ sfTheoryProvable zfrAxioms sfLUniversalHierarchyExists $): $ sfTheoryProvable zfrAxioms (sfReflectionCondLevelExists sfLUniversalHierarchyRelation) $;

theorem sfReflectionPH_subset_from_hierarchy(hS:$ sfTheoryProvable zfrAxioms sfLPowerHierarchySubset $): $ sfTheoryProvable zfrAxioms (sfReflectionHierarchySubsetNormal sfLUniversalHierarchyRelation) $;

theorem sfReflectionPH_coverage_from_hierarchy(hE:$ sfTheoryProvable zfrAxioms sfLUniversalHierarchyExists $)(hL:$ sfTheoryProvable zfrAxioms (sfReflectionLimitLevelLimit sfLUniversalHierarchyRelation) $)(hM:$ sfTheoryProvable zfrAxioms (sfReflectionLimitLevelMono sfLUniversalHierarchyRelation) $): $ sfTheoryProvable zfrAxioms (sfReflectionLimitCoverageLaw sfLUniversalHierarchyRelation) $;

theorem sfReflectionPH3_from_hierarchy(T F:set)(start domain sb sc n i:nat)(hd:$ sfBound 1 domain $)(hv:$ sfPieceTableValid sb sc n $)(hi:$ i < n $)(hE:$ sfTheoryProvable zfrAxioms sfLUniversalHierarchyExists $)(hS:$ sfTheoryProvable zfrAxioms sfLPowerHierarchySubset $)(hL:$ sfTheoryProvable zfrAxioms (sfReflectionLimitLevelLimit sfLUniversalHierarchyRelation) $)(hM:$ sfTheoryProvable zfrAxioms (sfReflectionLimitLevelMono sfLUniversalHierarchyRelation) $): $ sfTheoryProvable zfrAxioms (sfReflectionPH3Law T start domain sfLUniversalHierarchyRelation sb sc n i) $;
