import "pa_source_interpretation_formula_eqd_support.mm0";

import "pa_axiom_syntax_base.mm0";

import "pa_formula_source_bound.mm0";

import "source_local_extra.mm0";

theorem paAxiomSource_Prop1 (a b: nat): $ sfWf a /\ sfWf b -> zfcProvable (sfImp (a) (sfImp (b) (a))) $;

theorem paAxiomSyntax_Prop1_image (n a b: nat): $ paFormulaBound n a /\ paFormulaBound n b -> zfcProvable (paFormulaSource (paAxiomProp1 a b)) $;

theorem paAxiomSource_Prop2 (a b d: nat): $ sfWf a /\ sfWf b /\ sfWf d -> zfcProvable (sfImp (sfImp (a) (sfImp (b) (d))) (sfImp (sfImp (a) (b)) (sfImp (a) (d)))) $;

theorem paAxiomSyntax_Prop2_image (n a b d: nat): $ paFormulaBound n a /\ paFormulaBound n b /\ paFormulaBound n d -> zfcProvable (paFormulaSource (paAxiomProp2 a b d)) $;

theorem paAxiomSource_Prop3 (a b: nat): $ sfWf a /\ sfWf b -> zfcProvable (sfImp (sfImp (sfImp (a) (sfBot)) (sfImp (b) (sfBot))) (sfImp (b) (a))) $;

theorem paAxiomSyntax_Prop3_image (n a b: nat): $ paFormulaBound n a /\ paFormulaBound n b -> zfcProvable (paFormulaSource (paAxiomProp3 a b)) $;

theorem paAxiomSource_FalseElim (a: nat): $ sfWf a -> zfcProvable (sfImp (sfBot) (a)) $;

theorem paAxiomSyntax_FalseElim_image (n a: nat): $ paFormulaBound n a -> zfcProvable (paFormulaSource (paAxiomFalseElim a)) $;

theorem paAxiomSource_AndLeft (a b: nat): $ sfWf a /\ sfWf b -> zfcProvable (sfImp (sfAnd (a) (b)) (a)) $;

theorem paAxiomSyntax_AndLeft_image (n a b: nat): $ paFormulaBound n a /\ paFormulaBound n b -> zfcProvable (paFormulaSource (paAxiomAndLeft a b)) $;

theorem paAxiomSource_AndRight (a b: nat): $ sfWf a /\ sfWf b -> zfcProvable (sfImp (sfAnd (a) (b)) (b)) $;

theorem paAxiomSyntax_AndRight_image (n a b: nat): $ paFormulaBound n a /\ paFormulaBound n b -> zfcProvable (paFormulaSource (paAxiomAndRight a b)) $;

theorem paAxiomSource_AndIntro (a b: nat): $ sfWf a /\ sfWf b -> zfcProvable (sfImp (a) (sfImp (b) (sfAnd (a) (b)))) $;

theorem paAxiomSyntax_AndIntro_image (n a b: nat): $ paFormulaBound n a /\ paFormulaBound n b -> zfcProvable (paFormulaSource (paAxiomAndIntro a b)) $;

theorem paAxiomSource_OrLeft (a b: nat): $ sfWf a /\ sfWf b -> zfcProvable (sfImp (a) (sfOr (a) (b))) $;

theorem paAxiomSyntax_OrLeft_image (n a b: nat): $ paFormulaBound n a /\ paFormulaBound n b -> zfcProvable (paFormulaSource (paAxiomOrLeft a b)) $;

theorem paAxiomSource_OrRight (a b: nat): $ sfWf a /\ sfWf b -> zfcProvable (sfImp (b) (sfOr (a) (b))) $;

theorem paAxiomSyntax_OrRight_image (n a b: nat): $ paFormulaBound n a /\ paFormulaBound n b -> zfcProvable (paFormulaSource (paAxiomOrRight a b)) $;

theorem paAxiomSource_OrElim (a b d: nat): $ sfWf a /\ sfWf b /\ sfWf d -> zfcProvable (sfImp (sfImp (a) (d)) (sfImp (sfImp (b) (d)) (sfImp (sfOr (a) (b)) (d)))) $;

theorem paAxiomSyntax_OrElim_image (n a b d: nat): $ paFormulaBound n a /\ paFormulaBound n b /\ paFormulaBound n d -> zfcProvable (paFormulaSource (paAxiomOrElim a b d)) $;
