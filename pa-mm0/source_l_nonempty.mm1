import "source_l_nonempty_slim1_replay.mm1";
import "source_l_nonempty_support.mm1";

pub theorem sfLNonempty_replay_context: $ srcLNEContext = sfLBackground $ = 'eqid;
pub theorem sfLNonempty_replay_formula: $ srcLNEFormula = sfEx sfLDomain $ = 'eqid;
pub theorem sfLNonempty_local: $ nsLocal sfLBackground (sfEx sfLDomain) $ =
'(mpbi (nsLocal_context_eq sfLNonempty_replay_context)
  (mpbi (nsLocal_formula_eq sfLNonempty_replay_formula) srcLNECertificate));
pub theorem sfLNonempty_zfr: $ sfTheoryProvable zfrAxioms (sfEx sfLDomain) $ =
'(ax_mp sfLNonempty_local_lift sfLNonempty_local);
