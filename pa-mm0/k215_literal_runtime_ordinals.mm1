theorem k215PDoubleStep (a: nat): $ suc (2 * a + 1) = 2 * suc a $ =
 '(eqtr (eqcom addS) (eqcom mulS));
pub theorem k215PDoubleGap (a b: nat) (h: $ a < b $): $ 2 * a + 1 < 2 * b $ =
 '(mpbir (leeq1 k215PDoubleStep) (lemul2a h));
pub theorem k215PDigitLt (a b c d: nat) (h: $ a < b $) (hc: $ c <= 1 $):
 $ 2 * a + c < 2 * b + d $ =
 '(ltletr (lelttr (mpbi leadd2 hc) (k215PDoubleGap h)) leaddid1);
pub theorem k215PDigitAdjacent (a: nat): $ 2 * a + 0 < 2 * a + 1 $ =
 '(mpbir (lteq add0 add12) ltsucid);


