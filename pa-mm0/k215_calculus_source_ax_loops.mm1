theorem k215Loop29Cycle1 (x y z c: nat): $ k215PIter 1 (k215Loop29State k215Num29 (suc x) y z c) = (k215Loop29State k215Num30 x y z c) $ = '(eqtr k215PIter_succ (eqtr (k215PStepeq k215PIter_zero) k215Loop29StepS));

theorem k215Loop29Cycle2 (x y z c: nat): $ k215PIter 2 (k215Loop29State k215Num29 (suc x) y z c) = (k215Loop29State k215Num31 x (suc y) z c) $ = '(eqtr k215PIter_succ (eqtr (k215PStepeq k215Loop29Cycle1) k215Loop29Step1));

theorem k215Loop29Cycle3 (x y z c: nat): $ k215PIter 3 (k215Loop29State k215Num29 (suc x) y z c) = (k215Loop29State k215Num29 x (suc y) z c) $ = '(eqtr k215PIter_succ (eqtr (k215PStepeq k215Loop29Cycle2) k215Loop29Back));

