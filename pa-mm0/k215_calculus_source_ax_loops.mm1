   (eqtrd k215Loop99At (a1i (k215Loop99Stateeq eqid eqid k215AXLoopFourShift eqid eqid))));
theorem k215Loop99All (x c: nat): $ k215Loop99Claim x c $ =
 (named @ induct '(ind) 'x '(ax_gen (ax_gen k215Loop99Base)) '(iald @ iald k215Loop99Inductive));
pub theorem k215Loop99Transfer (x y z c: nat): $ k215PIter (6 * x + 1) (k215Loop99State k215Num99 x y z c) = (k215Loop99State k215Num105 0 (4 * x + y) z c) $ =
 '(ax_mp k215Loop99At k215Loop99All);


theorem k215Loop99VectorIn (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215Loop99State k215Num99 a7 a1 a0 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = k215PState k215Num99 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8) $ = '(k215PStateeq2 (k215PVectoreq eqid eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector k215PR6_vector eqid k215PR8_vector));

theorem k215Loop99VectorOut (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215Loop99State k215Num105 0 (4 * a7 + a1) a0 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = k215PState k215Num105 (k215PVector a0 (4 * a7 + a1) a2 a3 a4 a5 a6 0 a8) $ = '(k215PStateeq2 (k215PVectoreq eqid eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector k215PR6_vector eqid k215PR8_vector));

pub theorem k215Loop99Vector (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ k215PIter (6 * a7 + 1) (k215PState k215Num99 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) =
   k215PState k215Num105 (k215PVector a0 (4 * a7 + a1) a2 a3 a4 a5 a6 0 a8) $ =
 '(eqtr (k215PItereq2 (eqcom k215Loop99VectorIn)) (eqtr k215Loop99Transfer k215Loop99VectorOut));

