import "k215_calculus_source_decode_loops.mm1";
import "k215_calculus_source_ax_lookups.mm1";

theorem k215AXLoopFourAdd (y: nat): $ 4 + y = suc (suc (suc (suc y))) $ = '(eqtr addS1 (suceq (eqtr addS1 (suceq (eqtr addS1 (suceq (eqtr addS1 (suceq add01))))))));

theorem k215AXLoopFourShift (x y: nat): $ 4 * x + suc (suc (suc (suc y))) = 4 * suc x + y $ =
 '(eqtr (addeq2 (eqcom k215AXLoopFourAdd))
   (eqtr (eqcom addass) (addeq1 (eqcom mulS))));


@_ def k215Loop26State (pc x y z c: nat): nat = $ k215PState pc (k215PVector z x (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) y (k215PR7 c) (k215PR8 c)) $;

do (apply (register-eqd 'k215Loop26State) '(k215Loop26Stateeqd));

theorem k215Loop26StepZ (y z c: nat): $ k215PStep (k215Loop26State k215Num26 0 y z c) = (k215Loop26State k215Num29 0 y z c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupExtraLoopsaxprefix_26) (ifeq (eqeq1 k215PGet1_vector) eqid eqid)) (ifpos eqid));

theorem k215Loop26StepS (x y z c: nat): $ k215PStep (k215Loop26State k215Num26 (suc x) y z c) = (k215Loop26State k215Num27 x y z c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupExtraLoopsaxprefix_26) (ifeq (eqeq1 k215PGet1_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet1_vector)) (eqtr k215PSet1_vector (k215PVectoreq2 (eqtr subSS sub02))))));

theorem k215Loop26Step1 (x y z c: nat): $ k215PStep (k215Loop26State k215Num27 x y z c) = (k215Loop26State k215Num28 x (suc y) z c) $ = '(eqtr (k215PAtCI k215PLookupExtraLoopsaxprefix_27) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet6_vector)) k215PSet6_vector)));

theorem k215Loop26Back (x y z c: nat): $ k215PStep (k215Loop26State k215Num28 x y z c) = (k215Loop26State k215Num26 x y z c) $ = '(k215PAtCC k215PLookupExtraLoopsaxprefix_28);

theorem k215Loop26Cycle1 (x y z c: nat): $ k215PIter 1 (k215Loop26State k215Num26 (suc x) y z c) = (k215Loop26State k215Num27 x y z c) $ = '(eqtr k215PIter_succ (eqtr (k215PStepeq k215PIter_zero) k215Loop26StepS));

theorem k215Loop26Cycle2 (x y z c: nat): $ k215PIter 2 (k215Loop26State k215Num26 (suc x) y z c) = (k215Loop26State k215Num28 x (suc y) z c) $ = '(eqtr k215PIter_succ (eqtr (k215PStepeq k215Loop26Cycle1) k215Loop26Step1));

theorem k215Loop26Cycle3 (x y z c: nat): $ k215PIter 3 (k215Loop26State k215Num26 (suc x) y z c) = (k215Loop26State k215Num26 x (suc y) z c) $ = '(eqtr k215PIter_succ (eqtr (k215PStepeq k215Loop26Cycle2) k215Loop26Back));

@_ abstract def k215Loop26Claim (x c: nat) (.y .z: nat): wff =
 $ A. y A. z k215PIter (3 * x + 1) (k215Loop26State k215Num26 x y z c) = (k215Loop26State k215Num29 0 (x + y) z c) $;
theorem k215Loop26At (x y z c: nat): $ k215Loop26Claim x c -> k215PIter (3 * x + 1) (k215Loop26State k215Num26 x y z c) = (k215Loop26State k215Num29 0 (x + y) z c) $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215Loop26Base (y z c: nat): $ k215PIter (3 * 0 + 1) (k215Loop26State k215Num26 0 y z c) = (k215Loop26State k215Num29 0 (0 + y) z c) $ =
 '(eqtr (k215PItereq1 (eqtr (addeq1 mul0) add01))
   (eqtr k215PIter_succ (eqtr (k215PStepeq k215PIter_zero)
     (eqtr k215Loop26StepZ (k215Loop26Stateeq eqid eqid (eqcom add01) eqid eqid)))));
theorem k215Loop26Inductive (x y z c: nat): $ k215Loop26Claim x c -> k215PIter (3 * suc x + 1) (k215Loop26State k215Num26 (suc x) y z c) = (k215Loop26State k215Num29 0 (suc x + y) z c) $ =
 '(eqtrd (a1i (eqtr (k215PItereq1 k215EqTime_succ)
     (eqtr k215PIter_add (k215PItereq2 k215Loop26Cycle3))))
   (eqtrd k215Loop26At (a1i (k215Loop26Stateeq eqid eqid (eqtr addS (eqcom addS1)) eqid eqid))));
theorem k215Loop26All (x c: nat): $ k215Loop26Claim x c $ =
 (named @ induct '(ind) 'x '(ax_gen (ax_gen k215Loop26Base)) '(iald @ iald k215Loop26Inductive));
pub theorem k215Loop26Transfer (x y z c: nat): $ k215PIter (3 * x + 1) (k215Loop26State k215Num26 x y z c) = (k215Loop26State k215Num29 0 (x + y) z c) $ =
 '(ax_mp k215Loop26At k215Loop26All);


theorem k215Loop26VectorIn (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215Loop26State k215Num26 a1 a6 a0 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = k215PState k215Num26 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8) $ = '(k215PStateeq2 (k215PVectoreq eqid eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid k215PR7_vector k215PR8_vector));

theorem k215Loop26VectorOut (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215Loop26State k215Num29 0 (a1 + a6) a0 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = k215PState k215Num29 (k215PVector a0 0 a2 a3 a4 a5 (a1 + a6) a7 a8) $ = '(k215PStateeq2 (k215PVectoreq eqid eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid k215PR7_vector k215PR8_vector));

pub theorem k215Loop26Vector (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ k215PIter (3 * a1 + 1) (k215PState k215Num26 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) =
   k215PState k215Num29 (k215PVector a0 0 a2 a3 a4 a5 (a1 + a6) a7 a8) $ =
 '(eqtr (k215PItereq2 (eqcom k215Loop26VectorIn)) (eqtr k215Loop26Transfer k215Loop26VectorOut));

@_ def k215Loop29State (pc x y z c: nat): nat = $ k215PState pc (k215PVector z y x (k215PR3 c) (k215PR4 c) (k215PR5 c) (k215PR6 c) (k215PR7 c) (k215PR8 c)) $;

