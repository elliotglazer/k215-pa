theorem k215UnpairAt4323AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt4323State k215PNum4323 0 b (suc n) c) (k215UnpairAt4323State k215PNum4323 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
