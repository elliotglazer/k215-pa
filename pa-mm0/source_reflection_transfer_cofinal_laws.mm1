pub theorem sfReflectionCofinalMergeLaw_use(G level K k X l Y:nat)(hl:$ sfBound 2 level $)(hM:$ nsLocal G (sfReflectionCofinalMergeLaw level K) $)(hk:$ nsLocal G (sfMem k K) $)(hX:$ nsLocal G (sfORBinary level k X) $)(hlK:$ nsLocal G (sfMem l K) $)(hY:$ nsLocal G (sfORBinary level l Y) $): $ nsLocal G (sfReflectionCofinalMergeAt level K X Y) $ = (named '(ax_mp (ax_mp nsLocal_mp (ax_mp (ax_mp nsLocal_mp (ax_mp (ax_mp nsLocal_mp (ax_mp (ax_mp nsLocal_mp (mpbi (nsLocal_formula_eq (eqtr (rfcl_mergebody_rename hl) (rfcl_mergebody_congr hl rfcl_four_tail rfcl_four_3 rfcl_four_2 rfcl_four_1 rfcl_four_0))) (ax_mp (rfcl_all_cons (rfcl_mergebody_wf hl)) (ax_mp (rfcl_all_cons (ax_mp sfWf_all (rfcl_mergebody_wf hl))) (ax_mp (rfcl_all_cons (ax_mp sfWf_all (ax_mp sfWf_all (rfcl_mergebody_wf hl)))) (ax_mp (rfcl_all_cons (ax_mp sfWf_all (ax_mp sfWf_all (ax_mp sfWf_all (rfcl_mergebody_wf hl))))) (mpbir (nsLocal_formula_eq (ax_mp sfRename_identity (ax_mp sfWf_all (ax_mp sfWf_all (ax_mp sfWf_all (ax_mp sfWf_all (rfcl_mergebody_wf hl))))))) hM))))))) hk)) hX)) hlK)) hY));
