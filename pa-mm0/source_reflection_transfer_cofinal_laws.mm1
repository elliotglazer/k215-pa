pub theorem sfReflectionCofinalMergeLaw_rename(R:set)(level K:nat)(hl:$ sfBound 2 level $): $ sfRename R 0 (sfReflectionCofinalMergeLaw level K) = sfReflectionCofinalMergeLaw level (R @ K) $ = (named '(eqtr sfRename_sfAll (nsAll_eq (eqtr sfRename_sfAll (nsAll_eq (eqtr sfRename_sfAll (nsAll_eq (eqtr sfRename_sfAll (nsAll_eq (eqtr (ax_mp sfRename_as_map (rfcl_mergebody_wf hl)) (eqtr (rfcl_mergebody_rename hl) (rfcl_mergebody_congr hl rfcl_depth4_tail rfcl_depth4_3 rfcl_depth4_2 rfcl_depth4_1 rfcl_depth4_0))))))))))));

theorem rfcl_mergelaw_congr(level K KP:nat)(hl:$ sfBound 2 level $)(hK:$ K = KP $): $ sfReflectionCofinalMergeLaw level K = sfReflectionCofinalMergeLaw level KP $ = (named '(nsAll_eq (nsAll_eq (nsAll_eq (nsAll_eq (rfcl_mergebody_congr hl (suceq (suceq (suceq (suceq hK)))) eqid eqid eqid eqid))))));

pub theorem sfReflectionCofinalMergeLaw_shift(level K:nat)(hl:$ sfBound 2 level $): $ sfShift 0 (sfReflectionCofinalMergeLaw level K) = sfReflectionCofinalMergeLaw level (suc K) $ = (named '(eqtr (eqcom (ax_mp sfRename_successor (ax_mp sfWf_all (ax_mp sfWf_all (ax_mp sfWf_all (ax_mp sfWf_all (rfcl_mergebody_wf hl))))))) (eqtr (sfReflectionCofinalMergeLaw_rename hl) (rfcl_mergelaw_congr hl sfSuccessorMap_value))));

theorem rfcl_all_cons(E:set)(G t a:nat)(ha:$ sfWf a $): $ nsLocal G (sfRename E 0 (sfAll a)) -> nsLocal G (sfRename (sqEnvCons t E) 0 a) $ = (named '(syl (bi1 (nsLocal_formula_eq (sfReflectionTransfer_open ha))) (syl nsLocal_AllE (bi1 (nsLocal_formula_eq sfRename_sfAll)))));

def sfReflectionCofinalFour(k X l Y:nat):set = $ sqEnvCons Y (sqEnvCons l (sqEnvCons X (sqEnvCons k sfIdentityMap))) $;

theorem rfcl_four_0(k X l Y:nat): $ sfReflectionCofinalFour k X l Y @ 0 = Y $ = (named 'sqEnvCons_zero);

theorem rfcl_four_1(k X l Y:nat): $ sfReflectionCofinalFour k X l Y @ 1 = l $ = (named '(eqtr sqEnvCons_suc sqEnvCons_zero));

