theorem slUERel0: $ sfRelativize sfLDomain slUEF0 = slUEF0 $ = 'sfRelativize_sfMem;

theorem slUERel1: $ sfRelativize sfLDomain slUEF1 = slUEF1 $ = 'sfRelativize_sfMem;

theorem slUERel2: $ sfRelativize sfLDomain slUEF2 = slUEF2 $ = 'sfRelativize_sfMem;

theorem slUERel3: $ sfRelativize sfLDomain slUEF3 = slUEF3 $ = '(eqtr sfRelativize_sfAnd (nsAnd_eq slUERel1 slUERel2));

theorem slUERel4: $ sfRelativize sfLDomain slUEF4 = slUEF6 $ = '(eqtr sfRelativize_sfEx (nsEx_eq (nsAnd_eq eqid slUERel3)));

theorem slUERel5: $ sfRelativize sfLDomain slUEF7 = slUEF8 $ = '(eqtr sfRelativize_sfImp (nsImp_eq slUERel0 slUERel4));

theorem slUERel6: $ sfRelativize sfLDomain slUEF1 = slUEF1 $ = 'sfRelativize_sfMem;

