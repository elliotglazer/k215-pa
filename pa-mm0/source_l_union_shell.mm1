theorem slUERel13: $ sfRelativize sfLDomain slUEF13 = slUEF15 $ = '(eqtr sfRelativize_sfAll (nsAll_eq (nsImp_eq eqid slUERel12)));

theorem slUERel14: $ sfRelativize sfLDomain slUEF16 = slUEF18 $ = '(eqtr sfRelativize_sfEx (nsEx_eq (nsAnd_eq eqid slUERel13)));

theorem slUERel15: $ sfRelativize sfLDomain zfcUnion = slUFF2703 $ = '(eqtr sfRelativize_sfAll (nsAll_eq (nsImp_eq eqid slUERel14)));

@_ def sfLUnionNextLevel: nat = $ slUFF807 $;

pub theorem sfLUnionShell_context: $ slUFContext = sfLBackground $ = 'eqid;

pub theorem sfLUnionShell_formula: $ slUFFormula = sfImp sfLStageTrans (sfImp sfLDefUnion (sfImp sfLUnionNextLevel (sfRelativize sfLDomain zfcUnion))) $ = '(nsImp_eq eqid (nsImp_eq eqid (nsImp_eq eqid (eqcom slUERel15))));

pub theorem sfLUnionShell_local: $ nsLocal sfLBackground (sfImp sfLStageTrans (sfImp sfLDefUnion (sfImp sfLUnionNextLevel (sfRelativize sfLDomain zfcUnion)))) $ = '(mpbi (nsLocal_context_eq sfLUnionShell_context) (mpbi (nsLocal_formula_eq sfLUnionShell_formula) slUFCertificate));

pub theorem sfLUnionShell_zfr: $ sfTheoryProvable zfrAxioms (sfImp sfLStageTrans (sfImp sfLDefUnion (sfImp sfLUnionNextLevel (sfRelativize sfLDomain zfcUnion)))) $ = '(ax_mp (sfTheory_local sfLBackground_zfr) sfLUnionShell_local);

pub theorem sfLUnion_from_next: $ sfTheoryProvable zfrAxioms sfLUnionNextLevel -> sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcUnion) $ = '(ax_mp sfTheoryProvable_mp (ax_mp (ax_mp sfTheoryProvable_mp (ax_mp (ax_mp sfTheoryProvable_mp sfLUnionShell_zfr) sfLWeakStageTrans_zfr)) sfLDefUnion_zfr));
