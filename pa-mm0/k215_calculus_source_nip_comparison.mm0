import "k215_calculus_source_decode_loops.mm0";
import "k215_calculus_source_nip_lookups.mm0";

def k215CalEqN10: nat = $ suc 9 $;

def k215CalEqN11: nat = $ suc k215CalEqN10 $;

def k215PEq4726Location (pc: nat): nat = $ if (pc = 0) k215PNum4726 (if (pc = 1) k215PNum4727 (if (pc = 2) k215PNum4728 (if (pc = 3) k215PNum4729 (if (pc = 4) k215PNum4730 (if (pc = 5) k215PNum4731 (if (pc = 6) k215PNum4732 (if (pc = 7) k215PNum4733 (if (pc = 8) k215PNum4734 (if (pc = 9) k215PNum4735 (if (pc = k215CalEqN10) k215PNum4736 (k215PNum4737))))))))))) $;

def k215PEq4726State (pc x y z: nat): nat = $ k215PState (k215PEq4726Location pc) (k215PVector (k215PR0 z) (k215PR1 z) (k215PR2 z) (k215PR3 z) (k215PR4 z) x y (k215PR7 z) (k215PR8 z)) $;

theorem k215PEq4726ClearX (x z: nat): $ k215PIter (2 * x + 3) (k215PEq4726State 5 x 0 z) = (k215PEq4726State k215CalEqN11 0 0 z) $;

theorem k215PEq4726ClearY (y z: nat): $ k215PIter (3 * y + 3) (k215PEq4726State 5 0 y z) = (k215PEq4726State k215CalEqN11 0 0 z) $;

theorem k215PEq4726Equal (x z: nat): $ k215PIter (3 * x + 2) (k215PEq4726State 0 x x z) = (k215PEq4726State k215CalEqN10 0 0 z) $;

theorem k215PEq4726GreaterX (x y z: nat): $ k215PIter (3 * y + (3 + (2 * x + 3))) (k215PEq4726State 0 (suc x + y) y z) = (k215PEq4726State k215CalEqN11 0 0 z) $;

theorem k215PEq4726GreaterY (x y z: nat): $ k215PIter (3 * x + (2 + (3 * y + 3))) (k215PEq4726State 0 x (suc y + x) z) = (k215PEq4726State k215CalEqN11 0 0 z) $;

def k215PEq4726Done (a b z out: nat) (.n: nat): wff =
 $ E. n k215PIter n (k215PEq4726State 0 a b z) = k215PEq4726State out 0 0 z $;

theorem k215PEq4726Done_all (a b z: nat): $ k215PEq4726Done a b z (if (a = b) k215CalEqN10 k215CalEqN11) $;

theorem k215Comparison4726Equal (u t w c d a b r v: nat): $ a = b -> k215PReach (k215PState k215PNum4726 (k215PVector u t w c d a b r v)) (k215PState k215PNum4736 (k215PVector u t w c d 0 0 r v)) $;

theorem k215Comparison4726Different (u t w c d a b r v: nat): $ a != b -> k215PReach (k215PState k215PNum4726 (k215PVector u t w c d a b r v)) (k215PState k215PNum4737 (k215PVector u t w c d 0 0 r v)) $;
