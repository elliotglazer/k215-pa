import "b4_zfc_join.mm0";

theorem bdRuleI_In (m v B i g a b c d: nat): $ g = bdtIn -> bdRIn m v i a b -> bdZfcRule m v B i g a b c d $;
theorem bdRuleI_Sub (m v B i g a b c d: nat): $ g = bdtSub -> bdRSub m v i a b -> bdZfcRule m v B i g a b c d $;
theorem bdRuleI_Wf (m v B i g a b c d: nat): $ g = bdtWf -> bdRWf m v i a -> bdZfcRule m v B i g a b c d $;
theorem bdRuleI_Cwf (m v B i g a b c d: nat): $ g = bdtCwf -> bdRCwf m v i a -> bdZfcRule m v B i g a b c d $;
theorem bdRuleI_Row (m v B i g a b c d: nat): $ g = bdtRow -> bdRRow m v i a -> bdZfcRule m v B i g a b c d $;
theorem bdRuleI_Bnd (m v B i g a b c d: nat): $ g = bdtBnd -> bdRBnd m v i a b -> bdZfcRule m v B i g a b c d $;
theorem bdRuleI_Shift (m v B i g a b c d: nat): $ g = bdtShift -> bdRShift m v i a b c -> bdZfcRule m v B i g a b c d $;
theorem bdRuleI_Subst (m v B i g a b c d: nat): $ g = bdtSubst -> bdRSubst m v i a b c d -> bdZfcRule m v B i g a b c d $;
theorem bdRuleI_Ren (m v B i g a b c d: nat): $ g = bdtRen -> bdRRen m v i a b c d -> bdZfcRule m v B i g a b c d $;
theorem bdRuleI_AllPre (m v B i g a b c d: nat): $ g = bdtAllPre -> bdRAllPre m v i a b c -> bdZfcRule m v B i g a b c d $;
theorem bdRuleI_CShift (m v B i g a b c d: nat): $ g = bdtCShift -> bdRCShift m v i a b -> bdZfcRule m v B i g a b c d $;
theorem bdRuleI_Ax (m v B i g a b c d: nat): $ g = bdtAx -> bdRAx m v B i a -> bdZfcRule m v B i g a b c d $;
theorem bdRuleI_Cax (m v B i g a b c d: nat): $ g = bdtCax -> bdRCax m v i a -> bdZfcRule m v B i g a b c d $;
theorem bdRuleI_Valid (m v B i g a b c d: nat): $ g = bdtValid -> bdRValid m v B i a -> bdZfcRule m v B i g a b c d $;
theorem RI_In_hd (m v i a w: nat): $ bdRIn m v i a (a : w) $;
theorem RI_In_tl (m v i a u w: nat): $ bdHas m v i bdtIn a w 0 0 -> bdRIn m v i a (u : w) $;
theorem CI_In_hd (a w: nat): $ bdCertF bdtIn a (a : w) 0 0 $;
theorem CI_In_tl (a u w: nat): $ bdCertF bdtIn a w 0 0 -> bdCertF bdtIn a (u : w) 0 0 $;
theorem RI_Sub_nil (m v i h: nat): $ bdRSub m v i 0 h $;
theorem RI_Sub_cons (m v i p q h: nat): $ bdHas m v i bdtIn p h 0 0 /\ bdHas m v i bdtSub q h 0 0 -> bdRSub m v i (p : q) h $;
theorem CI_Sub_nil (h: nat): $ bdCertF bdtSub 0 h 0 0 $;
theorem CI_Sub_cons (p q h: nat): $ bdCertF bdtIn p h 0 0 -> bdCertF bdtSub q h 0 0 -> bdCertF bdtSub (p : q) h 0 0 $;
theorem RI_Wf_0 (m v i: nat): $ bdRWf m v i 0 $;
theorem CI_Wf_0: $ bdCertF bdtWf 0 0 0 0 $;
theorem RI_Wf_sfMem (m v i p q: nat): $ bdRWf m v i (sfMem p q) $;
theorem CI_Wf_sfMem (p q: nat): $ bdCertF bdtWf (sfMem p q) 0 0 0 $;
theorem RI_Wf_sfEq (m v i p q: nat): $ bdRWf m v i (sfEq p q) $;
theorem CI_Wf_sfEq (p q: nat): $ bdCertF bdtWf (sfEq p q) 0 0 0 $;
theorem RI_Wf_sfAnd (m v i p q: nat): $ bdHas m v i bdtWf p 0 0 0 /\ bdHas m v i bdtWf q 0 0 0 -> bdRWf m v i (sfAnd p q) $;
theorem CI_Wf_sfAnd (p q: nat): $ bdCertF bdtWf p 0 0 0 -> bdCertF bdtWf q 0 0 0 -> bdCertF bdtWf (sfAnd p q) 0 0 0 $;
theorem RI_Wf_sfOr (m v i p q: nat): $ bdHas m v i bdtWf p 0 0 0 /\ bdHas m v i bdtWf q 0 0 0 -> bdRWf m v i (sfOr p q) $;
theorem CI_Wf_sfOr (p q: nat): $ bdCertF bdtWf p 0 0 0 -> bdCertF bdtWf q 0 0 0 -> bdCertF bdtWf (sfOr p q) 0 0 0 $;
theorem RI_Wf_sfImp (m v i p q: nat): $ bdHas m v i bdtWf p 0 0 0 /\ bdHas m v i bdtWf q 0 0 0 -> bdRWf m v i (sfImp p q) $;
theorem CI_Wf_sfImp (p q: nat): $ bdCertF bdtWf p 0 0 0 -> bdCertF bdtWf q 0 0 0 -> bdCertF bdtWf (sfImp p q) 0 0 0 $;
theorem RI_Wf_sfAll (m v i p: nat): $ bdHas m v i bdtWf p 0 0 0 -> bdRWf m v i (sfAll p) $;
theorem CI_Wf_sfAll (p: nat): $ bdCertF bdtWf p 0 0 0 -> bdCertF bdtWf (sfAll p) 0 0 0 $;
theorem RI_Wf_sfEx (m v i p: nat): $ bdHas m v i bdtWf p 0 0 0 -> bdRWf m v i (sfEx p) $;
theorem CI_Wf_sfEx (p: nat): $ bdCertF bdtWf p 0 0 0 -> bdCertF bdtWf (sfEx p) 0 0 0 $;
theorem RI_Cwf_nil (m v i: nat): $ bdRCwf m v i 0 $;
theorem RI_Cwf_cons (m v i p q: nat): $ bdHas m v i bdtWf p 0 0 0 /\ bdHas m v i bdtCwf q 0 0 0 -> bdRCwf m v i (p : q) $;
theorem CI_Cwf_nil: $ bdCertF bdtCwf 0 0 0 0 $;
theorem CI_Cwf_cons (p q: nat): $ bdCertF bdtWf p 0 0 0 -> bdCertF bdtCwf q 0 0 0 -> bdCertF bdtCwf (p : q) 0 0 0 $;
theorem RI_Row_seq (m v i p q: nat): $ bdHas m v i bdtCwf p 0 0 0 /\ bdHas m v i bdtWf q 0 0 0 -> bdRRow m v i (sfSequent p q) $;
theorem RI_Row_br (m v i p q s w: nat): $ bdHas m v i bdtCwf p 0 0 0 /\ bdHas m v i bdtWf q 0 0 0 /\ bdHas m v i bdtWf s 0 0 0 /\ bdHas m v i bdtWf w 0 0 0 -> bdRRow m v i (sfBranches p q s w) $;
theorem CI_Row_seq (p q: nat): $ bdCertF bdtCwf p 0 0 0 -> bdCertF bdtWf q 0 0 0 -> bdCertF bdtRow (sfSequent p q) 0 0 0 $;
theorem CI_Row_br (p q s w: nat): $ bdCertF bdtCwf p 0 0 0 -> bdCertF bdtWf q 0 0 0 -> bdCertF bdtWf s 0 0 0 -> bdCertF bdtWf w 0 0 0 -> bdCertF bdtRow (sfBranches p q s w) 0 0 0 $;
theorem RI_Bnd_0 (m v i n: nat): $ bdRBnd m v i n 0 $;
theorem CI_Bnd_0 (n: nat): $ bdCertF bdtBnd n 0 0 0 $;
theorem RI_Bnd_sfMem (m v i n p q: nat): $ p < n /\ q < n -> bdRBnd m v i n (sfMem p q) $;
theorem CI_Bnd_sfMem (n p q: nat): $ p < n -> q < n -> bdCertF bdtBnd n (sfMem p q) 0 0 $;
theorem RI_Bnd_sfEq (m v i n p q: nat): $ p < n /\ q < n -> bdRBnd m v i n (sfEq p q) $;
theorem CI_Bnd_sfEq (n p q: nat): $ p < n -> q < n -> bdCertF bdtBnd n (sfEq p q) 0 0 $;
theorem RI_Bnd_sfAnd (m v i n p q: nat): $ bdHas m v i bdtBnd n p 0 0 /\ bdHas m v i bdtBnd n q 0 0 -> bdRBnd m v i n (sfAnd p q) $;
theorem CI_Bnd_sfAnd (n p q: nat): $ bdCertF bdtBnd n p 0 0 -> bdCertF bdtBnd n q 0 0 -> bdCertF bdtBnd n (sfAnd p q) 0 0 $;
theorem RI_Bnd_sfOr (m v i n p q: nat): $ bdHas m v i bdtBnd n p 0 0 /\ bdHas m v i bdtBnd n q 0 0 -> bdRBnd m v i n (sfOr p q) $;
theorem CI_Bnd_sfOr (n p q: nat): $ bdCertF bdtBnd n p 0 0 -> bdCertF bdtBnd n q 0 0 -> bdCertF bdtBnd n (sfOr p q) 0 0 $;
theorem RI_Bnd_sfImp (m v i n p q: nat): $ bdHas m v i bdtBnd n p 0 0 /\ bdHas m v i bdtBnd n q 0 0 -> bdRBnd m v i n (sfImp p q) $;
theorem CI_Bnd_sfImp (n p q: nat): $ bdCertF bdtBnd n p 0 0 -> bdCertF bdtBnd n q 0 0 -> bdCertF bdtBnd n (sfImp p q) 0 0 $;
theorem RI_Bnd_sfAll (m v i n p: nat): $ bdHas m v i bdtBnd (suc n) p 0 0 -> bdRBnd m v i n (sfAll p) $;
theorem CI_Bnd_sfAll (n p: nat): $ bdCertF bdtBnd (suc n) p 0 0 -> bdCertF bdtBnd n (sfAll p) 0 0 $;
theorem RI_Bnd_sfEx (m v i n p: nat): $ bdHas m v i bdtBnd (suc n) p 0 0 -> bdRBnd m v i n (sfEx p) $;
theorem CI_Bnd_sfEx (n p: nat): $ bdCertF bdtBnd (suc n) p 0 0 -> bdCertF bdtBnd n (sfEx p) 0 0 $;
theorem RI_AP_0 (m v i c: nat): $ bdRAllPre m v i 0 c c $;
theorem RI_AP_suc (m v i p c q: nat): $ bdHas m v i bdtAllPre p c q 0 -> bdRAllPre m v i (suc p) c (sfAll q) $;
theorem CI_AP_0 (c: nat): $ bdCertF bdtAllPre 0 c c 0 $;
theorem CI_AP_suc (p c q: nat): $ bdCertF bdtAllPre p c q 0 -> bdCertF bdtAllPre (suc p) c (sfAll q) 0 $;
theorem RI_CS_nil (m v i: nat): $ bdRCShift m v i 0 0 $;
theorem RI_CS_cons (m v i p q r s: nat): $ bdHas m v i bdtShift 0 p r 0 /\ bdHas m v i bdtCShift q s 0 0 -> bdRCShift m v i (p : q) (r : s) $;
theorem CI_CS_nil: $ bdCertF bdtCShift 0 0 0 0 $;
theorem CI_CS_cons (p q r s: nat): $ bdCertF bdtShift 0 p r 0 -> bdCertF bdtCShift q s 0 0 -> bdCertF bdtCShift (p : q) (r : s) 0 0 $;
theorem RI_Cax_nil (m v i: nat): $ bdRCax m v i 0 $;
theorem RI_Cax_cons (m v i p q: nat): $ bdHas m v i bdtAx p 0 0 0 /\ bdHas m v i bdtCax q 0 0 0 -> bdRCax m v i (p : q) $;
theorem CI_Cax_nil: $ bdCertF bdtCax 0 0 0 0 $;
theorem CI_Cax_cons (p q: nat): $ bdCertF bdtAx p 0 0 0 -> bdCertF bdtCax q 0 0 0 -> bdCertF bdtCax (p : q) 0 0 0 $;
