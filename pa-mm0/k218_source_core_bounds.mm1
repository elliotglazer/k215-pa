import "k218_source_core.mm1";
import "zfc_schemas.mm1";


theorem sfK218If_upper (P: wff) (a b c: nat)
 (ha: $ a <= c $) (hb: $ b <= c $): $ if P a b <= c $ =
'(cases (mpbird (leeq1d ifpos) (a1i ha))
        (mpbird (leeq1d ifneg) (a1i hb)));

theorem sfK218Rename_zero_bound (R: set) (b c phi: nat)
 (hm: $ A. i (i < b -> R @ i < c) $) (hf: $ sfBound b phi $):
 $ sfBound c (sfRename R 0 phi) $ =
'(mpbi (sfBoundeq1 add01)
  (ax_mp (ax_mp sfRename_bound hm) (mpbir (sfBoundeq1 add01) hf)));

pub theorem sfK218RequestMap_upper (i: nat): $ sfK218RequestMap @ i <= i + 1 $ =
'(mpbir (leeq1 sfK218RequestMap_value) (sfK218If_upper le01 (mpbir (leeq2 add12) leid)));

pub theorem sfK218RequestMap_bound (n i: nat): $ i < (suc (suc n)) -> sfK218RequestMap @ i < (suc (suc (suc n))) $ =
'(syl (bi1 (lteq2 (eqtr addS (suceq add0)))) (syl (lelttr sfK218RequestMap_upper) (bi1 ltadd1)));

theorem sfK218RequestMap_range (n: nat): $ A. i (i < (suc (suc n)) -> sfK218RequestMap @ i < (suc (suc (suc n)))) $ =
(named '(ax_gen {sfK218RequestMap_bound : $ i < (suc (suc n)) -> sfK218RequestMap @ i < (suc (suc (suc n))) $}));

pub theorem sfK218SupportMap_upper (i: nat): $ sfK218SupportMap @ i <= i + 2 $ =
