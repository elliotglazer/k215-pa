pub theorem sfTV_enum_outer(D level G n c:nat)(hd:$ sfBound 1 D $)(hg:$ sfContextWf G $)(hb:$ sfBound n c $)(he:$ nsLocal G zfcRefl $)(hf:$ nsLocal G (sfTVFunctionRowLawConjunction D level (sfTVEnumRows D) (sfTVEnumLength (n + c) c)) $)(hp:$ nsLocal G (sfReflectionLimitProfile level (sfPieceFunctionBinary D (sfReflectionPCLevel level) (sfTVEnumRows D) (sfTVEnumLength (n + c) c))) $)(hL:$ nsLocal G (sfORBinary level 0 3) $)(hy:$ nsLocal G (sfAll (sfImp (sfMem 0 4) D)) $): $ nsLocal G (sfCLBall n 3 (sfIff (sfRelativize D c) (sfCLSetRel (3 + n) c))) $ = (named '(sfTV_outer_from_rows hd hg leid leid hb he (sfTVEnumRows_inputs hf hp hL) hy));

pub theorem sfTV_enum_outer_from_context(D level G n c:nat)(hd:$ sfBound 1 D $)(hg:$ sfContextWf G $)(hb:$ sfBound n c $)(he:$ nsLocal G zfcRefl $)(hl:$ sfBound 2 level $)(hs:$ sfContextSub (sfReflectionPHProducerContext level) G $)(hp:$ nsLocal G (sfReflectionLimitProfile level (sfPieceFunctionBinary D (sfReflectionPCLevel level) (sfTVEnumRows D) (sfTVEnumLength (n + c) c))) $)(hL:$ nsLocal G (sfORBinary level 0 3) $)(hy:$ nsLocal G (sfAll (sfImp (sfMem 0 4) D)) $): $ nsLocal G (sfCLBall n 3 (sfIff (sfRelativize D c) (sfCLSetRel (3 + n) c))) $ = (named '(sfTV_enum_outer hd hg hb he (ax_mp (ax_mp nsLocal_weaken hg) hs (sfTVFunctionRowLawConjunction_local hd hl (sfTVEnumFunction_valid hd))) hp hL hy));
