import "pa_source_interpretation_term_numerals.mm0";

import "pa_formula_substitution_bound.mm0";

theorem bb215ArithmeticSentenceNumeral_rename (R: set) (b: nat): $ paTermRename R (paTermNumeral b) = paTermNumeral b $;

theorem bb215ArithmeticSentenceNumeral_lift (d b: nat): $ paTermLift d (paTermNumeral b) = paTermNumeral b $;

theorem bb215ArithmeticSentenceNumeral_subst (d a b: nat): $ paTermSubst d a (paTermNumeral b) = paTermNumeral b $;
