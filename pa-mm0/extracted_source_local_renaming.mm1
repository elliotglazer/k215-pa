import "zfc_irreflexive.mm1";
import "source_nd_renaming.mm1";

theorem exLocalRename_row (R: set) (d G a p: nat):
  $ sfNDFullDerives p (sfRenameRow R d (sfSequent G a)) ->
    nsLocal (sfContextRename R d G) (sfRename R d a) $ =
'(syl nsLocal_intro
  (mpbid (sfNR_Full_congr eqidd (a1i sfRenameRow_sequent)) id));

theorem exLocalRename_exists (R: set) (d G a: nat):
  $ sfNDRenameExists R d (sfSequent G a) ->
    nsLocal (sfContextRename R d G) (sfRename R d a) $ =
(named '(eex exLocalRename_row));

pub theorem exLocalRename (R: set) (d G a: nat):
  $ nsLocal G a ->
    nsLocal (sfContextRename R d G) (sfRename R d a) $ =
(named '(eex @ syl exLocalRename_exists sfNDFullDerives_rename));
