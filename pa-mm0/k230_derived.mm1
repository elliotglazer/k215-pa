pub theorem kAnd_left (a b: nat):
  $ kProvable (kAnd a b) -> kProvable a $ =
'(mpi kPropAndLeft kProvable_mp);

pub theorem kAnd_right (a b: nat):
  $ kProvable (kAnd a b) -> kProvable b $ =
'(mpi kPropAndRight kProvable_mp);

pub theorem kAnd_intro (a b: nat):
  $ kProvable a -> kProvable b -> kProvable (kAnd a b) $ =
'(syl (com12 kProvable_mp) (mpi kPropAndIntro kProvable_mp));

pub theorem kBundle_core (a b c: nat):
  $ c != a /\ c != b -> kProvable (k230 a b c) $ =
'(syl kAnd_left (syl kProvable_axiom kAxioms_bundle));

pub theorem kBundle_vacuity (a b c: nat):
  $ c != a /\ c != b -> kProvable (kVacuity a b c) $ =
'(syl kAnd_right (syl kProvable_axiom kAxioms_bundle));

