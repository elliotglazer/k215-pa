-- Exact numerical calculi; no literal-machine claim is made here.
import "k215_calculus_forward.mm0";
import "k215_rho8_recovery.mm0";

theorem k215Cal_replacement_closed: $ k218Closed k215Theorems $;
theorem k215Cal_Derives_reverse (p a: nat):
  $ k218Derives p a -> k215Provable a $;
theorem k215Cal_Provable_reverse (a: nat):
  $ k218Provable a -> k215Provable a $;
theorem k215Cal_Provable_iff (a: nat):
  $ k215Provable a <-> k218Provable a $;
theorem k215Cal_Inconsistent_reverse:
  $ k218Inconsistent -> k215Inconsistent $;
theorem k215Cal_Inconsistent_iff:
  $ k215Inconsistent <-> k218Inconsistent $;
