import "bb215_table_arithmetic_depth_twelve_sat.mm0";

import "pa_source_interpretation_nat_term_assignment.mm0";

def bb215ArithmeticFormulaDepthThirteenSatBody (E: set) (c h .x: nat): wff = $ ifp (c = 0) (0 != 0) (ifp (sfTag c = 1) (bb215ArithmeticFormulaTermValue E (sfLeft c) = bb215ArithmeticFormulaTermValue E (sfRight c)) (ifp (sfTag c = 3) (sfLeft c e. h /\ sfRight c e. h) (ifp (sfTag c = 4) (sfLeft c e. h \/ sfRight c e. h) (ifp (sfTag c = 5) (sfLeft c e. h -> sfRight c e. h) (ifp (sfTag c = 6 /\ sfRight c = 0) (A. x bb215TableArithmeticDepthTwelveSat (paNatTermConsEnvironment E x) (sfLeft c)) (ifp (sfTag c = 7 /\ sfRight c = 0) (E. x bb215TableArithmeticDepthTwelveSat (paNatTermConsEnvironment E x) (sfLeft c)) (0 != 0))))))) $;

def bb215ArithmeticFormulaDepthThirteenSatStep (E: set) (.c .h: nat): set = $ S\ c, {h | bb215ArithmeticFormulaDepthThirteenSatBody E c h} $;

def bb215ArithmeticFormulaDepthThirteenSat (E: set) (c: nat): wff = $ srecp (bb215ArithmeticFormulaDepthThirteenSatStep E) c $;

def bb215ArithmeticFormulaDepthThirteenSatPrevious (E: set) (c .i: nat): nat = $ sep (upto c) {i | srecp (bb215ArithmeticFormulaDepthThirteenSatStep E) i} $;

theorem bb215ArithmeticFormulaDepthThirteenSatStep_value (E: set) (c h: nat): $ (c, h) e. bb215ArithmeticFormulaDepthThirteenSatStep E <-> bb215ArithmeticFormulaDepthThirteenSatBody E c h $;

theorem bb215ArithmeticFormulaDepthThirteenSatPrevious_value (E: set) (c a: nat): $ a e. bb215ArithmeticFormulaDepthThirteenSatPrevious E c <-> a < c /\ bb215ArithmeticFormulaDepthThirteenSat E a $;

theorem bb215ArithmeticFormulaDepthThirteenSat_unfold (E: set) (c: nat): $ bb215ArithmeticFormulaDepthThirteenSat E c <-> bb215ArithmeticFormulaDepthThirteenSatBody E c (bb215ArithmeticFormulaDepthThirteenSatPrevious E c) $;

theorem bb215ArithmeticFormulaDepthThirteenSat_false (E: set): $ bb215ArithmeticFormulaDepthThirteenSat E paFormulaFalse <-> 0 != 0 $;

theorem bb215ArithmeticFormulaDepthThirteenSat_equal (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthThirteenSat E (paFormulaEqual a b) <-> bb215ArithmeticFormulaTermValue E a = bb215ArithmeticFormulaTermValue E b $;

theorem bb215ArithmeticFormulaDepthThirteenSat_and (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthThirteenSat E (paFormulaAnd a b) <-> (bb215ArithmeticFormulaDepthThirteenSat E a /\ bb215ArithmeticFormulaDepthThirteenSat E b) $;

theorem bb215ArithmeticFormulaDepthThirteenSat_or (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthThirteenSat E (paFormulaOr a b) <-> (bb215ArithmeticFormulaDepthThirteenSat E a \/ bb215ArithmeticFormulaDepthThirteenSat E b) $;

theorem bb215ArithmeticFormulaDepthThirteenSat_imp (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthThirteenSat E (paFormulaImp a b) <-> (bb215ArithmeticFormulaDepthThirteenSat E a -> bb215ArithmeticFormulaDepthThirteenSat E b) $;

theorem bb215ArithmeticFormulaDepthThirteenSat_all (E: set) (a: nat) {x: nat}: $ bb215ArithmeticFormulaDepthThirteenSat E (paFormulaAll a) <-> A. x bb215TableArithmeticDepthTwelveSat (paNatTermConsEnvironment E x) a $;

theorem bb215ArithmeticFormulaDepthThirteenSat_ex (E: set) (a: nat) {x: nat}: $ bb215ArithmeticFormulaDepthThirteenSat E (paFormulaEx a) <-> E. x bb215TableArithmeticDepthTwelveSat (paNatTermConsEnvironment E x) a $;
