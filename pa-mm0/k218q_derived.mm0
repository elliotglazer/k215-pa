-- Interpreted raw-code logical replay. The only global predicate is
-- k218QProvable(c) = k218Provable(k218Translate(c)); no core image is assumed.
import "k218q_propositional.mm0";

-- Finite Hilbert derivations of derived rules in the actual K calculus.
-- The generated certificate is independently checked against these statements.

theorem k218IPropI (a: nat):
  $ k218QProvable (kImp a a) $;

theorem k218IPropF (a: nat):
  $ k218QProvable (kImp kF a) $;

theorem k218IPropDNE (a: nat):
  $ k218QProvable (kImp (kImp (kImp a kF) kF) a) $;

theorem k218IPropAndLeft (a b: nat):
  $ k218QProvable (kImp (kImp (kImp a (kImp b kF)) kF) a) $;

theorem k218IPropAndRight (a b: nat):
  $ k218QProvable (kImp (kImp (kImp a (kImp b kF)) kF) b) $;

theorem k218IPropAndIntro (a b: nat):
  $ k218QProvable (kImp a (kImp b (kImp (kImp a (kImp b kF)) kF))) $;

theorem k218IPropB3 (a b: nat):
  $ k218QProvable (kImp a (kImp (kImp a kF) b)) $;

theorem k218IAnd_left (a b: nat):
  $ k218QProvable (kAnd a b) -> k218QProvable a $;

theorem k218IAnd_right (a b: nat):
  $ k218QProvable (kAnd a b) -> k218QProvable b $;

theorem k218IAnd_intro (a b: nat):
  $ k218QProvable a -> k218QProvable b -> k218QProvable (kAnd a b) $;

