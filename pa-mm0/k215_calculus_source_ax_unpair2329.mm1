theorem k215UnpairAt2329Reach9S (a b n c: nat): $ k215PReach (k215UnpairAt2329State k215PNum2329 a b (suc n) c) (k215UnpairAt2329State k215PNum2330 a b n c) $ = '(k215PReach_step k215UnpairAt2329Step9S);

theorem k215UnpairAt2329Step10 (a b n c: nat): $ k215PStep (k215UnpairAt2329State k215PNum2330 a b n c) = (k215UnpairAt2329State k215PNum2331 a (suc b) n c) $ = '(eqtr (k215PAtCI k215PLookupUnpair2329_2330) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215UnpairAt2329Reach10 (a b n c: nat): $ k215PReach (k215UnpairAt2329State k215PNum2330 a b n c) (k215UnpairAt2329State k215PNum2331 a (suc b) n c) $ = '(k215PReach_step k215UnpairAt2329Step10);

theorem k215UnpairAt2329Step11Z (b n c: nat): $ k215PStep (k215UnpairAt2329State k215PNum2331 0 b n c) = (k215UnpairAt2329State k215PNum2333 0 b n c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair2329_2331) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

