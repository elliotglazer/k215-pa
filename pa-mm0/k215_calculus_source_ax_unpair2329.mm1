pub theorem k215UnpairMacro2329_clean (n c: nat): $ k215PReach (k215UnpairAt2329State k215PNum2329 0 0 n c) (k215UnpairAt2329State k215PNum2337 (fst n) (snd n) 0 c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt2329Stateeq eqid
   (fsteq (eqtr (addeq1 pr0) add01))
   (sndeq (eqtr (addeq1 pr0) add01)) eqid eqid)) k215UnpairMacro2329);


