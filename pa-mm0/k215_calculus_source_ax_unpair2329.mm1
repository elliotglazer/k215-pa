theorem k215UnpairAt2329Step12 (a b n c: nat): $ k215PStep (k215UnpairAt2329State k215PNum2332 a b n c) = (k215UnpairAt2329State k215PNum2336 a b n c) $ = '(k215PAtCB k215PLookupUnpair2329_2332);

theorem k215UnpairAt2329Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt2329State k215PNum2332 a b n c) (k215UnpairAt2329State k215PNum2336 a b n c) $ = '(k215PReach_step k215UnpairAt2329Step12);

theorem k215UnpairAt2329Step16 (a b n c: nat): $ k215PStep (k215UnpairAt2329State k215PNum2336 a b n c) = (k215UnpairAt2329State k215PNum2329 a b n c) $ = '(k215PAtCC k215PLookupUnpair2329_2336);

theorem k215UnpairAt2329Reach16 (a b n c: nat): $ k215PReach (k215UnpairAt2329State k215PNum2336 a b n c) (k215UnpairAt2329State k215PNum2329 a b n c) $ = '(k215PReach_step k215UnpairAt2329Step16);

theorem k215UnpairAt2329CycleZero (b n c: nat): $ k215PReach (k215UnpairAt2329State k215PNum2329 0 b (suc n) c) (k215UnpairAt2329State k215PNum2329 (suc b) 0 n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt2329Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2329Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2329Reach11Z) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2329ReachTransfer) k215UnpairAt2329Reach16))));
theorem k215UnpairAt2329CycleSucc (a b n c: nat): $ k215PReach (k215UnpairAt2329State k215PNum2329 (suc a) b (suc n) c) (k215UnpairAt2329State k215PNum2329 a (suc b) n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt2329Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2329Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2329Reach11S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2329Reach12) k215UnpairAt2329Reach16))));


theorem k215UnpairAt2329AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt2329State k215PNum2329 0 b (suc n) c) (k215UnpairAt2329State k215PNum2329 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt2329Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215PairDiagonal_rotate)) (eqtr (eqcom sndpr) (sndeq k215PairDiagonal_rotate)) eqid eqid)) k215UnpairAt2329CycleZero);

