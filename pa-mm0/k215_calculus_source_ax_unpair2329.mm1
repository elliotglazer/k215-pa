pub theorem k215UnpairAt2329Advance (a b n c: nat): $ k215PReach (k215UnpairAt2329State k215PNum2329 a b (suc n) c) (k215UnpairAt2329State k215PNum2329 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
