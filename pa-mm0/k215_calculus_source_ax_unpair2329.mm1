@_ abstract def k215UnpairAt2329Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt2329State k215PNum2329 a b n c) (k215UnpairAt2329State k215PNum2337 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
theorem k215UnpairAt2329RunZero (a b c: nat): $ k215UnpairAt2329Run 0 a b c $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt2329Stateeq eqid
     (eqcom (eqtr (fsteq add0) fstpr))
     (eqcom (eqtr (sndeq add0) sndpr)) eqid eqid)) k215UnpairAt2329Reach9Z);
@_ abstract def k215UnpairAt2329Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt2329Run n a b c $;
theorem k215UnpairAt2329Claim_at (n a b c: nat): $ k215UnpairAt2329Claim n c -> k215UnpairAt2329Run n a b c $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215UnpairAt2329CodeStep (a b n: nat): $ (fst (suc (a, b)), snd (suc (a, b))) + n = (a, b) + suc n $ =
 '(eqtr (addeq1 fstsnd) addSass);
theorem k215UnpairAt2329RunInductive (n a b c: nat): $ k215UnpairAt2329Claim n c -> k215UnpairAt2329Run (suc n) a b c $ =
 '(syl (ax_mp k215PReach_trans k215UnpairAt2329Advance)
   (mpbid (a1i (k215PReacheq2 (k215UnpairAt2329Stateeq eqid
     (fsteq k215UnpairAt2329CodeStep) (sndeq k215UnpairAt2329CodeStep) eqid eqid))) k215UnpairAt2329Claim_at));
theorem k215UnpairAt2329Claim_all (n c: nat): $ k215UnpairAt2329Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt2329RunZero)) '(iald @ iald k215UnpairAt2329RunInductive));
pub theorem k215UnpairMacro2329 (n a b c: nat): $ k215PReach (k215UnpairAt2329State k215PNum2329 a b n c) (k215UnpairAt2329State k215PNum2337 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
