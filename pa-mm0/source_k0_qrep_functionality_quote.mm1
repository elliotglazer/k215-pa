pub theorem sfK0QRep_functionality_quote (E: set) (n t k phi: nat):
 $ sfBound (suc (suc n)) phi -> sqQuote E t k 0 (sfFunctionality (sfRename sfRepAMap 0 phi) (sfRename sfRepBMap 0 phi)) = sfK0QRepCanonicalFunctional E t k phi $ =
 (named '(eqtrd (a1i (ax_mp sqQuote_all_cons (ax_mp sfWf_all (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfRename_wf) (ax_mp (ax_mp sfWf_imp sfRename_wf) sfWf_eq)))))) (kAlleq2d (kImpeq2d (eqtrd (a1i (ax_mp sqQuote_all_cons (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfRename_wf) (ax_mp (ax_mp sfWf_imp sfRename_wf) sfWf_eq))))) (kAlleq2d (kImpeq2d (eqtrd (a1i (ax_mp sqQuote_all_cons (ax_mp (ax_mp sfWf_imp sfRename_wf) (ax_mp (ax_mp sfWf_imp sfRename_wf) sfWf_eq)))) (kAlleq2d (kImpeq2d (eqtrd (a1i sqQuote_sfImp) (kImpeqd sfK0QRepQuote_A (eqtrd (a1i sqQuote_sfImp) (kImpeqd sfK0QRepQuote_B (a1i (eqtr sqQuote_sfEq (sqEqualeq eqid (eqtr sfNamedIndex_zero (eqtr sqEnvCons_suc sqEnvCons_zero)) (eqtr sfNamedIndex_zero sqEnvCons_zero) add0)))))))))))))))));
