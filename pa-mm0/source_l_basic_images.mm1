import "source_domain_fixed.mm1";
import "source_l_domain.mm1";

pub theorem sfLRefl_zfr: $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcRefl) $ =
'(ax_mp (ax_mp sfTheoryProvable_mono zfcCoreAxioms_subset_zfr)
  (sfDomainRefl_core sfLDomain_wf));
pub theorem sfLSym_zfr: $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcSym) $ =
'(ax_mp (ax_mp sfTheoryProvable_mono zfcCoreAxioms_subset_zfr)
  (sfDomainSym_core sfLDomain_wf));
pub theorem sfLTrans_zfr: $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcTrans) $ =
'(ax_mp (ax_mp sfTheoryProvable_mono zfcCoreAxioms_subset_zfr)
  (sfDomainTrans_core sfLDomain_wf));
pub theorem sfLEqElem_zfr: $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcEqElem) $ =
'(ax_mp (ax_mp sfTheoryProvable_mono zfcCoreAxioms_subset_zfr)
  (sfDomainEqElem_core sfLDomain_wf));

pub theorem sfLEqualityFixed_image (a: nat):
 $ sfDomainEqualityFixed a -> sfTheoryProvable zfrAxioms (sfRelativize sfLDomain a) $ =
'(syl (ax_mp sfTheoryProvable_mono zfcCoreAxioms_subset_zfr)
  (sfDomainEqualityFixed_image sfLDomain_wf));
