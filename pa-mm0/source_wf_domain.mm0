import "source_bounds.mm0";

-- The relational well-founded-set domain; no Foundation axiom is used.

def sfWFNode0: nat = $ sfMem 0 1 $;

def sfWFNode1: nat = $ sfMem 0 2 $;

def sfWFNode2: nat = $ sfImp sfWFNode0 sfWFNode1 $;

def sfWFNode3: nat = $ sfAll sfWFNode2 $;

def sfWFNode4: nat = $ sfImp sfWFNode0 sfWFNode3 $;

def sfWFNode5: nat = $ sfAll sfWFNode4 $;

def sfWFNode6: nat = $ sfEx sfWFNode0 $;

def sfWFNode7: nat = $ sfBot $;

def sfWFNode8: nat = $ sfImp sfWFNode1 sfWFNode7 $;

def sfWFNode9: nat = $ sfImp sfWFNode0 sfWFNode8 $;

def sfWFNode10: nat = $ sfAll sfWFNode9 $;

def sfWFNode11: nat = $ sfAnd sfWFNode0 sfWFNode10 $;

def sfWFNode12: nat = $ sfEx sfWFNode11 $;

def sfWFNode13: nat = $ sfImp sfWFNode6 sfWFNode12 $;

def sfWFNode14: nat = $ sfImp sfWFNode3 sfWFNode13 $;

def sfWFNode15: nat = $ sfAll sfWFNode14 $;

def sfWFNode16: nat = $ sfAnd sfWFNode5 sfWFNode15 $;

def sfWFNode17: nat = $ sfMem 1 0 $;

def sfWFNode18: nat = $ sfAnd sfWFNode16 sfWFNode17 $;

def sfWFNode19: nat = $ sfEx sfWFNode18 $;

def sfWFDomain: nat = $ sfWFNode19 $;

theorem sfWFDomain_bound: $ sfBound 1 sfWFDomain $;

theorem sfWFDomain_wf: $ sfWf sfWFDomain $;
