import "source_k0_qrep_functionality_quote.mm0";

def sfK0QRepCanonicalOutput (E: set) (t k phi: nat): nat = $ (kAll k (kImp (kMem t k) (kExists (suc k) (kAnd (kMem t (suc k)) (kAll (suc (suc k)) (kImp (kMem t (suc (suc k))) (kAnd (kImp (sqMember t (suc (suc k)) (suc k) (suc (suc (suc k)))) (kExists (suc (suc (suc k))) (kAnd (kMem t (suc (suc (suc k)))) (kAnd (sqMember t (suc (suc (suc k))) k (suc (suc (suc (suc k))))) (sfK0QRepRelation E t (suc (suc (suc (suc k)))) (suc (suc (suc k))) (suc (suc k)) phi))))) (kImp (kExists (suc (suc (suc k))) (kAnd (kMem t (suc (suc (suc k)))) (kAnd (sqMember t (suc (suc (suc k))) k (suc (suc (suc (suc k))))) (sfK0QRepRelation E t (suc (suc (suc (suc k)))) (suc (suc (suc k))) (suc (suc k)) phi)))) (sqMember t (suc (suc k)) (suc k) (suc (suc (suc k)))))))))))) $;

theorem sfK0QRep_output_quote (E: set) (n t k phi: nat):
 $ sfBound (suc (suc n)) phi -> sqQuote E t k 0 (sfAll (sfEx (sfAll (sfIff (sfMem 0 1) (sfEx (sfAnd (sfMem 0 3) (sfRename sfRepCMap 0 phi))))))) = sfK0QRepCanonicalOutput E t k phi $;

theorem sfK0QRep_schema_quote (E: set) (n t k phi: nat):
 $ sfBound (suc (suc n)) phi -> sqQuote E t k 0 (sfReplacement (sfRename sfRepAMap 0 phi) (sfRename sfRepBMap 0 phi) (sfRename sfRepCMap 0 phi)) = kImp (sfK0QRepCanonicalFunctional E t k phi) (sfK0QRepCanonicalOutput E t k phi) $;
