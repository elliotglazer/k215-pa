import "k215_literal_runtime_reach.mm0";
import "k215_calculus_source_decode_lookups.mm0";

def k215Loop2State (pc x y z c: nat): nat = $ k215PState pc (k215PVector x (k215PR1 c) (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) z (k215PR7 c) y) $;

def k215Loop2Claim (x c: nat) (.y .z: nat): wff =
 $ A. y A. z k215PIter (4 * x + 1) (k215Loop2State 2 x y z c) = (k215Loop2State 6 0 (x + y) (x + z) c) $;

theorem k215Loop2Transfer (x y z c: nat): $ k215PIter (4 * x + 1) (k215Loop2State 2 x y z c) = (k215Loop2State 6 0 (x + y) (x + z) c) $;

theorem k215Loop2Vector (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ k215PIter (4 * a0 + 1) (k215PState 2 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) =
   k215PState 6 (k215PVector 0 a1 a2 a3 a4 a5 (a0 + a6) a7 (a0 + a8)) $;

def k215Loop13State (pc x y z c: nat): nat = $ k215PState pc (k215PVector z (k215PR1 c) (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) y x (k215PR8 c)) $;

def k215Loop13Claim (x c: nat) (.y .z: nat): wff =
 $ A. y A. z k215PIter (3 * x + 1) (k215Loop13State k215Num13 x y z c) = (k215Loop13State k215Num16 0 (x + y) z c) $;

theorem k215Loop13Transfer (x y z c: nat): $ k215PIter (3 * x + 1) (k215Loop13State k215Num13 x y z c) = (k215Loop13State k215Num16 0 (x + y) z c) $;

theorem k215Loop13Vector (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ k215PIter (3 * a7 + 1) (k215PState k215Num13 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) =
   k215PState k215Num16 (k215PVector a0 a1 a2 a3 a4 a5 (a7 + a6) 0 a8) $;

def k215Loop17State (pc x y z c: nat): nat = $ k215PState pc (k215PVector z (k215PR1 c) (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) (k215PR6 c) x y) $;

def k215Loop17Claim (x c: nat) (.y .z: nat): wff =
 $ A. y A. z k215PIter (3 * x + 1) (k215Loop17State k215Num17 x y z c) = (k215Loop17State k215Num20 0 (x + y) z c) $;

theorem k215Loop17Transfer (x y z c: nat): $ k215PIter (3 * x + 1) (k215Loop17State k215Num17 x y z c) = (k215Loop17State k215Num20 0 (x + y) z c) $;

theorem k215Loop17Vector (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ k215PIter (3 * a7 + 1) (k215PState k215Num17 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) =
   k215PState k215Num20 (k215PVector a0 a1 a2 a3 a4 a5 a6 0 (a7 + a8)) $;

def k215Loop20State (pc x y z c: nat): nat = $ k215PState pc (k215PVector z (k215PR1 c) (k215PR2 c) y (k215PR4 c) (k215PR5 c) x (k215PR7 c) (k215PR8 c)) $;

def k215Loop20Claim (x c: nat) (.y .z: nat): wff =
 $ A. y A. z k215PIter (3 * x + 1) (k215Loop20State k215Num20 x y z c) = (k215Loop20State k215Num23 0 (x + y) z c) $;

theorem k215Loop20Transfer (x y z c: nat): $ k215PIter (3 * x + 1) (k215Loop20State k215Num20 x y z c) = (k215Loop20State k215Num23 0 (x + y) z c) $;

theorem k215Loop20Vector (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ k215PIter (3 * a6 + 1) (k215PState k215Num20 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) =
   k215PState k215Num23 (k215PVector a0 a1 a2 (a6 + a3) a4 a5 0 a7 a8) $;
