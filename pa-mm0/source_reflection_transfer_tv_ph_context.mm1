import "source_reflection_transfer_tv_role_maps.mm1";

theorem sftvpc_sub_step(A:set)(G0 G y n:nat)(ht:$ sfTheoryClosed A $)(h0:$ sfTheoryContext A G0 $)(hg:$ sfContextWf G $): $ sfContextSub G0 (sfTVBallContext G y n) -> sfContextSub G0 (sfTVBallContext G y (suc n)) $ = (named '(syl (bi2 (trud (sfContextSub_congr_target (a1i sfTVBallContext_suc)))) (syl (ax_mp (com12 sfContextSub_trans) sfContextSub_cons) (syl (bi1 (trud (sfContextSub_congr (a1i (ax_mp (ax_mp sfTheoryContext_rename_identity ht) h0)) (a1i (ax_mp sfSepContext_successor (sfTVBallContext_wf hg)))))) sfContextRename_sub))));

pub theorem sfTVBallContext_axioms_sub(A:set)(G0 G y n:nat)(ht:$ sfTheoryClosed A $)(h0:$ sfTheoryContext A G0 $)(hg:$ sfContextWf G $)(hs:$ sfContextSub G0 G $): $ sfContextSub G0 (sfTVBallContext G y n) $ = (named @ induct '(ind) 'n '(mpbir (trud (sfContextSub_congr_target (a1i sfTVBallContext_zero))) hs) '(sftvpc_sub_step ht h0 hg));

def sfTVPHPoint(D L P k matrix:nat):nat = $ sfImp (sfReflectionLimitProfile L P) (sfImp (sfORBinary L 0 3) (sfImp (sfReflectionTuple sfIdentityMap 4 3 k) (sfReflectionTupleEw sfIdentityMap 4 D matrix 3))) $;

def sfTVPHPointLift(D L P n k matrix:nat):nat = $ sfImp (sfTVLift n (sfReflectionLimitProfile L P)) (sfImp (sfTVLift n (sfORBinary L 0 3)) (sfImp (sfReflectionTuple sfIdentityMap 0 (3 + n) k) (sfReflectionEwAt D matrix (3 + n)))) $;

pub theorem sfTVPHPoint_normalize(D L P n k matrix:nat)(hd:$ sfBound 1 D $)(hl:$ sfBound 2 L $)(hp:$ sfBound 2 P $)(hm:$ sfWf matrix $): $ sfRename (sfTVRoleMap n) 0 (sfTVPHPoint D L P k matrix) = sfTVPHPointLift D L P n k matrix $ = (named '(eqtr sfRename_sfImp (nsImp_eq (sfTVRoleMap_small (ax_mp (ax_mp sfBound_mono_le (ltlei (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S))))) (sfReflectionLimitProfile_bound hl hp))) (eqtr sfRename_sfImp (nsImp_eq (sfTVRoleMap_small (sfORBinary_bound hl lt01S (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S))))) (eqtr sfRename_sfImp (nsImp_eq (eqtr sfTVRoleMap_tuple (sfReflectionTupleeq3 addcom)) (eqtr (sfReflectionEwAt_rename hd) (nsImp_eq (nsEx_eq (nsAnd_eq eqid (sfTVRoleMap_matrix hm))) (nsEx_eq (nsAnd_eq (nsMem_eq eqid (suceq (eqtr (sfTVRoleMap_low (mpbi ltsuc (mpbi ltsuc (mpbi ltsuc lt01S)))) addcom))) (sfTVRoleMap_matrix hm))))))))))));

pub theorem sfTVPHPoint_in_context(A:set)(D L P n k matrix G0 G y:nat)(ht:$ sfTheoryClosed A $)(h0:$ sfTheoryContext A G0 $)(hg:$ sfContextWf G $)(hs:$ sfContextSub G0 G $)(hd:$ sfBound 1 D $)(hl:$ sfBound 2 L $)(hp:$ sfBound 2 P $)(hm:$ sfWf matrix $)(hPH:$ nsLocal G0 (sfTVPHPoint D L P k matrix) $): $ nsLocal (sfTVBallContext G y n) (sfTVPHPointLift D L P n k matrix) $ = (named '(mpbi (nsLocal_formula_eq (sfTVPHPoint_normalize hd hl hp hm)) (ax_mp (ax_mp (ax_mp nsLocal_weaken (sfTVBallContext_wf hg)) (sfTVBallContext_axioms_sub ht h0 hg hs)) (mpbi (nsLocal_context_eq (ax_mp (ax_mp sfTheoryContext_rename_identity ht) h0)) (ax_mp sfSepLocal_rename hPH)))));
