import "k215_literal_runtime_registers.mm1";
import "k215_literal_dispatch.mm1";

@_ def k215PFile (regs w rest: nat): nat = $ ((k215PR2 regs) : ((k215PR8 regs) : ((k215PR1 regs) : ((k215PR4 regs) : ((k215PR3 regs) : ((k215PR7 regs) : ((k215PR0 regs) : ((k215PR5 regs) : ((k215PR6 regs) : (w : rest)))))))))) $;

@_ def k215PFrame (g pc regs w rest: nat): nat =
 $ k215TmDispatchState (k215PEPath (k215PLookup pc))
   (g + (k215Num64 - len (k215PEPath (k215PLookup pc))))
   (k215PFile regs w rest) $;
@_ def k215PConfigFrame (g s w rest: nat): nat =
 $ k215PFrame g (k215PPC s) (k215PRegs s) w rest $;


do (apply (register-eqd 'k215PFile) '(k215PFileeqd));

do (apply (register-eqd 'k215PFrame) '(k215PFrameeqd));

do (apply (register-eqd 'k215PConfigFrame) '(k215PConfigFrameeqd));

do (apply (register-eqd 'k215TmDispatchState) '(k215TmDispatchStateeqd));

pub theorem k215PFile_vector (a0 a1 a2 a3 a4 a5 a6 a7 a8 w rest: nat): $ k215PFile (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8) w rest = (a2 : (a8 : (a1 : (a4 : (a3 : (a7 : (a0 : (a5 : (a6 : (w : rest)))))))))) $ = '(conseq k215PR2_vector (conseq k215PR8_vector (conseq k215PR1_vector (conseq k215PR4_vector (conseq k215PR3_vector (conseq k215PR7_vector (conseq k215PR0_vector (conseq k215PR5_vector (conseq k215PR6_vector eqid)))))))));

pub theorem k215PFrame_lookup (g pc regs w rest p tag arg zero positive: nat)
 (h: $ k215PLookup pc = k215PEntry p tag arg zero positive $):
 $ k215PFrame g pc regs w rest =
   k215TmDispatchState p (g + (k215Num64 - len p)) (k215PFile regs w rest) $ =
 '(k215TmDispatchStateeq (eqtr (fsteq h) fstpr) (addeq2 (subeq2 (leneq (eqtr (fsteq h) fstpr)))) eqid);
pub theorem k215PConfigFrame_state (g pc regs w rest: nat):
 $ k215PConfigFrame g (k215PState pc regs) w rest = k215PFrame g pc regs w rest $ =
 '(k215PFrameeq eqid k215PPC_state k215PRegs_state eqid eqid);
pub theorem k215PFrame_Q (g pc regs w rest: nat):
 $ k215TMQ (k215PFrame g pc regs w rest) = k215Num83 $ = 'k215TmDispatchState_Q;


