import "source_reflection_transfer_tv_reflection.mm0";

def sfTVReflectionContext(level:nat):nat = $ zfcRefl : (sfReflectionPHProducerContext level) $;

theorem sfTVReflectionContext_closed(level:nat)(hl:$ sfBound 2 level $): $ sfTheoryContext sfClosedFormulaClass (sfTVReflectionContext level) $;

theorem sfTVReflection_from_profile_local(n c:nat)(hb:$ sfBound n c $): $ nsLocal (sfTVReflectionContext sfLUniversalHierarchyRelation) (sfImp (sfReflectionLimitProfile sfLUniversalHierarchyRelation (sfTVCanonicalPiece n c)) (sfCLReflection sfLDomain n c 0)) $;

theorem sfTVReflectionContext_zfr(level:nat)(hl:$ sfBound 2 level $)(hE:$ sfTheoryProvable zfrAxioms (sfReflectionCondLevelExists level) $)(hS:$ sfTheoryProvable zfrAxioms (sfReflectionHierarchySubsetNormal level) $)(hC:$ sfTheoryProvable zfrAxioms (sfReflectionLimitCoverageLaw level) $): $ sfTheoryContext (sfTheoryProofClass zfrAxioms) (sfTVReflectionContext level) $;

theorem sfTVReflection_from_profile_zfr(n c:nat)(hb:$ sfBound n c $)(hE:$ sfTheoryProvable zfrAxioms (sfReflectionCondLevelExists sfLUniversalHierarchyRelation) $)(hS:$ sfTheoryProvable zfrAxioms (sfReflectionHierarchySubsetNormal sfLUniversalHierarchyRelation) $)(hC:$ sfTheoryProvable zfrAxioms (sfReflectionLimitCoverageLaw sfLUniversalHierarchyRelation) $): $ sfTheoryProvable zfrAxioms (sfImp (sfReflectionLimitProfile sfLUniversalHierarchyRelation (sfTVCanonicalPiece n c)) (sfCLReflection sfLDomain n c 0)) $;
