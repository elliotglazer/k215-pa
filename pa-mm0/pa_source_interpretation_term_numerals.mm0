import "pa_source_interpretation_term_source.mm0";

import "pa_source_interpretation_numerals.mm0";

def paTermNumeral (n .a: nat): nat = $ rec paTermZero (\ a, paTermSuccessor a) n $;

theorem paTermNumeral_zero: $ paTermNumeral 0 = paTermZero $;

theorem paTermNumeral_succ (n: nat): $ paTermNumeral (suc n) = paTermSuccessor (paTermNumeral n) $;

theorem paTermNumeral_bound (n: nat): $ paTermBound 0 (paTermNumeral n) $;

theorem paTermNumeral_source_graph (n: nat): $ paTermSource (paTermNumeral n) = paSourceNumeralGraph n $;

theorem paTermNumeral_source (n: nat): $ paTermSource (paTermNumeral n) = bb215SFNumeral n $;

theorem paTermNumeral_source_instance (n a: nat): $ sfEx (sfAnd (paTermSource (paTermNumeral n)) a) = bb215SFNumeralInstance n a $;
