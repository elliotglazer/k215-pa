import "source_l_clstage_k2.mm1";
import "source_l_clstage_op5.mm1";
import "source_l_replacement_definability_from_parts.mm1";

pub theorem sfLCoreDefinabilityLaw_from_rep(m psi:nat)(hb:$ sfBound (suc m) psi $)
 (hR:$ sfTheoryProvable zfrAxioms (sfLRepLaw m psi) $):
 $ sfTheoryProvable zfrAxioms (sfLCoreDefinabilityLaw m psi) $ =
 '(sfLCoreDefinabilityLaw_from_parts hb hR sfLEnvLaw_zfr sfLOp5Law_zfr);

pub theorem sfLReplacementDefinableLaw_from_rep(m psi:nat)(hb:$ sfBound (suc m) psi $)
 (hR:$ sfTheoryProvable zfrAxioms (sfLRepLaw m psi) $)
 (hL:$ sfTheoryProvable zfrAxioms sfLNextLevelLaw $):
 $ sfTheoryProvable zfrAxioms (sfLReplacementDefinableLaw m psi) $ =
 '(sfLReplacementDefinableLaw_from_parts hb hR sfLEnvLaw_zfr sfLOp5Law_zfr hL);

pub theorem sfLDefPowerLiteral_from_rep
 (hR:$ sfTheoryProvable zfrAxioms (sfLRepLaw 1 sfLPowerSubsetFormula) $):
 $ sfTheoryProvable zfrAxioms sfLDefPowerLiteral $ =
 '(sfLDefPowerLiteral_from_parts hR sfLEnvLaw_zfr sfLOp5Law_zfr);
