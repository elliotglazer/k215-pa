import "source_reflection_transfer_tv_requirements.mm0";

import "source_reflection_transfer_tv_logic.mm0";

def sfTVInductionClass(D:nat)(.c .g .y:nat):set = $ {c | A. g A. y (sfContextWf g -> nsLocal g (sfTVRequirements D y c) -> nsLocal g (sfAll (sfImp (sfMem 0 (suc y)) D)) -> nsLocal g (sfIff (sfRelativize D c) (sfCLSetRel y c)))} $;

theorem sfTVContainment_shift(D y:nat)(hd:$ sfBound 1 D $): $ sfShift 0 (sfAll (sfImp (sfMem 0 (suc y)) D)) = sfAll (sfImp (sfMem 0 (suc (suc y))) D) $;

theorem sfTV_uniform(D c G y:nat)(hd:$ sfBound 1 D $)(hf:$ sfWf c $)(hg:$ sfContextWf G $)(hw:$ nsLocal G (sfTVRequirements D y c) $)(hc:$ nsLocal G (sfAll (sfImp (sfMem 0 (suc y)) D)) $): $ nsLocal G (sfIff (sfRelativize D c) (sfCLSetRel y c)) $;
