pub theorem sqAtomEnvironment_0 (t x y: nat): $ sqAtomEnvironment t x y @ 0 = t $ =
(named '(eqtr (!! applame j ,eqtac) (ifpos eqid)));

pub theorem sqAtomEnvironment_1 (t x y: nat): $ sqAtomEnvironment t x y @ 1 = x $ =
(named '(eqtr (!! applame j ,eqtac) (eqtr (ifneg (ltneri lt01S)) (ifpos eqid))));

pub theorem sqAtomEnvironment_2 (t x y: nat): $ sqAtomEnvironment t x y @ 2 = y $ =
(named '(eqtr (!! applame j ,eqtac) (eqtr (ifneg (ltneri lt01S)) (ifneg (ltneri (mpbi ltsuc lt01S))))));

pub theorem sqEqual_positive (t x y k: nat): $ 0 < sqEqual t x y k $ = '(ax_mp sfNamedTemplate_positive sqEqualSource_wf);

pub theorem sqMember_positive (t x y k: nat): $ 0 < sqMember t x y k $ = '(ax_mp sfNamedTemplate_positive sqMemberSource_wf);
