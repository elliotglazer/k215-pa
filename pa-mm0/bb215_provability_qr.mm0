import "bb215_provability_qr_code.mm0";

import "bb215_provability_qr_sound.mm0";

import "bb215_provability_qr_complete.mm0";

-- Q = K215 Hilbert-calculus provability as a PA formula (lane L07, Q decision revision 2:
-- ranked derivation set). bb215ProvabilityK215Code has one free variable (0 = y), is Sigma1 with
-- a guarded matrix, and its depth-24 satisfaction is exactly k215Provable (E @ 0).

def bb215ProvabilityK215Code: nat = $ bb215ProvabilityQRCode $;

theorem bb215ProvabilityQRGraph_iff (y: nat): $ bb215ProvabilityQRGraph y <-> k215Provable y $;

theorem bb215ProvabilityQRCode_correct (E: set): $ bb215ArithmeticFormulaDepthTwentyfourSat E bb215ProvabilityQRCode <-> k215Provable (E @ 0) $;

theorem bb215ProvabilityK215Code_bound: $ paFormulaBound 1 bb215ProvabilityK215Code $;

theorem bb215ProvabilityK215Code_correct (E: set): $ bb215ArithmeticFormulaDepthTwentyfourSat E bb215ProvabilityK215Code <-> k215Provable (E @ 0) $;

theorem bb215ProvabilityQRGraph_iff_kF: $ bb215ProvabilityQRGraph 1 <-> k215Provable 1 $;
