import "source_l_replacement_definable_law.mm0";

theorem sfLReplacementDefinableBody_bound(m psi:nat)(hb:$ sfBound (suc m) psi $):
 $ sfBound (m + 2) (sfLReplacementDefinableBody m psi) $;

theorem sfLReplacementDefinableLaw_bound(m psi:nat)(hb:$ sfBound (suc m) psi $):
 $ sfBound 0 (sfLReplacementDefinableLaw m psi) $;
