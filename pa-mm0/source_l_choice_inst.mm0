import "source_l_choice_defs.mm0";

theorem sfLChoice_ordl_use (G d: nat) (h: $ nsLocal G sfLChoiceOrdL $)
 (hO: $ nsLocal G (sfCLOrdinalAt d) $): $ nsLocal G (sfLChoiceD d) $;

theorem sfLChoice_orddown_use (G d: nat) (h: $ nsLocal G sfLChoiceOrdDown $)
 (hO: $ nsLocal G (sfCLOrdinalAt d) $):
 $ nsLocal G (sfRelativize sfLDomain (sfCLOrdinalAt d)) $;

theorem sfLChoice_unique_use (G a y z: nat) (h: $ nsLocal G sfLChoiceUnique $)
 (ha: $ nsLocal G (sfCLOrdinalAt a) $) (hy: $ nsLocal G (sfCLHierarchyAt a y) $)
 (hz: $ nsLocal G (sfCLHierarchyAt a z) $): $ nsLocal G (sfEq y z) $;

theorem sfLChoice_up_use (G a y: nat) (h: $ nsLocal G sfLChoiceUp $)
 (ha: $ nsLocal G (sfLChoiceD a) $) (hy: $ nsLocal G (sfLChoiceD y) $)
 (hl: $ nsLocal G (sfRelativize sfLDomain (sfCLHierarchyAt a y)) $):
 $ nsLocal G (sfCLHierarchyAt a y) $;

theorem sfLChoice_t1_use (G d: nat) (h: $ nsLocal G (sfRelativize sfLDomain sfLChoiceT1) $)
 (hD: $ nsLocal G (sfLChoiceD d) $) (hO: $ nsLocal G (sfRelativize sfLDomain (sfCLOrdinalAt d)) $):
 $ nsLocal G (sfRelativize sfLDomain (sfEx (sfCLHierarchyAt (suc d) 0))) $;

theorem sfLChoice_t2_use (G a y x: nat) (h: $ nsLocal G (sfRelativize sfLDomain sfLChoiceT2) $)
 (hDa: $ nsLocal G (sfLChoiceD a) $) (hOa: $ nsLocal G (sfRelativize sfLDomain (sfCLOrdinalAt a)) $)
 (hDy: $ nsLocal G (sfLChoiceD y) $) (hLy: $ nsLocal G (sfRelativize sfLDomain (sfCLHierarchyAt a y)) $)
 (hDx: $ nsLocal G (sfLChoiceD x) $) (hm: $ nsLocal G (sfMem x y) $):
 $ nsLocal G (sfRelativize sfLDomain (sfLChoiceAC x)) $;
