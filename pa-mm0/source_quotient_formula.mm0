import "source_quotient_atoms.mm0";

import "quotation_supported_environment.mm0";

def sfQuotientQuoteClass (.c .S .n .z .k: nat): set = $ {c | A. S A. n A. z A. k (sfBound n c -> z < n -> sfNamedTemplate (sqNumericEnvironment S) k 0 (sfQuotient z c) = sqQuote (sqNumericEnvironment S) ((sqNumericEnvironment S) @ z) k 0 c)} $;

theorem sqq_value {S n z k: nat} (c: nat): $ c e. sfQuotientQuoteClass <-> A. S A. n A. z A. k (sfBound n c -> z < n -> sfNamedTemplate (sqNumericEnvironment S) k 0 (sfQuotient z c) = sqQuote (sqNumericEnvironment S) ((sqNumericEnvironment S) @ z) k 0 c) $;

theorem sfQuotientQuote_closed: $ sfConstructionClosed sfQuotientQuoteClass $;

theorem sfQuotient_quote_numeric (S n z k c: nat): $ sfBound n c -> z < n -> sfNamedTemplate (sqNumericEnvironment S) k 0 (sfQuotient z c) = sqQuote (sqNumericEnvironment S) ((sqNumericEnvironment S) @ z) k 0 c $;
