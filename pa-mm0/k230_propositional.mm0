import "k230_induction.mm0";

-- Uniform PA theorems about the concrete numerical K proof predicate.
-- CD230 is replayed as a shared lemma DAG. No completeness is used.

theorem kCd0 (v0 v1 v2 v3: nat):
  $ kProvable (kImp (kImp (kImp v0 v1) v2) (kImp (kImp v2 v0) (kImp v3 v0))) $;

theorem kCd1 (v0 v1 v2 v3 v4: nat):
  $ kProvable (kImp (kImp (kImp (kImp v0 v1) (kImp v2 v1)) (kImp v1 v3)) (kImp v4 (kImp v1 v3))) $;

