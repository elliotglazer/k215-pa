import "source_l_replacement_next_def.mm0";

import "source_l_pair_next.mm0";

-- The natively extracted NextLevel law is the literal next-level law.
theorem sfLNextLevelLaw_pair_literal: $ sfLPairNextLevel = sfLNextLevelLaw $;

theorem sfLNextLevelLaw_zfr: $ sfTheoryProvable zfrAxioms sfLNextLevelLaw $;

theorem sfLNextDefLaw_zfr: $ sfTheoryProvable zfrAxioms sfLNextDefLaw $;

-- The Replacement definability law needs only the level Definability Lemma.
theorem sfLReplacementDefinableLaw_from_level_zfr(m psi:nat)
 (hU:$ sfTheoryProvable zfrAxioms (sfLLevelDefinableLaw m psi) $):
 $ sfTheoryProvable zfrAxioms (sfLReplacementDefinableLaw m psi) $;
