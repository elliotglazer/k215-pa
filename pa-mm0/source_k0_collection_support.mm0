import "source_k0_collection_profile.mm0";

import "k218q_quantifier_macros.mm0";

import "k218q_equality.mm0";

theorem sfK0Collection_selected_projection (E: set) (b t r a u y x R psi: nat):
 $ k218QProvable (kImp (kImp (kAll x (kImp (kImp (kImp (sfK0QSepNamedSingleton x u R) (kImp (kImp (kImp (kImp (kImp (kMem t x) (kImp (kMem x a) kF)) kF) (kImp (kImp (kImp (kMem t y) (kImp (sfK0CollectionRel E R y x psi) kF)) kF) kF)) kF) kF)) kF) kF)) kF) (kImp (kAll x (kImp (kImp (kImp (kImp (kImp (kMem t x) (kImp (kMem x a) kF)) kF) (kImp (sfK0CollectionRel E R y x psi) kF)) kF) kF)) kF)) $;

theorem sfK0Collection_support_point (E: set) (b t r a u y x R psi: nat):
 $ k218QProvable (kImp (kImp (kMem t b) kF) (kImp (kImp (kMem t t) kF) (kImp (kMem t y) (kImp (kImp (kImp (kImp (kImp (kEq u r) (kImp (kEq y b) kF)) kF) kF) (kImp (kImp (kImp (kImp (kEq u t) (kImp (kEq y t) kF)) kF) kF) (kImp (kAll x (kImp (kImp (kImp (sfK0QSepNamedSingleton x u R) (kImp (kImp (kImp (kImp (kImp (kMem t x) (kImp (kMem x a) kF)) kF) (kImp (kImp (kImp (kMem t y) (kImp (sfK0CollectionRel E R y x psi) kF)) kF) kF)) kF) kF)) kF) kF)) kF))) (kImp (kAll x (kImp (kImp (kImp (kImp (kImp (kMem t x) (kImp (kMem x a) kF)) kF) (kImp (sfK0CollectionRel E R y x psi) kF)) kF) kF)) kF))))) $;
