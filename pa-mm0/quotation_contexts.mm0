import "quotation_propositional.mm0";
import "source_contexts.mm0";

def sqQuoteMap (E: set) (t k d .a: nat): set = $ \ a, sqQuote E t k d a $;
def sqContext (E: set) (t k d G: nat): nat = $ map (sqQuoteMap E t k d) G $;

theorem sqQuoteMap_value (E: set) (t k d a: nat):
 $ sqQuoteMap E t k d @ a = sqQuote E t k d a $;

theorem sqContext_nil (E: set) (t k d: nat): $ sqContext E t k d 0 = 0 $;

theorem sqContext_cons (E: set) (t k d a G: nat):
 $ sqContext E t k d (a : G) = sqQuote E t k d a : sqContext E t k d G $;

theorem sqContext_length (E: set) (t k d G: nat):
 $ len (sqContext E t k d G) = len G $;

theorem sqContext_member_iff {b: nat} (E: set) (t k d G a: nat):
 $ a IN sqContext E t k d G <-> E. b (b IN G /\ a = sqQuote E t k d b) $;

theorem sqContext_member (E: set) (t k d G a: nat):
 $ a IN G -> sqQuote E t k d a IN sqContext E t k d G $;

theorem sqContext_congr (F: wff) (E: set) (t k d G H: nat)
 (h: $ F -> G = H $):
 $ F -> sqContext E t k d G = sqContext E t k d H $;

theorem sqContext_sub (E: set) (t k d G H: nat):
 $ sfContextSub G H -> sfContextSub (sqContext E t k d G) (sqContext E t k d H) $;

theorem sqContext_support (E: set) (t k d G H: nat):
 $ sfContextSub G H -> kContextSupports (sqContext E t k d H) (sqContext E t k d G) $;

theorem sqLocal_context_weaken (E: set) (t k d G H a: nat):
 $ sfContextSub G H -> sqLocal (sqContext E t k d G) E t k d a ->
   sqLocal (sqContext E t k d H) E t k d a $;
