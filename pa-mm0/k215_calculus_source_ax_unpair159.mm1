import "k215_calculus_source_ax_reads_loops.mm1";
import "k215_literal_runtime_reach.mm1";
import "k215_calculus_source_pairing.mm1";
import "k215_calculus_source_ax_reads_lookups.mm1";

@_ def k215UnpairAt159State (pc a b n c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) a b n) $;

do (apply (register-eqd 'k215UnpairAt159State) '(k215UnpairAt159Stateeqd));

theorem k215UnpairAt159Transfer (b n c: nat): $ k215PIter (3 * b + 1) (k215UnpairAt159State k215Num163 0 b n c) = (k215UnpairAt159State k215Num166 b 0 n c) $ =
 '(eqtr k215Loop163Vector (k215PStateeq2 (k215PVectoreq7 add0)));
theorem k215UnpairAt159ReachTransfer (b n c: nat): $ k215PReach (k215UnpairAt159State k215Num163 0 b n c) (k215UnpairAt159State k215Num166 b 0 n c) $ =
 '(k215PReach_intro k215UnpairAt159Transfer);


theorem k215UnpairAt159Step9Z (a b c: nat): $ k215PStep (k215UnpairAt159State k215Num159 a b 0 c) = (k215UnpairAt159State k215Num167 a b 0 c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair159_159) (ifeq (eqeq1 k215PGet8_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt159Reach9Z (a b c: nat): $ k215PReach (k215UnpairAt159State k215Num159 a b 0 c) (k215UnpairAt159State k215Num167 a b 0 c) $ = '(k215PReach_step k215UnpairAt159Step9Z);

theorem k215UnpairAt159Step9S (a b n c: nat): $ k215PStep (k215UnpairAt159State k215Num159 a b (suc n) c) = (k215UnpairAt159State k215Num160 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair159_159) (ifeq (eqeq1 k215PGet8_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet8_vector)) (eqtr k215PSet8_vector (k215PVectoreq9 (eqtr subSS sub02))))));

theorem k215UnpairAt159Reach9S (a b n c: nat): $ k215PReach (k215UnpairAt159State k215Num159 a b (suc n) c) (k215UnpairAt159State k215Num160 a b n c) $ = '(k215PReach_step k215UnpairAt159Step9S);

theorem k215UnpairAt159Step10 (a b n c: nat): $ k215PStep (k215UnpairAt159State k215Num160 a b n c) = (k215UnpairAt159State k215Num161 a (suc b) n c) $ = '(eqtr (k215PAtCI k215PLookupUnpair159_160) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215UnpairAt159Reach10 (a b n c: nat): $ k215PReach (k215UnpairAt159State k215Num160 a b n c) (k215UnpairAt159State k215Num161 a (suc b) n c) $ = '(k215PReach_step k215UnpairAt159Step10);

theorem k215UnpairAt159Step11Z (b n c: nat): $ k215PStep (k215UnpairAt159State k215Num161 0 b n c) = (k215UnpairAt159State k215Num163 0 b n c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair159_161) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt159Reach11Z (b n c: nat): $ k215PReach (k215UnpairAt159State k215Num161 0 b n c) (k215UnpairAt159State k215Num163 0 b n c) $ = '(k215PReach_step k215UnpairAt159Step11Z);

theorem k215UnpairAt159Step11S (a b n c: nat): $ k215PStep (k215UnpairAt159State k215Num161 (suc a) b n c) = (k215UnpairAt159State k215Num162 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair159_161) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215UnpairAt159Reach11S (a b n c: nat): $ k215PReach (k215UnpairAt159State k215Num161 (suc a) b n c) (k215UnpairAt159State k215Num162 a b n c) $ = '(k215PReach_step k215UnpairAt159Step11S);

theorem k215UnpairAt159Step12 (a b n c: nat): $ k215PStep (k215UnpairAt159State k215Num162 a b n c) = (k215UnpairAt159State k215Num166 a b n c) $ = '(k215PAtCB k215PLookupUnpair159_162);

theorem k215UnpairAt159Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt159State k215Num162 a b n c) (k215UnpairAt159State k215Num166 a b n c) $ = '(k215PReach_step k215UnpairAt159Step12);

theorem k215UnpairAt159Step16 (a b n c: nat): $ k215PStep (k215UnpairAt159State k215Num166 a b n c) = (k215UnpairAt159State k215Num159 a b n c) $ = '(k215PAtCC k215PLookupUnpair159_166);

theorem k215UnpairAt159Reach16 (a b n c: nat): $ k215PReach (k215UnpairAt159State k215Num166 a b n c) (k215UnpairAt159State k215Num159 a b n c) $ = '(k215PReach_step k215UnpairAt159Step16);

theorem k215UnpairAt159CycleZero (b n c: nat): $ k215PReach (k215UnpairAt159State k215Num159 0 b (suc n) c) (k215UnpairAt159State k215Num159 (suc b) 0 n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt159Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt159Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt159Reach11Z) (ax_mp (ax_mp k215PReach_trans k215UnpairAt159ReachTransfer) k215UnpairAt159Reach16))));
theorem k215UnpairAt159CycleSucc (a b n c: nat): $ k215PReach (k215UnpairAt159State k215Num159 (suc a) b (suc n) c) (k215UnpairAt159State k215Num159 a (suc b) n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt159Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt159Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt159Reach11S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt159Reach12) k215UnpairAt159Reach16))));


theorem k215UnpairAt159AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt159State k215Num159 0 b (suc n) c) (k215UnpairAt159State k215Num159 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt159Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215PairDiagonal_rotate)) (eqtr (eqcom sndpr) (sndeq k215PairDiagonal_rotate)) eqid eqid)) k215UnpairAt159CycleZero);

theorem k215UnpairAt159AdvanceSucc (a b n c: nat): $ k215PReach (k215UnpairAt159State k215Num159 (suc a) b (suc n) c) (k215UnpairAt159State k215Num159 (fst (suc ((suc a), b))) (snd (suc ((suc a), b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt159Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215Pair_next)) (eqtr (eqcom sndpr) (sndeq k215Pair_next)) eqid eqid)) k215UnpairAt159CycleSucc);

pub theorem k215UnpairAt159Advance (a b n c: nat): $ k215PReach (k215UnpairAt159State k215Num159 a b (suc n) c) (k215UnpairAt159State k215Num159 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
 (named @ induct '(ind) 'a 'k215UnpairAt159AdvanceZero '(a1i k215UnpairAt159AdvanceSucc));
@_ abstract def k215UnpairAt159Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt159State k215Num159 a b n c) (k215UnpairAt159State k215Num167 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
theorem k215UnpairAt159RunZero (a b c: nat): $ k215UnpairAt159Run 0 a b c $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt159Stateeq eqid
     (eqcom (eqtr (fsteq add0) fstpr))
     (eqcom (eqtr (sndeq add0) sndpr)) eqid eqid)) k215UnpairAt159Reach9Z);
@_ abstract def k215UnpairAt159Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt159Run n a b c $;
theorem k215UnpairAt159Claim_at (n a b c: nat): $ k215UnpairAt159Claim n c -> k215UnpairAt159Run n a b c $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215UnpairAt159CodeStep (a b n: nat): $ (fst (suc (a, b)), snd (suc (a, b))) + n = (a, b) + suc n $ =
 '(eqtr (addeq1 fstsnd) addSass);
theorem k215UnpairAt159RunInductive (n a b c: nat): $ k215UnpairAt159Claim n c -> k215UnpairAt159Run (suc n) a b c $ =
 '(syl (ax_mp k215PReach_trans k215UnpairAt159Advance)
   (mpbid (a1i (k215PReacheq2 (k215UnpairAt159Stateeq eqid
     (fsteq k215UnpairAt159CodeStep) (sndeq k215UnpairAt159CodeStep) eqid eqid))) k215UnpairAt159Claim_at));
theorem k215UnpairAt159Claim_all (n c: nat): $ k215UnpairAt159Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt159RunZero)) '(iald @ iald k215UnpairAt159RunInductive));
pub theorem k215UnpairMacro159 (n a b c: nat): $ k215PReach (k215UnpairAt159State k215Num159 a b n c) (k215UnpairAt159State k215Num167 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
 '(ax_mp k215UnpairAt159Claim_at k215UnpairAt159Claim_all);
pub theorem k215UnpairMacro159_clean (n c: nat): $ k215PReach (k215UnpairAt159State k215Num159 0 0 n c) (k215UnpairAt159State k215Num167 (fst n) (snd n) 0 c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt159Stateeq eqid
   (fsteq (eqtr (addeq1 pr0) add01))
   (sndeq (eqtr (addeq1 pr0) add01)) eqid eqid)) k215UnpairMacro159);


