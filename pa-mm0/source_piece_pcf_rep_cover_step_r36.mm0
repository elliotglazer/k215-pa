import "source_piece_pcf_rep_cover_prefix_r35.mm0";

theorem sfPieceRepCoverPoint_prefix_step(n:nat): $ nsLocal 0 (sfImp (sfPieceRepEnvironmentCoverStep 1 0 2) (sfImp (sfPieceRepCoverPoint (sfPieceRepCoverTail 3) n 0) (sfPieceRepDn3Box (sfPieceRepCoverPoint (sfPieceRepCoverTail 3) (suc n) 2)))) $;

theorem sfPieceRepCoverProtected_step(G n:nat)(hs:$ nsLocal G (sfPieceRepEnvironmentCoverStep 1 0 2) $)(hx:$ nsLocal G (sfPieceRepCoverProtected n 0) $): $ nsLocal G (sfPieceRepCoverProtected (suc n) 2) $;

theorem sfPieceRepEnvironmentCoverStep_rename(R:set)(A X Y:nat): $ sfRename R 0 (sfPieceRepEnvironmentCoverStep A X Y) = sfPieceRepEnvironmentCoverStep (R @ A) (R @ X) (R @ Y) $;

theorem sfPieceRepEnvironmentCover_step(G A X Y n:nat)(hX:$ nsLocal G (sfPieceRepEnvironmentCoverAt A X n) $)(hXY:$ nsLocal G (sfPieceRepEnvironmentCoverStep A X Y) $): $ nsLocal G (sfPieceRepEnvironmentCoverAt A Y (suc n)) $;
