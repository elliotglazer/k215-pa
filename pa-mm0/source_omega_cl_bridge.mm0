-- Bridge between sfTRS (source_omega_trec_atom) and the CL-parametric hierarchy/ordinal
-- predicates of source_l_common_level_syntax (lane L08).
import "source_omega_trec_atom.mm0";

import "source_l_common_level_syntax.mm0";

import "source_syntax_laws.mm0";

theorem sfTRS_CLHierarchyAt (a y: nat): $ sfTRS sfCLHierarchy a y y y = sfCLHierarchyAt a y $;

theorem sfTRS_CLOrdinalAt (a: nat): $ sfTRS sfCLOrdinal a a a a = sfCLOrdinalAt a $;

theorem sfCLHierarchy_bound4: $ sfBound 4 sfCLHierarchy $;
