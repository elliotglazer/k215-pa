import "source_l_replacement_definable_reduction.mm1";
import "source_reflection_transfer_tv_domain_literal.mm1";

@_ def sfLNextLevelBody: nat =
 $ sfImp (sfCLOrdinalAt 1) (sfImp (sfCLHierarchyAt 1 0)
   (sfEx (sfEx (sfAnd (sfAnd (sfCLOrdinalAt 1) (sfCLHierarchyAt 1 0)) (sfLSeparationDef0 2 0))))) $;

@_ def sfLNextLevelLaw: nat = $ sfAllPrefix 2 sfLNextLevelBody $;

-- Renaming and shifting Def0 (same pattern as sfLSeparationDef0_subst in
-- source_l_separation_image_def0, with renaming in place of substitution).
theorem lrnn_subset_eq(A B C D:nat)(ha:$ A = C $)(hb:$ B = D $):
 $ sfCLSubset A B = sfCLSubset C D $ =
 '(nsAll_eq (nsImp_eq (nsMem_eq eqid (suceq ha)) (nsMem_eq eqid (suceq hb))));

theorem lrnn_subset_rename(R:set)(k a b:nat):
 $ sfRename R k (sfCLSubset a b) = sfCLSubset (sfRenameIndex R k a) (sfRenameIndex R k b) $ =
 '(eqtr sfRename_sfAll (nsAll_eq (eqtr sfRename_sfImp (nsImp_eq
   (eqtr sfRename_sfMem (nsMem_eq (ax_mp sfRenameIndex_bound lt01S) sfRenameIndex_lift))
   (eqtr sfRename_sfMem (nsMem_eq (ax_mp sfRenameIndex_bound lt01S) sfRenameIndex_lift))))));

theorem lrnn_forward_eq(A C D B E F:nat)(ha:$ A = B $)(hc:$ C = E $)(hd:$ D = F $):
 $ sfLSeparationDef0Forward A C D = sfLSeparationDef0Forward B E F $ =
 '(nsAll_eq (nsImp_eq (nsMem_eq eqid (suceq hd))
   (nsAnd_eq (nsMem_eq eqid (suceq hc)) (lrnn_subset_eq eqid (suceq ha)))));

theorem lrnn_reverse_eq(A C D B E F:nat)(ha:$ A = B $)(hc:$ C = E $)(hd:$ D = F $):
 $ sfLSeparationDef0Reverse A C D = sfLSeparationDef0Reverse B E F $ =
 '(nsAll_eq (nsImp_eq (nsMem_eq eqid (suceq hc))
   (nsImp_eq (lrnn_subset_eq eqid (suceq ha)) (nsMem_eq eqid (suceq hd)))));

theorem lrnn_forward_rename(R:set)(k A C D:nat):
 $ sfRename R k (sfLSeparationDef0Forward A C D) =
   sfLSeparationDef0Forward (sfRenameIndex R k A) (sfRenameIndex R k C) (sfRenameIndex R k D) $ =
 '(eqtr sfRename_sfAll (nsAll_eq (eqtr sfRename_sfImp (nsImp_eq
   (eqtr sfRename_sfMem (nsMem_eq (ax_mp sfRenameIndex_bound lt01S) sfRenameIndex_lift))
   (eqtr sfRename_sfAnd (nsAnd_eq
    (eqtr sfRename_sfMem (nsMem_eq (ax_mp sfRenameIndex_bound lt01S) sfRenameIndex_lift))
    (eqtr lrnn_subset_rename (lrnn_subset_eq (ax_mp sfRenameIndex_bound lt01S) sfRenameIndex_lift))))))));

theorem lrnn_reverse_rename(R:set)(k A C D:nat):
 $ sfRename R k (sfLSeparationDef0Reverse A C D) =
   sfLSeparationDef0Reverse (sfRenameIndex R k A) (sfRenameIndex R k C) (sfRenameIndex R k D) $ =
 '(eqtr sfRename_sfAll (nsAll_eq (eqtr sfRename_sfImp (nsImp_eq
   (eqtr sfRename_sfMem (nsMem_eq (ax_mp sfRenameIndex_bound lt01S) sfRenameIndex_lift))
   (eqtr sfRename_sfImp (nsImp_eq
    (eqtr lrnn_subset_rename (lrnn_subset_eq (ax_mp sfRenameIndex_bound lt01S) sfRenameIndex_lift))
    (eqtr sfRename_sfMem (nsMem_eq (ax_mp sfRenameIndex_bound lt01S) sfRenameIndex_lift))))))));

pub theorem sfLRepDef0_rename(R:set)(k A D:nat):
 $ sfRename R k (sfLSeparationDef0 A D) =
   sfLSeparationDef0 (sfRenameIndex R k A) (sfRenameIndex R k D) $ =
 '(eqtr sfRename_sfEx (nsEx_eq (eqtr sfRename_sfEx (nsEx_eq
   (eqtr sfRename_sfAnd (nsAnd_eq
    (eqtr sfRename_sfAnd (nsAnd_eq
     (eqtr sfRename_sfAnd (nsAnd_eq
      (eqtr sfPieceRepSuccessor_rename (sfPieceRepSuccessor_eq
        (eqtr sfRenameIndex_lift (suceq sfRenameIndex_lift))
        (ax_mp sfRenameIndex_bound (mpbi ltsuc lt01S))))
      (eqtr sfPieceRepClosure_rename (sfPieceRepClosure_eq
        (ax_mp sfRenameIndex_bound (mpbi ltsuc lt01S)) (ax_mp sfRenameIndex_bound lt01S)))))
     (eqtr lrnn_forward_rename (lrnn_forward_eq
       (eqtr sfRenameIndex_lift (suceq sfRenameIndex_lift))
       (ax_mp sfRenameIndex_bound lt01S)
       (eqtr sfRenameIndex_lift (suceq sfRenameIndex_lift))))))
    (eqtr lrnn_reverse_rename (lrnn_reverse_eq
      (eqtr sfRenameIndex_lift (suceq sfRenameIndex_lift))
      (ax_mp sfRenameIndex_bound lt01S)
      (eqtr sfRenameIndex_lift (suceq sfRenameIndex_lift))))))))));

pub theorem sfLRepDef0_shift(k A D:nat):
 $ sfShift k (sfLSeparationDef0 A D) = sfLSeparationDef0 (sfShiftIndex k A) (sfShiftIndex k D) $ =
 '(eqtr (eqcom (ax_mp sfRename_successor sfLSeparationDef0_wf))
   (eqtr sfLRepDef0_rename (sfLSeparationDef0_eq sfRenameIndex_successor sfRenameIndex_successor)));

-- Well-formedness.
theorem lrnn_cov_wf: $ sfWf (sfImp (sfMem 0 1) sfLDomain) $ =
 '(ax_mp (ax_mp sfWf_imp sfWf_mem) sfLDomain_wf);

theorem lrnn_c2_wf: $ sfWf (sfAnd (sfLSeparationDef0 2 0) (sfAll (sfImp (sfMem 0 1) sfLDomain))) $ =
 '(ax_mp (ax_mp sfWf_and sfLSeparationDef0_wf) (ax_mp sfWf_all lrnn_cov_wf));

theorem lrnn_ex_c2_wf:
 $ sfWf (sfEx (sfAnd (sfLSeparationDef0 2 0) (sfAll (sfImp (sfMem 0 1) sfLDomain)))) $ =
 '(ax_mp sfWf_ex lrnn_c2_wf);

theorem lrnn_gl_wf:
 $ sfWf (sfEx (sfAnd (sfLSeparationDef0 1 0) (sfAll (sfImp (sfMem 0 1) sfLDomain)))) $ =
 '(ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and sfLSeparationDef0_wf) (ax_mp sfWf_all lrnn_cov_wf)));

theorem lrnn_w_wf:
 $ sfWf (sfAnd (sfAnd (sfCLOrdinalAt 1) (sfCLHierarchyAt 1 0)) (sfLSeparationDef0 2 0)) $ =
 '(ax_mp (ax_mp sfWf_and (ax_mp (ax_mp sfWf_and sfCLOrdinalAt_wf) sfCLHierarchyAt_wf))
   sfLSeparationDef0_wf);

theorem lrnn_body_wf: $ sfWf sfLNextLevelBody $ =
 '(ax_mp (ax_mp sfWf_imp sfCLOrdinalAt_wf)
   (ax_mp (ax_mp sfWf_imp sfCLHierarchyAt_wf) (ax_mp sfWf_ex (ax_mp sfWf_ex lrnn_w_wf))));

theorem lrnn_m_wf:
 $ sfWf (sfEx (sfAnd (sfAnd (sfCLOrdinalAt 1) (sfCLHierarchyAt 1 0)) (sfMem 2 0))) $ =
 '(ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and
   (ax_mp (ax_mp sfWf_and sfCLOrdinalAt_wf) sfCLHierarchyAt_wf)) sfWf_mem));

theorem lrnn_m1_wf:
 $ sfWf (sfAnd (sfAnd (sfCLOrdinalAt 3) (sfCLHierarchyAt 3 0)) (sfMem 1 0)) $ =
 '(ax_mp (ax_mp sfWf_and (ax_mp (ax_mp sfWf_and sfCLOrdinalAt_wf) sfCLHierarchyAt_wf)) sfWf_mem);

-- Index computations for instantiating the two existentials of sfLDomain.
theorem lrnn_Ea:
 $ sfSubst (suc 0) 2 (sfAnd (sfAnd (sfCLOrdinalAt 1) (sfCLHierarchyAt 1 0)) (sfMem 2 0)) =
   sfAnd (sfAnd (sfCLOrdinalAt 3) (sfCLHierarchyAt 3 0)) (sfMem 1 0) $ =
 '(eqtr sfSubst_sfAnd (nsAnd_eq
   (eqtr sfSubst_sfAnd (nsAnd_eq
    (eqtr sfLOrdinalAt_subst (sfCLOrdinalAteq (eqtr sfSubstIndex_hit (eqtr addS (suceq add0)))))
    (eqtr sfLHierarchyAt_subst (sfCLHierarchyAteq (eqtr sfSubstIndex_hit (eqtr addS (suceq add0)))
     (ax_mp sfSubstIndex_bound lt01S)))))
   (eqtr sfSubst_sfMem (nsMem_eq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor))
    (ax_mp sfSubstIndex_bound lt01S)))));

theorem lrnn_Eb:
 $ sfSubst 0 1 (sfAnd (sfAnd (sfCLOrdinalAt 3) (sfCLHierarchyAt 3 0)) (sfMem 1 0)) =
   sfAnd (sfAnd (sfCLOrdinalAt 2) (sfCLHierarchyAt 2 1)) (sfMem 0 1) $ =
 '(eqtr sfSubst_sfAnd (nsAnd_eq
   (eqtr sfSubst_sfAnd (nsAnd_eq
    (eqtr sfLOrdinalAt_subst (sfCLOrdinalAteq sfSubstIndex_successor))
    (eqtr sfLHierarchyAt_subst (sfCLHierarchyAteq sfSubstIndex_successor sfSubstIndex_zero))))
   (eqtr sfSubst_sfMem (nsMem_eq sfSubstIndex_successor sfSubstIndex_zero))));

-- Shift computations for the goal.
theorem lrnn_def0_shift10:
 $ sfShift (suc 0) (sfLSeparationDef0 1 0) = sfLSeparationDef0 2 0 $ =
 '(eqtr sfLRepDef0_shift (sfLSeparationDef0_eq (ax_mp sfShiftIndex_free ltirr)
   (ax_mp sfShiftIndex_bound lt01S)));

theorem lrnn_cov_shift:
 $ sfShift (suc (suc 0)) (sfImp (sfMem 0 1) sfLDomain) = sfImp (sfMem 0 1) sfLDomain $ =
 '(eqtr sfShift_sfImp (nsImp_eq
   (eqtr sfShift_sfMem (nsMem_eq (ax_mp sfShiftIndex_bound lt01S)
    (ax_mp sfShiftIndex_bound (mpbi ltsuc lt01S))))
   (ax_mp sfShift_bound_identity (ax_mp (ax_mp sfBound_mono sfLDomain_bound) le11S))));

theorem lrnn_c_shift:
 $ sfShift (suc 0) (sfAnd (sfLSeparationDef0 1 0) (sfAll (sfImp (sfMem 0 1) sfLDomain))) =
   sfAnd (sfLSeparationDef0 2 0) (sfAll (sfImp (sfMem 0 1) sfLDomain)) $ =
 '(eqtr sfShift_sfAnd (nsAnd_eq lrnn_def0_shift10 (eqtr sfShift_sfAll (nsAll_eq lrnn_cov_shift))));

theorem lrnn_e1:
 $ sfShift 0 (sfEx (sfAnd (sfLSeparationDef0 1 0) (sfAll (sfImp (sfMem 0 1) sfLDomain)))) =
   sfEx (sfAnd (sfLSeparationDef0 2 0) (sfAll (sfImp (sfMem 0 1) sfLDomain))) $ =
 '(eqtr sfShift_sfEx (nsEx_eq lrnn_c_shift));

-- Contexts.
theorem lrnn_c3_wf(G:nat)(hg:$ sfContextWf G $):
 $ sfContextWf (sfEx (sfAnd (sfAnd (sfCLOrdinalAt 1) (sfCLHierarchyAt 1 0)) (sfLSeparationDef0 2 0)) :
   sfContextShift G) $ =
 '(mpbir sfContextWf_cons (ian (ax_mp sfWf_ex lrnn_w_wf) (ax_mp sfContextShift_preserves_wf hg)));

theorem lrnn_c4_wf(G:nat)(hg:$ sfContextWf G $):
 $ sfContextWf (sfAnd (sfAnd (sfCLOrdinalAt 1) (sfCLHierarchyAt 1 0)) (sfLSeparationDef0 2 0) :
   sfContextShift G) $ =
 '(mpbir sfContextWf_cons (ian lrnn_w_wf (ax_mp sfContextShift_preserves_wf hg)));

theorem lrnn_c6_wf(G:nat)(hg:$ sfContextWf G $):
 $ sfContextWf (sfMem 0 1 : sfContextShift G) $ =
 '(mpbir sfContextWf_cons (ian sfWf_mem (ax_mp sfContextShift_preserves_wf hg)));

-- y in L from an ordinal s with D = L_s and y in D (indices: y = 0, D = 1, s = 2).
theorem lrnn_inL(H:nat)
 (ho:$ nsLocal H (sfCLOrdinalAt 2) $)(hh:$ nsLocal H (sfCLHierarchyAt 2 1) $)
 (hm:$ nsLocal H (sfMem 0 1) $):
 $ nsLocal H sfLDomain $ =
 '(sfRQ_rewrite (eqcom sfTVLDomain_literal)
   (ax_mp (ax_mp nsLocal_ExI lrnn_m_wf)
    (sfRQ_rewrite (eqcom sfSubst_sfEx)
     (sfRQ_rewrite (eqcom (nsEx_eq lrnn_Ea))
      (ax_mp (ax_mp nsLocal_ExI lrnn_m1_wf)
       (mpbir (nsLocal_formula_eq lrnn_Eb)
        (ax_mp (ax_mp sfLocal_and (ax_mp (ax_mp sfLocal_and ho) hh)) hm)))))));

-- At D (indices D = 0, s = 1, Y = 2): every element of D is in L.
theorem lrnn_cover(G:nat)(hg:$ sfContextWf G $)
 (hW:$ nsLocal G (sfAnd (sfAnd (sfCLOrdinalAt 1) (sfCLHierarchyAt 1 0)) (sfLSeparationDef0 2 0)) $):
 $ nsLocal G (sfAll (sfImp (sfMem 0 1) sfLDomain)) $ =
 '(ax_mp (sfLocal_allI hg)
   (ax_mp nsLocal_II
    (lrnn_inL
     (ax_mp (ax_mp (ax_mp nsLocal_weaken (lrnn_c6_wf hg)) sfContextSub_cons)
      (sfRQ_rewrite sfCLOrdinalAt_shift
       (ax_mp sfSepLocal_shift (ax_mp nsLocal_CE1 (ax_mp nsLocal_CE1 hW)))))
     (ax_mp (ax_mp (ax_mp nsLocal_weaken (lrnn_c6_wf hg)) sfContextSub_cons)
      (sfRQ_rewrite sfCLHierarchyAt_shift
       (ax_mp sfSepLocal_shift (ax_mp nsLocal_CE2 (ax_mp nsLocal_CE1 hW)))))
     (ax_mp (ax_mp nsLocal_hyp (lrnn_c6_wf hg)) sfContext_member_head))));

theorem lrnn_at_d(G:nat)(hg:$ sfContextWf G $)
 (hW:$ nsLocal G (sfAnd (sfAnd (sfCLOrdinalAt 1) (sfCLHierarchyAt 1 0)) (sfLSeparationDef0 2 0)) $):
 $ nsLocal G (sfShift 0 (sfEx (sfAnd (sfLSeparationDef0 2 0) (sfAll (sfImp (sfMem 0 1) sfLDomain))))) $ =
 '(sfRQ_rewrite (eqcom sfShift_sfEx)
   (ax_mp (ax_mp nsLocal_ExI sfShift_wf)
    (mpbir (nsLocal_formula_eq (ax_mp sfSubst_shift_up_identity lrnn_c2_wf))
     (ax_mp (ax_mp sfLocal_and (ax_mp nsLocal_CE2 hW)) (lrnn_cover hg hW)))));

theorem lrnn_at_s(G:nat)(hg:$ sfContextWf G $)
 (hE:$ nsLocal G (sfEx (sfAnd (sfAnd (sfCLOrdinalAt 1) (sfCLHierarchyAt 1 0)) (sfLSeparationDef0 2 0))) $):
 $ nsLocal G (sfEx (sfAnd (sfLSeparationDef0 2 0) (sfAll (sfImp (sfMem 0 1) sfLDomain)))) $ =
 '(ax_mp (ax_mp (sfLocal_exE lrnn_ex_c2_wf) hE)
   (lrnn_at_d (lrnn_c4_wf hg) (ax_mp (ax_mp nsLocal_hyp (lrnn_c4_wf hg)) sfContext_member_head)));

theorem lrnn_at_y(G:nat)(hg:$ sfContextWf G $)
 (hE:$ nsLocal G (sfEx (sfEx (sfAnd (sfAnd (sfCLOrdinalAt 1) (sfCLHierarchyAt 1 0))
   (sfLSeparationDef0 2 0)))) $):
 $ nsLocal G (sfEx (sfAnd (sfLSeparationDef0 1 0) (sfAll (sfImp (sfMem 0 1) sfLDomain)))) $ =
 '(ax_mp (ax_mp (sfLocal_exE lrnn_gl_wf) hE)
   (sfRQ_rewrite (eqcom lrnn_e1)
    (lrnn_at_s (lrnn_c3_wf hg) (ax_mp (ax_mp nsLocal_hyp (lrnn_c3_wf hg)) sfContext_member_head))));

theorem lrnn_ctx_wf:
 $ sfContextWf (sfCLHierarchyAt 1 0 : (sfCLOrdinalAt 1 : (sfLNextLevelBody : 0))) $ =
 '(mpbir sfContextWf_cons (ian sfCLHierarchyAt_wf
   (mpbir sfContextWf_cons (ian sfCLOrdinalAt_wf
    (mpbir sfContextWf_cons (ian lrnn_body_wf sfContextWf_nil))))));

theorem lrnn_local: $ nsLocal (sfLNextLevelBody : 0) sfLNextDefBody $ =
 '(ax_mp nsLocal_II (ax_mp nsLocal_II
   (lrnn_at_y lrnn_ctx_wf
    (ax_mp (ax_mp nsLocal_mp
      (ax_mp (ax_mp nsLocal_mp
        (ax_mp (ax_mp nsLocal_hyp lrnn_ctx_wf)
         (ax_mp sfContext_member_tail (ax_mp sfContext_member_tail sfContext_member_head))))
       (ax_mp (ax_mp nsLocal_hyp lrnn_ctx_wf) (ax_mp sfContext_member_tail sfContext_member_head))))
     (ax_mp (ax_mp nsLocal_hyp lrnn_ctx_wf) sfContext_member_head)))));

pub theorem sfLNextDefLaw_from_level_law
 (hL:$ sfTheoryProvable zfrAxioms sfLNextLevelLaw $):
 $ sfTheoryProvable zfrAxioms sfLNextDefLaw $ =
 '(ax_mp (ax_mp sfTheoryProvable_prefix_intro zfrAxioms_closed)
   (ax_mp (ax_mp (sfTheory_lemma_context zfrAxioms_closed)
     (mpbir sfTheoryContext_cons (ian
      (mpbir sfTheoryProofClass_value (ax_mp (ax_mp sfTheoryProvable_prefix_elim zfrAxioms_closed) hL))
      sfTheoryContext_nil)))
    lrnn_local));

pub theorem sfLReplacementDefinableLaw_from_level_next(m psi:nat)
 (hU:$ sfTheoryProvable zfrAxioms (sfLLevelDefinableLaw m psi) $)
 (hL:$ sfTheoryProvable zfrAxioms sfLNextLevelLaw $):
 $ sfTheoryProvable zfrAxioms (sfLReplacementDefinableLaw m psi) $ =
 '(sfLReplacementDefinableLaw_from_level hU (sfLNextDefLaw_from_level_law hL));
