import "k215_calculus_source_ax_stack_loops.mm1";
import "k215_literal_runtime_reach.mm1";
import "k215_calculus_source_pairing.mm1";
import "k215_calculus_source_ax_stack_lookups.mm1";

@_ def k215UnpairAt398State (pc a b n c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) n (k215PR3 c) (k215PR4 c) (k215PR5 c) a b (k215PR8 c)) $;

do (apply (register-eqd 'k215UnpairAt398State) '(k215UnpairAt398Stateeqd));

theorem k215UnpairAt398Transfer (b n c: nat): $ k215PIter (3 * b + 1) (k215UnpairAt398State k215PNum402 0 b n c) = (k215UnpairAt398State k215PNum405 b 0 n c) $ =
 '(eqtr k215Loop402Vector (k215PStateeq2 (k215PVectoreq7 add0)));
theorem k215UnpairAt398ReachTransfer (b n c: nat): $ k215PReach (k215UnpairAt398State k215PNum402 0 b n c) (k215UnpairAt398State k215PNum405 b 0 n c) $ =
 '(k215PReach_intro k215UnpairAt398Transfer);


theorem k215UnpairAt398Step9Z (a b c: nat): $ k215PStep (k215UnpairAt398State k215PNum398 a b 0 c) = (k215UnpairAt398State k215PNum406 a b 0 c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair398_398) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt398Reach9Z (a b c: nat): $ k215PReach (k215UnpairAt398State k215PNum398 a b 0 c) (k215UnpairAt398State k215PNum406 a b 0 c) $ = '(k215PReach_step k215UnpairAt398Step9Z);

theorem k215UnpairAt398Step9S (a b n c: nat): $ k215PStep (k215UnpairAt398State k215PNum398 a b (suc n) c) = (k215UnpairAt398State k215PNum399 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair398_398) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet2_vector)) (eqtr k215PSet2_vector (k215PVectoreq3 (eqtr subSS sub02))))));

theorem k215UnpairAt398Reach9S (a b n c: nat): $ k215PReach (k215UnpairAt398State k215PNum398 a b (suc n) c) (k215UnpairAt398State k215PNum399 a b n c) $ = '(k215PReach_step k215UnpairAt398Step9S);

theorem k215UnpairAt398Step10 (a b n c: nat): $ k215PStep (k215UnpairAt398State k215PNum399 a b n c) = (k215UnpairAt398State k215PNum400 a (suc b) n c) $ = '(eqtr (k215PAtCI k215PLookupUnpair398_399) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215UnpairAt398Reach10 (a b n c: nat): $ k215PReach (k215UnpairAt398State k215PNum399 a b n c) (k215UnpairAt398State k215PNum400 a (suc b) n c) $ = '(k215PReach_step k215UnpairAt398Step10);

theorem k215UnpairAt398Step11Z (b n c: nat): $ k215PStep (k215UnpairAt398State k215PNum400 0 b n c) = (k215UnpairAt398State k215PNum402 0 b n c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair398_400) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt398Reach11Z (b n c: nat): $ k215PReach (k215UnpairAt398State k215PNum400 0 b n c) (k215UnpairAt398State k215PNum402 0 b n c) $ = '(k215PReach_step k215UnpairAt398Step11Z);

theorem k215UnpairAt398Step11S (a b n c: nat): $ k215PStep (k215UnpairAt398State k215PNum400 (suc a) b n c) = (k215UnpairAt398State k215PNum401 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair398_400) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215UnpairAt398Reach11S (a b n c: nat): $ k215PReach (k215UnpairAt398State k215PNum400 (suc a) b n c) (k215UnpairAt398State k215PNum401 a b n c) $ = '(k215PReach_step k215UnpairAt398Step11S);

theorem k215UnpairAt398Step12 (a b n c: nat): $ k215PStep (k215UnpairAt398State k215PNum401 a b n c) = (k215UnpairAt398State k215PNum405 a b n c) $ = '(k215PAtCB k215PLookupUnpair398_401);

theorem k215UnpairAt398Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt398State k215PNum401 a b n c) (k215UnpairAt398State k215PNum405 a b n c) $ = '(k215PReach_step k215UnpairAt398Step12);

theorem k215UnpairAt398Step16 (a b n c: nat): $ k215PStep (k215UnpairAt398State k215PNum405 a b n c) = (k215UnpairAt398State k215PNum398 a b n c) $ = '(k215PAtCC k215PLookupUnpair398_405);

theorem k215UnpairAt398Reach16 (a b n c: nat): $ k215PReach (k215UnpairAt398State k215PNum405 a b n c) (k215UnpairAt398State k215PNum398 a b n c) $ = '(k215PReach_step k215UnpairAt398Step16);

theorem k215UnpairAt398CycleZero (b n c: nat): $ k215PReach (k215UnpairAt398State k215PNum398 0 b (suc n) c) (k215UnpairAt398State k215PNum398 (suc b) 0 n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt398Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt398Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt398Reach11Z) (ax_mp (ax_mp k215PReach_trans k215UnpairAt398ReachTransfer) k215UnpairAt398Reach16))));
theorem k215UnpairAt398CycleSucc (a b n c: nat): $ k215PReach (k215UnpairAt398State k215PNum398 (suc a) b (suc n) c) (k215UnpairAt398State k215PNum398 a (suc b) n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt398Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt398Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt398Reach11S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt398Reach12) k215UnpairAt398Reach16))));


theorem k215UnpairAt398AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt398State k215PNum398 0 b (suc n) c) (k215UnpairAt398State k215PNum398 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt398Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215PairDiagonal_rotate)) (eqtr (eqcom sndpr) (sndeq k215PairDiagonal_rotate)) eqid eqid)) k215UnpairAt398CycleZero);

theorem k215UnpairAt398AdvanceSucc (a b n c: nat): $ k215PReach (k215UnpairAt398State k215PNum398 (suc a) b (suc n) c) (k215UnpairAt398State k215PNum398 (fst (suc ((suc a), b))) (snd (suc ((suc a), b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt398Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215Pair_next)) (eqtr (eqcom sndpr) (sndeq k215Pair_next)) eqid eqid)) k215UnpairAt398CycleSucc);

pub theorem k215UnpairAt398Advance (a b n c: nat): $ k215PReach (k215UnpairAt398State k215PNum398 a b (suc n) c) (k215UnpairAt398State k215PNum398 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
 (named @ induct '(ind) 'a 'k215UnpairAt398AdvanceZero '(a1i k215UnpairAt398AdvanceSucc));
@_ abstract def k215UnpairAt398Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt398State k215PNum398 a b n c) (k215UnpairAt398State k215PNum406 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
theorem k215UnpairAt398RunZero (a b c: nat): $ k215UnpairAt398Run 0 a b c $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt398Stateeq eqid
     (eqcom (eqtr (fsteq add0) fstpr))
     (eqcom (eqtr (sndeq add0) sndpr)) eqid eqid)) k215UnpairAt398Reach9Z);
@_ abstract def k215UnpairAt398Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt398Run n a b c $;
theorem k215UnpairAt398Claim_at (n a b c: nat): $ k215UnpairAt398Claim n c -> k215UnpairAt398Run n a b c $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215UnpairAt398CodeStep (a b n: nat): $ (fst (suc (a, b)), snd (suc (a, b))) + n = (a, b) + suc n $ =
 '(eqtr (addeq1 fstsnd) addSass);
theorem k215UnpairAt398RunInductive (n a b c: nat): $ k215UnpairAt398Claim n c -> k215UnpairAt398Run (suc n) a b c $ =
 '(syl (ax_mp k215PReach_trans k215UnpairAt398Advance)
   (mpbid (a1i (k215PReacheq2 (k215UnpairAt398Stateeq eqid
     (fsteq k215UnpairAt398CodeStep) (sndeq k215UnpairAt398CodeStep) eqid eqid))) k215UnpairAt398Claim_at));
theorem k215UnpairAt398Claim_all (n c: nat): $ k215UnpairAt398Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt398RunZero)) '(iald @ iald k215UnpairAt398RunInductive));
pub theorem k215UnpairMacro398 (n a b c: nat): $ k215PReach (k215UnpairAt398State k215PNum398 a b n c) (k215UnpairAt398State k215PNum406 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
 '(ax_mp k215UnpairAt398Claim_at k215UnpairAt398Claim_all);
pub theorem k215UnpairMacro398_clean (n c: nat): $ k215PReach (k215UnpairAt398State k215PNum398 0 0 n c) (k215UnpairAt398State k215PNum406 (fst n) (snd n) 0 c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt398Stateeq eqid
   (fsteq (eqtr (addeq1 pr0) add01))
   (sndeq (eqtr (addeq1 pr0) add01)) eqid eqid)) k215UnpairMacro398);


