import "source_k0_qrep_functional_allocated.mm0";

import "k218q_bound_vacuity.mm0";

theorem sfK0QRepCanonicalFunctional_vacuity (E: set) (n t k phi: nat) (hf: $ sfBound (suc (suc n)) phi $):
 $ k218QProvable (kImp (sfK0QRepCanonicalFunctional E t k phi) (kAll k (sfK0QRepCanonicalFunctional E t k phi))) $;

theorem sfK0QRepMarkerFunctional_vacuity (E: set) (n k phi: nat) (hf: $ sfBound (suc (suc n)) phi $) (hk: $ 2 < k $):
 $ k218QProvable (kImp (kAnd kEmptyMarker (sfK0QRepCanonicalFunctional E 1 k phi)) (kAll k (kAnd kEmptyMarker (sfK0QRepCanonicalFunctional E 1 k phi)))) $;
