import "source_wf_basic_images.mm0";
import "source_wf_empty_image.mm0";
import "source_wf_foundation.mm0";
import "source_theory_local.mm0";
import "source_wf_pair_image.mm0";
import "source_wf_union_image.mm0";
import "source_wf_power_image.mm0";
import "source_wf_omega_image.mm0";
import "source_wf_separation_image.mm0";
import "source_wf_replacement_image.mm0";

-- Actual WF images proved from the concrete source core, with no
-- interpretation-image premise. All ten fixed core images and Foundation
-- are proved. Separation is uniform over internal formula and prefix codes.
-- Both schemes are uniform over internally coded formulas and prefixes.
theorem sfWFNonempty_core:
  $ sfTheoryProvable zfcCoreAxioms (sfEx sfWFDomain) $;

theorem sfWFRefl_core:
  $ sfTheoryProvable zfcCoreAxioms (sfRelativize sfWFDomain zfcRefl) $;
theorem sfWFSym_core:
  $ sfTheoryProvable zfcCoreAxioms (sfRelativize sfWFDomain zfcSym) $;
theorem sfWFTrans_core:
  $ sfTheoryProvable zfcCoreAxioms (sfRelativize sfWFDomain zfcTrans) $;
theorem sfWFEqElem_core:
  $ sfTheoryProvable zfcCoreAxioms (sfRelativize sfWFDomain zfcEqElem) $;
theorem sfWFExt_core:
  $ sfTheoryProvable zfcCoreAxioms (sfRelativize sfWFDomain zfcExt) $;
theorem sfWFEmpty_core:
  $ sfTheoryProvable zfcCoreAxioms (sfRelativize sfWFDomain zfcEmpty) $;
theorem sfWFFoundation_core:
  $ sfTheoryProvable zfcCoreAxioms (sfRelativize sfWFDomain zfcFoundation) $;

theorem sfWFCoreFixed_image (a: nat):
  $ zfcCoreFixed a -> sfTheoryProvable zfcCoreAxioms (sfRelativize sfWFDomain a) $;

theorem sfWFClosedSeparation_image (a: nat):
  $ zfcClosedSeparation a -> sfTheoryProvable zfcCoreAxioms (sfRelativize sfWFDomain a) $;

theorem sfWFClosedReplacement_image (a: nat):
  $ zfcClosedReplacement a -> sfTheoryProvable zfcCoreAxioms (sfRelativize sfWFDomain a) $;

theorem sfWFCoreAxiom_image (a: nat):
  $ a e. zfcCoreAxioms -> sfTheoryProvable zfcCoreAxioms (sfRelativize sfWFDomain a) $;

theorem sfWFZFRAxiom_image (a: nat):
  $ a e. zfrAxioms -> sfTheoryProvable zfcCoreAxioms (sfRelativize sfWFDomain a) $;
