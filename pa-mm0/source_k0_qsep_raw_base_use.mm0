def sfK0QSepRawSingletonBody: nat = $ (sfEx (sfAnd (sfMem 1 0) (sfAll (sfImp (sfMem 0 1) (sfEq 0 2))))) $;

theorem sfK0QSepRaw_singleton_source (E: set) (k x: nat) (hk: $ 0 < k $) (hx: $ x < k $):
 $ k218QProvable (sfNamedTemplate (sqEnvCons x E) (suc k) 0 sfK0QSepRawSingletonBody) $;

def sfK0QSepRawSingletonWitness (k x: nat): nat = $ (kExists (suc k) (kAnd (kMem x (suc k)) (kAll (suc (suc k)) (kImp (kMem (suc (suc k)) (suc k)) (kEq (suc (suc k)) x))))) $;

theorem sfK0QSepRaw_singleton_named (E: set) (k x: nat):
 $ sfNamedTemplate (sqEnvCons x E) (suc k) 0 sfK0QSepRawSingletonBody = sfK0QSepRawSingletonWitness k x $;

theorem sfK0QSepRaw_singleton_proved (k x: nat) (hk: $ 0 < k $) (hx: $ x < k $):
 $ k218QProvable (sfK0QSepRawSingletonWitness k x) $;

def sfK0QSepRawPairBody: nat = $ (sfEx (sfAnd (sfAnd (sfMem 2 0) (sfMem 1 0)) (sfAll (sfImp (sfMem 0 1) (sfOr (sfEq 0 3) (sfEq 0 2)))))) $;

theorem sfK0QSepRaw_pair_source (E: set) (k b t: nat) (hk: $ 0 < k $) (hb: $ b < k $) (ht: $ t < k $):
 $ k218QProvable (sfNamedTemplate (sqEnvCons t (sqEnvCons b E)) (suc (suc k)) 0 sfK0QSepRawPairBody) $;

def sfK0QSepRawPairWitness (k b t: nat): nat = $ (kExists (suc (suc k)) (kAnd (kAnd (kMem b (suc (suc k))) (kMem t (suc (suc k)))) (kAll (suc (suc (suc k))) (kImp (kMem (suc (suc (suc k))) (suc (suc k))) (kDisj (kEq (suc (suc (suc k))) b) (kEq (suc (suc (suc k))) t)))))) $;

theorem sfK0QSepRaw_pair_named (E: set) (k b t: nat):
 $ sfNamedTemplate (sqEnvCons t (sqEnvCons b E)) (suc (suc k)) 0 sfK0QSepRawPairBody = sfK0QSepRawPairWitness k b t $;

theorem sfK0QSepRaw_pair_proved (k b t: nat) (hk: $ 0 < k $) (hb: $ b < k $) (ht: $ t < k $):
 $ k218QProvable (sfK0QSepRawPairWitness k b t) $;

def sfK0QSepRawTransitiveBody: nat = $ (sfEx (sfAnd (sfMem 1 0) (sfAll (sfImp (sfMem 0 1) (sfAll (sfImp (sfMem 0 1) (sfMem 0 2))))))) $;

theorem sfK0QSepRaw_transitive_source (E: set) (k a: nat) (hk: $ 0 < k $) (ha: $ a < k $):
 $ k218QProvable (sfNamedTemplate (sqEnvCons a E) (suc k) 0 sfK0QSepRawTransitiveBody) $;

def sfK0QSepRawTransitiveWitness (k a: nat): nat = $ (kExists (suc k) (kAnd (kMem a (suc k)) (kAll (suc (suc k)) (kImp (kMem (suc (suc k)) (suc k)) (kAll (suc (suc (suc k))) (kImp (kMem (suc (suc (suc k))) (suc (suc k))) (kMem (suc (suc (suc k))) (suc k)))))))) $;

theorem sfK0QSepRaw_transitive_named (E: set) (k a: nat):
 $ sfNamedTemplate (sqEnvCons a E) (suc k) 0 sfK0QSepRawTransitiveBody = sfK0QSepRawTransitiveWitness k a $;

theorem sfK0QSepRaw_transitive_proved (k a: nat) (hk: $ 0 < k $) (ha: $ a < k $):
 $ k218QProvable (sfK0QSepRawTransitiveWitness k a) $;

def sfK0QSepRawPowerBody: nat = $ (sfEx (sfAll (sfAnd (sfImp (sfMem 0 1) (sfAll (sfImp (sfMem 0 1) (sfMem 0 3)))) (sfImp (sfAll (sfImp (sfMem 0 1) (sfMem 0 3))) (sfMem 0 1))))) $;

theorem sfK0QSepRaw_power_source (E: set) (k a: nat) (hk: $ 0 < k $) (ha: $ a < k $):
 $ k218QProvable (sfNamedTemplate (sqEnvCons a E) (suc k) 0 sfK0QSepRawPowerBody) $;

def sfK0QSepRawPowerWitness (k a: nat): nat = $ (kExists (suc k) (kAll (suc (suc k)) (kAnd (kImp (kMem (suc (suc k)) (suc k)) (kAll (suc (suc (suc k))) (kImp (kMem (suc (suc (suc k))) (suc (suc k))) (kMem (suc (suc (suc k))) a)))) (kImp (kAll (suc (suc (suc k))) (kImp (kMem (suc (suc (suc k))) (suc (suc k))) (kMem (suc (suc (suc k))) a))) (kMem (suc (suc k)) (suc k)))))) $;

theorem sfK0QSepRaw_power_named (E: set) (k a: nat):
 $ sfNamedTemplate (sqEnvCons a E) (suc k) 0 sfK0QSepRawPowerBody = sfK0QSepRawPowerWitness k a $;

