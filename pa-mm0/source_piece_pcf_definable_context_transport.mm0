import "source_piece_pcf_definable_canonical.mm0";

import "source_reflection_least_cond_ord_maps.mm0";

def sfPieceDefinableContextTransportMap(n:nat): set = $ sfLCBinaryMap 0 1 (n + 2) $;

theorem sfPieceDefinableContextTransport_shift_code(a:nat)(hf:$ sfWf a $): $ sfRename sfPieceDefinableParametersUndo 0 (sfShift 0 a) = sfShift 2 a $;

theorem sfPieceDefinableContextTransport_lift(G a:nat)(hf:$ sfWf a $): $ nsLocal G a -> nsLocal (sfPieceDefinableParametersStep @ G) (sfShift 2 a) $;

theorem sfPieceDefinableContextTransportMap_zero(a:nat)(hf:$ sfWf a $): $ sfLCBinary a 0 1 (0 + 2) = a $;

theorem sfPieceDefinableContextTransportMap_step(n a:nat)(hf:$ sfWf a $): $ sfShift 2 (sfLCBinary a 0 1 (n + 2)) = sfLCBinary a 0 1 (suc n + 2) $;

theorem sfPieceDefinableContextTransport_all(n G a:nat)(hf:$ sfWf a $)(ha:$ nsLocal G a $): $ nsLocal (sfPieceDefinableParametersContext n G) (sfLCBinary a 0 1 (n + 2)) $;

theorem sfPieceDefinableContextTransport_named_code(m n phi r A:nat)(hb:$ sfBound n phi $): $ sfLCBinary (sfPieceDefinableNamed n phi r A) 0 1 (m + 2) = sfPieceDefinableNamed n phi (sfPieceDefinableContextTransportMap m @ r) (sfPieceDefinableContextTransportMap m @ A) $;

theorem sfPieceDefinableContextTransport_named(m G n phi r A:nat)(hb:$ sfBound n phi $)(hr:$ nsLocal G (sfPieceDefinableNamed n phi r A) $): $ nsLocal (sfPieceDefinableParametersContext m G) (sfPieceDefinableNamed n phi (sfPieceDefinableContextTransportMap m @ r) (sfPieceDefinableContextTransportMap m @ A)) $;
