@_ abstract def bb215ArithmeticFormulaExQFSat (E: set) (c .x: nat): wff = $ ifp (sfTag c = 7 /\ sfRight c = 0) (E. x bb215ArithmeticFormulaQFSat (paNatTermConsEnvironment E x) (sfLeft c)) (0 != 0) $;

pub theorem bb215ArithmeticFormulaExQFSat_ex (E: set) (c: nat) {x: nat}: $ bb215ArithmeticFormulaExQFSat E (paFormulaEx c) <-> E. x bb215ArithmeticFormulaQFSat (paNatTermConsEnvironment E x) c $ = (named '(bitr (ifppos (ian sfEx_tag sfEx_right)) (!! exeqi x (bb215ArithmeticFormulaQFSateq2 sfEx_left))));
