@_ def sfTVReflectionWitness(n c:nat):nat = $ sfEx (sfAnd sfLeastOrdinalPredicate (sfCLReflection sfLDomain n c 0)) $;

theorem sftvout_reflection_bound(n c:nat)(hb:$ sfBound n c $): $ sfBound 1 (sfCLReflection sfLDomain n c 0) $ = (named '(mpbir sfBound_sfAll (mpbir sfBound_sfImp (ian (sfCLHierarchyAt_bound (ax_mp (bi1 ltsuc) d0lt1) lt01S) (ax_mp (ax_mp sfBound_mono (ax_mp (ax_mp sfCLBall_bound (mpbir (sfSchema_bound_index_eq add12) (mpbir sfBound_iff (ian (ax_mp (ax_mp sfBound_mono (ax_mp (ax_mp sfRelativize_bound sfLDomain_bound) hb)) lesucid) (sfCLSetRel_reflection_bound hb))))) lt01S)) (mpbi lesuc le01))))));

pub theorem sfTVReflectionWitness_body_bound(n c:nat)(hb:$ sfBound n c $): $ sfBound 1 (sfAnd sfLeastOrdinalPredicate (sfCLReflection sfLDomain n c 0)) $ = (named '(mpbir sfBound_sfAnd (ian sfLeastOrdinalPredicate_bound (sftvout_reflection_bound hb))));

pub theorem sfTVReflectionWitness_closed(n c:nat)(hb:$ sfBound n c $): $ sfBound 0 (sfTVReflectionWitness n c) $ = (named '(mpbir sfBound_sfEx (sfTVReflectionWitness_body_bound hb)));

theorem sftvout_profile_witness(n c:nat)(hb:$ sfBound n c $): $ nsLocal ((sfReflectionLimitProfile sfLUniversalHierarchyRelation (sfTVCanonicalPiece n c)) : (sfTVReflectionContext sfLUniversalHierarchyRelation)) (sfTVReflectionWitness n c) $ = (named '(ax_mp (ax_mp nsLocal_ExI (ax_mp sfBound_wf (sfTVReflectionWitness_body_bound hb))) (mpbir (nsLocal_formula_eq (ax_mp sfSubst_bound_top_identity (sfTVReflectionWitness_body_bound hb))) (ax_mp (ax_mp sfLocal_and (mpbi (nsLocal_formula_eq sfTVCLOrdinal_zero) (sfTVProfile_ordinal (ax_mp (ax_mp nsLocal_hyp (mpbir sfContextWf_cons (ian (ax_mp sfBound_wf sfTVCanonicalProfile_bound) (ax_mp (ax_mp sfTheoryContext_wf ssid) (sfTVReflectionContext_closed sfLUniversalHierarchyRelation_bound))))) sfContext_member_head)))) (ax_mp (ax_mp nsLocal_mp (ax_mp (ax_mp nsLocal_weaken (mpbir sfContextWf_cons (ian (ax_mp sfBound_wf sfTVCanonicalProfile_bound) (ax_mp (ax_mp sfTheoryContext_wf ssid) (sfTVReflectionContext_closed sfLUniversalHierarchyRelation_bound))))) sfContextSub_cons (sfTVReflection_from_profile_local hb))) (ax_mp (ax_mp nsLocal_hyp (mpbir sfContextWf_cons (ian (ax_mp sfBound_wf sfTVCanonicalProfile_bound) (ax_mp (ax_mp sfTheoryContext_wf ssid) (sfTVReflectionContext_closed sfLUniversalHierarchyRelation_bound))))) sfContext_member_head))))));

pub theorem sfTVReflectionWitness_from_output_local(n c:nat)(hb:$ sfBound n c $): $ nsLocal (sfTVReflectionContext sfLUniversalHierarchyRelation) (sfImp (sfReflectionLimitOutput sfLUniversalHierarchyRelation (sfTVCanonicalPiece n c)) (sfTVReflectionWitness n c)) $ = (named '(sfTVEx2_project_closed (sfTVReflectionContext_closed sfLUniversalHierarchyRelation_bound) (ax_mp sfBound_wf sfTVCanonicalProfile_bound) (sfTVReflectionWitness_closed hb) (sftvout_profile_witness hb)));

pub theorem sfTVReflectionWitness_from_output_zfr(n c:nat)(hb:$ sfBound n c $)(hE:$ sfTheoryProvable zfrAxioms (sfReflectionCondLevelExists sfLUniversalHierarchyRelation) $)(hS:$ sfTheoryProvable zfrAxioms (sfReflectionHierarchySubsetNormal sfLUniversalHierarchyRelation) $)(hC:$ sfTheoryProvable zfrAxioms (sfReflectionLimitCoverageLaw sfLUniversalHierarchyRelation) $): $ sfTheoryProvable zfrAxioms (sfImp (sfReflectionLimitOutput sfLUniversalHierarchyRelation (sfTVCanonicalPiece n c)) (sfTVReflectionWitness n c)) $ = (named '(ax_mp (ax_mp (sfTheory_lemma_context zfrAxioms_closed) (sfTVReflectionContext_zfr sfLUniversalHierarchyRelation_bound hE hS hC)) (sfTVReflectionWitness_from_output_local hb)));
