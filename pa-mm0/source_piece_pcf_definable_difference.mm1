import "source_piece_pcf_definable_difference_replay.mm1";
import "source_l_background.mm1";
import "source_theory_local.mm1";

def sfPieceDefinableDifferenceFormula:nat = $ pcdfDFormula $;
pub theorem sfPieceDefinableDifference_context: $ pcdfDContext = sfLBackground $ = 'eqid;
pub theorem sfPieceDefinableDifference_local: $ nsLocal sfLBackground sfPieceDefinableDifferenceFormula $ = '(mpbi (nsLocal_context_eq sfPieceDefinableDifference_context) pcdfDCertificate);
pub theorem sfPieceDefinableDifference_zfr: $ sfTheoryProvable zfrAxioms sfPieceDefinableDifferenceFormula $ = '(ax_mp (sfTheory_local sfLBackground_zfr) sfPieceDefinableDifference_local);
