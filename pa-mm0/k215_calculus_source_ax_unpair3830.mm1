pub theorem k215UnpairAt3830Advance (a b n c: nat): $ k215PReach (k215UnpairAt3830State k215PNum3830 a b (suc n) c) (k215UnpairAt3830State k215PNum3830 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
 (named @ induct '(ind) 'a 'k215UnpairAt3830AdvanceZero '(a1i k215UnpairAt3830AdvanceSucc));
@_ abstract def k215UnpairAt3830Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt3830State k215PNum3830 a b n c) (k215UnpairAt3830State k215PNum3838 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
theorem k215UnpairAt3830RunZero (a b c: nat): $ k215UnpairAt3830Run 0 a b c $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt3830Stateeq eqid
     (eqcom (eqtr (fsteq add0) fstpr))
     (eqcom (eqtr (sndeq add0) sndpr)) eqid eqid)) k215UnpairAt3830Reach9Z);
@_ abstract def k215UnpairAt3830Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt3830Run n a b c $;
theorem k215UnpairAt3830Claim_at (n a b c: nat): $ k215UnpairAt3830Claim n c -> k215UnpairAt3830Run n a b c $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215UnpairAt3830CodeStep (a b n: nat): $ (fst (suc (a, b)), snd (suc (a, b))) + n = (a, b) + suc n $ =
 '(eqtr (addeq1 fstsnd) addSass);
theorem k215UnpairAt3830RunInductive (n a b c: nat): $ k215UnpairAt3830Claim n c -> k215UnpairAt3830Run (suc n) a b c $ =
 '(syl (ax_mp k215PReach_trans k215UnpairAt3830Advance)
   (mpbid (a1i (k215PReacheq2 (k215UnpairAt3830Stateeq eqid
