theorem k215UnpairAt3830Step12 (a b n c: nat): $ k215PStep (k215UnpairAt3830State k215PNum3833 a b n c) = (k215UnpairAt3830State k215PNum3837 a b n c) $ = '(k215PAtCB k215PLookupUnpair3830_3833);

theorem k215UnpairAt3830Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt3830State k215PNum3833 a b n c) (k215UnpairAt3830State k215PNum3837 a b n c) $ = '(k215PReach_step k215UnpairAt3830Step12);

theorem k215UnpairAt3830Step16 (a b n c: nat): $ k215PStep (k215UnpairAt3830State k215PNum3837 a b n c) = (k215UnpairAt3830State k215PNum3830 a b n c) $ = '(k215PAtCC k215PLookupUnpair3830_3837);

theorem k215UnpairAt3830Reach16 (a b n c: nat): $ k215PReach (k215UnpairAt3830State k215PNum3837 a b n c) (k215UnpairAt3830State k215PNum3830 a b n c) $ = '(k215PReach_step k215UnpairAt3830Step16);

theorem k215UnpairAt3830CycleZero (b n c: nat): $ k215PReach (k215UnpairAt3830State k215PNum3830 0 b (suc n) c) (k215UnpairAt3830State k215PNum3830 (suc b) 0 n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt3830Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt3830Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt3830Reach11Z) (ax_mp (ax_mp k215PReach_trans k215UnpairAt3830ReachTransfer) k215UnpairAt3830Reach16))));
