theorem k215UnpairAt3830Claim_all (n c: nat): $ k215UnpairAt3830Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt3830RunZero)) '(iald @ iald k215UnpairAt3830RunInductive));
pub theorem k215UnpairMacro3830 (n a b c: nat): $ k215PReach (k215UnpairAt3830State k215PNum3830 a b n c) (k215UnpairAt3830State k215PNum3838 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
