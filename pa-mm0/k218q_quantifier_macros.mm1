  (k218IProvable_syl hq (k218IAll_mono k218IPropK))
  (k218QProvable_mp
    (k218IProvable_syl (k218IVacuity_negation hp) (k218IAll_mono k218IPropNegativeImplication))
    k218IPropCasesImplication));

pub theorem k218IVacuity_universal (x y p: nat)
  (hv: $ k218QProvable (kImp p (kAll y p)) $):
  $ k218QProvable (kImp (kAll x p) (kAll y (kAll x p))) $ =
'(k218IProvable_syl (k218IAll_mono hv) (k218QProvable_axiom k218QAxioms_rho4));

pub theorem k218IVacuity_truth (x: nat):
  $ k218QProvable (kImp 0 (kAll x 0)) $ =
'(k218QProvable_mp (k218QProvable_gen (k218QProvable_axiom k218QAxioms_true)) k218IPropK);

pub theorem k218IAll_exists (x p q: nat):
  $ k218QProvable (kImp (kAll x (kImp p q)) (kImp (kExists x p) (kExists x q))) $ =
'(k218IProvable_syl (k218IAll_mono k218IPropContra)
  (k218IProvable_syl (k218QProvable_axiom k218QAxioms_rho2) k218IPropContra));

pub theorem k218IExists_elimination (x p q: nat)
  (hv: $ k218QProvable (kImp q (kAll x q)) $):
  $ k218QProvable (kImp (kAll x (kImp p q)) (kImp (kExists x p) q)) $ =
'(k218IProvable_syl k218IAll_exists
  (k218QProvable_mp (k218IExists_collapse hv)
    (k218QProvable_mp k218IPropB k218ICd103)));
