import "k230_vacuity.mm0";

-- Every variable and binder occurring in a positive raw code is smaller
-- than that code. Code zero is truth and has no variable occurrences.
def kRawBoundFreshClass (x .c: nat): set = $ {c | c <= x -> kFresh c x} $;

theorem kRawBoundFreshClass_value (c x: nat):
  $ c e. kRawBoundFreshClass x <-> (c <= x -> kFresh c x) $;

theorem kRawBoundFreshClass_closed (x: nat):
  $ kRawConstructionClosed (kRawBoundFreshClass x) $;

theorem kRaw_bound_fresh (c x: nat): $ c <= x -> kFresh c x $;

theorem kRaw_self_fresh (c: nat): $ kFresh c c $;
