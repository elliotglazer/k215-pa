import "bb215_derivability_d2_quant.mm0";
import "pa_proof_numeral_level.mm0";

-- L05, D2 plan layer L0.5 (lanes/L05.md): a theorem at level n stays a theorem, with the
-- same formula code, at every higher level. Uses the checked trace level shift
-- paProofDerives_levelShift_row.

theorem bb215D2_raise (n k c: nat): $ paProvable n c -> paProvable (n + k) c $;

theorem bb215D2_raise_zero (k c: nat) (h: $ paProvable 0 c $): $ paProvable k c $;

theorem bb215D2_raise_suc (n c: nat): $ paProvable n c -> paProvable (suc n) c $;
