import "source_reflection_transfer_witness_maps.mm1";

def sfReflectionPHSubsetBody(level d z y:nat):nat = $ sfImp (sfORBinary level d y) (sfCLSubset y z) $;

def sfReflectionPHSubsetAt(level d z:nat):nat = $ sfAll (sfReflectionPHSubsetBody level (suc d) (suc z) 0) $;

theorem rfwl_body_wf(level d z y:nat): $ sfWf (sfReflectionPHSubsetBody level d z y) $ = (named '(ax_mp (ax_mp sfWf_imp sfORBinary_wf) (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfWf_mem) sfWf_mem))));

theorem rfwl_subset_wf(level d z:nat): $ sfWf (sfReflectionPHSubsetAt level d z) $ = (named '(ax_mp sfWf_all rfwl_body_wf));

theorem rfwl_body_rename(R:set)(level d z y:nat)(hl:$ sfBound 2 level $): $ sfRename R 0 (sfReflectionPHSubsetBody level d z y) = sfReflectionPHSubsetBody level (R @ d) (R @ z) (R @ y) $ = (named '(eqtr sfRename_sfImp (nsImp_eq (sfORBinary_rename (ax_mp sfBound_wf hl)) rfcl_subset_rename)));

theorem rfwl_body_congr(level d dp z zp y yp:nat)(hl:$ sfBound 2 level $)(hd:$ d = dp $)(hz:$ z = zp $)(hy:$ y = yp $): $ sfReflectionPHSubsetBody level d z y = sfReflectionPHSubsetBody level dp zp yp $ = (named '(nsImp_eq (sfORBinary_congr (ax_mp sfBound_wf hl) hd hy) (sfCLSubseteq hy hz)));

theorem rfwl_depth1_zero(R:set): $ sfRenameDepthMap R 1 @ 0 = 0 $ = (named '(eqtr sfRenameDepthMap_value (ax_mp sfRenameIndex_bound d0lt1)));

theorem rfwl_depth1_tail(R:set)(i:nat): $ sfRenameDepthMap R 1 @ suc i = suc (R @ i) $ = (named '(eqtr sfRenameDepthMap_value (eqtr sfRenameIndex_lift (suceq sfRenameIndex_zero))));

pub theorem sfReflectionPHSubsetAt_rename(R:set)(level d z:nat)(hl:$ sfBound 2 level $): $ sfRename R 0 (sfReflectionPHSubsetAt level d z) = sfReflectionPHSubsetAt level (R @ d) (R @ z) $ = (named '(eqtr sfRename_sfAll (nsAll_eq (eqtr (ax_mp sfRename_as_map rfwl_body_wf) (eqtr (rfwl_body_rename hl) (rfwl_body_congr hl rfwl_depth1_tail rfwl_depth1_tail rfwl_depth1_zero))))));

theorem rfwl_subset_congr(level d dp z zp:nat)(hl:$ sfBound 2 level $)(hd:$ d = dp $)(hz:$ z = zp $): $ sfReflectionPHSubsetAt level d z = sfReflectionPHSubsetAt level dp zp $ = (named '(nsAll_eq (rfwl_body_congr hl (suceq hd) (suceq hz) eqid)));

pub theorem sfReflectionPHSubsetAt_shift(level d z:nat)(hl:$ sfBound 2 level $): $ sfShift 0 (sfReflectionPHSubsetAt level d z) = sfReflectionPHSubsetAt level (suc d) (suc z) $ = (named '(eqtr (eqcom (ax_mp sfRename_successor rfwl_subset_wf)) (eqtr (sfReflectionPHSubsetAt_rename hl) (rfwl_subset_congr hl sfSuccessorMap_value sfSuccessorMap_value))));

pub theorem sfReflectionPHSubsetAt_use(G level d z y:nat)(hl:$ sfBound 2 level $)(hS:$ nsLocal G (sfReflectionPHSubsetAt level d z) $)(hL:$ nsLocal G (sfORBinary level d y) $): $ nsLocal G (sfCLSubset y z) $ = (named '(ax_mp (ax_mp nsLocal_mp (mpbi (nsLocal_formula_eq (eqtr (rfwl_body_rename hl) (rfwl_body_congr hl rfcc_cons_suc rfcc_cons_suc rfcc_cons_zero))) (ax_mp (rfcl_all_cons rfwl_body_wf) (mpbir (nsLocal_formula_eq (ax_mp sfRename_identity rfwl_subset_wf)) hS)))) hL));

theorem rfwl_binary_shift(P x y:nat)(hp:$ sfBound 2 P $): $ sfShift 0 (sfORBinary P x y) = sfORBinary P (suc x) (suc y) $ = (named '(eqtr (sfORBinary_shift (ax_mp sfBound_wf hp)) (sfORBinary_congr (ax_mp sfBound_wf hp) sfShiftIndex_zero sfShiftIndex_zero)));

theorem rfwl_level_branch(T F:set)(G start domain level sb sc n i d X z:nat)(hd:$ sfBound 1 domain $)(hl:$ sfBound 2 level $)(hv:$ sfPieceTableValid sb sc n $)(hi:$ i < n $)(hT:$ nsLocal G (sfReflectionTuple T start X (sfPieceCount sb sc i)) $)(hE:$ nsLocal G (sfEx (sfORBinary level (suc d) 0)) $)(hP:$ nsLocal G (sfORBinary (sfPieceBinary domain (sfReflectionPCLevel level) sb sc n) d X) $)(hS:$ nsLocal G (sfReflectionPHSubsetAt level d z) $): $ nsLocal ((sfORBinary level (suc d) 0) : sfContextShift G) (sfShift 0 (sfReflectionTupleEw T start domain (sfPieceMatrix sb sc i) z)) $ = (named '(mpbir (nsLocal_formula_eq (sfReflectionTupleEw_shift hd (ax_mp sfBound_wf (ax_mp (ax_mp sfPieceTableValid_at hv) hi)))) (! sfReflectionPH_tuple_local $ T $ $ F $ $ ((sfORBinary level (suc d) 0) : sfContextShift G) $ $ suc start $ $ domain $ $ level $ $ sb $ $ sc $ $ n $ $ i $ $ suc d $ $ suc X $ $ 0 $ $ suc z $ hd hl hv hi (mpbi (nsLocal_formula_eq sfReflectionTuple_zero_shift) (ax_mp (ax_mp (ax_mp nsLocal_weaken (mpbir sfContextWf_cons (ian sfORBinary_wf sfContextShift_wf))) sfContextSub_cons) (ax_mp sfSepLocal_shift hT))) (ax_mp (ax_mp nsLocal_hyp (mpbir sfContextWf_cons (ian sfORBinary_wf sfContextShift_wf))) sfContext_member_head) (mpbi (nsLocal_formula_eq (rfwl_binary_shift (ax_mp (ax_mp (ax_mp sfPieceBinary_bound hd) (sfReflectionPCLevel_bound hl)) hv))) (ax_mp (ax_mp (ax_mp nsLocal_weaken (mpbir sfContextWf_cons (ian sfORBinary_wf sfContextShift_wf))) sfContextSub_cons) (ax_mp sfSepLocal_shift hP))) (sfReflectionPHSubsetAt_use hl (mpbi (nsLocal_formula_eq (sfReflectionPHSubsetAt_shift hl)) (ax_mp (ax_mp (ax_mp nsLocal_weaken (mpbir sfContextWf_cons (ian sfORBinary_wf sfContextShift_wf))) sfContextSub_cons) (ax_mp sfSepLocal_shift hS))) (ax_mp (ax_mp nsLocal_hyp (mpbir sfContextWf_cons (ian sfORBinary_wf sfContextShift_wf))) sfContext_member_head)))));

pub theorem sfReflectionPH_level_eliminate(T F:set)(G start domain level sb sc n i d X z:nat)(hd:$ sfBound 1 domain $)(hl:$ sfBound 2 level $)(hv:$ sfPieceTableValid sb sc n $)(hi:$ i < n $)(hT:$ nsLocal G (sfReflectionTuple T start X (sfPieceCount sb sc i)) $)(hE:$ nsLocal G (sfEx (sfORBinary level (suc d) 0)) $)(hP:$ nsLocal G (sfORBinary (sfPieceBinary domain (sfReflectionPCLevel level) sb sc n) d X) $)(hS:$ nsLocal G (sfReflectionPHSubsetAt level d z) $): $ nsLocal G (sfReflectionTupleEw T start domain (sfPieceMatrix sb sc i) z) $ = (named '(ax_mp (ax_mp (sfLocal_exE (sfReflectionTupleEw_wf hd)) hE) (! rfwl_level_branch $ T $ $ F $ $ G $ $ start $ $ domain $ $ level $ $ sb $ $ sc $ $ n $ $ i $ $ d $ $ X $ $ z $ hd hl hv hi hT hE hP hS)));
