import "b4_zfc_c1.mm0";

theorem bdIn_cert (a l: nat) {x yy ll: nat}: $ a IN l -> bdCertF bdtIn a l 0 0 $;
theorem bdSub_cert (g h: nat) {x yy ll: nat}: $ sfContextSub g h -> bdCertF bdtSub g h 0 0 $;
theorem bdRecon (y t: nat): $ sfTag y = t -> y = sfNode t (sfLeft y) (sfRight y) $;
theorem bdRecon0 (y t: nat): $ sfTag y = t -> sfRight y = 0 -> y = sfNode t (sfLeft y) 0 $;
theorem bdLt8c (t: nat): $ t < 8 -> t = 0 \/ t = 1 \/ t = 2 \/ t = 3 \/ t = 4 \/ t = 5 \/ t = 6 \/ t = 7 $;
theorem bdWf_ih (y z: nat) {x: nat}: $ A. x (x < y -> (sfWf x -> bdCertF bdtWf x 0 0 0)) -> z e. sfPrevious y -> bdCertF bdtWf z 0 0 0 $;
theorem bdWf_cert (n: nat) {x y: nat}: $ sfWf n -> bdCertF bdtWf n 0 0 0 $;
theorem bdCwf_cert (g: nat) {x yy ll: nat}: $ sfContextWf g -> bdCertF bdtCwf g 0 0 0 $;
theorem bdRowSeqEq (r: nat): $ fst r = 0 -> r = sfSequent (fst (snd r)) (snd (snd r)) $;
theorem bdRowBrEq (r: nat): $ fst r = 1 -> r = sfBranches (fst (snd r)) (fst (snd (snd r))) (fst (snd (snd (snd r)))) (snd (snd (snd (snd r)))) $;
theorem bdRow_cert (r: nat): $ sfRowWf r -> bdCertF bdtRow r 0 0 0 $;
theorem bdBnd_ih {x w w2: nat} (y z: nat) (n: nat w): $ A. x (x < y -> A. w (sfBound w x -> bdCertF bdtBnd w x 0 0)) -> z < y -> sfBound n z -> bdCertF bdtBnd n z 0 0 $;
theorem bdBnd_cert (n c: nat) {x y w: nat}: $ sfBound n c -> bdCertF bdtBnd n c 0 0 $;
theorem bdAP_cert (n c: nat) {x y: nat}: $ bdCertF bdtAllPre n c (sfAllPrefix n c) 0 $;
