import "quotation_rebase_quote.mm1";
import "quotation_contexts.mm1";

-- A first-order numerical environment. Out-of-range lookup is zero; live
-- environment support is required only below its explicit list length.
@_ abstract def sqZeroEnvironment (.i: nat): set = $ \ i, 0 $;
@_ def sqNumericEnvironment (S: nat): set = $ sqStackEnv S sqZeroEnvironment $;
pub theorem sqZeroEnvironment_value (i: nat): $ sqZeroEnvironment @ i = 0 $ =
(named '(!! applame j ,eqtac));
pub theorem sqNumericEnvironment_nil (i: nat): $ sqNumericEnvironment 0 @ i = 0 $ =
'(eqtr sqStackEnv_nil sqZeroEnvironment_value);
pub theorem sqNumericEnvironment_cons_zero (a S: nat):
 $ sqNumericEnvironment (a : S) @ 0 = a $ = 'sqStackEnv_cons_zero;
pub theorem sqNumericEnvironment_cons_suc (a S i: nat):
 $ sqNumericEnvironment (a : S) @ suc i = sqNumericEnvironment S @ i $ = 'sqStackEnv_cons_suc;
pub theorem sqNumericEnvironment_cons_agree (a S n: nat):
 $ sqEnvAgree (sqNumericEnvironment (a : S)) (sqEnvCons a (sqNumericEnvironment S)) n $ =
'sqStackEnv_cons_agree;

@_ abstract def sqEnvironmentBelow (S k .i: nat): wff =
 $ A. i (i < len S -> sqNumericEnvironment S @ i < k) $;
pub theorem sqEnvironmentBelow_at (S k i: nat):
 $ sqEnvironmentBelow S k -> i < len S -> sqNumericEnvironment S @ i < k $ =
(named '(!! eale j ,eqtac));
pub theorem sqEnvironmentBelow_nil (k: nat): $ sqEnvironmentBelow 0 k $ =
(named '(ax_gen @ absurd (mpbir (noteq (lteq2 len0)) lt02)));
theorem sqSE_below_cons_zero (S k a: nat):
 $ a < k -> sqEnvironmentBelow S k -> 0 < len (a : S) -> sqNumericEnvironment (a : S) @ 0 < k $ =
'(a1d @ a1d @ mpbird (a1i (lteq1 sqNumericEnvironment_cons_zero)) id);
theorem sqSE_below_cons_suc (S k a i: nat):
 $ a < k -> sqEnvironmentBelow S k -> suc i < len (a : S) -> sqNumericEnvironment (a : S) @ suc i < k $ =
'(a1i @ syl6 (bi2 (lteq1 sqNumericEnvironment_cons_suc)) @
 syl5 (syl (bi2 ltsuc) (bi1 (lteq2 lenS))) sqEnvironmentBelow_at);
theorem sqSE_below_cons_at (S k a i: nat):
 $ a < k -> sqEnvironmentBelow S k -> i < len (a : S) -> sqNumericEnvironment (a : S) @ i < k $ =
(named @ induct '(ind) 'i 'sqSE_below_cons_zero '(a1i sqSE_below_cons_suc));
pub theorem sqEnvironmentBelow_cons (S k a: nat):
 $ a < k -> sqEnvironmentBelow S k -> sqEnvironmentBelow (a : S) k $ =
(named '(exp @ !! iald i @ mpd anr (syl sqSE_below_cons_at anl)));
pub theorem sqEnvironmentBelow_mono (S k l: nat):
 $ k <= l -> sqEnvironmentBelow S k -> sqEnvironmentBelow S l $ =
(named '(exp @ !! iald i @ exp @
 ltletrd (mpd anr (syl sqEnvironmentBelow_at anlr)) anll));

@_ def sqEnvironmentSafe (S n t k: nat): wff =
 $ n <= len S /\ (0 < k /\ (t < k /\ sqEnvironmentBelow S k)) $;
pub theorem sqEnvironmentSafe_length (S n t k: nat):
 $ sqEnvironmentSafe S n t k -> n <= len S $ = 'anl;
pub theorem sqEnvironmentSafe_positive (S n t k: nat):
 $ sqEnvironmentSafe S n t k -> 0 < k $ = '(syl anl anr);
pub theorem sqEnvironmentSafe_tag (S n t k: nat):
 $ sqEnvironmentSafe S n t k -> t < k $ = '(syl anl (syl anr anr));
pub theorem sqEnvironmentSafe_below (S n t k: nat):
 $ sqEnvironmentSafe S n t k -> sqEnvironmentBelow S k $ = '(syl anr (syl anr anr));
pub theorem sqEnvironmentSafe_index (S n t k i: nat):
 $ sqEnvironmentSafe S n t k -> i < n -> sqNumericEnvironment S @ i < k $ =
'(exp @ mpd (ltletrd anr (syl sqEnvironmentSafe_length anl))
 (syl sqEnvironmentBelow_at (syl sqEnvironmentSafe_below anl)));
pub theorem sqEnvironmentSafe_cutoff (S n m t k: nat):
 $ n <= m -> sqEnvironmentSafe S m t k -> sqEnvironmentSafe S n t k $ =
'(exp @ iand (letrd anl (syl sqEnvironmentSafe_length anr)) (syl anr anr));
pub theorem sqEnvironmentSafe_cons (S n t k a: nat):
 $ a < k -> sqEnvironmentSafe S n t k -> sqEnvironmentSafe (a : S) (suc n) t k $ =
'(exp @ iand
 (mpbird (a1i (leeq2 lenS)) (syl (bi1 lesuc) (syl sqEnvironmentSafe_length anr)))
 (iand (syl sqEnvironmentSafe_positive anr)
 (iand (syl sqEnvironmentSafe_tag anr)
 (mpd (syl sqEnvironmentSafe_below anr) (syl sqEnvironmentBelow_cons anl)))));

@_ abstract def sqDomainSupport (H S t .i: nat): wff =
 $ A. i (i < len S -> kHypProvable H (kMem t (sqNumericEnvironment S @ i))) $;
pub theorem sqDomainSupport_at (H S t i: nat):
 $ sqDomainSupport H S t -> i < len S -> kHypProvable H (kMem t (sqNumericEnvironment S @ i)) $ =
(named '(!! eale j ,eqtac));
pub theorem sqDomainSupport_nil (H t: nat): $ sqDomainSupport H 0 t $ =
(named '(ax_gen @ absurd (mpbir (noteq (lteq2 len0)) lt02)));
theorem sqSE_domain_cons_zero (H S t a: nat):
 $ kHypProvable H (kMem t a) -> sqDomainSupport H S t ->
 0 < len (a : S) -> kHypProvable H (kMem t (sqNumericEnvironment (a : S) @ 0)) $ =
'(a1d @ a1d @ mpbird (a1i (kHypProvableeq2 (kMemeq2 sqNumericEnvironment_cons_zero))) id);
theorem sqSE_domain_cons_suc (H S t a i: nat):
 $ kHypProvable H (kMem t a) -> sqDomainSupport H S t ->
 suc i < len (a : S) -> kHypProvable H (kMem t (sqNumericEnvironment (a : S) @ suc i)) $ =
'(a1i @ syl6 (bi2 (kHypProvableeq2 (kMemeq2 sqNumericEnvironment_cons_suc))) @
 syl5 (syl (bi2 ltsuc) (bi1 (lteq2 lenS))) sqDomainSupport_at);
theorem sqSE_domain_cons_at (H S t a i: nat):
 $ kHypProvable H (kMem t a) -> sqDomainSupport H S t ->
 i < len (a : S) -> kHypProvable H (kMem t (sqNumericEnvironment (a : S) @ i)) $ =
(named @ induct '(ind) 'i 'sqSE_domain_cons_zero '(a1i sqSE_domain_cons_suc));
pub theorem sqDomainSupport_cons (H S t a: nat):
 $ kHypProvable H (kMem t a) -> sqDomainSupport H S t -> sqDomainSupport H (a : S) t $ =
(named '(exp @ !! iald i @ mpd anr (syl sqSE_domain_cons_at anl)));
pub theorem sqDomainSupport_refine (H J S t: nat):
 $ kContextSupports J H -> sqDomainSupport H S t -> sqDomainSupport J S t $ =
(named '(exp @ !! iald i @ exp @
 mpd (mpd anr (syl sqDomainSupport_at anlr)) (syl kHypProvable_refine_d anll)));

@_ def sqSourceSupport (H S t k G: nat): wff =
 $ kContextSupports H (sqContext (sqNumericEnvironment S) t k 0 G) $;
pub theorem sqSourceSupport_member (H S t k G a: nat):
 $ sqSourceSupport H S t k G -> a IN G -> kHypProvable H (sqQuote (sqNumericEnvironment S) t k 0 a) $ =
'(syl5 sqContext_member kContextSupports_member);
pub theorem sqSourceSupport_nil (H S t k: nat): $ sqSourceSupport H S t k 0 $ =
'(mpbir (kContextSupportseq2 sqContext_nil) kContextSupports_nil);
pub theorem sqSourceSupport_self (S t k G: nat):
 $ sqSourceSupport (sqContext (sqNumericEnvironment S) t k 0 G) S t k G $ =
'kContextSupports_self;
