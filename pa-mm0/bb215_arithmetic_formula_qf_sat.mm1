import "bb215_arithmetic_formula_term_value.mm1";

import "pa_formula_syntax.mm1";

@_ abstract def bb215ArithmeticFormulaQFSatBody (E: set) (c h: nat): wff = $ ifp (c = 0) (0 != 0)
 (ifp (sfTag c = 1) (bb215ArithmeticFormulaTermValue E (sfLeft c) = bb215ArithmeticFormulaTermValue E (sfRight c))
 (ifp (sfTag c = 3) (sfLeft c e. h /\ sfRight c e. h)
 (ifp (sfTag c = 4) (sfLeft c e. h \/ sfRight c e. h)
 (ifp (sfTag c = 5) (sfLeft c e. h -> sfRight c e. h) (0 != 0))))) $;

@_ abstract def bb215ArithmeticFormulaQFSatStep (E: set) (.c .h: nat): set = $ S\ c, {h | bb215ArithmeticFormulaQFSatBody E c h} $;

@_ abstract def bb215ArithmeticFormulaQFSat (E: set) (c: nat): wff = $ srecp (bb215ArithmeticFormulaQFSatStep E) c $;

@_ abstract def bb215ArithmeticFormulaQFSatPrevious (E: set) (c .i: nat): nat = $ sep (upto c) {i | srecp (bb215ArithmeticFormulaQFSatStep E) i} $;

pub theorem bb215ArithmeticFormulaQFSatStep_value (E: set) (c h: nat): $ (c, h) e. bb215ArithmeticFormulaQFSatStep E <-> bb215ArithmeticFormulaQFSatBody E c h $ = (named '(elsabe @ elabed ,eqtac));

pub theorem bb215ArithmeticFormulaQFSatPrevious_value (E: set) (c a: nat): $ a e. bb215ArithmeticFormulaQFSatPrevious E c <-> a < c /\ bb215ArithmeticFormulaQFSat E a $ = (named '(bitr elsep @ bitr (aneq1i elupto) (aneq2i (elabe ,eqtac))));

pub theorem bb215ArithmeticFormulaQFSat_unfold (E: set) (c: nat): $ bb215ArithmeticFormulaQFSat E c <-> bb215ArithmeticFormulaQFSatBody E c (bb215ArithmeticFormulaQFSatPrevious E c) $ = (named '(bitr srecpval bb215ArithmeticFormulaQFSatStep_value));

theorem bb215ArithmeticFormulaQFSatBody_Equal (E: set) (c h: nat) (h0: $ c != 0 $) (ht: $ sfTag c = 1 $): $ bb215ArithmeticFormulaQFSatBody E c h <-> bb215ArithmeticFormulaTermValue E (sfLeft c) = bb215ArithmeticFormulaTermValue E (sfRight c) $ = (named '(bitr (ifpneg h0) (ifppos ht)));

theorem bb215ArithmeticFormulaQFSatBody_And (E: set) (c h: nat) (h0: $ c != 0 $) (ht: $ sfTag c = 3 $): $ bb215ArithmeticFormulaQFSatBody E c h <-> sfLeft c e. h /\ sfRight c e. h $ = (named '(bitr (ifpneg h0) (bitr (ifpneg (mpbir (noteq (eqeq1 ht)) (ltneri (ltletr ltsucid lesucid)))) (ifppos ht))));

theorem bb215ArithmeticFormulaQFSatBody_Or (E: set) (c h: nat) (h0: $ c != 0 $) (ht: $ sfTag c = 4 $): $ bb215ArithmeticFormulaQFSatBody E c h <-> sfLeft c e. h \/ sfRight c e. h $ = (named '(bitr (ifpneg h0) (bitr (ifpneg (mpbir (noteq (eqeq1 ht)) (ltneri (ltletr (ltletr ltsucid lesucid) lesucid)))) (bitr (ifpneg (mpbir (noteq (eqeq1 ht)) (ltneri ltsucid))) (ifppos ht)))));

theorem bb215ArithmeticFormulaQFSatBody_Imp (E: set) (c h: nat) (h0: $ c != 0 $) (ht: $ sfTag c = 5 $): $ bb215ArithmeticFormulaQFSatBody E c h <-> sfLeft c e. h -> sfRight c e. h $ = (named '(bitr (ifpneg h0) (bitr (ifpneg (mpbir (noteq (eqeq1 ht)) (ltneri (ltletr (ltletr (ltletr ltsucid lesucid) lesucid) lesucid)))) (bitr (ifpneg (mpbir (noteq (eqeq1 ht)) (ltneri (ltletr ltsucid lesucid)))) (bitr (ifpneg (mpbir (noteq (eqeq1 ht)) (ltneri ltsucid))) (ifppos ht))))));

theorem bb215ArithmeticFormulaQFSatPrevious_child (E: set) (c a: nat) (hl: $ sfLeft c = a $) (ha: $ a < c $): $ sfLeft c e. bb215ArithmeticFormulaQFSatPrevious E c <-> bb215ArithmeticFormulaQFSat E a $ = (named '(bitr (eleq1 hl) (bitr bb215ArithmeticFormulaQFSatPrevious_value (bian1 ha))));

theorem bb215ArithmeticFormulaQFSatPrevious_right (E: set) (c a: nat) (hl: $ sfRight c = a $) (ha: $ a < c $): $ sfRight c e. bb215ArithmeticFormulaQFSatPrevious E c <-> bb215ArithmeticFormulaQFSat E a $ = (named '(bitr (eleq1 hl) (bitr bb215ArithmeticFormulaQFSatPrevious_value (bian1 ha))));

pub theorem bb215ArithmeticFormulaQFSat_false (E: set): $ bb215ArithmeticFormulaQFSat E paFormulaFalse <-> 0 != 0 $ = (named '(bitr bb215ArithmeticFormulaQFSat_unfold (ifppos eqid)));

pub theorem bb215ArithmeticFormulaQFSat_equal (E: set) (a b: nat): $ bb215ArithmeticFormulaQFSat E (paFormulaEqual a b) <-> bb215ArithmeticFormulaTermValue E a = bb215ArithmeticFormulaTermValue E b $ = (named '(bitr bb215ArithmeticFormulaQFSat_unfold (bitr (bb215ArithmeticFormulaQFSatBody_Equal sfMem_ne_sfBot sfMem_tag) (eqeq (bb215ArithmeticFormulaTermValueeq2 sfMem_left) (bb215ArithmeticFormulaTermValueeq2 sfMem_right)))));

pub theorem bb215ArithmeticFormulaQFSat_and (E: set) (a b: nat): $ bb215ArithmeticFormulaQFSat E (paFormulaAnd a b) <-> (bb215ArithmeticFormulaQFSat E a /\ bb215ArithmeticFormulaQFSat E b) $ = (named '(bitr bb215ArithmeticFormulaQFSat_unfold (bitr (bb215ArithmeticFormulaQFSatBody_And sfAnd_ne_sfBot sfAnd_tag) (aneq (bb215ArithmeticFormulaQFSatPrevious_child sfAnd_left sfAnd_left_lt) (bb215ArithmeticFormulaQFSatPrevious_right sfAnd_right sfAnd_right_lt)))));

pub theorem bb215ArithmeticFormulaQFSat_or (E: set) (a b: nat): $ bb215ArithmeticFormulaQFSat E (paFormulaOr a b) <-> (bb215ArithmeticFormulaQFSat E a \/ bb215ArithmeticFormulaQFSat E b) $ = (named '(bitr bb215ArithmeticFormulaQFSat_unfold (bitr (bb215ArithmeticFormulaQFSatBody_Or sfOr_ne_sfBot sfOr_tag) (oreq (bb215ArithmeticFormulaQFSatPrevious_child sfOr_left sfOr_left_lt) (bb215ArithmeticFormulaQFSatPrevious_right sfOr_right sfOr_right_lt)))));

pub theorem bb215ArithmeticFormulaQFSat_imp (E: set) (a b: nat): $ bb215ArithmeticFormulaQFSat E (paFormulaImp a b) <-> (bb215ArithmeticFormulaQFSat E a -> bb215ArithmeticFormulaQFSat E b) $ = (named '(bitr bb215ArithmeticFormulaQFSat_unfold (bitr (bb215ArithmeticFormulaQFSatBody_Imp sfImp_ne_sfBot sfImp_tag) (imeqi (bb215ArithmeticFormulaQFSatPrevious_child sfImp_left sfImp_left_lt) (bb215ArithmeticFormulaQFSatPrevious_right sfImp_right sfImp_right_lt)))));
