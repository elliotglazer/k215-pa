theorem sfLeastOrdinalParametersContext_proved(n phi:nat)(hb:$ sfBound (suc n) phi $): $ all (sfTheoryProofClass zfrAxioms) (sfLeastOrdinalParametersContext phi) $;

theorem sfLeastOrdinalParameters_zfr_meta(n phi:nat)(hb:$ sfBound (suc n) phi $): $ sfTheoryProvable zfrAxioms (sfLeastOrdinalLaw phi) $;

theorem sfLeastOrdinalParameters_zfr(n phi:nat): $ sfBound (suc n) phi -> sfTheoryProvable zfrAxioms (sfLeastOrdinalLaw phi) $;

theorem sfLeastOrdinalParameters_all_zfr(n phi:nat): $ sfBound (suc n) phi -> sfTheoryProvable zfrAxioms (sfAllPrefix n (sfLeastOrdinalLaw phi)) $;
