import "k215_calculus_source_ax_stack_loops.mm1";
import "k215_literal_runtime_reach.mm1";
import "k215_calculus_source_pairing.mm1";
import "k215_calculus_source_ax_stack_lookups.mm1";

@_ def k215PairAt3447State (pc a b t c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) b (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) a t (k215PR8 c)) $;

do (apply (register-eqd 'k215PairAt3447State) '(k215PairAt3447Stateeqd));

theorem k215PairAt3447TransferIn (a b t c: nat): $ k215PIter (4 * b + 1) (k215PairAt3447State k215PNum3447 a b t c) = (k215PairAt3447State k215PNum3451 (a + b) 0 (t + b) c) $ =
 '(eqtr k215Loop3447Vector (k215PStateeq2 (k215PVectoreq eqid eqid eqid eqid eqid eqid addcom addcom eqid)));
theorem k215PairAt3447TransferBack (a t c: nat): $ k215PIter (3 * a + 1) (k215PairAt3447State k215PNum3453 a 0 t c) = (k215PairAt3447State k215PNum3456 0 a t c) $ =
 '(eqtr k215Loop3453Vector (k215PStateeq2 (k215PVectoreq2 add0)));
pub theorem k215PairAt3447ReachIn (a b t c: nat): $ k215PReach (k215PairAt3447State k215PNum3447 a b t c) (k215PairAt3447State k215PNum3451 (a + b) 0 (t + b) c) $ =
 '(k215PReach_intro k215PairAt3447TransferIn);
theorem k215PairAt3447ReachBack (a t c: nat): $ k215PReach (k215PairAt3447State k215PNum3453 a 0 t c) (k215PairAt3447State k215PNum3456 0 a t c) $ =
 '(k215PReach_intro k215PairAt3447TransferBack);


theorem k215PairAt3447Step50Z (b t c: nat): $ k215PStep (k215PairAt3447State k215PNum3451 0 b t c) = (k215PairAt3447State k215PNum3457 0 b t c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupPair3447_3451) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215PairAt3447Reach50Z (b t c: nat): $ k215PReach (k215PairAt3447State k215PNum3451 0 b t c) (k215PairAt3447State k215PNum3457 0 b t c) $ = '(k215PReach_step k215PairAt3447Step50Z);

theorem k215PairAt3447Step50S (a b t c: nat): $ k215PStep (k215PairAt3447State k215PNum3451 (suc a) b t c) = (k215PairAt3447State k215PNum3452 a b t c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupPair3447_3451) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215PairAt3447Reach50S (a b t c: nat): $ k215PReach (k215PairAt3447State k215PNum3451 (suc a) b t c) (k215PairAt3447State k215PNum3452 a b t c) $ = '(k215PReach_step k215PairAt3447Step50S);

theorem k215PairAt3447Step51 (a b t c: nat): $ k215PStep (k215PairAt3447State k215PNum3452 a b t c) = (k215PairAt3447State k215PNum3453 a b (suc t) c) $ = '(eqtr (k215PAtCI k215PLookupPair3447_3452) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215PairAt3447Reach51 (a b t c: nat): $ k215PReach (k215PairAt3447State k215PNum3452 a b t c) (k215PairAt3447State k215PNum3453 a b (suc t) c) $ = '(k215PReach_step k215PairAt3447Step51);

theorem k215PairAt3447Step55 (a b t c: nat): $ k215PStep (k215PairAt3447State k215PNum3456 a b t c) = (k215PairAt3447State k215PNum3447 a b t c) $ = '(k215PAtCC k215PLookupPair3447_3456);

theorem k215PairAt3447Reach55 (a b t c: nat): $ k215PReach (k215PairAt3447State k215PNum3456 a b t c) (k215PairAt3447State k215PNum3447 a b t c) $ = '(k215PReach_step k215PairAt3447Step55);

theorem k215PairAt3447Prefix (k t c: nat): $ k215PReach (k215PairAt3447State k215PNum3451 (suc k) 0 t c) (k215PairAt3447State k215PNum3447 0 k (suc t) c) $ = '(ax_mp (ax_mp k215PReach_trans k215PairAt3447Reach50S) (ax_mp (ax_mp k215PReach_trans k215PairAt3447Reach51) (ax_mp (ax_mp k215PReach_trans k215PairAt3447ReachBack) k215PairAt3447Reach55)));
theorem k215PairAt3447ReachSum (a b t k c: nat): $ a + b = suc k -> k215PReach (k215PairAt3447State k215PNum3447 a b t c) (k215PairAt3447State k215PNum3451 (suc k) 0 (t + b) c) $ =
 '(mpbid (k215PReacheq2d (k215PairAt3447Stateeq2d id)) (a1i k215PairAt3447ReachIn));
pub theorem k215PairAt3447Cycle (a b t k c: nat): $ a + b = suc k -> k215PReach (k215PairAt3447State k215PNum3447 a b t c) (k215PairAt3447State k215PNum3447 0 k (suc (t + b)) c) $ =
 '(mpd (a1i k215PairAt3447Prefix) (syl k215PReach_trans k215PairAt3447ReachSum));
theorem k215PairAt3447ReachZeroIn (t c: nat): $ k215PReach (k215PairAt3447State k215PNum3447 0 0 t c) (k215PairAt3447State k215PNum3451 0 0 t c) $ =
 '(mpbi (k215PReacheq2 (k215PairAt3447Stateeq eqid add0 eqid add0 eqid)) k215PairAt3447ReachIn);
pub theorem k215PairAt3447Base (t c: nat): $ k215PReach (k215PairAt3447State k215PNum3447 0 0 t c) (k215PairAt3447State k215PNum3457 0 0 t c) $ =
 '(ax_mp (ax_mp k215PReach_trans k215PairAt3447ReachZeroIn) k215PairAt3447Reach50Z);


@_ abstract def k215PairAt3447Run (a b t c: nat): wff =
 $ k215PReach (k215PairAt3447State k215PNum3447 a b t c) (k215PairAt3447State k215PNum3457 0 0 (t + (a, b)) c) $;
do (apply (register-eqd 'k215PairAt3447Run) '(k215PairAt3447Runeqd));
theorem k215PairAt3447RunZero (t c: nat): $ k215PairAt3447Run 0 0 t c $ =
 '(mpbi (k215PReacheq2 (k215PairAt3447Stateeq4 (eqcom (eqtr (addeq2 pr0) add0)))) k215PairAt3447Base);
theorem k215PairAt3447RunBase (a b t c: nat): $ a + b = 0 -> k215PairAt3447Run a b t c $ =
 '(mpbiri k215PairAt3447RunZero (k215PairAt3447Runeqd
   (syl anl (bi1 addeq0)) (syl anr (bi1 addeq0)) eqidd eqidd));
theorem k215PairAt3447SumStep (a b k: nat): $ a + b = suc k -> (a, b) = b + suc (0, k) $ =
 '(eqtrd (a1i preqadd) (eqtrd (addeq1d (preq1d id))
   (a1i (eqtr (addeq1 k215PairDiagonal_rotate) addcom))));
theorem k215PairAt3447Accumulator (a b t k: nat): $ a + b = suc k -> suc (t + b) + (0, k) = t + (a, b) $ =
 '(eqtrd
   (a1i (eqtr addS1 (eqtr (suceq addass)
     (eqtr (eqcom addS) (addeq2 (eqcom addS))))))
   (addeq2d (eqcomd k215PairAt3447SumStep)));
@_ abstract def k215PairAt3447Claim (k c: nat) (.a .b .t: nat): wff =
 $ A. a A. b A. t (a + b = k -> k215PairAt3447Run a b t c) $;
theorem k215PairAt3447Claim_at (a b t k c: nat): $ k215PairAt3447Claim k c -> a + b = k -> k215PairAt3447Run a b t c $ =
 (named '(!! ealie i @ !! ealde j @ !! ealde l @ bi1d ,eqtac));
theorem k215PairAt3447RunInductive (a b t k c: nat): $ k215PairAt3447Claim k c -> a + b = suc k -> k215PairAt3447Run a b t c $ =
 '(exp @ mpd
   (mpbid
     (k215PReacheq2d (k215PairAt3447Stateeq4d (syl k215PairAt3447Accumulator anr)))
     (mpd (a1i add01) (syl k215PairAt3447Claim_at anl)))
   (syl k215PReach_trans (syl k215PairAt3447Cycle anr)));
theorem k215PairAt3447Claim_all (k c: nat): $ k215PairAt3447Claim k c $ =
 (named @ induct '(ind) 'k
   '(ax_gen (ax_gen (ax_gen k215PairAt3447RunBase)))
   '(iald @ iald @ iald k215PairAt3447RunInductive));
pub theorem k215PairMacro3447 (a b t c: nat): $ k215PReach (k215PairAt3447State k215PNum3447 a b t c) (k215PairAt3447State k215PNum3457 0 0 (t + (a, b)) c) $ =
 '(ax_mp (ax_mp k215PairAt3447Claim_at k215PairAt3447Claim_all) eqid);


