@_ def k215UnpairAt2140State (pc a b n c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) n (k215PR3 c) (k215PR4 c) (k215PR5 c) a b (k215PR8 c)) $;

do (apply (register-eqd 'k215UnpairAt2140State) '(k215UnpairAt2140Stateeqd));

theorem k215UnpairAt2140Transfer (b n c: nat): $ k215PIter (3 * b + 1) (k215UnpairAt2140State k215PNum2144 0 b n c) = (k215UnpairAt2140State k215PNum2147 b 0 n c) $ =
 '(eqtr k215Loop2144Vector (k215PStateeq2 (k215PVectoreq7 add0)));
theorem k215UnpairAt2140ReachTransfer (b n c: nat): $ k215PReach (k215UnpairAt2140State k215PNum2144 0 b n c) (k215UnpairAt2140State k215PNum2147 b 0 n c) $ =
 '(k215PReach_intro k215UnpairAt2140Transfer);


theorem k215UnpairAt2140Step9Z (a b c: nat): $ k215PStep (k215UnpairAt2140State k215PNum2140 a b 0 c) = (k215UnpairAt2140State k215PNum2148 a b 0 c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair2140_2140) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt2140Reach9Z (a b c: nat): $ k215PReach (k215UnpairAt2140State k215PNum2140 a b 0 c) (k215UnpairAt2140State k215PNum2148 a b 0 c) $ = '(k215PReach_step k215UnpairAt2140Step9Z);

theorem k215UnpairAt2140Step9S (a b n c: nat): $ k215PStep (k215UnpairAt2140State k215PNum2140 a b (suc n) c) = (k215UnpairAt2140State k215PNum2141 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair2140_2140) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet2_vector)) (eqtr k215PSet2_vector (k215PVectoreq3 (eqtr subSS sub02))))));

theorem k215UnpairAt2140Reach9S (a b n c: nat): $ k215PReach (k215UnpairAt2140State k215PNum2140 a b (suc n) c) (k215UnpairAt2140State k215PNum2141 a b n c) $ = '(k215PReach_step k215UnpairAt2140Step9S);

theorem k215UnpairAt2140Step10 (a b n c: nat): $ k215PStep (k215UnpairAt2140State k215PNum2141 a b n c) = (k215UnpairAt2140State k215PNum2142 a (suc b) n c) $ = '(eqtr (k215PAtCI k215PLookupUnpair2140_2141) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215UnpairAt2140Reach10 (a b n c: nat): $ k215PReach (k215UnpairAt2140State k215PNum2141 a b n c) (k215UnpairAt2140State k215PNum2142 a (suc b) n c) $ = '(k215PReach_step k215UnpairAt2140Step10);

theorem k215UnpairAt2140Step11Z (b n c: nat): $ k215PStep (k215UnpairAt2140State k215PNum2142 0 b n c) = (k215UnpairAt2140State k215PNum2144 0 b n c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair2140_2142) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt2140Reach11Z (b n c: nat): $ k215PReach (k215UnpairAt2140State k215PNum2142 0 b n c) (k215UnpairAt2140State k215PNum2144 0 b n c) $ = '(k215PReach_step k215UnpairAt2140Step11Z);

theorem k215UnpairAt2140Step11S (a b n c: nat): $ k215PStep (k215UnpairAt2140State k215PNum2142 (suc a) b n c) = (k215UnpairAt2140State k215PNum2143 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair2140_2142) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215UnpairAt2140Reach11S (a b n c: nat): $ k215PReach (k215UnpairAt2140State k215PNum2142 (suc a) b n c) (k215UnpairAt2140State k215PNum2143 a b n c) $ = '(k215PReach_step k215UnpairAt2140Step11S);

theorem k215UnpairAt2140Step12 (a b n c: nat): $ k215PStep (k215UnpairAt2140State k215PNum2143 a b n c) = (k215UnpairAt2140State k215PNum2147 a b n c) $ = '(k215PAtCB k215PLookupUnpair2140_2143);

theorem k215UnpairAt2140Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt2140State k215PNum2143 a b n c) (k215UnpairAt2140State k215PNum2147 a b n c) $ = '(k215PReach_step k215UnpairAt2140Step12);

theorem k215UnpairAt2140Step16 (a b n c: nat): $ k215PStep (k215UnpairAt2140State k215PNum2147 a b n c) = (k215UnpairAt2140State k215PNum2140 a b n c) $ = '(k215PAtCC k215PLookupUnpair2140_2147);

theorem k215UnpairAt2140Reach16 (a b n c: nat): $ k215PReach (k215UnpairAt2140State k215PNum2147 a b n c) (k215UnpairAt2140State k215PNum2140 a b n c) $ = '(k215PReach_step k215UnpairAt2140Step16);

theorem k215UnpairAt2140CycleZero (b n c: nat): $ k215PReach (k215UnpairAt2140State k215PNum2140 0 b (suc n) c) (k215UnpairAt2140State k215PNum2140 (suc b) 0 n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt2140Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2140Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2140Reach11Z) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2140ReachTransfer) k215UnpairAt2140Reach16))));
theorem k215UnpairAt2140CycleSucc (a b n c: nat): $ k215PReach (k215UnpairAt2140State k215PNum2140 (suc a) b (suc n) c) (k215UnpairAt2140State k215PNum2140 a (suc b) n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt2140Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2140Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2140Reach11S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2140Reach12) k215UnpairAt2140Reach16))));


theorem k215UnpairAt2140AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt2140State k215PNum2140 0 b (suc n) c) (k215UnpairAt2140State k215PNum2140 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt2140Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215PairDiagonal_rotate)) (eqtr (eqcom sndpr) (sndeq k215PairDiagonal_rotate)) eqid eqid)) k215UnpairAt2140CycleZero);

theorem k215UnpairAt2140AdvanceSucc (a b n c: nat): $ k215PReach (k215UnpairAt2140State k215PNum2140 (suc a) b (suc n) c) (k215UnpairAt2140State k215PNum2140 (fst (suc ((suc a), b))) (snd (suc ((suc a), b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt2140Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215Pair_next)) (eqtr (eqcom sndpr) (sndeq k215Pair_next)) eqid eqid)) k215UnpairAt2140CycleSucc);

pub theorem k215UnpairAt2140Advance (a b n c: nat): $ k215PReach (k215UnpairAt2140State k215PNum2140 a b (suc n) c) (k215UnpairAt2140State k215PNum2140 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
 (named @ induct '(ind) 'a 'k215UnpairAt2140AdvanceZero '(a1i k215UnpairAt2140AdvanceSucc));
@_ abstract def k215UnpairAt2140Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt2140State k215PNum2140 a b n c) (k215UnpairAt2140State k215PNum2148 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
theorem k215UnpairAt2140RunZero (a b c: nat): $ k215UnpairAt2140Run 0 a b c $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt2140Stateeq eqid
     (eqcom (eqtr (fsteq add0) fstpr))
     (eqcom (eqtr (sndeq add0) sndpr)) eqid eqid)) k215UnpairAt2140Reach9Z);
@_ abstract def k215UnpairAt2140Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt2140Run n a b c $;
theorem k215UnpairAt2140Claim_at (n a b c: nat): $ k215UnpairAt2140Claim n c -> k215UnpairAt2140Run n a b c $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215UnpairAt2140CodeStep (a b n: nat): $ (fst (suc (a, b)), snd (suc (a, b))) + n = (a, b) + suc n $ =
 '(eqtr (addeq1 fstsnd) addSass);
theorem k215UnpairAt2140RunInductive (n a b c: nat): $ k215UnpairAt2140Claim n c -> k215UnpairAt2140Run (suc n) a b c $ =
 '(syl (ax_mp k215PReach_trans k215UnpairAt2140Advance)
   (mpbid (a1i (k215PReacheq2 (k215UnpairAt2140Stateeq eqid
     (fsteq k215UnpairAt2140CodeStep) (sndeq k215UnpairAt2140CodeStep) eqid eqid))) k215UnpairAt2140Claim_at));
theorem k215UnpairAt2140Claim_all (n c: nat): $ k215UnpairAt2140Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt2140RunZero)) '(iald @ iald k215UnpairAt2140RunInductive));
pub theorem k215UnpairMacro2140 (n a b c: nat): $ k215PReach (k215UnpairAt2140State k215PNum2140 a b n c) (k215UnpairAt2140State k215PNum2148 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
 '(ax_mp k215UnpairAt2140Claim_at k215UnpairAt2140Claim_all);
pub theorem k215UnpairMacro2140_clean (n c: nat): $ k215PReach (k215UnpairAt2140State k215PNum2140 0 0 n c) (k215UnpairAt2140State k215PNum2148 (fst n) (snd n) 0 c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt2140Stateeq eqid
   (fsteq (eqtr (addeq1 pr0) add01))
   (sndeq (eqtr (addeq1 pr0) add01)) eqid eqid)) k215UnpairMacro2140);


