theorem k215PairMacro46_vectorAt1848 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat):
 $ k215PReach (k215PState k215PNum1854 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215PNum1864 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $;

theorem k215PushParam1848 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum1848 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum1874 (k215PVector u c (t, w) c a b 0 0 v)) $;
