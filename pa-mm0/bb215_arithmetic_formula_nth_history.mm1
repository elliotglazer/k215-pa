theorem bb215ArithmeticFormulaNthHistoryGraph_witness_head (n l: nat): $ bb215ArithmeticFormulaNthHistoryGraph n l (bb215ArithmeticFormulaListHead (bb215ArithmeticFormulaListDrop n l)) $ = (named '(ax_mp (!! eximi a bb215ArithmeticFormulaNthHistoryCharacterization_certificate) bb215ArithmeticFormulaRecCharacterization_exists));

pub theorem bb215ArithmeticFormulaNthHistoryGraph_witness (n l: nat): $ bb215ArithmeticFormulaNthHistoryGraph n l (nth n l) $ = (named '(mpbir (bb215ArithmeticFormulaNthHistoryGrapheq3 bb215ArithmeticFormulaListNth_iterate) bb215ArithmeticFormulaNthHistoryGraph_witness_head));

