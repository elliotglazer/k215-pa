@_ abstract def bb215ArithmeticFormulaNthHistoryCertificate (a l n v .y: nat): wff = $ bb215ArithmeticFormulaHistoryCell a 0 l /\ bb215ArithmeticFormulaRecClosure a bb215ArithmeticFormulaListTailStep n /\ A. y (bb215ArithmeticFormulaHistoryCell a n y -> bb215ArithmeticFormulaListHead y = v) $;

theorem bb215ArithmeticFormulaNthHistoryCertificate_step (a l n v i x: nat): $ bb215ArithmeticFormulaNthHistoryCertificate a l n v -> i < n -> bb215ArithmeticFormulaHistoryCell a i x -> bb215ArithmeticFormulaHistoryCell a (suc i) (bb215ArithmeticFormulaListTailStep @ x) $ = (named '(syl bb215ArithmeticFormulaRecClosure_at anlr));

theorem bb215ArithmeticFormulaNthHistoryCertificate_initial (a l n v: nat): $ bb215ArithmeticFormulaNthHistoryCertificate a l n v -> bb215ArithmeticFormulaHistoryCell a 0 (rec l bb215ArithmeticFormulaListTailStep 0) $ = (named '(mpbid (a1i (bb215ArithmeticFormulaHistoryCelleq3 (eqcom rec0))) anll));

