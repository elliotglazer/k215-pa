pub theorem bb215ArithmeticFormulaNthHistoryGraph_sound (n l v: nat): $ bb215ArithmeticFormulaNthHistoryGraph n l v -> nth n l = v $ = (named '(!! eex a bb215ArithmeticFormulaNthHistoryCertificate_sound));

