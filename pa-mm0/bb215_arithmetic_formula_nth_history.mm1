theorem bb215ArithmeticFormulaNthHistoryCertificate_final_index (a l n v: nat) {j: nat}: $ bb215ArithmeticFormulaNthHistoryCertificate a l n v -> A. j (bb215ArithmeticFormulaHistoryCell a n j -> bb215ArithmeticFormulaListHead j = v) $ = (named 'anr);

theorem bb215ArithmeticFormulaNthHistoryCertificate_final (a l n v y: nat): $ bb215ArithmeticFormulaNthHistoryCertificate a l n v -> bb215ArithmeticFormulaHistoryCell a n y -> bb215ArithmeticFormulaListHead y = v $ = (named '(rsyl (!! bb215ArithmeticFormulaNthHistoryCertificate_final_index j) (!! eale j ,eqtac)));

theorem bb215ArithmeticFormulaNthHistoryCertificate_head (a l n v: nat): $ bb215ArithmeticFormulaNthHistoryCertificate a l n v -> bb215ArithmeticFormulaListHead (bb215ArithmeticFormulaListDrop n l) = v $ = (named '(mpd (mpd (a1i leid) bb215ArithmeticFormulaNthHistoryCertificate_runs) bb215ArithmeticFormulaNthHistoryCertificate_final));

pub theorem bb215ArithmeticFormulaNthHistoryCertificate_sound (a l n v: nat): $ bb215ArithmeticFormulaNthHistoryCertificate a l n v -> nth n l = v $ = (named '(eqtrd (a1i bb215ArithmeticFormulaListNth_iterate) bb215ArithmeticFormulaNthHistoryCertificate_head));

