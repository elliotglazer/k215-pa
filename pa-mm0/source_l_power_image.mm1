import "source_l_power_def_literal.mm1";
import "source_l_power_shell.mm1";
import "source_l_replacement_producer_closed.mm1";
import "source_l_pair_next.mm1";

pub theorem sfLDefPower_literal: $ sfLDefPower = sfLDefPowerLiteral $ = 'eqid;

pub theorem sfLDefPower_from_definability
 (hU:$ sfTheoryProvable zfrAxioms (sfLDefinabilityLaw 1 sfLPowerSubsetFormula) $):
 $ sfTheoryProvable zfrAxioms sfLDefPower $ =
 '(mpbir (sfTheoryProvableeq2 sfLDefPower_literal) (sfLDefPowerLiteral_from_definability hU));

pub theorem sfLPower_image_from_definability
 (hC:$ sfTheoryProvable zfrAxioms sfLPairCommon2 $)
 (hU:$ sfTheoryProvable zfrAxioms (sfLDefinabilityLaw 1 sfLPowerSubsetFormula) $):
 $ sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcPower) $ =
 '(ax_mp (ax_mp sfTheoryProvable_mp
   (ax_mp (ax_mp sfTheoryProvable_mp
    (ax_mp (ax_mp sfTheoryProvable_mp
     (ax_mp (ax_mp sfTheoryProvable_mp sfLPower_reduced_zfr) sfLReplacementPowerBound_zfr))
     (ax_mp (ax_mp sfLLevelExtension_from_next_common2 sfLPairNextLevel_zfr) hC)))
    sfLPairNextLevel_zfr))
   (sfLDefPower_from_definability hU));
