-- L10: L02's "every level L_a is in L" (sfLLevelsInLLaw, source_l_clstage_levels) at the type of
-- L01's premise k215BLvl (k215_bundle_images_bcore). The two defs agree def for def; this light
-- module checks that conversion, so k215_final_full can use it for hlv.
import "k215_bundle_images_bcore.mm0";
import "source_l_clstage_levels.mm0";

theorem k215AssemblyBLvl_from_definable
 (h: $ sfTheoryProvable zfrAxioms (sfLReplacementDefinableLaw 0 (sfEq 0 0)) $):
 $ zfcProvable k215BLvl $;

-- Hypothesis-free last theorem (keeps check.py's false-final control well formed).
theorem k215AssemblyBLvl_eq: $ sfLLevelsInLLaw = k215BLvl $;
