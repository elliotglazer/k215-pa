import "k218q_closure_rebase.mm0";

def k218ClosureSourceBase (E: set) (B a b c f: nat): nat = $ suc (k218ClosureChosen_u E B a b c f) $;

def k218ClosureMatrixBase (E: set) (B a b c f: nat): nat = $ k218ClosureSourceBase E B a b c f + 10 $;

def k218ClosureRebased (E: set) (n B a b c f: nat): nat =
 $ k218ClosureSeparated E n (k218ClosureMatrixBase E B a b c f) a b c (k218ClosureChosen_u E B a b c f) (k218ClosureChosen_v E B a b c f) (k218ClosureChosen_p E B a b c f) (k218ClosureChosen_w E B a b c f) (k218ClosureChosen_x E B a b c f) (k218ClosureChosen_y E B a b c f) f $;

theorem k218QClosure_chosen_rebase {i j: nat} (E: set) (n B a b c f: nat)
 (hB: $ 0 < B $) (he: $ A. j (j < n -> E @ j < B) $)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218IEquivalent
     (k218ClosureSeparated E n B a b c (k218ClosureChosen_u E B a b c f) (k218ClosureChosen_v E B a b c f) (k218ClosureChosen_p E B a b c f) (k218ClosureChosen_w E B a b c f) (k218ClosureChosen_x E B a b c f) (k218ClosureChosen_y E B a b c f) f)
     (k218ClosureRebased E n B a b c f) $;
