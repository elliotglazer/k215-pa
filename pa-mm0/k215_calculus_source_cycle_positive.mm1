import "k215_calculus_source_decode.mm1";
import "k215_literal_runtime_progress.mm1";



theorem k215PReach_split_at (n s t: nat):
 $ k215PIter n s = t -> (s = t \/ k215PProgress s t) $ =
 (named @ induct '(ind) 'n
  '(syl orl (eqtrd (a1i (eqcom k215PIter_zero)) id))
  '(a1i (syl orr k215PProgress_intro)));
pub theorem k215PReach_split (s t: nat):
 $ k215PReach s t -> (s = t \/ k215PProgress s t) $ =
 (named '(eex k215PReach_split_at));
pub theorem k215PReach_positive_ne (s t: nat):
 $ s != t -> k215PReach s t -> k215PProgress s t $ =
 '(syl5 k215PReach_split (eord absurd (a1i id)));
theorem k215PEnumDecoded_distinct (s: nat):
 $ k215PEnumConfig s != k215PDecodedConfig s $ =
 '(mt (eqtrd (a1i (eqcom k215PPC_state)) (eqtrd (k215PPCeqd id) (a1i k215PPC_state)))
      (mpbir (noteq eqcomb) peano1));
pub theorem k215PDecodeEnum_positive (s: nat):
 $ k215PProgress (k215PEnumConfig s) (k215PDecodedConfig s) $ =
 '(ax_mp (ax_mp k215PReach_positive_ne k215PEnumDecoded_distinct) k215PDecodeEnum);
pub theorem k215PEnumConfig_status (s: nat):
 $ k215PStatus (k215PEnumConfig s) = 1 $ =
 '(eqtr (k215PETageq (eqtr (k215PLookupeq k215PPC_state) k215PLookupDecode_0)) k215PETag_entry);
