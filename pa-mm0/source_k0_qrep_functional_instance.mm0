import "source_k0_qrep_witness_syntax.mm0";

theorem sfK0QRep_functional_instance (E: set) (n a u v w x y z M R phi: nat) (hf: $ sfBound (suc (suc n)) phi $) (hM: $ 1 < M $) (hMR: $ M < R $) (huM: $ u < M $) (hvM: $ v < M $) (hwM: $ w < M $) (hxM: $ x < M $) (hyM: $ y < M $) (hzM: $ z < M $) (hu0: $ u != 0 $) (hv0: $ v != 0 $) (hw0: $ w != 0 $) (hx0: $ x != 0 $) (hy0: $ y != 0 $) (hz0: $ z != 0 $) (hu1: $ u != 1 $) (hv1: $ v != 1 $) (hw1: $ w != 1 $) (hx1: $ x != 1 $) (hy1: $ y != 1 $) (hz1: $ z != 1 $) (huv: $ u != v $) (huw: $ u != w $) (hux: $ u != x $) (huy: $ u != y $) (huz: $ u != z $) (hvw: $ v != w $) (hvx: $ v != x $) (hvy: $ v != y $) (hvz: $ v != z $) (hwx: $ w != x $) (hwy: $ w != y $) (hwz: $ w != z $) (hxy: $ x != y $) (hxz: $ x != z $) (hyz: $ y != z $) (hua: $ u != a $) (hva: $ v != a $) (hwa: $ w != a $) (heu: $ sqEnvAvoid E n u $) (hev: $ sqEnvAvoid E n v $) (hew: $ sqEnvAvoid E n w $):
 $ k218QProvable (kImp (kAll u (kImp (kImp (kImp (kMem 1 u) (kImp (sqMember 1 u a M) kF)) kF) (kAll v (kImp (kMem 1 v) (kAll w (kImp (kMem 1 w) (kImp (sfK0QRepRelation E 1 R u v phi) (kImp (sfK0QRepRelation E 1 R u w phi) (sqEqual 1 v w M))))))))) (kImp (kImp (kImp (kMem 1 x) (kImp (sqMember 1 x a M) kF)) kF) (kImp (kMem 1 y) (kImp (kMem 1 z) (kImp (sfK0QRepRelation E 1 R x y phi) (kImp (sfK0QRepRelation E 1 R x z phi) (sqEqual 1 y z M))))))) $;
