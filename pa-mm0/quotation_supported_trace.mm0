import "quotation_supported_propositional.mm0";
import "quotation_supported_quantifier_closure.mm0";

theorem sqSupported_rules_sound: $ traceRuleSound sfNDFullRules sqSupportedClass $;

theorem sqSupported_trace (p: nat):
 $ traceValid sfNDFullRules p -> traceClassAll sqSupportedClass p $;

theorem sqSupported_derives (p r: nat):
 $ sfNDFullDerives p r -> sqSupportedGood r $;

theorem sqSupported_sequent (p G a: nat):
 $ sfNDFullDerives p (sfSequent G a) -> sqSupportedGood (sfSequent G a) $;

theorem sqSupported_sequent_cutoff {n: nat} (p G a: nat):
 $ sfNDFullDerives p (sfSequent G a) -> E. n sqSupportedAt n (sfSequent G a) $;
