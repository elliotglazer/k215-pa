import "source_l_separation_image_op5_profile.mm1";
import "source_piece_pcf_rep_cover_laws_r39.mm1";
import "source_l_level_member_names.mm1";
import "source_relative_contexts.mm1";

@_ def sfLSeparationDef0Forward(A C D:nat):nat =
 $ sfAll (sfImp (sfMem 0 (suc D)) (sfAnd (sfMem 0 (suc C)) (sfCLSubset 0 (suc A)))) $;
@_ def sfLSeparationDef0Reverse(A C D:nat):nat =
 $ sfAll (sfImp (sfMem 0 (suc C)) (sfImp (sfCLSubset 0 (suc A)) (sfMem 0 (suc D)))) $;
@_ def sfLSeparationDef0Witness(A D:nat):nat =
 $ sfAnd (sfAnd (sfAnd (sfPieceRepSuccessor (suc (suc A)) 1) (sfPieceRepClosure 1 0))
   (sfLSeparationDef0Forward (suc (suc A)) 0 (suc (suc D))))
   (sfLSeparationDef0Reverse (suc (suc A)) 0 (suc (suc D))) $;
@_ def sfLSeparationDef0(A D:nat):nat = $ sfEx (sfEx (sfLSeparationDef0Witness A D)) $;
@_ def sfLSeparationDefClosureAt(a A D y:nat):nat =
 $ sfImp (sfCLOrdinalAt a) (sfImp (sfCLHierarchyAt a A)
    (sfImp (sfLSeparationDef0 A D) (sfImp (sfMem y D) (sfDomainAt sfLDomain y)))) $;
@_ def sfLSeparationDefClosureLaw:nat =
 $ sfAll (sfAll (sfAll (sfAll (sfLSeparationDefClosureAt 3 2 1 0)))) $;

theorem sld0_subset_wf(A B:nat): $ sfWf (sfCLSubset A B) $ =
 '(ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfWf_mem) sfWf_mem));
theorem sld0_subset_eq(A B C D:nat)(ha:$ A = C $)(hb:$ B = D $):
 $ sfCLSubset A B = sfCLSubset C D $ =
 '(nsAll_eq (nsImp_eq (nsMem_eq eqid (suceq ha)) (nsMem_eq eqid (suceq hb))));
theorem sld0_forward_wf(A C D:nat): $ sfWf (sfLSeparationDef0Forward A C D) $ =
 '(ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfWf_mem) (ax_mp (ax_mp sfWf_and sfWf_mem) sld0_subset_wf)));
theorem sld0_reverse_wf(A C D:nat): $ sfWf (sfLSeparationDef0Reverse A C D) $ =
 '(ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfWf_mem) (ax_mp (ax_mp sfWf_imp sld0_subset_wf) sfWf_mem)));
pub theorem sfLSeparationDef0_wf(A D:nat): $ sfWf (sfLSeparationDef0 A D) $ =
 '(ax_mp sfWf_ex (ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and
   (ax_mp (ax_mp sfWf_and (ax_mp (ax_mp sfWf_and sfPieceRepSuccessor_wf) sfPieceRepClosure_wf)) sld0_forward_wf)) sld0_reverse_wf)));
theorem sld0_forward_eq(A C D B E F:nat)(ha:$ A = B $)(hc:$ C = E $)(hd:$ D = F $):
 $ sfLSeparationDef0Forward A C D = sfLSeparationDef0Forward B E F $ =
 '(nsAll_eq (nsImp_eq (nsMem_eq eqid (suceq hd)) (nsAnd_eq (nsMem_eq eqid (suceq hc)) (sld0_subset_eq eqid (suceq ha)))));
theorem sld0_reverse_eq(A C D B E F:nat)(ha:$ A = B $)(hc:$ C = E $)(hd:$ D = F $):
 $ sfLSeparationDef0Reverse A C D = sfLSeparationDef0Reverse B E F $ =
 '(nsAll_eq (nsImp_eq (nsMem_eq eqid (suceq hc)) (nsImp_eq (sld0_subset_eq eqid (suceq ha)) (nsMem_eq eqid (suceq hd)))));
pub theorem sfLSeparationDef0_eq(A D B E:nat)(ha:$ A = B $)(hd:$ D = E $):
 $ sfLSeparationDef0 A D = sfLSeparationDef0 B E $ =
 '(nsEx_eq (nsEx_eq (nsAnd_eq (nsAnd_eq
   (nsAnd_eq (sfPieceRepSuccessor_eq (suceq (suceq ha)) eqid) eqid)
   (sld0_forward_eq (suceq (suceq ha)) eqid (suceq (suceq hd))))
   (sld0_reverse_eq (suceq (suceq ha)) eqid (suceq (suceq hd))))));
theorem sld0_forward_subst(k t A C D:nat):
 $ sfSubst k t (sfLSeparationDef0Forward A C D) =
   sfLSeparationDef0Forward (sfSubstIndex k t A) (sfSubstIndex k t C) (sfSubstIndex k t D) $ =
 '(eqtr sfSubst_sfAll (nsAll_eq (eqtr sfSubst_sfImp (nsImp_eq
   (eqtr sfSubst_sfMem (nsMem_eq (ax_mp sfSubstIndex_bound lt01S) sfSubstIndex_lift))
   (eqtr sfSubst_sfAnd (nsAnd_eq
    (eqtr sfSubst_sfMem (nsMem_eq (ax_mp sfSubstIndex_bound lt01S) sfSubstIndex_lift))
    (eqtr sfLSubset_subst (sld0_subset_eq (ax_mp sfSubstIndex_bound lt01S) sfSubstIndex_lift))))))));
theorem sld0_reverse_subst(k t A C D:nat):
 $ sfSubst k t (sfLSeparationDef0Reverse A C D) =
   sfLSeparationDef0Reverse (sfSubstIndex k t A) (sfSubstIndex k t C) (sfSubstIndex k t D) $ =
 '(eqtr sfSubst_sfAll (nsAll_eq (eqtr sfSubst_sfImp (nsImp_eq
   (eqtr sfSubst_sfMem (nsMem_eq (ax_mp sfSubstIndex_bound lt01S) sfSubstIndex_lift))
   (eqtr sfSubst_sfImp (nsImp_eq
    (eqtr sfLSubset_subst (sld0_subset_eq (ax_mp sfSubstIndex_bound lt01S) sfSubstIndex_lift))
    (eqtr sfSubst_sfMem (nsMem_eq (ax_mp sfSubstIndex_bound lt01S) sfSubstIndex_lift))))))));
pub theorem sfLSeparationDef0_subst(k t A D:nat):
 $ sfSubst k t (sfLSeparationDef0 A D) = sfLSeparationDef0 (sfSubstIndex k t A) (sfSubstIndex k t D) $ =
 '(eqtr sfSubst_sfEx (nsEx_eq (eqtr sfSubst_sfEx (nsEx_eq
   (eqtr sfSubst_sfAnd (nsAnd_eq
    (eqtr sfSubst_sfAnd (nsAnd_eq
     (eqtr sfSubst_sfAnd (nsAnd_eq
      (eqtr sfPieceRepSuccessor_subst (sfPieceRepSuccessor_eq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_lift)) (ax_mp sfSubstIndex_bound (mpbi ltsuc lt01S))))
      (eqtr sfPieceRepClosure_subst (sfPieceRepClosure_eq (ax_mp sfSubstIndex_bound (mpbi ltsuc lt01S)) (ax_mp sfSubstIndex_bound lt01S)))))
     (eqtr sld0_forward_subst (sld0_forward_eq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_lift)) (ax_mp sfSubstIndex_bound lt01S) (eqtr sfSubstIndex_lift (suceq sfSubstIndex_lift))))))
    (eqtr sld0_reverse_subst (sld0_reverse_eq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_lift)) (ax_mp sfSubstIndex_bound lt01S) (eqtr sfSubstIndex_lift (suceq sfSubstIndex_lift))))))))));
pub theorem sfLSeparationDef0Reverse_member(G A C D y:nat)
 (hr:$ nsLocal G (sfLSeparationDef0Reverse A C D) $)
 (hy:$ nsLocal G (sfMem y C) $)(hs:$ nsLocal G (sfCLSubset y A) $):
 $ nsLocal G (sfMem y D) $ =
 '(ax_mp (ax_mp nsLocal_mp (ax_mp (ax_mp nsLocal_mp
   (sfRQ_rewrite (eqtr sfSubst_sfImp (nsImp_eq
    (eqtr sfSubst_sfMem (nsMem_eq sfSubstIndex_zero sfSubstIndex_successor))
    (eqtr sfSubst_sfImp (nsImp_eq
     (eqtr sfLSubset_subst (sld0_subset_eq sfSubstIndex_zero sfSubstIndex_successor))
     (eqtr sfSubst_sfMem (nsMem_eq sfSubstIndex_zero sfSubstIndex_successor))))))
    (ax_mp nsLocal_AllE hr))) hy)) hs);
theorem sld0_profile_step(T:set)(G phi A Y:nat)(hp:$ nsLocal G (sfPieceDefinableProfile T phi A Y) $):
 $ nsLocal (sfContextShift G) (sfImp (sfMem 0 (suc Y)) (sfMem 0 (suc A))) $ =
 '(ax_mp nsLocal_II (ax_mp nsLocal_CE1 (ax_mp (ax_mp nsLocal_mp
   (ax_mp (ax_mp (ax_mp nsLocal_weaken
    (mpbir sfContextWf_cons (ian sfWf_mem sfContextShift_wf))) sfContextSub_cons)
     (ax_mp nsLocal_CE1 (ax_mp sfSepLocal_open hp))))
   (ax_mp (ax_mp nsLocal_hyp (mpbir sfContextWf_cons (ian sfWf_mem sfContextShift_wf))) sfContext_member_head))));
pub theorem sfLSeparationDefinableProfile_subset(T:set)(G phi A Y:nat)
 (hp:$ nsLocal G (sfPieceDefinableProfile T phi A Y) $):
 $ nsLocal G (sfCLSubset Y A) $ =
 '(ax_mp (sfLocal_allI (ax_mp nsLocal_context_wf hp)) (sld0_profile_step hp));
pub theorem sfLSeparationDef0_profile_member(T:set)(G phi A C D y:nat)
 (hr:$ nsLocal G (sfLSeparationDef0Reverse A C D) $)
 (hy:$ nsLocal G (sfMem y C) $)
 (hp:$ nsLocal G (sfPieceDefinableProfile T phi A y) $):
 $ nsLocal G (sfMem y D) $ =
 '(sfLSeparationDef0Reverse_member hr hy (sfLSeparationDefinableProfile_subset hp));
pub theorem sfLSeparationDefClosureAt_apply(G a A D y:nat)
 (hc:$ nsLocal G (sfLSeparationDefClosureAt a A D y) $)
 (ha:$ nsLocal G (sfCLOrdinalAt a) $)(hA:$ nsLocal G (sfCLHierarchyAt a A) $)
 (hd:$ nsLocal G (sfLSeparationDef0 A D) $)(hy:$ nsLocal G (sfMem y D) $):
 $ nsLocal G (sfDomainAt sfLDomain y) $ =
 '(ax_mp (ax_mp nsLocal_mp (ax_mp (ax_mp nsLocal_mp
   (ax_mp (ax_mp nsLocal_mp (ax_mp (ax_mp nsLocal_mp hc) ha)) hA)) hd)) hy);
theorem sld0_matrix_eq(a A D y b B E z:nat)
 (ha:$ a = b $)(hA:$ A = B $)(hd:$ D = E $)(hy:$ y = z $):
 $ sfLSeparationDefClosureAt a A D y = sfLSeparationDefClosureAt b B E z $ =
 '(nsImp_eq (sfCLOrdinalAteq ha) (nsImp_eq (sfCLHierarchyAteq ha hA)
   (nsImp_eq (sfLSeparationDef0_eq hA hd) (nsImp_eq (nsMem_eq hy hd)
    (trud (sfDomainAt_congr (a1i eqid) (a1i hy)))))));
theorem sld0_matrix_subst(k t a A D y:nat):
 $ sfSubst k t (sfLSeparationDefClosureAt a A D y) =
   sfLSeparationDefClosureAt (sfSubstIndex k t a) (sfSubstIndex k t A)
    (sfSubstIndex k t D) (sfSubstIndex k t y) $ =
 '(eqtr sfSubst_sfImp (nsImp_eq sfLOrdinalAt_subst
   (eqtr sfSubst_sfImp (nsImp_eq sfLHierarchyAt_subst
    (eqtr sfSubst_sfImp (nsImp_eq sfLSeparationDef0_subst
     (eqtr sfSubst_sfImp (nsImp_eq sfSubst_sfMem sfLDomainAt_subst))))))));

theorem sld0_open0(a:nat):
 $ sfSubst 0 a (sfAll (sfAll (sfAll (sfLSeparationDefClosureAt 3 2 1 0)))) = (sfAll (sfAll (sfAll (sfLSeparationDefClosureAt (suc (suc (suc a))) 2 1 0)))) $ =
 '(eqtr sfSubst_sfAll (nsAll_eq (eqtr sfSubst_sfAll (nsAll_eq (eqtr sfSubst_sfAll (nsAll_eq (eqtr sld0_matrix_subst (sld0_matrix_eq (eqtr sfSubstIndex_lift (suceq (eqtr sfSubstIndex_lift (suceq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_zero)))))) (ax_mp sfSubstIndex_bound (mpbi ltsuc (mpbi ltsuc lt01S))) (ax_mp sfSubstIndex_bound (mpbi ltsuc lt01S)) (ax_mp sfSubstIndex_bound lt01S)))))))));
theorem sld0_local0(G a:nat)(hp:$ nsLocal G sfLSeparationDefClosureLaw $):
 $ nsLocal G (sfAll (sfAll (sfAll (sfLSeparationDefClosureAt (suc (suc (suc a))) 2 1 0)))) $ =
 '(sfRQ_rewrite (sld0_open0) (ax_mp nsLocal_AllE hp));
theorem sld0_open1(a A:nat):
 $ sfSubst 0 A (sfAll (sfAll (sfLSeparationDefClosureAt (suc (suc (suc a))) 2 1 0))) = (sfAll (sfAll (sfLSeparationDefClosureAt (suc (suc a)) (suc (suc A)) 1 0))) $ =
 '(eqtr sfSubst_sfAll (nsAll_eq (eqtr sfSubst_sfAll (nsAll_eq (eqtr sld0_matrix_subst (sld0_matrix_eq (eqtr sfSubstIndex_lift (suceq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor)))) (eqtr sfSubstIndex_lift (suceq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_zero)))) (ax_mp sfSubstIndex_bound (mpbi ltsuc lt01S)) (ax_mp sfSubstIndex_bound lt01S)))))));
theorem sld0_local1(G a A:nat)(hp:$ nsLocal G sfLSeparationDefClosureLaw $):
 $ nsLocal G (sfAll (sfAll (sfLSeparationDefClosureAt (suc (suc a)) (suc (suc A)) 1 0))) $ =
 '(sfRQ_rewrite (sld0_open1) (ax_mp nsLocal_AllE (sld0_local0 hp)));
theorem sld0_open2(a A D:nat):
 $ sfSubst 0 D (sfAll (sfLSeparationDefClosureAt (suc (suc a)) (suc (suc A)) 1 0)) = (sfAll (sfLSeparationDefClosureAt (suc a) (suc A) (suc D) 0)) $ =
 '(eqtr sfSubst_sfAll (nsAll_eq (eqtr sld0_matrix_subst (sld0_matrix_eq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor)) (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor)) (eqtr sfSubstIndex_lift (suceq sfSubstIndex_zero)) (ax_mp sfSubstIndex_bound lt01S)))));
theorem sld0_local2(G a A D:nat)(hp:$ nsLocal G sfLSeparationDefClosureLaw $):
 $ nsLocal G (sfAll (sfLSeparationDefClosureAt (suc a) (suc A) (suc D) 0)) $ =
 '(sfRQ_rewrite (sld0_open2) (ax_mp nsLocal_AllE (sld0_local1 hp)));
theorem sld0_open3(a A D y:nat):
 $ sfSubst 0 y (sfLSeparationDefClosureAt (suc a) (suc A) (suc D) 0) = (sfLSeparationDefClosureAt a A D y) $ =
 '(eqtr sld0_matrix_subst (sld0_matrix_eq sfSubstIndex_successor sfSubstIndex_successor sfSubstIndex_successor sfSubstIndex_zero));
theorem sld0_local3(G a A D y:nat)(hp:$ nsLocal G sfLSeparationDefClosureLaw $):
 $ nsLocal G (sfLSeparationDefClosureAt a A D y) $ =
 '(sfRQ_rewrite (sld0_open3) (ax_mp nsLocal_AllE (sld0_local2 hp)));
pub theorem sfLSeparationDefClosure_use(G a A D y:nat)
 (hp:$ nsLocal G sfLSeparationDefClosureLaw $)
 (ha:$ nsLocal G (sfCLOrdinalAt a) $)(hA:$ nsLocal G (sfCLHierarchyAt a A) $)
 (hd:$ nsLocal G (sfLSeparationDef0 A D) $)(hy:$ nsLocal G (sfMem y D) $):
 $ nsLocal G (sfDomainAt sfLDomain y) $ =
 '(sfLSeparationDefClosureAt_apply (sld0_local3 hp) ha hA hd hy);
