-- K215 uses the same formula codes and a restricted rho8 axiom family.
import "k215_induction.mm0";
import "k218_induction.mm0";

theorem k215Cal_Imp_zero: $ kImp 0 0 = 0 $;
theorem k215Cal_Axioms_subset: $ k215Axioms C_ k218Axioms $;
theorem k215Cal_Rules_subset: $ k215Rules C_ k218Rules $;
theorem k215Cal_Derives_forward (p a: nat):
  $ k215Derives p a -> k218Derives p a $;
theorem k215Cal_Provable_forward (a: nat):
  $ k215Provable a -> k218Provable a $;
theorem k215Cal_Inconsistent_forward:
  $ k215Inconsistent -> k218Inconsistent $;
