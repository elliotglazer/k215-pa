def k215Loop107Claim (x c: nat) (.y .z: nat): wff =
 $ A. y A. z k215PIter (3 * x + 1) (k215Loop107State k215Num107 x y z c) = (k215Loop107State k215Num110 0 (x + y) z c) $;

theorem k215Loop107Transfer (x y z c: nat): $ k215PIter (3 * x + 1) (k215Loop107State k215Num107 x y z c) = (k215Loop107State k215Num110 0 (x + y) z c) $;

