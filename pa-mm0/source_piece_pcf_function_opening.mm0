import "source_piece_pcf_opening.mm0";

import "source_piece_pcf_function_syntax.mm0";

def sfPieceFunctionBinaryOpenLaw (domain level:nat)(E:set)(n d X:nat): wff =
 $ sfPieceFunctionTableValid E n ->
   sfORBinary (sfPieceFunctionBinary domain level E n) d X =
    sfPieceFunctionConjunction domain level E n d X $;

def pcfOBoundLaw(domain level:nat)(E:set)(n d X:nat):wff =
 $ sfBound 1 domain -> sfBound 2 level -> sfPieceFunctionBinaryOpenLaw domain level E n d X $;

theorem sfPieceFunctionBinary_open (domain level:nat)(E:set)(n d X:nat)
 (hd: $ sfBound 1 domain $) (hl: $ sfBound 2 level $):
 $ sfPieceFunctionTableValid E n ->
   sfORBinary (sfPieceFunctionBinary domain level E n) d X =
    sfPieceFunctionConjunction domain level E n d X $;
