import "k218q_seed_syntax.mm1";

@_ def k218QSeedCode (d: nat): nat = $ k218Translate (kNot (kNot d)) $;
theorem k218QS_not_gt3 (d: nat): $ 3 < kNot d $ =
'(ltletr ltsucid (mpbi (leeq1 mul12) (ax_mp lemul2a leprid2)));
pub theorem k218QSeedCode_gt3 (d: nat): $ 3 < k218QSeedCode d $ =
'(mpbir (lteq2 k218Translate_kNot) k218QS_not_gt3);

theorem k218QS_label_ne1 (d: nat): $ k218QSeedCode d != 1 $ =
'(ltneri (lttr (mpbi ltsuc lt01S) k218QSeedCode_gt3));
theorem k218QS_label_ne3 (d: nat): $ k218QSeedCode d != 3 $ =
'(ltneri k218QSeedCode_gt3);
pub theorem k218QSeed_literal (d: nat):
  $ k218QProvable (k218SeedN 1 3 (k218QSeedCode d) (kNot (kNot d))) $ =
'(mpbir (k218Provableeq (eqtr k218Translate_k218SeedN (eqcom k218Seed_literal_structure)))
  (ax_mp k218Provable_axiom
    (ax_mp k218Axioms_bundle (ian k218QS_label_ne1 k218QS_label_ne3))));
