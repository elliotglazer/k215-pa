-- Interpreted raw-code logical replay. The only global predicate is
-- k218QProvable(c) = k218Provable(k218Translate(c)); no core image is assumed.
import "k218q_transport.mm1";
import "source_named_template.mm1";

@_ def k218IEquivalent (a b: nat): wff =
 $ k218QProvable (kImp a b) /\ k218QProvable (kImp b a) $;

pub theorem k218IEqProv_mp (G: wff) (a b: nat)
 (ha: $ G -> k218QProvable a $) (hi: $ G -> k218QProvable (kImp a b) $):
 $ G -> k218QProvable b $ = '(sylc k218QProvable_mp ha hi);

pub theorem k218IEqProv_syl (G: wff) (a b c: nat)
 (hab: $ G -> k218QProvable (kImp a b) $) (hbc: $ G -> k218QProvable (kImp b c) $):
 $ G -> k218QProvable (kImp a c) $ =
'(k218IEqProv_mp hbc (k218IEqProv_mp hab (a1i k218IPropB)));

pub theorem k218IEqProv_all (G: wff) (x a b: nat)
 (h: $ G -> k218QProvable (kImp a b) $):
 $ G -> k218QProvable (kImp (kAll x a) (kAll x b)) $ =
'(k218IEqProv_mp (syl k218QProvable_gen h) (a1i (ax_mp k218QProvable_axiom k218QAxioms_rho2)));

pub theorem k218IEqProv_not (G: wff) (a b: nat)
 (h: $ G -> k218QProvable (kImp a b) $):
 $ G -> k218QProvable (kImp (kNot b) (kNot a)) $ =
'(k218IEqProv_mp h (a1i k218IPropContra));

pub theorem k218IEqProv_imp (G: wff) (a ap b bp: nat)
 (ha: $ G -> k218QProvable (kImp ap a) $)
 (hb: $ G -> k218QProvable (kImp b bp) $):
 $ G -> k218QProvable (kImp (kImp a b) (kImp ap bp)) $ =
'(k218IEqProv_mp (a1i (ax_mp k218QProvable_axiom k218QAxioms_true))
  (k218IEqProv_mp (k218IEqProv_mp hb (a1i k218IPropK))
    (k218IEqProv_mp (k218IEqProv_mp ha (a1i k218IPropK)) (a1i k218ITransport_imp_lemma))));

pub theorem k218IEquivalent_refl (a: nat): $ k218IEquivalent a a $ = '(ian k218IPropI k218IPropI);
pub theorem k218IEquivalent_sym (a b: nat): $ k218IEquivalent a b -> k218IEquivalent b a $ = 'ancom;
pub theorem k218IEquivalent_trans (a b c: nat):
 $ k218IEquivalent a b /\ k218IEquivalent b c -> k218IEquivalent a c $ =
'(iand (k218IEqProv_syl anll anrl) (k218IEqProv_syl anrr anlr));
pub theorem k218IEquivalent_imp (a ap b bp: nat):
 $ k218IEquivalent a ap /\ k218IEquivalent b bp -> k218IEquivalent (kImp a b) (kImp ap bp) $ =
'(iand (k218IEqProv_imp anlr anrl) (k218IEqProv_imp anll anrr));
pub theorem k218IEquivalent_not (a b: nat):
 $ k218IEquivalent a b -> k218IEquivalent (kNot a) (kNot b) $ =
'(iand (k218IEqProv_not anr) (k218IEqProv_not anl));
pub theorem k218IEquivalent_and (a ap b bp: nat):
 $ k218IEquivalent a ap /\ k218IEquivalent b bp -> k218IEquivalent (kAnd a b) (kAnd ap bp) $ =
'(syl k218IEquivalent_not @ syl k218IEquivalent_imp @ iand anl (syl k218IEquivalent_not anr));
pub theorem k218IEquivalent_or (a ap b bp: nat):
 $ k218IEquivalent a ap /\ k218IEquivalent b bp -> k218IEquivalent (kDisj a b) (kDisj ap bp) $ =
'(syl k218IEquivalent_imp @ iand (syl k218IEquivalent_not anl) anr);
pub theorem k218IEquivalent_all (x a b: nat):
 $ k218IEquivalent a b -> k218IEquivalent (kAll x a) (kAll x b) $ =
'(iand (k218IEqProv_all anl) (k218IEqProv_all anr));
pub theorem k218IEquivalent_exists (x a b: nat):
 $ k218IEquivalent a b -> k218IEquivalent (kExists x a) (kExists x b) $ =
'(syl k218IEquivalent_not (syl k218IEquivalent_all k218IEquivalent_not));
pub theorem k218IEquivalent_guarded_all (x guard a b: nat):
 $ k218IEquivalent a b ->
   k218IEquivalent (kAll x (kImp guard a)) (kAll x (kImp guard b)) $ =
'(syl k218IEquivalent_all (syl k218IEquivalent_imp (iand (a1i k218IEquivalent_refl) id)));
pub theorem k218IEquivalent_guarded_exists (x guard a b: nat):
 $ k218IEquivalent a b ->
   k218IEquivalent (kExists x (kAnd guard a)) (kExists x (kAnd guard b)) $ =
'(syl k218IEquivalent_exists (syl k218IEquivalent_and (iand (a1i k218IEquivalent_refl) id)));
