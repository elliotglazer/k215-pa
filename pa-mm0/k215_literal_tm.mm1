@_ def k215TMState (q l r: nat): nat = $ (q, l, r) $;
@_ def k215TMQ (s: nat): nat = $ fst s $;
@_ def k215TML (s: nat): nat = $ fst (snd s) $;
@_ def k215TMR (s: nat): nat = $ snd (snd s) $;
@_ def k215TMWrite (a: nat): nat = $ fst a $;
@_ def k215TMDir (a: nat): nat = $ fst (snd a) $;
@_ def k215TMTarget (a: nat): nat = $ snd (snd a) $;
@_ def k215TMMove (a l r: nat): nat =
$ if (k215TMDir a = 0)
    (k215TMState (k215TMTarget a) (l // 2) (l % 2 + 2 * k215TMWrite a + 4 * (r // 2)))
    (k215TMState (k215TMTarget a) (2 * l + k215TMWrite a) (r // 2)) $;
@_ def k215TMStep (s: nat): nat =
$ if (k215TMQ s < k215Num215)
    (k215TMMove (k215TMAction (k215TMQ s) (k215TMR s % 2)) (k215TML s) (k215TMR s)) s $;
@_ def k215TMInitial: nat = $ k215TMState 0 0 0 $;
@_ def k215TMValidAction (a: nat): wff =
$ k215TMWrite a <= 1 /\ k215TMDir a <= 1 /\ k215TMTarget a <= k215Num215 $;
@_ def k215TMStateBound (s: nat): wff = $ k215TMQ s <= k215Num215 $;
@_ def k215TMRun (n s .x: nat): nat = $ rec s (\ x, k215TMStep x) n $;
@_ def k215LiteralHalts (.n: nat): wff = $ E. n k215TMQ (k215TMRun n k215TMInitial) = k215Num215 $;

pub theorem k215TMState_Q (q l r: nat): $ k215TMQ (k215TMState q l r) = q $ = 'fstpr;
pub theorem k215TMState_L (q l r: nat): $ k215TML (k215TMState q l r) = l $ =
'(eqtr (fsteq sndpr) fstpr);
pub theorem k215TMState_R (q l r: nat): $ k215TMR (k215TMState q l r) = r $ =
'(eqtr (sndeq sndpr) sndpr);
pub theorem k215TMState_rebuild (s: nat): $ k215TMState (k215TMQ s) (k215TML s) (k215TMR s) = s $ =
'(eqtr (preq2 fstsnd) fstsnd);

theorem k215TMValid_if (p: wff) (a b: nat)
  (ha: $ k215TMValidAction a $) (hb: $ k215TMValidAction b $):
  $ k215TMValidAction (if p a b) $ =
'(cases (mpbiri ha (k215TMValidActioneqd ifpos))
        (mpbiri hb (k215TMValidActioneqd ifneg)));
theorem k215TMValid_tuple (w d n: nat)
  (hw: $ w <= 1 $) (hd: $ d <= 1 $) (hn: $ n <= k215Num215 $):
  $ k215TMValidAction (w, d, n) $ =
'(ian (ian (mpbir (leeq1 fstpr) hw)
            (mpbir (leeq1 (eqtr (fsteq sndpr) fstpr)) hd))
       (mpbir (leeq1 (eqtr (sndeq sndpr) sndpr)) hn));
theorem k215TMTarget_le215: $ k215Num215 <= k215Num215 $ = 'leid;
