pub theorem k215TMMove_Q (a l r: nat): $ k215TMQ (k215TMMove a l r) = k215TMTarget a $ =
'(cases (eqtrd (k215TMQeqd ifpos) (a1i k215TMState_Q))
        (eqtrd (k215TMQeqd ifneg) (a1i k215TMState_Q)));
pub theorem k215TMMove_bound (a l r: nat): $ k215TMValidAction a -> k215TMStateBound (k215TMMove a l r) $ =
'(syl (bi2 (leeq1 k215TMMove_Q)) anr);
pub theorem k215TMStep_active (s: nat): $ k215TMQ s < k215Num215 ->
 k215TMStep s = k215TMMove (k215TMAction (k215TMQ s) (k215TMR s % 2)) (k215TML s) (k215TMR s) $ = 'ifpos;
pub theorem k215TMStep_halted (s: nat): $ ~k215TMQ s < k215Num215 -> k215TMStep s = s $ = 'ifneg;
pub theorem k215TMStep_bound (s: nat): $ k215TMStateBound s -> k215TMStateBound (k215TMStep s) $ =
'(casesda
  (mpbird (k215TMStateBoundeqd (syl k215TMStep_active anr)) (a1i (k215TMMove_bound k215TMAction_valid)))
  (mpbird (k215TMStateBoundeqd (syl k215TMStep_halted anr)) anl));
pub theorem k215TMInitial_zero: $ k215TMInitial = 0 $ = '(eqtr (preq2 pr0) pr0);
pub theorem k215TMRun_zero (s: nat): $ k215TMRun 0 s = s $ = (named 'rec0);
pub theorem k215TMRun_succ (n s: nat): $ k215TMRun (suc n) s = k215TMStep (k215TMRun n s) $ =
'(eqtr recS @ ! applame $ k215TMRun n s $ _ x _ k215TMStepeq);
theorem k215TMRun_bound_zero (s: nat): $ k215TMStateBound s -> k215TMStateBound (k215TMRun 0 s) $ =
'(bi2 (k215TMStateBoundeq k215TMRun_zero));
theorem k215TMRun_bound_step (n s: nat):
 $ k215TMStateBound s /\ k215TMStateBound (k215TMRun n s) -> k215TMStateBound (k215TMRun (suc n) s) $ =
'(syl (bi2 (k215TMStateBoundeq k215TMRun_succ)) (syl k215TMStep_bound anr));
pub theorem k215TMRun_bound (n s: nat): $ k215TMStateBound s -> k215TMStateBound (k215TMRun n s) $ =
(named @ induct '(indd) 'n 'k215TMRun_bound_zero 'k215TMRun_bound_step);
pub theorem k215TMRun_initial_bound (n: nat): $ k215TMStateBound (k215TMRun n k215TMInitial) $ =
'(k215TMRun_bound (mpbir (leeq1 k215TMState_Q) le01));
