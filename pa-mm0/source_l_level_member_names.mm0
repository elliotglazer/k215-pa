import "source_l_common_level_instance_renaming.mm0";
import "source_l_common_level_members.mm0";
import "source_substitution_renaming.mm0";
import "source_l_domain.mm0";

def sfLUnaryAt (c x: nat): nat = $ sfRename (sfCLPairMap x x) 0 c $;

theorem sfLOrdinalAt_subst (k t d: nat):
 $ sfSubst k t (sfCLOrdinalAt d) = sfCLOrdinalAt (sfSubstIndex k t d) $;

theorem sfLHierarchyAt_subst (k t d y: nat):
 $ sfSubst k t (sfCLHierarchyAt d y) =
   sfCLHierarchyAt (sfSubstIndex k t d) (sfSubstIndex k t y) $;

theorem sfLUnaryAt_subst (c n k t x: nat) (hc: $ sfBound n c $):
 $ sfSubst k t (sfLUnaryAt c x) = sfLUnaryAt c (sfSubstIndex k t x) $;

theorem sfLUnaryAt_to_subst (c x: nat) (hc: $ sfBound 1 c $):
 $ sfLUnaryAt c x = sfSubst 0 x c $;

theorem sfLUnarySubst_subst (c k t x: nat) (hc: $ sfBound 1 c $):
 $ sfSubst k t (sfSubst 0 x c) = sfSubst 0 (sfSubstIndex k t x) c $;

theorem sfLDomainAt_subst (k t x: nat):
 $ sfSubst k t (sfSubst 0 x sfLDomain) = sfSubst 0 (sfSubstIndex k t x) sfLDomain $;

theorem sfLSubset_subst (k t a b: nat):
 $ sfSubst k t (sfCLSubset a b) = sfCLSubset (sfSubstIndex k t a) (sfSubstIndex k t b) $;
