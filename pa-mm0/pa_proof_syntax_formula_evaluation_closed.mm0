import "pa_proof_syntax_formula_evaluation_quantifiers.mm0";

import "pa_source_interpretation_equality_axiom_graph_laws.mm0";

theorem paFormulaSourceEvaluation_zero_code (n a c: nat): $ paTermBound n a -> sfAll (paFormulaSourceEvaluationBody 0 a c) = paSourceEqualityGraphEvaluation (paFormulaSource c) (paTermSource a) (paFormulaSource (paFormulaSubst 0 a c)) $;

theorem paFormulaSourceEvaluationCorrect_zero (n m a c: nat): $ paFormulaSourceEvaluationCorrect -> paTermBound n a -> paFormulaBound m c -> zfcProvable (paSourceEqualityGraphEvaluation (paFormulaSource c) (paTermSource a) (paFormulaSource (paFormulaSubst 0 a c))) $;
