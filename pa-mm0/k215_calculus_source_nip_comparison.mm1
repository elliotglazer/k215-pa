  '(eqtr (k215PItereq1 (eqtr (addeq1 mul0) add01)) k215PEq4726EqualBaseS2)
  '(eqtrd (a1i (k215PItereq1 k215EqTime_succ))
    (eqtrd (a1i k215PIter_add)
