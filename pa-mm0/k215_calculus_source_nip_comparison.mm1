  '(eqtr (k215PItereq (eqtr (addeq1 mul0) add01) (k215PEq4726Stateeq3 add0)) (eqtr k215PIter_add (eqtr (k215PItereq2 k215PEq4726StartYS2) k215PEq4726ClearY)))
  '(eqtrd (a1i (eqtr (k215PItereq k215EqTime_succ (k215PEq4726Stateeq3 addS)) (eqtr k215PIter_add (k215PItereq2 k215PEq4726PairS3)))) id));

@_ abstract def k215PEq4726Done (a b z out: nat) (.n: nat): wff =
 $ E. n k215PIter n (k215PEq4726State 0 a b z) = k215PEq4726State out 0 0 z $;
do (apply (register-eqd 'k215PEq4726Done) '(k215PEq4726Doneeqd));
theorem k215PEq4726Done_intro (a b z out n: nat): $ k215PIter n (k215PEq4726State 0 a b z) = k215PEq4726State out 0 0 z -> k215PEq4726Done a b z out $ =
 (named '(iexe ,eqtac));
theorem k215PEq4726Done_equal (a b z: nat): $ a = b -> k215PEq4726Done a b z k215CalEqN10 $ =
 '(mpbii (ax_mp k215PEq4726Done_intro k215PEq4726Equal) (k215PEq4726Doneeq2d id));
theorem k215PEq4726Done_greaterX (a b z: nat): $ b < a -> k215PEq4726Done a b z k215CalEqN11 $ =
 '(mpbii (ax_mp k215PEq4726Done_intro k215PEq4726GreaterX) (k215PEq4726Doneeq1d k215EqPositiveDifference));
theorem k215PEq4726Done_greaterY (a b z: nat): $ a < b -> k215PEq4726Done a b z k215CalEqN11 $ =
 '(mpbii (ax_mp k215PEq4726Done_intro k215PEq4726GreaterY) (k215PEq4726Doneeq2d k215EqPositiveDifference));
theorem k215PEq4726Done_different (a b z: nat): $ a != b -> k215PEq4726Done a b z k215CalEqN11 $ =
 '(syl (eor k215PEq4726Done_greaterY k215PEq4726Done_greaterX) (bi1 neltlt));
pub theorem k215PEq4726Done_all (a b z: nat): $ k215PEq4726Done a b z (if (a = b) k215CalEqN10 k215CalEqN11) $ =
 '(cases (mpbid (k215PEq4726Doneeq4d (eqcomd ifpos)) k215PEq4726Done_equal)
         (mpbid (k215PEq4726Doneeq4d (eqcomd ifneg)) k215PEq4726Done_different));


theorem k215Comparison4726DoneReach (a b z out: nat): $ k215PEq4726Done a b z out -> k215PReach (k215PEq4726State 0 a b z) (k215PEq4726State out 0 0 z) $ = (named '(eex k215PReach_intro));

theorem k215Comparison4726In (u t w c d a b r v: nat): $ k215PEq4726State 0 a b (k215PVector u t w c d a b r v) = (k215PState k215PNum4726 (k215PVector u t w c d a b r v)) $ = '(eqtr k215PEq4726At0 (k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector k215PR2_vector k215PR3_vector k215PR4_vector eqid eqid k215PR7_vector k215PR8_vector)));

theorem k215Comparison4726EqualOut (u t w c d a b r v: nat): $ k215PEq4726State k215CalEqN10 0 0 (k215PVector u t w c d a b r v) = (k215PState k215PNum4736 (k215PVector u t w c d 0 0 r v)) $ = '(eqtr k215PEq4726At10 (k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector k215PR2_vector k215PR3_vector k215PR4_vector eqid eqid k215PR7_vector k215PR8_vector)));

theorem k215Comparison4726DifferentOut (u t w c d a b r v: nat): $ k215PEq4726State k215CalEqN11 0 0 (k215PVector u t w c d a b r v) = (k215PState k215PNum4737 (k215PVector u t w c d 0 0 r v)) $ = '(eqtr k215PEq4726At11 (k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector k215PR2_vector k215PR3_vector k215PR4_vector eqid eqid k215PR7_vector k215PR8_vector)));

theorem k215Comparison4726EqualRaw (a b z: nat): $ a = b -> k215PReach (k215PEq4726State 0 a b z) (k215PEq4726State k215CalEqN10 0 0 z) $ = '(syl k215Comparison4726DoneReach k215PEq4726Done_equal);

pub theorem k215Comparison4726Equal (u t w c d a b r v: nat): $ a = b -> k215PReach (k215PState k215PNum4726 (k215PVector u t w c d a b r v)) (k215PState k215PNum4736 (k215PVector u t w c d 0 0 r v)) $ = '(mpbid (a1i (k215PReacheq k215Comparison4726In k215Comparison4726EqualOut)) k215Comparison4726EqualRaw);

theorem k215Comparison4726DifferentRaw (a b z: nat): $ a != b -> k215PReach (k215PEq4726State 0 a b z) (k215PEq4726State k215CalEqN11 0 0 z) $ = '(syl k215Comparison4726DoneReach k215PEq4726Done_different);

pub theorem k215Comparison4726Different (u t w c d a b r v: nat): $ a != b -> k215PReach (k215PState k215PNum4726 (k215PVector u t w c d a b r v)) (k215PState k215PNum4737 (k215PVector u t w c d 0 0 r v)) $ = '(mpbid (a1i (k215PReacheq k215Comparison4726In k215Comparison4726DifferentOut)) k215Comparison4726DifferentRaw);

