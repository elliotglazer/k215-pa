  '(eqtr (k215PItereq1 (eqtr (addeq1 mul0) add01)) k215PEq4726CleanYBaseS3)
  '(eqtrd (a1i (k215PItereq1 k215EqTime_succ))
    (eqtrd (a1i k215PIter_add)
      (eqtrd (a1i (k215PItereq2 k215PEq4726CleanYCycleS3)) id))));

pub theorem k215PEq4726Equal (x z: nat): $ k215PIter (3 * x + 2) (k215PEq4726State 0 x x z) = (k215PEq4726State k215CalEqN10 0 0 z) $ =
