pub theorem k215PEq4726GreaterX (x y z: nat): $ k215PIter (3 * y + (3 + (2 * x + 3))) (k215PEq4726State 0 (suc x + y) y z) = (k215PEq4726State k215CalEqN11 0 0 z) $ =
 (named @ induct '(ind) 'y
  '(eqtr (k215PItereq (eqtr (addeq1 mul0) add01) (k215PEq4726Stateeq2 add0)) (eqtr k215PIter_add (eqtr (k215PItereq2 k215PEq4726StartXS3) k215PEq4726ClearX)))
  '(eqtrd (a1i (eqtr (k215PItereq k215EqTime_succ (k215PEq4726Stateeq2 addS)) (eqtr k215PIter_add (k215PItereq2 k215PEq4726PairS3)))) id));

pub theorem k215PEq4726GreaterY (x y z: nat): $ k215PIter (3 * x + (2 + (3 * y + 3))) (k215PEq4726State 0 x (suc y + x) z) = (k215PEq4726State k215CalEqN11 0 0 z) $ =
