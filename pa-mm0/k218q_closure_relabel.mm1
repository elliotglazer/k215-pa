pub theorem k218QClosure_separate (E: set) (n B a b c f: nat)
 (ha0: $ 0 < a $) (hab: $ a < b $) (hbc: $ b < c $)
 (haB: $ a < B $) (hbB: $ b < B $)
 (heA: $ sqEnvAvoid E n a $) (heB: $ sqEnvAvoid E n b $)
