theorem k218CR_matrix_fresh (E: set) (n B q r z f: nat)
 (hzB: $ z < B $) (hz0: $ z != 0 $)
 (hzq: $ z != q $) (hzr: $ z != r $)
 (he: $ sqEnvAvoid E n z $) (hf: $ sfBound (suc (suc n)) f $):
 $ kFresh (sfNamedTemplate (sqEnvCons q (sqEnvCons r E)) B 0 f) z $ =
'(ax_mp (ax_mp (sfNamedTemplate_fresh hzB hz0)
    (mpbir (sfBoundeq1 add01) hf))
  (ax_mp (ax_mp k218RoleAvoid_cons hzq)
    (ax_mp (ax_mp k218RoleAvoid_cons hzr) he)));

@_ def k218ClosurePhase0 (E: set) (n B a b c u v p w x y f: nat): nat =
 $ (kAll b (kImp (kMem b c) (kExists a (kAnd (sfNamedTemplate (sqEnvCons b (sqEnvCons a E)) B 0 f) (kAll a (kImp (kAll c (kImp (kMem c a) (kMem c b))) (kAll b (kImp (sfNamedTemplate (sqEnvCons b (sqEnvCons a E)) B 0 f) (kExists b (kAnd (sfNamedTemplate (sqEnvCons b (sqEnvCons a E)) B 0 f) (kMem b c))))))))))) $;

@_ def k218ClosureAlphaBody0 (E: set) (n B a b c u v p w x y f: nat): nat =
 $ (kAnd (sfNamedTemplate (sqEnvCons b (sqEnvCons a E)) B 0 f) (kMem b c)) $;

theorem k218CR_substitution0 (E: set) (n B a b c u v p w x y f: nat)
 (ha0: $ 0 < a $)
 (ho0: $ a < b $)
 (ho1: $ b < c $)
 (ho2: $ c < y $)
 (ho3: $ y < x $)
 (ho4: $ x < w $)
 (ho5: $ w < p $)
 (ho6: $ p < v $)
 (ho7: $ v < u $)
 (haB: $ a < B $) (hbB: $ b < B $)
 (heA: $ sqEnvAvoid E n a $) (heB: $ sqEnvAvoid E n b $)
 (hf: $ sfBound (suc (suc n)) f $):
 $ kSubst (k218ClosureAlphaBody0 E n B a b c u v p w x y f) b y = (kAnd (sfNamedTemplate (sqEnvCons y (sqEnvCons a E)) B 0 f) (kMem y c)) $ =
'(eqtr (qsSubst_kAnd (ltneri (lttr ha0 ho0))) (kAndeq (k218RoleOutput_substitution hbB (ltneri (lttr ha0 ho0)) (ltneri ho0) heB hf) (eqtr kSubst_kMem (kMemeq kReplace_hit (ax_mp kReplace_miss (ltneri ho1))))));

