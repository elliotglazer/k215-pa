theorem k215BinaryUnpairInAt319 (u t w c a b v: nat): $ (k215UnpairAt319State k215PNum319 0 0 w (k215PVector u t w c a b 0 0 v)) = (k215PState k215PNum319 (k215PVector u t w c a b 0 0 v)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector eqid k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryUnpairOutAt319 (u t w c a b v: nat): $ (k215UnpairAt319State k215PNum327 (fst w) (snd w) 0 (k215PVector u t w c a b 0 0 v)) = (k215PState k215PNum327 (k215PVector u t 0 c a b (fst w) (snd w) v)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector eqid k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryUnpairAt319 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum319 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum327 (k215PVector u t 0 c a b (fst w) (snd w) v)) $ =
 '(mpbi (k215PReacheq k215BinaryUnpairInAt319 k215BinaryUnpairOutAt319) k215UnpairMacro319_clean);

theorem k215BinaryRestoreStackAt319 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum327 (k215PVector u t 0 c a b (fst w) (snd w) v)) (k215PState k215PNum330 (k215PVector u t (snd w) c a b (fst w) 0 v)) $ =
 '(k215PReach_intro (eqtr k215Loop327Vector (k215PStateeq2 (k215PVectoreq3 add0))));

theorem k215BinaryPairInAt319 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt330State k215PNum330 a6 a1 a7 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum330 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryPairOutAt319 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt330State k215PNum340 0 0 (a7 + (a6, a1)) (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum340 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryPairAt319 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat):
 $ k215PReach (k215PState k215PNum330 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215PNum340 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ =
 '(mpbi (k215PReacheq k215BinaryPairInAt319 k215BinaryPairOutAt319) k215PairMacro330);

theorem k215BinaryPairCleanAt319 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum330 (k215PVector u t (snd w) c a b (fst w) 0 v)) (k215PState k215PNum340 (k215PVector u 0 (snd w) c a b 0 (fst w, t) v)) $ =
 '(mpbi (k215PReacheq2 (k215PStateeq2 (k215PVectoreq8 add01))) k215BinaryPairAt319);
theorem k215BinaryFourAt319 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum340 (k215PVector u 0 (snd w) c a b 0 (fst w, t) v)) (k215PState k215PNum346 (k215PVector u (4 * (fst w, t)) (snd w) c a b 0 0 v)) $ =
 '(k215PReach_intro (eqtr k215Loop340Vector (k215PStateeq2 (k215PVectoreq2 add0))));

theorem k215BinaryTagAllAt319 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum346 (k215PVector u (4 * (fst w, t)) (snd w) c a b 0 0 v)) (k215PState k215PNum346 (k215PVector u (kImp (fst w) t) (snd w) c a b 0 0 v)) $ = 'k215PReach_refl;

pub theorem k215BinaryConstructor319 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum319 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum346 (k215PVector u (kImp (fst w) t) (snd w) c a b 0 0 v)) $ = '(ax_mp (ax_mp k215PReach_trans k215BinaryUnpairAt319) (ax_mp (ax_mp k215PReach_trans k215BinaryRestoreStackAt319) (ax_mp (ax_mp k215PReach_trans k215BinaryPairCleanAt319) (ax_mp (ax_mp k215PReach_trans k215BinaryFourAt319) k215BinaryTagAllAt319))));

