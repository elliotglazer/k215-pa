import "source_l_power_shell_replay.mm0";

import "source_l_power_shell_syntax.mm0";

import "source_l_power_collection_syntax.mm0";

import "source_l_level_member_extension.mm0";

import "source_l_pair_shell.mm0";

import "extracted_ltrans_weak.mm0";

def slPSEqF0: nat = $ sfMem 0 1 $;

def slPSEqF1: nat = $ sfMem 0 3 $;

def slPSEqF2: nat = $ sfImp slPSEqF0 slPSEqF1 $;

def slPSEqF3: nat = $ sfAll slPSEqF2 $;

def slPSEqF4: nat = $ sfImp sfLDomain slPSEqF2 $;

def slPSEqF5: nat = $ sfAll slPSEqF4 $;

def slPSEqF6: nat = $ sfImp slPSEqF0 slPSEqF3 $;

def slPSEqF7: nat = $ sfImp slPSEqF0 slPSEqF5 $;

def slPSEqF8: nat = $ sfImp slPSEqF3 slPSEqF0 $;

def slPSEqF9: nat = $ sfImp slPSEqF5 slPSEqF0 $;

def slPSEqF10: nat = $ sfAnd slPSEqF6 slPSEqF8 $;

def slPSEqF11: nat = $ sfAnd slPSEqF7 slPSEqF9 $;

def slPSEqF12: nat = $ sfAll slPSEqF10 $;

def slPSEqF13: nat = $ sfImp sfLDomain slPSEqF11 $;

def slPSEqF14: nat = $ sfAll slPSEqF13 $;

def slPSEqF15: nat = $ sfEx slPSEqF12 $;

def slPSEqF16: nat = $ sfAnd sfLDomain slPSEqF14 $;

def slPSEqF17: nat = $ sfEx slPSEqF16 $;

theorem sfLPowerShell_context: $ slPSContext = sfLBackground $;

theorem sfLPowerShell_formula: $ slPSFormula = sfImp sfLTransitivity (sfImp sfLStageTrans (sfImp sfLPowerLevelBound (sfImp sfLLevelExtension (sfImp sfLPairNextLevel (sfImp sfLDefPower (sfRelativize sfLDomain zfcPower)))))) $;

theorem sfLPowerShell_local: $ nsLocal sfLBackground (sfImp sfLTransitivity (sfImp sfLStageTrans (sfImp sfLPowerLevelBound (sfImp sfLLevelExtension (sfImp sfLPairNextLevel (sfImp sfLDefPower (sfRelativize sfLDomain zfcPower))))))) $;

theorem sfLPowerShell_zfr: $ sfTheoryProvable zfrAxioms (sfImp sfLTransitivity (sfImp sfLStageTrans (sfImp sfLPowerLevelBound (sfImp sfLLevelExtension (sfImp sfLPairNextLevel (sfImp sfLDefPower (sfRelativize sfLDomain zfcPower))))))) $;

theorem sfLPower_reduced_zfr: $ sfTheoryProvable zfrAxioms (sfImp sfLPowerLevelBound (sfImp sfLLevelExtension (sfImp sfLPairNextLevel (sfImp sfLDefPower (sfRelativize sfLDomain zfcPower))))) $;
