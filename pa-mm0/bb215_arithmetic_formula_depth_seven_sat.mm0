def bb215ArithmeticFormulaDepthSevenSatBody (E: set) (c h .x: nat): wff = $ ifp (c = 0) (0 != 0) (ifp (sfTag c = 1) (bb215ArithmeticFormulaTermValue E (sfLeft c) = bb215ArithmeticFormulaTermValue E (sfRight c)) (ifp (sfTag c = 3) (sfLeft c e. h /\ sfRight c e. h) (ifp (sfTag c = 4) (sfLeft c e. h \/ sfRight c e. h) (ifp (sfTag c = 5) (sfLeft c e. h -> sfRight c e. h) (ifp (sfTag c = 6 /\ sfRight c = 0) (A. x bb215ArithmeticFormulaDepthSixSat (paNatTermConsEnvironment E x) (sfLeft c)) (ifp (sfTag c = 7 /\ sfRight c = 0) (E. x bb215ArithmeticFormulaDepthSixSat (paNatTermConsEnvironment E x) (sfLeft c)) (0 != 0))))))) $;

def bb215ArithmeticFormulaDepthSevenSatStep (E: set) (.c .h: nat): set = $ S\ c, {h | bb215ArithmeticFormulaDepthSevenSatBody E c h} $;

def bb215ArithmeticFormulaDepthSevenSat (E: set) (c: nat): wff = $ srecp (bb215ArithmeticFormulaDepthSevenSatStep E) c $;

def bb215ArithmeticFormulaDepthSevenSatPrevious (E: set) (c .i: nat): nat = $ sep (upto c) {i | srecp (bb215ArithmeticFormulaDepthSevenSatStep E) i} $;

theorem bb215ArithmeticFormulaDepthSevenSatStep_value (E: set) (c h: nat): $ (c, h) e. bb215ArithmeticFormulaDepthSevenSatStep E <-> bb215ArithmeticFormulaDepthSevenSatBody E c h $;

theorem bb215ArithmeticFormulaDepthSevenSatPrevious_value (E: set) (c a: nat): $ a e. bb215ArithmeticFormulaDepthSevenSatPrevious E c <-> a < c /\ bb215ArithmeticFormulaDepthSevenSat E a $;

theorem bb215ArithmeticFormulaDepthSevenSat_unfold (E: set) (c: nat): $ bb215ArithmeticFormulaDepthSevenSat E c <-> bb215ArithmeticFormulaDepthSevenSatBody E c (bb215ArithmeticFormulaDepthSevenSatPrevious E c) $;

theorem bb215ArithmeticFormulaDepthSevenSat_false (E: set): $ bb215ArithmeticFormulaDepthSevenSat E paFormulaFalse <-> 0 != 0 $;

theorem bb215ArithmeticFormulaDepthSevenSat_equal (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthSevenSat E (paFormulaEqual a b) <-> bb215ArithmeticFormulaTermValue E a = bb215ArithmeticFormulaTermValue E b $;

theorem bb215ArithmeticFormulaDepthSevenSat_and (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthSevenSat E (paFormulaAnd a b) <-> (bb215ArithmeticFormulaDepthSevenSat E a /\ bb215ArithmeticFormulaDepthSevenSat E b) $;

theorem bb215ArithmeticFormulaDepthSevenSat_or (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthSevenSat E (paFormulaOr a b) <-> (bb215ArithmeticFormulaDepthSevenSat E a \/ bb215ArithmeticFormulaDepthSevenSat E b) $;

theorem bb215ArithmeticFormulaDepthSevenSat_imp (E: set) (a b: nat): $ bb215ArithmeticFormulaDepthSevenSat E (paFormulaImp a b) <-> (bb215ArithmeticFormulaDepthSevenSat E a -> bb215ArithmeticFormulaDepthSevenSat E b) $;

theorem bb215ArithmeticFormulaDepthSevenSat_all (E: set) (a: nat) {x: nat}: $ bb215ArithmeticFormulaDepthSevenSat E (paFormulaAll a) <-> A. x bb215ArithmeticFormulaDepthSixSat (paNatTermConsEnvironment E x) a $;

theorem bb215ArithmeticFormulaDepthSevenSat_ex (E: set) (a: nat) {x: nat}: $ bb215ArithmeticFormulaDepthSevenSat E (paFormulaEx a) <-> E. x bb215ArithmeticFormulaDepthSixSat (paNatTermConsEnvironment E x) a $;
