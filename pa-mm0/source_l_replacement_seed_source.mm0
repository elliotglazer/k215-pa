import "source_l_replacement_seed.mm0";

import "source_l_replacement_range_source.mm0";

import "source_l_power_collection_syntax.mm0";

def sfLReplacementSeedMetadata:nat = $ slPQF778 $;

def sfLReplacementSeedMatrix(phi:nat):nat =
 $ sfRelativize sfLDomain (sfRename sfRepCMap 0 phi) $;

theorem sfLReplacement_seed_bound_exact(c:nat):
 $ sfLPowerLevelBound = sfAll (sfLReplacementSeedBound c sfLReplacementSeedMetadata) $;

theorem sfLReplacement_seed_metadata_wf:
 $ sfWf sfLReplacementSeedMetadata $;

theorem sfLReplacement_seed_bound_open(G c:nat)
 (hp:$ nsLocal G sfLPowerLevelBound $):
 $ nsLocal G (sfLReplacementSeedBound c sfLReplacementSeedMetadata) $;

theorem sfLReplacement_ambient_seed_exact(phi:nat)(hf:$ sfWf phi $):
 $ sfLReplacementAmbientBody phi =
 sfLReplacementAmbientBase (sfLReplacementSeedMatrix phi) sfLReplacementSeedMetadata $;

theorem sfLReplacement_seed_from_L_bound(G phi:nat)(hf:$ sfWf phi $)
 (hi:$ nsLocal G (sfLReplacementAmbientBody phi) $)
 (hb:$ nsLocal G sfLPowerLevelBound $):
 $ nsLocal G (sfLReplacementSeedRange (sfLReplacementSeedMatrix phi) sfLReplacementSeedMetadata) $;
