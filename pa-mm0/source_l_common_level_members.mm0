import "source_l_common_level_blocks.mm0";

def sfCLSubset (a b: nat): nat =
 $ sfAll (sfImp (sfMem 0 (suc a)) (sfMem 0 (suc b))) $;

theorem sfCLSubset_use (G a b x: nat) (hs: $ nsLocal G (sfCLSubset a b) $):
 $ nsLocal G (sfMem x a) -> nsLocal G (sfMem x b) $;

theorem sfCLMembership_mono (G start a b n: nat) (hs: $ nsLocal G (sfCLSubset a b) $):
 $ nsLocal G (sfCLMembership start a n) -> nsLocal G (sfCLMembership start b n) $;
