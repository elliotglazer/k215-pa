import "k218q_quotient_mixed_rebase.mm0";

def k218QMixedEnv (H S T n t k .i: nat): wff = $ A. i (i < n -> k218QMixed H t k (sqNumericEnvironment S @ i) (sqNumericEnvironment T @ i)) $;

theorem k218QMixedEnv_at (H S T n t k i: nat): $ k218QMixedEnv H S T n t k -> i < n -> k218QMixed H t k (sqNumericEnvironment S @ i) (sqNumericEnvironment T @ i) $;

theorem k218QMixed_same (H t k x: nat): $ k218QMixed H t k x x $;

theorem k218QMixedEnv_same (H S n t k: nat): $ k218QMixedEnv H S S n t k $;

theorem k218QMixed_refine (G: wff) (H J t k x y: nat) (hs: $ G -> k218IContextSupports J H $) (hr: $ G -> k218QMixed H t k x y $): $ G -> k218QMixed J t k x y $;

theorem k218QMixedEnv_refine (G: wff) (H J S T n t k: nat) (hs: $ G -> k218IContextSupports J H $) (hr: $ G -> k218QMixedEnv H S T n t k $): $ G -> k218QMixedEnv J S T n t k $;

theorem k218QMixedEnv_weaken (H a S T n t k: nat): $ k218QMixedEnv H S T n t k -> k218QMixedEnv (a : H) S T n t k $;

theorem k218QMixedEnv_sym (G: wff) (H S T n t k: nat) (hs: $ G -> sqEnvironmentSafe S n t k $) (ht: $ G -> sqEnvironmentSafe T n t k $) (he: $ G -> k218IHypProvable H (k218QAEmpty t k) $) (hr: $ G -> k218QMixedEnv H S T n t k $): $ G -> k218QMixedEnv H T S n t k $;

theorem k218QMixedEnv_rebase (G: wff) (H S T n t k l: nat) (hsk: $ G -> sqEnvironmentSafe S n t k $) (htk: $ G -> sqEnvironmentSafe T n t k $) (hsl: $ G -> sqEnvironmentSafe S n t l $) (htl: $ G -> sqEnvironmentSafe T n t l $) (hr: $ G -> k218QMixedEnv H S T n t k $): $ G -> k218QMixedEnv H S T n t l $;

theorem k218QMixedEnv_cons (H S T n t k z: nat): $ k218QMixedEnv H S T n t k -> k218QMixedEnv H (z : S) (z : T) (suc n) t k $;
