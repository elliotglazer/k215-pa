import "mp_kernel.mm0";

def fAll (a: nat): nat = $ suc (4, a) $;

def genRules (.c .l .b: nat): set =
$ S\ c, {l | E. b (b IN l /\ c = fAll b)} $;

def folRules (A: set): set = $ mpRules A u. genRules $;

theorem genRules_value {b: nat} (c l: nat):
  $ (c, l) e. genRules <-> E. b (b IN l /\ c = fAll b) $;
theorem folRules_stable (A: set): $ traceAppendStable (folRules A) $;
theorem folDerives_axiom (A: set) (a: nat):
  $ a e. A -> traceDerives (folRules A) (a : 0) a $;
theorem folDerives_mp (A: set) (p q a b: nat):
  $ traceDerives (folRules A) p a -> traceDerives (folRules A) q (fImp a b) ->
    traceDerives (folRules A) (b : (p ++ q)) b $;
theorem folDerives_gen (A: set) (p a: nat):
  $ traceDerives (folRules A) p a -> traceDerives (folRules A) (fAll a : p) (fAll a) $;
