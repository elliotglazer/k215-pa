import "pa_source_interpretation_formula_eqd_support.mm0";

import "pa_source_interpretation_term_induction.mm0";

import "pa_formula_induction.mm0";

import "pa_axiom_syntax.mm0";

def paNumeralLevelTermClass (m .c: nat): set = $ {c | paTermBound m c} $;

theorem paTermBound_mono (n m c: nat): $ n <= m -> paTermBound n c -> paTermBound m c $;

def paNumeralLevelFormulaClass (.n .c .m: nat): set = $ S\ n, {c | A. m (n <= m -> paFormulaBound m c)} $;

theorem paFormulaBound_mono (n m c: nat): $ n <= m -> paFormulaBound n c -> paFormulaBound m c $;

theorem paAxiomCase_mono (n m j a b d c: nat): $ n <= m -> paAxiomCase n j a b d c -> paAxiomCase m j a b d c $;

theorem paAxiomSyntax_mono (n m c w: nat): $ n <= m -> paAxiomSyntax n c w -> paAxiomSyntax m c w $;
