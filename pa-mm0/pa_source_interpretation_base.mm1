pub theorem paSourceInductive_bound: $ sfBound 1 paSourceInductive $ = (named '(mpbir sfBound_sfAnd (iani (mpbir sfBound_sfEx (mpbir sfBound_sfAnd (iani (mpbir sfBound_sfAll (mpbir sfBound_sfImp (iani (mpbir sfBound_sfMem (iani lt01S (ltletr ltsucid lesucid))) sfBound_bot))) (mpbir sfBound_sfMem (iani lt01S ltsucid))))) (mpbir sfBound_sfAll (mpbir sfBound_sfImp (iani (mpbir sfBound_sfMem (iani lt01S ltsucid)) (mpbir sfBound_sfEx (mpbir sfBound_sfAnd (iani (mpbir sfBound_sfAll (mpbir sfBound_sfAnd (iani (mpbir sfBound_sfImp (iani (mpbir sfBound_sfMem (iani lt01S (ltletr (ltletr ltsucid lesucid) lesucid))) (mpbir sfBound_sfOr (iani (mpbir sfBound_sfMem (iani lt01S (ltletr ltsucid lesucid))) (mpbir sfBound_sfEq (iani lt01S (ltletr ltsucid lesucid))))))) (mpbir sfBound_sfImp (iani (mpbir sfBound_sfOr (iani (mpbir sfBound_sfMem (iani lt01S (ltletr ltsucid lesucid))) (mpbir sfBound_sfEq (iani lt01S (ltletr ltsucid lesucid))))) (mpbir sfBound_sfMem (iani lt01S (ltletr (ltletr ltsucid lesucid) lesucid)))))))) (mpbir sfBound_sfMem (iani lt01S ltsucid)))))))))));

