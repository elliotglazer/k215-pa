theorem paSI_refl_at: $ nsLocal (paSISuccessor10 : (paSourceZero : (paSIF25 : 0))) paSIreflPoint $ = (named '(mpbi (nsLocaleq2 paSI_refl_subst) (nsLocal_AllE (nsLocal_hyp (mpbir sfContextWf_cons (iani (sfWf_all (sfWf_and (sfWf_imp sfWf_mem (sfWf_or sfWf_mem sfWf_eq)) (sfWf_imp (sfWf_or sfWf_mem sfWf_eq) sfWf_mem))) (mpbir sfContextWf_cons (iani (sfWf_all (sfWf_imp sfWf_mem sfWf_bot)) (mpbir sfContextWf_cons (iani (sfWf_all sfWf_eq) sfContextWf_nil)))))) (sfContext_member_tail (sfContext_member_tail sfContext_member_head))))));

