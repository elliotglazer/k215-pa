theorem paSI_successor_at: $ nsLocal (paSISuccessor10 : (paSourceZero : (paSIF25 : 0))) paSIsuccessorPoint $ = (named '(mpbi (nsLocaleq2 paSI_successor_subst) (nsLocal_AllE (nsLocal_hyp (mpbir sfContextWf_cons (iani (sfWf_all (sfWf_and (sfWf_imp sfWf_mem (sfWf_or sfWf_mem sfWf_eq)) (sfWf_imp (sfWf_or sfWf_mem sfWf_eq) sfWf_mem))) (mpbir sfContextWf_cons (iani (sfWf_all (sfWf_imp sfWf_mem sfWf_bot)) (mpbir sfContextWf_cons (iani (sfWf_all sfWf_eq) sfContextWf_nil)))))) sfContext_member_head))));

