import "source_l_replacement_common_reflected.mm0";
import "source_l_separation_image_collector_kernel.mm0";

theorem slSepReflected_inner(G start params count phi a X:nat)(hb:$ sfBound count phi $)
 (hS:$ nsLocal G (sfReflectionHierarchySubsetNormal sfCLHierarchy) $)
 (hp:$ nsLocal G (sfCLPoint start params a X) $):
 $ nsLocal (lrrAboveSecond G count phi a) (sfCLReflectedPoint (suc (suc start)) params count phi 1 0) $;
theorem sfLSeparationReflect_collected(G start params count phi a X:nat)(hb:$ sfBound count phi $)
 (hA:$ nsLocal G (sfLReplacementAboveLaw count phi) $)
 (hL:$ nsLocal G sfLReplacementLevelExistsLaw $)
 (hS:$ nsLocal G (sfReflectionHierarchySubsetNormal sfCLHierarchy) $)
 (hp:$ nsLocal G (sfCLPoint start params a X) $):
 $ nsLocal G (sfCLReflectedRecipe start params count phi) $;
theorem slSepAboveLaw_bound(count phi:nat)(hb:$ sfBound count phi $):
 $ sfBound 0 (sfLReplacementAboveLaw count phi) $;
theorem slSepWitnessClosed(G point a:nat)(hp:$ sfWf point $)(hb:$ sfBound 0 a $)(ha:$ nsLocal G a $):
 $ nsLocal (sfCLWitnessContext G point) a $;
theorem sfLSeparationReflectedRecipe_from_collected(G start params count phi:nat)(hb:$ sfBound count phi $)
 (hA:$ nsLocal G (sfLReplacementAboveLaw count phi) $)
 (hL:$ nsLocal G sfLReplacementLevelExistsLaw $)
 (hS:$ nsLocal G (sfReflectionHierarchySubsetNormal sfCLHierarchy) $)
 (hc:$ nsLocal G (sfCLRecipe start params) $):
 $ nsLocal G (sfCLReflectedRecipe start params count phi) $;
