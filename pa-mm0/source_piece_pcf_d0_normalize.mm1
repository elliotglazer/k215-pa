theorem pcn_lpm_at{j:nat}(R:set)(d z zz i:nat):
 $ (A. j (sfRenameDepthMap R d @ (j + z) = j + zz)) -> sfRenameDepthMap R d @ (i + z) = i + zz $ =
(named '(!! eale j ,eqtac));
theorem pcn_lpm_zero{j:nat}(R:set)(d x z zz:nat)(ht:$ A. j (sfRenameDepthMap R d @ (j + z) = j + zz) $):
 $ sfComposeMap (sfRenameDepthMap R d) (sfLeastParamMap x z) @ 0 = sfLeastParamMap (sfRenameDepthMap R d @ x) zz @ 0 $ =
'(eqtr sfComposeMap_value (eqtr (sfLPM_app sfLPM_zero) (eqcom sfLPM_zero)));
theorem pcn_lpm_suc{j:nat}(R:set)(d x z zz i:nat)(ht:$ A. j (sfRenameDepthMap R d @ (j + z) = j + zz) $):
 $ sfComposeMap (sfRenameDepthMap R d) (sfLeastParamMap x z) @ suc i = sfLeastParamMap (sfRenameDepthMap R d @ x) zz @ suc i $ =
'(eqtr sfComposeMap_value (eqtr (sfLPM_app sfLPM_suc) (eqtr (ax_mp pcn_lpm_at ht) (eqcom sfLPM_suc))));
theorem pcn_lpm_each{j:nat}(R:set)(d x z zz i:nat)(ht:$ A. j (sfRenameDepthMap R d @ (j + z) = j + zz) $):
 $ sfComposeMap (sfRenameDepthMap R d) (sfLeastParamMap x z) @ i = sfLeastParamMap (sfRenameDepthMap R d @ x) zz @ i $ =
(named @ induct '(ind) 'i '(pcn_lpm_zero ht) '(a1i (pcn_lpm_suc ht)));
theorem pcn_lpm_rename{j:nat}(R:set)(d phi x z zz:nat)(hf:$ sfWf phi $)(ht:$ A. j (sfRenameDepthMap R d @ (j + z) = j + zz) $):
 $ sfRename R d (sfLeastParam phi x z) = sfLeastParam phi (sfRenameDepthMap R d @ x) zz $ =
'(eqtr (ax_mp sfRename_mixed_compose hf) (ax_mp (sfRename_extensional (!! ax_gen i @ ! pcn_lpm_each j R d x z zz i ht)) hf));
theorem pcn_tail(x y i:nat):
 $ sfRenameDepthMap (sfLCBinaryMap x y 3) 2 @ (i + 4) = i + 5 $ =
'(eqtr (sfLPM_app (eqtr addS (suceq (eqtr addS (suceq (eqtr addS (suceq (eqtr addS (suceq add02)))))))))
 (eqtr sfRenameDepthMap_value
 (eqtr sfRenameIndex_lift (eqtr (suceq sfRenameIndex_lift)
 (eqtr (suceq (suceq sfRenameIndex_zero))
 (eqtr (suceq (suceq sfLCB_tail))
 (eqtr (suceq (suceq (eqtr addS (suceq (eqtr addS (suceq (eqtr addS (suceq add02)))))))) (eqcom (eqtr addS (suceq (eqtr addS (suceq (eqtr addS (suceq (eqtr addS (suceq (eqtr addS (suceq add02))))))))))))))))));
theorem pcn_slot(phi x y:nat)(hf:$ sfWf phi $):
 $ sfRename (sfLCBinaryMap x y 3) 2 (sfLeastParam phi 0 4) = sfLeastParam phi 0 5 $ =
'(eqtr (pcn_lpm_rename hf (!! ax_gen i @ ! pcn_tail x y i))
 (sfLeastParam_congr hf (eqtr sfRenameDepthMap_value (ax_mp sfRenameIndex_bound d0lt2)) eqid));


