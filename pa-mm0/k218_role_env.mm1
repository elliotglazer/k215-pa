theorem k218RoleClosureInput_tail (i: nat): $ sfK218ClosureInputMap @ (suc (suc i)) = (suc (suc (suc (suc (suc (suc i)))))) $ =
'(eqtr sfK218ClosureInputMap_value (eqtr (ifneg (mpbi lenlt (mpbi lesuc (mpbi lesuc le01)))) (eqtr addS (suceq (eqtr addS (suceq (eqtr addS (suceq (eqtr addS (suceq add0))))))))));

theorem k218RoleClosureInput_at_zero (E: set) (x p v u c a: nat): $ sfComposeMap (sqEnvCons x (sqEnvCons p (sqEnvCons v (sqEnvCons u (sqEnvCons c (sqEnvCons a E)))))) sfK218ClosureInputMap @ 0 = (sqEnvCons x (sqEnvCons p E)) @ 0 $ =
