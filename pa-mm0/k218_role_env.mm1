'(eqtr sfComposeMap_value (eqtr (appeq2 k218RoleClosureInput_one) (eqtr (eqtr sqEnvCons_suc sqEnvCons_zero) (eqcom (eqtr sqEnvCons_suc sqEnvCons_zero)))));

theorem k218RoleClosureInput_at_tail (E: set) (x p v u c a i: nat): $ sfComposeMap (sqEnvCons x (sqEnvCons p (sqEnvCons v (sqEnvCons u (sqEnvCons c (sqEnvCons a E)))))) sfK218ClosureInputMap @ (suc (suc i)) = (sqEnvCons x (sqEnvCons p E)) @ (suc (suc i)) $ =
'(eqtr sfComposeMap_value (eqtr (appeq2 k218RoleClosureInput_tail) (eqtr (eqtr sqEnvCons_suc (eqtr sqEnvCons_suc (eqtr sqEnvCons_suc (eqtr sqEnvCons_suc (eqtr sqEnvCons_suc sqEnvCons_suc))))) (eqcom (eqtr sqEnvCons_suc sqEnvCons_suc)))));

pub theorem k218RoleClosureInput_at (E: set) (x p v u c a i: nat): $ sfComposeMap (sqEnvCons x (sqEnvCons p (sqEnvCons v (sqEnvCons u (sqEnvCons c (sqEnvCons a E)))))) sfK218ClosureInputMap @ i = (sqEnvCons x (sqEnvCons p E)) @ i $ =
(named '(k218RoleCases_at k218RoleClosureInput_at_zero k218RoleClosureInput_at_one
  (ax_gen {k218RoleClosureInput_at_tail : $ sfComposeMap (sqEnvCons x (sqEnvCons p (sqEnvCons v (sqEnvCons u (sqEnvCons c (sqEnvCons a E)))))) sfK218ClosureInputMap @ suc (suc j) = (sqEnvCons x (sqEnvCons p E)) @ suc (suc j) $})));

pub theorem k218RoleClosureInput_environment (E: set) (x p v u c a: nat): $ sfComposeMap (sqEnvCons x (sqEnvCons p (sqEnvCons v (sqEnvCons u (sqEnvCons c (sqEnvCons a E)))))) sfK218ClosureInputMap == (sqEnvCons x (sqEnvCons p E)) $ =
