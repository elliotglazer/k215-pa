pub theorem k218RoleClosureOutput_at (E: set) (y x p v u c a i: nat): $ sfComposeMap (sqEnvCons y (sqEnvCons x (sqEnvCons p (sqEnvCons v (sqEnvCons u (sqEnvCons c (sqEnvCons a E))))))) sfK218ClosureOutputMap @ i = (sqEnvCons y (sqEnvCons p E)) @ i $ =
