theorem k218RoleClosureOutput_at_zero (E: set) (y x p v u c a: nat): $ sfComposeMap (sqEnvCons y (sqEnvCons x (sqEnvCons p (sqEnvCons v (sqEnvCons u (sqEnvCons c (sqEnvCons a E))))))) sfK218ClosureOutputMap @ 0 = (sqEnvCons y (sqEnvCons p E)) @ 0 $ =
