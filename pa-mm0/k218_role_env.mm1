theorem k218RoleClosureOutput_at_one (E: set) (y x p v u c a: nat): $ sfComposeMap (sqEnvCons y (sqEnvCons x (sqEnvCons p (sqEnvCons v (sqEnvCons u (sqEnvCons c (sqEnvCons a E))))))) sfK218ClosureOutputMap @ 1 = (sqEnvCons y (sqEnvCons p E)) @ 1 $ =
'(eqtr sfComposeMap_value (eqtr (appeq2 k218RoleClosureOutput_one) (eqtr (eqtr sqEnvCons_suc (eqtr sqEnvCons_suc sqEnvCons_zero)) (eqcom (eqtr sqEnvCons_suc sqEnvCons_zero)))));

theorem k218RoleClosureOutput_at_tail (E: set) (y x p v u c a i: nat): $ sfComposeMap (sqEnvCons y (sqEnvCons x (sqEnvCons p (sqEnvCons v (sqEnvCons u (sqEnvCons c (sqEnvCons a E))))))) sfK218ClosureOutputMap @ (suc (suc i)) = (sqEnvCons y (sqEnvCons p E)) @ (suc (suc i)) $ =
