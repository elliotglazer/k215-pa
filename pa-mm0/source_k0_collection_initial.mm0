import "source_k0_collection_substitution.mm0";

import "source_k0_collection_branches.mm0";

theorem sfK0Collection_root_seed (E: set) (n b t r a c y x R psi: nat) (hf: $ sfBound (suc (suc n)) psi $)
 (hy0: $ y != 0 $) (hyR: $ y < R $) (hyx: $ y < x $)
 (hbR: $ b < R $) (hbx: $ b < x $) (htR: $ t < R $) (htx: $ t < x $)
 (hb: $ b != y $) (ht: $ t != y $) (hr: $ r != y $)
 (ha: $ a != y $) (hc: $ c != y $) (he: $ sqEnvAvoid E n y $):
 $ k218QProvable (kImp (kAll y (kImp (kImp (kImp (kImp (kImp (kEq r r) (kImp (kEq y b) kF)) kF) kF) (kImp (kImp (kImp (kImp (kEq r t) (kImp (kEq y t) kF)) kF) kF) (kImp (kAll x (kImp (kImp (kImp (sfK0QSepNamedSingleton x r R) (kImp (kImp (kImp (kImp (kImp (kMem t x) (kImp (kMem x a) kF)) kF) (kImp (kImp (kImp (kMem t y) (kImp (sfK0CollectionRel E R y x psi) kF)) kF) kF)) kF) kF)) kF) kF)) kF))) kF)) kF) $;

theorem sfK0Collection_root_request_member (E: set) (n b t r a c y x R psi: nat) (hf: $ sfBound (suc (suc n)) psi $)
 (hy0: $ y != 0 $) (hyR: $ y < R $) (hyx: $ y < x $)
 (hbR: $ b < R $) (hbx: $ b < x $) (htR: $ t < R $) (htx: $ t < x $)
 (hb: $ b != y $) (ht: $ t != y $) (hr: $ r != y $)
 (ha: $ a != y $) (hc: $ c != y $) (he: $ sqEnvAvoid E n y $):
 $ k218QProvable (kImp (kImp (kImp (kImp (kEq r r) kF) (kImp (kAll y (kImp (kImp (kImp (kMem y c) (kImp (kAll x (kImp (kMem x r) (kMem x y))) kF)) kF) kF)) kF)) (kImp (kImp (kAll y (kImp (kImp (kImp (kImp (kImp (kEq r r) (kImp (kEq y b) kF)) kF) kF) (kImp (kImp (kImp (kImp (kEq r t) (kImp (kEq y t) kF)) kF) kF) (kImp (kAll x (kImp (kImp (kImp (sfK0QSepNamedSingleton x r R) (kImp (kImp (kImp (kImp (kImp (kMem t x) (kImp (kMem x a) kF)) kF) (kImp (kImp (kImp (kMem t y) (kImp (sfK0CollectionRel E R y x psi) kF)) kF) kF)) kF) kF)) kF) kF)) kF))) kF)) kF) (kImp (kAll y (kImp (kImp (kImp (kMem y c) (kImp (kImp (kImp (kImp (kImp (kEq r r) (kImp (kEq y b) kF)) kF) kF) (kImp (kImp (kImp (kImp (kEq r t) (kImp (kEq y t) kF)) kF) kF) (kImp (kAll x (kImp (kImp (kImp (sfK0QSepNamedSingleton x r R) (kImp (kImp (kImp (kImp (kImp (kMem t x) (kImp (kMem x a) kF)) kF) (kImp (kImp (kImp (kMem t y) (kImp (sfK0CollectionRel E R y x psi) kF)) kF) kF)) kF) kF)) kF) kF)) kF))) kF)) kF) kF)) kF))) (kImp (kImp (kEq r t) kF) (kImp (kAll x (kImp (sfK0QSepNamedSingleton x r R) kF)) (kMem b c)))) $;

