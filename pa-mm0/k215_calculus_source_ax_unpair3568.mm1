theorem k215UnpairAt3568AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt3568State k215PNum3568 0 b (suc n) c) (k215UnpairAt3568State k215PNum3568 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
