pub theorem k215UnpairMacro3568 (n a b c: nat): $ k215PReach (k215UnpairAt3568State k215PNum3568 a b n c) (k215UnpairAt3568State k215PNum3576 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
