theorem k215UnpairAt3568Reach16 (a b n c: nat): $ k215PReach (k215UnpairAt3568State k215PNum3575 a b n c) (k215UnpairAt3568State k215PNum3568 a b n c) $ = '(k215PReach_step k215UnpairAt3568Step16);

theorem k215UnpairAt3568CycleZero (b n c: nat): $ k215PReach (k215UnpairAt3568State k215PNum3568 0 b (suc n) c) (k215UnpairAt3568State k215PNum3568 (suc b) 0 n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt3568Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt3568Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt3568Reach11Z) (ax_mp (ax_mp k215PReach_trans k215UnpairAt3568ReachTransfer) k215UnpairAt3568Reach16))));
