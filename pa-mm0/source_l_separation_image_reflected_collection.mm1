import "source_l_replacement_common_reflected.mm1";
import "source_l_separation_image_collector_kernel.mm1";

pub theorem slSepReflected_inner(G start params count phi a X:nat)(hb:$ sfBound count phi $)
 (hS:$ nsLocal G (sfReflectionHierarchySubsetNormal sfCLHierarchy) $)
 (hp:$ nsLocal G (sfCLPoint start params a X) $):
 $ nsLocal (lrrAboveSecond G count phi a) (sfCLReflectedPoint (suc (suc start)) params count phi 1 0) $ =
 '(sfLReplacementReflectedPoint_from_above (lrrAbove_shifted_subset hS) (lrrAbove_shifted_members hp)
  (ax_mp nsLocal_CE1 (lrrAbove_shifted_point hb))
  (ax_mp nsLocal_CE1 (ax_mp nsLocal_CE2 (lrrAbove_shifted_point hb)))
  (ax_mp (ax_mp nsLocal_hyp lrrAbove_second_wf) sfContext_member_head)
  (ax_mp nsLocal_CE2 (ax_mp nsLocal_CE2 (lrrAbove_shifted_point hb))));

pub theorem sfLSeparationReflect_collected(G start params count phi a X:nat)(hb:$ sfBound count phi $)
 (hA:$ nsLocal G (sfLReplacementAboveLaw count phi) $)
 (hL:$ nsLocal G sfLReplacementLevelExistsLaw $)
 (hS:$ nsLocal G (sfReflectionHierarchySubsetNormal sfCLHierarchy) $)
 (hp:$ nsLocal G (sfCLPoint start params a X) $):
 $ nsLocal G (sfCLReflectedRecipe start params count phi) $ =
 '(sfLReplacementEx_mono (ax_mp sfWf_ex sfCLReflectedPoint_wf)
   (sfLReplacementAbove_use hb hA (ax_mp nsLocal_CE1 (ax_mp sfCLPoint_pair hp)))
   (sfLReplacementEx_mono sfCLReflectedPoint_wf (lrrAbove_newlevel hL) (slSepReflected_inner hb hS hp)));

pub theorem slSepAboveLaw_bound(count phi:nat)(hb:$ sfBound count phi $):
 $ sfBound 0 (sfLReplacementAboveLaw count phi) $ =
 '(mpbir sfBound_sfAll (mpbir sfBound_sfImp (ian (sfCLOrdinalAt_bound d0lt1)
   (mpbir sfBound_sfEx (mpbir sfBound_sfAnd (ian (sfCLOrdinalAt_bound d0lt2)
    (mpbir sfBound_sfAnd (ian (mpbir sfBound_sfMem (ian d1lt2 d0lt2))
      (sfCLReflection_bound sfLDomain_bound hb d0lt2)))))))));

pub theorem slSepWitnessClosed(G point a:nat)(hp:$ sfWf point $)(hb:$ sfBound 0 a $)(ha:$ nsLocal G a $):
 $ nsLocal (sfCLWitnessContext G point) a $ =
 '(sfRQ_rewrite (eqtr (sfShifteq2 (ax_mp sfShift_closed_identity hb)) (ax_mp sfShift_closed_identity hb)) (slSepWitnessLift hp ha));

theorem slSepWitnessPoint(G start params:nat):
 $ nsLocal (sfCLWitnessContext G (sfCLPoint (suc (suc start)) params 1 0)) (sfCLPoint (suc (suc start)) params 1 0) $ =
 '(ax_mp (ax_mp nsLocal_hyp (mpbir sfContextWf_cons (ian sfCLPoint_wf sfContextShift_wf))) sfContext_member_head);

theorem slSepWitnessSubset(G start params:nat)(hS:$ nsLocal G (sfReflectionHierarchySubsetNormal sfCLHierarchy) $):
 $ nsLocal (sfCLWitnessContext G (sfCLPoint (suc (suc start)) params 1 0)) (sfReflectionHierarchySubsetNormal sfCLHierarchy) $ =
 '(sfRQ_rewrite (eqtr (sfShifteq2 (rfmc_subnormal_shift sfCLHierarchy_bound)) (rfmc_subnormal_shift sfCLHierarchy_bound)) (slSepWitnessLift sfCLPoint_wf hS));

pub theorem sfLSeparationReflectedRecipe_from_collected(G start params count phi:nat)(hb:$ sfBound count phi $)
 (hA:$ nsLocal G (sfLReplacementAboveLaw count phi) $)
 (hL:$ nsLocal G sfLReplacementLevelExistsLaw $)
 (hS:$ nsLocal G (sfReflectionHierarchySubsetNormal sfCLHierarchy) $)
 (hc:$ nsLocal G (sfCLRecipe start params) $):
 $ nsLocal G (sfCLReflectedRecipe start params count phi) $ =
 '(ax_mp (sfCLRecipe_eliminate (ax_mp nsLocal_context_wf hc) sfCLReflectedRecipe_wf hc)
   (mpbir (nsLocal_formula_eq (eqtr (sfShifteq2 (sfCLReflectedRecipe_shift hb)) (sfCLReflectedRecipe_shift hb)))
    (sfLSeparationReflect_collected hb (slSepWitnessClosed sfCLPoint_wf (slSepAboveLaw_bound hb) hA)
     (slSepWitnessClosed sfCLPoint_wf sfLReplacementLevelExists_bound hL)
     (slSepWitnessSubset hS) slSepWitnessPoint)));
