@_ def k215UnpairAt1305State (pc a b n c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) n (k215PR3 c) (k215PR4 c) (k215PR5 c) a b (k215PR8 c)) $;

do (apply (register-eqd 'k215UnpairAt1305State) '(k215UnpairAt1305Stateeqd));

theorem k215UnpairAt1305Transfer (b n c: nat): $ k215PIter (3 * b + 1) (k215UnpairAt1305State k215PNum1309 0 b n c) = (k215UnpairAt1305State k215PNum1312 b 0 n c) $ =
 '(eqtr k215Loop1309Vector (k215PStateeq2 (k215PVectoreq7 add0)));
theorem k215UnpairAt1305ReachTransfer (b n c: nat): $ k215PReach (k215UnpairAt1305State k215PNum1309 0 b n c) (k215UnpairAt1305State k215PNum1312 b 0 n c) $ =
 '(k215PReach_intro k215UnpairAt1305Transfer);


theorem k215UnpairAt1305Step9Z (a b c: nat): $ k215PStep (k215UnpairAt1305State k215PNum1305 a b 0 c) = (k215UnpairAt1305State k215PNum1313 a b 0 c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair1305_1305) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt1305Reach9Z (a b c: nat): $ k215PReach (k215UnpairAt1305State k215PNum1305 a b 0 c) (k215UnpairAt1305State k215PNum1313 a b 0 c) $ = '(k215PReach_step k215UnpairAt1305Step9Z);

theorem k215UnpairAt1305Step9S (a b n c: nat): $ k215PStep (k215UnpairAt1305State k215PNum1305 a b (suc n) c) = (k215UnpairAt1305State k215PNum1306 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair1305_1305) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet2_vector)) (eqtr k215PSet2_vector (k215PVectoreq3 (eqtr subSS sub02))))));

theorem k215UnpairAt1305Reach9S (a b n c: nat): $ k215PReach (k215UnpairAt1305State k215PNum1305 a b (suc n) c) (k215UnpairAt1305State k215PNum1306 a b n c) $ = '(k215PReach_step k215UnpairAt1305Step9S);

theorem k215UnpairAt1305Step10 (a b n c: nat): $ k215PStep (k215UnpairAt1305State k215PNum1306 a b n c) = (k215UnpairAt1305State k215PNum1307 a (suc b) n c) $ = '(eqtr (k215PAtCI k215PLookupUnpair1305_1306) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215UnpairAt1305Reach10 (a b n c: nat): $ k215PReach (k215UnpairAt1305State k215PNum1306 a b n c) (k215UnpairAt1305State k215PNum1307 a (suc b) n c) $ = '(k215PReach_step k215UnpairAt1305Step10);

theorem k215UnpairAt1305Step11Z (b n c: nat): $ k215PStep (k215UnpairAt1305State k215PNum1307 0 b n c) = (k215UnpairAt1305State k215PNum1309 0 b n c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair1305_1307) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt1305Reach11Z (b n c: nat): $ k215PReach (k215UnpairAt1305State k215PNum1307 0 b n c) (k215UnpairAt1305State k215PNum1309 0 b n c) $ = '(k215PReach_step k215UnpairAt1305Step11Z);

theorem k215UnpairAt1305Step11S (a b n c: nat): $ k215PStep (k215UnpairAt1305State k215PNum1307 (suc a) b n c) = (k215UnpairAt1305State k215PNum1308 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair1305_1307) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215UnpairAt1305Reach11S (a b n c: nat): $ k215PReach (k215UnpairAt1305State k215PNum1307 (suc a) b n c) (k215UnpairAt1305State k215PNum1308 a b n c) $ = '(k215PReach_step k215UnpairAt1305Step11S);

theorem k215UnpairAt1305Step12 (a b n c: nat): $ k215PStep (k215UnpairAt1305State k215PNum1308 a b n c) = (k215UnpairAt1305State k215PNum1312 a b n c) $ = '(k215PAtCB k215PLookupUnpair1305_1308);

theorem k215UnpairAt1305Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt1305State k215PNum1308 a b n c) (k215UnpairAt1305State k215PNum1312 a b n c) $ = '(k215PReach_step k215UnpairAt1305Step12);

theorem k215UnpairAt1305Step16 (a b n c: nat): $ k215PStep (k215UnpairAt1305State k215PNum1312 a b n c) = (k215UnpairAt1305State k215PNum1305 a b n c) $ = '(k215PAtCC k215PLookupUnpair1305_1312);

theorem k215UnpairAt1305Reach16 (a b n c: nat): $ k215PReach (k215UnpairAt1305State k215PNum1312 a b n c) (k215UnpairAt1305State k215PNum1305 a b n c) $ = '(k215PReach_step k215UnpairAt1305Step16);

theorem k215UnpairAt1305CycleZero (b n c: nat): $ k215PReach (k215UnpairAt1305State k215PNum1305 0 b (suc n) c) (k215UnpairAt1305State k215PNum1305 (suc b) 0 n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt1305Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt1305Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt1305Reach11Z) (ax_mp (ax_mp k215PReach_trans k215UnpairAt1305ReachTransfer) k215UnpairAt1305Reach16))));
theorem k215UnpairAt1305CycleSucc (a b n c: nat): $ k215PReach (k215UnpairAt1305State k215PNum1305 (suc a) b (suc n) c) (k215UnpairAt1305State k215PNum1305 a (suc b) n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt1305Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt1305Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt1305Reach11S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt1305Reach12) k215UnpairAt1305Reach16))));


theorem k215UnpairAt1305AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt1305State k215PNum1305 0 b (suc n) c) (k215UnpairAt1305State k215PNum1305 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt1305Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215PairDiagonal_rotate)) (eqtr (eqcom sndpr) (sndeq k215PairDiagonal_rotate)) eqid eqid)) k215UnpairAt1305CycleZero);

theorem k215UnpairAt1305AdvanceSucc (a b n c: nat): $ k215PReach (k215UnpairAt1305State k215PNum1305 (suc a) b (suc n) c) (k215UnpairAt1305State k215PNum1305 (fst (suc ((suc a), b))) (snd (suc ((suc a), b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt1305Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215Pair_next)) (eqtr (eqcom sndpr) (sndeq k215Pair_next)) eqid eqid)) k215UnpairAt1305CycleSucc);

pub theorem k215UnpairAt1305Advance (a b n c: nat): $ k215PReach (k215UnpairAt1305State k215PNum1305 a b (suc n) c) (k215UnpairAt1305State k215PNum1305 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
 (named @ induct '(ind) 'a 'k215UnpairAt1305AdvanceZero '(a1i k215UnpairAt1305AdvanceSucc));
@_ abstract def k215UnpairAt1305Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt1305State k215PNum1305 a b n c) (k215UnpairAt1305State k215PNum1313 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
theorem k215UnpairAt1305RunZero (a b c: nat): $ k215UnpairAt1305Run 0 a b c $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt1305Stateeq eqid
     (eqcom (eqtr (fsteq add0) fstpr))
     (eqcom (eqtr (sndeq add0) sndpr)) eqid eqid)) k215UnpairAt1305Reach9Z);
@_ abstract def k215UnpairAt1305Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt1305Run n a b c $;
theorem k215UnpairAt1305Claim_at (n a b c: nat): $ k215UnpairAt1305Claim n c -> k215UnpairAt1305Run n a b c $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215UnpairAt1305CodeStep (a b n: nat): $ (fst (suc (a, b)), snd (suc (a, b))) + n = (a, b) + suc n $ =
 '(eqtr (addeq1 fstsnd) addSass);
theorem k215UnpairAt1305RunInductive (n a b c: nat): $ k215UnpairAt1305Claim n c -> k215UnpairAt1305Run (suc n) a b c $ =
 '(syl (ax_mp k215PReach_trans k215UnpairAt1305Advance)
   (mpbid (a1i (k215PReacheq2 (k215UnpairAt1305Stateeq eqid
     (fsteq k215UnpairAt1305CodeStep) (sndeq k215UnpairAt1305CodeStep) eqid eqid))) k215UnpairAt1305Claim_at));
theorem k215UnpairAt1305Claim_all (n c: nat): $ k215UnpairAt1305Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt1305RunZero)) '(iald @ iald k215UnpairAt1305RunInductive));
pub theorem k215UnpairMacro1305 (n a b c: nat): $ k215PReach (k215UnpairAt1305State k215PNum1305 a b n c) (k215UnpairAt1305State k215PNum1313 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
 '(ax_mp k215UnpairAt1305Claim_at k215UnpairAt1305Claim_all);
pub theorem k215UnpairMacro1305_clean (n c: nat): $ k215PReach (k215UnpairAt1305State k215PNum1305 0 0 n c) (k215UnpairAt1305State k215PNum1313 (fst n) (snd n) 0 c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt1305Stateeq eqid
   (fsteq (eqtr (addeq1 pr0) add01))
   (sndeq (eqtr (addeq1 pr0) add01)) eqid eqid)) k215UnpairMacro1305);


