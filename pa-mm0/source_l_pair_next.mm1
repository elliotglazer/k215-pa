import "source_l_pair_next_slim1_replay.mm1";
import "source_l_pair_shell.mm1";

pub theorem sfLPairNext_context: $ slPNContext = sfLBackground $ = 'eqid;
pub theorem sfLPairNext_formula: $ slPNFormula = sfLPairNextLevel $ = 'eqid;
pub theorem sfLPairNext_local: $ nsLocal sfLBackground sfLPairNextLevel $ = '(mpbi (nsLocal_context_eq sfLPairNext_context) (mpbi (nsLocal_formula_eq sfLPairNext_formula) slPNCertificate));
pub theorem sfLPairNextLevel_zfr: $ sfTheoryProvable zfrAxioms sfLPairNextLevel $ = '(ax_mp (sfTheory_local sfLBackground_zfr) sfLPairNext_local);
pub theorem sfLPair_from_common2: $ sfTheoryProvable zfrAxioms sfLPairCommon2 -> sfTheoryProvable zfrAxioms (sfRelativize sfLDomain zfcPair) $ = '(ax_mp sfLPair_from_levels sfLPairNextLevel_zfr);
