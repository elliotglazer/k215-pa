import "source_k0_qsep_raw_base_use.mm0";

import "k218q_alpha.mm0";

theorem sfK0QSepSingleton_exists_at (k x p K: nat) (hk: $ 0 < k $) (hx: $ x < k $)
 (hp0: $ p != 0 $) (hpx: $ p != x $)
 (hpc: $ p != suc k $) (hpl: $ p != suc (suc k) $)
 (hKL: $ K != suc (suc k) $) (hKp: $ K != p $) (hKx: $ K != x $):
 $ k218QProvable (kExists p (sfK0QSepNamedSingleton x p (suc (suc k)))) $;

theorem sfK0QSepSingleton_profile_rebase (k x p K: nat) (hk: $ 0 < k $) (hx: $ x < k $)
 (hp0: $ p != 0 $) (hpx: $ p != x $)
 (hpc: $ p != suc k $) (hpl: $ p != suc (suc k) $)
 (hKL: $ K != suc (suc k) $) (hKp: $ K != p $) (hKx: $ K != x $):
 $ k218QProvable (kImp (kAll (suc (suc k)) (kImp (kMem (suc (suc k)) p) (kEq (suc (suc k)) x))) (kAll K (kImp (kMem K p) (kEq K x)))) $;

theorem sfK0QSepSingleton_body_rebase (k x p K: nat) (hk: $ 0 < k $) (hx: $ x < k $)
 (hp0: $ p != 0 $) (hpx: $ p != x $)
 (hpc: $ p != suc k $) (hpl: $ p != suc (suc k) $)
 (hKL: $ K != suc (suc k) $) (hKp: $ K != p $) (hKx: $ K != x $):
 $ k218QProvable (kImp (sfK0QSepNamedSingleton x p (suc (suc k))) (sfK0QSepNamedSingleton x p K)) $;

theorem sfK0QSepSingleton_exists (k x p K: nat) (hk: $ 0 < k $) (hx: $ x < k $)
 (hp0: $ p != 0 $) (hpx: $ p != x $)
 (hpc: $ p != suc k $) (hpl: $ p != suc (suc k) $)
 (hKL: $ K != suc (suc k) $) (hKp: $ K != p $) (hKx: $ K != x $):
 $ k218QProvable (kExists p (sfK0QSepNamedSingleton x p K)) $;
