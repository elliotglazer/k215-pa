import "source_piece_pcf_rep_lookup_r15.mm0";

def sfPieceRepLookup(e x v:nat):nat = $ sfAll (sfPieceRepIff (sfPieceRepApplication (suc e) (suc x) 0) (sfEq 0 (suc v))) $;

theorem sfPieceRepLookup_wf(e x v:nat):
 $ sfWf (sfPieceRepLookup e x v) $;

theorem sfPieceEnv_lookup_all_from_laws(T:set)(G n i e x:nat)(hq:$ sfContextSub sfFormulaEqualityContext G $)(hl:$ nsLocal G sfPieceRepLookupLaws $)(hi:$ i < n $)(he:$ nsLocal G (sfPieceEnv T n e) $)(hx:$ nsLocal G (sfPieceNumeral (n - 1 - i) x) $):
 $ nsLocal G (sfPieceRepLookup e x (T @ i)) $;
