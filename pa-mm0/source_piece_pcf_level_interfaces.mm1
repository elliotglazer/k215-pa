
import "source_piece_pcf_above_kernel.mm1";
import "source_l_universal_hierarchy_syntax.mm1";
import "source_l_power_hierarchy_syntax.mm1";

pub theorem sfPieceLevelExists_hierarchy_eq:
 $ sfPieceLevelExistsSource = sfLUniversalHierarchyExists $ = 'eqid;
pub theorem sfPieceLevelSubset_hierarchy_eq:
 $ sfPieceLevelSubsetSource = sfLPowerHierarchySubset $ = 'eqid;

pub theorem sfPieceLevelExists_from_hierarchy
 (he:$ sfTheoryProvable zfrAxioms sfLUniversalHierarchyExists $):
 $ sfTheoryProvable zfrAxioms sfPieceLevelExistsSource $ =
'(mpbir (trud (sfTheoryProvable_congr (a1i sfPieceLevelExists_hierarchy_eq))) he);
pub theorem sfPieceLevelSubset_from_hierarchy
 (hs:$ sfTheoryProvable zfrAxioms sfLPowerHierarchySubset $):
 $ sfTheoryProvable zfrAxioms sfPieceLevelSubsetSource $ =
'(mpbir (trud (sfTheoryProvable_congr (a1i sfPieceLevelSubset_hierarchy_eq))) hs);
pub theorem sfPieceAbove_from_hierarchy
 (he:$ sfTheoryProvable zfrAxioms sfLUniversalHierarchyExists $)
 (hs:$ sfTheoryProvable zfrAxioms sfLPowerHierarchySubset $):
 $ sfTheoryProvable zfrAxioms sfPieceLevelAboveSource $ =
'(sfPieceAbove_from_exists_subset (sfPieceLevelExists_from_hierarchy he) (sfPieceLevelSubset_from_hierarchy hs));
