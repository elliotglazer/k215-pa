pub theorem k215Loop204Vector (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ k215PIter (3 * a7 + 1) (k215PState k215Num204 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) =
   k215PState k215Num207 (k215PVector a0 a1 a2 a3 a4 a5 (a7 + a6) 0 a8) $ =
 '(eqtr (k215PItereq2 (eqcom k215Loop204VectorIn)) (eqtr k215Loop204Transfer k215Loop204VectorOut));

@_ def k215Loop208State (pc x y z c: nat): nat = $ k215PState pc (k215PVector z (k215PR1 c) (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) (k215PR6 c) x y) $;

do (apply (register-eqd 'k215Loop208State) '(k215Loop208Stateeqd));

theorem k215Loop208StepZ (y z c: nat): $ k215PStep (k215Loop208State k215Num208 0 y z c) = (k215Loop208State k215Num211 0 y z c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupExtraLoopsaxreads_208) (ifeq (eqeq1 k215PGet7_vector) eqid eqid)) (ifpos eqid));

theorem k215Loop208StepS (x y z c: nat): $ k215PStep (k215Loop208State k215Num208 (suc x) y z c) = (k215Loop208State k215Num209 x y z c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupExtraLoopsaxreads_208) (ifeq (eqeq1 k215PGet7_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet7_vector)) (eqtr k215PSet7_vector (k215PVectoreq8 (eqtr subSS sub02))))));

theorem k215Loop208Step1 (x y z c: nat): $ k215PStep (k215Loop208State k215Num209 x y z c) = (k215Loop208State k215Num210 x (suc y) z c) $ = '(eqtr (k215PAtCI k215PLookupExtraLoopsaxreads_209) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet8_vector)) k215PSet8_vector)));

theorem k215Loop208Back (x y z c: nat): $ k215PStep (k215Loop208State k215Num210 x y z c) = (k215Loop208State k215Num208 x y z c) $ = '(k215PAtCC k215PLookupExtraLoopsaxreads_210);

theorem k215Loop208Cycle1 (x y z c: nat): $ k215PIter 1 (k215Loop208State k215Num208 (suc x) y z c) = (k215Loop208State k215Num209 x y z c) $ = '(eqtr k215PIter_succ (eqtr (k215PStepeq k215PIter_zero) k215Loop208StepS));

theorem k215Loop208Cycle2 (x y z c: nat): $ k215PIter 2 (k215Loop208State k215Num208 (suc x) y z c) = (k215Loop208State k215Num210 x (suc y) z c) $ = '(eqtr k215PIter_succ (eqtr (k215PStepeq k215Loop208Cycle1) k215Loop208Step1));

theorem k215Loop208Cycle3 (x y z c: nat): $ k215PIter 3 (k215Loop208State k215Num208 (suc x) y z c) = (k215Loop208State k215Num208 x (suc y) z c) $ = '(eqtr k215PIter_succ (eqtr (k215PStepeq k215Loop208Cycle2) k215Loop208Back));

@_ abstract def k215Loop208Claim (x c: nat) (.y .z: nat): wff =
 $ A. y A. z k215PIter (3 * x + 1) (k215Loop208State k215Num208 x y z c) = (k215Loop208State k215Num211 0 (x + y) z c) $;
theorem k215Loop208At (x y z c: nat): $ k215Loop208Claim x c -> k215PIter (3 * x + 1) (k215Loop208State k215Num208 x y z c) = (k215Loop208State k215Num211 0 (x + y) z c) $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215Loop208Base (y z c: nat): $ k215PIter (3 * 0 + 1) (k215Loop208State k215Num208 0 y z c) = (k215Loop208State k215Num211 0 (0 + y) z c) $ =
 '(eqtr (k215PItereq1 (eqtr (addeq1 mul0) add01))
   (eqtr k215PIter_succ (eqtr (k215PStepeq k215PIter_zero)
     (eqtr k215Loop208StepZ (k215Loop208Stateeq eqid eqid (eqcom add01) eqid eqid)))));
theorem k215Loop208Inductive (x y z c: nat): $ k215Loop208Claim x c -> k215PIter (3 * suc x + 1) (k215Loop208State k215Num208 (suc x) y z c) = (k215Loop208State k215Num211 0 (suc x + y) z c) $ =
 '(eqtrd (a1i (eqtr (k215PItereq1 k215EqTime_succ)
     (eqtr k215PIter_add (k215PItereq2 k215Loop208Cycle3))))
   (eqtrd k215Loop208At (a1i (k215Loop208Stateeq eqid eqid (eqtr addS (eqcom addS1)) eqid eqid))));
theorem k215Loop208All (x c: nat): $ k215Loop208Claim x c $ =
 (named @ induct '(ind) 'x '(ax_gen (ax_gen k215Loop208Base)) '(iald @ iald k215Loop208Inductive));
pub theorem k215Loop208Transfer (x y z c: nat): $ k215PIter (3 * x + 1) (k215Loop208State k215Num208 x y z c) = (k215Loop208State k215Num211 0 (x + y) z c) $ =
 '(ax_mp k215Loop208At k215Loop208All);


