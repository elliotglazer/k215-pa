import "k215_calculus_source_decode_loops.mm1";
import "k215_calculus_source_ax_reads_lookups.mm1";

theorem k215AXReadLoopFourAdd (y: nat): $ 4 + y = suc (suc (suc (suc y))) $ = '(eqtr addS1 (suceq (eqtr addS1 (suceq (eqtr addS1 (suceq (eqtr addS1 (suceq add01))))))));

theorem k215AXReadLoopFourShift (x y: nat): $ 4 * x + suc (suc (suc (suc y))) = 4 * suc x + y $ =
 '(eqtr (addeq2 (eqcom k215AXReadLoopFourAdd))
   (eqtr (eqcom addass) (addeq1 (eqcom mulS))));


@_ def k215Loop163State (pc x y z c: nat): nat = $ k215PState pc (k215PVector z (k215PR1 c) (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) y x (k215PR8 c)) $;

do (apply (register-eqd 'k215Loop163State) '(k215Loop163Stateeqd));

theorem k215Loop163StepZ (y z c: nat): $ k215PStep (k215Loop163State k215Num163 0 y z c) = (k215Loop163State k215Num166 0 y z c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupExtraLoopsaxreads_163) (ifeq (eqeq1 k215PGet7_vector) eqid eqid)) (ifpos eqid));

theorem k215Loop163StepS (x y z c: nat): $ k215PStep (k215Loop163State k215Num163 (suc x) y z c) = (k215Loop163State k215Num164 x y z c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupExtraLoopsaxreads_163) (ifeq (eqeq1 k215PGet7_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet7_vector)) (eqtr k215PSet7_vector (k215PVectoreq8 (eqtr subSS sub02))))));

theorem k215Loop163Step1 (x y z c: nat): $ k215PStep (k215Loop163State k215Num164 x y z c) = (k215Loop163State k215Num165 x (suc y) z c) $ = '(eqtr (k215PAtCI k215PLookupExtraLoopsaxreads_164) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet6_vector)) k215PSet6_vector)));

theorem k215Loop163Back (x y z c: nat): $ k215PStep (k215Loop163State k215Num165 x y z c) = (k215Loop163State k215Num163 x y z c) $ = '(k215PAtCC k215PLookupExtraLoopsaxreads_165);

theorem k215Loop163Cycle1 (x y z c: nat): $ k215PIter 1 (k215Loop163State k215Num163 (suc x) y z c) = (k215Loop163State k215Num164 x y z c) $ = '(eqtr k215PIter_succ (eqtr (k215PStepeq k215PIter_zero) k215Loop163StepS));

theorem k215Loop163Cycle2 (x y z c: nat): $ k215PIter 2 (k215Loop163State k215Num163 (suc x) y z c) = (k215Loop163State k215Num165 x (suc y) z c) $ = '(eqtr k215PIter_succ (eqtr (k215PStepeq k215Loop163Cycle1) k215Loop163Step1));

theorem k215Loop163Cycle3 (x y z c: nat): $ k215PIter 3 (k215Loop163State k215Num163 (suc x) y z c) = (k215Loop163State k215Num163 x (suc y) z c) $ = '(eqtr k215PIter_succ (eqtr (k215PStepeq k215Loop163Cycle2) k215Loop163Back));

@_ abstract def k215Loop163Claim (x c: nat) (.y .z: nat): wff =
 $ A. y A. z k215PIter (3 * x + 1) (k215Loop163State k215Num163 x y z c) = (k215Loop163State k215Num166 0 (x + y) z c) $;
theorem k215Loop163At (x y z c: nat): $ k215Loop163Claim x c -> k215PIter (3 * x + 1) (k215Loop163State k215Num163 x y z c) = (k215Loop163State k215Num166 0 (x + y) z c) $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215Loop163Base (y z c: nat): $ k215PIter (3 * 0 + 1) (k215Loop163State k215Num163 0 y z c) = (k215Loop163State k215Num166 0 (0 + y) z c) $ =
 '(eqtr (k215PItereq1 (eqtr (addeq1 mul0) add01))
   (eqtr k215PIter_succ (eqtr (k215PStepeq k215PIter_zero)
     (eqtr k215Loop163StepZ (k215Loop163Stateeq eqid eqid (eqcom add01) eqid eqid)))));
theorem k215Loop163Inductive (x y z c: nat): $ k215Loop163Claim x c -> k215PIter (3 * suc x + 1) (k215Loop163State k215Num163 (suc x) y z c) = (k215Loop163State k215Num166 0 (suc x + y) z c) $ =
 '(eqtrd (a1i (eqtr (k215PItereq1 k215EqTime_succ)
     (eqtr k215PIter_add (k215PItereq2 k215Loop163Cycle3))))
   (eqtrd k215Loop163At (a1i (k215Loop163Stateeq eqid eqid (eqtr addS (eqcom addS1)) eqid eqid))));
theorem k215Loop163All (x c: nat): $ k215Loop163Claim x c $ =
 (named @ induct '(ind) 'x '(ax_gen (ax_gen k215Loop163Base)) '(iald @ iald k215Loop163Inductive));
pub theorem k215Loop163Transfer (x y z c: nat): $ k215PIter (3 * x + 1) (k215Loop163State k215Num163 x y z c) = (k215Loop163State k215Num166 0 (x + y) z c) $ =
 '(ax_mp k215Loop163At k215Loop163All);


theorem k215Loop163VectorIn (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215Loop163State k215Num163 a7 a6 a0 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = k215PState k215Num163 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8) $ = '(k215PStateeq2 (k215PVectoreq eqid k215PR1_vector k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215Loop163VectorOut (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215Loop163State k215Num166 0 (a7 + a6) a0 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = k215PState k215Num166 (k215PVector a0 a1 a2 a3 a4 a5 (a7 + a6) 0 a8) $ = '(k215PStateeq2 (k215PVectoreq eqid k215PR1_vector k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

pub theorem k215Loop163Vector (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ k215PIter (3 * a7 + 1) (k215PState k215Num163 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) =
   k215PState k215Num166 (k215PVector a0 a1 a2 a3 a4 a5 (a7 + a6) 0 a8) $ =
 '(eqtr (k215PItereq2 (eqcom k215Loop163VectorIn)) (eqtr k215Loop163Transfer k215Loop163VectorOut));

