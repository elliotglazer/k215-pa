theorem k215UnpairAt4220Step11S (a b n c: nat): $ k215PStep (k215UnpairAt4220State k215PNum4222 (suc a) b n c) = (k215UnpairAt4220State k215PNum4223 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair4220_4222) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215UnpairAt4220Reach11S (a b n c: nat): $ k215PReach (k215UnpairAt4220State k215PNum4222 (suc a) b n c) (k215UnpairAt4220State k215PNum4223 a b n c) $ = '(k215PReach_step k215UnpairAt4220Step11S);

theorem k215UnpairAt4220Step12 (a b n c: nat): $ k215PStep (k215UnpairAt4220State k215PNum4223 a b n c) = (k215UnpairAt4220State k215PNum4227 a b n c) $ = '(k215PAtCB k215PLookupUnpair4220_4223);

theorem k215UnpairAt4220Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt4220State k215PNum4223 a b n c) (k215UnpairAt4220State k215PNum4227 a b n c) $ = '(k215PReach_step k215UnpairAt4220Step12);

theorem k215UnpairAt4220Step16 (a b n c: nat): $ k215PStep (k215UnpairAt4220State k215PNum4227 a b n c) = (k215UnpairAt4220State k215PNum4220 a b n c) $ = '(k215PAtCC k215PLookupUnpair4220_4227);

theorem k215UnpairAt4220Reach16 (a b n c: nat): $ k215PReach (k215UnpairAt4220State k215PNum4227 a b n c) (k215UnpairAt4220State k215PNum4220 a b n c) $ = '(k215PReach_step k215UnpairAt4220Step16);

theorem k215UnpairAt4220CycleZero (b n c: nat): $ k215PReach (k215UnpairAt4220State k215PNum4220 0 b (suc n) c) (k215UnpairAt4220State k215PNum4220 (suc b) 0 n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt4220Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt4220Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt4220Reach11Z) (ax_mp (ax_mp k215PReach_trans k215UnpairAt4220ReachTransfer) k215UnpairAt4220Reach16))));
theorem k215UnpairAt4220CycleSucc (a b n c: nat): $ k215PReach (k215UnpairAt4220State k215PNum4220 (suc a) b (suc n) c) (k215UnpairAt4220State k215PNum4220 a (suc b) n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt4220Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt4220Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt4220Reach11S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt4220Reach12) k215UnpairAt4220Reach16))));


theorem k215UnpairAt4220AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt4220State k215PNum4220 0 b (suc n) c) (k215UnpairAt4220State k215PNum4220 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt4220Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215PairDiagonal_rotate)) (eqtr (eqcom sndpr) (sndeq k215PairDiagonal_rotate)) eqid eqid)) k215UnpairAt4220CycleZero);

theorem k215UnpairAt4220AdvanceSucc (a b n c: nat): $ k215PReach (k215UnpairAt4220State k215PNum4220 (suc a) b (suc n) c) (k215UnpairAt4220State k215PNum4220 (fst (suc ((suc a), b))) (snd (suc ((suc a), b))) n c) $ =
