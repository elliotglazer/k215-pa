theorem k215UnpairAt4220Reach9S (a b n c: nat): $ k215PReach (k215UnpairAt4220State k215PNum4220 a b (suc n) c) (k215UnpairAt4220State k215PNum4221 a b n c) $ = '(k215PReach_step k215UnpairAt4220Step9S);

theorem k215UnpairAt4220Step10 (a b n c: nat): $ k215PStep (k215UnpairAt4220State k215PNum4221 a b n c) = (k215UnpairAt4220State k215PNum4222 a (suc b) n c) $ = '(eqtr (k215PAtCI k215PLookupUnpair4220_4221) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215UnpairAt4220Reach10 (a b n c: nat): $ k215PReach (k215UnpairAt4220State k215PNum4221 a b n c) (k215UnpairAt4220State k215PNum4222 a (suc b) n c) $ = '(k215PReach_step k215UnpairAt4220Step10);

theorem k215UnpairAt4220Step11Z (b n c: nat): $ k215PStep (k215UnpairAt4220State k215PNum4222 0 b n c) = (k215UnpairAt4220State k215PNum4224 0 b n c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair4220_4222) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

