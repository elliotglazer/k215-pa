pub theorem k215UnpairAt4220Advance (a b n c: nat): $ k215PReach (k215UnpairAt4220State k215PNum4220 a b (suc n) c) (k215UnpairAt4220State k215PNum4220 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
 (named @ induct '(ind) 'a 'k215UnpairAt4220AdvanceZero '(a1i k215UnpairAt4220AdvanceSucc));
@_ abstract def k215UnpairAt4220Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt4220State k215PNum4220 a b n c) (k215UnpairAt4220State k215PNum4228 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
theorem k215UnpairAt4220RunZero (a b c: nat): $ k215UnpairAt4220Run 0 a b c $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt4220Stateeq eqid
     (eqcom (eqtr (fsteq add0) fstpr))
     (eqcom (eqtr (sndeq add0) sndpr)) eqid eqid)) k215UnpairAt4220Reach9Z);
@_ abstract def k215UnpairAt4220Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt4220Run n a b c $;
theorem k215UnpairAt4220Claim_at (n a b c: nat): $ k215UnpairAt4220Claim n c -> k215UnpairAt4220Run n a b c $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215UnpairAt4220CodeStep (a b n: nat): $ (fst (suc (a, b)), snd (suc (a, b))) + n = (a, b) + suc n $ =
 '(eqtr (addeq1 fstsnd) addSass);
theorem k215UnpairAt4220RunInductive (n a b c: nat): $ k215UnpairAt4220Claim n c -> k215UnpairAt4220Run (suc n) a b c $ =
 '(syl (ax_mp k215PReach_trans k215UnpairAt4220Advance)
   (mpbid (a1i (k215PReacheq2 (k215UnpairAt4220Stateeq eqid
     (fsteq k215UnpairAt4220CodeStep) (sndeq k215UnpairAt4220CodeStep) eqid eqid))) k215UnpairAt4220Claim_at));
theorem k215UnpairAt4220Claim_all (n c: nat): $ k215UnpairAt4220Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt4220RunZero)) '(iald @ iald k215UnpairAt4220RunInductive));
pub theorem k215UnpairMacro4220 (n a b c: nat): $ k215PReach (k215UnpairAt4220State k215PNum4220 a b n c) (k215UnpairAt4220State k215PNum4228 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
 '(ax_mp k215UnpairAt4220Claim_at k215UnpairAt4220Claim_all);
pub theorem k215UnpairMacro4220_clean (n c: nat): $ k215PReach (k215UnpairAt4220State k215PNum4220 0 0 n c) (k215UnpairAt4220State k215PNum4228 (fst n) (snd n) 0 c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt4220Stateeq eqid
   (fsteq (eqtr (addeq1 pr0) add01))
   (sndeq (eqtr (addeq1 pr0) add01)) eqid eqid)) k215UnpairMacro4220);


