def zfcProofArithmeticBoundedDivides (a b .q: nat): wff = $ E. q (q <= b /\ q * a = b) $;

theorem zfcProofArithmeticBoundedDivides_sound (a b: nat): $ zfcProofArithmeticBoundedDivides a b -> a || b $;

theorem zfcProofArithmeticBoundedDivides_witness (a b: nat): $ a || b -> zfcProofArithmeticBoundedDivides a b $;

theorem zfcProofArithmeticBoundedDivides_correct (a b: nat): $ zfcProofArithmeticBoundedDivides a b <-> a || b $;

def zfcProofArithmeticBoundedFiniteCell (m c k .x: nat): wff = $ 0 < m /\ 0 < c /\ (A. x (x <= k -> 0 < x -> zfcProofArithmeticBoundedDivides x m)) /\ zfcProofArithmeticBoundedDivides (suc (m * suc k)) c $;

theorem zfcProofArithmeticBoundedFiniteCell_correct (m c k: nat): $ zfcProofArithmeticBoundedFiniteCell m c k <-> bb215ArithmeticFormulaFiniteCell m c k $;

def zfcProofArithmeticBoundedHistoryPair (m c i y .p: nat): wff = $ E. p (p < c /\ (bb215ArithmeticFormulaPairGraph i y p /\ zfcProofArithmeticBoundedFiniteCell m c p)) $;

theorem zfcProofArithmeticBoundedHistoryPair_point (m c i y p: nat): $ p < c /\ (bb215ArithmeticFormulaPairGraph i y p /\ zfcProofArithmeticBoundedFiniteCell m c p) <-> bb215ArithmeticFormulaPairGraph i y p /\ bb215ArithmeticFormulaFiniteCell m c p $;

theorem zfcProofArithmeticBoundedHistoryPair_correct (m c i y: nat): $ zfcProofArithmeticBoundedHistoryPair m c i y <-> bb215ArithmeticFormulaHistoryPairGraph m c i y $;

