import "source_l_common_level_two_join.mm0";
import "source_l_common_level_two_shift.mm0";

theorem sfCL2_core (G ja jb: nat) (hg: $ sfContextWf G $)
 (hS: $ nsLocal G sfCL2Sub $) (hC: $ nsLocal G sfCL2Cmp $)
 (ha: $ nsLocal G (sfCL2Ex (suc (suc ja))) $) (hb: $ nsLocal G (sfCL2Ex (suc (suc jb))) $):
 $ nsLocal G (sfCL2BothEx (suc (suc ja)) (suc (suc jb))) $;

theorem sfCL2Law_local: $ nsLocal sfCL2Context sfCL2Law $;

theorem sfCL2Law_imp_zfr: $ sfTheoryProvable zfrAxioms (sfImp sfCL2Sub (sfImp sfCL2Cmp sfCL2Law)) $;

theorem sfCL2Law_zfr (hS: $ sfTheoryProvable zfrAxioms sfCL2Sub $)
 (hC: $ sfTheoryProvable zfrAxioms sfCL2Cmp $):
 $ sfTheoryProvable zfrAxioms sfCL2Law $;
