import "source_relative_theory.mm0";

theorem sfRelativeTheory_transfer_d (S T: set) (D a: nat) (P: wff) (ht: $ sfTheoryClosed T $) (hd: $ sfBound 1 D $) (hi: $ P -> sfRelativeAxiomImages S T D $) (he: $ P -> sfTheoryProvable T (sfEx D) $):
 $ P -> sfBound 0 a -> sfTheoryProvable S a -> sfTheoryProvable T (sfRelativize D a) $;

theorem sfRelativeTheory_transfer_curried (S T: set) (D a: nat) (ht: $ sfTheoryClosed T $) (hd: $ sfBound 1 D $):
 $ sfRelativeAxiomImages S T D -> sfTheoryProvable T (sfEx D) -> sfBound 0 a -> sfTheoryProvable S a -> sfTheoryProvable T (sfRelativize D a) $;

theorem sfRelativeTheory_refutation_d (S T: set) (D: nat) (P: wff) (ht: $ sfTheoryClosed T $) (hd: $ sfBound 1 D $) (hi: $ P -> sfRelativeAxiomImages S T D $) (he: $ P -> sfTheoryProvable T (sfEx D) $):
 $ P -> sfTheoryProvable S sfBot -> sfTheoryProvable T sfBot $;

theorem sfRelativeTheory_refutation_curried (S T: set) (D: nat) (ht: $ sfTheoryClosed T $) (hd: $ sfBound 1 D $):
 $ sfRelativeAxiomImages S T D -> sfTheoryProvable T (sfEx D) -> sfTheoryProvable S sfBot -> sfTheoryProvable T sfBot $;
