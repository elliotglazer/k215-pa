@_ def k215PairAt3369State (pc a b t c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) b (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) a t (k215PR8 c)) $;

do (apply (register-eqd 'k215PairAt3369State) '(k215PairAt3369Stateeqd));

theorem k215PairAt3369TransferIn (a b t c: nat): $ k215PIter (4 * b + 1) (k215PairAt3369State k215PNum3369 a b t c) = (k215PairAt3369State k215PNum3373 (a + b) 0 (t + b) c) $ =
 '(eqtr k215Loop3369Vector (k215PStateeq2 (k215PVectoreq eqid eqid eqid eqid eqid eqid addcom addcom eqid)));
theorem k215PairAt3369TransferBack (a t c: nat): $ k215PIter (3 * a + 1) (k215PairAt3369State k215PNum3375 a 0 t c) = (k215PairAt3369State k215PNum3378 0 a t c) $ =
 '(eqtr k215Loop3375Vector (k215PStateeq2 (k215PVectoreq2 add0)));
pub theorem k215PairAt3369ReachIn (a b t c: nat): $ k215PReach (k215PairAt3369State k215PNum3369 a b t c) (k215PairAt3369State k215PNum3373 (a + b) 0 (t + b) c) $ =
 '(k215PReach_intro k215PairAt3369TransferIn);
theorem k215PairAt3369ReachBack (a t c: nat): $ k215PReach (k215PairAt3369State k215PNum3375 a 0 t c) (k215PairAt3369State k215PNum3378 0 a t c) $ =
 '(k215PReach_intro k215PairAt3369TransferBack);


theorem k215PairAt3369Step50Z (b t c: nat): $ k215PStep (k215PairAt3369State k215PNum3373 0 b t c) = (k215PairAt3369State k215PNum3379 0 b t c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupPair3369_3373) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215PairAt3369Reach50Z (b t c: nat): $ k215PReach (k215PairAt3369State k215PNum3373 0 b t c) (k215PairAt3369State k215PNum3379 0 b t c) $ = '(k215PReach_step k215PairAt3369Step50Z);

theorem k215PairAt3369Step50S (a b t c: nat): $ k215PStep (k215PairAt3369State k215PNum3373 (suc a) b t c) = (k215PairAt3369State k215PNum3374 a b t c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupPair3369_3373) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215PairAt3369Reach50S (a b t c: nat): $ k215PReach (k215PairAt3369State k215PNum3373 (suc a) b t c) (k215PairAt3369State k215PNum3374 a b t c) $ = '(k215PReach_step k215PairAt3369Step50S);

theorem k215PairAt3369Step51 (a b t c: nat): $ k215PStep (k215PairAt3369State k215PNum3374 a b t c) = (k215PairAt3369State k215PNum3375 a b (suc t) c) $ = '(eqtr (k215PAtCI k215PLookupPair3369_3374) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215PairAt3369Reach51 (a b t c: nat): $ k215PReach (k215PairAt3369State k215PNum3374 a b t c) (k215PairAt3369State k215PNum3375 a b (suc t) c) $ = '(k215PReach_step k215PairAt3369Step51);

theorem k215PairAt3369Step55 (a b t c: nat): $ k215PStep (k215PairAt3369State k215PNum3378 a b t c) = (k215PairAt3369State k215PNum3369 a b t c) $ = '(k215PAtCC k215PLookupPair3369_3378);

theorem k215PairAt3369Reach55 (a b t c: nat): $ k215PReach (k215PairAt3369State k215PNum3378 a b t c) (k215PairAt3369State k215PNum3369 a b t c) $ = '(k215PReach_step k215PairAt3369Step55);

theorem k215PairAt3369Prefix (k t c: nat): $ k215PReach (k215PairAt3369State k215PNum3373 (suc k) 0 t c) (k215PairAt3369State k215PNum3369 0 k (suc t) c) $ = '(ax_mp (ax_mp k215PReach_trans k215PairAt3369Reach50S) (ax_mp (ax_mp k215PReach_trans k215PairAt3369Reach51) (ax_mp (ax_mp k215PReach_trans k215PairAt3369ReachBack) k215PairAt3369Reach55)));
theorem k215PairAt3369ReachSum (a b t k c: nat): $ a + b = suc k -> k215PReach (k215PairAt3369State k215PNum3369 a b t c) (k215PairAt3369State k215PNum3373 (suc k) 0 (t + b) c) $ =
 '(mpbid (k215PReacheq2d (k215PairAt3369Stateeq2d id)) (a1i k215PairAt3369ReachIn));
pub theorem k215PairAt3369Cycle (a b t k c: nat): $ a + b = suc k -> k215PReach (k215PairAt3369State k215PNum3369 a b t c) (k215PairAt3369State k215PNum3369 0 k (suc (t + b)) c) $ =
 '(mpd (a1i k215PairAt3369Prefix) (syl k215PReach_trans k215PairAt3369ReachSum));
theorem k215PairAt3369ReachZeroIn (t c: nat): $ k215PReach (k215PairAt3369State k215PNum3369 0 0 t c) (k215PairAt3369State k215PNum3373 0 0 t c) $ =
 '(mpbi (k215PReacheq2 (k215PairAt3369Stateeq eqid add0 eqid add0 eqid)) k215PairAt3369ReachIn);
pub theorem k215PairAt3369Base (t c: nat): $ k215PReach (k215PairAt3369State k215PNum3369 0 0 t c) (k215PairAt3369State k215PNum3379 0 0 t c) $ =
 '(ax_mp (ax_mp k215PReach_trans k215PairAt3369ReachZeroIn) k215PairAt3369Reach50Z);


@_ abstract def k215PairAt3369Run (a b t c: nat): wff =
 $ k215PReach (k215PairAt3369State k215PNum3369 a b t c) (k215PairAt3369State k215PNum3379 0 0 (t + (a, b)) c) $;
do (apply (register-eqd 'k215PairAt3369Run) '(k215PairAt3369Runeqd));
theorem k215PairAt3369RunZero (t c: nat): $ k215PairAt3369Run 0 0 t c $ =
 '(mpbi (k215PReacheq2 (k215PairAt3369Stateeq4 (eqcom (eqtr (addeq2 pr0) add0)))) k215PairAt3369Base);
theorem k215PairAt3369RunBase (a b t c: nat): $ a + b = 0 -> k215PairAt3369Run a b t c $ =
 '(mpbiri k215PairAt3369RunZero (k215PairAt3369Runeqd
   (syl anl (bi1 addeq0)) (syl anr (bi1 addeq0)) eqidd eqidd));
theorem k215PairAt3369SumStep (a b k: nat): $ a + b = suc k -> (a, b) = b + suc (0, k) $ =
 '(eqtrd (a1i preqadd) (eqtrd (addeq1d (preq1d id))
   (a1i (eqtr (addeq1 k215PairDiagonal_rotate) addcom))));
theorem k215PairAt3369Accumulator (a b t k: nat): $ a + b = suc k -> suc (t + b) + (0, k) = t + (a, b) $ =
 '(eqtrd
   (a1i (eqtr addS1 (eqtr (suceq addass)
     (eqtr (eqcom addS) (addeq2 (eqcom addS))))))
   (addeq2d (eqcomd k215PairAt3369SumStep)));
@_ abstract def k215PairAt3369Claim (k c: nat) (.a .b .t: nat): wff =
 $ A. a A. b A. t (a + b = k -> k215PairAt3369Run a b t c) $;
theorem k215PairAt3369Claim_at (a b t k c: nat): $ k215PairAt3369Claim k c -> a + b = k -> k215PairAt3369Run a b t c $ =
 (named '(!! ealie i @ !! ealde j @ !! ealde l @ bi1d ,eqtac));
theorem k215PairAt3369RunInductive (a b t k c: nat): $ k215PairAt3369Claim k c -> a + b = suc k -> k215PairAt3369Run a b t c $ =
 '(exp @ mpd
   (mpbid
     (k215PReacheq2d (k215PairAt3369Stateeq4d (syl k215PairAt3369Accumulator anr)))
     (mpd (a1i add01) (syl k215PairAt3369Claim_at anl)))
   (syl k215PReach_trans (syl k215PairAt3369Cycle anr)));
theorem k215PairAt3369Claim_all (k c: nat): $ k215PairAt3369Claim k c $ =
 (named @ induct '(ind) 'k
   '(ax_gen (ax_gen (ax_gen k215PairAt3369RunBase)))
   '(iald @ iald @ iald k215PairAt3369RunInductive));
pub theorem k215PairMacro3369 (a b t c: nat): $ k215PReach (k215PairAt3369State k215PNum3369 a b t c) (k215PairAt3369State k215PNum3379 0 0 (t + (a, b)) c) $ =
 '(ax_mp (ax_mp k215PairAt3369Claim_at k215PairAt3369Claim_all) eqid);


