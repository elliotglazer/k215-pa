import "source_k0_qsep_quotient_profile.mm0";

import "source_k0_qsep_quotient_rebase.mm0";

import "k218q_alpha.mm0";

theorem sfK0QSepQuotient_binder_alpha (E: set) (n t a c z y M K phi: nat) (hf: $ sfBound (suc n) phi $) (hz0: $ z != 0 $) (hzM: $ z < M $) (hzK: $ z < K $)
 (htz: $ t != z $) (haz: $ a != z $) (hcz: $ c != z $) (hez: $ sqEnvAvoid E n z $)
 (hy0: $ y != 0 $) (hyM: $ y < M $) (hyK: $ y < K $)
 (hyt: $ y != t $) (hya: $ y != a $) (hyc: $ y != c $) (hyz: $ y != z $) (hey: $ sqEnvAvoid E n y $):
 $ k218QProvable (kImp (kAll z (kImp (kMem t z) (kImp (kImp (kImp (sqMember t z c M) (kImp (kImp (sqMember t z a M) (kImp (sqQuote (sqEnvCons z E) t K 0 phi) kF)) kF)) (kImp (kImp (kImp (kImp (sqMember t z a M) (kImp (sqQuote (sqEnvCons z E) t K 0 phi) kF)) kF) (sqMember t z c M)) kF)) kF))) (kAll y (kImp (kMem t y) (kImp (kImp (kImp (sqMember t y c M) (kImp (kImp (sqMember t y a M) (kImp (sqQuote (sqEnvCons y E) t K 0 phi) kF)) kF)) (kImp (kImp (kImp (kImp (sqMember t y a M) (kImp (sqQuote (sqEnvCons y E) t K 0 phi) kF)) kF) (sqMember t y c M)) kF)) kF)))) $;

theorem sfK0QSepQuotient_body_alpha (E: set) (n t a c z y M K phi: nat) (hf: $ sfBound (suc n) phi $) (hz0: $ z != 0 $) (hzM: $ z < M $) (hzK: $ z < K $)
 (htz: $ t != z $) (haz: $ a != z $) (hcz: $ c != z $) (hez: $ sqEnvAvoid E n z $)
 (hy0: $ y != 0 $) (hyM: $ y < M $) (hyK: $ y < K $)
 (hyt: $ y != t $) (hya: $ y != a $) (hyc: $ y != c $) (hyz: $ y != z $) (hey: $ sqEnvAvoid E n y $):
 $ k218QProvable (kImp (sfK0QSepQuotientBody E t a c z M K phi) (sfK0QSepQuotientBody E t a c y M K phi)) $;

theorem sfK0QSepQuotient_exists_body_alpha (E: set) (n t a c z y M K phi: nat) (hf: $ sfBound (suc n) phi $) (hz0: $ z != 0 $) (hzM: $ z < M $) (hzK: $ z < K $)
 (htz: $ t != z $) (haz: $ a != z $) (hcz: $ c != z $) (hez: $ sqEnvAvoid E n z $)
 (hy0: $ y != 0 $) (hyM: $ y < M $) (hyK: $ y < K $)
 (hyt: $ y != t $) (hya: $ y != a $) (hyc: $ y != c $) (hyz: $ y != z $) (hey: $ sqEnvAvoid E n y $):
 $ k218QProvable (kImp (kExists c (sfK0QSepQuotientBody E t a c z M K phi)) (kExists c (sfK0QSepQuotientBody E t a c y M K phi))) $;

theorem sfK0QSepQuotient_witness_alpha (E: set) (n t a c d z M K phi: nat) (hf: $ sfBound (suc n) phi $) (hc0: $ c != 0 $) (hcM: $ c < M $) (hcK: $ c < K $)
 (htc: $ t != c $) (hac: $ a != c $) (hzc: $ z != c $) (hct: $ c != t $) (hcz: $ c != z $) (hec: $ sqEnvAvoid E n c $)
 (hd0: $ d != 0 $) (hdM: $ d < M $) (hdK: $ d < K $)
 (hdt: $ d != t $) (hda: $ d != a $) (hdc: $ d != c $) (hdz: $ d != z $) (hed: $ sqEnvAvoid E n d $):
 $ k218QProvable (kImp (kExists c (sfK0QSepQuotientBody E t a c z M K phi)) (kExists d (sfK0QSepQuotientBody E t a d z M K phi))) $;
