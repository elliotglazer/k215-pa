import "raw_source_distribution.mm0";

import "raw_source_quantifiers.mm0";

import "k218_codes.mm0";

def rsgVacuityProof (a: nat): nat = $ zfcNDIntro 0 ((sfSequent (a : 0) (sfAll (sfShift 0 a))) : (zfcNDHyp (sfContextShift (a : 0)) (sfShift 0 a))) a (sfAll (sfShift 0 a)) $;

theorem rsgVacuity (a: nat) (h: $ sfWf a $):
 $ zfcProvable (sfImp a (sfAll (sfShift 0 a))) $;

def rsgOrdinaryG (a b c: nat): nat = $ sfImp (sfEq c a) (sfImp (sfEq c b) (sfAll (sfShift 0 (sfEq a b)))) $;

theorem rawSource_SeedG (a b c: nat):
 $ zfcProvable (rawDecode (k218RhoG a b c)) $;
