import "source_piece_pcf_join.mm0";

import "source_l_common_level_members.mm0";

import "source_least_ordinal_binary_fixed.mm0";

def sfTVStrictMember:nat = $ sfMem 2 0 $;

theorem sfTVStrictMember_binary(x y z:nat): $ sfLCBinary sfTVStrictMember x y z = sfMem z x $;

theorem sfTVStrictMember_mono_literal: $ sfPieceMonoCode sfTVStrictMember = sfAll (sfAll (sfAll (sfImp (pcdnmF14 0) (sfImp (pcdnmF21 0) (sfImp (pcdnmF23 0) (sfImp (sfMem 3 2) (sfMem 3 1))))))) $;

theorem sfTVStrictMember_mono_local: $ nsLocal 0 (sfPieceMonoCode sfTVStrictMember) $;

theorem sfTVStrictMember_mono_zfr: $ sfTheoryProvable zfrAxioms (sfPieceMonoCode sfTVStrictMember) $;

theorem sfTVStrictMember_successor_literal: $ sfLeastOrdinalSuccessorLaw = sfAll (sfImp sfLeastOrdinalPredicate (sfEx (sfAnd sfLeastOrdinalPredicate (sfMem 1 0)))) $;

theorem sfTVStrictMember_successor_open: $ sfSubst 0 1 (sfImp sfLeastOrdinalPredicate (sfEx (sfAnd sfLeastOrdinalPredicate (sfMem 1 0)))) = sfImp (sfSubst 0 1 sfLeastOrdinalPredicate) (sfPieceHasOrdinal sfTVStrictMember) $;

theorem sfTVStrictMember_exists_if_ordinal: $ sfTheoryProvable zfrAxioms (sfImp (sfSubst 0 1 sfLeastOrdinalPredicate) (sfPieceHasOrdinal sfTVStrictMember)) $;
