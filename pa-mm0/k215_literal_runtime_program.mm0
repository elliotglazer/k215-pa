def k215PVector (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): nat = $ (a0, a1, a2, a3, a4, a5, a6, a7, a8) $;

def k215PR0 (v: nat): nat = $ fst v $;

def k215PR1 (v: nat): nat = $ fst (snd v) $;

def k215PR2 (v: nat): nat = $ fst (snd (snd v)) $;

def k215PR3 (v: nat): nat = $ fst (snd (snd (snd v))) $;

def k215PR4 (v: nat): nat = $ fst (snd (snd (snd (snd v)))) $;

def k215PR5 (v: nat): nat = $ fst (snd (snd (snd (snd (snd v))))) $;

def k215PR6 (v: nat): nat = $ fst (snd (snd (snd (snd (snd (snd v)))))) $;

def k215PR7 (v: nat): nat = $ fst (snd (snd (snd (snd (snd (snd (snd v))))))) $;

def k215PR8 (v: nat): nat = $ (snd (snd (snd (snd (snd (snd (snd (snd v)))))))) $;

def k215PGet (i v: nat): nat = $ if (i = 0) (k215PR0 v) (if (i = 1) (k215PR1 v) (if (i = 2) (k215PR2 v) (if (i = 3) (k215PR3 v) (if (i = 4) (k215PR4 v) (if (i = 5) (k215PR5 v) (if (i = 6) (k215PR6 v) (if (i = 7) (k215PR7 v) (k215PR8 v)))))))) $;

def k215PSet (i a v: nat): nat = $ k215PVector (if (i = 0) a (k215PR0 v)) (if (i = 1) a (k215PR1 v)) (if (i = 2) a (k215PR2 v)) (if (i = 3) a (k215PR3 v)) (if (i = 4) a (k215PR4 v)) (if (i = 5) a (k215PR5 v)) (if (i = 6) a (k215PR6 v)) (if (i = 7) a (k215PR7 v)) (if (i = 8) a (k215PR8 v)) $;

def k215PState (pc regs: nat): nat = $ (pc, regs) $;

def k215PPC (s: nat): nat = $ fst s $;

def k215PRegs (s: nat): nat = $ snd s $;

def k215PStepEntry (e regs: nat): nat = $ if (k215PETag e = 0)
      (k215PState (k215PEPositive e) (k215PSet (k215PEArg e) (suc (k215PGet (k215PEArg e) regs)) regs))
      (if (k215PETag e = 1)
        (if (k215PGet (k215PEArg e) regs = 0)
          (k215PState (k215PEZero e) regs)
          (k215PState (k215PEPositive e) (k215PSet (k215PEArg e) (k215PGet (k215PEArg e) regs - 1) regs)))
        (k215PState (k215PEZero e) regs)) $;

def k215PStep (s: nat): nat = $ if (k215PETag (k215PLookup (k215PPC s)) = 4) s
      (k215PStepEntry (k215PLookup (k215PPC s)) (k215PRegs s)) $;

def k215PIter (n s: nat) (.z: nat): nat = $ rec s (\ z, k215PStep z) n $;

def k215PInitial: nat = $ k215PState 0 (k215PVector 4 0 0 0 0 0 0 0 0) $;

def k215PHaltsFrom (s: nat) (.n: nat): wff = $ E. n k215PETag (k215PLookup (k215PPC (k215PIter n s))) = 4 $;

def k215PInitialHalts: wff = $ k215PHaltsFrom k215PInitial $;

theorem k215PLookup_zero: $ k215PLookup 0 = (k215PEntry (0 : (0 : (0 : 0))) 1 8 2 1) $;
