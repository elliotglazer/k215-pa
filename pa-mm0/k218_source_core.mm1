import "source_renaming.mm1";

@_ abstract def sfK218RequestMap (.i: nat): set = $ \ i, if (i = 0) 0 (suc i) $;
pub theorem sfK218RequestMap_value (i: nat): $ sfK218RequestMap @ i = if (i = 0) 0 (suc i) $ = (named '(!! applame j ,eqtac));

@_ abstract def sfK218SupportMap (.i: nat): set = $ \ i, if (i = 0) 1 (if (i = 1) 0 (i + 2)) $;
pub theorem sfK218SupportMap_value (i: nat): $ sfK218SupportMap @ i = if (i = 0) 1 (if (i = 1) 0 (i + 2)) $ = (named '(!! applame j ,eqtac));

@_ abstract def sfK218ClosureInputMap (.i: nat): set = $ \ i, if (i < 2) i (i + 4) $;
pub theorem sfK218ClosureInputMap_value (i: nat): $ sfK218ClosureInputMap @ i = if (i < 2) i (i + 4) $ = (named '(!! applame j ,eqtac));

@_ abstract def sfK218ClosureOutputMap (.i: nat): set = $ \ i, if (i = 0) 0 (if (i = 1) 2 (i + 5)) $;
pub theorem sfK218ClosureOutputMap_value (i: nat): $ sfK218ClosureOutputMap @ i = if (i = 0) 0 (if (i = 1) 2 (i + 5)) $ = (named '(!! applame j ,eqtac));

@_ abstract def sfK218KpRequestMap (.i: nat): set = $ \ i, if (i < 2) i (i + 2) $;
pub theorem sfK218KpRequestMap_value (i: nat): $ sfK218KpRequestMap @ i = if (i < 2) i (i + 2) $ = (named '(!! applame j ,eqtac));

@_ def sfK218EmittedClosure (phi: nat): nat = $ (sfAll (sfImp (sfMem 0 1) (sfEx (sfAnd (sfRename sfK218SupportMap 0 phi) (sfAll (sfImp (sfAll (sfImp (sfMem 0 1) (sfMem 0 3))) (sfAll (sfImp (sfRename sfK218ClosureInputMap 0 phi) (sfEx (sfAnd (sfRename sfK218ClosureOutputMap 0 phi) (sfMem 0 5))))))))))) $;
pub theorem sfK218EmittedClosure_wf (phi: nat): $ sfWf (sfK218EmittedClosure phi) $ =
'(ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfWf_mem) (ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and sfRename_wf) (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfWf_mem) sfWf_mem))) (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfRename_wf) (ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and sfRename_wf) sfWf_mem))))))))));

@_ def sfK218SeededCore (phi: nat): nat = $ (sfAll (sfEx (sfAnd (sfImp (sfEx (sfRename sfK218RequestMap 0 phi)) (sfEx (sfAnd (sfMem 0 1) (sfRename sfK218RequestMap 0 phi)))) (sfAll (sfImp (sfMem 0 1) (sfEx (sfAnd (sfRename sfK218SupportMap 0 phi) (sfAll (sfImp (sfAll (sfImp (sfMem 0 1) (sfMem 0 3))) (sfAll (sfImp (sfRename sfK218ClosureInputMap 0 phi) (sfEx (sfAnd (sfRename sfK218ClosureOutputMap 0 phi) (sfMem 0 5)))))))))))))) $;
pub theorem sfK218SeededCore_wf (phi: nat): $ sfWf (sfK218SeededCore phi) $ =
'(ax_mp sfWf_all (ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and (ax_mp (ax_mp sfWf_imp (ax_mp sfWf_ex sfRename_wf)) (ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and sfWf_mem) sfRename_wf)))) (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfWf_mem) (ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and sfRename_wf) (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfWf_mem) sfWf_mem))) (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfRename_wf) (ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and sfRename_wf) sfWf_mem)))))))))))));

@_ def sfK218Kp0 (phi: nat): nat = $ (sfAll (sfEx (sfAnd (sfAll (sfImp (sfOr (sfEq 0 2) (sfEx (sfAnd (sfMem 0 2) (sfAll (sfImp (sfMem 0 2) (sfMem 0 1)))))) (sfImp (sfEx (sfRename sfK218KpRequestMap 0 phi)) (sfEx (sfAnd (sfMem 0 2) (sfRename sfK218KpRequestMap 0 phi)))))) (sfAll (sfImp (sfMem 0 1) (sfEx (sfRename sfK218SupportMap 0 phi))))))) $;
pub theorem sfK218Kp0_wf (phi: nat): $ sfWf (sfK218Kp0 phi) $ =
'(ax_mp sfWf_all (ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp (ax_mp (ax_mp sfWf_or sfWf_eq) (ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and sfWf_mem) (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfWf_mem) sfWf_mem)))))) (ax_mp (ax_mp sfWf_imp (ax_mp sfWf_ex sfRename_wf)) (ax_mp sfWf_ex (ax_mp (ax_mp sfWf_and sfWf_mem) sfRename_wf)))))) (ax_mp sfWf_all (ax_mp (ax_mp sfWf_imp sfWf_mem) (ax_mp sfWf_ex sfRename_wf))))));
