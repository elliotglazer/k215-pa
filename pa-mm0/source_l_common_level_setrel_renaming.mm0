import "source_l_common_level_setrel.mm0";

import "source_theory_prefix.mm0";

import "source_structural_induction.mm0";

def sfCLSetRelRenameClass (R: set) (.c .k .d: nat): set = $ {c | A. k A. d sfRename R k (sfCLSetRel d c) = sfCLSetRel (sfRenameIndex R k d) (sfRename R k c)} $;

theorem sfCLSetRel_rename (R: set) (k d c: nat): $ sfWf c -> sfRename R k (sfCLSetRel d c) = sfCLSetRel (sfRenameIndex R k d) (sfRename R k c) $;

theorem sfCLSetRel_shift (k d c: nat) (hc: $ sfWf c $): $ sfShift k (sfCLSetRel d c) = sfCLSetRel (sfShiftIndex k d) (sfShift k c) $;
