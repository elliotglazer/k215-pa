theorem sfK0QSepCarrier_image (E: set) (n k phi: nat) (hf: $ sfBound (suc n) phi $) (hk: $ 2 < k $)
 (he: $ sqEnvBelow E n k $):
 $ k218QProvable (kImp kEmptyMarker (sqQuote E 1 k 0 (sfSeparation (sfRename sfSepMap 0 phi)))) $;
