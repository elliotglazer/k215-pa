import "k218q_seed_kp0_common.mm0";

def k218Kp0Aligned (E: set) (n B f: nat): nat =
 $ (kAll (k218SourceSeedBase E B f) (kExists (suc (k218SourceSeedBase E B f)) (kAnd (kAll (suc (suc (k218SourceSeedBase E B f))) (kImp (kDisj (kEq (suc (suc (k218SourceSeedBase E B f))) (k218SourceSeedBase E B f)) (kExists (suc (suc (suc (k218SourceSeedBase E B f)))) (kAnd (kMem (suc (suc (suc (k218SourceSeedBase E B f)))) (suc (k218SourceSeedBase E B f))) (kAll (suc (suc (suc (suc (k218SourceSeedBase E B f))))) (kImp (kMem (suc (suc (suc (suc (k218SourceSeedBase E B f))))) (suc (suc (k218SourceSeedBase E B f)))) (kMem (suc (suc (suc (suc (k218SourceSeedBase E B f))))) (suc (suc (suc (k218SourceSeedBase E B f)))))))))) (kImp (kExists (suc (suc (suc (k218SourceSeedBase E B f)))) (sfNamedTemplate (sqEnvCons (suc (suc (suc (k218SourceSeedBase E B f)))) (sqEnvCons (suc (suc (k218SourceSeedBase E B f))) E)) (k218SourceMatrixBase E B f) 0 f)) (kExists (suc (suc (suc (k218SourceSeedBase E B f)))) (kAnd (kMem (suc (suc (suc (k218SourceSeedBase E B f)))) (suc (k218SourceSeedBase E B f))) (sfNamedTemplate (sqEnvCons (suc (suc (suc (k218SourceSeedBase E B f)))) (sqEnvCons (suc (suc (k218SourceSeedBase E B f))) E)) (k218SourceMatrixBase E B f) 0 f)))))) (kAll (suc (suc (k218SourceSeedBase E B f))) (kImp (kMem (suc (suc (k218SourceSeedBase E B f))) (suc (k218SourceSeedBase E B f))) (kExists (suc (suc (suc (k218SourceSeedBase E B f)))) (sfNamedTemplate (sqEnvCons (suc (suc (k218SourceSeedBase E B f))) (sqEnvCons (suc (suc (suc (k218SourceSeedBase E B f)))) E)) (k218SourceMatrixBase E B f) 0 f))))))) $;

theorem k218QKp0_alpha_aligned {j: nat} (E: set) (n B f: nat)
 (hB: $ 3 < B $) (he1: $ sqEnvAvoid E n 1 $) (he3: $ sqEnvAvoid E n 3 $)
 (he: $ A. j (j < n -> E @ j < B) $)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218IEquivalent (k218Kp0Common E n B f) (k218Kp0Aligned E n B f) $;

theorem k218QKp0_aligned_source {i j: nat} (E: set) (n B f: nat)
 (hB: $ 3 < B $) (he1: $ sqEnvAvoid E n 1 $) (he3: $ sqEnvAvoid E n 3 $)
 (he: $ A. j (j < n -> E @ j < B) $)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218IEquivalent (k218Kp0Aligned E n B f) (k218NamedKp0 E (k218SourceSeedBase E B f) f) $;

theorem k218QNamedKp0 {i j: nat} (E: set) (n B f: nat)
 (hB: $ 3 < B $) (he1: $ sqEnvAvoid E n 1 $) (he3: $ sqEnvAvoid E n 3 $)
 (he: $ A. j (j < n -> E @ j < B) $)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218QProvable (k218NamedKp0 E (k218SourceSeedBase E B f) f) $;

theorem k218QSourceKp0 {i j: nat} (E: set) (n B f: nat)
 (hB: $ 3 < B $) (he1: $ sqEnvAvoid E n 1 $) (he3: $ sqEnvAvoid E n 3 $)
 (he: $ A. j (j < n -> E @ j < B) $)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218QProvable (sfNamedTemplate E (k218SourceSeedBase E B f) 0 (sfK218Kp0 f)) $;
