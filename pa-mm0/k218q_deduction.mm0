-- Interpreted raw-code logical replay. The only global predicate is
-- k218QProvable(c) = k218Provable(k218Translate(c)); no core image is assumed.
import "k218q_derived.mm0";

-- Contextual deduction uses only assumptions, already proved k218QProvable
-- seeds (k218QTheorems), and earlier modus ponens. There is no GEN rule here.
def k218IHypRules (G: nat) (.c .l .b: nat): set =
$ S\ c, {l | c IN G \/ (c e. k218QTheorems \/
    E. b (b IN l /\ kImp b c IN l))} $;
def k218IHypDerives (G p a: nat): wff = $ traceDerives (k218IHypRules G) p a $;
def k218IHypProvable (G a: nat) (.p: nat): wff = $ E. p k218IHypDerives G p a $;

theorem k218IHypRules_value {b: nat} (G c l: nat):
  $ (c, l) e. k218IHypRules G <-> c IN G \/
    (c e. k218QTheorems \/ E. b (b IN l /\ kImp b c IN l)) $;
theorem k218IHypRules_stable (G: nat): $ traceAppendStable (k218IHypRules G) $;
theorem k218IHypProvable_intro (G p a: nat): $ k218IHypDerives G p a -> k218IHypProvable G a $;
theorem k218IHypProvable_assumption (G a: nat): $ a IN G -> k218IHypProvable G a $;
theorem k218IHypProvable_seed (G a: nat): $ k218QProvable a -> k218IHypProvable G a $;
theorem k218IHypDerives_mp (G p q a b: nat):
  $ k218IHypDerives G p a -> k218IHypDerives G q (kImp a b) ->
    k218IHypDerives G (b : (p ++ q)) b $;
theorem k218IHypProvable_mp (G a b: nat):
  $ k218IHypProvable G a -> k218IHypProvable G (kImp a b) -> k218IHypProvable G b $;

theorem k218IHypProvable_imp_weaken (G h a: nat):
  $ k218IHypProvable G a -> k218IHypProvable G (kImp h a) $;
theorem k218IHypProvable_imp_mp (G h a b: nat):
  $ k218IHypProvable G (kImp h a) -> k218IHypProvable G (kImp h (kImp a b)) ->
    k218IHypProvable G (kImp h b) $;
def k218IDeductionClass (G h: nat) (.a: nat): set =
$ {a | k218IHypProvable G (kImp h a)} $;
theorem k218IDeductionClass_value (G h a: nat):
  $ a e. k218IDeductionClass G h <-> k218IHypProvable G (kImp h a) $;
theorem k218IHypRules_deduction_sound (G h: nat):
  $ traceRuleSound (k218IHypRules (h : G)) (k218IDeductionClass G h) $;
theorem k218IHypDerives_deduction (G h p a: nat):
  $ k218IHypDerives (h : G) p a -> k218IHypProvable G (kImp h a) $;
theorem k218IHypProvable_deduction (G h a: nat):
  $ k218IHypProvable (h : G) a -> k218IHypProvable G (kImp h a) $;
theorem k218IHypRules_empty_sound: $ traceRuleSound (k218IHypRules 0) k218QTheorems $;
theorem k218IHypDerives_empty (p a: nat): $ k218IHypDerives 0 p a -> k218QProvable a $;
theorem k218IHypProvable_empty (a: nat): $ k218IHypProvable 0 a -> k218QProvable a $;
theorem k218IHypProvable_empty_iff (a: nat): $ k218IHypProvable 0 a <-> k218QProvable a $;
theorem k218IHypProvable_discharge (h a: nat):
  $ k218IHypProvable (h : 0) a -> k218QProvable (kImp h a) $;
