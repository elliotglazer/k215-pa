theorem bcSN10 {x: nat} (z t b A: nat) (P: wff x) (ht: $ t < 8 $) (hP: $ P <-> x = A $): $ E. x (x <= z /\ bdNode t x b z /\ P) <-> z = sfNode t A b $;
theorem bcSN01 {y: nat} (z t a B: nat) (Q: wff y) (ht: $ t < 8 $) (hQ: $ Q <-> y = B $): $ E. y (y <= z /\ bdNode t a y z /\ Q) <-> z = sfNode t a B $;
theorem bcSN11 {x y: nat} (z t A B: nat) (P: wff x) (Q: wff y) (ht: $ t < 8 $) (hP: $ P <-> x = A $) (hQ: $ Q <-> y = B $): $ E. x (x <= z /\ E. y (y <= z /\ bdNode t x y z /\ P /\ Q)) <-> z = sfNode t A B $;
theorem bcSK00_0 {p: nat} (z A B: nat): $ E. p (p <= z /\ bdPair A B p /\ z = 4 * p) <-> z = 4 * (A, B) $;
theorem bcSK01_0 {p y: nat} (z A B: nat) (Q: wff y) (hQ: $ Q <-> y = B $): $ E. p (p <= z /\ E. y (y <= p /\ bdPair A y p /\ z = 4 * p /\ Q)) <-> z = 4 * (A, B) $;
theorem bcSK10_0 {p x: nat} (z A B: nat) (P: wff x) (hP: $ P <-> x = A $): $ E. p (p <= z /\ E. x (x <= p /\ bdPair x B p /\ z = 4 * p /\ P)) <-> z = 4 * (A, B) $;
theorem bcSK11_0 {p x y: nat} (z A B: nat) (P: wff x) (Q: wff y) (hP: $ P <-> x = A $) (hQ: $ Q <-> y = B $): $ E. p (p <= z /\ E. x (x <= p /\ E. y (y <= p /\ bdPair x y p /\ z = 4 * p /\ P /\ Q))) <-> z = 4 * (A, B) $;
theorem bcSK00_1 {p: nat} (z A B: nat): $ E. p (p <= z /\ bdPair A B p /\ z = 4 * p + 1) <-> z = 4 * (A, B) + 1 $;
theorem bcSK01_1 {p y: nat} (z A B: nat) (Q: wff y) (hQ: $ Q <-> y = B $): $ E. p (p <= z /\ E. y (y <= p /\ bdPair A y p /\ z = 4 * p + 1 /\ Q)) <-> z = 4 * (A, B) + 1 $;
theorem bcSK10_1 {p x: nat} (z A B: nat) (P: wff x) (hP: $ P <-> x = A $): $ E. p (p <= z /\ E. x (x <= p /\ bdPair x B p /\ z = 4 * p + 1 /\ P)) <-> z = 4 * (A, B) + 1 $;
theorem bcSK11_1 {p x y: nat} (z A B: nat) (P: wff x) (Q: wff y) (hP: $ P <-> x = A $) (hQ: $ Q <-> y = B $): $ E. p (p <= z /\ E. x (x <= p /\ E. y (y <= p /\ bdPair x y p /\ z = 4 * p + 1 /\ P /\ Q))) <-> z = 4 * (A, B) + 1 $;
theorem bcSK00_2 {p: nat} (z A B: nat): $ E. p (p <= z /\ bdPair A B p /\ z = 4 * p + 2) <-> z = 4 * (A, B) + 2 $;
theorem bcSK01_2 {p y: nat} (z A B: nat) (Q: wff y) (hQ: $ Q <-> y = B $): $ E. p (p <= z /\ E. y (y <= p /\ bdPair A y p /\ z = 4 * p + 2 /\ Q)) <-> z = 4 * (A, B) + 2 $;
theorem bcSK10_2 {p x: nat} (z A B: nat) (P: wff x) (hP: $ P <-> x = A $): $ E. p (p <= z /\ E. x (x <= p /\ bdPair x B p /\ z = 4 * p + 2 /\ P)) <-> z = 4 * (A, B) + 2 $;
theorem bcSK11_2 {p x y: nat} (z A B: nat) (P: wff x) (Q: wff y) (hP: $ P <-> x = A $) (hQ: $ Q <-> y = B $): $ E. p (p <= z /\ E. x (x <= p /\ E. y (y <= p /\ bdPair x y p /\ z = 4 * p + 2 /\ P /\ Q))) <-> z = 4 * (A, B) + 2 $;
theorem bcSK00_3 {p: nat} (z A B: nat): $ E. p (p <= z /\ bdPair A B p /\ z = 4 * p + 3) <-> z = 4 * (A, B) + 3 $;
theorem bcSK01_3 {p y: nat} (z A B: nat) (Q: wff y) (hQ: $ Q <-> y = B $): $ E. p (p <= z /\ E. y (y <= p /\ bdPair A y p /\ z = 4 * p + 3 /\ Q)) <-> z = 4 * (A, B) + 3 $;
theorem bcSK10_3 {p x: nat} (z A B: nat) (P: wff x) (hP: $ P <-> x = A $): $ E. p (p <= z /\ E. x (x <= p /\ bdPair x B p /\ z = 4 * p + 3 /\ P)) <-> z = 4 * (A, B) + 3 $;
theorem bcSK11_3 {p x y: nat} (z A B: nat) (P: wff x) (Q: wff y) (hP: $ P <-> x = A $) (hQ: $ Q <-> y = B $): $ E. p (p <= z /\ E. x (x <= p /\ E. y (y <= p /\ bdPair x y p /\ z = 4 * p + 3 /\ P /\ Q))) <-> z = 4 * (A, B) + 3 $;
