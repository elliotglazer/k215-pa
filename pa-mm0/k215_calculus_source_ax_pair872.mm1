import "k215_calculus_source_ax_stack_loops.mm1";
import "k215_literal_runtime_reach.mm1";
import "k215_calculus_source_pairing.mm1";
import "k215_calculus_source_ax_stack_lookups.mm1";

@_ def k215PairAt872State (pc a b t c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) b (k215PR2 c) (k215PR3 c) (k215PR4 c) (k215PR5 c) a t (k215PR8 c)) $;

do (apply (register-eqd 'k215PairAt872State) '(k215PairAt872Stateeqd));

theorem k215PairAt872TransferIn (a b t c: nat): $ k215PIter (4 * b + 1) (k215PairAt872State k215PNum872 a b t c) = (k215PairAt872State k215PNum876 (a + b) 0 (t + b) c) $ =
 '(eqtr k215Loop872Vector (k215PStateeq2 (k215PVectoreq eqid eqid eqid eqid eqid eqid addcom addcom eqid)));
theorem k215PairAt872TransferBack (a t c: nat): $ k215PIter (3 * a + 1) (k215PairAt872State k215PNum878 a 0 t c) = (k215PairAt872State k215PNum881 0 a t c) $ =
 '(eqtr k215Loop878Vector (k215PStateeq2 (k215PVectoreq2 add0)));
pub theorem k215PairAt872ReachIn (a b t c: nat): $ k215PReach (k215PairAt872State k215PNum872 a b t c) (k215PairAt872State k215PNum876 (a + b) 0 (t + b) c) $ =
 '(k215PReach_intro k215PairAt872TransferIn);
theorem k215PairAt872ReachBack (a t c: nat): $ k215PReach (k215PairAt872State k215PNum878 a 0 t c) (k215PairAt872State k215PNum881 0 a t c) $ =
 '(k215PReach_intro k215PairAt872TransferBack);


theorem k215PairAt872Step50Z (b t c: nat): $ k215PStep (k215PairAt872State k215PNum876 0 b t c) = (k215PairAt872State k215PNum882 0 b t c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupPair872_876) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215PairAt872Reach50Z (b t c: nat): $ k215PReach (k215PairAt872State k215PNum876 0 b t c) (k215PairAt872State k215PNum882 0 b t c) $ = '(k215PReach_step k215PairAt872Step50Z);

theorem k215PairAt872Step50S (a b t c: nat): $ k215PStep (k215PairAt872State k215PNum876 (suc a) b t c) = (k215PairAt872State k215PNum877 a b t c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupPair872_876) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215PairAt872Reach50S (a b t c: nat): $ k215PReach (k215PairAt872State k215PNum876 (suc a) b t c) (k215PairAt872State k215PNum877 a b t c) $ = '(k215PReach_step k215PairAt872Step50S);

theorem k215PairAt872Step51 (a b t c: nat): $ k215PStep (k215PairAt872State k215PNum877 a b t c) = (k215PairAt872State k215PNum878 a b (suc t) c) $ = '(eqtr (k215PAtCI k215PLookupPair872_877) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215PairAt872Reach51 (a b t c: nat): $ k215PReach (k215PairAt872State k215PNum877 a b t c) (k215PairAt872State k215PNum878 a b (suc t) c) $ = '(k215PReach_step k215PairAt872Step51);

theorem k215PairAt872Step55 (a b t c: nat): $ k215PStep (k215PairAt872State k215PNum881 a b t c) = (k215PairAt872State k215PNum872 a b t c) $ = '(k215PAtCC k215PLookupPair872_881);

theorem k215PairAt872Reach55 (a b t c: nat): $ k215PReach (k215PairAt872State k215PNum881 a b t c) (k215PairAt872State k215PNum872 a b t c) $ = '(k215PReach_step k215PairAt872Step55);

theorem k215PairAt872Prefix (k t c: nat): $ k215PReach (k215PairAt872State k215PNum876 (suc k) 0 t c) (k215PairAt872State k215PNum872 0 k (suc t) c) $ = '(ax_mp (ax_mp k215PReach_trans k215PairAt872Reach50S) (ax_mp (ax_mp k215PReach_trans k215PairAt872Reach51) (ax_mp (ax_mp k215PReach_trans k215PairAt872ReachBack) k215PairAt872Reach55)));
theorem k215PairAt872ReachSum (a b t k c: nat): $ a + b = suc k -> k215PReach (k215PairAt872State k215PNum872 a b t c) (k215PairAt872State k215PNum876 (suc k) 0 (t + b) c) $ =
 '(mpbid (k215PReacheq2d (k215PairAt872Stateeq2d id)) (a1i k215PairAt872ReachIn));
pub theorem k215PairAt872Cycle (a b t k c: nat): $ a + b = suc k -> k215PReach (k215PairAt872State k215PNum872 a b t c) (k215PairAt872State k215PNum872 0 k (suc (t + b)) c) $ =
 '(mpd (a1i k215PairAt872Prefix) (syl k215PReach_trans k215PairAt872ReachSum));
theorem k215PairAt872ReachZeroIn (t c: nat): $ k215PReach (k215PairAt872State k215PNum872 0 0 t c) (k215PairAt872State k215PNum876 0 0 t c) $ =
 '(mpbi (k215PReacheq2 (k215PairAt872Stateeq eqid add0 eqid add0 eqid)) k215PairAt872ReachIn);
pub theorem k215PairAt872Base (t c: nat): $ k215PReach (k215PairAt872State k215PNum872 0 0 t c) (k215PairAt872State k215PNum882 0 0 t c) $ =
 '(ax_mp (ax_mp k215PReach_trans k215PairAt872ReachZeroIn) k215PairAt872Reach50Z);


@_ abstract def k215PairAt872Run (a b t c: nat): wff =
 $ k215PReach (k215PairAt872State k215PNum872 a b t c) (k215PairAt872State k215PNum882 0 0 (t + (a, b)) c) $;
do (apply (register-eqd 'k215PairAt872Run) '(k215PairAt872Runeqd));
theorem k215PairAt872RunZero (t c: nat): $ k215PairAt872Run 0 0 t c $ =
 '(mpbi (k215PReacheq2 (k215PairAt872Stateeq4 (eqcom (eqtr (addeq2 pr0) add0)))) k215PairAt872Base);
theorem k215PairAt872RunBase (a b t c: nat): $ a + b = 0 -> k215PairAt872Run a b t c $ =
 '(mpbiri k215PairAt872RunZero (k215PairAt872Runeqd
   (syl anl (bi1 addeq0)) (syl anr (bi1 addeq0)) eqidd eqidd));
theorem k215PairAt872SumStep (a b k: nat): $ a + b = suc k -> (a, b) = b + suc (0, k) $ =
 '(eqtrd (a1i preqadd) (eqtrd (addeq1d (preq1d id))
   (a1i (eqtr (addeq1 k215PairDiagonal_rotate) addcom))));
theorem k215PairAt872Accumulator (a b t k: nat): $ a + b = suc k -> suc (t + b) + (0, k) = t + (a, b) $ =
 '(eqtrd
   (a1i (eqtr addS1 (eqtr (suceq addass)
     (eqtr (eqcom addS) (addeq2 (eqcom addS))))))
   (addeq2d (eqcomd k215PairAt872SumStep)));
@_ abstract def k215PairAt872Claim (k c: nat) (.a .b .t: nat): wff =
 $ A. a A. b A. t (a + b = k -> k215PairAt872Run a b t c) $;
theorem k215PairAt872Claim_at (a b t k c: nat): $ k215PairAt872Claim k c -> a + b = k -> k215PairAt872Run a b t c $ =
 (named '(!! ealie i @ !! ealde j @ !! ealde l @ bi1d ,eqtac));
theorem k215PairAt872RunInductive (a b t k c: nat): $ k215PairAt872Claim k c -> a + b = suc k -> k215PairAt872Run a b t c $ =
 '(exp @ mpd
   (mpbid
     (k215PReacheq2d (k215PairAt872Stateeq4d (syl k215PairAt872Accumulator anr)))
     (mpd (a1i add01) (syl k215PairAt872Claim_at anl)))
   (syl k215PReach_trans (syl k215PairAt872Cycle anr)));
theorem k215PairAt872Claim_all (k c: nat): $ k215PairAt872Claim k c $ =
 (named @ induct '(ind) 'k
   '(ax_gen (ax_gen (ax_gen k215PairAt872RunBase)))
   '(iald @ iald @ iald k215PairAt872RunInductive));
pub theorem k215PairMacro872 (a b t c: nat): $ k215PReach (k215PairAt872State k215PNum872 a b t c) (k215PairAt872State k215PNum882 0 0 (t + (a, b)) c) $ =
 '(ax_mp (ax_mp k215PairAt872Claim_at k215PairAt872Claim_all) eqid);


