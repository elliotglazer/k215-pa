import "source_l_replacement_schema_seed.mm1";
import "source_l_replacement_parameter_transport.mm1";

pub theorem sfLReplacementInput_lift(G n phi f:nat)
 (hf:$ sfShift 0 f = f $)
 (hp:$ nsLocal (sfLSeparationImageParameterContext sfLDomain n G) f $):
 $ nsLocal (sfLReplacementSchemaInput G n phi) f $ =
 '(sfRQ_rewrite hf
  (ax_mp (ax_mp (ax_mp nsLocal_weaken
    (mpbir sfContextWf_cons (ian sfLDomain_wf sfContextShift_wf))) sfContextSub_cons)
   (ax_mp sfSepLocal_shift
    (ax_mp (ax_mp (ax_mp nsLocal_weaken
     (mpbir sfContextWf_cons (ian
      (ax_mp sfRelativize_wf sfLDomain_wf) (ax_mp nsLocal_context_wf hp)))) sfContextSub_cons) hp))));
