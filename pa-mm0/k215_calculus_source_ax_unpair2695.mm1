@_ def k215UnpairAt2695State (pc a b n c: nat): nat = $ k215PState pc (k215PVector (k215PR0 c) (k215PR1 c) n (k215PR3 c) (k215PR4 c) (k215PR5 c) a b (k215PR8 c)) $;

do (apply (register-eqd 'k215UnpairAt2695State) '(k215UnpairAt2695Stateeqd));

theorem k215UnpairAt2695Transfer (b n c: nat): $ k215PIter (3 * b + 1) (k215UnpairAt2695State k215PNum2699 0 b n c) = (k215UnpairAt2695State k215PNum2702 b 0 n c) $ =
 '(eqtr k215Loop2699Vector (k215PStateeq2 (k215PVectoreq7 add0)));
theorem k215UnpairAt2695ReachTransfer (b n c: nat): $ k215PReach (k215UnpairAt2695State k215PNum2699 0 b n c) (k215UnpairAt2695State k215PNum2702 b 0 n c) $ =
 '(k215PReach_intro k215UnpairAt2695Transfer);


theorem k215UnpairAt2695Step9Z (a b c: nat): $ k215PStep (k215UnpairAt2695State k215PNum2695 a b 0 c) = (k215UnpairAt2695State k215PNum2703 a b 0 c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair2695_2695) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt2695Reach9Z (a b c: nat): $ k215PReach (k215UnpairAt2695State k215PNum2695 a b 0 c) (k215UnpairAt2695State k215PNum2703 a b 0 c) $ = '(k215PReach_step k215UnpairAt2695Step9Z);

theorem k215UnpairAt2695Step9S (a b n c: nat): $ k215PStep (k215UnpairAt2695State k215PNum2695 a b (suc n) c) = (k215UnpairAt2695State k215PNum2696 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair2695_2695) (ifeq (eqeq1 k215PGet2_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet2_vector)) (eqtr k215PSet2_vector (k215PVectoreq3 (eqtr subSS sub02))))));

theorem k215UnpairAt2695Reach9S (a b n c: nat): $ k215PReach (k215UnpairAt2695State k215PNum2695 a b (suc n) c) (k215UnpairAt2695State k215PNum2696 a b n c) $ = '(k215PReach_step k215UnpairAt2695Step9S);

theorem k215UnpairAt2695Step10 (a b n c: nat): $ k215PStep (k215UnpairAt2695State k215PNum2696 a b n c) = (k215UnpairAt2695State k215PNum2697 a (suc b) n c) $ = '(eqtr (k215PAtCI k215PLookupUnpair2695_2696) (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet7_vector)) k215PSet7_vector)));

theorem k215UnpairAt2695Reach10 (a b n c: nat): $ k215PReach (k215UnpairAt2695State k215PNum2696 a b n c) (k215UnpairAt2695State k215PNum2697 a (suc b) n c) $ = '(k215PReach_step k215UnpairAt2695Step10);

theorem k215UnpairAt2695Step11Z (b n c: nat): $ k215PStep (k215UnpairAt2695State k215PNum2697 0 b n c) = (k215UnpairAt2695State k215PNum2699 0 b n c) $ = '(eqtr (eqtr (k215PAtCD k215PLookupUnpair2695_2697) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifpos eqid));

theorem k215UnpairAt2695Reach11Z (b n c: nat): $ k215PReach (k215UnpairAt2695State k215PNum2697 0 b n c) (k215UnpairAt2695State k215PNum2699 0 b n c) $ = '(k215PReach_step k215UnpairAt2695Step11Z);

theorem k215UnpairAt2695Step11S (a b n c: nat): $ k215PStep (k215UnpairAt2695State k215PNum2697 (suc a) b n c) = (k215UnpairAt2695State k215PNum2698 a b n c) $ = '(eqtr (eqtr (eqtr (k215PAtCD k215PLookupUnpair2695_2697) (ifeq (eqeq1 k215PGet6_vector) eqid eqid)) (ifneg peano1)) (k215PStateeq2 (eqtr (k215PSeteq2 (subeq1 k215PGet6_vector)) (eqtr k215PSet6_vector (k215PVectoreq7 (eqtr subSS sub02))))));

theorem k215UnpairAt2695Reach11S (a b n c: nat): $ k215PReach (k215UnpairAt2695State k215PNum2697 (suc a) b n c) (k215UnpairAt2695State k215PNum2698 a b n c) $ = '(k215PReach_step k215UnpairAt2695Step11S);

theorem k215UnpairAt2695Step12 (a b n c: nat): $ k215PStep (k215UnpairAt2695State k215PNum2698 a b n c) = (k215UnpairAt2695State k215PNum2702 a b n c) $ = '(k215PAtCB k215PLookupUnpair2695_2698);

theorem k215UnpairAt2695Reach12 (a b n c: nat): $ k215PReach (k215UnpairAt2695State k215PNum2698 a b n c) (k215UnpairAt2695State k215PNum2702 a b n c) $ = '(k215PReach_step k215UnpairAt2695Step12);

theorem k215UnpairAt2695Step16 (a b n c: nat): $ k215PStep (k215UnpairAt2695State k215PNum2702 a b n c) = (k215UnpairAt2695State k215PNum2695 a b n c) $ = '(k215PAtCC k215PLookupUnpair2695_2702);

theorem k215UnpairAt2695Reach16 (a b n c: nat): $ k215PReach (k215UnpairAt2695State k215PNum2702 a b n c) (k215UnpairAt2695State k215PNum2695 a b n c) $ = '(k215PReach_step k215UnpairAt2695Step16);

theorem k215UnpairAt2695CycleZero (b n c: nat): $ k215PReach (k215UnpairAt2695State k215PNum2695 0 b (suc n) c) (k215UnpairAt2695State k215PNum2695 (suc b) 0 n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt2695Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2695Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2695Reach11Z) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2695ReachTransfer) k215UnpairAt2695Reach16))));
theorem k215UnpairAt2695CycleSucc (a b n c: nat): $ k215PReach (k215UnpairAt2695State k215PNum2695 (suc a) b (suc n) c) (k215UnpairAt2695State k215PNum2695 a (suc b) n c) $ = '(ax_mp (ax_mp k215PReach_trans k215UnpairAt2695Reach9S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2695Reach10) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2695Reach11S) (ax_mp (ax_mp k215PReach_trans k215UnpairAt2695Reach12) k215UnpairAt2695Reach16))));


theorem k215UnpairAt2695AdvanceZero (b n c: nat): $ k215PReach (k215UnpairAt2695State k215PNum2695 0 b (suc n) c) (k215UnpairAt2695State k215PNum2695 (fst (suc (0, b))) (snd (suc (0, b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt2695Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215PairDiagonal_rotate)) (eqtr (eqcom sndpr) (sndeq k215PairDiagonal_rotate)) eqid eqid)) k215UnpairAt2695CycleZero);

theorem k215UnpairAt2695AdvanceSucc (a b n c: nat): $ k215PReach (k215UnpairAt2695State k215PNum2695 (suc a) b (suc n) c) (k215UnpairAt2695State k215PNum2695 (fst (suc ((suc a), b))) (snd (suc ((suc a), b))) n c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt2695Stateeq eqid (eqtr (eqcom fstpr) (fsteq k215Pair_next)) (eqtr (eqcom sndpr) (sndeq k215Pair_next)) eqid eqid)) k215UnpairAt2695CycleSucc);

pub theorem k215UnpairAt2695Advance (a b n c: nat): $ k215PReach (k215UnpairAt2695State k215PNum2695 a b (suc n) c) (k215UnpairAt2695State k215PNum2695 (fst (suc (a, b))) (snd (suc (a, b))) n c) $ =
 (named @ induct '(ind) 'a 'k215UnpairAt2695AdvanceZero '(a1i k215UnpairAt2695AdvanceSucc));
@_ abstract def k215UnpairAt2695Run (n a b c: nat): wff =
 $ k215PReach (k215UnpairAt2695State k215PNum2695 a b n c) (k215UnpairAt2695State k215PNum2703 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $;
theorem k215UnpairAt2695RunZero (a b c: nat): $ k215UnpairAt2695Run 0 a b c $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt2695Stateeq eqid
     (eqcom (eqtr (fsteq add0) fstpr))
     (eqcom (eqtr (sndeq add0) sndpr)) eqid eqid)) k215UnpairAt2695Reach9Z);
@_ abstract def k215UnpairAt2695Claim (n c: nat) (.a .b: nat): wff =
 $ A. a A. b k215UnpairAt2695Run n a b c $;
theorem k215UnpairAt2695Claim_at (n a b c: nat): $ k215UnpairAt2695Claim n c -> k215UnpairAt2695Run n a b c $ =
 (named '(!! ealie i @ !! ealde j @ bi1d ,eqtac));
theorem k215UnpairAt2695CodeStep (a b n: nat): $ (fst (suc (a, b)), snd (suc (a, b))) + n = (a, b) + suc n $ =
 '(eqtr (addeq1 fstsnd) addSass);
theorem k215UnpairAt2695RunInductive (n a b c: nat): $ k215UnpairAt2695Claim n c -> k215UnpairAt2695Run (suc n) a b c $ =
 '(syl (ax_mp k215PReach_trans k215UnpairAt2695Advance)
   (mpbid (a1i (k215PReacheq2 (k215UnpairAt2695Stateeq eqid
     (fsteq k215UnpairAt2695CodeStep) (sndeq k215UnpairAt2695CodeStep) eqid eqid))) k215UnpairAt2695Claim_at));
theorem k215UnpairAt2695Claim_all (n c: nat): $ k215UnpairAt2695Claim n c $ =
 (named @ induct '(ind) 'n '(ax_gen (ax_gen k215UnpairAt2695RunZero)) '(iald @ iald k215UnpairAt2695RunInductive));
pub theorem k215UnpairMacro2695 (n a b c: nat): $ k215PReach (k215UnpairAt2695State k215PNum2695 a b n c) (k215UnpairAt2695State k215PNum2703 (fst ((a, b) + n)) (snd ((a, b) + n)) 0 c) $ =
 '(ax_mp k215UnpairAt2695Claim_at k215UnpairAt2695Claim_all);
pub theorem k215UnpairMacro2695_clean (n c: nat): $ k215PReach (k215UnpairAt2695State k215PNum2695 0 0 n c) (k215UnpairAt2695State k215PNum2703 (fst n) (snd n) 0 c) $ =
 '(mpbi (k215PReacheq2 (k215UnpairAt2695Stateeq eqid
   (fsteq (eqtr (addeq1 pr0) add01))
   (sndeq (eqtr (addeq1 pr0) add01)) eqid eqid)) k215UnpairMacro2695);


