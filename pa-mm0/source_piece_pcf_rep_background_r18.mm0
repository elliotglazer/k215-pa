import "source_piece_pcf_rep_neq_r12.mm0";

import "source_piece_pcf_rep_r16_kernel_empty_unique.mm0";

import "source_piece_pcf_rep_r16_kernel_successor_unique.mm0";

import "source_piece_pcf_rep_r16_kernel_successor_lift.mm0";

import "source_piece_pcf_rep_r16_kernel_no_self.mm0";

theorem sfPieceEquality_background:
 $ sfContextSub sfFormulaEqualityContext sfLBackground $;

theorem sfPieceNumeral_unique(G k x y:nat)(hg:$ sfContextWf G $)(hb:$ sfContextSub sfLBackground G $)(hx:$ (nsLocal G (sfPieceNumeral k x)) $)(hy:$ (nsLocal G (sfPieceNumeral k y)) $):
 $ (nsLocal G (sfEq x y)) $;

theorem sfPieceNumeral_lt(G k l x y:nat)(hg:$ sfContextWf G $)(hb:$ sfContextSub sfLBackground G $)(hlt:$ k < l $)(hx:$ (nsLocal G (sfPieceNumeral k x)) $)(hy:$ (nsLocal G (sfPieceNumeral l y)) $):
 $ (nsLocal G (sfMem x y)) $;

theorem sfPieceNumeral_neq(G k l x y:nat)(hg:$ sfContextWf G $)(hb:$ sfContextSub sfLBackground G $)(hne:$ k != l $)(hx:$ (nsLocal G (sfPieceNumeral k x)) $)(hy:$ (nsLocal G (sfPieceNumeral l y)) $):
 $ (nsLocal G (sfImp (sfEq x y) sfBot)) $;
