theorem k215BinaryUnpairInAt1900 (u t w c a b v: nat): $ (k215UnpairAt1900State k215PNum1900 0 0 w (k215PVector u t w c a b 0 0 v)) = (k215PState k215PNum1900 (k215PVector u t w c a b 0 0 v)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector eqid k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryUnpairOutAt1900 (u t w c a b v: nat): $ (k215UnpairAt1900State k215PNum1908 (fst w) (snd w) 0 (k215PVector u t w c a b 0 0 v)) = (k215PState k215PNum1908 (k215PVector u t 0 c a b (fst w) (snd w) v)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector k215PR1_vector eqid k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryUnpairAt1900 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum1900 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum1908 (k215PVector u t 0 c a b (fst w) (snd w) v)) $ =
 '(mpbi (k215PReacheq k215BinaryUnpairInAt1900 k215BinaryUnpairOutAt1900) k215UnpairMacro1900_clean);

theorem k215BinaryRestoreStackAt1900 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum1908 (k215PVector u t 0 c a b (fst w) (snd w) v)) (k215PState k215PNum1911 (k215PVector u t (snd w) c a b (fst w) 0 v)) $ =
 '(k215PReach_intro (eqtr k215Loop1908Vector (k215PStateeq2 (k215PVectoreq3 add0))));

theorem k215BinaryPairInAt1900 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt1911State k215PNum1911 a6 a1 a7 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum1911 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryPairOutAt1900 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat): $ (k215PairAt1911State k215PNum1921 0 0 (a7 + (a6, a1)) (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) = (k215PState k215PNum1921 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ = '(k215PStateeq2 (k215PVectoreq k215PR0_vector eqid k215PR2_vector k215PR3_vector k215PR4_vector k215PR5_vector eqid eqid k215PR8_vector));

theorem k215BinaryPairAt1900 (a0 a1 a2 a3 a4 a5 a6 a7 a8: nat):
 $ k215PReach (k215PState k215PNum1911 (k215PVector a0 a1 a2 a3 a4 a5 a6 a7 a8)) (k215PState k215PNum1921 (k215PVector a0 0 a2 a3 a4 a5 0 (a7 + (a6, a1)) a8)) $ =
 '(mpbi (k215PReacheq k215BinaryPairInAt1900 k215BinaryPairOutAt1900) k215PairMacro1911);

theorem k215BinaryPairCleanAt1900 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum1911 (k215PVector u t (snd w) c a b (fst w) 0 v)) (k215PState k215PNum1921 (k215PVector u 0 (snd w) c a b 0 (fst w, t) v)) $ =
 '(mpbi (k215PReacheq2 (k215PStateeq2 (k215PVectoreq8 add01))) k215BinaryPairAt1900);
theorem k215BinaryFourAt1900 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum1921 (k215PVector u 0 (snd w) c a b 0 (fst w, t) v)) (k215PState k215PNum1927 (k215PVector u (4 * (fst w, t)) (snd w) c a b 0 0 v)) $ =
 '(k215PReach_intro (eqtr k215Loop1921Vector (k215PStateeq2 (k215PVectoreq2 add0))));

theorem k215BinaryTag0At1900 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum1927 (k215PVector u (4 * (fst w, t)) (snd w) c a b 0 0 v)) (k215PState k215PNum1928 (k215PVector u (suc (4 * (fst w, t))) (snd w) c a b 0 0 v)) $ =
 '(k215PReach_step (eqtr (k215PAtCI k215PLookupTags1900_1927)
   (k215PStateeq2 (eqtr (k215PSeteq2 (suceq k215PGet1_vector)) k215PSet1_vector))));

theorem k215BinaryTagAllAt1900 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum1927 (k215PVector u (4 * (fst w, t)) (snd w) c a b 0 0 v)) (k215PState k215PNum1928 (k215PVector u (kMem (fst w) t) (snd w) c a b 0 0 v)) $ = '(mpbi (k215PReacheq2 (k215PStateeq2 (k215PVectoreq2 (eqcom (eqtr addS (suceq add0)))))) k215BinaryTag0At1900);

pub theorem k215BinaryConstructor1900 (u t w c a b v: nat):
 $ k215PReach (k215PState k215PNum1900 (k215PVector u t w c a b 0 0 v)) (k215PState k215PNum1928 (k215PVector u (kMem (fst w) t) (snd w) c a b 0 0 v)) $ = '(ax_mp (ax_mp k215PReach_trans k215BinaryUnpairAt1900) (ax_mp (ax_mp k215PReach_trans k215BinaryRestoreStackAt1900) (ax_mp (ax_mp k215PReach_trans k215BinaryPairCleanAt1900) (ax_mp (ax_mp k215PReach_trans k215BinaryFourAt1900) k215BinaryTagAllAt1900))));

