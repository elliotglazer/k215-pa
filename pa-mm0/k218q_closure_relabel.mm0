import "k218q_equivalence.mm0";
import "k218q_alpha.mm0";
import "k218_role_substitution.mm0";
import "quotation_binders_absent.mm0";
import "k230_fresh_allocation.mm0";
import "k218_seed_normalize.mm0";

def k218ClosurePhase0 (E: set) (n B a b c u v p w x y f: nat): nat =
 $ (kAll b (kImp (kMem b c) (kExists a (kAnd (sfNamedTemplate (sqEnvCons b (sqEnvCons a E)) B 0 f) (kAll a (kImp (kAll c (kImp (kMem c a) (kMem c b))) (kAll b (kImp (sfNamedTemplate (sqEnvCons b (sqEnvCons a E)) B 0 f) (kExists b (kAnd (sfNamedTemplate (sqEnvCons b (sqEnvCons a E)) B 0 f) (kMem b c))))))))))) $;

def k218ClosureAlphaBody0 (E: set) (n B a b c u v p w x y f: nat): nat =
 $ (kAnd (sfNamedTemplate (sqEnvCons b (sqEnvCons a E)) B 0 f) (kMem b c)) $;

def k218ClosurePhase1 (E: set) (n B a b c u v p w x y f: nat): nat =
 $ (kAll b (kImp (kMem b c) (kExists a (kAnd (sfNamedTemplate (sqEnvCons b (sqEnvCons a E)) B 0 f) (kAll a (kImp (kAll c (kImp (kMem c a) (kMem c b))) (kAll b (kImp (sfNamedTemplate (sqEnvCons b (sqEnvCons a E)) B 0 f) (kExists y (kAnd (sfNamedTemplate (sqEnvCons y (sqEnvCons a E)) B 0 f) (kMem y c))))))))))) $;

def k218ClosureAlphaBody1 (E: set) (n B a b c u v p w x y f: nat): nat =
 $ (kImp (sfNamedTemplate (sqEnvCons b (sqEnvCons a E)) B 0 f) (kExists y (kAnd (sfNamedTemplate (sqEnvCons y (sqEnvCons a E)) B 0 f) (kMem y c)))) $;

def k218ClosurePhase2 (E: set) (n B a b c u v p w x y f: nat): nat =
 $ (kAll b (kImp (kMem b c) (kExists a (kAnd (sfNamedTemplate (sqEnvCons b (sqEnvCons a E)) B 0 f) (kAll a (kImp (kAll c (kImp (kMem c a) (kMem c b))) (kAll x (kImp (sfNamedTemplate (sqEnvCons x (sqEnvCons a E)) B 0 f) (kExists y (kAnd (sfNamedTemplate (sqEnvCons y (sqEnvCons a E)) B 0 f) (kMem y c))))))))))) $;

def k218ClosureAlphaBody2 (E: set) (n B a b c u v p w x y f: nat): nat =
 $ (kImp (kMem c a) (kMem c b)) $;

def k218ClosurePhase3 (E: set) (n B a b c u v p w x y f: nat): nat =
 $ (kAll b (kImp (kMem b c) (kExists a (kAnd (sfNamedTemplate (sqEnvCons b (sqEnvCons a E)) B 0 f) (kAll a (kImp (kAll w (kImp (kMem w a) (kMem w b))) (kAll x (kImp (sfNamedTemplate (sqEnvCons x (sqEnvCons a E)) B 0 f) (kExists y (kAnd (sfNamedTemplate (sqEnvCons y (sqEnvCons a E)) B 0 f) (kMem y c))))))))))) $;

def k218ClosureAlphaBody3 (E: set) (n B a b c u v p w x y f: nat): nat =
 $ (kImp (kAll w (kImp (kMem w a) (kMem w b))) (kAll x (kImp (sfNamedTemplate (sqEnvCons x (sqEnvCons a E)) B 0 f) (kExists y (kAnd (sfNamedTemplate (sqEnvCons y (sqEnvCons a E)) B 0 f) (kMem y c)))))) $;

def k218ClosurePhase4 (E: set) (n B a b c u v p w x y f: nat): nat =
 $ (kAll b (kImp (kMem b c) (kExists a (kAnd (sfNamedTemplate (sqEnvCons b (sqEnvCons a E)) B 0 f) (kAll p (kImp (kAll w (kImp (kMem w p) (kMem w b))) (kAll x (kImp (sfNamedTemplate (sqEnvCons x (sqEnvCons p E)) B 0 f) (kExists y (kAnd (sfNamedTemplate (sqEnvCons y (sqEnvCons p E)) B 0 f) (kMem y c))))))))))) $;

def k218ClosureAlphaBody4 (E: set) (n B a b c u v p w x y f: nat): nat =
 $ (kAnd (sfNamedTemplate (sqEnvCons b (sqEnvCons a E)) B 0 f) (kAll p (kImp (kAll w (kImp (kMem w p) (kMem w b))) (kAll x (kImp (sfNamedTemplate (sqEnvCons x (sqEnvCons p E)) B 0 f) (kExists y (kAnd (sfNamedTemplate (sqEnvCons y (sqEnvCons p E)) B 0 f) (kMem y c)))))))) $;

def k218ClosurePhase5 (E: set) (n B a b c u v p w x y f: nat): nat =
 $ (kAll b (kImp (kMem b c) (kExists v (kAnd (sfNamedTemplate (sqEnvCons b (sqEnvCons v E)) B 0 f) (kAll p (kImp (kAll w (kImp (kMem w p) (kMem w b))) (kAll x (kImp (sfNamedTemplate (sqEnvCons x (sqEnvCons p E)) B 0 f) (kExists y (kAnd (sfNamedTemplate (sqEnvCons y (sqEnvCons p E)) B 0 f) (kMem y c))))))))))) $;

def k218ClosureAlphaBody5 (E: set) (n B a b c u v p w x y f: nat): nat =
 $ (kImp (kMem b c) (kExists v (kAnd (sfNamedTemplate (sqEnvCons b (sqEnvCons v E)) B 0 f) (kAll p (kImp (kAll w (kImp (kMem w p) (kMem w b))) (kAll x (kImp (sfNamedTemplate (sqEnvCons x (sqEnvCons p E)) B 0 f) (kExists y (kAnd (sfNamedTemplate (sqEnvCons y (sqEnvCons p E)) B 0 f) (kMem y c)))))))))) $;

def k218ClosureSeparated (E: set) (n B a b c u v p w x y f: nat): nat =
 $ (kAll u (kImp (kMem u c) (kExists v (kAnd (sfNamedTemplate (sqEnvCons u (sqEnvCons v E)) B 0 f) (kAll p (kImp (kAll w (kImp (kMem w p) (kMem w u))) (kAll x (kImp (sfNamedTemplate (sqEnvCons x (sqEnvCons p E)) B 0 f) (kExists y (kAnd (sfNamedTemplate (sqEnvCons y (sqEnvCons p E)) B 0 f) (kMem y c))))))))))) $;

theorem k218QClosure_relabel (E: set) (n B a b c u v p w x y f: nat)
 (ha0: $ 0 < a $)
 (ho0: $ a < b $)
 (ho1: $ b < c $)
 (ho2: $ c < y $)
 (ho3: $ y < x $)
 (ho4: $ x < w $)
 (ho5: $ w < p $)
 (ho6: $ p < v $)
 (ho7: $ v < u $)
 (haB: $ a < B $) (hbB: $ b < B $)
 (heA: $ sqEnvAvoid E n a $) (heB: $ sqEnvAvoid E n b $)
 (hf: $ sfBound (suc (suc n)) f $)
 (hf0: $ kFresh (k218ClosureAlphaBody0 E n B a b c u v p w x y f) y $)
 (hf1: $ kFresh (k218ClosureAlphaBody1 E n B a b c u v p w x y f) x $)
 (hf2: $ kFresh (k218ClosureAlphaBody2 E n B a b c u v p w x y f) w $)
 (hf3: $ kFresh (k218ClosureAlphaBody3 E n B a b c u v p w x y f) p $)
 (hf4: $ kFresh (k218ClosureAlphaBody4 E n B a b c u v p w x y f) v $)
 (hf5: $ kFresh (k218ClosureAlphaBody5 E n B a b c u v p w x y f) u $):
 $ k218IEquivalent
   (k218Closure a b c (sfNamedTemplate (sqEnvCons b (sqEnvCons a E)) B 0 f))
   (k218ClosureSeparated E n B a b c u v p w x y f) $;

def k218ClosureChosen_y (E: set) (B a b c f: nat): nat =
 $ kFreshAllocate 0 (kAnd (sfNamedTemplate (sqEnvCons b (sqEnvCons a E)) B 0 f) (kMem b c)) 0 (c + (B + suc f)) $;

def k218ClosureChosen_x (E: set) (B a b c f: nat): nat =
 $ kFreshAllocate 0 (kImp (sfNamedTemplate (sqEnvCons b (sqEnvCons a E)) B 0 f) (kExists (k218ClosureChosen_y E B a b c f) (kAnd (sfNamedTemplate (sqEnvCons (k218ClosureChosen_y E B a b c f) (sqEnvCons a E)) B 0 f) (kMem (k218ClosureChosen_y E B a b c f) c)))) 0 (k218ClosureChosen_y E B a b c f) $;

def k218ClosureChosen_w (E: set) (B a b c f: nat): nat =
 $ kFreshAllocate 0 (kImp (kMem c a) (kMem c b)) 0 (k218ClosureChosen_x E B a b c f) $;

def k218ClosureChosen_p (E: set) (B a b c f: nat): nat =
 $ kFreshAllocate 0 (kImp (kAll (k218ClosureChosen_w E B a b c f) (kImp (kMem (k218ClosureChosen_w E B a b c f) a) (kMem (k218ClosureChosen_w E B a b c f) b))) (kAll (k218ClosureChosen_x E B a b c f) (kImp (sfNamedTemplate (sqEnvCons (k218ClosureChosen_x E B a b c f) (sqEnvCons a E)) B 0 f) (kExists (k218ClosureChosen_y E B a b c f) (kAnd (sfNamedTemplate (sqEnvCons (k218ClosureChosen_y E B a b c f) (sqEnvCons a E)) B 0 f) (kMem (k218ClosureChosen_y E B a b c f) c)))))) 0 (k218ClosureChosen_w E B a b c f) $;

def k218ClosureChosen_v (E: set) (B a b c f: nat): nat =
 $ kFreshAllocate 0 (kAnd (sfNamedTemplate (sqEnvCons b (sqEnvCons a E)) B 0 f) (kAll (k218ClosureChosen_p E B a b c f) (kImp (kAll (k218ClosureChosen_w E B a b c f) (kImp (kMem (k218ClosureChosen_w E B a b c f) (k218ClosureChosen_p E B a b c f)) (kMem (k218ClosureChosen_w E B a b c f) b))) (kAll (k218ClosureChosen_x E B a b c f) (kImp (sfNamedTemplate (sqEnvCons (k218ClosureChosen_x E B a b c f) (sqEnvCons (k218ClosureChosen_p E B a b c f) E)) B 0 f) (kExists (k218ClosureChosen_y E B a b c f) (kAnd (sfNamedTemplate (sqEnvCons (k218ClosureChosen_y E B a b c f) (sqEnvCons (k218ClosureChosen_p E B a b c f) E)) B 0 f) (kMem (k218ClosureChosen_y E B a b c f) c)))))))) 0 (k218ClosureChosen_p E B a b c f) $;

def k218ClosureChosen_u (E: set) (B a b c f: nat): nat =
 $ kFreshAllocate 0 (kImp (kMem b c) (kExists (k218ClosureChosen_v E B a b c f) (kAnd (sfNamedTemplate (sqEnvCons b (sqEnvCons (k218ClosureChosen_v E B a b c f) E)) B 0 f) (kAll (k218ClosureChosen_p E B a b c f) (kImp (kAll (k218ClosureChosen_w E B a b c f) (kImp (kMem (k218ClosureChosen_w E B a b c f) (k218ClosureChosen_p E B a b c f)) (kMem (k218ClosureChosen_w E B a b c f) b))) (kAll (k218ClosureChosen_x E B a b c f) (kImp (sfNamedTemplate (sqEnvCons (k218ClosureChosen_x E B a b c f) (sqEnvCons (k218ClosureChosen_p E B a b c f) E)) B 0 f) (kExists (k218ClosureChosen_y E B a b c f) (kAnd (sfNamedTemplate (sqEnvCons (k218ClosureChosen_y E B a b c f) (sqEnvCons (k218ClosureChosen_p E B a b c f) E)) B 0 f) (kMem (k218ClosureChosen_y E B a b c f) c)))))))))) 0 (k218ClosureChosen_v E B a b c f) $;

theorem k218ClosureChosen_range (E: set) (B a b c f: nat):
 $ B + suc f < (k218ClosureChosen_y E B a b c f) $;

theorem k218QClosure_separate (E: set) (n B a b c f: nat)
 (ha0: $ 0 < a $) (hab: $ a < b $) (hbc: $ b < c $)
 (haB: $ a < B $) (hbB: $ b < B $)
 (heA: $ sqEnvAvoid E n a $) (heB: $ sqEnvAvoid E n b $)
 (hf: $ sfBound (suc (suc n)) f $):
 $ k218IEquivalent
   (k218Closure a b c (sfNamedTemplate (sqEnvCons b (sqEnvCons a E)) B 0 f))
   (k218ClosureSeparated E n B a b c (k218ClosureChosen_u E B a b c f) (k218ClosureChosen_v E B a b c f) (k218ClosureChosen_p E B a b c f) (k218ClosureChosen_w E B a b c f) (k218ClosureChosen_x E B a b c f) (k218ClosureChosen_y E B a b c f) f) $;
