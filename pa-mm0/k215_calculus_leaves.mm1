 $ k215EnumIter (suc (suc (suc 10)))
   (k218EnumState (suc (k215CmdAX c b a (k215NipPrefix 8 (suc (k215CmdDROP (k215NipPrefix 3 r)))))) np 0 w 0 0) =
   suc (k218EnumState r np (kRho8 a b c 0) w 0 0) $ =
'(eqtr (k215Iter_after_step k215Leaf_AXstep) (eqtr (k215Iter_after_step (k215StepNips_pair (necom d1ne0))) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step k215Leaf_DROPstep) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Leaf_gate_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_All_neone)) (eqtr k215EnumIter_zero (suceq (k218EnumStateeq k215NipPrefix_zero eqid eqid eqid eqid eqid))))))))))))))));

@_ def k215LeafTime: nat = $ (suc (suc (suc 10))) + (suc (suc 10)) $;
@_ def k215BundleLeafTime: nat = $ (suc 10) + (suc (suc 10)) $;

pub theorem k215LeafR1_run (a b c r np t w: nat):
 $ k215EnumIter k215LeafTime (k218EnumState (suc (k215LeafPrefix 1 a b c r)) np t w 0 0) =
   suc (k218EnumState r np (kRho1 a b) w 0 0) $ =
'(eqtr (k215Leaf_after_run k215Discard_run)
  (eqtr (k215EnumItereq2 (k218EnumStateeq (suceq (k215CmdAXeq4 k215LeafTail_1))
    eqid eqid eqid eqid eqid)) k215LeafCore_1));

pub theorem k215LeafR1_run_first (a b c r t w: nat):
 $ k215EnumIter k215LeafTime (k218EnumState 0 (k215LeafPrefix 1 a b c r) t w 0 0) =
   suc (k218EnumState r (suc (k215LeafPrefix 1 a b c r)) (kRho1 a b) w 0 0) $ =
'(eqtr (k215Leaf_after_run k215Discard_run_first)
  (eqtr (k215EnumItereq2 (k218EnumStateeq (suceq (k215CmdAXeq4 k215LeafTail_1))
    eqid eqid eqid eqid eqid)) k215LeafCore_1));

