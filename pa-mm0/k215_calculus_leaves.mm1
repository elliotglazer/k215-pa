pub theorem k215LeafG_run_first (a b c r t w: nat):
 $ k215EnumIter k215LeafTime (k218EnumState 0 (k215LeafPrefix 7 a b c r) t w 0 0) =
   suc (k218EnumState r (suc (k215LeafPrefix 7 a b c r)) (k218RhoG a b c) w 0 0) $ =
'(eqtr (k215Leaf_after_run k215Discard_run_first)
  (eqtr (k215EnumItereq2 (k218EnumStateeq (suceq (k215CmdAXeq4 k215LeafTail_7))
    eqid eqid eqid eqid eqid)) k215LeafCore_7));

