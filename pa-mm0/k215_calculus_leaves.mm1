theorem k215BundleLeafCore (a b c r np w: nat):
 $ k215EnumIter (suc 10)
   (k218EnumState (suc (k215CmdAX c b a (k215NipPrefix 10 r))) np 0 w 0 0) =
   suc (k218EnumState r np (k218Gate a b c) w 0 0) $ =
'(eqtr (k215Iter_after_step k215Leaf_AXstep) (eqtr (k215Iter_after_step (k215StepNips_pair (necom d1ne0))) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_All_neone)) (eqtr k215EnumIter_zero (suceq (k218EnumStateeq k215NipPrefix_zero eqid eqid eqid eqid eqid))))))))))))));

pub theorem k215BundleLeaf_run (a b c r np t w: nat):
 $ k215EnumIter k215BundleLeafTime (k218EnumState (suc (k215BundleLeafPrefix a b c r)) np t w 0 0) =
   suc (k218EnumState r np (k218Gate a b c) w 0 0) $ =
'(eqtr (k215Leaf_after_run k215Discard_run) k215BundleLeafCore);
pub theorem k215BundleLeaf_enabled_run (a b c r np t w: nat):
 $ c != a /\ c != b ->
   k215EnumIter k215BundleLeafTime (k218EnumState (suc (k215BundleLeafPrefix a b c r)) np t w 0 0) =
   suc (k218EnumState r np (k218Bundle a b c) w 0 0) $ =
'(eqtrd (a1i k215BundleLeaf_run)
  (suceqd (k218EnumStateeqd eqidd eqidd k218Gate_enabled eqidd eqidd eqidd)));

