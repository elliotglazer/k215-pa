-- Distinct SeedG abstract search. Explicit replay, independently checked; no literal-TM correspondence is assumed.
import "k215_calculus_operational.mm1";

do (apply (register-eqd 'k218EnumState) '(k218EnumStateeqd));
do (apply (register-eqd 'k215EnumStep) '(k215EnumStepeqd));
do (apply (register-eqd 'k215EnumAdvance) '(k215EnumAdvanceeqd));
do (apply (register-eqd 'k215EnumIter) '(k215EnumItereqd));
do (apply (register-eqd 'k215CmdAX) '(k215CmdAXeqd));
do (apply (register-eqd 'k215CmdDROP) '(k215CmdDROPeqd));
do (apply (register-eqd 'k215NipPrefix) '(k215NipPrefixeqd));
do (apply (register-eqd 'k215DiscardPrefix) '(k215DiscardPrefixeqd));

-- Source leaf = DISCARD ; AX ; NIP^j ; DROP ; NIP^(11-j).
@_ def k215LeafTail (j r: nat): nat =
 $ k215NipPrefix j (suc (k215CmdDROP (k215NipPrefix ((suc 10) - j) r))) $;
@_ def k215LeafPrefix (j a b c r: nat): nat =
 $ k215DiscardPrefix (suc (k215CmdAX c b a (k215LeafTail j r))) $;
@_ def k215BundleLeafPrefix (a b c r: nat): nat =
 $ k215DiscardPrefix (suc (k215CmdAX c b a (k215NipPrefix 10 r))) $;

theorem k215Leaf_after_run (m n s t: nat) (h: $ k215EnumIter n s = suc t $):
 $ k215EnumIter (m + n) s = k215EnumIter m t $ =
(named @ induct '(ind) 'm
 '(eqtr (k215EnumItereq1 add01) (eqtr h (eqcom k215EnumIter_zero)))
 '(eqtrd (a1i (k215EnumItereq1 addS1))
   (eqtrd (a1i k215EnumIter_succ)
     (eqtrd (k215EnumAdvanceeqd id) (a1i (eqcom k215EnumIter_succ))))));

theorem k215Leaf_gate_neone (a b c: nat): $ k218Gate a b c != 1 $ =
'(cases
  (mpbiri (necom d1ne0) (noteqd (eqeq1d ifpos)))
  (mpbiri k215Command_Imp_neone (noteqd (eqeq1d ifneg))));

theorem k215Leaf_AXstep (a b c r np w: nat):
 $ k215EnumStep (k218EnumState (suc (k215CmdAX c b a r)) np 0 w 0 0) =
   suc (k218EnumState r np (k218Gate a b c) (k215AxStack a 0 b c 0 0 w) 0 0) $ =
'(eqtr k215StepAX_continue
  (suceq (k218EnumStateeq eqid eqid (k218Gateeq add01 add01 eqid)
    (k215AxStackeq add01 eqid add01 eqid eqid eqid eqid) eqid eqid)));

theorem k215Leaf_DROPstep (r np t w d h: nat):
 $ k215EnumStep (k218EnumState (k215NipPrefix 0 (suc (k215CmdDROP r))) np t w d h) =
   suc (k218EnumState r np h (t, w) d h) $ =
'(eqtr (k215EnumStepeq (k218EnumStateeq k215NipPrefix_zero eqid eqid eqid eqid eqid))
  k215StepDROP_continue);

theorem k215LeafTail_1 (r: nat):
 $ k215LeafTail 1 r = k215NipPrefix 1 (suc (k215CmdDROP (k215NipPrefix 10 r))) $ =
'(k215NipPrefixeq2 (suceq (k215CmdDROPeq (k215NipPrefixeq1 (eqtr subSS sub02)))));

theorem k215LeafCore_1 (a b c r np w: nat):
 $ k215EnumIter (suc (suc (suc 10)))
   (k218EnumState (suc (k215CmdAX c b a (k215NipPrefix 1 (suc (k215CmdDROP (k215NipPrefix 10 r)))))) np 0 w 0 0) =
   suc (k218EnumState r np (kRho1 a b) w 0 0) $ =
'(eqtr (k215Iter_after_step k215Leaf_AXstep) (eqtr (k215Iter_after_step (k215StepNips_pair (necom d1ne0))) (eqtr (k215Iter_after_step k215Leaf_DROPstep) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Leaf_gate_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_All_neone)) (eqtr k215EnumIter_zero (suceq (k218EnumStateeq k215NipPrefix_zero eqid eqid eqid eqid eqid))))))))))))))));

theorem k215LeafTail_2 (r: nat):
 $ k215LeafTail 2 r = k215NipPrefix 2 (suc (k215CmdDROP (k215NipPrefix 9 r))) $ =
'(k215NipPrefixeq2 (suceq (k215CmdDROPeq (k215NipPrefixeq1 (eqtr subSS (eqtr subSS sub02))))));

theorem k215LeafCore_2 (a b c r np w: nat):
 $ k215EnumIter (suc (suc (suc 10)))
   (k218EnumState (suc (k215CmdAX c b a (k215NipPrefix 2 (suc (k215CmdDROP (k215NipPrefix 9 r)))))) np 0 w 0 0) =
   suc (k218EnumState r np (kRho2 a b c) w 0 0) $ =
'(eqtr (k215Iter_after_step k215Leaf_AXstep) (eqtr (k215Iter_after_step (k215StepNips_pair (necom d1ne0))) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step k215Leaf_DROPstep) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Leaf_gate_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_All_neone)) (eqtr k215EnumIter_zero (suceq (k218EnumStateeq k215NipPrefix_zero eqid eqid eqid eqid eqid))))))))))))))));

theorem k215LeafTail_3 (r: nat):
 $ k215LeafTail 3 r = k215NipPrefix 3 (suc (k215CmdDROP (k215NipPrefix 8 r))) $ =
'(k215NipPrefixeq2 (suceq (k215CmdDROPeq (k215NipPrefixeq1 (eqtr subSS (eqtr subSS (eqtr subSS sub02)))))));

theorem k215LeafCore_3 (a b c r np w: nat):
 $ k215EnumIter (suc (suc (suc 10)))
   (k218EnumState (suc (k215CmdAX c b a (k215NipPrefix 3 (suc (k215CmdDROP (k215NipPrefix 8 r)))))) np 0 w 0 0) =
   suc (k218EnumState r np (kRho3 a b c) w 0 0) $ =
'(eqtr (k215Iter_after_step k215Leaf_AXstep) (eqtr (k215Iter_after_step (k215StepNips_pair (necom d1ne0))) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step k215Leaf_DROPstep) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Leaf_gate_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_Imp_neone)) (eqtr (k215Iter_after_step (k215StepNips_pair k215Command_All_neone)) (eqtr k215EnumIter_zero (suceq (k218EnumStateeq k215NipPrefix_zero eqid eqid eqid eqid eqid))))))))))))))));

