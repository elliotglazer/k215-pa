 '(eqtr sfSubst_sfAll (nsAll_eq (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepLookup_subst (sfPieceRepLookup_eq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor)) (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor)) (eqtr sfSubstIndex_lift (suceq sfSubstIndex_zero)))) (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepLookup_subst (sfPieceRepLookup_eq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor)) (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor)) (ax_mp sfSubstIndex_bound lt01S))) (eqtr sfSubst_sfAnd (nsAnd_eq (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepEqualTest_subst (sfPieceRepEqualTest_eq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor)) (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor)) (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor)))) (eqtr sfSubst_sfEq (nsEq_eq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_zero)) (ax_mp sfSubstIndex_bound lt01S))))) (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfSubst_sfEq (nsEq_eq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_zero)) (ax_mp sfSubstIndex_bound lt01S))) (eqtr sfPieceRepEqualTest_subst (sfPieceRepEqualTest_eq (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor)) (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor)) (eqtr sfSubstIndex_lift (suceq sfSubstIndex_successor))))))))))))));

theorem pcra_equal_inst3(G e x y a:nat):
 $ (nsLocal G sfPieceRepEqualLookupLaw) -> (nsLocal G (sfAll (sfImp (sfPieceRepLookup (suc e) (suc x) (suc a)) (sfImp (sfPieceRepLookup (suc e) (suc y) 0) (sfAnd (sfImp (sfPieceRepEqualTest (suc x) (suc y) (suc e)) (sfEq (suc a) 0)) (sfImp (sfEq (suc a) 0) (sfPieceRepEqualTest (suc x) (suc y) (suc e)))))))) $ =
 '(syl (syl (bi1 (nsLocal_formula_eq pcra_equal_open3)) nsLocal_AllE) pcra_equal_inst2);

theorem pcra_equal_open4(e x y a b:nat):
 $ sfSubst 0 b (sfImp (sfPieceRepLookup (suc e) (suc x) (suc a)) (sfImp (sfPieceRepLookup (suc e) (suc y) 0) (sfAnd (sfImp (sfPieceRepEqualTest (suc x) (suc y) (suc e)) (sfEq (suc a) 0)) (sfImp (sfEq (suc a) 0) (sfPieceRepEqualTest (suc x) (suc y) (suc e)))))) = (sfImp (sfPieceRepLookup e x a) (sfImp (sfPieceRepLookup e y b) (sfAnd (sfImp (sfPieceRepEqualTest x y e) (sfEq a b)) (sfImp (sfEq a b) (sfPieceRepEqualTest x y e))))) $ =
 '(eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepLookup_subst (sfPieceRepLookup_eq sfSubstIndex_successor sfSubstIndex_successor sfSubstIndex_successor)) (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepLookup_subst (sfPieceRepLookup_eq sfSubstIndex_successor sfSubstIndex_successor sfSubstIndex_zero)) (eqtr sfSubst_sfAnd (nsAnd_eq (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfPieceRepEqualTest_subst (sfPieceRepEqualTest_eq sfSubstIndex_successor sfSubstIndex_successor sfSubstIndex_successor)) (eqtr sfSubst_sfEq (nsEq_eq sfSubstIndex_successor sfSubstIndex_zero)))) (eqtr sfSubst_sfImp (nsImp_eq (eqtr sfSubst_sfEq (nsEq_eq sfSubstIndex_successor sfSubstIndex_zero)) (eqtr sfPieceRepEqualTest_subst (sfPieceRepEqualTest_eq sfSubstIndex_successor sfSubstIndex_successor sfSubstIndex_successor))))))))));

theorem pcra_equal_inst4(G e x y a b:nat):
 $ (nsLocal G sfPieceRepEqualLookupLaw) -> (nsLocal G (sfImp (sfPieceRepLookup e x a) (sfImp (sfPieceRepLookup e y b) (sfAnd (sfImp (sfPieceRepEqualTest x y e) (sfEq a b)) (sfImp (sfEq a b) (sfPieceRepEqualTest x y e)))))) $ =
 '(syl (syl (bi1 (nsLocal_formula_eq pcra_equal_open4)) nsLocal_AllE) pcra_equal_inst3);

pub theorem sfPieceRepEqualLookup_use(G e x y a b:nat):
 $ (nsLocal G sfPieceRepEqualLookupLaw) -> (nsLocal G (sfPieceRepLookup e x a)) -> (nsLocal G (sfPieceRepLookup e y b)) -> (nsLocal G (sfAnd (sfImp (sfPieceRepEqualTest x y e) (sfEq a b)) (sfImp (sfEq a b) (sfPieceRepEqualTest x y e)))) $ =
 '(syl (syl6 nsLocal_mp nsLocal_mp) pcra_equal_inst4);

pub theorem sfPieceEnv_equal_test_from_laws(T:set)(G n i j e x y:nat)(hq:$ sfContextSub sfFormulaEqualityContext G $)(hl:$ nsLocal G sfPieceRepLookupLaws $)(ha:$ nsLocal G sfPieceRepEqualLookupLaw $)(hi:$ i < n $)(hj:$ j < n $)(he:$ nsLocal G (sfPieceEnv T n e) $)(hx:$ nsLocal G (sfPieceNumeral (n - 1 - i) x) $)(hy:$ nsLocal G (sfPieceNumeral (n - 1 - j) y) $):
 $ (nsLocal G (sfPieceRepIff (sfPieceRepEqualTest x y e) (sfEq (T @ i) (T @ j)))) $ =
 '(ax_mp (ax_mp (ax_mp sfPieceRepEqualLookup_use ha) (sfPieceEnv_lookup_all_from_laws hq hl hi he hx)) (sfPieceEnv_lookup_all_from_laws hq hl hj he hy));
