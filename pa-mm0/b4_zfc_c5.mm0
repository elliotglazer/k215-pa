import "b4_zfc_c4.mm0";

theorem ND_Ctx (m v i gg aa: nat): $ bdHas m v i bdtIn aa gg 0 0 -> bdNDBase m v i (sfSequent gg aa) $;
theorem RI_V_Ctx (m v B i gg aa ll: nat): $ bdHas m v i bdtValid ll 0 0 0 /\ bdHas m v i bdtRow (sfSequent gg aa) 0 0 0 /\ bdHas m v i bdtIn aa gg 0 0 -> bdRValid m v B i ((sfSequent gg aa) : ll) $;
theorem ND_Pc (m v i gg aa bb: nat): $ bdNDBase m v i (sfSequent gg (sfImp (sfImp (sfImp aa bb) aa) aa)) $;
theorem RI_V_Pc (m v B i gg aa bb ll: nat): $ bdHas m v i bdtValid ll 0 0 0 /\ bdHas m v i bdtRow (sfSequent gg (sfImp (sfImp (sfImp aa bb) aa) aa)) 0 0 0 -> bdRValid m v B i ((sfSequent gg (sfImp (sfImp (sfImp aa bb) aa) aa)) : ll) $;
theorem ND_II (m v i gg aa bb: nat): $ bdNDProp1 m v i (sfSequent gg (sfImp aa bb)) (sfSequent (aa : gg) bb) $;
theorem RI_V_II (m v B i gg aa bb ll: nat): $ (sfSequent (aa : gg) bb) <= ll /\ bdHas m v i bdtIn (sfSequent (aa : gg) bb) ll 0 0 /\ bdHas m v i bdtValid ll 0 0 0 /\ bdHas m v i bdtRow (sfSequent gg (sfImp aa bb)) 0 0 0 -> bdRValid m v B i ((sfSequent gg (sfImp aa bb)) : ll) $;
theorem ND_Exp (m v i gg aa: nat): $ bdNDProp1 m v i (sfSequent gg aa) (sfSequent gg 0) $;
theorem RI_V_Exp (m v B i gg aa ll: nat): $ (sfSequent gg 0) <= ll /\ bdHas m v i bdtIn (sfSequent gg 0) ll 0 0 /\ bdHas m v i bdtValid ll 0 0 0 /\ bdHas m v i bdtRow (sfSequent gg aa) 0 0 0 -> bdRValid m v B i ((sfSequent gg aa) : ll) $;
theorem ND_CE1 (m v i gg aa bb: nat): $ bdNDProp1 m v i (sfSequent gg aa) (sfSequent gg (sfAnd aa bb)) $;
theorem RI_V_CE1 (m v B i gg aa bb ll: nat): $ (sfSequent gg (sfAnd aa bb)) <= ll /\ bdHas m v i bdtIn (sfSequent gg (sfAnd aa bb)) ll 0 0 /\ bdHas m v i bdtValid ll 0 0 0 /\ bdHas m v i bdtRow (sfSequent gg aa) 0 0 0 -> bdRValid m v B i ((sfSequent gg aa) : ll) $;
theorem ND_CE2 (m v i gg aa bb: nat): $ bdNDProp1 m v i (sfSequent gg bb) (sfSequent gg (sfAnd aa bb)) $;
theorem RI_V_CE2 (m v B i gg aa bb ll: nat): $ (sfSequent gg (sfAnd aa bb)) <= ll /\ bdHas m v i bdtIn (sfSequent gg (sfAnd aa bb)) ll 0 0 /\ bdHas m v i bdtValid ll 0 0 0 /\ bdHas m v i bdtRow (sfSequent gg bb) 0 0 0 -> bdRValid m v B i ((sfSequent gg bb) : ll) $;
theorem ND_DI1 (m v i gg aa bb: nat): $ bdNDProp1 m v i (sfSequent gg (sfOr aa bb)) (sfSequent gg aa) $;
theorem RI_V_DI1 (m v B i gg aa bb ll: nat): $ (sfSequent gg aa) <= ll /\ bdHas m v i bdtIn (sfSequent gg aa) ll 0 0 /\ bdHas m v i bdtValid ll 0 0 0 /\ bdHas m v i bdtRow (sfSequent gg (sfOr aa bb)) 0 0 0 -> bdRValid m v B i ((sfSequent gg (sfOr aa bb)) : ll) $;
theorem ND_DI2 (m v i gg aa bb: nat): $ bdNDProp1 m v i (sfSequent gg (sfOr aa bb)) (sfSequent gg bb) $;
theorem RI_V_DI2 (m v B i gg aa bb ll: nat): $ (sfSequent gg bb) <= ll /\ bdHas m v i bdtIn (sfSequent gg bb) ll 0 0 /\ bdHas m v i bdtValid ll 0 0 0 /\ bdHas m v i bdtRow (sfSequent gg (sfOr aa bb)) 0 0 0 -> bdRValid m v B i ((sfSequent gg (sfOr aa bb)) : ll) $;
theorem ND_Wk (m v i gg hh aa: nat): $ bdHas m v i bdtSub gg hh 0 0 -> bdNDProp1 m v i (sfSequent hh aa) (sfSequent gg aa) $;
theorem RI_V_Wk (m v B i gg hh aa ll: nat): $ (sfSequent gg aa) <= ll /\ bdHas m v i bdtIn (sfSequent gg aa) ll 0 0 /\ bdHas m v i bdtValid ll 0 0 0 /\ bdHas m v i bdtRow (sfSequent hh aa) 0 0 0 /\ bdHas m v i bdtSub gg hh 0 0 -> bdRValid m v B i ((sfSequent hh aa) : ll) $;
theorem ND_AllI (m v B i gg aa: nat): $ bdHas m v i bdtCShift gg (sfContextShift gg) 0 0 -> bdNDQuant1 m v B i (sfSequent gg (sfAll aa)) (sfSequent (sfContextShift gg) aa) $;
theorem RI_V_AllI (m v B i gg aa ll: nat): $ (sfSequent (sfContextShift gg) aa) <= ll /\ bdHas m v i bdtIn (sfSequent (sfContextShift gg) aa) ll 0 0 /\ bdHas m v i bdtValid ll 0 0 0 /\ bdHas m v i bdtRow (sfSequent gg (sfAll aa)) 0 0 0 /\ bdHas m v i bdtCShift gg (sfContextShift gg) 0 0 -> bdRValid m v B i ((sfSequent gg (sfAll aa)) : ll) $;
theorem ND_AllE (m v B i gg aa tt: nat): $ tt <= B /\ bdHas m v i bdtSubst 0 tt aa (sfSubst 0 tt aa) -> bdNDQuant1 m v B i (sfSequent gg (sfSubst 0 tt aa)) (sfSequent gg (sfAll aa)) $;
theorem RI_V_AllE (m v B i gg aa tt ll: nat): $ (sfSequent gg (sfAll aa)) <= ll /\ tt <= B /\ bdHas m v i bdtIn (sfSequent gg (sfAll aa)) ll 0 0 /\ bdHas m v i bdtValid ll 0 0 0 /\ bdHas m v i bdtRow (sfSequent gg (sfSubst 0 tt aa)) 0 0 0 /\ bdHas m v i bdtSubst 0 tt aa (sfSubst 0 tt aa) -> bdRValid m v B i ((sfSequent gg (sfSubst 0 tt aa)) : ll) $;
theorem ND_ExI (m v B i gg aa tt: nat): $ tt <= B /\ bdHas m v i bdtSubst 0 tt aa (sfSubst 0 tt aa) -> bdNDQuant1 m v B i (sfSequent gg (sfEx aa)) (sfSequent gg (sfSubst 0 tt aa)) $;
theorem RI_V_ExI (m v B i gg aa tt ll: nat): $ (sfSequent gg (sfSubst 0 tt aa)) <= ll /\ tt <= B /\ bdHas m v i bdtIn (sfSequent gg (sfSubst 0 tt aa)) ll 0 0 /\ bdHas m v i bdtValid ll 0 0 0 /\ bdHas m v i bdtRow (sfSequent gg (sfEx aa)) 0 0 0 /\ bdHas m v i bdtSubst 0 tt aa (sfSubst 0 tt aa) -> bdRValid m v B i ((sfSequent gg (sfEx aa)) : ll) $;
theorem ND_IE (m v i gg aa bb: nat): $ bdND2 m v i (sfSequent gg bb) (sfSequent gg (sfImp aa bb)) (sfSequent gg aa) $;
theorem RI_V_IE (m v B i gg aa bb ll: nat): $ (sfSequent gg (sfImp aa bb)) <= ll /\ (sfSequent gg aa) <= ll /\ bdHas m v i bdtIn (sfSequent gg (sfImp aa bb)) ll 0 0 /\ bdHas m v i bdtIn (sfSequent gg aa) ll 0 0 /\ bdHas m v i bdtValid ll 0 0 0 /\ bdHas m v i bdtRow (sfSequent gg bb) 0 0 0 -> bdRValid m v B i ((sfSequent gg bb) : ll) $;
theorem ND_CI (m v i gg aa bb: nat): $ bdND2 m v i (sfSequent gg (sfAnd aa bb)) (sfSequent gg aa) (sfSequent gg bb) $;
theorem RI_V_CI (m v B i gg aa bb ll: nat): $ (sfSequent gg aa) <= ll /\ (sfSequent gg bb) <= ll /\ bdHas m v i bdtIn (sfSequent gg aa) ll 0 0 /\ bdHas m v i bdtIn (sfSequent gg bb) ll 0 0 /\ bdHas m v i bdtValid ll 0 0 0 /\ bdHas m v i bdtRow (sfSequent gg (sfAnd aa bb)) 0 0 0 -> bdRValid m v B i ((sfSequent gg (sfAnd aa bb)) : ll) $;
theorem ND_BP (m v i gg aa bb cc: nat): $ bdND2 m v i (sfBranches gg aa bb cc) (sfSequent (aa : gg) cc) (sfSequent (bb : gg) cc) $;
theorem RI_V_BP (m v B i gg aa bb cc ll: nat): $ (sfSequent (aa : gg) cc) <= ll /\ (sfSequent (bb : gg) cc) <= ll /\ bdHas m v i bdtIn (sfSequent (aa : gg) cc) ll 0 0 /\ bdHas m v i bdtIn (sfSequent (bb : gg) cc) ll 0 0 /\ bdHas m v i bdtValid ll 0 0 0 /\ bdHas m v i bdtRow (sfBranches gg aa bb cc) 0 0 0 -> bdRValid m v B i ((sfBranches gg aa bb cc) : ll) $;
theorem ND_DE (m v i gg aa bb cc: nat): $ bdND2 m v i (sfSequent gg cc) (sfSequent gg (sfOr aa bb)) (sfBranches gg aa bb cc) $;
theorem RI_V_DE (m v B i gg aa bb cc ll: nat): $ (sfSequent gg (sfOr aa bb)) <= ll /\ (sfBranches gg aa bb cc) <= ll /\ bdHas m v i bdtIn (sfSequent gg (sfOr aa bb)) ll 0 0 /\ bdHas m v i bdtIn (sfBranches gg aa bb cc) ll 0 0 /\ bdHas m v i bdtValid ll 0 0 0 /\ bdHas m v i bdtRow (sfSequent gg cc) 0 0 0 -> bdRValid m v B i ((sfSequent gg cc) : ll) $;
theorem ND_ExE (m v i gg aa cc: nat): $ bdHas m v i bdtCShift gg (sfContextShift gg) 0 0 /\ bdHas m v i bdtShift 0 cc (sfShift 0 cc) 0 -> bdND2 m v i (sfSequent gg cc) (sfSequent gg (sfEx aa)) (sfSequent (aa : sfContextShift gg) (sfShift 0 cc)) $;
theorem RI_V_ExE (m v B i gg aa cc ll: nat): $ (sfSequent gg (sfEx aa)) <= ll /\ (sfSequent (aa : sfContextShift gg) (sfShift 0 cc)) <= ll /\ bdHas m v i bdtIn (sfSequent gg (sfEx aa)) ll 0 0 /\ bdHas m v i bdtIn (sfSequent (aa : sfContextShift gg) (sfShift 0 cc)) ll 0 0 /\ bdHas m v i bdtValid ll 0 0 0 /\ bdHas m v i bdtRow (sfSequent gg cc) 0 0 0 /\ bdHas m v i bdtCShift gg (sfContextShift gg) 0 0 /\ bdHas m v i bdtShift 0 cc (sfShift 0 cc) 0 -> bdRValid m v B i ((sfSequent gg cc) : ll) $;
theorem RI_V_nil (m v B i: nat): $ bdRValid m v B i 0 $;
