theorem zfcProofArithmeticQuantifierShiftLocal_or (A K: nat) (d a b x y: nat): $ zfcProofArithmeticQuantifierShiftLocal A K -> (d, sfOr a b) <= K -> bb215ArithmeticFormulaHistoryCell A ((d, a)) (x) -> bb215ArithmeticFormulaHistoryCell A ((d, b)) (y) -> bb215ArithmeticFormulaHistoryCell A ((d, sfOr a b)) (sfOr x y) $;

