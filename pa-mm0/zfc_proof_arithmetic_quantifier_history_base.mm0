def zfcProofArithmeticQuantifierSubstValues (t: nat) (.i: nat): set = $ \ i, sfSubst (fst i) (t) (snd i) $;

theorem zfcProofArithmeticQuantifierSubstValues_at (t i: nat): $ zfcProofArithmeticQuantifierSubstValues t @ i = sfSubst (fst i) (t) (snd i) $;

theorem zfcProofArithmeticQuantifierSubstValues_pair (t d c: nat): $ zfcProofArithmeticQuantifierSubstValues t @ (d, c) = sfSubst (d) (t) (c) $;

