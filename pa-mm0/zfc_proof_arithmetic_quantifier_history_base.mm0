def zfcProofArithmeticQuantifierShiftValues (.i: nat): set = $ \ i, sfShift (fst i) (snd i) $;

theorem zfcProofArithmeticQuantifierShiftValues_at (i: nat): $ zfcProofArithmeticQuantifierShiftValues @ i = sfShift (fst i) (snd i) $;

theorem zfcProofArithmeticQuantifierShiftValues_pair (d c: nat): $ zfcProofArithmeticQuantifierShiftValues @ (d, c) = sfShift (d) (c) $;

def zfcProofArithmeticQuantifierShiftCharacterization (A K: nat) {.i .y: nat}: wff = $ A. i A. y ((bb215ArithmeticFormulaHistoryCell A i y <-> i <= K /\ y = zfcProofArithmeticQuantifierShiftValues @ i)) $;

theorem zfcProofArithmeticQuantifierShiftCharacterization_exists (K: nat) {A: nat}: $ E. A zfcProofArithmeticQuantifierShiftCharacterization A K $;

theorem zfcProofArithmeticQuantifierShiftCharacterization_point (A K: nat) (i y: nat): $ zfcProofArithmeticQuantifierShiftCharacterization A K -> (bb215ArithmeticFormulaHistoryCell A i y <-> i <= K /\ y = zfcProofArithmeticQuantifierShiftValues @ i) $;

theorem zfcProofArithmeticQuantifierShiftCharacterization_pair (A K: nat) (d c y: nat): $ zfcProofArithmeticQuantifierShiftCharacterization A K -> (bb215ArithmeticFormulaHistoryCell A ((d, c)) (y) <-> (d, c) <= K /\ y = sfShift (d) (c)) $;

def zfcProofArithmeticQuantifierShiftLocal (A K: nat) (.d .a .b .x .y: nat): wff = $ (A. d A. a A. b ((d, sfNode 0 a b) <= K -> bb215ArithmeticFormulaHistoryCell A ((d, sfNode 0 a b)) (0))) /\ (A. d A. a A. b ((d, sfMem a b) <= K -> bb215ArithmeticFormulaHistoryCell A ((d, sfMem a b)) (sfMem (sfShiftIndex (d) (a)) (sfShiftIndex (d) (b))))) /\ (A. d A. a A. b ((d, sfEq a b) <= K -> bb215ArithmeticFormulaHistoryCell A ((d, sfEq a b)) (sfEq (sfShiftIndex (d) (a)) (sfShiftIndex (d) (b))))) /\ (A. d A. a A. b A. x A. y ((d, sfAnd a b) <= K -> bb215ArithmeticFormulaHistoryCell A ((d, a)) (x) -> bb215ArithmeticFormulaHistoryCell A ((d, b)) (y) -> bb215ArithmeticFormulaHistoryCell A ((d, sfAnd a b)) (sfAnd x y))) /\ (A. d A. a A. b A. x A. y ((d, sfOr a b) <= K -> bb215ArithmeticFormulaHistoryCell A ((d, a)) (x) -> bb215ArithmeticFormulaHistoryCell A ((d, b)) (y) -> bb215ArithmeticFormulaHistoryCell A ((d, sfOr a b)) (sfOr x y))) /\ (A. d A. a A. b A. x A. y ((d, sfImp a b) <= K -> bb215ArithmeticFormulaHistoryCell A ((d, a)) (x) -> bb215ArithmeticFormulaHistoryCell A ((d, b)) (y) -> bb215ArithmeticFormulaHistoryCell A ((d, sfImp a b)) (sfImp x y))) /\ (A. d A. a A. x ((d, sfAll a) <= K -> bb215ArithmeticFormulaHistoryCell A ((suc d, a)) (x) -> bb215ArithmeticFormulaHistoryCell A ((d, sfAll a)) (sfAll x))) /\ (A. d A. a A. x ((d, sfEx a) <= K -> bb215ArithmeticFormulaHistoryCell A ((suc d, a)) (x) -> bb215ArithmeticFormulaHistoryCell A ((d, sfEx a)) (sfEx x))) /\ (A. d A. a A. b (b != 0 -> (d, sfNode 6 a b) <= K -> bb215ArithmeticFormulaHistoryCell A ((d, sfNode 6 a b)) (0))) /\ (A. d A. a A. b (b != 0 -> (d, sfNode 7 a b) <= K -> bb215ArithmeticFormulaHistoryCell A ((d, sfNode 7 a b)) (0))) $;

theorem zfcProofArithmeticQuantifierShiftLocal_zero (A K: nat) (d a b: nat): $ zfcProofArithmeticQuantifierShiftLocal A K -> (d, sfNode 0 a b) <= K -> bb215ArithmeticFormulaHistoryCell A ((d, sfNode 0 a b)) (0) $;

