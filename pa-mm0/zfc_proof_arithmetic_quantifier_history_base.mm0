theorem zfcProofArithmeticQuantifierShiftLocal_all (A K: nat) (d a x: nat): $ zfcProofArithmeticQuantifierShiftLocal A K -> (d, sfAll a) <= K -> bb215ArithmeticFormulaHistoryCell A ((suc d, a)) (x) -> bb215ArithmeticFormulaHistoryCell A ((d, sfAll a)) (sfAll x) $;

