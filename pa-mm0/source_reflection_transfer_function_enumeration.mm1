import "source_reflection_transfer_tv_enumeration.mm1";

import "source_piece_pcf_function_opening.mm1";

pub theorem sfTVEnumFunction_count(D i:nat): $ sfPieceFunctionCount (sfTVEnumRows D) i = fst i $ = (named '(eqtr (fsteq sfTVEnumRows_at) fstpr));

pub theorem sfTVEnumFunction_matrix(D i:nat): $ sfPieceFunctionMatrix (sfTVEnumRows D) i = sfTVEnumMatrix D i $ = (named '(eqtr (sndeq sfTVEnumRows_at) sndpr));

pub theorem sfTVEnumFunction_valid(D n:nat)(hd:$ sfBound 1 D $): $ sfPieceFunctionTableValid (sfTVEnumRows D) n $ = (named '(ax_gen (a1i (mpbir (trud (sfBoundeqd (a1i (suceq sfTVEnumFunction_count)) (a1i sfTVEnumFunction_matrix))) (sfTVEnumMatrixRaw_bound hd)))));

pub theorem sfTVEnumFunction_positive_count(D k c:nat)(hb:$ sfBound (suc k) c $): $ sfPieceFunctionCount (sfTVEnumRows D) (sfTVEnumIndex k c 0) = k $ = (named '(eqtr sfTVEnumFunction_count fstpr));

pub theorem sfTVEnumFunction_positive_matrix(D k c:nat)(hb:$ sfBound (suc k) c $): $ sfPieceFunctionMatrix (sfTVEnumRows D) (sfTVEnumIndex k c 0) = sfRelativize D c $ = (named '(eqtr sfTVEnumFunction_matrix (eqtr sfTVEnumMatrix_at (sfTVEnumMatrixRaw_positive hb))));

pub theorem sfTVEnumFunction_negative_count(D k c:nat)(hb:$ sfBound (suc k) c $): $ sfPieceFunctionCount (sfTVEnumRows D) (sfTVEnumIndex k c 1) = k $ = (named '(eqtr sfTVEnumFunction_count fstpr));

pub theorem sfTVEnumFunction_negative_matrix(D k c:nat)(hb:$ sfBound (suc k) c $): $ sfPieceFunctionMatrix (sfTVEnumRows D) (sfTVEnumIndex k c 1) = sfImp (sfRelativize D c) sfBot $ = (named '(eqtr sfTVEnumFunction_matrix (eqtr sfTVEnumMatrix_at (sfTVEnumMatrixRaw_negative hb))));
