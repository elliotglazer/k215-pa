def paS1RTn (m v c e .a .b .g .t .u .x: nat): wff = $
  E. a E. b E. x (c = paFormulaEqual a b /\ paS1In m v (paS1Tv a e x) /\ paS1In m v (paS1Tv b e x)) \/
  E. a E. b (c = paFormulaAnd a b /\ paS1In m v (paS1Tn a e) /\ paS1In m v (paS1Tn b e)) \/
  E. a E. b (c = paFormulaOr a b /\ (paS1In m v (paS1Tn a e) \/ paS1In m v (paS1Tn b e))) \/
