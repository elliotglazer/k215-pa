delimiter $ ( { ~ $  $ } ) , $;
strict provable sort wff;
term im (p q: wff): wff;
infixr im: $->$ prec 25;
term not (p: wff): wff;
prefix not: $~$ prec 41;
axiom ax_1 (a b: wff): $ a -> b -> a $;
axiom ax_2 (a b c: wff): $ (a -> b -> c) -> (a -> b) -> a -> c $;
axiom ax_3 (a b: wff): $ (~a -> ~b) -> b -> a $;
axiom ax_mp (a b: wff): $ a -> b $ > $ a $ > $ b $;
def an (a b: wff): wff = $ ~(a -> ~b) $;
infixl an: $/\$ prec 34;
def iff (a b: wff): wff = $ (a -> b) /\ (b -> a) $;
infixl iff: $<->$ prec 20;
def or (a b: wff): wff = $ ~a -> b $;
infixl or: $\/$ prec 30;
def ifp (p a b: wff): wff;
theorem ifppos (p a b: wff): $ p -> (ifp p a b <-> a) $;
theorem ifpneg (p a b: wff): $ ~p -> (ifp p a b <-> b) $;
term tru: wff;
prefix tru: $T.$ prec max;
axiom itru: $ T. $;
def fal: wff = $ ~T. $;
prefix fal: $F.$ prec max;
sort nat;
term al {x: nat} (p: wff x): wff;
prefix al: $A.$ prec 41;
def ex {x: nat} (p: wff x): wff = $ ~(A. x ~p) $;
prefix ex: $E.$ prec 41;
term eq (a b: nat): wff;
infixl eq: $=$ prec 50;
axiom ax_gen {x: nat} (p: wff x): $ p $ > $ A. x p $;
axiom ax_4 {x: nat} (p q: wff x): $ A. x (p -> q) -> A. x p -> A. x q $;
axiom ax_5 {x: nat} (p: wff): $ p -> A. x p $;
axiom ax_6 (a: nat) {x: nat}: $ E. x x = a $;
axiom ax_7 (a b c: nat): $ a = b -> a = c -> b = c $;
axiom ax_10 {x: nat} (p: wff x): $ ~(A. x p) -> A. x ~(A. x p) $;
axiom ax_11 {x y: nat} (p: wff x y): $ A. x A. y p -> A. y A. x p $;
axiom ax_12 {x: nat} (a: nat) (p: wff x): $ x = a -> p -> A. x (x = a -> p) $;
def ne (a b: nat): wff = $ ~ a = b $;
infixl ne: $!=$ prec 50;
def sb (a: nat) {x .y: nat} (p: wff x): wff =
$ A. y (y = a -> A. x (x = y -> p)) $;
notation sb (a: nat) {x: nat} (p: wff x): wff =
  ($[$:41) a ($/$:0) x ($]$:0) p;
strict sort set;
term ab {x: nat} (p: wff x): set;
notation ab {x: nat} (p: wff x): set = (${$:max) x ($|$:0) p ($}$:0);
term el (a: nat) (A: set): wff;
infixl el: $e.$ prec 50;
axiom elab (a: nat) {x: nat} (p: wff x): $ a e. {x | p} <-> [ a / x ] p $;
axiom ax_8 (a b: nat) (A: set): $ a = b -> a e. A -> b e. A $;
def eqs (A B: set) {.x: nat}: wff = $ A. x (x e. A <-> x e. B) $;
infixl eqs: $==$ prec 50;
def subset (A B: set) (.x: nat): wff = $ A. x (x e. A -> x e. B) $;
infixl subset: $C_$ prec 50;
def Inter (A B: set) (.x: nat): set = $ {x | x e. A /\ x e. B} $;
infixl Inter: $i^i$ prec 70;
def Union (A B: set) (.x: nat): set = $ {x | x e. A \/ x e. B} $;
infixl Union: $u.$ prec 65;
def Compl (A: set) (.x: nat): set = $ {x | ~x e. A} $;
def Univ (.x: nat): set = $ {x | T.} $;
prefix Univ: $_V$ prec max;
def sbs (a: nat) {x .y: nat} (A: set x): set = $ {y | [ a / x ] y e. A} $;
notation sbs (a: nat) {x: nat} (A: set x): set = ($S[$:99) a ($/$:0) x ($]$:0) A;
term d0: nat;
prefix d0: $0$ prec max;
term suc (n: nat): nat;
def d1:  nat = $suc 0$;
prefix d1:  $1$  prec max;
def d2:  nat = $suc 1$;
prefix d2:  $2$  prec max;
def d3:  nat = $suc 2$;
prefix d3:  $3$  prec max;
def d4:  nat = $suc 3$;
prefix d4:  $4$  prec max;
def d5:  nat = $suc 4$;
prefix d5:  $5$  prec max;
def d6:  nat = $suc 5$;
prefix d6:  $6$  prec max;
def d7:  nat = $suc 6$;
prefix d7:  $7$  prec max;
def d8:  nat = $suc 7$;
prefix d8:  $8$  prec max;
def d9:  nat = $suc 8$;
prefix d9:  $9$  prec max;
def d10: nat = $suc 9$;
prefix d10: $10$ prec max;
axiom peano1 (a: nat): $ suc a != 0 $;
axiom peano2 (a b: nat): $ suc a = suc b <-> a = b $;
axiom peano5 {x: nat} (p: wff x):
  $ [ 0 / x ] p -> A. x (p -> [ suc x / x ] p) -> A. x p $;
term the (A: set): nat;
axiom theid {x: nat} (A: set) (a: nat): $ A == {x | x = a} -> the A = a $;
axiom the0 {x y: nat} (A: set): $ ~E. y A == {x | x = y} -> the A = 0 $;
def sbn (a: nat) {x .y: nat} (b: nat x): nat = $ the {y | [ a / x ] y = b} $;
notation sbn (a: nat) {x: nat} (b: nat x): nat = ($N[$:99) a ($/$:0) x ($]$:0) b;
term add (a b: nat): nat;
infixl add: $+$ prec 64;
term mul (a b: nat): nat;
infixl mul: $*$ prec 70;
axiom addeq (a b c d: nat): $ a = b -> c = d -> a + c = b + d $;
axiom muleq (a b c d: nat): $ a = b -> c = d -> a * c = b * d $;
axiom add0 (a: nat): $ a + 0 = a $;
axiom addS (a b: nat): $ a + suc b = suc (a + b) $;
axiom mul0 (a: nat): $ a * 0 = 0 $;
axiom mulS (a b: nat): $ a * suc b = a * b + a $;
def sub (a b: nat) {.x: nat}: nat = $ the {x | b + x = a} $;
infixl sub: $-$ prec 64;
def le (a b .x: nat): wff = $ E. x a + x = b $;
infixl le: $<=$ prec 50;
def lt (a b: nat): wff = $ suc a <= b $;
infixl lt: $<$ prec 50;
def finite (A: set) (.n .x: nat): wff = $ E. n A. x (x e. A -> x < n) $;
def if (p: wff) (a b: nat): nat;
theorem ifpos (p: wff) (a b: nat): $ p -> if p a b = a $;
theorem ifneg (p: wff) (a b: nat): $ ~p -> if p a b = b $;
def true (n: nat): wff = $ n != 0 $;
def bool (n: nat): wff = $ n < 2 $;
def nat (p: wff): nat = $ if p 1 0 $;
def min (a b: nat): nat = $ if (a < b) a b $;
def max (a b: nat): nat = $ if (a < b) b a $;
def div (a b: nat): nat;
infixl div: $//$ prec 70;
def mod (a b: nat): nat;
infixl mod: $%$ prec 70;
theorem div0 (a: nat): $ a // 0 = 0 $;
theorem divmod (a b: nat): $ b * (a // b) + a % b = a $;
theorem modlt (a b: nat): $ b != 0 -> a % b < b $;
def dvd (a b .c: nat): wff = $ E. c c * a = b $;
infixl dvd: $||$ prec 50;
def b0 (n: nat): nat = $ n + n $;
def b1 (n: nat): nat = $ suc (b0 n) $;
def odd (n: nat): wff = $ n % 2 = 1 $;
def pr (a b: nat): nat = $ (a + b) * suc (a + b) // 2 + b $;
infixr pr: $,$ prec 55;
def fst (a: nat): nat;
def snd (a: nat): nat;
theorem pr0: $ 0, 0 = 0 $;
theorem fstpr (a b: nat): $ fst (a, b) = a $;
theorem sndpr (a b: nat): $ snd (a, b) = b $;
theorem fstsnd (a: nat): $ fst a, snd a = a $;
def pi11 (n: nat): nat = $ fst (fst n) $;
def pi12 (n: nat): nat = $ snd (fst n) $;
def pi21 (n: nat): nat = $ fst (snd n) $;
def pi22 (n: nat): nat = $ snd (snd n) $;
def pi221 (n: nat): nat = $ fst (pi22 n) $;
def pi222 (n: nat): nat = $ snd (pi22 n) $;
def isfun (A: set) (.a .b .b2: nat): wff =
$ A. a A. b A. b2 (a, b e. A -> a, b2 e. A -> b = b2) $;
def sab {x .z: nat} (A: set x): set = $ {z | snd z e. S[ fst z / x ] A} $;
notation sab {x: nat} (A: set x): set = ($S\$:100) x ($,$:55) A;
def xab {x .z: nat} (A: set) (B: set x): set =
$ {z | fst z e. A /\ snd z e. S[ fst z / x ] B} $;
notation xab {x: nat} (A: set) (B: set x): set =
  ($X\$:100) x ($e.$:50) A ($,$:55) B;
def Xp (A B: set) (.x: nat): set = $ X\ x e. A, B $;
def Dom (A: set) (.x .y: nat): set = $ {x | E. y x, y e. A} $;
def Ran (A: set) (.x .y: nat): set = $ {y | E. x x, y e. A} $;
def Im (F A: set) (.x .y: nat): set = $ {y | E. x (x e. A /\ x, y e. F)} $;
infixl Im: $''$ prec 80;
def cnv (A: set) (.x .y: nat): set = $ S\ x, {y | y, x e. A} $;
def comp (F G: set) (.x .y .z: nat): set =
$ S\ x, {z | E. y (x, y e. F /\ y, z e. G)} $;
infixr comp: $o>$ prec 91;
def res (A B: set): set = $ A i^i Xp B _V $;
infixl res: $|`$ prec 54;
def lam {x .p: nat} (a: nat x): set = $ {p | E. x p = x, a} $;
notation lam {x: nat} (a: nat x): set = ($\$:53) x ($,$:55) a;
def app (F: set) (x .y: nat): nat = $ the {y | x, y e. F} $;
infixl app: $@$ prec 200;
def case (A B: set) (.n: nat): set =
$ \ n, if (odd n) (B @ (n // 2)) (A @ (n // 2)) $;
theorem casel (A B: set) (n: nat): $ case A B @ b0 n = A @ n $;
theorem caser (A B: set) (n: nat): $ case A B @ b1 n = B @ n $;
def Sum (A B: set): set;
theorem Suml (A B: set) (n: nat): $ b0 n e. Sum A B <-> n e. A $;
theorem Sumr (A B: set) (n: nat): $ b1 n e. Sum A B <-> n e. B $;
def rec (z: nat) (S: set) (n: nat): nat;
theorem rec0 (z: nat) (S: set): $ rec z S 0 = z $;
theorem recS (z: nat) (S: set) (n: nat):
  $ rec z S (suc n) = S @ rec z S n $;
def obind (a: nat) (F: set): nat;
theorem obind0 (F: set): $ obind 0 F = 0 $;
theorem obindS (n: nat) (F: set): $ obind (suc n) F = F @ n $;
def pow (a b: nat): nat;
infixr pow: $^$ prec 81;
theorem pow0 (a: nat): $ a ^ 0 = 1 $;
theorem powS (a b: nat): $ a ^ suc b = a * a ^ b $;
def shl (a n: nat): nat = $ a * 2 ^ n $;
def shr (a n: nat): nat = $ a // 2 ^ n $;
def ns (a .x: nat): set = $ {x | odd (shr a x)} $;
coercion ns: nat > set;
theorem axext (a b: nat): $ a == b -> a = b $;
theorem ellt (a b: nat): $ a e. b -> a < b $;
theorem nel0 (a: nat): $ ~ a e. 0 $;
def lower (A: set) (.n: nat): nat = $ the {n | n == A} $;
theorem eqlower (A: set): $ finite A <-> A == lower A $;
def sn (a: nat): nat;
theorem elsn (a b: nat): $ a e. sn b <-> a = b $;
def ins (a b: nat): nat;
infixr ins: $;$ prec 85;
theorem elins (a b c: nat): $ a e. ins b c <-> a = b \/ a e. c $;
def upto (n: nat): nat = $ 2 ^ n - 1 $;
theorem elupto (k n: nat): $ k e. upto n <-> k < n $;
def Bool: nat = $ 0 ; sn 1 $;
def Option (A: set) (.n: nat): set = $ {n | n = 0 \/ n - 1 e. A} $;
def Power (A: set) (.x: nat): set = $ {x | x C_ A} $;
def power (a: nat): nat = $ lower (Power a) $;
def sUnion (A: set) (.x .y: nat): set = $ {x | E. y (x e. y /\ y e. A)} $;
def cons (a b: nat): nat = $ suc (a, b) $;
infixr cons: $:$ prec 91;
def sep (n: nat) (A: set): nat;
theorem elsep (n: nat) (A: set) (a: nat): $ a e. sep n A <-> a e. n /\ a e. A $;
def Arrow (A B: set) (.f: nat): set =
$ {f | isfun f /\ Dom f == A /\ Ran f C_ B} $;
def rlam {x: nat} (a: nat) (v: nat x): nat = $ lower ((\ x, v) |` a) $;
notation rlam {x: nat} (a: nat) (v: nat x): nat = ($\.$:53) x ($e.$:50) a ($,$:55) v;
def write (F: set) (a b .x .y: nat): set =
$ S\ x, {y | ifp (x = a) (y = b) (x, y e. F)} $;
theorem writeEq (F: set) (a b: nat): $ write F a b @ a = b $;
theorem writeNe (F: set) (a b x: nat): $ x != a -> write F a b @ x = F @ x $;
def srec (S: set) (n: nat): nat;
theorem srecval {i: nat} (S: set) (n: nat):
  $ srec S n = S @ (\. i e. upto n, srec S i) $;
def srecp (A: set) (n: nat): wff;
theorem srecpval {i: nat} (A: set) (n: nat):
  $ srecp A n <-> n, sep (upto n) {i | srecp A i} e. A $;
def card (s: nat): nat;
theorem card0: $ card 0 = 0 $;
theorem cardS (a s: nat): $ ~a e. s -> card (a ; s) = suc (card s) $;
def lrec (z: nat) (S: set) (n: nat): nat;
theorem lrec0 (z: nat) (S: set): $ lrec z S 0 = z $;
theorem lrecS (z: nat) (S: set) (a b: nat):
  $ lrec z S (a : b) = S @ (a, b, lrec z S b) $;
def lmems (l: nat): nat;
theorem lmems0: $ lmems 0 = 0 $;
theorem lmemsS (a l: nat): $ lmems (a : l) = a ; lmems l $;
def lmem (a l: nat): wff = $ a e. lmems l $;
infixl lmem: $IN$ prec 50;
def all (A: set) (l: nat): wff = $ lmems l C_ A $;
def List (A: set) (.n: nat): set = $ {n | all A n} $;
def len (l: nat): nat;
theorem len0: $ len 0 = 0 $;
theorem lenS (a b: nat): $ len (a : b) = suc (len b) $;
def Array (A: set) (n .l: nat): set = $ {l | l e. List A /\ len l = n} $;
def append (l1 l2: nat): nat;
infixr append: $++$ prec 85;
theorem append0 (l: nat): $ 0 ++ l = l $;
theorem appendS (a l r: nat): $ (a : l) ++ r = a : (l ++ r) $;
def snoc (l a: nat): nat;
infixl snoc: $|>$ prec 84;
theorem snoc0 (a: nat): $ 0 |> a = a : 0 $;
theorem snocS (a b c: nat): $ (a : b) |> c = a : (b |> c) $;
theorem snoclt (a b: nat): $ a < a |> b $;
def nth (n l: nat): nat;
theorem nth0 (n: nat): $ nth n 0 = 0 $;
theorem nthZ (a l: nat): $ nth 0 (a : l) = suc a $;
theorem nthS (n a l: nat): $ nth (suc n) (a : l) = nth n l $;
def repeat (a n: nat): nat;
theorem repeat0 (a: nat): $ repeat a 0 = 0 $;
theorem repeatS (a n: nat): $ repeat a (suc n) = a : repeat a n $;
def map (F: set) (l: nat): nat;
theorem map0 (F: set): $ map F 0 = 0 $;
theorem mapS (F: set) (a l: nat):
  $ map F (a : l) = F @ a : map F l $;
def ljoin (L: nat): nat;
theorem ljoin0: $ ljoin 0 = 0 $;
theorem ljoinS (l L: nat): $ ljoin (l : L) = l ++ ljoin L $;
def sublistAt (n L1 L2 .l .r: nat): wff =
$ E. l E. r (L1 = l ++ L2 ++ r /\ len l = n) $;
def all2 (R: set) {.l1 .l2 .x .y .n: nat}: set =
$ S\ l1, {l2 | len l1 = len l2 /\ A. n A. x A. y
  (nth n l1 = suc x -> nth n l2 = suc y -> x, y e. R)} $;
def ex2 (R: set) {.l1 .l2 .x .y .n: nat}: set =
$ S\ l1, {l2 | len l1 = len l2 /\ E. n E. x E. y
  (nth n l1 = suc x /\ nth n l2 = suc y /\ x, y e. R)} $;
def traceStep (R: set) (.n: nat): set =
$ \ n, nat (true (pi22 n) /\ (fst n, pi21 n) e. R) $;
def traceCheck (R: set) (p: nat): nat = $ lrec 1 (traceStep R) p $;
def traceValid (R: set) (p: nat): wff = $ true (traceCheck R p) $;
def traceDerives (R: set) (p a: nat): wff = $ traceValid R p /\ a IN p $;
def sfBot: nat = $ 0 $;
def sfNode (t a b: nat): nat = $ 8 * (a, b) + t $;
def sfMem (a b: nat): nat = $ sfNode 1 a b $;
def sfEq (a b: nat): nat = $ sfNode 2 a b $;
def sfAnd (a b: nat): nat = $ sfNode 3 a b $;
def sfOr (a b: nat): nat = $ sfNode 4 a b $;
def sfImp (a b: nat): nat = $ sfNode 5 a b $;
def sfAll (a: nat): nat = $ sfNode 6 a 0 $;
def sfEx (a: nat): nat = $ sfNode 7 a 0 $;
def sfTag (a: nat): nat = $ a % 8 $;
def sfLeft (a: nat): nat = $ fst (a // 8) $;
def sfRight (a: nat): nat = $ snd (a // 8) $;
def sfAllowed (n h: nat): wff =
$ n = 0 \/ ((sfTag n = 1 \/ sfTag n = 2) \/ (
  ((sfTag n = 3 \/ sfTag n = 4 \/ sfTag n = 5) /\
    sfLeft n e. h /\ sfRight n e. h) \/
  ((sfTag n = 6 \/ sfTag n = 7) /\
    sfRight n = 0 /\ sfLeft n e. h))) $;
def sfSyntaxStep (.n .h: nat): set = $ S\ n, {h | sfAllowed n h} $;
def sfWf (n: nat): wff = $ srecp sfSyntaxStep n $;
def sfShiftIndex (d i: nat): nat = $ if (i < d) i (suc i) $;
def sfHistoryLength (h .x .y .k: nat): nat =
$ the {x | x e. {k | Dom h C_ upto k} /\
    A. y (y e. {k | Dom h C_ upto k} -> x <= y)} $;
def sfShiftBody (d c h: nat): nat =
$ if (c = 0) 0
  (if (sfTag c = 1) (sfMem (sfShiftIndex d (sfLeft c)) (sfShiftIndex d (sfRight c)))
  (if (sfTag c = 2) (sfEq (sfShiftIndex d (sfLeft c)) (sfShiftIndex d (sfRight c)))
  (if (sfTag c = 3) (sfAnd (h @ (d, sfLeft c)) (h @ (d, sfRight c)))
  (if (sfTag c = 4) (sfOr (h @ (d, sfLeft c)) (h @ (d, sfRight c)))
  (if (sfTag c = 5) (sfImp (h @ (d, sfLeft c)) (h @ (d, sfRight c)))
  (if (sfTag c = 6 /\ sfRight c = 0) (sfAll (h @ (suc d, sfLeft c)))
  (if (sfTag c = 7 /\ sfRight c = 0) (sfEx (h @ (suc d, sfLeft c))) 0))))))) $;
def sfShiftStep (.h: nat): set =
$ \ h, sfShiftBody (fst (sfHistoryLength h)) (snd (sfHistoryLength h)) h $;
def sfShift (d c: nat): nat = $ srec sfShiftStep (d, c) $;
def sfBoundAllowed (n c h: nat): wff =
$ ifp (c = 0) (0 = 0)
  (ifp (sfTag c = 1) (sfLeft c < n /\ sfRight c < n)
  (ifp (sfTag c = 2) (sfLeft c < n /\ sfRight c < n)
  (ifp (sfTag c = 3) ((n, sfLeft c) e. h /\ (n, sfRight c) e. h)
  (ifp (sfTag c = 4) ((n, sfLeft c) e. h /\ (n, sfRight c) e. h)
  (ifp (sfTag c = 5) ((n, sfLeft c) e. h /\ (n, sfRight c) e. h)
  (ifp (sfTag c = 6 /\ sfRight c = 0) ((suc n, sfLeft c) e. h)
  (ifp (sfTag c = 7 /\ sfRight c = 0) ((suc n, sfLeft c) e. h)
    (0 != 0)))))))) $;
def sfBoundStep (.k .h: nat): set =
$ S\ k, {h | sfBoundAllowed (fst k) (snd k) h} $;
def sfBound (n c: nat): wff = $ srecp sfBoundStep (n, c) $;
def paTermZero: nat = $ 0 $;
def paTermVariable (i: nat): nat = $ sfMem i 0 $;
def paTermSuccessor (a: nat): nat = $ sfEq a 0 $;
def paTermAddition (a b: nat): nat = $ sfAnd a b $;
def paTermMultiplication (a b: nat): nat = $ sfOr a b $;
def paTermBoundAllowed (n c h: nat): wff = $ ifp (c = 0) (0 = 0)
 (ifp (sfTag c = 1) (sfRight c = 0 /\ sfLeft c < n)
 (ifp (sfTag c = 2) (sfRight c = 0 /\ (n,  sfLeft c) e. h)
 (ifp (sfTag c = 3) ((n,  sfLeft c) e. h /\ (n,  sfRight c) e. h)
 (ifp (sfTag c = 4) ((n,  sfLeft c) e. h /\ (n,  sfRight c) e. h)
 (0 != 0))))) $;
def paTermBoundStep (.k .h: nat): set = $ S\ k,  {h | paTermBoundAllowed (fst k) (snd k) h} $;
def paTermBound (n c: nat): wff = $ srecp paTermBoundStep (n,  c) $;
def paFormulaFalse: nat = $ 0 $;
def paFormulaEqual (a b: nat): nat = $ sfMem a b $;
def paFormulaAnd (a b: nat): nat = $ sfAnd a b $;
def paFormulaOr (a b: nat): nat = $ sfOr a b $;
def paFormulaImp (a b: nat): nat = $ sfImp a b $;
def paFormulaAll (a: nat): nat = $ sfAll a $;
def paFormulaEx (a: nat): nat = $ sfEx a $;
def paFormulaBoundAllowed (n c h: nat): wff = $ ifp (c = 0) (0 = 0)
 (ifp (sfTag c = 1) (paTermBound n (sfLeft c) /\ paTermBound n (sfRight c))
 (ifp (sfTag c = 3) ((n, sfLeft c) e. h /\ (n, sfRight c) e. h)
 (ifp (sfTag c = 4) ((n, sfLeft c) e. h /\ (n, sfRight c) e. h)
 (ifp (sfTag c = 5) ((n, sfLeft c) e. h /\ (n, sfRight c) e. h)
 (ifp (sfTag c = 6 /\ sfRight c = 0) ((suc n, sfLeft c) e. h)
 (ifp (sfTag c = 7 /\ sfRight c = 0) ((suc n, sfLeft c) e. h)
 (0 != 0))))))) $;
def paFormulaBoundStep (.k .h: nat): set = $ S\ k, {h | paFormulaBoundAllowed (fst k) (snd k) h} $;
def paFormulaBound (n c: nat): wff = $ srecp paFormulaBoundStep (n, c) $;
def sfRenameIndex (R: set) (d i: nat): nat = $ if (i < d) i (d + (R @ (i - d))) $;
def sfRenameBody (R: set) (d c h: nat): nat =
$ if (c = 0) 0
  (if (sfTag c = 1) (sfMem (sfRenameIndex R d (sfLeft c)) (sfRenameIndex R d (sfRight c)))
  (if (sfTag c = 2) (sfEq (sfRenameIndex R d (sfLeft c)) (sfRenameIndex R d (sfRight c)))
  (if (sfTag c = 3) (sfAnd (h @ (d, sfLeft c)) (h @ (d, sfRight c)))
  (if (sfTag c = 4) (sfOr (h @ (d, sfLeft c)) (h @ (d, sfRight c)))
  (if (sfTag c = 5) (sfImp (h @ (d, sfLeft c)) (h @ (d, sfRight c)))
  (if (sfTag c = 6 /\ sfRight c = 0) (sfAll (h @ (suc d, sfLeft c)))
  (if (sfTag c = 7 /\ sfRight c = 0) (sfEx (h @ (suc d, sfLeft c))) 0))))))) $;
def sfRenameStep (R: set) (.h: nat): set =
$ \ h, sfRenameBody R (fst (sfHistoryLength h)) (snd (sfHistoryLength h)) h $;
def sfRename (R: set) (d c: nat): nat = $ srec (sfRenameStep R) (d, c) $;
def paTermRenameBody (R: set) (c h: nat): nat = $ if (c = 0) paTermZero
 (if (sfTag c = 1) (paTermVariable (R @ (sfLeft c)))
 (if (sfTag c = 2) (paTermSuccessor (h @ (sfLeft c)))
 (if (sfTag c = 3) (paTermAddition (h @ (sfLeft c)) (h @ (sfRight c)))
 (if (sfTag c = 4) (paTermMultiplication (h @ (sfLeft c)) (h @ (sfRight c))) paTermZero)))) $;
def paTermRenameStep (R: set) (.h: nat): set = $ \ h, paTermRenameBody R (sfHistoryLength h) h $;
def paTermRename (R: set) (c: nat): nat = $ srec (paTermRenameStep R) c $;
def paTermLiftMap (k .i: nat): set = $ \ i, k + i $;
def paTermLift (k c: nat): nat = $ paTermRename (paTermLiftMap k) c $;
def paTermShiftMap (d .i: nat): set = $ \ i, sfShiftIndex d i $;
def paTermSubstVariable (d a i: nat): nat = $ if (i < d) (paTermVariable i) (if (i = d) (paTermLift d a) (paTermVariable (i - 1))) $;
def paTermSubstBody (d a c h: nat): nat = $ if (c = 0) paTermZero
 (if (sfTag c = 1) (paTermSubstVariable d a (sfLeft c))
 (if (sfTag c = 2) (paTermSuccessor (h @ (sfLeft c)))
 (if (sfTag c = 3) (paTermAddition (h @ (sfLeft c)) (h @ (sfRight c)))
 (if (sfTag c = 4) (paTermMultiplication (h @ (sfLeft c)) (h @ (sfRight c))) paTermZero)))) $;
def paTermSubstStep (d a: nat) (.h: nat): set = $ \ h, paTermSubstBody d a (sfHistoryLength h) h $;
def paTermSubst (d a c: nat): nat = $ srec (paTermSubstStep d a) c $;
def paFormulaSubstBody (d a c h: nat): nat = $ if (c = 0) 0 (if (sfTag c = 1) (paFormulaEqual (paTermSubst d a (sfLeft c)) (paTermSubst d a (sfRight c))) (if (sfTag c = 3) (paFormulaAnd (h @ (d, sfLeft c)) (h @ (d, sfRight c))) (if (sfTag c = 4) (paFormulaOr (h @ (d, sfLeft c)) (h @ (d, sfRight c))) (if (sfTag c = 5) (paFormulaImp (h @ (d, sfLeft c)) (h @ (d, sfRight c))) (if (sfTag c = 6 /\ sfRight c = 0) (paFormulaAll (h @ (suc d, sfLeft c))) (if (sfTag c = 7 /\ sfRight c = 0) (paFormulaEx (h @ (suc d, sfLeft c))) 0)))))) $;
def paFormulaSubstStep (a .h: nat): set = $ \ h, paFormulaSubstBody (fst (sfHistoryLength h)) a (snd (sfHistoryLength h)) h $;
def paFormulaSubst (d a c: nat): nat = $ srec (paFormulaSubstStep a) (d, c) $;
def sfSubstIndex (d t i: nat): nat = $ if (i < d) i (if (i = d) (t + d) (i - 1)) $;
def sfSubstBody (d t c h: nat): nat =
$ if (c = 0) 0
  (if (sfTag c = 1) (sfMem (sfSubstIndex d t (sfLeft c)) (sfSubstIndex d t (sfRight c)))
  (if (sfTag c = 2) (sfEq (sfSubstIndex d t (sfLeft c)) (sfSubstIndex d t (sfRight c)))
  (if (sfTag c = 3) (sfAnd (h @ (d, sfLeft c)) (h @ (d, sfRight c)))
  (if (sfTag c = 4) (sfOr (h @ (d, sfLeft c)) (h @ (d, sfRight c)))
  (if (sfTag c = 5) (sfImp (h @ (d, sfLeft c)) (h @ (d, sfRight c)))
  (if (sfTag c = 6 /\ sfRight c = 0) (sfAll (h @ (suc d, sfLeft c)))
  (if (sfTag c = 7 /\ sfRight c = 0) (sfEx (h @ (suc d, sfLeft c))) 0))))))) $;
def sfSubstStep (t .h: nat): set =
$ \ h, sfSubstBody (fst (sfHistoryLength h)) t (snd (sfHistoryLength h)) h $;
def sfSubst (d t c: nat): nat = $ srec (sfSubstStep t) (d, c) $;
def sfRenameDepthMap (R: set) (k .i: nat): set = $ \ i, sfRenameIndex R k i $;
def paFormulaRenameBody (R: set) (d c h: nat): nat = $ if (c = 0) 0 (if (sfTag c = 1) (paFormulaEqual (paTermRename (sfRenameDepthMap R d) (sfLeft c)) (paTermRename (sfRenameDepthMap R d) (sfRight c))) (if (sfTag c = 3) (paFormulaAnd (h @ (d, sfLeft c)) (h @ (d, sfRight c))) (if (sfTag c = 4) (paFormulaOr (h @ (d, sfLeft c)) (h @ (d, sfRight c))) (if (sfTag c = 5) (paFormulaImp (h @ (d, sfLeft c)) (h @ (d, sfRight c))) (if (sfTag c = 6 /\ sfRight c = 0) (paFormulaAll (h @ (suc d, sfLeft c))) (if (sfTag c = 7 /\ sfRight c = 0) (paFormulaEx (h @ (suc d, sfLeft c))) 0)))))) $;
def paFormulaRenameStep (R: set) (.h: nat): set = $ \ h, paFormulaRenameBody R (fst (sfHistoryLength h)) (snd (sfHistoryLength h)) h $;
def paFormulaRename (R: set) (d c: nat): nat = $ srec (paFormulaRenameStep R) (d, c) $;
def paAxiomLift (c: nat): nat = $ paFormulaRename (paTermShiftMap 0) 0 c $;
def paAxiomRaiseParameters (c: nat): nat = $ paFormulaRename (paTermShiftMap 0) 1 c $;
def paAxiomNext (phi: nat): nat = $ paFormulaSubst 0 (paTermSuccessor (paTermVariable 0)) (paAxiomRaiseParameters phi) $;
def paAxiomProp1 (a b: nat): nat = $ paFormulaImp (a) (paFormulaImp (b) (a)) $;
def paAxiomProp2 (a b d: nat): nat = $ paFormulaImp (paFormulaImp (a) (paFormulaImp (b) (d))) (paFormulaImp (paFormulaImp (a) (b)) (paFormulaImp (a) (d))) $;
def paAxiomProp3 (a b: nat): nat = $ paFormulaImp (paFormulaImp (paFormulaImp (a) (paFormulaFalse)) (paFormulaImp (b) (paFormulaFalse))) (paFormulaImp (b) (a)) $;
def paAxiomFalseElim (a: nat): nat = $ paFormulaImp (paFormulaFalse) (a) $;
def paAxiomAndLeft (a b: nat): nat = $ paFormulaImp (paFormulaAnd (a) (b)) (a) $;
def paAxiomAndRight (a b: nat): nat = $ paFormulaImp (paFormulaAnd (a) (b)) (b) $;
def paAxiomAndIntro (a b: nat): nat = $ paFormulaImp (a) (paFormulaImp (b) (paFormulaAnd (a) (b))) $;
def paAxiomOrLeft (a b: nat): nat = $ paFormulaImp (a) (paFormulaOr (a) (b)) $;
def paAxiomOrRight (a b: nat): nat = $ paFormulaImp (b) (paFormulaOr (a) (b)) $;
def paAxiomOrElim (a b d: nat): nat = $ paFormulaImp (paFormulaImp (a) (d)) (paFormulaImp (paFormulaImp (b) (d)) (paFormulaImp (paFormulaOr (a) (b)) (d))) $;
def paAxiomAllElim (a b: nat): nat = $ paFormulaImp (paFormulaAll (a)) (paFormulaSubst 0 (b) (a)) $;
def paAxiomAllDistrib (a b: nat): nat = $ paFormulaImp (paFormulaAll (paFormulaImp (a) (b))) (paFormulaImp (paFormulaAll (a)) (paFormulaAll (b))) $;
def paAxiomAllVacuity (a: nat): nat = $ paFormulaImp (a) (paFormulaAll (paAxiomLift (a))) $;
def paAxiomExToDual (a: nat): nat = $ paFormulaImp (paFormulaEx (a)) (paFormulaImp (paFormulaAll (paFormulaImp (a) (paFormulaFalse))) (paFormulaFalse)) $;
def paAxiomDualToEx (a: nat): nat = $ paFormulaImp (paFormulaImp (paFormulaAll (paFormulaImp (a) (paFormulaFalse))) (paFormulaFalse)) (paFormulaEx (a)) $;
def paAxiomEqRefl (a: nat): nat = $ paFormulaEqual (a) (a) $;
def paAxiomEqSubst (a b d: nat): nat = $ paFormulaImp (paFormulaEqual (b) (d)) (paFormulaImp (paFormulaSubst 0 (b) (a)) (paFormulaSubst 0 (d) (a))) $;
def paAxiomSuccessorNonzero: nat = $ paFormulaAll (paFormulaImp (paFormulaEqual (paTermSuccessor (paTermVariable 0)) (paTermZero)) (paFormulaFalse)) $;
def paAxiomSuccessorInjective: nat = $ paFormulaAll (paFormulaAll (paFormulaImp (paFormulaEqual (paTermSuccessor (paTermVariable 1)) (paTermSuccessor (paTermVariable 0))) (paFormulaEqual (paTermVariable 1) (paTermVariable 0)))) $;
def paAxiomAdditionZero: nat = $ paFormulaAll (paFormulaEqual (paTermAddition (paTermVariable 0) (paTermZero)) (paTermVariable 0)) $;
def paAxiomAdditionSuccessor: nat = $ paFormulaAll (paFormulaAll (paFormulaEqual (paTermAddition (paTermVariable 1) (paTermSuccessor (paTermVariable 0))) (paTermSuccessor (paTermAddition (paTermVariable 1) (paTermVariable 0))))) $;
def paAxiomMultiplicationZero: nat = $ paFormulaAll (paFormulaEqual (paTermMultiplication (paTermVariable 0) (paTermZero)) (paTermZero)) $;
def paAxiomMultiplicationSuccessor: nat = $ paFormulaAll (paFormulaAll (paFormulaEqual (paTermMultiplication (paTermVariable 1) (paTermSuccessor (paTermVariable 0))) (paTermAddition (paTermMultiplication (paTermVariable 1) (paTermVariable 0)) (paTermVariable 1)))) $;
def paAxiomInduction (a: nat): nat = $ paFormulaImp (paFormulaSubst 0 (paTermZero) (a)) (paFormulaImp (paFormulaAll (paFormulaImp (a) (paAxiomNext (a)))) (paFormulaAll (a))) $;
def paAxiomCase (n j a b d c: nat): wff = $ (j = 0 /\ (paFormulaBound n a /\ paFormulaBound n b) /\ c = (paAxiomProp1 a b)) \/ ((j = 1 /\ (paFormulaBound n a /\ paFormulaBound n b /\ paFormulaBound n d) /\ c = (paAxiomProp2 a b d)) \/ ((j = 2 /\ (paFormulaBound n a /\ paFormulaBound n b) /\ c = (paAxiomProp3 a b)) \/ ((j = 3 /\ (paFormulaBound n a) /\ c = (paAxiomFalseElim a)) \/ ((j = 4 /\ (paFormulaBound n a /\ paFormulaBound n b) /\ c = (paAxiomAndLeft a b)) \/ ((j = 5 /\ (paFormulaBound n a /\ paFormulaBound n b) /\ c = (paAxiomAndRight a b)) \/ ((j = 6 /\ (paFormulaBound n a /\ paFormulaBound n b) /\ c = (paAxiomAndIntro a b)) \/ ((j = 7 /\ (paFormulaBound n a /\ paFormulaBound n b) /\ c = (paAxiomOrLeft a b)) \/ ((j = 8 /\ (paFormulaBound n a /\ paFormulaBound n b) /\ c = (paAxiomOrRight a b)) \/ ((j = 9 /\ (paFormulaBound n a /\ paFormulaBound n b /\ paFormulaBound n d) /\ c = (paAxiomOrElim a b d)) \/ ((j = 10 /\ (paFormulaBound (suc n) a /\ paTermBound n b) /\ c = (paAxiomAllElim a b)) \/ ((j = (suc 10) /\ (paFormulaBound (suc n) a /\ paFormulaBound (suc n) b) /\ c = (paAxiomAllDistrib a b)) \/ ((j = (suc (suc 10)) /\ (paFormulaBound n a) /\ c = (paAxiomAllVacuity a)) \/ ((j = (suc (suc (suc 10))) /\ (paFormulaBound (suc n) a) /\ c = (paAxiomExToDual a)) \/ ((j = (suc (suc (suc (suc 10)))) /\ (paFormulaBound (suc n) a) /\ c = (paAxiomDualToEx a)) \/ ((j = (suc (suc (suc (suc (suc 10))))) /\ (paTermBound n a) /\ c = (paAxiomEqRefl a)) \/ ((j = (suc (suc (suc (suc (suc (suc 10)))))) /\ (paFormulaBound (suc n) a /\ paTermBound n b /\ paTermBound n d) /\ c = (paAxiomEqSubst a b d)) \/ ((j = (suc (suc (suc (suc (suc (suc (suc 10))))))) /\ (0 = 0) /\ c = (paAxiomSuccessorNonzero)) \/ ((j = (suc (suc (suc (suc (suc (suc (suc (suc 10)))))))) /\ (0 = 0) /\ c = (paAxiomSuccessorInjective)) \/ ((j = (suc (suc (suc (suc (suc (suc (suc (suc (suc 10))))))))) /\ (0 = 0) /\ c = (paAxiomAdditionZero)) \/ ((j = (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc 10)))))))))) /\ (0 = 0) /\ c = (paAxiomAdditionSuccessor)) \/ ((j = (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc 10))))))))))) /\ (0 = 0) /\ c = (paAxiomMultiplicationZero)) \/ ((j = (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc 10)))))))))))) /\ (0 = 0) /\ c = (paAxiomMultiplicationSuccessor)) \/ ((j = (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc 10))))))))))))) /\ (paFormulaBound (suc n) a) /\ c = (paAxiomInduction a))))))))))))))))))))))))) $;
def paAxiomSyntax (n c w: nat): wff = $ paFormulaBound n c /\ paAxiomCase n (fst w) (fst (snd w)) (fst (snd (snd w))) (snd (snd (snd w))) c $;
def paProofRow (n c h: nat): nat = $ (n, (c, h)) $;
def paProofLevel (r: nat): nat = $ fst r $;
def paProofFormula (r: nat): nat = $ fst (snd r) $;
def paProofAnnotation (r: nat): nat = $ snd (snd r) $;
def paProofMPAnnotation (p q: nat): nat = $ (1, (p, q)) $;
def paProofGenAnnotation (p: nat): nat = $ (2, p) $;
def paProofRowWf (r: nat): wff = $ paFormulaBound (paProofLevel r) (paProofFormula r) $;
def paProofAxiom (r: nat): wff = $ fst (paProofAnnotation r) = 0 /\ paAxiomSyntax (paProofLevel r) (paProofFormula r) (snd (paProofAnnotation r)) $;
def paProofMP (r p q: nat): wff = $ paProofAnnotation r = paProofMPAnnotation p q /\ paProofLevel p = paProofLevel r /\ paProofLevel q = paProofLevel r /\ paProofFormula q = paFormulaImp (paProofFormula p) (paProofFormula r) $;
def paProofGen (r p: nat): wff = $ paProofAnnotation r = paProofGenAnnotation p /\ paProofLevel p = suc (paProofLevel r) /\ paProofFormula r = paFormulaAll (paProofFormula p) $;
def paProofLeftPremise (r: nat): nat = $ fst (snd (paProofAnnotation r)) $;
def paProofRightPremise (r: nat): nat = $ snd (snd (paProofAnnotation r)) $;
def paProofGenPremise (r: nat): nat = $ snd (paProofAnnotation r) $;
def paProofCase (r l: nat): wff = $ paProofRowWf r /\ (paProofAxiom r \/ ((paProofLeftPremise r IN l /\ paProofRightPremise r IN l /\ paProofMP r (paProofLeftPremise r) (paProofRightPremise r)) \/ (paProofGenPremise r IN l /\ paProofGen r (paProofGenPremise r)))) $;
def paProofRules (.r .l: nat): set = $ S\ r, {l | paProofCase r l} $;
def paProofDerives (p r: nat): wff = $ traceDerives paProofRules p r $;
def paProvable (n c .p .h: nat): wff = $ E. p E. h paProofDerives p (paProofRow n c h) $;
def sfFormulaClass (.a: nat): set = $ {a | sfWf a} $;
def sfContextWf (G: nat): wff = $ all sfFormulaClass G $;
def sfContextSub (G D: nat): wff = $ lmems G C_ lmems D $;
def sfSequent (G a: nat): nat = $ (0, G, a) $;
def sfBranches (G a b c: nat): nat = $ (1, G, a, b, c) $;
def sfRowWf (r: nat): wff =
$ ifp (fst r = 0)
  (sfContextWf (fst (snd r)) /\ sfWf (snd (snd r)))
  (fst r = 1 /\ (sfContextWf (fst (snd r)) /\
    (sfWf (fst (snd (snd r))) /\
    (sfWf (fst (snd (snd (snd r)))) /\ sfWf (snd (snd (snd (snd r)))))))) $;
def sfShiftMap (.a: nat): set = $ \ a, sfShift 0 a $;
def sfContextShift (G: nat): nat = $ map sfShiftMap G $;
def zfcRefl: nat = $ sfAll (sfEq 0 0) $;
def zfcSym: nat = $ sfAll (sfAll (sfImp (sfEq 1 0) (sfEq 0 1))) $;
def zfcTrans: nat = $ sfAll (sfAll (sfAll (sfImp (sfEq 2 1) (sfImp (sfEq 1 0) (sfEq 2 0))))) $;
def zfcEqElem: nat = $ sfAll (sfAll (sfAll (sfAll (sfImp (sfEq 3 1) (sfImp (sfEq 2 0) (sfImp (sfMem 3 2) (sfMem 1 0))))))) $;
def zfcExt: nat = $ sfAll (sfAll (sfImp (sfAll (sfImp (sfMem 0 2) (sfMem 0 1))) (sfImp (sfAll (sfImp (sfMem 0 1) (sfMem 0 2))) (sfEq 1 0)))) $;
def zfcEmpty: nat = $ sfEx (sfAll (sfImp (sfMem 0 1) (sfBot))) $;
def zfcPair: nat = $ sfAll (sfAll (sfEx (sfAll (sfAnd (sfImp (sfMem 0 1) (sfOr (sfEq 0 3) (sfEq 0 2))) (sfImp (sfOr (sfEq 0 3) (sfEq 0 2)) (sfMem 0 1)))))) $;
def zfcUnion: nat = $ sfAll (sfEx (sfAll (sfAnd (sfImp (sfMem 0 1) (sfEx (sfAnd (sfMem 0 3) (sfMem 1 0)))) (sfImp (sfEx (sfAnd (sfMem 0 3) (sfMem 1 0))) (sfMem 0 1))))) $;
def zfcPower: nat = $ sfAll (sfEx (sfAll (sfAnd (sfImp (sfMem 0 1) (sfAll (sfImp (sfMem 0 1) (sfMem 0 3)))) (sfImp (sfAll (sfImp (sfMem 0 1) (sfMem 0 3))) (sfMem 0 1))))) $;
def zfcOmega: nat = $ sfEx (sfAnd (sfAnd (sfEx (sfAnd (sfAll (sfImp (sfMem 0 1) (sfBot))) (sfMem 0 1))) (sfAll (sfImp (sfMem 0 1) (sfEx (sfAnd (sfAll (sfAnd (sfImp (sfMem 0 1) (sfOr (sfMem 0 2) (sfEq 0 2))) (sfImp (sfOr (sfMem 0 2) (sfEq 0 2)) (sfMem 0 1)))) (sfMem 0 2)))))) (sfAll (sfImp (sfAnd (sfEx (sfAnd (sfAll (sfImp (sfMem 0 1) (sfBot))) (sfMem 0 1))) (sfAll (sfImp (sfMem 0 1) (sfEx (sfAnd (sfAll (sfAnd (sfImp (sfMem 0 1) (sfOr (sfMem 0 2) (sfEq 0 2))) (sfImp (sfOr (sfMem 0 2) (sfEq 0 2)) (sfMem 0 1)))) (sfMem 0 2)))))) (sfAll (sfImp (sfMem 0 2) (sfMem 0 1)))))) $;
def zfcFoundation: nat = $ sfAll (sfImp (sfEx (sfMem 0 1)) (sfEx (sfAnd (sfMem 0 1) (sfAll (sfImp (sfMem 0 1) (sfImp (sfMem 0 2) (sfBot))))))) $;
def zfcChoice: nat = $ sfAll (sfImp (sfAll (sfImp (sfMem 0 1) (sfEx (sfMem 0 1)))) (sfImp (sfAll (sfImp (sfMem 0 1) (sfAll (sfImp (sfMem 0 2) (sfImp (sfImp (sfEq 1 0) (sfBot)) (sfImp (sfEx (sfAnd (sfMem 0 2) (sfMem 0 1))) (sfBot))))))) (sfEx (sfAll (sfImp (sfMem 0 2) (sfEx (sfAnd (sfAnd (sfMem 0 1) (sfMem 0 2)) (sfAll (sfImp (sfMem 0 2) (sfImp (sfMem 0 3) (sfEq 0 1))))))))))) $;
def zfcFixed (n: nat): wff = $ n = zfcRefl \/ (n = zfcSym \/ (n = zfcTrans \/ (n = zfcEqElem \/ (n = zfcExt \/ (n = zfcEmpty \/ (n = zfcPair \/ (n = zfcUnion \/ (n = zfcPower \/ (n = zfcOmega \/ (n = zfcFoundation \/ (n = zfcChoice))))))))))) $;
def sfIff (a b: nat): nat = $ sfAnd (sfImp a b) (sfImp b a) $;
def sfSeparation (body: nat): nat =
$ sfAll (sfEx (sfAll (sfIff (sfMem 0 1) (sfAnd (sfMem 0 2) body)))) $;
def sfFunctionality (bodyA bodyB: nat): nat =
$ sfAll (sfAll (sfAll (sfImp bodyA (sfImp bodyB (sfEq 1 0))))) $;
def sfReplacement (bodyA bodyB bodyC: nat): nat =
$ sfImp (sfFunctionality bodyA bodyB)
    (sfAll (sfEx (sfAll
      (sfIff (sfMem 0 1) (sfEx (sfAnd (sfMem 0 3) bodyC)))))) $;
def sfAllPrefix (n c .a: nat): nat = $ rec c (\ a, sfAll a) n $;
def sfSepIndex (i: nat): nat = $ if (i = 0) 0 (i + 2) $;
def sfRepAIndex (i: nat): nat = $ if (i = 0) 2 (if (i = 1) 1 (i + 1)) $;
def sfRepBIndex (i: nat): nat = $ if (i = 0) 2 (if (i = 1) 0 (i + 1)) $;
def sfRepCIndex (i: nat): nat = $ if (i = 0) 0 (if (i = 1) 1 (i + 2)) $;
def sfSepMap (.i: nat): set = $ \ i, sfSepIndex i $;
def sfRepAMap (.i: nat): set = $ \ i, sfRepAIndex i $;
def sfRepBMap (.i: nat): set = $ \ i, sfRepBIndex i $;
def sfRepCMap (.i: nat): set = $ \ i, sfRepCIndex i $;
def zfcSeparationCode (phi n: nat): nat =
$ sfAllPrefix n (sfSeparation (sfRename sfSepMap 0 phi)) $;
def zfcReplacementCode (phi n: nat): nat =
$ sfAllPrefix n (sfReplacement
    (sfRename sfRepAMap 0 phi) (sfRename sfRepBMap 0 phi)
    (sfRename sfRepCMap 0 phi)) $;
def zfcClosedSeparation (z .phi .n: nat): wff =
$ sfBound 0 z /\ E. phi E. n
    (sfBound (suc n) phi /\ z = zfcSeparationCode phi n) $;
def zfcClosedReplacement (z .phi .n: nat): wff =
$ sfBound 0 z /\ E. phi E. n
    (sfBound (suc (suc n)) phi /\ z = zfcReplacementCode phi n) $;
def zfcAxioms (.z: nat): set =
$ {z | zfcFixed z \/ (zfcClosedSeparation z \/ zfcClosedReplacement z)} $;
def sfNDCaseCtx (r: nat) (.g .a: nat): wff = $ E. g E. a (r = sfSequent g a /\ a IN g) $;
def sfNDCasePc (r: nat) (.g .a .b: nat): wff = $ E. g E. a E. b (r = sfSequent g (sfImp (sfImp (sfImp a b) a) a)) $;
def sfNDCaseII (r p: nat) (.g .a .b: nat): wff = $ E. g E. a E. b (r = sfSequent g (sfImp a b) /\ p = sfSequent (a : g) b) $;
def sfNDCaseExp (r p: nat) (.g .a: nat): wff = $ E. g E. a (r = sfSequent g a /\ p = sfSequent g sfBot) $;
def sfNDCaseCE1 (r p: nat) (.g .a .b: nat): wff = $ E. g E. a E. b (r = sfSequent g a /\ p = sfSequent g (sfAnd a b)) $;
def sfNDCaseCE2 (r p: nat) (.g .a .b: nat): wff = $ E. g E. a E. b (r = sfSequent g b /\ p = sfSequent g (sfAnd a b)) $;
def sfNDCaseDI1 (r p: nat) (.g .a .b: nat): wff = $ E. g E. a E. b (r = sfSequent g (sfOr a b) /\ p = sfSequent g a) $;
def sfNDCaseDI2 (r p: nat) (.g .a .b: nat): wff = $ E. g E. a E. b (r = sfSequent g (sfOr a b) /\ p = sfSequent g b) $;
def sfNDCaseIE (r p q: nat) (.g .a .b: nat): wff = $ E. g E. a E. b (r = sfSequent g b /\ (p = sfSequent g (sfImp a b) /\ q = sfSequent g a)) $;
def sfNDCaseCI (r p q: nat) (.g .a .b: nat): wff = $ E. g E. a E. b (r = sfSequent g (sfAnd a b) /\ (p = sfSequent g a /\ q = sfSequent g b)) $;
def sfNDCaseBranchPair (r p q: nat) (.g .a .b .c: nat): wff = $ E. g E. a E. b E. c (r = sfBranches g a b c /\ (p = sfSequent (a : g) c /\ q = sfSequent (b : g) c)) $;
def sfNDCaseDE (r p q: nat) (.g .a .b .c: nat): wff = $ E. g E. a E. b E. c (r = sfSequent g c /\ (p = sfSequent g (sfOr a b) /\ q = sfBranches g a b c)) $;
def sfNDCaseWk (r p: nat) (.g .h .a: nat): wff = $ E. g E. h E. a (r = sfSequent h a /\ (p = sfSequent g a /\ sfContextSub g h)) $;
def sfNDPropBase (r: nat): wff =
$ sfRowWf r /\ (sfNDCaseCtx r \/ sfNDCasePc r) $;
def sfNDPropUnary (r p: nat): wff =
$ sfRowWf r /\ (sfNDCaseII r p \/ (sfNDCaseExp r p \/
  (sfNDCaseCE1 r p \/ (sfNDCaseCE2 r p \/
  (sfNDCaseDI1 r p \/ (sfNDCaseDI2 r p \/ sfNDCaseWk r p)))))) $;
def sfNDPropBinary (r p q: nat): wff =
$ sfRowWf r /\ (sfNDCaseIE r p q \/ (sfNDCaseCI r p q \/
  (sfNDCaseBranchPair r p q \/ sfNDCaseDE r p q))) $;
def sfNDPropRules (.r .l .p .q: nat): set =
$ S\ r, {l | sfNDPropBase r \/
  ((E. p (p IN l /\ sfNDPropUnary r p)) \/
   E. p E. q (p IN l /\ (q IN l /\ sfNDPropBinary r p q)))} $;
def sfNDCaseAllI (r p: nat) (.g .a: nat): wff = $ E. g E. a (r = sfSequent g (sfAll a) /\ p = sfSequent (sfContextShift g) a) $;
def sfNDCaseAllE (r p: nat) (.g .a .t: nat): wff = $ E. g E. a E. t (r = sfSequent g (sfSubst 0 t a) /\ p = sfSequent g (sfAll a)) $;
def sfNDCaseExI (r p: nat) (.g .a .t: nat): wff = $ E. g E. a E. t (r = sfSequent g (sfEx a) /\ p = sfSequent g (sfSubst 0 t a)) $;
def sfNDCaseExE (r p q: nat) (.g .a .c: nat): wff = $ E. g E. a E. c (r = sfSequent g c /\ (p = sfSequent g (sfEx a) /\ q = sfSequent (a : sfContextShift g) (sfShift 0 c))) $;
def sfNDQuantUnary (r p: nat): wff =
$ sfRowWf r /\ (sfNDCaseAllI r p \/ (sfNDCaseAllE r p \/ sfNDCaseExI r p)) $;
def sfNDQuantBinary (r p q: nat): wff = $ sfRowWf r /\ sfNDCaseExE r p q $;
def sfNDQuantRules (.r .l .p .q: nat): set =
$ S\ r, {l | (E. p (p IN l /\ sfNDQuantUnary r p)) \/
    E. p E. q (p IN l /\ (q IN l /\ sfNDQuantBinary r p q))} $;
def sfNDFullRules: set = $ sfNDPropRules u. sfNDQuantRules $;
def sfNDFullDerives (p r: nat): wff = $ traceDerives sfNDFullRules p r $;
