def tmAct (M q b: nat): nat = $ nth (q, b) M - 1 $;
def tmValidAction (k a: nat): wff = $ k215TMWrite a <= 1 /\ k215TMDir a <= 1 /\ k215TMTarget a <= k $;
def tmValid (k M .q .b: nat): wff = $ A. q A. b (q < k -> b < 2 -> tmValidAction k (tmAct M q b)) $;
def tmStep (k M s: nat): nat =
$ if (k215TMQ s < k) (k215TMMove (tmAct M (k215TMQ s) (k215TMR s % 2)) (k215TML s) (k215TMR s)) s $;
def tmRun (k M t s .x: nat): nat = $ rec s (\ x, tmStep k M x) t $;
def tmHalted (k M t: nat): wff = $ k215TMQ (tmRun k M t k215TMInitial) = k $;
def tmHalts (k M .t: nat): wff = $ E. t tmHalted k M t $;
def tmHaltsPA (k M: nat): nat = $ paFormulaSubst 0 (paTermNumeral M) (tmHaltsOpenPA k) $;
def bbSentencePA (n b: nat): nat = $ paFormulaSubst 0 (paTermNumeral b) (bbValueCode n) $;
def bbSentenceSource (n b: nat): nat = $ paFormulaSource (bbSentencePA n b) $;
def bb215ProvabilityInternalBridge (P H: nat): wff = $ paFormulaBound 0 H /\ paProvable 0 (paFormulaImp (bb215PrAt P paFormulaFalse) H) $;
def paSigma1 (c: nat): wff = $ paS1Class 1 c $;
def paSigma1True (c a: nat): wff = $ paS1Holds c (a : 0) $;
def thIsSigma1Rec (R: nat): wff = $ paFormulaBound 1 R /\ paSigma1 R $;
def thAxSet (R .a: nat): set = $ {a | sfBound 0 a /\ paSigma1True R a} $;
def zfcStdAxRecognizer: nat = $ g2szRz $;
def thExtendsZFC (R .a: nat): wff = $ A. a (a e. zfcAxioms -> a e. thAxSet R) /\ paProvable 0 (paFormulaAll (paFormulaImp zfcStdAxRecognizer R)) $;
def sfThProvable (R f: nat): wff = $ sfTheoryProvable (thAxSet R) f $;
def sfThInconsistent (R: nat): wff = $ sfThProvable R sfBot $;
def sfThMemCode: nat = $ g2sfMemCode $;
def sfThClosedCode: nat = $ g2sfClosedCode $;
def sfThCtxCode (R: nat): nat = $ paFormulaAll (paFormulaImp sfThMemCode (paFormulaAnd sfThClosedCode R)) $;
def zfcStdValidCode: nat = $ g2sfValidCode $;
def zfcStdGoalCode: nat = $ g2sfGoalCode $;
def sfThCode (R: nat): nat = $ paFormulaEx (paFormulaEx (paFormulaAnd (sfThCtxCode R) (paFormulaAnd zfcStdValidCode zfcStdGoalCode))) $;
def sfThPr (R: nat): nat = $ bb215ProvabilityImageFormula bb215L3pGsr (sfThCode R) $;
def sfThCon (R: nat): nat = $ bb215ProvabilityConsistencyPA (sfThPr R) $;
theorem G2_generic_set (R: nat)
  (hR: $ thIsSigma1Rec R $) (hZ: $ thExtendsZFC R $):
  $ ~sfThInconsistent R -> ~sfThProvable R (paFormulaSource (sfThCon R)) $;
theorem BB_generic_set_thm2 (R m n M: nat) {b: nat}
  (hR: $ thIsSigma1Rec R $) (hZ: $ thExtendsZFC R $)
  (hM: $ tmValid m M $) (hmn: $ m <= n $)
  (hT1: $ tmHalts m M <-> sfThInconsistent R $)
  (hB: $ bb215ProvabilityInternalBridge (sfThPr R) (tmHaltsPA m M) $):
  $ ~sfThInconsistent R <-> A. b ~sfThProvable R (bbSentenceSource n b) $;
theorem BB_generic_set_thm3 (R m n M: nat) {b: nat}
  (hR: $ thIsSigma1Rec R $) (hZ: $ thExtendsZFC R $)
  (hM: $ tmValid m M $) (hmn: $ m <= n $)
  (hT1: $ tmHalts m M <-> sfThInconsistent R $)
  (hB: $ bb215ProvabilityInternalBridge (sfThPr R) (tmHaltsPA m M) $):
  $ (~sfThInconsistent R <-> ~tmHalts m M) /\
    (~tmHalts m M <-> A. b ~sfThProvable R (bbSentenceSource n b)) $;
theorem BB_generic_set_thm2_P (A: set) (P G m n M: nat) {a b c: nat}
  (hA: $ zfcAxioms C_ A $)
  (hP: $ paFormulaBound 1 P $)
  (h1: $ A. c bb215ProvabilityD1T A bb215G2ASrc P c $)
  (h2: $ A. a A. b bb215ProvabilityD2 P a b $)
  (h3: $ A. a bb215ProvabilityD3 P a $)
  (hG: $ bb215ProvabilityFixedPoint P G $)
  (hM: $ tmValid m M $) (hmn: $ m <= n $)
  (hT1: $ tmHalts m M <-> sfTheoryProvable A sfBot $)
  (hB: $ bb215ProvabilityInternalBridge P (tmHaltsPA m M) $):
  $ ~sfTheoryProvable A sfBot <-> A. b ~sfTheoryProvable A (bbSentenceSource n b) $;
theorem BB_generic_set_thm3_P (A: set) (P G m n M: nat) {a b c: nat}
  (hA: $ zfcAxioms C_ A $)
  (hP: $ paFormulaBound 1 P $)
  (h1: $ A. c bb215ProvabilityD1T A bb215G2ASrc P c $)
  (h2: $ A. a A. b bb215ProvabilityD2 P a b $)
  (h3: $ A. a bb215ProvabilityD3 P a $)
  (hG: $ bb215ProvabilityFixedPoint P G $)
  (hM: $ tmValid m M $) (hmn: $ m <= n $)
  (hT1: $ tmHalts m M <-> sfTheoryProvable A sfBot $)
  (hB: $ bb215ProvabilityInternalBridge P (tmHaltsPA m M) $):
  $ (~sfTheoryProvable A sfBot <-> ~tmHalts m M) /\
    (~tmHalts m M <-> A. b ~sfTheoryProvable A (bbSentenceSource n b)) $;
