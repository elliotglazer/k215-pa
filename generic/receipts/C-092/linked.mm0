def paS1Fn (c e: nat): nat = $ (3, c, e) $;
def paS1RLk (m v i e x .j .y .f: nat): wff = $ (e = 0 /\ x = 0) \/ (i = 0 /\ E. f e = x : f) \/
  E. j E. y E. f (i = suc j /\ e = y : f /\ paS1In m v (paS1Lk j f x)) $;
def paS1RTv (m v t e x .i .a .b .y .z: nat): wff = $ (t = paTermZero /\ x = 0) \/
  E. i (t = paTermVariable i /\ paS1In m v (paS1Lk i e x)) \/
  E. a E. y (t = paTermSuccessor a /\ x = suc y /\ paS1In m v (paS1Tv a e y)) \/
  E. a E. b E. y E. z (t = paTermAddition a b /\ x = y + z /\ paS1In m v (paS1Tv a e y) /\ paS1In m v (paS1Tv b e z)) \/
