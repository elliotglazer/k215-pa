def paSITermSuccMap (.i: nat): set = $ \ i, if (i = 0) 0 (suc (i)) $;
def paSITermLeftMap (.i: nat): set = $ \ i, if (i = 0) 1 (suc (suc (i))) $;
def paSITermRightMap (.i: nat): set = $ \ i, if (i = 0) 0 (suc (suc (i))) $;
def paSIFormulaLeftMap (.i: nat): set = $ \ i, if (i = 0) 1 (suc (i)) $;
def paSourceTermVariable (i: nat): nat = $ sfEq 0 (suc i) $;
def paSourceTermZero: nat = $ paSourceZero $;
def paSourceTermSuccessor (a: nat): nat = $ sfEx (sfAnd (sfRename paSITermSuccMap 0 a) paSourceSuccessor) $;
def paSourceTermAddition (a b: nat): nat = $ sfEx (sfEx (sfAnd (sfRename paSITermLeftMap 0 a) (sfAnd (sfRename paSITermRightMap 0 b) paSourceAddition102))) $;
def paSourceTermMultiplication (a b: nat): nat = $ sfEx (sfEx (sfAnd (sfRename paSITermLeftMap 0 a) (sfAnd (sfRename paSITermRightMap 0 b) paSourceMultiplication102))) $;
def paSourceFormulaEqual (a b: nat): nat = $ sfEx (sfEx (sfAnd (sfRename paSIFormulaLeftMap 0 a) (sfAnd (sfRename paSITermSuccMap 0 b) (sfEq 1 0)))) $;
def paSourceFormulaAll (a: nat): nat = $ sfAll (sfImp paSourceNatural a) $;
def paSourceFormulaEx (a: nat): nat = $ sfEx (sfAnd paSourceNatural a) $;
def paTermSourceBody (c h: nat): nat = $ if (c = 0) paSourceTermZero
 (if (sfTag c = 1) (paSourceTermVariable (sfLeft c))
 (if (sfTag c = 2) (paSourceTermSuccessor (h @ (sfLeft c)))
 (if (sfTag c = 3) (paSourceTermAddition (h @ (sfLeft c)) (h @ (sfRight c)))
 (if (sfTag c = 4) (paSourceTermMultiplication (h @ (sfLeft c)) (h @ (sfRight c))) paSourceTermZero)))) $;
def paTermSourceStep (.h: nat): set = $ \ h, paTermSourceBody (sfHistoryLength h) h $;
def paTermSource (c: nat): nat = $ srec paTermSourceStep c $;
def paFormulaSourceBody (c h: nat): nat = $ if (c = 0) 0 (if (sfTag c = 1) (paSourceFormulaEqual (paTermSource (sfLeft c)) (paTermSource (sfRight c))) (if (sfTag c = 3) (sfAnd (h @ (sfLeft c)) (h @ (sfRight c))) (if (sfTag c = 4) (sfOr (h @ (sfLeft c)) (h @ (sfRight c))) (if (sfTag c = 5) (sfImp (h @ (sfLeft c)) (h @ (sfRight c))) (if (sfTag c = 6 /\ sfRight c = 0) (paSourceFormulaAll (h @ (sfLeft c))) (if (sfTag c = 7 /\ sfRight c = 0) (paSourceFormulaEx (h @ (sfLeft c))) 0)))))) $;
def paFormulaSourceStep (.h: nat): set = $ \ h, paFormulaSourceBody (sfHistoryLength h) h $;
def paFormulaSource (c: nat): nat = $ srec paFormulaSourceStep c $;
def sfTheoryContext (A: set) (G: nat): wff = $ all A G $;
def sfTheoryProvable (A: set) (f .G .p: nat): wff =
$ E. G E. p (sfTheoryContext A G /\ sfNDFullDerives p (sfSequent G f)) $;
def paTermNumeral (n .a: nat): nat = $ rec paTermZero (\ a, paTermSuccessor a) n $;
def bb215PrAt (P x: nat): nat = $ paFormulaSubst 0 (paTermNumeral x) P $;
def bb215ProvabilityD2 (P a b: nat): wff = $ paFormulaBound 0 a -> paFormulaBound 0 b -> paProvable 0 (paFormulaImp (bb215PrAt P (paFormulaImp a b)) (paFormulaImp (bb215PrAt P a) (bb215PrAt P b))) $;
def bb215ProvabilityD3 (P a: nat): wff = $ paFormulaBound 0 a -> paProvable 0 (paFormulaImp (bb215PrAt P a) (bb215PrAt P (bb215PrAt P a))) $;
def bb215ProvabilityFixedPoint (P G: nat): wff = $ paFormulaBound 0 G /\ paProvable 0 (paFormulaImp G (paFormulaImp (bb215PrAt P G) paFormulaFalse)) /\ paProvable 0 (paFormulaImp (paFormulaImp (bb215PrAt P G) paFormulaFalse) G) $;
def bb215ProvabilityConsistencyPA (P: nat): nat = $ paFormulaImp (bb215PrAt P paFormulaFalse) paFormulaFalse $;
def paNatTermConsEnvironment (E: set) (v .i: nat): set = $ \ i, if (i = 0) v (E @ (i - 1)) $;
def bb215ProvabilityImageFormula (S Q: nat): nat = $ paFormulaEx (paFormulaAnd S Q) $;
def bb215S1Arg (j: nat) (.i: nat): set = $ \ i, j $;
def paTermLowerBoundAllowed (n c h: nat): wff = $ ifp (c = 0) (0 = 0)
 (ifp (sfTag c = 1) (sfRight c = 0 /\ n <= sfLeft c)
