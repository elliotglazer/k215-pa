--| Friedman negation `p ->A` (`~p` is the instance A := F.).
local def ng (p A: wff): wff = $ p -> A $;
--| Friedman double negation.
local def dn (p A: wff): wff = $ (p -> A) -> A $;
--| Translation of peano's `E. x p := ~(A. x ~p)`.
