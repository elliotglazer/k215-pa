-- eqG / elG / nsing: introduction and elimination
theorem eqGe {u v: nat} (X Y: set) (A: wff): $ eqG X Y A -> u e. X -> v e. Y -> dn (u = v) A $ =
  '(syl ax_sp ax_sp);
theorem eqGc {u v: nat} (X Y: set) (A: wff) (h: $ u e. X -> v e. Y -> dn (u = v) A $):
  $ eqG X Y A $ = '(ax_gen (ax_gen h));
