-- Statements of the hpeano-test.mm1 lemmas. mm0-c has no import, so join first:
--   tools/mm0-rs compile foundation/hpeano-test.mm1 build/hpt.mmb
--   tools/mm0-rs join foundation/hpeano-test.mm0 build/hpt.mm0
--   tools/mm0-c build/hpt.mmb < build/hpt.mm0
import "hpeano.mm0";
theorem id (a: wff): $ a -> a $;
theorem syl (a b c: wff): $ b -> c $ > $ a -> b $ > $ a -> c $;
theorem itru: $ T. $;
theorem notimp (a b: wff): $ ~a -> a -> b $;
theorem imim2i (a b c: wff): $ b -> c $ > $ (a -> b) -> (a -> c) $;
theorem ax_10 {x: nat} (p: wff x): $ ~(A. x p) -> A. x ~(A. x p) $;
theorem orcom (a b: wff): $ a \/ b -> b \/ a $;
theorem eqid (a: nat): $ a = a $;
theorem indi {x: nat} (p: wff x): $ [ 0 / x ] p $ > $ p -> [ suc x / x ] p $ > $ A. x p $;
theorem alex {x: nat} (p: wff x): $ A. x p -> E. x p $;
