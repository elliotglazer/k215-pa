--| `bdK215Act q c w d t`: row (q, c) of the literal K215 table is the action
--| (write w, direction d, target t). Mirrors k215TMAction for q < 215, c < 2.
def bdK215Act (q c w d t: nat): wff =
$ bdK215ActBlock0 q c w d t \/
  bdK215ActBlock1 q c w d t \/
  bdK215ActBlock2 q c w d t \/
  bdK215ActBlock3 q c w d t \/
  bdK215ActBlock4 q c w d t \/
  bdK215ActBlock5 q c w d t \/
  bdK215ActBlock6 q c w d t \/
  bdK215ActBlock7 q c w d t \/
  bdK215ActBlock8 q c w d t \/
  bdK215ActBlock9 q c w d t \/
  bdK215ActBlock10 q c w d t \/
  bdK215ActBlock11 q c w d t \/
  bdK215ActBlock12 q c w d t \/
  bdK215ActBlock13 q c w d t \/
  bdK215ActBlock14 q c w d t \/
  bdK215ActBlock15 q c w d t \/
  bdK215ActBlock16 q c w d t \/
  bdK215ActBlock17 q c w d t \/
  bdK215ActBlock18 q c w d t \/
  bdK215ActBlock19 q c w d t \/
  bdK215ActBlock20 q c w d t \/
  bdK215ActBlock21 q c w d t $;

--| u = k215TMMove (w, d, t) l r, with r = 2 * rh + (bit).
def bdK215Move (w d t l rh u .lh .lc: nat): wff =
$ E. lh (lh <= l /\ E. lc (lc <= l /\ bdHalf l lh lc /\
  ((d = 0 /\ bdState t lh (lc + 2 * w + 4 * rh) u) \/
   (d != 0 /\ bdState t (2 * l + w) rh u)))) $;

--| u = k215TMStep s.
def bdK215Step (s u .q .l .r .rh .c .w .d .t: nat): wff =
$ E. q (q <= s /\ E. l (l <= s /\ E. r (r <= s /\ bdState q l r s /\
  ((q < bdNum 2 1 5 /\ E. rh (rh <= r /\ E. c (c <= r /\ bdHalf r rh c /\
     E. w (w <= 1 /\ E. d (d <= 1 /\ E. t (t <= bdNum 2 1 5 /\
       bdK215Act q c w d t /\ bdK215Move w d t l rh u)))))) \/
   (~ q < bdNum 2 1 5 /\ u = s))))) $;

--| the state s has halted (k215TMQ s = 215).
def bdK215Halted (s .q .l .r: nat): wff =
$ E. q (q <= s /\ E. l (l <= s /\ E. r (r <= s /\ bdState q l r s /\
  q = bdNum 2 1 5))) $;

--| every element of the set (m, v) is a pair (n, s) with s the initial state 0
--| (n = 0) or a K215 step from an element (n - 1, s') of the set.
def bdK215Trace (m v .k .n .s .j .n2 .s2: nat): wff =
$ A. k (k < v -> bdCell m v k -> E. n (n <= k /\ E. s (s <= k /\ bdPair n s k /\
  ((n = 0 /\ s = 0) \/
   E. j (j < v /\ bdCell m v j /\ E. n2 (n2 <= j /\ E. s2 (s2 <= j /\
     bdPair n2 s2 j /\ n = suc n2 /\ bdK215Step s2 s))))))) $;

--| D_H: h = (m, v) codes a K215 run history that reaches the halt state 215.
def bdK215Halt (h .m .v .k .n .s: nat): wff =
$ E. m (m <= h /\ E. v (v <= h /\ bdPair m v h /\ bdK215Trace m v /\
  E. k (k < v /\ bdCell m v k /\ E. n (n <= k /\ E. s (s <= k /\
    bdPair n s k /\ bdK215Halted s))))) $;

-- ===================================================================
-- D_I: ZFC derivation of falsity (zfc_proofs.mm0 and its closure)
-- ===================================================================
-- A certificate is w = (m, (v, B)): a finite set of indexed facts
-- (i, (tag, (a, (b, (c, d))))) coded by (m, v), each justified by facts of
-- smaller index, plus a bound B for witnesses that are not sub-codes.

--| n = sfNode t a b = 8 * (a, b) + t with t < 8 (so t = sfTag n).
def bdNode (t a b n .k: nat): wff =
$ t < 8 /\ E. k (k <= n /\ bdPair a b k /\ n = 8 * k + t) $;

--| c = a : l  (peano `cons` = suc (a, l)).
def bdCons (a l c .k: nat): wff = $ E. k (k < c /\ bdPair a l k /\ c = suc k) $;

--| r = sfSequent g a = (0, g, a).
def bdSeq (g a r .k: nat): wff = $ E. k (k <= r /\ bdPair g a k /\ bdPair 0 k r) $;

--| r = sfBranches g a b c = (1, g, a, b, c).
def bdBr (g a b c r .k .j .i: nat): wff =
$ E. k (k <= r /\ bdPair 1 k r /\ E. j (j <= k /\ bdPair g j k /\
  E. i (i <= j /\ bdPair a i j /\ bdPair b c i))) $;

--| n = sfIff a b = sfAnd (sfImp a b) (sfImp b a).
def bdIff (a b n .x .y: nat): wff =
$ E. x (x <= n /\ E. y (y <= n /\ bdNode 5 a b x /\ bdNode 5 b a y /\
  bdNode 3 x y n)) $;

--| n = sfSeparation p.
def bdSepSkel (p n .a .b .c .e .f .g: nat): wff =
$ E. a (a <= n /\ bdNode 6 a 0 n /\ E. b (b <= a /\ bdNode 7 b 0 a /\
  E. c (c <= b /\ bdNode 6 c 0 b /\ E. e (e <= c /\ E. f (f <= c /\
    bdIff e f c /\ bdNode 1 0 1 e /\
    E. g (g <= f /\ bdNode 3 g p f /\ bdNode 1 0 2 g)))))) $;

--| n = sfFunctionality p q.
def bdFunSkel (p q n .a .b .c .e .f: nat): wff =
$ E. a (a <= n /\ bdNode 6 a 0 n /\ E. b (b <= a /\ bdNode 6 b 0 a /\
  E. c (c <= b /\ bdNode 6 c 0 b /\ E. e (e <= c /\ bdNode 5 p e c /\
    E. f (f <= e /\ bdNode 5 q f e /\ bdNode 2 1 0 f))))) $;

--| n = sfReplacement p q r.
def bdRepSkel (p q r n .x .y .a .b .c .e .f .g .h: nat): wff =
$ E. x (x <= n /\ E. y (y <= n /\ bdNode 5 x y n /\ bdFunSkel p q x /\
  E. a (a <= y /\ bdNode 6 a 0 y /\ E. b (b <= a /\ bdNode 7 b 0 a /\
    E. c (c <= b /\ bdNode 6 c 0 b /\ E. e (e <= c /\ E. f (f <= c /\
      bdIff e f c /\ bdNode 1 0 1 e /\ E. g (g <= f /\ bdNode 7 g 0 f /\
        E. h (h <= g /\ bdNode 3 h r g /\ bdNode 1 0 3 h))))))))) $;

-- the 12 fixed axioms (hash-consed node relations)
def bdZfcSub1 (z: nat): wff = $ bdNode 2 0 0 z $;
def bdZfcRefl (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub1 a) $;
def bdZfcSub2 (z: nat): wff = $ bdNode 2 1 0 z $;
def bdZfcSub3 (z: nat): wff = $ bdNode 2 0 1 z $;
def bdZfcSub4 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub2 a /\ bdZfcSub3 b)) $;
def bdZfcSub5 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub4 a) $;
def bdZfcSym (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub5 a) $;
def bdZfcSub6 (z: nat): wff = $ bdNode 2 2 1 z $;
def bdZfcSub7 (z: nat): wff = $ bdNode 2 2 0 z $;
def bdZfcSub8 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub2 a /\ bdZfcSub7 b)) $;
def bdZfcSub9 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub6 a /\ bdZfcSub8 b)) $;
def bdZfcSub10 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub9 a) $;
def bdZfcSub11 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub10 a) $;
def bdZfcTrans (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub11 a) $;
def bdZfcSub12 (z: nat): wff = $ bdNode 2 3 1 z $;
def bdZfcSub13 (z: nat): wff = $ bdNode 1 3 2 z $;
def bdZfcSub14 (z: nat): wff = $ bdNode 1 1 0 z $;
def bdZfcSub15 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub13 a /\ bdZfcSub14 b)) $;
def bdZfcSub16 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub7 a /\ bdZfcSub15 b)) $;
def bdZfcSub17 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub12 a /\ bdZfcSub16 b)) $;
def bdZfcSub18 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub17 a) $;
def bdZfcSub19 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub18 a) $;
def bdZfcSub20 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub19 a) $;
def bdZfcEqElem (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub20 a) $;
def bdZfcSub21 (z: nat): wff = $ bdNode 1 0 2 z $;
def bdZfcSub22 (z: nat): wff = $ bdNode 1 0 1 z $;
def bdZfcSub23 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub21 a /\ bdZfcSub22 b)) $;
def bdZfcSub24 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub23 a) $;
def bdZfcSub25 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub22 a /\ bdZfcSub21 b)) $;
def bdZfcSub26 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub25 a) $;
def bdZfcSub27 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub26 a /\ bdZfcSub2 b)) $;
def bdZfcSub28 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub24 a /\ bdZfcSub27 b)) $;
def bdZfcSub29 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub28 a) $;
def bdZfcExt (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub29 a) $;
def bdZfcSub30 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 5 a 0 z /\ bdZfcSub22 a) $;
def bdZfcSub31 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub30 a) $;
def bdZfcEmpty (z .a: nat): wff = $ E. a (a <= z /\ bdNode 7 a 0 z /\ bdZfcSub31 a) $;
def bdZfcSub32 (z: nat): wff = $ bdNode 2 0 3 z $;
def bdZfcSub33 (z: nat): wff = $ bdNode 2 0 2 z $;
def bdZfcSub34 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 4 a b z /\ bdZfcSub32 a /\ bdZfcSub33 b)) $;
def bdZfcSub35 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub22 a /\ bdZfcSub34 b)) $;
def bdZfcSub36 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub34 a /\ bdZfcSub22 b)) $;
def bdZfcSub37 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 3 a b z /\ bdZfcSub35 a /\ bdZfcSub36 b)) $;
def bdZfcSub38 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub37 a) $;
def bdZfcSub39 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 7 a 0 z /\ bdZfcSub38 a) $;
def bdZfcSub40 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub39 a) $;
def bdZfcPair (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub40 a) $;
def bdZfcSub41 (z: nat): wff = $ bdNode 1 0 3 z $;
def bdZfcSub42 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 3 a b z /\ bdZfcSub41 a /\ bdZfcSub14 b)) $;
def bdZfcSub43 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 7 a 0 z /\ bdZfcSub42 a) $;
def bdZfcSub44 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub22 a /\ bdZfcSub43 b)) $;
def bdZfcSub45 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub43 a /\ bdZfcSub22 b)) $;
def bdZfcSub46 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 3 a b z /\ bdZfcSub44 a /\ bdZfcSub45 b)) $;
def bdZfcSub47 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub46 a) $;
def bdZfcSub48 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 7 a 0 z /\ bdZfcSub47 a) $;
def bdZfcUnion (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub48 a) $;
def bdZfcSub49 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub22 a /\ bdZfcSub41 b)) $;
def bdZfcSub50 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub49 a) $;
def bdZfcSub51 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub22 a /\ bdZfcSub50 b)) $;
def bdZfcSub52 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub50 a /\ bdZfcSub22 b)) $;
def bdZfcSub53 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 3 a b z /\ bdZfcSub51 a /\ bdZfcSub52 b)) $;
def bdZfcSub54 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub53 a) $;
def bdZfcSub55 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 7 a 0 z /\ bdZfcSub54 a) $;
def bdZfcPower (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub55 a) $;
def bdZfcSub56 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 3 a b z /\ bdZfcSub31 a /\ bdZfcSub22 b)) $;
def bdZfcSub57 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 7 a 0 z /\ bdZfcSub56 a) $;
def bdZfcSub58 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 4 a b z /\ bdZfcSub21 a /\ bdZfcSub33 b)) $;
def bdZfcSub59 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub22 a /\ bdZfcSub58 b)) $;
def bdZfcSub60 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub58 a /\ bdZfcSub22 b)) $;
def bdZfcSub61 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 3 a b z /\ bdZfcSub59 a /\ bdZfcSub60 b)) $;
def bdZfcSub62 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub61 a) $;
def bdZfcSub63 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 3 a b z /\ bdZfcSub62 a /\ bdZfcSub21 b)) $;
def bdZfcSub64 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 7 a 0 z /\ bdZfcSub63 a) $;
def bdZfcSub65 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub22 a /\ bdZfcSub64 b)) $;
def bdZfcSub66 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub65 a) $;
def bdZfcSub67 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 3 a b z /\ bdZfcSub57 a /\ bdZfcSub66 b)) $;
def bdZfcSub68 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub67 a /\ bdZfcSub24 b)) $;
def bdZfcSub69 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub68 a) $;
def bdZfcSub70 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 3 a b z /\ bdZfcSub67 a /\ bdZfcSub69 b)) $;
def bdZfcOmega (z .a: nat): wff = $ E. a (a <= z /\ bdNode 7 a 0 z /\ bdZfcSub70 a) $;
def bdZfcSub71 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 7 a 0 z /\ bdZfcSub22 a) $;
def bdZfcSub72 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 5 a 0 z /\ bdZfcSub21 a) $;
def bdZfcSub73 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub22 a /\ bdZfcSub72 b)) $;
def bdZfcSub74 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub73 a) $;
def bdZfcSub75 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 3 a b z /\ bdZfcSub22 a /\ bdZfcSub74 b)) $;
def bdZfcSub76 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 7 a 0 z /\ bdZfcSub75 a) $;
def bdZfcSub77 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub71 a /\ bdZfcSub76 b)) $;
def bdZfcFoundation (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub77 a) $;
def bdZfcSub78 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub22 a /\ bdZfcSub71 b)) $;
def bdZfcSub79 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub78 a) $;
def bdZfcSub80 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 5 a 0 z /\ bdZfcSub2 a) $;
def bdZfcSub81 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 3 a b z /\ bdZfcSub21 a /\ bdZfcSub22 b)) $;
def bdZfcSub82 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 7 a 0 z /\ bdZfcSub81 a) $;
def bdZfcSub83 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 5 a 0 z /\ bdZfcSub82 a) $;
def bdZfcSub84 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub80 a /\ bdZfcSub83 b)) $;
def bdZfcSub85 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub21 a /\ bdZfcSub84 b)) $;
def bdZfcSub86 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub85 a) $;
def bdZfcSub87 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub22 a /\ bdZfcSub86 b)) $;
def bdZfcSub88 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub87 a) $;
def bdZfcSub89 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 3 a b z /\ bdZfcSub22 a /\ bdZfcSub21 b)) $;
def bdZfcSub90 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub41 a /\ bdZfcSub3 b)) $;
def bdZfcSub91 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub21 a /\ bdZfcSub90 b)) $;
def bdZfcSub92 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub91 a) $;
def bdZfcSub93 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 3 a b z /\ bdZfcSub89 a /\ bdZfcSub92 b)) $;
def bdZfcSub94 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 7 a 0 z /\ bdZfcSub93 a) $;
def bdZfcSub95 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub21 a /\ bdZfcSub94 b)) $;
def bdZfcSub96 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub95 a) $;
def bdZfcSub97 (z .a: nat): wff = $ E. a (a <= z /\ bdNode 7 a 0 z /\ bdZfcSub96 a) $;
def bdZfcSub98 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub88 a /\ bdZfcSub97 b)) $;
def bdZfcSub99 (z .a .b: nat): wff = $ E. a (a <= z /\ E. b (b <= z /\ bdNode 5 a b z /\ bdZfcSub79 a /\ bdZfcSub98 b)) $;
def bdZfcChoice (z .a: nat): wff = $ E. a (a <= z /\ bdNode 6 a 0 z /\ bdZfcSub99 a) $;
--| z is one of the 12 fixed axiom codes of zfc_fixed.mm0 (zfcFixed).
def bdZfcFixed (z: nat): wff =
$ bdZfcRefl z \/
  bdZfcSym z \/
  bdZfcTrans z \/
  bdZfcEqElem z \/
  bdZfcExt z \/
  bdZfcEmpty z \/
  bdZfcPair z \/
  bdZfcUnion z \/
  bdZfcPower z \/
  bdZfcOmega z \/
  bdZfcFoundation z \/
  bdZfcChoice z $;

-- fact tags
def bdtIn: nat = $ 1 $;       -- (a, l):      a IN l
def bdtSub: nat = $ 2 $;      -- (g, h):      sfContextSub g h
def bdtWf: nat = $ 3 $;       -- (a):         sfWf a
def bdtCwf: nat = $ 4 $;      -- (g):         sfContextWf g
def bdtRow: nat = $ 5 $;      -- (r):         sfRowWf r
def bdtBnd: nat = $ 6 $;      -- (n, c):      sfBound n c
def bdtShift: nat = $ 7 $;    -- (d, c, y):   sfShift d c = y
def bdtSubst: nat = $ 8 $;    -- (d, s, c, y): sfSubst d s c = y
def bdtRen: nat = $ 9 $;      -- (e, d, c, y): sfRename (map e) d c = y, e < 4
def bdtAllPre: nat = $ 10 $;  -- (n, c, y):   sfAllPrefix n c = y
def bdtCShift: nat = $ 10 + 1 $; -- (g, y):   sfContextShift g = y
def bdtAx: nat = $ 10 + 2 $;  -- (z):         z e. zfcAxioms
def bdtCax: nat = $ 10 + 3 $; -- (g):         zfcContext g
def bdtValid: nat = $ 10 + 4 $; -- (p):       traceValid sfNDFullRules p

--| k = (i, (g, (a, (b, (c, d))))): fact with index i, tag g, arguments a b c d.
def bdTup (i g a b c d k .x .y .z .u: nat): wff =
$ E. x (x <= k /\ bdPair i x k /\ E. y (y <= x /\ bdPair g y x /\
  E. z (z <= y /\ bdPair a z y /\ E. u (u <= z /\ bdPair b u z /\
    bdPair c d u)))) $;

--| the set (m, v) holds the fact (g, a, b, c, d) at some index below i.
def bdHas (m v i g a b c d .k .j: nat): wff =
$ E. k (k < v /\ bdCell m v k /\ E. j (j < i /\ bdTup j g a b c d k)) $;

-- index maps of sfShift, sfSubst, sfRename (sfShiftIndex, sfSubstIndex,
-- sfRenameIndex with the four maps of zfc_schema_maps.mm0)
def bdShIdx (d i j: nat): wff = $ (i < d /\ j = i) \/ (~ i < d /\ j = suc i) $;
def bdSbIdx (d s i j: nat): wff =
$ (i < d /\ j = i) \/ (i = d /\ j = s + d) \/ (d < i /\ suc j = i) $;
def bdRnMap (e i j: nat): wff =
$ (e = 0 /\ ((i = 0 /\ j = 0) \/ (i != 0 /\ j = i + 2))) \/
  (e = 1 /\ ((i = 0 /\ j = 2) \/ (i = 1 /\ j = 1) \/ (1 < i /\ j = i + 1))) \/
  (e = 2 /\ ((i = 0 /\ j = 2) \/ (i = 1 /\ j = 0) \/ (1 < i /\ j = i + 1))) \/
  (e = 3 /\ ((i = 0 /\ j = 0) \/ (i = 1 /\ j = 1) \/ (1 < i /\ j = i + 2))) $;
def bdRnIdx (e d i j .u .x: nat): wff =
$ (i < d /\ j = i) \/
  (~ i < d /\ E. u (u <= i /\ d + u = i /\ E. x (x <= j /\ bdRnMap e u x /\ j = d + x))) $;

-- one justification rule per tag; (m, v) is the fact set, i the index of the
-- fact being justified (premises must have index < i), B the witness bound.
def bdRIn (m v i a l .x .t: nat): wff =
$ E. x (x <= l /\ E. t (t <= l /\ bdCons x t l /\
  (a = x \/ bdHas m v i bdtIn a t 0 0))) $;

def bdRSub (m v i g h .a .t: nat): wff =
$ g = 0 \/ E. a (a <= g /\ E. t (t <= g /\ bdCons a t g /\
  bdHas m v i bdtIn a h 0 0 /\ bdHas m v i bdtSub t h 0 0)) $;

def bdRWf (m v i n .t .a .b: nat): wff =
$ n = 0 \/ E. t (t <= n /\ E. a (a <= n /\ E. b (b <= n /\ bdNode t a b n /\
  ((t = 1 \/ t = 2) \/
   ((t = 3 \/ t = 4 \/ t = 5) /\ bdHas m v i bdtWf a 0 0 0 /\ bdHas m v i bdtWf b 0 0 0) \/
   ((t = 6 \/ t = 7) /\ b = 0 /\ bdHas m v i bdtWf a 0 0 0))))) $;

def bdRCwf (m v i g .a .t: nat): wff =
$ g = 0 \/ E. a (a <= g /\ E. t (t <= g /\ bdCons a t g /\
  bdHas m v i bdtWf a 0 0 0 /\ bdHas m v i bdtCwf t 0 0 0)) $;

def bdRRow (m v i r .g .a .b .c: nat): wff =
$ E. g (g <= r /\ E. a (a <= r /\ bdSeq g a r /\
    bdHas m v i bdtCwf g 0 0 0 /\ bdHas m v i bdtWf a 0 0 0)) \/
  E. g (g <= r /\ E. a (a <= r /\ E. b (b <= r /\ E. c (c <= r /\ bdBr g a b c r /\
    bdHas m v i bdtCwf g 0 0 0 /\ bdHas m v i bdtWf a 0 0 0 /\
    bdHas m v i bdtWf b 0 0 0 /\ bdHas m v i bdtWf c 0 0 0)))) $;

def bdRBnd (m v i n c .t .a .b: nat): wff =
$ c = 0 \/ E. t (t <= c /\ E. a (a <= c /\ E. b (b <= c /\ bdNode t a b c /\
  (((t = 1 \/ t = 2) /\ a < n /\ b < n) \/
   ((t = 3 \/ t = 4 \/ t = 5) /\ bdHas m v i bdtBnd n a 0 0 /\ bdHas m v i bdtBnd n b 0 0) \/
   ((t = 6 \/ t = 7) /\ b = 0 /\ bdHas m v i bdtBnd (suc n) a 0 0))))) $;

def bdRShift (m v i d c y .t .a .b .x .z: nat): wff =
$ (c = 0 /\ y = 0) \/ E. t (t <= c /\ E. a (a <= c /\ E. b (b <= c /\ bdNode t a b c /\
  (((t = 1 \/ t = 2) /\ E. x (x <= y /\ E. z (z <= y /\
      bdShIdx d a x /\ bdShIdx d b z /\ bdNode t x z y))) \/
   ((t = 3 \/ t = 4 \/ t = 5) /\ E. x (x <= y /\ E. z (z <= y /\
      bdHas m v i bdtShift d a x 0 /\ bdHas m v i bdtShift d b z 0 /\ bdNode t x z y))) \/
   ((t = 6 \/ t = 7) /\ b = 0 /\ E. x (x <= y /\
      bdHas m v i bdtShift (suc d) a x 0 /\ bdNode t x 0 y)) \/
   (y = 0 /\ (t = 0 \/ ((t = 6 \/ t = 7) /\ b != 0))))))) $;

def bdRSubst (m v i d s c y .t .a .b .x .z: nat): wff =
$ (c = 0 /\ y = 0) \/ E. t (t <= c /\ E. a (a <= c /\ E. b (b <= c /\ bdNode t a b c /\
  (((t = 1 \/ t = 2) /\ E. x (x <= y /\ E. z (z <= y /\
      bdSbIdx d s a x /\ bdSbIdx d s b z /\ bdNode t x z y))) \/
   ((t = 3 \/ t = 4 \/ t = 5) /\ E. x (x <= y /\ E. z (z <= y /\
      bdHas m v i bdtSubst d s a x /\ bdHas m v i bdtSubst d s b z /\ bdNode t x z y))) \/
   ((t = 6 \/ t = 7) /\ b = 0 /\ E. x (x <= y /\
      bdHas m v i bdtSubst (suc d) s a x /\ bdNode t x 0 y)) \/
   (y = 0 /\ (t = 0 \/ ((t = 6 \/ t = 7) /\ b != 0))))))) $;

def bdRRen (m v i e d c y .t .a .b .x .z: nat): wff =
$ e < 4 /\ ((c = 0 /\ y = 0) \/ E. t (t <= c /\ E. a (a <= c /\ E. b (b <= c /\ bdNode t a b c /\
  (((t = 1 \/ t = 2) /\ E. x (x <= y /\ E. z (z <= y /\
      bdRnIdx e d a x /\ bdRnIdx e d b z /\ bdNode t x z y))) \/
   ((t = 3 \/ t = 4 \/ t = 5) /\ E. x (x <= y /\ E. z (z <= y /\
      bdHas m v i bdtRen e d a x /\ bdHas m v i bdtRen e d b z /\ bdNode t x z y))) \/
   ((t = 6 \/ t = 7) /\ b = 0 /\ E. x (x <= y /\
      bdHas m v i bdtRen e (suc d) a x /\ bdNode t x 0 y)) \/
   (y = 0 /\ (t = 0 \/ ((t = 6 \/ t = 7) /\ b != 0)))))))) $;

def bdRAllPre (m v i n c y .k .x: nat): wff =
$ (n = 0 /\ y = c) \/ E. k (k < n /\ n = suc k /\ E. x (x < y /\
  bdHas m v i bdtAllPre k c x 0 /\ bdNode 6 x 0 y)) $;

def bdRCShift (m v i g y .a .t .x .z: nat): wff =
$ (g = 0 /\ y = 0) \/ E. a (a <= g /\ E. t (t <= g /\ bdCons a t g /\
  E. x (x <= y /\ E. z (z <= y /\ bdCons x z y /\
    bdHas m v i bdtShift 0 a x 0 /\ bdHas m v i bdtCShift t z 0 0)))) $;

--| z e. zfcAxioms: a fixed axiom, or a closed Separation / Replacement instance.
def bdRAx (m v B i z .f .n .x .y .p .q .r: nat): wff =
$ bdZfcFixed z \/
  (bdHas m v i bdtBnd 0 z 0 0 /\ E. f (f <= B /\ E. n (n <= B /\
    E. x (x <= B /\ E. y (y <= B /\
      bdHas m v i bdtBnd (suc n) f 0 0 /\ bdHas m v i bdtRen 0 0 f x /\
      bdSepSkel x y /\ bdHas m v i bdtAllPre n y z 0))))) \/
  (bdHas m v i bdtBnd 0 z 0 0 /\ E. f (f <= B /\ E. n (n <= B /\
    E. p (p <= B /\ E. q (q <= B /\ E. r (r <= B /\ E. y (y <= B /\
      bdHas m v i bdtBnd (suc (suc n)) f 0 0 /\ bdHas m v i bdtRen 1 0 f p /\
      bdHas m v i bdtRen 2 0 f q /\ bdHas m v i bdtRen 3 0 f r /\
      bdRepSkel p q r y /\ bdHas m v i bdtAllPre n y z 0))))))) $;

def bdRCax (m v i g .z .t: nat): wff =
$ g = 0 \/ E. z (z <= g /\ E. t (t <= g /\ bdCons z t g /\
  bdHas m v i bdtAx z 0 0 0 /\ bdHas m v i bdtCax t 0 0 0)) $;

-- natural-deduction rules of source_nd_prop.mm0 / source_nd_quantifiers.mm0
-- (conclusion row r, premise rows p, q); sfRowWf r is checked in bdRValid.
--| sfNDCaseCtx, sfNDCasePc.
def bdNDBase (m v i r .g .a .b .x .y .z: nat): wff =
$ E. g (g <= r /\ E. a (a <= r /\ bdSeq g a r /\ bdHas m v i bdtIn a g 0 0)) \/
  E. g (g <= r /\ E. z (z <= r /\ bdSeq g z r /\ E. y (y <= z /\ E. a (a <= z /\
    bdNode 5 y a z /\ E. x (x <= y /\ bdNode 5 x a y /\
      E. b (b <= x /\ bdNode 5 a b x)))))) $;

--| sfNDCaseII, Exp, CE1, CE2, DI1, DI2, Wk.
def bdNDProp1 (m v i r p .g .h .a .b .x .y: nat): wff =
$ E. g (g <= r /\ E. y (y <= r /\ bdSeq g y r /\ E. a (a <= y /\ E. b (b <= y /\
    bdNode 5 a b y /\ E. h (h <= p /\ bdCons a g h /\ bdSeq h b p))))) \/
  E. g (g <= r /\ E. a (a <= r /\ bdSeq g a r /\ bdSeq g 0 p)) \/
  E. g (g <= r /\ E. a (a <= r /\ bdSeq g a r /\ E. x (x <= p /\ bdSeq g x p /\
    E. b (b <= x /\ bdNode 3 a b x)))) \/
  E. g (g <= r /\ E. b (b <= r /\ bdSeq g b r /\ E. x (x <= p /\ bdSeq g x p /\
    E. a (a <= x /\ bdNode 3 a b x)))) \/
  E. g (g <= r /\ E. x (x <= r /\ bdSeq g x r /\ E. a (a <= x /\ E. b (b <= x /\
    bdNode 4 a b x /\ bdSeq g a p)))) \/
  E. g (g <= r /\ E. x (x <= r /\ bdSeq g x r /\ E. a (a <= x /\ E. b (b <= x /\
    bdNode 4 a b x /\ bdSeq g b p)))) \/
  E. h (h <= r /\ E. a (a <= r /\ bdSeq h a r /\ E. g (g <= p /\ bdSeq g a p /\
    bdHas m v i bdtSub g h 0 0))) $;

--| sfNDCaseAllI, AllE, ExI.
def bdNDQuant1 (m v B i r p .g .h .a .t .x .y: nat): wff =
$ E. g (g <= r /\ E. x (x <= r /\ bdSeq g x r /\ E. a (a <= x /\ bdNode 6 a 0 x /\
    E. h (h <= p /\ bdSeq h a p /\ bdHas m v i bdtCShift g h 0 0)))) \/
  E. g (g <= r /\ E. y (y <= r /\ bdSeq g y r /\ E. x (x <= p /\ bdSeq g x p /\
    E. a (a <= x /\ bdNode 6 a 0 x /\ E. t (t <= B /\ bdHas m v i bdtSubst 0 t a y))))) \/
  E. g (g <= r /\ E. x (x <= r /\ bdSeq g x r /\ E. a (a <= x /\ bdNode 7 a 0 x /\
    E. y (y <= p /\ bdSeq g y p /\ E. t (t <= B /\ bdHas m v i bdtSubst 0 t a y))))) $;

--| sfNDCaseIE, CI, BranchPair, DE, ExE.
def bdND2 (m v i r p q .g .h .a .b .c .s .x .y: nat): wff =
$ E. g (g <= r /\ E. b (b <= r /\ bdSeq g b r /\ E. a (a <= q /\ bdSeq g a q /\
    E. x (x <= p /\ bdSeq g x p /\ bdNode 5 a b x)))) \/
  E. g (g <= r /\ E. x (x <= r /\ bdSeq g x r /\ E. a (a <= x /\ E. b (b <= x /\
    bdNode 3 a b x /\ bdSeq g a p /\ bdSeq g b q)))) \/
  E. g (g <= r /\ E. a (a <= r /\ E. b (b <= r /\ E. c (c <= r /\ bdBr g a b c r /\
    E. h (h <= p /\ bdCons a g h /\ bdSeq h c p) /\
    E. h (h <= q /\ bdCons b g h /\ bdSeq h c q))))) \/
  E. g (g <= r /\ E. c (c <= r /\ bdSeq g c r /\ E. x (x <= p /\ bdSeq g x p /\
    E. a (a <= x /\ E. b (b <= x /\ bdNode 4 a b x /\ bdBr g a b c q))))) \/
  E. g (g <= r /\ E. c (c <= r /\ bdSeq g c r /\ E. x (x <= p /\ bdSeq g x p /\
    E. a (a <= x /\ bdNode 7 a 0 x /\ E. h (h <= q /\ E. y (y <= q /\ bdSeq h y q /\
      E. s (s <= h /\ bdCons a s h /\ bdHas m v i bdtCShift g s 0 0) /\
      bdHas m v i bdtShift 0 c y 0)))))) $;

--| traceValid sfNDFullRules (r : l).
def bdRValid (m v B i p .r .l .x .y: nat): wff =
$ p = 0 \/ E. r (r <= p /\ E. l (l <= p /\ bdCons r l p /\
  bdHas m v i bdtValid l 0 0 0 /\ bdHas m v i bdtRow r 0 0 0 /\
  (bdNDBase m v i r \/
   E. x (x <= l /\ bdHas m v i bdtIn x l 0 0 /\
     (bdNDProp1 m v i r x \/ bdNDQuant1 m v B i r x)) \/
   E. x (x <= l /\ E. y (y <= l /\ bdHas m v i bdtIn x l 0 0 /\
     bdHas m v i bdtIn y l 0 0 /\ bdND2 m v i r x y))))) $;

def bdZfcRule (m v B i g a b c d: nat): wff =
$ (g = bdtIn /\ bdRIn m v i a b) \/ (g = bdtSub /\ bdRSub m v i a b) \/
  (g = bdtWf /\ bdRWf m v i a) \/ (g = bdtCwf /\ bdRCwf m v i a) \/
  (g = bdtRow /\ bdRRow m v i a) \/ (g = bdtBnd /\ bdRBnd m v i a b) \/
  (g = bdtShift /\ bdRShift m v i a b c) \/ (g = bdtSubst /\ bdRSubst m v i a b c d) \/
  (g = bdtRen /\ bdRRen m v i a b c d) \/ (g = bdtAllPre /\ bdRAllPre m v i a b c) \/
  (g = bdtCShift /\ bdRCShift m v i a b) \/ (g = bdtAx /\ bdRAx m v B i a) \/
  (g = bdtCax /\ bdRCax m v i a) \/ (g = bdtValid /\ bdRValid m v B i a) $;

--| every fact of the set (m, v) is justified by facts of smaller index.
def bdZfcJust (m v B .k .i .g .a .b .c .d: nat): wff =
$ A. k (k < v -> bdCell m v k -> E. i (i <= k /\ E. g (g <= k /\ E. a (a <= k /\
  E. b (b <= k /\ E. c (c <= k /\ E. d (d <= k /\
    bdTup i g a b c d k /\ bdZfcRule m v B i g a b c d))))))) $;

--| D_I: w = (m, (v, B)) certifies a context G of ZFC axioms and a valid ND trace
--| p containing the row sfSequent G sfBot.
def bdZfcBot (w .m .k .v .B .g .p .r: nat): wff =
$ E. m (m <= w /\ E. k (k <= w /\ bdPair m k w /\ E. v (v <= k /\ E. B (B <= k /\
  bdPair v B k /\ bdZfcJust m v B /\ E. g (g <= B /\ E. p (p <= B /\
    E. r (r <= p /\ bdHas m v v bdtCax g 0 0 0 /\ bdHas m v v bdtValid p 0 0 0 /\
      bdSeq g 0 r /\ bdHas m v v bdtIn r p 0 0))))))) $;

--| B5 test defs (Delta0).
def tTriv (n: nat): wff = $ n <= n $;
def tGt (n m: nat): wff = $ n < m $;
def tEv (n .k: nat): wff = $ E. k (k <= n /\ k + k = n) $;
def tAll (n .k: nat): wff = $ A. k (k < n -> suc k != 0) $;

-- ===== spike graph library (spike/negtrans-lib.mm1) =====


--| Friedman negation `p ->A` (`~p` is the instance A := F.).
local def ng (p A: wff): wff = $ p -> A $;
--| Friedman double negation.
local def dn (p A: wff): wff = $ (p -> A) -> A $;
--| Translation of peano's `E. x p := ~(A. x ~p)`.
local def ex_N {x: nat} (p: wff x) (A: wff): wff = $ ng (A. x (ng p A)) A $;
--| Translations of peano's `/\`, `<->` (bodies are checked by the translator).
local def an_N (a b A: wff): wff = $ ng (a -> ng b A) A $;
local def iff_N (a b A: wff): wff = $ an_N (a -> b) (b -> a) A $;

--| The graph of a nat value: `{y | y = a}`.
local def sg (a .y: nat): set = $ {y | y = a} $;
--| Equality of graphs (translation of `=`).
local def eqG (X Y: set) (A: wff) (.y .z: nat): wff =
  $ A. y A. z (y e. X -> z e. Y -> dn (y = z) A) $;
--| Membership of a graph's value in a set (translation of `e.`).
local def elG (X S: set) (A: wff) (.y: nat): wff = $ A. y (y e. X -> dn (y e. S) A) $;
--| `X` is (negatively) a singleton.
local def nsing (X: set) (A: wff) (.y: nat): wff =
  $ eqG X X A /\ ng (A. y (ng (y e. X) A)) A $;
--| Graphs of successor, addition and multiplication.
local def sucG (X: set) (A: wff) (.y .z: nat): set =
  $ {y | A. z (z e. X -> dn (y = suc z) A)} $;
local def addG (X Y: set) (A: wff) (.y .u .v: nat): set =
  $ {y | A. u A. v (u e. X -> v e. Y -> dn (y = u + v) A)} $;
local def mulG (X Y: set) (A: wff) (.y .u .v: nat): set =
  $ {y | A. u A. v (u e. X -> v e. Y -> dn (y = u * v) A)} $;
--| `S` is the singleton `{w}` (stably).
local def issg (S: set) (w: nat) (A: wff) (.x: nat): wff =
  $ A. x (dn (x e. S) A <-> dn (x = w) A) $;
--| The graph of `the S`.
local def theG (S: set) (A: wff) (.y .w: nat): set =
  $ {y | A. w (issg S w A -> dn (y = w) A) /\ (A. w (ng (issg S w A) A) -> dn (y = 0) A)} $;
--| Translations of peano's `!=`, `[a / x] p` and `==` (checked by the translator).
local def ne_N (a b: set) (A: wff): wff = $ ng (eqG a b A) A $;
local def sb_N (a: set) {x .y: nat} (p: wff x) (A: wff): wff =
  $ A. y (eqG (sg y) a A -> A. x (eqG (sg x) (sg y) A -> p)) $;
local def eqs_N (S T: set) {.x: nat} (A: wff): wff =
  $ A. x (iff_N (elG (sg x) S A) (elG (sg x) T A) A) $;

-- propositional and first-order basics
theorem id (a: wff): $ a -> a $ = '(ax_mp (ax_mp ax_2 ax_1) (! ax_1 _ a));
theorem syl (a b c: wff) (h1: $ b -> c $) (h2: $ a -> b $): $ a -> c $ = '(ax_mp (ax_mp ax_2 (ax_mp ax_1 h1)) h2);
--| T. holds (T. := ~F.).
theorem itru: $ T. $ = 'id;
theorem dni (p A: wff): $ p -> dn p A $ = '(ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 id))) ax_1);
theorem dnA (p A: wff): $ A -> dn p A $ = 'ax_1;
theorem dnmap (p q A: wff) (h: $ p -> q $): $ dn p A -> dn q A $ = '(ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)) (ax_mp ax_1 (ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)) (ax_mp ax_1 h))));
theorem dnmap2 (p q r A: wff) (h: $ p -> q -> r $): $ dn p A -> dn q A -> dn r A $ =
  '(ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)))) (ax_mp ax_1 (ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)))) (ax_mp ax_1 (ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)))) (ax_mp ax_1 h))))));
theorem dnmap3 (p q r s A: wff) (h: $ p -> q -> r -> s $):
  $ dn p A -> dn q A -> dn r A -> dn s A $ =
  '(ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)))))) (ax_mp ax_1 (ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)))))) (ax_mp ax_1 (ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)))))) (ax_mp ax_1 (ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)))))) (ax_mp ax_1 h))))))));
theorem dnmap4 (p q r s t A: wff) (h: $ p -> q -> r -> s -> t $):
  $ dn p A -> dn q A -> dn r A -> dn s A -> dn t A $ =
  '(ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)))))))) (ax_mp ax_1 (ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)))))))) (ax_mp ax_1 (ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)))))))) (ax_mp ax_1 (ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)))))))) (ax_mp ax_1 (ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)))))))) (ax_mp ax_1 h))))))))));
theorem an_Ni (a b A: wff): $ a -> b -> an_N a b A $ = '(ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 id))) ax_1))))) (ax_mp ax_1 ax_1));
theorem iffN1 (a b A: wff) (h: $ dn b A -> b $): $ iff_N a b A -> a -> b $ =
  '(ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 h)))) (ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)))) (ax_mp ax_1 (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 ax_1)))))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 id))) ax_1)))))));
theorem iffN2 (a b A: wff) (h: $ dn a A -> a $): $ iff_N a b A -> b -> a $ =
  '(ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 h)))) (ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)))) (ax_mp ax_1 (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 ax_1)))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 id))) ax_1)))))));

theorem eqid (a: nat): $ a = a $ =
  '(ax_mp (ax_mp (ax_mp (!! exe x) (ax_gen ax_5)) (ax_gen (ax_mp (ax_mp ax_2 ax_7) id))) ax_6);
theorem eqcom (a b: nat): $ a = b -> b = a $ = '(ax_mp (ax_mp ax_2 ax_7) (ax_mp ax_1 eqid));
