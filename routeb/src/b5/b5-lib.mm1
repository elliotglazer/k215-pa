theorem nfab1 {x u: nat} (p: wff x): $ u e. {x | p} -> A. x (u e. {x | p}) $ =
  '(syl (alim (ax_mp anr elab)) (syl ax_11 (syl (!! alim w nfq1) (ax_mp anl elab))));
theorem nfdnel {x u: nat} (p: wff x) (A: wff): $ dn (u e. {x | p}) A -> A. x (dn (u e. {x | p}) A) $ =
  '(nfim (nfim nfab1 ax_5) ax_5);
theorem nfelG {x: nat} (a: set) (p: wff x) (A: wff): $ elG a {x | p} A -> A. x (elG a {x | p} A) $ =
  '(!! nfal x v (nfim ax_5 nfdnel));
theorem elsg1 {y: nat} (a: nat): $ y e. sg a -> y = a $ = 'elv1;
