theorem eqtrc (a b c: nat): $ a = c -> b = c -> a = b $ = '(ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) eqtr))) (ax_mp ax_1 eqcom));
theorem sucq (a b: nat): $ a = b -> suc a = suc b $ = '(ax_mp anr peano2);
theorem alim {x: nat} (p q: wff x) (h: $ p -> q $): $ A. x p -> A. x q $ = '(ax_mp ax_4 (ax_gen h));
theorem alnf {x: nat} (p: wff) (q: wff x): $ A. x (p -> q) -> p -> A. x q $ =
  '(ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) ax_4))) (ax_mp ax_1 ax_5));
theorem ald1 {x: nat} (a1: wff) (p: wff x) (h: $ a1 -> p $):
  $ a1 -> A. x p $ = '(ax_mp alnf (ax_gen h));
theorem ald2 {x: nat} (a1 a2: wff) (p: wff x) (h: $ a1 -> a2 -> p $):
  $ a1 -> a2 -> A. x p $ = '(ax_mp (ax_mp ax_2 (ax_mp ax_1 alnf)) (ax_mp alnf (ax_gen h)));
theorem ald3 {x: nat} (a1 a2 a3: wff) (p: wff x) (h: $ a1 -> a2 -> a3 -> p $):
  $ a1 -> a2 -> a3 -> A. x p $ = '(ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 alnf)))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 alnf)) (ax_mp alnf (ax_gen h))));
theorem ald4 {x: nat} (a1 a2 a3 a4: wff) (p: wff x) (h: $ a1 -> a2 -> a3 -> a4 -> p $):
  $ a1 -> a2 -> a3 -> a4 -> A. x p $ = '(ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 alnf)))))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 alnf)))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 alnf)) (ax_mp alnf (ax_gen h)))));
theorem ald5 {x: nat} (a1 a2 a3 a4 a5: wff) (p: wff x) (h: $ a1 -> a2 -> a3 -> a4 -> a5 -> p $):
  $ a1 -> a2 -> a3 -> a4 -> a5 -> A. x p $ = '(ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 alnf)))))))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 alnf)))))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 alnf)))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 alnf)) (ax_mp alnf (ax_gen h))))));
theorem ald6 {x: nat} (a1 a2 a3 a4 a5 a6: wff) (p: wff x) (h: $ a1 -> a2 -> a3 -> a4 -> a5 -> a6 -> p $):
  $ a1 -> a2 -> a3 -> a4 -> a5 -> a6 -> A. x p $ = '(ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 alnf)))))))))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 alnf)))))))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 alnf)))))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 alnf)))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 alnf)) (ax_mp alnf (ax_gen h)))))));
theorem ald7 {x: nat} (a1 a2 a3 a4 a5 a6 a7: wff) (p: wff x) (h: $ a1 -> a2 -> a3 -> a4 -> a5 -> a6 -> a7 -> p $):
  $ a1 -> a2 -> a3 -> a4 -> a5 -> a6 -> a7 -> A. x p $ = '(ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 alnf)))))))))))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 alnf)))))))))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 alnf)))))))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 alnf)))))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 alnf)))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 alnf)) (ax_mp alnf (ax_gen h))))))));

theorem spi1 {x: nat} (a: nat) (p: wff x) (q: wff) (h: $ x = a -> p -> q $): $ p -> x = a -> q $ =
  '(ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 h))) ax_1);
