  $ eqs_N S {x | eqG (sg x) a A} A -> eqG (theG S A) a A $ = '(!! ald1 u (!! ald1 v (ti3 h)));

theorem t0f1 {x y z: nat} (A: wff): $ z = y -> x = z -> z e. {x | eqG (sg x) (sg y) A} $ =
