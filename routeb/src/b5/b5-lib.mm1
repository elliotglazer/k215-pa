  '(ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 exeq)))) (!! ald2 w elv1a));
theorem elv1 {x: nat} (p: wff x): $ x e. {x | p} -> p $ = '(ax_mp (!! exeq y) (!! ax_gen y elv1b));
