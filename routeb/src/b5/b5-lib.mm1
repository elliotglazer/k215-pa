--| `bdNum h t u` is the decimal numeral htu (no `the`).
def bdNum (h t u: nat): nat = $ 10 * (10 * h + t) + u $;

--| p = (a, b) for peano's Cantor pairing `pr` (same text as K215's
--| bb215ArithmeticFormulaPairGraph, whose _correct lemma gives <-> p = (a, b)).
def bdPair (a b p: nat): wff = $ 2 * p = (a + b) * suc (a + b) + 2 * b $;

--| bounded divisibility: a divides b.
def bdDvd (a b .c: nat): wff = $ E. c (c <= b /\ c * a = b) $;

--| k is an element of the finite set coded by (m, v): the body of peano.mm1's
--| `pset` (elpset) with `||` bounded. Implies k < v.
def bdCell (m v k .x: nat): wff =
$ 0 < m /\ 0 < v /\ A. x (x <= k -> 0 < x -> bdDvd x m) /\
  bdDvd (suc (m * suc k)) v $;

