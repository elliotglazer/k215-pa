theorem st_im (p q A: wff) (h: $ dn q A -> q $): $ dn (p -> q) A -> p -> q $ =
  '(ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 h)))) (ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)))) (ax_mp ax_1 (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 id))) ax_1))))));
theorem st_A (A: wff): $ dn A A -> A $ = '(ax_mp (ax_mp ax_2 id) (ax_mp ax_1 id));
theorem st_tru (A: wff): $ dn T. A -> T. $ = '(ax_mp ax_1 itru);
theorem nf_ngal {x: nat} (p: wff x) (A: wff): $ ng (A. x p) A -> A. x (ng (A. x p) A) $ =
  '(ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_i5r)) (ax_mp ax_2 (ax_mp ax_1 ax_5)));
theorem nf_dnal {x: nat} (p: wff x) (A: wff): $ dn (A. x p) A -> A. x (dn (A. x p) A) $ =
  '(syl (ax_mp ax_4 (ax_gen (ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)) (ax_mp ax_1 nf_ngal))))
        (syl ax_i5r (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 ax_5)))) (ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)) (ax_mp ax_1 ax_sp)))));
theorem st_al {x: nat} (p: wff x) (A: wff) (h: $ dn p A -> p $): $ dn (A. x p) A -> A. x p $ =
  '(syl (ax_mp ax_4 (ax_gen (syl h (ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)) (ax_mp ax_1 (ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)) (ax_mp ax_1 ax_sp))))))) nf_dnal);
theorem st_eqG (X Y: set) (A: wff): $ dn (eqG X Y A) A -> eqG X Y A $ =
  '(!! st_al y (!! st_al z (st_im (st_im st_dn))));
theorem st_elG (X S: set) (A: wff): $ dn (elG X S A) A -> elG X S A $ = '(!! st_al y (st_im st_dn));

-- singletons
theorem eg1 {u v: nat} (a b: nat) (A: wff):
  $ u = a -> v = b -> (u e. sg a -> v e. sg b -> dn (u = v) A) -> dn (a = b) A $ =
