theorem eg1s {u v: nat} (a b: nat) (A: wff):
  $ v = b -> (u e. sg a -> v e. sg b -> dn (u = v) A) -> u = a -> dn (a = b) A $ =
  '(ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 eg1))) ax_1))))) (ax_mp ax_1 ax_1));
theorem eg2 {u v: nat} (a b: nat) (A: wff):
  $ u = a -> A. v (u e. sg a -> v e. sg b -> dn (u = v) A) -> dn (a = b) A $ =
  '(ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (spi eg1s)))) ax_1);
theorem eqGsg1 (a b: nat) (A: wff): $ eqG (sg a) (sg b) A -> dn (a = b) A $ = '(!! spi u (!! eg2 u v));
theorem eg3 {u v: nat} (a b: nat) (A: wff):
  $ dn (a = b) A -> u e. sg a -> v e. sg b -> dn (u = v) A $ =
  '(ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)))))) (ax_mp ax_1 (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)))))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 ax_1)))) (ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 eqtr)))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 eqtr)) elsg1)))))) (ax_mp ax_1 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 eqcom)) elsg1))))))));
theorem eqGsg2 (a b: nat) (A: wff): $ dn (a = b) A -> eqG (sg a) (sg b) A $ =
  '(!! ald1 u (!! ald1 v eg3));
