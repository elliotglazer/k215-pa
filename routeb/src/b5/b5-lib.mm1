theorem nexE {u: nat} (X: set) (q A: wff) (hq: $ dn q A -> q $) (h: $ nsing X A $):
  $ A. u (u e. X -> q) -> q $ =
  '(ax_mp (ax_mp ax_2 (ax_mp ax_1 hq)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 (ax_mp nsE h))))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 alnf)) (alim nexa))));

-- stability
theorem st_ng (p A: wff): $ dn (ng p A) A -> ng p A $ = '(ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)) (ax_mp ax_1 (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 id))) ax_1)));
