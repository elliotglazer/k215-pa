-- eqG / elG / nsing: introduction and elimination
theorem eqGe {u v: nat} (X Y: set) (A: wff): $ eqG X Y A -> u e. X -> v e. Y -> dn (u = v) A $ =
  '(syl ax_sp ax_sp);
theorem eqGc {u v: nat} (X Y: set) (A: wff) (h: $ u e. X -> v e. Y -> dn (u = v) A $):
  $ eqG X Y A $ = '(ax_gen (ax_gen h));
theorem elGe {u: nat} (X S: set) (A: wff): $ elG X S A -> u e. X -> dn (u e. S) A $ = 'ax_sp;
theorem nsU (X: set) (A: wff): $ nsing X A -> eqG X X A $ =
  '(! anl $ eqG X X A $ $ ng (A. u (ng (u e. X) A)) A $);
theorem nsE {u: nat} (X: set) (A: wff): $ nsing X A -> ng (A. u (ng (u e. X) A)) A $ = 'anr;
theorem nsI {u: nat} (X: set) (A: wff) (h1: $ eqG X X A $) (h2: $ A. u (ng (u e. X) A) -> A $):
  $ nsing X A $ = '(ax_mp (ax_mp ani h1) h2);
