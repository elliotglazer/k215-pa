    iff_N (elG (sg z) S A) (elG (sg z) {x | eqG (sg x) (sg y) A} A) A $ =
  '(ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 an_Ni)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 t0f)))) (ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) anl))) (ax_mp ax_1 elGsg1))))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 elGsg2)))) (ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) anr))) (ax_mp ax_1 t0b))));
theorem t0c {x y: nat} (S: set) (A: wff): $ issg S y A -> eqs_N S {x | eqG (sg x) (sg y) A} A $ =
