  '(ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp exe (ax_gen ax_5)))) (alim (spi1 h)))) (ax_mp ax_1 ax_6));
theorem exeq {x: nat} (a: nat) (q: wff): $ A. x (x = a -> q) -> q $ =
  '(ax_mp (ax_mp ax_2 (ax_mp exe (ax_gen ax_5))) (ax_mp ax_1 ax_6));

theorem exeqnf {x: nat} (a: nat) (q: wff x) (h: $ q -> A. x q $): $ A. x (x = a -> q) -> q $ =
  '(ax_mp (ax_mp ax_2 (ax_mp exe (ax_gen h))) (ax_mp ax_1 ax_6));
theorem ald1q {x: nat} (p q: wff x) (h: $ A. x p -> q $): $ A. x p -> A. x q $ = '(syl (alim h) ax_ial);
theorem alnfx {x: nat} (a b: wff x) (h: $ a -> A. x a $): $ A. x (a -> b) -> a -> A. x b $ =
  '(ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) ax_4))) (ax_mp ax_1 h));
theorem nfi1 {x: nat} (a: wff) (B: wff x): $ (A. x a -> B) -> a -> B $ = '(ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)) (ax_mp ax_1 ax_5));
--| `x` not free in `a -> A. x B` when `a` does not mention `x`.
theorem nfimp {x: nat} (a: wff) (B: wff x): $ (a -> A. x B) -> A. x (a -> B) $ =
  '(ax_mp (ax_mp ax_2 (ax_mp ax_1 (alim nfi1))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_i5r)) (ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)) (ax_mp ax_1 ax_sp))));
