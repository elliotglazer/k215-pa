  $ (a -> b) -> A. x (a -> b) $ = '(ax_mp (ax_mp ax_2 (ax_mp ax_1 (alim (nfi2 ha)))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_i5r)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 hb)))) (ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)) (ax_mp ax_1 ax_sp)))));
