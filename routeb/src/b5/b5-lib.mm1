  '(ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ore id))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 id))) ax_1))))) (ax_mp ax_1 (ax_mp (ax_mp ax_2 (ax_mp ax_1 (relB (rel_tEv (isvI ns_sg (ax_mp eqGsg2 (ax_mp (ax_mp ax_2 ax_2) (ax_mp ax_1 id)))))))) (relFp (rel_tEv isv_sg)))));
