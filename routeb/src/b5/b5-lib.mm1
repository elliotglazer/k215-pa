theorem the0N {x y: nat} (S: set) (A: wff):
  $ ng (ex_N y (eqs_N S {x | eqG (sg x) (sg y) A} A) A) A -> eqG (theG S A) (sg 0) A $ =
  '(!! ald1 u (!! ald1 v t0g));

