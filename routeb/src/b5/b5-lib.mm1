theorem t0b {x y z: nat} (A: wff): $ elG (sg z) {x | eqG (sg x) (sg y) A} A -> dn (z = y) A $ =
  '(ax_mp (ax_mp ax_2 (ax_mp ax_1 st_dn)) (ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) elGsg1))) (ax_mp ax_1 (ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)) (ax_mp ax_1 t0b2)))));
