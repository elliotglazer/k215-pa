  '(ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 ax_2)))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 ax_sp)))))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 ax_sp)))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 (ax_mp anl elab))))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_8)) eqcom))))))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 eqtr)) eqcom)))) (ax_mp ax_1 eqcom))));
