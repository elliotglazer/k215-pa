  '(ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 ax_12)))) (ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 eqtr)) eqcom)))) (ax_mp ax_1 eqcom))))))) (ax_mp ax_1 ax_1));
theorem elv2b {x y: nat} (p: wff x): $ y = x -> p -> x e. {x | p} $ =
