theorem t0f2 {x y z: nat} (A: wff): $ z = y -> z e. {x | eqG (sg x) (sg y) A} $ =
  '(ax_mp (ax_mp ax_2 (ax_mp ax_1 (exeqnf nfab1))) (ax_mp alnf (!! ax_gen x t0f1)));
theorem t0f {x y z: nat} (A: wff): $ dn (z = y) A -> elG (sg z) {x | eqG (sg x) (sg y) A} A $ =
  '(ax_mp (ax_mp ax_2 (ax_mp ax_1 elGsg2)) (ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)) (ax_mp ax_1 (ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)) (ax_mp ax_1 t0f2)))));
theorem t0b1 {x y z: nat} (A: wff): $ z e. {x | eqG (sg x) (sg y) A} -> x = z -> dn (z = y) A $ =
  '(ax_mp (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 ax_2)))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 ax_1)))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 eqGsg1)))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp ax_1 elv1)))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_8)) eqcom)))) ax_1))))))) (ax_mp ax_1 (ax_mp (ax_mp ax_2 (ax_mp ax_1 (ax_mp ax_2 (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_2)) ax_1)))) (ax_mp (ax_mp ax_2 (ax_mp ax_1 ax_1)) (ax_mp (ax_mp ax_2 (ax_mp ax_1 eqtr)) eqcom)))));
