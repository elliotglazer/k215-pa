  (~ i < d /\ E. u (u <= i /\ d + u = i /\ E. x (x <= j /\ bcCeMap e u x /\ j = d + x))) $;

--| j = S_e(i) for the maps of pa_source_interpretation_builders.mm0.
def bcSiMap (e i j: nat): wff =
$ (e = 0 /\ ((i = 0 /\ j = 0) \/ (i != 0 /\ j = suc i))) \/
  (e = 1 /\ ((i = 0 /\ j = 1) \/ (i != 0 /\ j = suc (suc i)))) \/
  (e = 2 /\ ((i = 0 /\ j = 0) \/ (i != 0 /\ j = suc (suc i)))) \/
  (e = 3 /\ ((i = 0 /\ j = 1) \/ (i != 0 /\ j = suc i))) $;

--| j = sfRenameIndex S_e d i.
def bcSiIdx (e d i j .u .x: nat): wff =
$ (i < d /\ j = i) \/
  (~ i < d /\ E. u (u <= i /\ d + u = i /\ E. x (x <= j /\ bcSiMap e u x /\ j = d + x))) $;

--| paTermNumeral: rec paTermZero paTermSuccessor.
def bcRNum (m v i n t .k .x: nat): wff =
$ (n = 0 /\ t = 0) \/
  E. k (k < n /\ n = suc k /\ E. x (x <= t /\ bdHas m v i bctNum k x 0 0 /\ bdNode 2 x 0 t)) $;

--| paTermLift k = paTermRename (paTermLiftMap k)  (paTermRenameBody).
def bcRTLift (m v i k t y .g .a .b .x .z: nat): wff =
$ (t = 0 /\ y = 0) \/ E. g (g <= t /\ E. a (a <= t /\ E. b (b <= t /\ bdNode g a b t /\
  ((g = 1 /\ bdNode 1 (k + a) 0 y) \/
   (g = 2 /\ E. x (x <= y /\ bdHas m v i bctTLift k a x 0 /\ bdNode 2 x 0 y)) \/
   ((g = 3 \/ g = 4) /\ E. x (x <= y /\ E. z (z <= y /\
      bdHas m v i bctTLift k a x 0 /\ bdHas m v i bctTLift k b z 0 /\ bdNode g x z y))) \/
   ((g = 0 \/ g = 5 \/ g = 6 \/ g = 7) /\ y = 0))))) $;

--| paTermRename (sfRenameDepthMap R_e d)  (paTermRenameBody).
def bcRTRen (m v i e d t y .g .a .b .j .x .z: nat): wff =
$ (t = 0 /\ y = 0) \/ E. g (g <= t /\ E. a (a <= t /\ E. b (b <= t /\ bdNode g a b t /\
  ((g = 1 /\ E. j (j <= y /\ bcCeIdx e d a j /\ bdNode 1 j 0 y)) \/
   (g = 2 /\ E. x (x <= y /\ bdHas m v i bctTRen e d a x /\ bdNode 2 x 0 y)) \/
   ((g = 3 \/ g = 4) /\ E. x (x <= y /\ E. z (z <= y /\
      bdHas m v i bctTRen e d a x /\ bdHas m v i bctTRen e d b z /\ bdNode g x z y))) \/
   ((g = 0 \/ g = 5 \/ g = 6 \/ g = 7) /\ y = 0))))) $;

--| paTermSubst d a  (paTermSubstBody, paTermSubstVariable).
def bcRTSub (m v i d a t y .g .p .q .j .x .z: nat): wff =
$ (t = 0 /\ y = 0) \/ E. g (g <= t /\ E. p (p <= t /\ E. q (q <= t /\ bdNode g p q t /\
  ((g = 1 /\ ((p < d /\ bdNode 1 p 0 y) \/ (p = d /\ bdHas m v i bctTLift d a y 0) \/
              (d < p /\ E. j (j < p /\ p = suc j /\ bdNode 1 j 0 y)))) \/
   (g = 2 /\ E. x (x <= y /\ bdHas m v i bctTSub d a p x /\ bdNode 2 x 0 y)) \/
   ((g = 3 \/ g = 4) /\ E. x (x <= y /\ E. z (z <= y /\
      bdHas m v i bctTSub d a p x /\ bdHas m v i bctTSub d a q z /\ bdNode g x z y))) \/
   ((g = 0 \/ g = 5 \/ g = 6 \/ g = 7) /\ y = 0))))) $;

--| paFormulaSubst d a  (paFormulaSubstBody).
def bcRFSub (m v i d a c y .g .p .q .x .z: nat): wff =
$ (c = 0 /\ y = 0) \/ E. g (g <= c /\ E. p (p <= c /\ E. q (q <= c /\ bdNode g p q c /\
  ((g = 1 /\ E. x (x <= y /\ E. z (z <= y /\
      bdHas m v i bctTSub d a p x /\ bdHas m v i bctTSub d a q z /\ bdNode 1 x z y))) \/
   ((g = 3 \/ g = 4 \/ g = 5) /\ E. x (x <= y /\ E. z (z <= y /\
      bdHas m v i bctFSub d a p x /\ bdHas m v i bctFSub d a q z /\ bdNode g x z y))) \/
   ((g = 6 \/ g = 7) /\ q = 0 /\ E. x (x <= y /\
      bdHas m v i bctFSub (suc d) a p x /\ bdNode g x 0 y)) \/
   (y = 0 /\ (g = 0 \/ g = 2 \/ ((g = 6 \/ g = 7) /\ q != 0))))))) $;

--| paFormulaRename R_e d  (paFormulaRenameBody).
def bcRFRen (m v i e d c y .g .p .q .x .z: nat): wff =
$ (c = 0 /\ y = 0) \/ E. g (g <= c /\ E. p (p <= c /\ E. q (q <= c /\ bdNode g p q c /\
  ((g = 1 /\ E. x (x <= y /\ E. z (z <= y /\
      bdHas m v i bctTRen e d p x /\ bdHas m v i bctTRen e d q z /\ bdNode 1 x z y))) \/
   ((g = 3 \/ g = 4 \/ g = 5) /\ E. x (x <= y /\ E. z (z <= y /\
      bdHas m v i bctFRen e d p x /\ bdHas m v i bctFRen e d q z /\ bdNode g x z y))) \/
   ((g = 6 \/ g = 7) /\ q = 0 /\ E. x (x <= y /\
      bdHas m v i bctFRen e (suc d) p x /\ bdNode g x 0 y)) \/
   (y = 0 /\ (g = 0 \/ g = 2 \/ ((g = 6 \/ g = 7) /\ q != 0))))))) $;

--| sfRename S_e d  (sfRenameBody).
def bcRSRen (m v i e d c y .g .p .q .x .z: nat): wff =
$ e < 4 /\ ((c = 0 /\ y = 0) \/ E. g (g <= c /\ E. p (p <= c /\ E. q (q <= c /\ bdNode g p q c /\
  (((g = 1 \/ g = 2) /\ E. x (x <= y /\ E. z (z <= y /\
      bcSiIdx e d p x /\ bcSiIdx e d q z /\ bdNode g x z y))) \/
   ((g = 3 \/ g = 4 \/ g = 5) /\ E. x (x <= y /\ E. z (z <= y /\
      bdHas m v i bctSRen e d p x /\ bdHas m v i bctSRen e d q z /\ bdNode g x z y))) \/
   ((g = 6 \/ g = 7) /\ q = 0 /\ E. x (x <= y /\
      bdHas m v i bctSRen e (suc d) p x /\ bdNode g x 0 y)) \/
   (y = 0 /\ (g = 0 \/ ((g = 6 \/ g = 7) /\ q != 0)))))))) $;

--| paTermSource  (paTermSourceBody with the builders paSourceTerm*).
def bcRTSrc (m v i t y .g .p .q .x .z .x2 .z2 .r .s .u .w: nat): wff =
$ (t = 0 /\ bcPaSourceZero y) \/ E. g (g <= t /\ E. p (p <= t /\ E. q (q <= t /\ bdNode g p q t /\
  ((g = 1 /\ bdNode 2 0 (suc p) y) \/
   (g = 2 /\ E. x (x < v /\ bdHas m v i bctTSrc p x 0 0 /\ E. x2 (x2 <= y /\
      bdHas m v i bctSRen 0 0 x x2 /\ E. r (r <= y /\ bdNode 7 r 0 y /\
        E. s (s <= r /\ bdNode 3 x2 s r /\ bcPaSourceSuccessor s))))) \/
   ((g = 3 \/ g = 4) /\ E. x (x < v /\ E. z (z < v /\
      bdHas m v i bctTSrc p x 0 0 /\ bdHas m v i bctTSrc q z 0 0 /\
      E. x2 (x2 <= y /\ E. z2 (z2 <= y /\
        bdHas m v i bctSRen 1 0 x x2 /\ bdHas m v i bctSRen 2 0 z z2 /\
        E. r (r <= y /\ bdNode 7 r 0 y /\ E. s (s <= r /\ bdNode 7 s 0 r /\
          E. u (u <= s /\ bdNode 3 x2 u s /\ E. w (w <= u /\ bdNode 3 z2 w u /\
            ((g = 3 /\ bcPaSourceAddition102 w) \/
             (g = 4 /\ bcPaSourceMultiplication102 w))))))))))) \/
   ((g = 0 \/ g = 5 \/ g = 6 \/ g = 7) /\ bcPaSourceZero y))))) $;

--| paFormulaSource  (paFormulaSourceBody with paSourceFormulaEqual / All / Ex).
def bcRFSrc (m v i c y .g .p .q .x .z .x2 .z2 .r .s .u .w: nat): wff =
$ (c = 0 /\ y = 0) \/ E. g (g <= c /\ E. p (p <= c /\ E. q (q <= c /\ bdNode g p q c /\
  ((g = 1 /\ E. x (x < v /\ E. z (z < v /\
      bdHas m v i bctTSrc p x 0 0 /\ bdHas m v i bctTSrc q z 0 0 /\
      E. x2 (x2 <= y /\ E. z2 (z2 <= y /\
        bdHas m v i bctSRen 3 0 x x2 /\ bdHas m v i bctSRen 0 0 z z2 /\
        E. r (r <= y /\ bdNode 7 r 0 y /\ E. s (s <= r /\ bdNode 7 s 0 r /\
          E. u (u <= s /\ bdNode 3 x2 u s /\ E. w (w <= u /\ bdNode 3 z2 w u /\
            bdNode 2 1 0 w))))))))) \/
   ((g = 3 \/ g = 4 \/ g = 5) /\ E. x (x <= y /\ E. z (z <= y /\
      bdHas m v i bctFSrc p x 0 0 /\ bdHas m v i bctFSrc q z 0 0 /\ bdNode g x z y))) \/
   (g = 6 /\ q = 0 /\ E. x (x <= y /\ bdHas m v i bctFSrc p x 0 0 /\
      E. r (r <= y /\ bdNode 6 r 0 y /\ E. s (s <= r /\ bdNode 5 s x r /\ bcPaSIOp63 s)))) \/
   (g = 7 /\ q = 0 /\ E. x (x <= y /\ bdHas m v i bctFSrc p x 0 0 /\
      E. r (r <= y /\ bdNode 7 r 0 y /\ E. s (s <= r /\ bdNode 3 s x r /\ bcPaSIOp63 s)))) \/
   (y = 0 /\ (g = 0 \/ g = 2 \/ ((g = 6 \/ g = 7) /\ q != 0))))))) $;

def bcRule (m v i g a b c d: nat): wff =
$ (g = bctNum /\ bcRNum m v i a b) \/ (g = bctTLift /\ bcRTLift m v i a b c) \/
  (g = bctTRen /\ bcRTRen m v i a b c d) \/ (g = bctTSub /\ bcRTSub m v i a b c d) \/
  (g = bctFSub /\ bcRFSub m v i a b c d) \/ (g = bctFRen /\ bcRFRen m v i a b c d) \/
  (g = bctSRen /\ bcRSRen m v i a b c d) \/ (g = bctTSrc /\ bcRTSrc m v i a b) \/
  (g = bctFSrc /\ bcRFSrc m v i a b) $;

--| every fact of the set (m, v) is justified by facts of smaller index.
def bcJust (m v .k .i .g .a .b .c .d: nat): wff =
$ A. k (k < v -> bdCell m v k -> E. i (i <= k /\ E. g (g <= k /\ E. a (a <= k /\
  E. b (b <= k /\ E. c (c <= k /\ E. d (d <= k /\
    bdTup i g a b c d k /\ bcRule m v i g a b c d))))))) $;

-- ===================================================================
-- graphs of the two sentence codes and the top-level certificates
-- ===================================================================
--| the facts (m, v) compute s = bb215ArithmeticSentenceSource b
--| = paFormulaSource (paFormulaSubst 0 (paTermNumeral b) bb215ArithmeticFormulaValueCode).
def bcBBSrc (m v b s .t .c .x: nat): wff =
$ E. t (t < v /\ bdHas m v v bctNum b t 0 0 /\ E. c (c < v /\ bcBb215ArithmeticFormulaValueCode m v c /\
  E. x (x < v /\ bdHas m v v bctFSub 0 t c x /\ bdHas m v v bctFSrc x s 0 0))) $;

--| the facts (m, v) compute s = paFormulaSource zfcConPA.
def bcConSrc (m v s .x: nat): wff =
$ E. x (x < v /\ bcZfcConPA m v x /\ bdHas m v v bctFSrc x s 0 0) $;

--| D_B: u = (b, (m, (v, w))): (m, v) computes s = bb215ArithmeticSentenceSource b
--| and w certifies a ZFC proof of s.
def bdBB215Prf (u .b .k .m .j .v .w .s: nat): wff =
$ E. b (b <= u /\ E. k (k <= u /\ bdPair b k u /\ E. m (m <= k /\ E. j (j <= k /\
  bdPair m j k /\ E. v (v <= j /\ E. w (w <= j /\ bdPair v w j /\ bcJust m v /\
    E. s (s < v /\ bcBBSrc m v b s /\ bdZfcPrf w s))))))) $;

--| D_G: u = (m, (v, w)): (m, v) computes s = paFormulaSource zfcConPA and w
--| certifies a ZFC proof of s.
def bdZfcConPrf (u .m .j .v .w .s: nat): wff =
$ E. m (m <= u /\ E. j (j <= u /\ bdPair m j u /\ E. v (v <= j /\ E. w (w <= j /\
  bdPair v w j /\ bcJust m v /\ E. s (s < v /\ bcConSrc m v s /\ bdZfcPrf w s))))) $;

-- B6 (b6/b6.py): the recovered Pi2 statements over hpeano, stated with the approved text of b4/b4_statements.mm0.

--| sigma1: K215 Theorem 1, halting -> inconsistency, as a Pi2 sentence.
theorem K215_sigma1 {h w: nat}: $ A. h (bdK215Halt h -> E. w bdZfcBot w) $;

--| sigma2: K215 Theorem 1, inconsistency -> halting, as a Pi2 sentence.
theorem K215_sigma2 {h w: nat}: $ A. w (bdZfcBot w -> E. h bdK215Halt h) $;

--| Theorem 2, (->): a ZFC proof of some value sentence gives a ZFC proof of falsity.
theorem K215_thm2_pi2a {u w: nat}: $ A. u (bdBB215Prf u -> E. w bdZfcBot w) $;

--| Theorem 2, (<-): a ZFC proof of falsity gives a ZFC proof of some value sentence.
theorem K215_thm2_pi2b {w u: nat}: $ A. w (bdZfcBot w -> E. u bdBB215Prf u) $;

--| Theorem 3, second conjunct (->): a halting run gives a ZFC proof of some value sentence.
theorem K215_thm3_pi2a {h u: nat}: $ A. h (bdK215Halt h -> E. u bdBB215Prf u) $;

--| Theorem 3, second conjunct (<-): a ZFC proof of some value sentence gives a halting run.
theorem K215_thm3_pi2b {u h: nat}: $ A. u (bdBB215Prf u -> E. h bdK215Halt h) $;

--| G2: a ZFC proof of Con(ZFC) gives a ZFC proof of falsity.
theorem K215_G2_pi2 {u w: nat}: $ A. u (bdZfcConPrf u -> E. w bdZfcBot w) $;
