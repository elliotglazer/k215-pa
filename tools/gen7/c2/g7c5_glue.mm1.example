import "perdef.mm1";

import "gen7_tmh.mm1";

-- G7 C5 glue (scratch test of the linker step): reflTmHalts_code from the reflected flat adequacy.
pub theorem g7_reflTmHalts_code_of (k M: nat) {x: nat}
  (hR: $ cPr (ciff (g7tmhCode k M) (ctmHalts (cNum k) (cNum M))) $):
  $ paProvable 0 (paFormulaImp (trJ (trPA (ctmHalts (cNum k) (cNum M)))) (tmHaltsPA k M)) $ =
(named '(g7_tmh_bridge hR (g7pfc_ctmHalts (g7_nfr_fresh nfr_cNum) (g7_nfr_fresh nfr_cNum))));
